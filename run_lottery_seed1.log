Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy achieved good accuracy but lost syntax rate because it
// sometimes let long unconstrained explanatory text continue after opening a
// math span too late, and inside spans it occasionally followed model-preferred
// symbolic continuations that never reached a clean completed arithmetic phrase
// before the step budget expired. To improve evaluation performance, this
// revision is much more aggressive about delimiter discipline: outside a span,
// if the current best token is "<<" or even merely contains "<<", we open a
// constrained span immediately via the helper instead of sampling freely first.
// Inside a span, we avoid speculative raw argmax appends entirely and always
// use parser-guided constrained generation, with light penalties against nested
// delimiters and EOS. As soon as the parser reports a complete constrained
// prefix, we close immediately with ">>". This trades some creativity for much
// higher odds that every arithmetic segment is short, syntactically valid, and
// properly terminated within the budget.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, staying outside leaves the invariant
//   vacuous; opening via OpenConstrainedSpan sets currentConstrainedOut to [],
//   which is a valid prefix by the method precondition on parser. In the inside
//   complete branch, CloseConstrainedSpan exits constrained mode, so the
//   implication becomes vacuous. In the inside incomplete branch, ConstrainedStep
//   returns a parser-valid next token when it is not EOS, and
//   AppendConstrainedToken extends currentConstrainedOut with exactly that valid
//   token, preserving parser validity.
// suffix: Outside and remaining outside does not affect the implication because
//   we are not inside constrained mode. Opening a span appends only the "<<"
//   delimiter and sets currentConstrainedOut := [], so the suffix of length 0 is
//   []. Closing a complete span appends ">>" and resets the constrained state,
//   making the implication vacuous. In the constrained append branch,
//   AppendConstrainedToken appends the same token to both generated and
//   currentConstrainedOut, so the tracked constrained content remains the suffix
//   of generated.
// cost: The only cost-bumping actions are UnconstrainedStep, OpenConstrainedSpan,
//   ConstrainedStep, and CloseConstrainedSpan; each such branch also increments
//   steps exactly once, so helpers.cost <= steps is preserved. Query helpers and
//   logit adjustments do not bump cost, and AppendConstrainedToken also does not
//   bump cost, so branches using them after a single bump still satisfy the
//   inequality.
// progress: Every non-break branch appends at most one token to generated:
//   UnconstrainedStep appends one sampled token, OpenConstrainedSpan appends one
//   "<<", AppendConstrainedToken appends one constrained token, and
//   CloseConstrainedSpan appends one ">>". Each such branch increments steps by
//   one, so |generated| <= |generatedPrefix| + steps is maintained. EOS branches
//   break immediately after the one counted step and need not re-establish the
//   invariant for another iteration.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 8.0);
    helpers.PenalizeTokenLogits(lm, [">>"], 8.0);
    var topOutside := helpers.GetHighestLogitToken(lm);

    if topOutside == "<<" || Contains(topOutside, "<<") {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      } else if nextOutside == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        generated := generated + [nextOutside];
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      helpers.PenalizeTokenLogits(lm, ["<<", ">>", eosToken], 8.0);

      var nextInside := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if nextInside == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, nextInside
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

