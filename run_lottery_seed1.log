Strategy: // CSD_RATIONALE_BEGIN
// The unconstrained-delimiter strategy improved raw syntax rate but failed on the core
// task because free generation inside `<< >>` produced malformed arithmetic and
// repetition. The evaluation traces show exactly why: once `<<` appeared, the model
// often drifted into prose, variable assignments, or repeated delimiters instead of a
// single arithmetic expression. To fix that, this strategy now uses actual constrained
// decoding for the content between delimiters, while still keeping the surrounding
// explanation mostly unconstrained.
//
// The policy is phase-based. Outside constrained mode, it first emits a short natural-
// language lead-in, explicitly suppressing delimiter tokens for a few steps so the
// answer does not open with `<<` too early. After that warmup, it strongly encourages
// opening a constrained span. When `<<` is chosen, we enter parser-controlled mode via
// the helper. Inside constrained mode, every token is generated with
// `helpers.ConstrainedStep`, so the content remains a parser-valid arithmetic prefix at
// all times. We also bias toward concise, finishable expressions by checking for dead
// ends and, whenever the constrained prefix is already complete, immediately closing the
// span with `helpers.CloseConstrainedSpan` instead of risking extra malformed tokens.
// This directly targets the prior `malformed_constrained_content` failures.
//
// To reduce repetition and long wandering outputs, the loop uses a small warmup, then
// aggressively seeks one well-formed constrained computation, and after a close it
// mildly boosts EOS so the model can terminate instead of opening many more spans.
// Outside constrained mode we still sample unconstrained text, but with penalties on
// repeated delimiter behavior. The result is a hybrid strategy: unconstrained narration
// around the math, parser-constrained arithmetic inside `<< >>`, and explicit early
// closure/termination behavior to improve both accuracy and syntax robustness.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, we either append an ordinary token and
//   keep `insideConstrainedOut` false, or open a span using `OpenConstrainedSpan`, which
//   establishes a fresh valid constrained prefix. In the constrained branch, either we
//   close only when `parser.IsCompletePrefix(currentConstrainedOut)` holds, making the
//   post-state unconstrained and thus vacuous, or we obtain `next` from
//   `ConstrainedStep` and append it with `AppendConstrainedToken`, which preserves
//   parser-validity by construction.
//
// suffix: In unconstrained branches the implication is vacuous unless we just opened a
//   span; `OpenConstrainedSpan` sets the generated suffix/current constrained segment
//   consistently. In constrained branches, `AppendConstrainedToken` appends the same
//   token to both the generated output and constrained tracker, preserving the suffix
//   equality, while `CloseConstrainedSpan` exits constrained mode so the implication is
//   again vacuous.
//
// cost: Every cost-bumping action is paired with exactly one increment of `steps` in the
//   same iteration: `UnconstrainedStep`, `OpenConstrainedSpan`, `ConstrainedStep`, and
//   `CloseConstrainedSpan` each increase `helpers.cost` by 1 internally, and we then set
//   `steps := steps + 1`. Pure parser queries, logit adjustments, and
//   `AppendConstrainedToken` do not change `helpers.cost`, so `helpers.cost <= steps` is
//   preserved in every branch.
//
// progress: Each iteration increases `steps` by 1 and changes `generated` by at most one
//   token in the ordinary unconstrained and constrained-append branches, and by at most
//   one delimiter token in the open/close branches. If EOS is produced by the
//   unconstrained step, we break without appending, which also preserves the bound.
//   Hence after every branch, `|generated| <= |generatedPrefix| + steps` remains true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;
var warmup := 0;
var spansClosed := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant helpers.cost <= steps
  invariant 0 <= warmup
  invariant 0 <= spansClosed
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var gClose, inClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := gClose;
      insideConstrainedOut := inClose;
      currentConstrainedOut := cClose;
      spansClosed := spansClosed + 1;
      steps := steps + 1;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      if narrow {
        lm.GenerateLogits(prompt + generated);
        helpers.ScaleAllLogits(lm, 0.5);
      }
      var nextC := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
      var gApp, inApp, cApp := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, nextC);
      generated := gApp;
      insideConstrainedOut := inApp;
      currentConstrainedOut := cApp;
      steps := steps + 1;
    }
  } else {
    lm.GenerateLogits(prompt + generated);
    if warmup < 4 {
      helpers.PenalizeTokenLogits(lm, ["<<", ">>"], 100.0);
    } else {
      helpers.BoostTokenLogits(lm, ["<<"], 12.0);
      helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
      if spansClosed > 0 {
        helpers.BoostTokenLogits(lm, [eosToken], 6.0);
        helpers.PenalizeTokenLogits(lm, ["<<"], 4.0);
      }
    }

    var top := helpers.GetHighestLogitToken(lm);
    if top == "<<" && warmup >= 2 && spansClosed == 0 {
      var gOpen, inOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
      generated := gOpen;
      insideConstrainedOut := inOpen;
      currentConstrainedOut := cOpen;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
