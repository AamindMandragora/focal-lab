Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it opened constrained spans aggressively
// but did not reliably finish them within the remaining budget, producing many
// unterminated `<< ...` segments. This revision makes closure the primary goal.
// Outside constrained mode, it only opens a span on an explicit `<<` signal:
// either the sampled token is exactly `<<` or contains `<<`. It never opens a
// span merely because `<<` has a competitive logit. Inside constrained mode, it
// uses parser-guided constrained generation until the arithmetic prefix becomes
// complete, and then immediately closes with `>>` on the next step. In addition,
// if the loop is about to run out of budget and the current constrained prefix
// is complete, it prioritizes closing rather than extending. This conservative
// open policy plus eager close policy directly targets the observed failure mode
// of unterminated constrained segments while still allowing arithmetic content
// to be produced inside delimiters when the model explicitly starts such a span.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, appending a normal token keeps
//   insideConstrainedOut false, so the implication is vacuous; if the sampled
//   token is exactly `<<` or contains `<<`, we enter constrained mode with
//   currentConstrainedOut := [], which is a valid parser prefix by precondition.
//   In the constrained branch, if the prefix is complete we call
//   CloseConstrainedSpan, which exits constrained mode, making the implication
//   vacuous. Otherwise, either a valid argmax token is appended via
//   AppendConstrainedToken after IsTokenValidNext succeeds, or ConstrainedStep
//   returns a parser-approved token (or EOS, which breaks without changing the
//   state), so validity is preserved.
//
// suffix: In unconstrained normal-token branches we remain outside constrained
//   mode, so the implication is vacuous. When a sampled token opens a span, that
//   token is appended to generated and currentConstrainedOut is reset to [],
//   whose empty suffix matches generated trivially. CloseConstrainedSpan appends
//   the closing delimiter and resets currentConstrainedOut to [], so the
//   implication remains true. In constrained append branches,
//   AppendConstrainedToken appends the same token to generated and to the active
//   constrained prefix, preserving the suffix equality.
//
// cost: Every branch that consumes a generation step also increments steps once.
//   Raw unconstrained sampling uses ChooseNextTokenUnconstrained followed by a
//   manual helpers.cost bump; CloseConstrainedSpan and ConstrainedStep each bump
//   helpers.cost internally, and we increment steps once in those branches.
//   Query helpers and AppendConstrainedToken do not bump helpers.cost. On EOS
//   break branches, the helper/manual bump has already happened in the same
//   iteration, so helpers.cost <= steps is preserved.
//
// progress: Initially generated == generatedPrefix. In each iteration, after
//   steps is incremented by 1, the branch appends at most one token to
//   generated: unconstrained sampling appends one sampled token or none on EOS;
//   CloseConstrainedSpan appends the closing delimiter token; constrained append
//   branches append exactly one token; ConstrainedStep with EOS appends none.
//   Therefore generated grows by at most one per step, preserving
//   |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);
      if argmaxValid && argmax != eosToken {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
