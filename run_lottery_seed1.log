Strategy: // CSD_RATIONALE_BEGIN
// The failure pattern is decisive: the prior strategy opened constrained spans
// too eagerly, before the model had actually started an arithmetic expression,
// and then let the constrained decoder emit prefixes like "n =" or "frac ="
// that never reached a complete expression before the step budget ended. The
// fix is to invert that policy.
//
// This revision keeps generation unconstrained by default and only opens a
// constrained span when the model itself strongly proposes the exact delimiter
// token "<<". Merely containing "<<" is no longer enough. This avoids forcing
// the parser to interpret variable-assignment prose as arithmetic.
//
// Once inside a constrained span, the strategy is aggressively completion-first.
// If the current constrained prefix is complete, it closes immediately. If the
// parser reports a narrow state, we also close as soon as completion becomes
// available rather than exploring further. Otherwise we take one constrained
// step. This keeps arithmetic spans short and increases the chance that every
// opened "<<" is matched by a closing ">>".
//
// The strategy also avoids duplicating tokens after helper calls: helper methods
// that already update generated are used as the sole state transition in their
// branch. This directly targets the evaluation issue "unterminated_constrained_segment"
// by reducing accidental malformed state evolution and by making closure happen
// as soon as the parser allows it.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained stay-outside branch, insideConstrainedOut
//   remains false, so the implication is vacuous. In the opening branch,
//   OpenConstrainedSpan starts a new constrained segment with empty tracked
//   content, and [] is a valid parser prefix by precondition. In the close
//   branch, CloseConstrainedSpan sets insideConstrainedOut to false, so the
//   implication is vacuous. In the append branch, ConstrainedStep supplies a
//   parser-valid next token and AppendConstrainedToken extends the tracked
//   prefix with that token, preserving validity.
// suffix: Outside constrained mode the implication is vacuous. Opening appends
//   only the delimiter while resetting currentConstrainedOut to [], so the
//   suffix of length 0 is still []. Appending adds the same token to generated
//   and currentConstrainedOut, preserving that the tracked constrained content
//   is the suffix. Closing exits constrained mode, so vacuity applies.
// cost: Each iteration performs at most one cost-bumping helper among
//   UnconstrainedStep, OpenConstrainedSpan, ConstrainedStep, and
//   CloseConstrainedSpan, and in exactly those branches steps is incremented by
//   1. Query helpers and AppendConstrainedToken do not bump helper cost, so
//   helpers.cost <= steps is preserved.
// progress: Every non-break branch appends at most one token to generated:
//   UnconstrainedStep appends one ordinary token, OpenConstrainedSpan appends
//   one "<<", AppendConstrainedToken appends one constrained token, and
//   CloseConstrainedSpan appends one ">>". Since each such branch also
//   increments steps by 1, |generated| <= |generatedPrefix| + steps remains
//   true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 3.0);
    helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
    var topOutside := helpers.GetHighestLogitToken(lm);

    if topOutside == "<<" {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
      generated := generated + [nextOutside];
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      var nextInside := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if nextInside == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, nextInside
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;

        var completeAfter := parser.IsCompletePrefix(currentConstrainedOut);
        if narrow && completeAfter && steps < maxSteps {
          var closedGenerated2, closedInside2, closedCurrent2 := helpers.CloseConstrainedSpan(
            lm, parser, generated, currentConstrainedOut
          );
          generated := closedGenerated2;
          insideConstrainedOut := closedInside2;
          currentConstrainedOut := closedCurrent2;
          steps := steps + 1;
        }
      }
    }
  }
}

if insideConstrainedOut && steps < maxSteps {
  var completeEnd := parser.IsCompletePrefix(currentConstrainedOut);
  if completeEnd {
    var closedGenerated3, closedInside3, closedCurrent3 := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated3;
    insideConstrainedOut := closedInside3;
    currentConstrainedOut := closedCurrent3;
    steps := steps + 1;
  }
}

cost := steps;

