Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy opened constrained spans opportunistically but relied on
// the model to decide when to close them, which led to many unterminated `<<`
// segments. This revision makes closure deterministic: once inside a constrained
// span, if the parser says the arithmetic prefix is complete, the very next step
// is to call CloseConstrainedSpan, so every opened span is promptly closed with
// `>>` before any unconstrained narration resumes. Outside constrained spans, the
// strategy strongly biases toward opening a span whenever the model suggests `<<`
// or a token containing `<<`, and it also boosts `<<` when arithmetic-looking
// narration is being produced, increasing the chance that computations are placed
// inside delimiters. Inside spans, generation is fully parser-guided: invalid
// argmax tokens are rejected in favor of ConstrainedStep, and EOS immediately
// terminates generation rather than leaving a span half-open.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, remaining outside keeps the implication
//   vacuous; opening a span sets currentConstrainedOut := [], which is a valid
//   parser prefix by precondition. In the complete-prefix branch, CloseConstrainedSpan
//   exits constrained mode so the implication is vacuous. In the constrained append
//   branches, we append only tokens validated by IsTokenValidNext or returned by
//   ConstrainedStep, and AppendConstrainedToken preserves parser validity.
// suffix: Remaining outside keeps currentConstrainedOut == []; opening a span
//   appends only the opening delimiter to generated and sets currentConstrainedOut
//   to [], so the empty suffix matches. CloseConstrainedSpan resets the constrained
//   prefix to [], so the suffix invariant is immediate. In constrained append
//   branches, AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, preserving the suffix equality.
// cost: Raw unconstrained sampling uses ChooseNextTokenUnconstrained and then
//   manually increments helpers.cost once; steps is incremented in the same
//   iteration. OpenConstrainedSpan, ConstrainedStep, and CloseConstrainedSpan each
//   bump helpers.cost internally exactly once, and each corresponding branch also
//   increments steps once. Query-only branches plus AppendConstrainedToken do not
//   increase helpers.cost, so helpers.cost <= steps is preserved.
// progress: Each iteration increments steps by 1 and appends at most one token to
//   generated: one unconstrained token, one opening delimiter via OpenConstrainedSpan,
//   one constrained token via AppendConstrainedToken, or one closing delimiter via
//   CloseConstrainedSpan. If EOS is produced, we break immediately after that single
//   step with no further appends. Therefore |generated| never exceeds
//   |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);

      if argmaxValid && argmax != eosToken {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  } else {
    lm.GenerateLogits(prompt + generated);
    var top := helpers.GetHighestLogitToken(lm);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    var topLogit := helpers.GetTokenLogit(lm, top);

    if top == "<<" || Contains(top, "<<") || openLogit >= topLogit - 0.5 {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;

      if next == eosToken {
        break;
      } else if next == "<<" || Contains(next, "<<") {
        generated := generated + ["<<"];
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        generated := generated + [next];
      }
    }
  }
}

cost := steps;

