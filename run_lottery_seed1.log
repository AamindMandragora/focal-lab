Strategy: // CSD_RATIONALE_BEGIN
// The evaluation failures show that the previous strategy still let the model
// spend many tokens outside constrained spans and produce symbolic placeholders
// like "frac * n" instead of concrete arithmetic. To improve both accuracy and
// syntax rate, this revision makes arithmetic spans easier to enter and much
// shorter once entered. Outside constrained mode, if the model's top token is
// exactly "<<" or merely contains "<<", we open immediately; this biases toward
// actually using required delimiters instead of verbose prose. Inside a span, we
// avoid long exploratory generation: if the current constrained prefix is already
// complete, we close immediately; if the parser reports a narrow or dead-end
// state, we also stop extending as soon as completion becomes available on the
// next iteration. Otherwise we take exactly one constrained step and append it.
// This design aims to elicit many short concrete computations such as
// <<171 * 2 / 3>> and <<171 + 114>> rather than unfinished algebraic text.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained/non-opening branch, insideConstrainedOut
//   stays false, so the implication is vacuous. In the opening branch,
//   OpenConstrainedSpan starts a fresh constrained span with empty tracked
//   content, and [] is a valid parser prefix by precondition. In the close
//   branch, CloseConstrainedSpan exits constrained mode, making the implication
//   vacuous. In the append branch, ConstrainedStep chooses a parser-valid next
//   token and AppendConstrainedToken extends currentConstrainedOut with exactly
//   that token, so validity is preserved.
// suffix: When we remain outside constrained mode, the implication is vacuous.
//   Opening adds only the delimiter token while tracked constrained content is
//   reset to [], so the suffix of length 0 is still []. Closing leaves
//   constrained mode, so vacuity applies again. Appending inside constrained
//   mode adds the same token to generated and currentConstrainedOut, preserving
//   that the tracked constrained content is the suffix of generated.
// cost: The only cost-bumping operations used in the loop are OpenConstrainedSpan,
//   UnconstrainedStep, ConstrainedStep, and CloseConstrainedSpan, each at most
//   once per iteration, and every such branch increments steps by exactly 1.
//   Query helpers and AppendConstrainedToken do not bump helper cost, so
//   helpers.cost <= steps remains true.
// progress: Every non-break branch appends at most one token to generated:
//   UnconstrainedStep appends one token, OpenConstrainedSpan appends one "<<",
//   AppendConstrainedToken appends one constrained token, and CloseConstrainedSpan
//   appends one ">>". Since each such branch also increments steps by 1, the
//   bound |generated| <= |generatedPrefix| + steps is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 8.0);
    helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
    var topOutside := helpers.GetHighestLogitToken(lm);

    if topOutside == "<<" || Contains(topOutside, "<<") {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      } else if nextOutside == "<<" {
        generated := generated + [nextOutside];
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        generated := generated + [nextOutside];
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 3);

      if narrow && validCount == 0 {
        break;
      } else {
        var nextInside := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextInside == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, nextInside
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

if insideConstrainedOut && steps < maxSteps {
  var completeEnd := parser.IsCompletePrefix(currentConstrainedOut);
  if completeEnd {
    var closedGenerated2, closedInside2, closedCurrent2 := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated2;
    insideConstrainedOut := closedInside2;
    currentConstrainedOut := closedCurrent2;
    steps := steps + 1;
  }
}

cost := steps;

