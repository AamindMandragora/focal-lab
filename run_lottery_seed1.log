Strategy: // CSD_RATIONALE_BEGIN
// Step-by-step math CSD with delimiter-sensitive entry and parser-guarded
// continuation. The strategy tracks the full generated text in `generated`, a
// Boolean `insideConstrainedOut` indicating whether we are currently inside a
// `<< ... >>` arithmetic span, and `currentConstrainedOut`, which stores only
// the tokens inside the active span. Outside a span, generation is mostly free,
// but if the model gives `<<` a logit close to the current argmax, we open a
// constrained span proactively so arithmetic is more likely to be emitted in
// the required delimiters. Inside a span, we prefer a speculative argmax token
// when it is parser-valid; otherwise we fall back to `ConstrainedStep` to pick
// a valid continuation. Once the parser says the constrained prefix is complete,
// we close the span with `>>`. This tracked state lets us preserve parser-valid
// arithmetic fragments while still allowing natural unconstrained explanation
// text between computations.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if we open a span (either by
//   proactive entry or by actually generating "<<"), we set
//   currentConstrainedOut := [], which is a valid prefix by precondition. If we
//   stay outside a span, the implication is vacuous. In the complete-prefix
//   branch, CloseConstrainedSpan sets insideConstrainedOut to false, again
//   making the implication vacuous. In the speculative constrained branch, we
//   call AppendConstrainedToken only after IsTokenValidNext returned true, so
//   the new constrained prefix remains valid. In the fallback constrained
//   branch, ConstrainedStep supplies a valid next token (or EOS, which breaks),
//   so appending preserves validity.
// suffix: In unconstrained generation without opening, the old suffix relation
//   is unchanged because we remain outside the constrained mode. When we open a
//   span, currentConstrainedOut becomes [], and the length-0 suffix of the new
//   generated sequence matches []. CloseConstrainedSpan atomically appends ">>"
//   and resets currentConstrainedOut to [], so the implication holds. In both
//   constrained append branches, AppendConstrainedToken appends the same token
//   to generated and currentConstrainedOut, preserving the suffix equality.
// cost: In the unconstrained raw-logit branch we use GenerateLogits and logit
//   queries, which do not bump helpers.cost, then one primitive token choice
//   and a manual helpers.cost := helpers.cost + 1; we also do steps := steps +
//   1, so helpers.cost <= steps is preserved. CloseConstrainedSpan bumps cost
//   internally and we increment steps once. In the speculative constrained
//   argmax-valid branch, no cost-bumping helper is called and only steps grows,
//   so the inequality still holds. In the ConstrainedStep fallback, that helper
//   bumps once and steps also grows once.
// progress: Every non-break branch appends at most one token to generated,
//   except CloseConstrainedSpan which also appends exactly one delimiter token;
//   in all such branches steps increases by 1. The speculative constrained
//   argmax-valid branch appends one token before incrementing steps. Break
//   branches do not need to preserve a future iteration invariant because the
//   loop exits immediately.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;

    if next == eosToken {
      break;
    } else if openLogit >= argmaxLogit - 2.0 && argmax != eosToken && argmax != ">>" && next != "<<" {
      generated := generated + ["<<"];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      helpers.PenalizeTokenLogits(lm, [">>", "<<"], 8.0);
      var argmaxInside := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmaxInside);

      if argmaxValid && argmaxInside != eosToken {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmaxInside
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var nextInside := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextInside == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, nextInside
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

cost := steps;

