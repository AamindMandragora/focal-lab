Strategy: // CSD_RATIONALE_BEGIN
// The evaluation failures show that the prior policy was structurally wrong for this
// task: it opened `<<` immediately, before any natural-language setup, and then let
// the constrained parser drive token selection in a way that frequently produced
// malformed arithmetic prefixes such as `n =` or `frac =` that never reached a
// complete expression before budget ran out. That simultaneously caused "entered too
// early" and "unterminated constrained segment" failures.
//
// The revised strategy therefore delays constrained generation until there is already
// some ordinary narration, and it only opens a constrained span when there is enough
// remaining budget to both generate arithmetic content and close the span. Outside a
// span, the strategy strongly discourages delimiter tokens and generates normally.
// After a short narration prefix has been produced, it opens at most one constrained
// span. Inside the span, it uses ConstrainedStep only to obtain parser-valid tokens,
// but it refuses to linger indefinitely: if the current constrained prefix is already
// complete, it closes immediately; otherwise it keeps appending valid tokens while
// budget remains, and if the span still is not complete when there is only one step
// left, it stops rather than opening an uncloseable segment. This directly targets
// the observed unterminated-span issue.
//
// To improve the chance that a completed `<<...>>` actually appears, the policy opens
// only after a few unconstrained tokens of reasoning text, avoiding the "too early"
// failure mode, and reserves one step for closure before opening. Outside constrained
// mode, `<<` and `>>` are penalized so only helper-controlled delimiter handling is
// used. The strategy is simple, budget-aware, and centered on the invariant that a
// constrained span is opened only when it can still be closed.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In unconstrained narration branches we remain outside constrained
//   mode, so the implication is vacuous. OpenConstrainedSpan starts a fresh span with
//   empty tracked content, which is a valid parser prefix. In the append branch,
//   ConstrainedStep yields EOS or a parser-valid next token, and AppendConstrainedToken
//   preserves validity of the tracked constrained prefix. In the close branch,
//   CloseConstrainedSpan exits constrained mode, so the implication becomes vacuous.
//
// suffix: During unconstrained narration we keep currentConstrainedOut == [], so the
//   suffix invariant is immediate. OpenConstrainedSpan appends only the opening
//   delimiter and leaves tracked content empty, so the empty suffix matches. In the
//   append branch, AppendConstrainedToken extends both generated and
//   currentConstrainedOut by the same token, preserving the suffix equality. In the
//   close branch, leaving constrained mode resets tracked content to [], making the
//   invariant immediate.
//
// cost: The only cost-bumping operations used are OpenConstrainedSpan,
//   CloseConstrainedSpan, ConstrainedStep, and the primitive unconstrained choice
//   where we manually increment helpers.cost once. Every branch that performs one of
//   these actions also increments steps exactly once, while pure parser/logit queries
//   do not affect helpers.cost. Thus helpers.cost never exceeds steps.
//
// progress: Each non-breaking iteration appends at most one token to generated: one
//   narration token, one opening delimiter, one constrained-content token, or one
//   closing delimiter. The same iteration increments steps by one. EOS branches spend
//   one step and then break without any further append. Therefore generated grows by
//   at most one token per step, preserving |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;
var openedAny := insideConstrainedOut;
var narrationTokens := 0;
if insideConstrainedOut {
  narrationTokens := 3;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  invariant 0 <= narrationTokens
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if steps + 1 >= maxSteps {
        break;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  } else {
    var shouldOpen := false;
    if !openedAny && narrationTokens >= 3 && steps + 2 <= maxSteps {
      shouldOpen := true;
    }

    if shouldOpen {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedAny := true;
      steps := steps + 1;
    } else {
      lm.GenerateLogits(prompt + generated);
      helpers.PenalizeTokenLogits(lm, ["<<", ">>"], 100.0);
      var next2 := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next2 == eosToken {
        break;
      } else {
        generated := generated + [next2];
        if !Contains(next2, "<<") && !Contains(next2, ">>") {
          narrationTokens := narrationTokens + 1;
        }
      }
    }
  }
}

