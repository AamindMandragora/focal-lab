Strategy: // CSD_RATIONALE_BEGIN
// The prior strategy over-opened constrained spans and then relied on token-by-
// token parser-guided completion, which was safe syntactically but brittle for
// evaluation: it sometimes entered math mode before enough natural-language
// setup had been emitted, and once inside it could spend many steps without
// reaching a complete arithmetic phrase, causing unterminated spans. This
// revision makes constrained generation rare, short, and aggressively closable.
// Outside a span, we mostly generate ordinary text and only open when the model
// strongly prefers the exact delimiter token "<<"; merely containing "<<" is no
// longer enough. Inside a span, we first ask how many valid next tokens exist.
// If the parser is at a dead end or has very few continuations, we prefer to
// stop extending and close as soon as completion is available. Otherwise we use
// a single parser-guided constrained step, but after every append we re-check
// completion on the next loop and close immediately. This directly targets the
// observed failures: fewer premature openings, fewer long unfinished spans, and
// fewer malformed repeated delimiter patterns.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside/stay-outside branch, constrained mode remains
//   false, so the implication is vacuous. In the opening branch,
//   OpenConstrainedSpan enters constrained mode with empty current content,
//   which is a valid prefix because parser.IsValidPrefix([]) holds. In the
//   inside/close branch, CloseConstrainedSpan leaves constrained mode, so the
//   implication is again vacuous. In the inside/append branch, we only append a
//   token returned by ConstrainedStep, and AppendConstrainedToken extends the
//   tracked constrained prefix with that valid token, preserving validity.
// suffix: Outside/stay-outside preserves vacuity because we are not inside. On
//   opening, generated gains only the delimiter token while current constrained
//   content becomes [], so the suffix of length 0 is still []. On closing, we
//   exit constrained mode, making the implication vacuous. On constrained
//   append, AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, so the constrained content remains exactly the suffix
//   of generated.
// cost: Every branch that consumes a model step uses exactly one cost-bumping
//   helper—UnconstrainedStep, OpenConstrainedSpan, ConstrainedStep, or
//   CloseConstrainedSpan—and then increments steps by 1. Query helpers
//   (ValidTokenCount, DeadEndDetection, GetHighestLogitToken, logit adjustments)
//   and AppendConstrainedToken do not bump helper cost, so helpers.cost never
//   exceeds steps.
// progress: Each non-break iteration appends at most one token to generated.
//   UnconstrainedStep appends one token, OpenConstrainedSpan appends one "<<",
//   AppendConstrainedToken appends one constrained token, and CloseConstrainedSpan
//   appends one ">>". Since each such branch also increments steps by exactly 1,
//   the bound |generated| <= |generatedPrefix| + steps is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 3.0);
    helpers.PenalizeTokenLogits(lm, [">>"], 8.0);
    var topOutside := helpers.GetHighestLogitToken(lm);

    if topOutside == "<<" {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      } else if nextOutside == "<<" {
        generated := generated + [nextOutside];
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        generated := generated + [nextOutside];
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);

      if narrow && validCount == 0 {
        break;
      } else {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
        helpers.PenalizeTokenLogits(lm, ["<<", ">>"], 100.0);
        helpers.PenalizeTokenLogits(lm, [eosToken], 8.0);

        var nextInside := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextInside == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, nextInside
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

if insideConstrainedOut && steps < maxSteps {
  var completeEnd := parser.IsCompletePrefix(currentConstrainedOut);
  if completeEnd {
    var closedGenerated2, closedInside2, closedCurrent2 := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated2;
    insideConstrainedOut := closedInside2;
    currentConstrainedOut := closedCurrent2;
    steps := steps + 1;
  }
}

cost := steps;

