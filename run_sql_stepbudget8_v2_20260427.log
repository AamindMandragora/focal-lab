Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy opened a constrained span immediately and then emitted
// SQL one token at a time with only shallow candidate preference. That verified,
// but it performed poorly on Spider because it often committed too early to weak
// local choices and could also meander inside the SQL span, producing short,
// repetitive prefixes like "SELECT count".
//
// The revised strategy is tailored to text-to-SQL with schema-narrowed parsing:
// (1) outside constrained mode, it still opens exactly one SQL span so the final
// output contains << >> as required;
// (2) inside constrained mode, it first checks whether the SQL prefix is already
// complete and closes immediately when it is;
// (3) otherwise it uses parser-aware lookahead signals to avoid dead ends and
// low-branching traps: when the valid-next-token set is narrow, it asks for top
// parser-valid candidates and deterministically appends the best one; when the
// space is broader, it falls back to ConstrainedStep, which uses the LM under
// parser restriction;
// (4) if the parser reports a dead-end/narrow state and the current constrained
// prefix may already contain a bad local commitment, it rolls back to the
// longest valid parser prefix before continuing. This directly addresses the
// observed repetition/local-stall failures;
// (5) to improve throughput and reduce wasted unconstrained wandering, the
// strategy never alternates back into free-form generation after opening the SQL
// span; it generates a single constrained SQL query and then closes it.
//
// In short, the main change is replacing the purely append-only constrained loop
// with a parser-aware recover-and-continue loop: complete => close, dead-end =>
// rollback, narrow frontier => top valid candidate, otherwise constrained LM
// step. This is aimed at substantially improving exact-match accuracy while
// preserving the required << >> wrapping and syntax guarantees.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, OpenConstrainedSpan starts a fresh
// constrained segment whose current prefix is empty, and parser.IsValidPrefix([])
// is given. In the inside-complete branch, CloseConstrainedSpan leaves
// constrained mode, so the implication becomes vacuous. In the rollback branch,
// RollbackConstrainedSpan restores a parser-valid constrained prefix; in the
// append branches, we only call AppendConstrainedToken with a token obtained
// either from TopValidCandidates plus an explicit IsTokenValidNext check or from
// ConstrainedStep, whose contract is to produce a parser-allowed next token
// unless it returns EOS; thus validity is preserved in every state-changing
// branch.
//
// suffix: OpenConstrainedSpan creates an empty constrained suffix, so generated's
// suffix equals currentConstrainedOut trivially. CloseConstrainedSpan exits
// constrained mode, making the implication vacuous. RollbackConstrainedSpan
// rewrites generated and currentConstrainedOut together to a stable prefix plus
// the rolled-back constrained content, so the suffix relation is restored;
// AppendConstrainedToken appends the same token to both generated and
// currentConstrainedOut, preserving the suffix equality.
//
// cost accounting: We use a local steps counter and increment it exactly once
// per outer iteration, regardless of whether that iteration opens, closes,
// rolls back, appends, or breaks on EOS. Returned cost is defined as steps, not
// helper bookkeeping, so cost <= maxSteps follows from the loop bound. Branches
// that break do so only after the iteration's single steps increment.
//
// progress: Initially generated == generatedPrefix. In one outer iteration,
// OpenConstrainedSpan and CloseConstrainedSpan append at most one token each;
// rollback can only shorten generated relative to the start of the iteration;
// AppendConstrainedToken appends one token; EOS break appends nothing. Hence at
// the end of each iteration, generated has increased by at most one token from
// the previous iteration's value, and therefore by at most stepTokenBudget
// because stepTokenBudget >= 1. So
// |generated| <= |generatedPrefix| + steps * stepTokenBudget is preserved in all
// branches, including rollback branches where the length may decrease.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      if narrow && |currentConstrainedOut| > 0 {
        var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
        if |rolled| < |currentConstrainedOut| {
          var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
            parser, stablePrefix, generated, currentConstrainedOut
          );
          generated := rolledGenerated;
          currentConstrainedOut := rolledCurrent;
          insideConstrainedOut := true;
          steps := steps + 1;
        } else {
          var count := helpers.ValidTokenCount(parser, currentConstrainedOut);
          if count <= 4 {
            var candidates := helpers.TopValidCandidates(
              lm, parser, prompt + stablePrefix, currentConstrainedOut, 6, eosToken
            );
            if |candidates| > 0 {
              var chosen := candidates[0];
              if chosen == eosToken {
                steps := steps + 1;
                break;
              } else {
                var chosenValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, chosen);
                if chosenValid {
                  var appendedGenerated1, appendedInside1, appendedCurrent1 := helpers.AppendConstrainedToken(
                    lm, parser, generated, currentConstrainedOut, chosen
                  );
                  generated := appendedGenerated1;
                  insideConstrainedOut := appendedInside1;
                  currentConstrainedOut := appendedCurrent1;
                }
                steps := steps + 1;
