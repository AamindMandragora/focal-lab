Strategy: // CSD_RATIONALE_BEGIN
// The failure pattern shows the prior strategy repeatedly re-opened constrained
// spans and kept generating multiple SQL fragments like `...>><< SELECT ...`.
// That behavior is syntactically valid under the delimiter protocol but wrong
// for Spider, which expects exactly one SQL query. The revised strategy changes
// the global control flow rather than only tweaking logits:
//
// 1. At most one constrained SQL span is ever opened. Before the first span, we
//    strongly force the opening delimiter so generation enters SQL quickly.
//    After the span is closed, generation stops immediately instead of allowing
//    any second `<<`.
// 2. Inside the span, decoding remains parser-constrained and deterministic at
//    the outer-step level: if the current SQL prefix is complete, we close with
//    `>>`; otherwise we take one parser-constrained token via ConstrainedStep.
//    This keeps the 100% syntax behavior while avoiding free-form drift.
// 3. EOS remains terminal in every branch.
// 4. State tracking is unchanged: generated stores the full answer including
//    delimiters, while currentConstrainedOut stores only the SQL content between
//    delimiters.
//
// This directly addresses the observed `>><<` repetition by making closure of
// the first complete SQL query terminal for the whole strategy.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: Before any span is opened and after it is closed,
//   insideConstrainedOut is false, so the implication is vacuous. Opening the
//   span uses OpenConstrainedSpan, which sets currentConstrainedOut to [] and
//   parser.IsValidPrefix([]) holds by precondition. In the active constrained
//   branch, ConstrainedStep either returns EOS and we break without mutation, or
//   AppendConstrainedToken extends the constrained prefix with a parser-valid
//   next token, preserving validity. Closing the span via CloseConstrainedSpan
//   sets insideConstrainedOut to false, making the implication vacuous.
// suffix: Outside the span the invariant is vacuous. Immediately after opening,
//   currentConstrainedOut == [], so the suffix of generated of length 0 is [].
//   In the constrained append branch, AppendConstrainedToken appends the same
//   token to generated and currentConstrainedOut, so suffix equality is
//   preserved. EOS break leaves state unchanged, and closing the span makes the
//   implication vacuous.
// cost accounting: steps is the only returned cost measure. Each loop iteration
//   performs exactly one costed helper call before either continuing or
//   breaking: OpenConstrainedSpan, UnconstrainedStep, ConstrainedStep, or
//   CloseConstrainedSpan. Query helpers and parser predicates are non-bumping.
//   We increment steps exactly once per such outer iteration, so at exit
//   cost := steps and therefore cost <= maxSteps.
// progress: Each outer iteration increments steps by exactly 1. Before opening,
//   either OpenConstrainedSpan or UnconstrainedStep adds at most one token to
//   generated; with stepTokenBudget >= 1, the bound
//   |generated| <= |generatedPrefix| + steps * stepTokenBudget is preserved.
//   Inside the span, CloseConstrainedSpan adds one token and
//   AppendConstrainedToken adds one token, while an EOS break adds none; each
//   case fits within the one-step slack added by incrementing steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var openedAnySpan := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if openedAnySpan {
      break;
    } else {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, ["<<"], 100.0);
      var topOutside := helpers.GetHighestLogitToken(lm);
      if topOutside == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        openedAnySpan := true;
        steps := steps + 1;
      } else {
        var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if nextOutside == eosToken {
          break;
        } else if nextOutside == "<<" {
          generated := generated + [nextOutside];
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          openedAnySpan := true;
        } else {
          generated := generated + [nextOutside];
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

