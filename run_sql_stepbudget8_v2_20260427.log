Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL generation naturally alternates between free-form framing
// text and a single constrained SQL region delimited by "<<" and ">>". We
// track three pieces of state: the full generated output (`generated`), whether
// we are currently inside the SQL region (`insideConstrainedOut`), and the SQL
// prefix accumulated so far inside that region (`currentConstrainedOut`).
//
// Outside the SQL region, we use chunked unconstrained decoding so the model
// can quickly emit surrounding text or the opening delimiter. Inside the SQL
// region, the parser is schema-specialized, so we exploit it aggressively:
// if the current SQL prefix is already complete, we close immediately; if the
// parser reports a narrow frontier (few valid next tokens), we use a hard
// constrained step; otherwise we use a speculative fast path that samples the
// current argmax and accepts it only when it is parser-valid. This keeps the
// constrained prefix valid while still allowing fluent model-driven decoding on
// easier parts of the SQL query.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span chunk branch, we either remain outside
//   (implication vacuous) or, when the chunk stops on "<<", we set
//   currentConstrainedOut := [], which is a valid parser prefix by precondition.
//   In the complete-prefix branch, CloseConstrainedSpan sets insideConstrainedOut
//   to false, so the implication is vacuous. In the narrow-frontier constrained
//   branch, ConstrainedStep returns either EOS (break) or a parser-valid next
//   token, and AppendConstrainedToken preserves validity. In the speculative
//   argmax branch, we call AppendConstrainedToken only after IsTokenValidNext
//   returns true; the invalid-argmax sub-branch leaves the state unchanged.
// suffix: Outside the span, when stoppedOnOpenSpan is false we stay outside, so
//   the implication is vacuous; when stoppedOnOpenSpan is true we enter with
//   currentConstrainedOut := [], and the length-0 suffix of generated equals [].
//   CloseConstrainedSpan appends the closing delimiter and resets the current
//   constrained prefix to [], making the implication vacuous. Both constrained
//   append branches use AppendConstrainedToken, which appends the same token to
//   generated and currentConstrainedOut, preserving the suffix equality; the
//   invalid-argmax sub-branch leaves both unchanged.
// cost accounting: We maintain cost == 0 as a loop invariant and use a local
//   `steps` counter for the returned cost. In the chunk branch, steps increases
//   by the helper-returned stepsUsed. In the close branch, steps increases by 1.
//   In the narrow-frontier branch, ConstrainedStep consumes one outer step, so
//   steps increases by 1. In the speculative argmax branch, we manually charge
//   one step after ChooseNextToken, so steps again increases by 1. Thus
//   steps <= maxSteps is preserved and assigning cost := steps at the end gives
//   cost <= maxSteps.
// progress: In the chunk branch, UnconstrainedChunk appends at most stepsUsed
//   tokens, so |generated| grows by at most stepsUsed, and since
//   stepTokenBudget >= 1 we have stepsUsed <= stepsUsed * stepTokenBudget.
//   In the close branch, at most one token is appended, and 1 <= stepTokenBudget.
//   In both constrained token branches, at most one token is appended, and the
//   invalid-argmax sub-branch appends none; after steps := steps + 1, the bound
//   |generated| <= |generatedPrefix| + steps * stepTokenBudget is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpenSpan {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= 3 {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
        var next := lm.ChooseNextToken();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
          if valid {
            var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated2;
            insideConstrainedOut := appendedInside2;
            currentConstrainedOut := appendedCurrent2;
          }
        }
      }
    }
  }
}

