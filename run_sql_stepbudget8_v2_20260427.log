Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy underperformed because it let the model wander too much
// outside constrained mode and then closed constrained spans as soon as the
// parser reported local completeness. For Spider Text-to-SQL, the useful work is
// almost entirely the SQL itself, so this revised strategy aggressively enters a
// constrained span early and then stays parser-guided until a complete SQL
// query is formed. This directly targets the observed low accuracy while keeping
// syntax perfect.
//
// Concretely, outside constrained mode we do not spend many free-form tokens.
// If generation is not already inside a constrained span, we immediately open
// one on the next step. Inside constrained mode, we use parser-constrained
// decoding token by token. We only call CloseConstrainedSpan from a branch where
// parser completeness is already known, and we prefer closing immediately once a
// complete query exists so the final answer contains a single completed SQL span
// delimited by << and >>. EOS remains terminal in every branch.
//
// This design still keeps each outer iteration simple for verification: every
// iteration consumes exactly one outer step, and every helper used appends at
// most one token. The main behavioral change is strategic rather than
// structural: almost all budget is now spent on parser-constrained SQL tokens
// instead of unconstrained narration, which is better aligned with the Spider
// task.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, if generated already ends with "<<"
// and we switch into constrained mode manually, currentConstrainedOut becomes []
// and validity follows from the method precondition parser.IsValidPrefix([]). If
// we call OpenConstrainedSpan, that helper returns an empty constrained prefix,
// again valid. In the inside-complete branch, CloseConstrainedSpan leaves
// constrained mode, so the implication is vacuous. In the inside-incomplete
// branch, if ConstrainedStep returns EOS we break without changing the
// constrained state; otherwise AppendConstrainedToken extends the constrained
// prefix with a parser-valid token, preserving validity.
//
// suffix: In the outside branch where we switch into constrained mode because
// generated already ends with "<<", the constrained suffix is [] so the suffix
// equality is immediate. In the OpenConstrainedSpan branch, the helper starts a
// fresh empty constrained suffix, and the length-0 suffix equality holds. In
// the close branch we leave constrained mode, so the implication is vacuous. In
// the append branch, AppendConstrainedToken appends the same token to generated
// and currentConstrainedOut, preserving that currentConstrainedOut is exactly
// the suffix of generated.
//
// cost accounting: We use a local steps counter and increment it exactly once
// per loop iteration. The outside branch either performs OpenConstrainedSpan or
// just changes bookkeeping after observing the existing trailing "<<"; both are
// charged by the single outer-step increment in steps. The inside-complete
// branch uses CloseConstrainedSpan, and the inside-incomplete branch uses
// ConstrainedStep before possibly calling the non-bumping AppendConstrainedToken.
// Therefore steps remains between 0 and maxSteps, and cost := steps at the end
// ensures cost <= maxSteps.
//
// progress: Initially |generated| = |generatedPrefix|. In the outside branch,
// either we only switch bookkeeping with no token growth, or OpenConstrainedSpan
// appends one delimiter token. In the inside-complete branch,
// CloseConstrainedSpan appends one closing delimiter token. In the
// inside-incomplete branch, either EOS causes no append before break, or
// AppendConstrainedToken appends one token. Thus every iteration increases
// |generated| by at most 1, so after steps := steps + 1 the bound
// |generated| <= |generatedPrefix| + steps * stepTokenBudget is preserved since
// stepTokenBudget >= 1.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if |generated| > 0 && generated[|generated| - 1] == "<<" {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
      steps := steps + 1;
    } else {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, prompt + stablePrefix, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

