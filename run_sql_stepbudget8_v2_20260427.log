Strategy: // CSD_RATIONALE_BEGIN
// The failure pattern shows that the prior strategy entered constrained mode but
// still relied too directly on a single constrained sample at each position,
// which let the model choose low-quality yet grammar-valid continuations. On
// Spider, syntax is already solved; the bottleneck is picking better SQL tokens
// among parser-valid options. The revised strategy therefore keeps the answer in
// one constrained SQL span, but changes the token selection policy inside that
// span.
//
// Outside constrained mode, we immediately open the span so the output still
// contains << and >>. Inside constrained mode, if the current SQL prefix is
// complete we close immediately. Otherwise, we query a small set of top
// parser-valid candidates from the current LM state and deterministically append
// the first candidate when one exists. This biases decoding toward high-logit
// valid SQL tokens without depending on a fresh unconstrained sample that may
// wander into weak grammar corners. If no valid candidate is returned, we fall
// back to ConstrainedStep so generation can still make progress. EOS is always
// terminal.
//
// This directly addresses the observed low-accuracy malformed-content pattern:
// rather than accepting whatever single constrained sample appears next, we
// explicitly rank among valid SQL continuations and greedily take a strong
// parser-approved token. The loop structure remains simple for proof: each outer
// iteration consumes exactly one step, opens/closes a delimiter, or appends at
// most one constrained token.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, OpenConstrainedSpan starts a fresh
// constrained segment with empty currentConstrainedOut, which is valid because
// parser.IsValidPrefix([]) holds. In the inside-complete branch,
// CloseConstrainedSpan exits constrained mode, so the implication is vacuous. In
// the inside-incomplete branch, if TopValidCandidates returns a nonempty list we
// append its first parser-valid token with AppendConstrainedToken, preserving
// validity; if it returns empty we use ConstrainedStep, and on non-EOS output
// AppendConstrainedToken again preserves validity, while on EOS we break without
// changing the constrained state.
//
// suffix: OpenConstrainedSpan creates an empty constrained suffix, so the suffix
// equality holds trivially. CloseConstrainedSpan leaves constrained mode, so the
// implication is vacuous. In either append branch, AppendConstrainedToken adds
// the same token to generated and currentConstrainedOut, preserving that
// currentConstrainedOut is exactly the suffix of generated.
//
// cost accounting: We maintain a local steps counter and increment it exactly
// once per loop iteration, regardless of branch. OpenConstrainedSpan,
// CloseConstrainedSpan, and the fallback ConstrainedStep may internally bump
// helper cost, but the returned cost is defined only by steps. Thus 0 <= steps
// <= maxSteps throughout, and assigning cost := steps at the end yields
// cost <= maxSteps.
//
// progress: Initially generated equals generatedPrefix. In the outside branch,
// OpenConstrainedSpan appends at most one token. In the inside-complete branch,
// CloseConstrainedSpan appends at most one token. In the inside-incomplete
// branch, either we append one token via AppendConstrainedToken, or EOS causes
// no append before break. Therefore each iteration increases |generated| by at
// most 1, so after incrementing steps the bound
// |generated| <= |generatedPrefix| + steps * stepTokenBudget is preserved since
// stepTokenBudget >= 1.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var candidates := helpers.TopValidCandidates(lm, parser, prompt + stablePrefix, currentConstrainedOut, 4, eosToken);
      steps := steps + 1;
      if |candidates| > 0 {
        var chosen := candidates[0];
        if chosen == eosToken {
          break;
        } else {
          var appendedGenerated1, appendedInside1, appendedCurrent1 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, chosen
          );
          generated := appendedGenerated1;
          insideConstrainedOut := appendedInside1;
          currentConstrainedOut := appendedCurrent1;
        }
      } else {
        var next := helpers.ConstrainedStep(lm, parser, prompt + stablePrefix, currentConstrainedOut, eosToken);
        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

cost := steps;

