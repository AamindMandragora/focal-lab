Strategy: // CSD_RATIONALE_BEGIN
// The prior strategy over-focused on token-by-token parser validity inside the
// SQL span. That guaranteed syntax, but it still let the model drift into
// locally valid yet semantically poor continuations, especially repeated or
// badly timed punctuation near clause boundaries. The evaluation failures
// (`SELECT <id> , <id> FROM <id>>>`) show that the decoder was willing to keep
// sampling weak local continuations until the grammar happened to complete.
//
// The revised strategy changes shape rather than making a local tweak:
// 1. Open exactly one constrained SQL span immediately.
// 2. While outside the span, never emit anything else.
// 3. Inside the span, use parser-guided constrained decoding as the default.
// 4. In broad states, generate a short unconstrained chunk on the full output
//    stream so the LM can express higher-level SQL clause patterns, but only
//    keep the longest suffix that is still a valid constrained prefix via
//    RollbackConstrainedSpan.
// 5. In narrow states, fall back to one-token ConstrainedStep to avoid dead-end
//    drift.
// 6. As soon as the constrained SQL prefix is complete, close the span
//    immediately and stop; this prevents trailing parser-valid junk before `>>`.
//
// This directly addresses the observed failure mode: broad states get chunked
// LM planning, narrow states get strict parser steering, and completion causes
// immediate closure instead of allowing extra punctuation or identifiers.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: When outside the constrained span, the implication is
// vacuous. Opening the span yields an empty constrained prefix, valid by the
// method precondition. In the narrow branch, ConstrainedStep returns a token
// accepted by the parser (or EOS, which leaves state unchanged), and
// AppendConstrainedToken preserves validity. In the chunk branch,
// UnconstrainedChunk may overshoot, but RollbackConstrainedSpan restores the
// constrained suffix to a parser-valid prefix. In the complete branch,
// CloseConstrainedSpan exits the constrained mode, making the implication
// vacuous.
//
// suffix: Outside the span the implication is vacuous. After opening, the
// constrained suffix is empty, so the property is immediate. In the narrow
// branch, AppendConstrainedToken appends the same token to generated and the
// constrained prefix, preserving the suffix equality. In the chunk branch,
// RollbackConstrainedSpan explicitly reconstructs generated/currentConstrainedOut
// so that the active constrained contents are again the suffix of generated. In
// the close and EOS branches, either the implication becomes vacuous or the
// state is unchanged.
//
// cost accounting: steps is the returned cost. Each iteration that continues
// performs exactly one costed outer action: OpenConstrainedSpan,
// CloseConstrainedSpan, ConstrainedStep, or UnconstrainedChunk. Query helpers
// and rollback helpers do not affect returned cost. We increment steps once per
// such outer action, and on exit set cost := steps, so cost <= maxSteps.
//
// progress: Initially generated == generatedPrefix. Each outer iteration
// increments steps by exactly 1 before the next iteration. OpenConstrainedSpan
// and CloseConstrainedSpan add at most 1 token, ConstrainedStep followed by
// AppendConstrainedToken adds at most 1 token, and UnconstrainedChunk adds at
// most stepTokenBudget tokens by construction; RollbackConstrainedSpan can only
// shorten that result. Therefore after every branch,
// |generated| <= |generatedPrefix| + steps * stepTokenBudget remains true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var openedAnySpan := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if openedAnySpan {
      break;
    } else {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedAnySpan := true;
      steps := steps + 1;
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 3);
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;

      if narrow || validCount <= 5 {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
          lm, prompt, generated, stepTokenBudget, "<<", eosToken
        );
        var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
          parser, stablePrefix, chunkGenerated, currentConstrainedOut
        );
        generated := rolledGenerated;
        currentConstrainedOut := rolledCurrent;
        insideConstrainedOut := true;
        steps := steps + 1;
        if stoppedOnEos {
          break;
        } else {
          var completeAfterRollback := parser.IsCompletePrefix(currentConstrainedOut);
          if completeAfterRollback {
            var closedGenerated2, closedInside2, closedCurrent2 := helpers.CloseConstrainedSpan(
              lm, parser, generated, currentConstrainedOut
            );
            generated := closedGenerated2;
            insideConstrainedOut := closedInside2;
            currentConstrainedOut := closedCurrent2;
            break;
          }
        }
      }
    }
  }
}

cost := steps;

