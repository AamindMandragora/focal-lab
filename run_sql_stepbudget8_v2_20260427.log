Strategy: // CSD_RATIONALE_BEGIN
// This strategy keeps the control structure simple to avoid verifier timeouts.
// We maintain the full generated text, whether we are inside a constrained
// span, and the constrained suffix itself. Outside a constrained span we take
// one unconstrained step at a time; if the model emits "<<", we open a new
// constrained span using the helper so the bookkeeping is consistent. Inside a
// constrained span, if the parser says the constrained prefix is complete, we
// close immediately; otherwise we take one parser-constrained token step and
// append it unless it is EOS.
//
// The design deliberately uses only single-step helpers in the loop. That keeps
// the loop invariants straightforward: every iteration consumes exactly one
// outer step, appends at most one token, and either preserves or resets the
// constrained-prefix relationship in an obvious way.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained-outside branch, if the sampled token is
//   not "<<", we remain outside so the implication is vacuous; if it is "<<",
//   OpenConstrainedSpan returns an empty constrained prefix, which is a valid
//   parser prefix by precondition. In the inside-complete branch,
//   CloseConstrainedSpan exits constrained mode, so the implication is vacuous.
//   In the inside-incomplete branch, ConstrainedStep returns either EOS, in
//   which case the state is unchanged before break, or a parser-valid next
//   token, and AppendConstrainedToken preserves parser validity.
// suffix: In the unconstrained-outside non-open sub-branch we stay outside, so
//   the implication is vacuous; in the open sub-branch, OpenConstrainedSpan
//   starts a fresh empty constrained suffix, and the length-0 suffix equality
//   holds. In the close branch, we leave constrained mode, so the implication
//   is vacuous. In the constrained-append branch, AppendConstrainedToken appends
//   the same token to both generated and currentConstrainedOut, preserving the
//   suffix equality.
// cost accounting: The loop uses a local steps counter with one increment per
//   iteration. Each branch performs exactly one costed helper/sampling action:
//   UnconstrainedStep, OpenConstrainedSpan, CloseConstrainedSpan, or
//   ConstrainedStep. Thus after steps := steps + 1, we preserve steps <=
//   maxSteps, and assigning cost := steps at the end yields cost <= maxSteps.
// progress: Initially the bound is exact. Each iteration appends at most one
//   token to generated: UnconstrainedStep appends one token, OpenConstrainedSpan
//   appends the opening delimiter token, CloseConstrainedSpan appends the
//   closing delimiter token, and AppendConstrainedToken appends one constrained
//   token. Since stepTokenBudget >= 1, after incrementing steps by 1 we still
//   have |generated| <= |generatedPrefix| + steps * stepTokenBudget.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      if next == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next2 := helpers.ConstrainedStep(lm, parser, prompt + stablePrefix, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next2 == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next2
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

