Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy was too permissive inside the SQL span: in broad parser
// states it merely boosted a few valid candidates and then sampled
// unconstrained, which preserved syntax but frequently produced low-quality or
// obviously wrong SQL continuations (e.g. noisy punctuation/repetition). For
// Spider, accuracy matters more than stylistic diversity once inside the SQL
// query. The revised strategy therefore makes the constrained span almost fully
// deterministic: after entering "<<", every outer step either closes a complete
// SQL prefix with ">>" or takes a parser-constrained next token via
// ConstrainedStep. This removes the invalid-but-syntactically-allowed drift
// caused by unconstrained sampling under weak boosts.
// To improve where the constrained span begins, the unconstrained region is also
// simplified. Rather than taking long free-form chunks that may wander before
// opening the SQL span, we decode one token at a time outside the span and
// strongly bias toward the open delimiter "<<". This tends to start the SQL
// query promptly, satisfying the required delimiter format while spending the
// available step budget on the schema-constrained SQL itself instead of on
// preamble text.
// State tracking remains standard: generated is the full output including
// delimiters, while currentConstrainedOut stores only the SQL tokens between
// "<<" and ">>". Opening a span resets currentConstrainedOut to []; appending a
// constrained token extends both generated and currentConstrainedOut together;
// closing is performed only when parser.IsCompletePrefix(currentConstrainedOut)
// is known, so ">>" is emitted only at a legal SQL stopping point. EOS is
// always terminal.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span branch, either EOS is sampled and we
//   break with no state change, or we open a new constrained span via
//   OpenConstrainedSpan, which sets currentConstrainedOut := []; validity holds
//   because parser.IsValidPrefix([]) is a precondition, or we append one
//   unconstrained token while remaining outside, making the implication
//   vacuous. In the complete-prefix branch, CloseConstrainedSpan exits the span,
//   so the implication is vacuous. In the active constrained branch,
//   ConstrainedStep returns either EOS (break, no mutation) or a valid next SQL
//   token, and AppendConstrainedToken preserves parser validity.
// suffix: Outside the span the invariant is vacuous; after OpenConstrainedSpan,
//   currentConstrainedOut is empty, so the generated suffix of length 0 equals
//   []. CloseConstrainedSpan resets currentConstrainedOut to [], so the
//   implication is vacuous. In the constrained append branch,
//   AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, preserving exact suffix equality. EOS break leaves
//   state unchanged.
// cost accounting: cost is kept at 0 during the loop and a local steps counter
//   tracks returned cost. Each outside-span iteration performs exactly one
//   costed action: either OpenConstrainedSpan or UnconstrainedStep, after which
//   we increment steps by 1. Each inside-span iteration likewise performs
//   exactly one costed action: CloseConstrainedSpan or ConstrainedStep, then
//   steps += 1. Query-only parser checks do not affect steps. Hence at exit
//   cost := steps and steps <= maxSteps, so cost <= maxSteps.
// progress: Every outer iteration increases steps by exactly 1 before any
//   possible break. Outside the span, OpenConstrainedSpan or UnconstrainedStep
//   adds at most one token to generated, so
//   |generated| <= |generatedPrefix| + steps * stepTokenBudget is preserved
//   since stepTokenBudget >= 1. In the complete-prefix branch,
//   CloseConstrainedSpan adds one token and steps grows by 1. In the active
//   constrained branch, AppendConstrainedToken adds one token after a
//   ConstrainedStep, while an EOS break adds none; both cases preserve the
//   bound because one step of slack is added each iteration.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 100.0);
    var topOutside := helpers.GetHighestLogitToken(lm);
    if topOutside == "<<" {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      } else if nextOutside == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
        generated := generated + [nextOutside];
      } else {
        generated := generated + [nextOutside];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

