Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL strategy with delimiter-triggered constrained decoding.
// The method tracks the usual span state (`insideConstrainedOut` and
// `currentConstrainedOut`) plus a small SQL-specific context: the tokens seen
// after the most recent FROM and SELECT keywords inside the active SQL span.
// Those context slices are extracted from the already-generated constrained
// prefix and used only as soft signals.
//
// Outside a constrained span, generation is unconstrained so the model can
// emit ordinary explanatory/prefix text and the opening delimiter naturally.
// Once inside the SQL span, the parser provides the hard validity boundary.
// When the grammar is narrow, the strategy uses AdaptiveConstrainedStep with
// caller-supplied token groups to bias toward schema-relevant tokens. When the
// grammar is wider, it manually generates logits, softly boosts tokens that
// appear in the recent FROM/SELECT context and in the caller groups, then
// masks to parser-valid tokens plus EOS before sampling. If the constrained
// prefix is already complete, the strategy closes the span immediately.
// This combination keeps every emitted SQL token parser-valid while still
// steering choices toward schema- and clause-relevant continuations.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, the only transition into a
//   constrained span is on token "<<" and we set currentConstrainedOut := [],
//   which is parser-valid by precondition. In the close-span branch,
//   CloseConstrainedSpan sets insideConstrainedOut to false, so the implication
//   becomes vacuous. In the adaptive constrained branch, any non-EOS token
//   returned by AdaptiveConstrainedStep satisfies parser-valid-next, and
//   AppendConstrainedToken extends the prefix validly. In the manual masked
//   branch, we call MaskValidNextAndEos before ChooseNextToken, so any non-EOS
//   sampled token is parser-valid-next; AppendConstrainedToken then preserves
//   parser validity.
//
// suffix: In the unconstrained branch, either we stay outside the span or we
//   enter with currentConstrainedOut := [], and the length-0 suffix of
//   generated matches []. In the close-span branch, CloseConstrainedSpan
//   appends the closing delimiter and resets currentConstrainedOut to [],
//   making the suffix condition vacuous afterward. In both constrained token
//   branches, AppendConstrainedToken appends the same token to `generated` and
//   `currentConstrainedOut`, so the generated suffix remains exactly the active
//   constrained prefix.
//
// cost accounting: `cost` is kept at 0 throughout the loop and assigned from
//   `steps` only once at the end. Every non-breaking branch increments `steps`
//   by exactly 1 after a cost-bumping helper or primitive sampling action:
//   UnconstrainedStep, CloseConstrainedSpan, AdaptiveConstrainedStep, or
//   ChooseNextToken after manual masking. Therefore the returned `cost := steps`
//   is at most maxSteps.
//
// progress: UnconstrainedStep appends exactly one token and we do steps :=
//   steps + 1. CloseConstrainedSpan appends at most one token and again steps
//   grows by 1. AdaptiveConstrainedStep itself only chooses the next token;
//   on non-EOS we append exactly one token with AppendConstrainedToken and set
//   steps := steps + 1, while on EOS we break immediately after the increment.
//   In the manual masked branch, sampling consumes one step; on non-EOS we
//   append exactly one token, and on EOS we break. Thus every non-breaking
//   branch strictly increases steps and preserves |generated| <=
//   |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;
var fromKeyword: Token := "FROM";
var selectKeyword: Token := "SELECT";

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);

      if validCount <= narrowThreshold {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var fromContext := helpers.ExtractAfterKeyword(currentConstrainedOut, fromKeyword);
        var selectContext := helpers.ExtractAfterKeyword(currentConstrainedOut, selectKeyword);
        var flatGroups := helpers.FlattenTokenGroups(validTokenGroups);

        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);

        if |flatGroups| > 0 {
          helpers.BoostValidGroups(lm, parser, currentConstrainedOut, validTokenGroups, 4.0);
        }

        if |fromContext| > 0 {
          var anyFromValid := helpers.GroupHasValidMember(parser, currentConstrainedOut, fromContext);
          if anyFromValid {
            helpers.BoostTokenLogits(lm, fromContext, 6.0);
          }
        }

        if |selectContext| > 0 {
          var anySelectValid := helpers.GroupHasValidMember(parser, currentConstrainedOut, selectContext);
          if anySelectValid {
            helpers.BoostTokenLogits(lm, selectContext, 3.0);
          }
        }

        lm.MaskValidNextAndEos(parser, currentConstrainedOut, eosToken);
        var next := lm.ChooseNextToken();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;

        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

