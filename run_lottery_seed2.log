// Strategy for step-by-step math solutions with arithmetic spans in << >>.
// The state tracks the full generated answer in `generated`, whether we are
// currently inside a constrained arithmetic span in `insideConstrainedOut`, and
// the content of the active span in `currentConstrainedOut`. Outside spans we
// decode mostly freely, but if the model strongly prefers "<<" or if the
// sampled token text contains "<<", we open a constrained span so arithmetic is
// produced under parser control. Inside spans, we first check whether the span
// is already complete and should be closed with ">>"; otherwise we inspect the
// number of valid next tokens. When the valid set is small we use
// `ConstrainedStep` directly; when it is larger we boost a few top valid
// candidates and sample, appending only parser-valid tokens. This tracked state
// ensures delimiter structure is explicit and that the text between delimiters
// remains a parser-valid arithmetic prefix.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, appending a normal token keeps
//   `insideConstrainedOut` false, so the implication is vacuous; opening via
//   explicit "<<" or via `Contains(next, "<<")` sets `currentConstrainedOut := []`,
//   which is valid by precondition `parser.IsValidPrefix([])`. In the
//   complete-prefix branch, `CloseConstrainedSpan` sets `insideConstrainedOut`
//   false, so validity is vacuous. In the direct constrained branch,
//   `ConstrainedStep` provides a valid next token (or EOS, which breaks), and
//   `AppendConstrainedToken` preserves parser validity. In the boosted-sampling
//   branch, we call `AppendConstrainedToken` only when `IsTokenValidNext` is
//   true; the rejection branch leaves state unchanged.
// suffix: In unconstrained normal-token branches we remain outside, so the
//   implication is vacuous. When opening a span, we append "<<" to `generated`
//   and set `currentConstrainedOut := []`; the length-0 suffix equals `[]`.
//   `CloseConstrainedSpan` appends ">>" and resets the current span to `[]`.
//   Both constrained append branches use `AppendConstrainedToken`, which
//   appends the same token to `generated` and `currentConstrainedOut`; the
//   rejection branch changes neither side.
// cost: `UnconstrainedStep`, `ConstrainedStep`, and `CloseConstrainedSpan` each
//   bump `helpers.cost` by 1 internally, and in exactly those iterations we do
//   `steps := steps + 1`. In the boosted-sampling branch we use
//   `ChooseNextTokenUnconstrained()` and then manually do
//   `helpers.cost := helpers.cost + 1`, again paired with `steps := steps + 1`.
//   Query helpers and `AppendConstrainedToken` do not bump cost, so
//   `helpers.cost <= steps` is preserved in every branch.
// progress: Every loop iteration increases `steps` by 1. The unconstrained
//   branch appends at most one token to `generated`; the close branch appends
//   one delimiter token; the direct constrained branch appends at most one
//   constrained token; the boosted-sampling branch appends either one valid
//   token or nothing on rejection. Hence `|generated| <= |generatedPrefix| +
//   steps` remains true in all branches.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    var topToken := helpers.GetHighestLogitToken(lm);
    var topLogit := helpers.GetTokenLogit(lm, topToken);
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else if next == "<<" || Contains(next, "<<") || openLogit >= topLogit - 2.0 {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
    } else {
      generated := generated + [next];
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= 3 {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var candidates := helpers.TopValidCandidates(
          lm, parser, constrainedPrompt, currentConstrainedOut, 4, eosToken
        );
        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
        helpers.BoostTokenLogits(lm, candidates, 8.0);
        helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
        var next := lm.ChooseNextTokenUnconstrained();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
          if valid {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
          }
        }
      }
    }
  }
}

