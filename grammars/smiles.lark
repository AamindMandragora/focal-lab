// Single-line chemistry answer grammar for constrained molecular generation.
// This intentionally accepts SMILES-like strings and nearby chemistry answer
// formats while still enforcing a bounded one-line answer span.

csd_start: answer
start: answer

answer: atom+

atom: CHEM_TOKEN

CHEM_TOKEN: /[A-Za-z0-9+#@%.,;_()[\]{}=:'"<>|*\/\\-]+/

%import common.WS_INLINE
%ignore WS_INLINE
