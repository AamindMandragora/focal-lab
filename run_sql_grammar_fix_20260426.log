Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy guaranteed syntactic validity but still scored very low
// on Spider because it mixed delimiter management with token-level generation in
// a way that often duplicated or corrupted the beginning of the SQL span. In
// particular, opening the constrained span after already sampling "<<" outside
// could misalign the generated text, and the prompt passed into constrained
// generation depended on delicate suffix arithmetic.
// Revised strategy:
// 1. Enter constrained generation as the default behavior. Outside a span, we
//    strongly bias toward "<<" and then sample exactly one token ourselves.
//    If that sampled token is eosToken we stop; if it is "<<", we enter the
//    constrained span by updating state directly; otherwise we emit that single
//    unconstrained token and continue. This avoids the prior double-open style
//    interaction.
// 2. Once inside the constrained span, generation is entirely parser-driven.
//    If the SQL prefix is complete, we close immediately with
//    helpers.CloseConstrainedSpan. Otherwise we call helpers.ConstrainedStep
//    using the full prompt + generated context and append exactly the returned
//    parser-approved token. We never free-sample inside the SQL span.
// 3. We add a light dead-end recovery: if the valid-next-token count is tiny or
//    dead-end detection fires, we further trust ConstrainedStep rather than any
//    heuristic token choice. This keeps the search tightly on-schema and on-
//    grammar, which is what Spider needs.
// 4. EOS remains terminal in every branch.
// The key change is simplification: one clean transition into "<<", then purely
// constrained SQL token generation until parser completion, then immediate ">>".
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, if we stay outside after emitting an
//   unconstrained token, the implication is vacuous; if we open on "<<", we set
//   currentConstrainedOut := [], which is valid by parser.IsValidPrefix([]). In
//   the inside-complete branch, CloseConstrainedSpan makes insideConstrainedOut
//   false, so the implication is vacuous. In the inside-incomplete branch,
//   ConstrainedStep returns either eosToken, leaving state unchanged, or a valid
//   next token; AppendConstrainedToken then preserves parser validity.
// suffix: In outside branches that remain outside, the implication is vacuous.
//   When we open on "<<", currentConstrainedOut is [], so it is the suffix of
//   generated. In the close branch, insideConstrainedOut becomes false, making
//   the invariant vacuous. In the append branch, AppendConstrainedToken extends
//   both generated and currentConstrainedOut with the same token, preserving the
//   suffix equality; in the eos sub-branch neither changes.
// progress: steps increases exactly once per iteration. Outside, we append at
//   most one token to generated. Opening on "<<" appends exactly one token.
//   Closing appends one delimiter token. Appending a constrained token appends
//   exactly one token, while the eos sub-branch appends none. Hence generated
//   grows by at most one per step, preserving
//   |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 100.0);
    var next := lm.ChooseNextToken();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;

    if next == eosToken {
      break;
    } else if next == "<<" {
      generated := generated + [next];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else {
      generated := generated + [next];
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      var next := helpers.ConstrainedStep(lm, parser, prompt + generated, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

