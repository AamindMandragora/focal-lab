Strategy: {
  // CSD_RATIONALE_BEGIN
  // The previous strategy fixed premature stopping, but the evaluation preview
  // "SELECT <id> <id> ," shows a different problem: it was still too sampler-like
  // inside the SQL span. Even though every token was parser-valid, the policy was
  // allowing locally valid but semantically aimless continuations, which is fatal
  // for Spider where the grammar admits many identifier-heavy branches.
  //
  // This revision switches to a much more deterministic constrained policy:
  // once the constrained span is open, generation is driven almost entirely by
  // helpers.ConstrainedStep, with only light frontier-aware logit shaping to keep
  // the model on high-probability valid continuations. Most importantly, if the
  // current SQL prefix is already complete, we immediately spend the next step on
  // closing the constrained span rather than continuing to elaborate the query.
  // For Spider, emitting one complete SQL query is the task; continuing past the
  // first complete query often drifts into junk continuations that remain grammar-
  // valid but are no longer the intended answer.
  //
  // Relative to the failed attempt, the key changes are:
  // (1) close immediately on completeness instead of "keep going while valid";
  // (2) remove the aggressive candidate-boosting scheme that distorted decoding
  //     toward repetitive identifier sequences;
  // (3) use constrained decoding from the very start of the answer by opening
  //     the span immediately and then appending only parser-approved tokens;
  // (4) treat EOS as terminal and never continue after it.
  //
  // The resulting strategy is deliberately simple and high-precision: open once,
  // decode valid SQL tokens, and close as soon as a complete query is reached.
  // This directly targets the observed failure mode of over-generation inside the
  // grammar while preserving the required << >> delimiters.
  // CSD_RATIONALE_END
  // CSD_PROOF_SKETCH_BEGIN
  // parser_validity: In the outside branch, OpenConstrainedSpan sets
  //   insideConstrainedOut := true and currentConstrainedOut := [], and
  //   parser.IsValidPrefix([]) holds by precondition. In the inside-close branch,
  //   CloseConstrainedSpan is called only after checking completeness, and it
  //   exits constrained mode, so the implication becomes vacuous. In the inside-
  //   append branch, logit shaping does not change tracked state, ConstrainedStep
  //   returns a parser-permitted next token, and AppendConstrainedToken preserves
  //   parser validity. In the eos break branch there is no state change.
  //
  // suffix: In the outside branch, opening adds only the delimiter and leaves the
  //   tracked constrained content empty, so the suffix property holds trivially.
  //   In the close branch, closing appends the delimiter and resets the tracked
  //   constrained content to [], so the implication holds immediately. In the
  //   append branch, AppendConstrainedToken extends both generated and
  //   currentConstrainedOut by the same token, preserving the suffix relation. In
  //   the eos break branch there is no state change, so the invariant is preserved.
  //
  // progress: Every step-counted branch increments steps exactly once and grows
  //   generated by at most one token: opening adds the opening delimiter, closing
  //   adds the closing delimiter, and appending adds one constrained token. The
  //   eos break branch increments steps for the constrained choice but does not
  //   modify generated, which still preserves the bound
  //   |generated| <= |generatedPrefix| + steps.
  // CSD_PROOF_SKETCH_END
  generated := generatedPrefix;
  insideConstrainedOut := insideConstrained;
  currentConstrainedOut := currentConstrained;
  cost := 0;

  var steps := 0;

  while steps < maxSteps
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
    invariant |generated| <= |generatedPrefix| + steps
    invariant cost == 0
    decreases maxSteps - steps
  {
    if !insideConstrainedOut {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
      if completeNow {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
      } else {
        var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
        var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 3);

        lm.GenerateLogits(prompt + generated);

        if narrow {
          var candsNarrow := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 6, eosToken);
          helpers.ScaleAllLogits(lm, 0.7);
          helpers.BoostTokenLogits(lm, candsNarrow, 8.0);
        } else {
          if validCount <= 8 {
            var candsSmall := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 5, eosToken);
            helpers.BoostTokenLogits(lm, candsSmall, 3.0);
          }
        }

        var next := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
        steps := steps + 1;

        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }

  cost := steps;
}

