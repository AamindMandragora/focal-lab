Strategy: {
  // CSD_RATIONALE_BEGIN
  // The previous strategy fixed syntax but still behaved like a generic SQL
  // surface-form decoder: it eagerly stayed inside a broad parser-valid region and
  // let the LM emit high-probability identifier-heavy continuations such as
  // "SELECT <id>, <id>, <id> FROM <id>". On Spider, grammar validity alone is too
  // weak because the schema-narrowed grammar still admits many semantically bland
  // queries. The observed failure pattern suggests two problems:
  // (1) the decoder was not strongly enough biasing toward decisive structural SQL
  //     keywords when the frontier was broad, and
  // (2) it was willing to continue identifier/list growth without any local signal
  //     that the query was settling.
  //
  // This revision therefore switches to a more opinionated constrained policy:
  // - We still open a constrained span immediately so the whole SQL query is
  //   grammar-checked and wrapped in << >> as required.
  // - Inside the span, before each constrained choice, we explicitly shape logits
  //   toward a small set of structural SQL keywords that commonly separate useful
  //   clauses: FROM, WHERE, GROUP, ORDER, BY, HAVING, LIMIT, JOIN, ON, UNION,
  //   INTERSECT, EXCEPT, ASC, DESC, and closing punctuation/aggregates. This is
  //   done in addition to boosting top parser-valid candidates.
  // - When the valid frontier is broad, we boost structural tokens much more
  //   aggressively and penalize commas slightly, to reduce the common degenerate
  //   pattern of long identifier lists.
  // - When the frontier is narrow or near a dead end, we trust the parser frontier
  //   more and strongly boost the top valid candidates.
  // - We only close a constrained span when the current prefix is complete and the
  //   frontier is locally settled (small valid-count or dead-end-like). This keeps
  //   us from truncating too early while still allowing termination once a full
  //   query has formed.
  // - EOS remains terminal.
  //
  // The key change in response to evaluation is not just "continue longer", but
  // "use grammar plus structural keyword pressure" so that broad-valid states are
  // steered toward clause formation instead of generic identifier accumulation.
  // CSD_RATIONALE_END
  // CSD_PROOF_SKETCH_BEGIN
  // parser_validity: In the open branch, OpenConstrainedSpan enters constrained
  //   mode with empty tracked content, and [] is a valid parser prefix by
  //   precondition. In the close branch, we call CloseConstrainedSpan only after
  //   establishing parser.IsCompletePrefix(currentConstrainedOut); afterward
  //   insideConstrainedOut is false, so the implication is vacuous. In the append
  //   branch, all logit shaping and parser queries are read-only on the tracked
  //   prefix; ConstrainedStep chooses a parser-valid next token, and
  //   AppendConstrainedToken preserves validity. In the eos break branch, tracked
  //   state is unchanged.
  //
  // suffix: Opening adds only the opening delimiter while tracked constrained
  //   content is empty, so the suffix property holds trivially. Closing resets the
  //   tracked constrained content to [], making the implication vacuous. Appending
  //   extends generated and currentConstrainedOut by the same token via
  //   AppendConstrainedToken, so the suffix relation is preserved. The eos break
  //   branch leaves both unchanged.
  //
  // progress: steps is incremented exactly once on every non-breaking generation
  //   action. OpenConstrainedSpan and CloseConstrainedSpan add at most one token to
  //   generated, and AppendConstrainedToken adds exactly the chosen constrained
  //   token, so |generated| grows by at most the number of counted steps. In the
  //   eos break branch, steps increases for the constrained choice while generated
  //   does not grow, which still preserves |generated| <= |generatedPrefix| + steps.
  // CSD_PROOF_SKETCH_END
  generated := generatedPrefix;
  insideConstrainedOut := insideConstrained;
  currentConstrainedOut := currentConstrained;
  cost := 0;

  var steps := 0;
  var done := false;

  while steps < maxSteps && !done
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
    invariant |generated| <= |generatedPrefix| + steps
    invariant cost == 0
    decreases maxSteps - steps
  {
    if !insideConstrainedOut {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 4);

      if completeNow && (validCount <= 2 || narrow) {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
