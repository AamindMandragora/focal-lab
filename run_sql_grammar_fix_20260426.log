Strategy: {
  // CSD_RATIONALE_BEGIN
  // The previous strategy opened the constrained SQL span too late and let too
  // much unconstrained text leak into the answer, which produced short malformed
  // SQL fragments like "SELECT <id> <id> FROM!". For Spider, the required output
  // is a single SQL query and the evaluator requires << >> delimiters, so this
  // revision makes the policy much more decisive: if we start outside a
  // constrained span, we immediately open one on the first available step rather
  // than waiting for model evidence. Once inside, generation is parser-led.
  //
  // To improve accuracy and reduce repetition, the inside-span policy uses a
  // small amount of adaptive control before sampling: if the valid frontier is
  // narrow, we strongly boost valid candidates and penalize invalid ones; if the
  // parser reports a dead-end-like narrow state, we scale logits down and again
  // boost valid candidates so the next token stays on-grammar. We also close the
  // constrained span immediately when the parser says the current prefix is
  // complete, which avoids trailing junk after a valid SQL query. This design
  // directly targets the observed failures by ensuring the output is almost
  // entirely schema-valid SQL between delimiters, with no free-form prose and
  // fewer opportunities for unconstrained repetition.
  // CSD_RATIONALE_END
  // CSD_PROOF_SKETCH_BEGIN
  // parser_validity: In the outside branch we only open the constrained span,
  //   setting currentConstrainedOut := []; since parser.IsValidPrefix([]) holds
  //   by precondition, the invariant is preserved. In the inside-complete branch
  //   we call CloseConstrainedSpan only after parser.IsCompletePrefix holds, and
  //   the helper exits the constrained mode, so the implication becomes vacuous.
  //   In the inside-append branch, whether we first query counts/candidates or
  //   adjust logits, the only state-changing append is via AppendConstrainedToken
  //   using a token returned by ConstrainedStep, which is a parser-valid next
  //   token unless it is eosToken; on eosToken we break without changing the
  //   constrained state.
  //
  // suffix: In the outside branch, after opening we have currentConstrainedOut
  //   := [] and generated gains only the opening delimiter, so the empty tracked
  //   constrained prefix is still the suffix of length 0. In the close branch,
  //   CloseConstrainedSpan appends the closing delimiter and resets the tracked
  //   constrained prefix to [], so the suffix invariant holds immediately. In
  //   the append branch, AppendConstrainedToken appends the same token to both
  //   generated and currentConstrainedOut, preserving the equality between the
  //   generated suffix and the tracked constrained contents.
  //
  // progress: Every non-breaking iteration increments steps exactly once. The
  //   outside branch appends one opening delimiter token; the close branch
  //   appends one closing delimiter token; the inside append branch appends one
  //   constrained token; and the eosToken branch breaks after the step bump with
  //   no further growth. Hence generated grows by at most one token per counted
  //   step, so |generated| <= |generatedPrefix| + steps is preserved.
  // CSD_PROOF_SKETCH_END
  generated := generatedPrefix;
  insideConstrainedOut := insideConstrained;
  currentConstrainedOut := currentConstrained;
  cost := 0;

  var steps := 0;

  while steps < maxSteps
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
    invariant |generated| <= |generatedPrefix| + steps
    invariant cost == 0
    decreases maxSteps - steps
  {
    if !insideConstrainedOut {
      steps := steps + 1;
      generated := generated + ["<<"];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else {
      var complete := parser.IsCompletePrefix(currentConstrainedOut);
      if complete {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
      } else {
        var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
        var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 3);
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];

        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);

        if validCount <= 8 {
          var cands := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 8, eosToken);
          helpers.BoostTokenLogits(lm, cands, 8.0);
        } else {
          var cands2 := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 5, eosToken);
          helpers.BoostTokenLogits(lm, cands2, 3.0);
        }

        if narrow {
          helpers.ScaleAllLogits(lm, 0.5);
          var cands3 := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 10, eosToken);
          helpers.BoostTokenLogits(lm, cands3, 100.0);
        }

        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }

  cost := steps;
}

