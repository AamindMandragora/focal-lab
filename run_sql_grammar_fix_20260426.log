Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL generation benefits from treating the SQL query itself as
// a constrained span. The strategy tracks the full emitted text in generated,
// whether we are currently inside the SQL-constrained region, and the active
// SQL prefix currentConstrainedOut that excludes delimiter tokens.
// Outside a constrained span, generation is mostly free, but we proactively
// open a constrained span when either the model emits "<<" directly or the
// delimiter token has logit close to the current argmax; this is useful when
// the prompt format expects a single SQL query and the model is nearly ready to
// begin structured output. Inside the span, we inspect parser state: if the
// current SQL prefix is complete we close immediately; otherwise we measure how
// many valid next SQL tokens remain. When the parser is narrow (few valid next
// tokens), we use hard constrained decoding via ConstrainedStep. When the
// parser is broader, we softly bias toward a small set of top valid candidates
// by boosting their logits, then sample; only parser-valid sampled tokens are
// appended.
// This tracked state supports validity because currentConstrainedOut is updated
// only through parser-respecting transitions, and generated always ends with
// currentConstrainedOut while inside the constrained SQL span.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, either we stay outside the span
//   (implication vacuous), or we append "<<" and set currentConstrainedOut := [],
//   which is valid by the method precondition parser.IsValidPrefix([]). In the
//   complete-prefix branch, CloseConstrainedSpan sets insideConstrainedOut to
//   false, so the implication becomes vacuous. In the narrow hard-constrained
//   branch, ConstrainedStep returns either eosToken (we break without changing
//   constrained state) or a parser-valid next token, and AppendConstrainedToken
//   preserves parser validity. In the broad soft-constrained branch, we only
//   call AppendConstrainedToken after IsTokenValidNext returns true; the !valid
//   sub-branch leaves the state unchanged.
// suffix: In unconstrained generation that remains outside the span, the suffix
//   invariant is vacuous; when we open the span we set currentConstrainedOut := [],
//   so the length-0 suffix of generated matches []. CloseConstrainedSpan
//   atomically appends the closing delimiter and resets currentConstrainedOut to
//   [], making the invariant vacuous afterward. In both constrained append
//   branches, AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, so the tracked SQL prefix remains exactly the suffix
//   of generated. In the soft branch's rejection case, neither value changes.
// progress: Every loop iteration increases steps by exactly 1 before either
//   breaking or continuing. The unconstrained branch appends at most one token
//   to generated. The close branch appends only the closing delimiter, so
//   generated grows by one while steps also grows by one. The narrow append
//   branch appends at most one SQL token; its EOS sub-branch appends nothing.
//   The broad soft branch either appends one valid token or rejects the sampled
//   token and appends nothing. Hence |generated| never exceeds
//   |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;

    if argmax == eosToken {
      break;
    } else if argmax == "<<" || openLogit >= argmaxLogit - 2.0 {
      generated := generated + ["<<"];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else {
      generated := generated + [argmax];
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= 3 {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var candidates := helpers.TopValidCandidates(
          lm, parser, constrainedPrompt, currentConstrainedOut, 4, eosToken
        );
        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
        helpers.BoostTokenLogits(lm, candidates, 5.0);
        var next := lm.ChooseNextTokenUnconstrained();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
          if valid {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
