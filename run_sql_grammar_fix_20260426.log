        var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 4);
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];

        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);

        if validCount <= 6 {
          helpers.ScaleAllLogits(lm, 0.5);
          var cands := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 12, eosToken);
          helpers.BoostTokenLogits(lm, cands, 12.0);
        } else {
          var cands2 := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 8, eosToken);
