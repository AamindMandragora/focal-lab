Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL with schema-narrowed grammar. We track the full generated
// answer in `generated`, whether we are currently inside a constrained SQL span
// in `insideConstrainedOut`, and the SQL tokens accumulated inside that span in
// `currentConstrainedOut`. Outside the span, we generate freely but bias toward
// opening a constrained region when the model already appears ready to emit SQL:
// if the logit of "<<" is close to the current argmax, or if the argmax itself
// contains SQL-ish markers like SELECT/FROM/WHERE, we proactively open the span.
// Inside the span, the parser is the source of validity: when the current SQL
// prefix is complete we close immediately; otherwise we prefer a speculative
// fast path that commits the model argmax if it is parser-valid, and fall back
// to a constrained helper otherwise. This tracked state ensures that only the
// SQL substring between delimiters is parser-constrained, while the full answer
// still records delimiter tokens and any unconstrained prefix already emitted.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, either we stay outside the span
//   (so the implication is vacuous), or we append "<<" and set
//   currentConstrainedOut := [], which is a valid prefix by precondition. In
//   the complete-prefix branch, CloseConstrainedSpan sets insideConstrainedOut
//   to false, again making the implication vacuous. In the speculative-inside
//   branch we call AppendConstrainedToken only after IsTokenValidNext returns
//   true, so the new constrained prefix remains valid. In the fallback-inside
//   branch, ConstrainedStep returns either EOS (break) or a valid next token,
//   and AppendConstrainedToken preserves validity.
// suffix: Outside the span, either state is unchanged or we newly enter with
//   currentConstrainedOut := []; the empty sequence is always the suffix of
//   generated of length 0. CloseConstrainedSpan atomically appends the closing
//   delimiter and resets currentConstrainedOut to [], so the suffix invariant
//   holds. In either append-inside branch, AppendConstrainedToken appends the
//   same token to both generated and currentConstrainedOut, preserving the
//   equality between the active constrained suffix and the tracked prefix.
// progress: Each loop iteration increments `steps` by exactly 1 in every
//   non-breaking path. The unconstrained branch appends at most one token to
//   generated; the close branch appends one closing delimiter token; the inside
//   append branches append one constrained token; and EOS branches break
//   without further growth. Therefore |generated| never exceeds
//   |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;

    if openLogit >= argmaxLogit - 3.0 && argmax != eosToken {
      generated := generated + ["<<"];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else if Contains(argmax, "SELECT") || Contains(argmax, "FROM") || Contains(argmax, "WHERE") {
      generated := generated + ["<<"];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else if argmax == eosToken {
      break;
    } else {
      generated := generated + [argmax];
      if argmax == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);

      if argmaxValid && argmax != eosToken {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

cost := steps;

