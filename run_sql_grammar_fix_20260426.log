Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy under-constrained broad parser states and sometimes let
// unconstrained or softly-biased token choices drift into malformed SQL-like
// text (for example fragments such as "SELECT avg <id> FROM"). For Spider, the
// output is almost entirely the SQL query itself, so accuracy is improved by
// making the SQL span dominant rather than optional once it begins.
// Revised strategy:
// 1. Outside the constrained span, strongly prefer opening "<<" immediately;
//    if the model instead prefers EOS we stop, otherwise we still either open
//    the span or emit one unconstrained token. This preserves the required
//    delimiters while starting SQL generation early.
// 2. Inside the constrained span, never sample an arbitrary token. If the
//    current SQL prefix is complete, close the span immediately. Otherwise,
//    always obtain the next token from helpers.ConstrainedStep, which is schema-
//    and grammar-aware. This removes the main failure mode from the previous
//    attempt: broad-state free sampling that produced invalid or low-accuracy
//    continuations.
// 3. EOS remains terminal: if ConstrainedStep returns eosToken before the SQL
//    prefix is complete, we stop rather than inventing text outside the grammar.
// This design is more conservative but better aligned with Spider evaluation:
// once inside "<< ... >>", every SQL token is parser-approved.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, if we remain outside, the implication
//   is vacuous; if we open the constrained span, currentConstrainedOut becomes
//   [], which is valid by the precondition parser.IsValidPrefix([]). In the
//   inside-complete branch, CloseConstrainedSpan sets insideConstrainedOut to
//   false, so the implication is vacuous. In the inside-incomplete branch,
//   ConstrainedStep either returns eosToken and we leave constrained state
//   unchanged, or returns a parser-valid next token which AppendConstrainedToken
//   uses to preserve parser validity.
// suffix: In the outside branch that stays outside, the invariant is vacuous;
//   when we open, currentConstrainedOut is [], and the empty sequence is the
//   suffix of generated. In the close branch, insideConstrainedOut becomes
//   false, so the invariant is vacuous afterward. In the constrained append
//   branch, AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, preserving the suffix equality; in the eos sub-branch
//   neither generated nor currentConstrainedOut changes.
// progress: Each iteration increments steps exactly once. The outside branch
//   appends at most one token to generated. The close branch appends one closing
//   delimiter token while steps increases by one. The constrained append branch
//   appends at most one token, and the eos sub-branch appends none. Therefore
//   |generated| grows by at most one per step, preserving
//   |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var best := helpers.GetHighestLogitToken(lm);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    var bestLogit := helpers.GetTokenLogit(lm, best);
    steps := steps + 1;

    if best == eosToken {
      helpers.cost := helpers.cost + 1;
      break;
    } else if best == "<<" || openLogit >= bestLogit - 100.0 {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      if next == eosToken {
        break;
      } else if next == "<<" {
        var openedGenerated2, openedInside2, openedCurrent2 := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated2;
        insideConstrainedOut := openedInside2;
        currentConstrainedOut := openedCurrent2;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

