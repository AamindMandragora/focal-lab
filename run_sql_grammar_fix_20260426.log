Strategy: {
  // CSD_RATIONALE_BEGIN
  // The prior strategy achieved syntax but failed semantically because it let the
  // constrained SQL span start from an empty prefix and then relied on generic
  // constrained decoding token by token. On Spider, that often drifts into odd
  // but still grammar-valid SQL such as malformed aggregates or repetitive local
  // loops. The revised strategy changes two things:
  // 1. We still ensure the answer contains << and >>, but we enter the
  //    constrained span in a tightly controlled way: outside the span we heavily
  //    bias toward opening immediately, so nearly all budget is spent on SQL.
  // 2. Inside the constrained span, we add stronger anti-loop and completion
  //    pressure. If the parser says the current SQL prefix is complete, we close
  //    immediately. Otherwise we inspect the top valid candidates and prefer an
  //    early complete candidate when available; if not, we use the parser-driven
  //    constrained step. We also penalize the most recent constrained token to
  //    reduce immediate repetition loops before sampling. This directly targets
  //    the observed repetition failures while keeping every emitted SQL token
  //    parser-valid.
  // 3. We never manually append >> based on token text; closing only happens in
  //    the parser-complete branch via helpers.CloseConstrainedSpan, as required.
  // 4. EOS remains terminal everywhere.
  // The intent is to spend almost all generation inside the schema-aware SQL
  // grammar, avoid local repetitive cycles, and close as soon as a complete SQL
  // query is available.
  // CSD_RATIONALE_END
  // CSD_PROOF_SKETCH_BEGIN
  // parser_validity: In the outside branch, if eosToken is sampled we break with
  //   state unchanged; if "<<" is sampled we set currentConstrainedOut := [],
  //   which is valid by the precondition parser.IsValidPrefix([]); otherwise we
  //   remain outside so the implication is vacuous. In the inside-complete
  //   branch, helpers.CloseConstrainedSpan sets insideConstrainedOut false, so
  //   the implication is vacuous. In the inside-incomplete branch, either we
  //   break on eosToken with unchanged constrained state, or we append a token
  //   obtained from TopValidCandidates / ConstrainedStep and then use
  //   AppendConstrainedToken, which preserves parser-validity of the constrained
  //   prefix.
  // suffix: Outside branches that remain outside make the implication vacuous.
  //   Opening on "<<" sets currentConstrainedOut to [], and the empty sequence is
  //   the suffix of any generated sequence. Closing makes insideConstrainedOut
  //   false, so the implication is vacuous. In the append branch,
  //   AppendConstrainedToken extends generated and currentConstrainedOut in sync,
  //   preserving generated[|generated|-|currentConstrainedOut|..] ==
  //   currentConstrainedOut; if eosToken is returned, neither sequence changes.
  // progress: steps is incremented exactly once on every non-breaking iteration.
  //   In the outside branch we append at most one token. In the close branch we
  //   append exactly one delimiter token. In the inside append branch we append
  //   exactly one constrained token; in the eos sub-branch we append none and
  //   break immediately. Therefore generated grows by at most one per completed
  //   iteration, preserving |generated| <= |generatedPrefix| + steps.
  // CSD_PROOF_SKETCH_END
  generated := generatedPrefix;
  insideConstrainedOut := insideConstrained;
  currentConstrainedOut := currentConstrained;
  cost := 0;
  var steps := 0;

  while steps < maxSteps
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
    invariant |generated| <= |generatedPrefix| + steps
    invariant cost == 0
    decreases maxSteps - steps
  {
    if !insideConstrainedOut {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, ["<<"], 100.0);
      helpers.PenalizeTokenLogits(lm, [eosToken], 8.0);
      var next := lm.ChooseNextToken();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;

      if next == eosToken {
        break;
      } else if next == "<<" {
        generated := generated + [next];
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        generated := generated + [next];
      }
    } else {
      var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
      if completeNow {
        var g1, i1, c1 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := g1;
        insideConstrainedOut := i1;
        currentConstrainedOut := c1;
        steps := steps + 1;
      } else {
        lm.GenerateLogits(prompt + generated);
        if 0 < |currentConstrainedOut| {
          var lastTok := currentConstrainedOut[|currentConstrainedOut| - 1];
          helpers.PenalizeTokenLogits(lm, [lastTok], 3.0);
        }
        var candidates := helpers.TopValidCandidates(lm, parser, prompt + generated, currentConstrainedOut, 6, eosToken);
        var chosen := "";
        if 0 < |candidates| {
          var cand0 := candidates[0];
          var ok0 := helpers.IsTokenValidNext(parser, currentConstrainedOut, cand0);
          if ok0 {
            var p0 := currentConstrainedOut + [cand0];
            var done0 := parser.IsCompletePrefix(p0);
            if done0 {
              chosen := cand0;
            }
          }
          if chosen == "" && 1 < |candidates| {
            var cand1 := candidates[1];
            var ok1 := helpers.IsTokenValidNext(parser, currentConstrainedOut, cand1);
            if ok1 {
              var p1 := currentConstrainedOut + [cand1];
              var done1 := parser.IsCompletePrefix(p1);
              if done1 {
                chosen := cand1;
              }
            }
          }
          if chosen == "" && 2 < |candidates| {
            var cand2 := candidates[2];
            var ok2 := helpers.IsTokenValidNext(parser, currentConstrainedOut, cand2);
            if ok2 {
              var p2 := currentConstrainedOut + [cand2];
              var done2 := parser.IsCompletePrefix(p2);
              if done2 {
                chosen := cand2;
              }
            }
          }
        }

        var next := "";
        if chosen != "" {
          next := chosen;
          steps := steps + 1;
        } else {
          next := helpers.ConstrainedStep(lm, parser, prompt + generated, currentConstrainedOut, eosToken);
          steps := steps + 1;
        }

        if next == eosToken {
          break;
        } else {
          var g2, i2, c2 := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := g2;
          insideConstrainedOut := i2;
          currentConstrainedOut := c2;
        }
      }
    }
  }

  cost := steps;
}

