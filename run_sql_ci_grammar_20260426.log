Strategy: // CSD_RATIONALE_BEGIN
// The evaluation failure shows that the prior strategy still let unconstrained LM
// logits dominate token choice inside SQL. Although every emitted token was
// parser-valid often enough to keep syntax at 100%, the SQL content degraded into
// bizarre but grammatical continuations. For Spider, the constrained span should
// behave much closer to pure grammar-constrained decoding than to lightly biased
// free decoding.
//
// The revised strategy therefore makes a stronger change: once inside the SQL
// span, it always uses `ConstrainedStep` for token generation. This delegates
// token choice to the verified constrained-decoding helper at every SQL step and
// removes the fragile branch that sampled from unrestricted logits and only later
// checked validity. The only remaining decision inside the span is whether the
// current constrained prefix is already complete; if so, we immediately close the
// span with `CloseConstrainedSpan`, otherwise we take exactly one
// `ConstrainedStep`.
//
// Outside the constrained span, we still force opening `<<` as early as possible,
// because the task requires the final output to contain `<< >>` and the SQL query
// itself should be almost entirely parser-controlled. To avoid wasting many steps
// before the open delimiter, we strongly boost `<<` and either open immediately
// when it is chosen or append a single unconstrained token otherwise. This keeps
// the strategy simple, verifier-friendly, and much more aligned with the task:
// nearly all query tokens now come from schema-aware constrained decoding.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span branch, if EOS is chosen we break without
//   changing constrained state; if "<<" is chosen, `OpenConstrainedSpan` sets the
//   constrained prefix to `[]`, which is valid by precondition; otherwise we stay
//   outside constrained mode so the implication remains vacuous. In the
//   complete-prefix branch, `CloseConstrainedSpan` exits constrained mode, making
//   the implication vacuous. In the active constrained branch, `ConstrainedStep`
//   returns the next constrained token (or EOS); on the non-EOS path,
//   `AppendConstrainedToken` extends the constrained prefix with that token and
//   preserves parser validity.
// suffix: In the outside-span branch, remaining outside keeps the implication
//   vacuous; after `OpenConstrainedSpan`, the constrained prefix is `[]`, which is
//   the empty suffix of `generated`. In the complete-prefix branch,
//   `CloseConstrainedSpan` resets the constrained prefix to `[]`, so the suffix
//   property is immediate. In the active constrained branch,
//   `AppendConstrainedToken` appends the same token to both `generated` and
//   `currentConstrainedOut`, so the tracked constrained prefix remains exactly the
//   suffix of `generated`.
// progress: In the outside-span branch, exactly one generation step is charged by
//   incrementing `steps`; either no token is appended before break, one token is
//   appended directly, or `OpenConstrainedSpan` appends at most one delimiter
//   token, so `|generated| <= |generatedPrefix| + steps` is preserved. In the
//   complete-prefix branch, `CloseConstrainedSpan` uses one step and appends at
//   most one delimiter token, so the same bound holds after `steps := steps + 1`.
//   In the active constrained branch, `ConstrainedStep` consumes one step; if it
//   returns EOS we break, otherwise `AppendConstrainedToken` appends one token,
//   preserving the bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 100.0);
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      if next == "<<" {
        var gOpen, iOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
        generated := gOpen;
        insideConstrainedOut := iOpen;
        currentConstrainedOut := cOpen;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var gClose, iClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := gClose;
      insideConstrainedOut := iClose;
      currentConstrainedOut := cClose;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var nextSql := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if nextSql == eosToken {
        break;
      } else {
        var gApp, iApp, cApp := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, nextSql
        );
        generated := gApp;
        insideConstrainedOut := iApp;
        currentConstrainedOut := cApp;
      }
    }
  }
}

cost := steps;

