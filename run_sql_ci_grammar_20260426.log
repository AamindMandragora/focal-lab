Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy mixed constrained decoding with occasional
// unconstrained sampling inside the SQL span. That preserved syntax but hurt
// exactness on Spider: schema-aware SQL generation should stay tightly aligned
// with the parser at every token, and the observed malformed-looking outputs
// indicate that soft-biased unconstrained choices inside the span were still
// drifting into poor local decisions.
// 
// This revision uses a stricter two-phase policy. Outside the SQL span, it
// takes exactly one unconstrained step at a time and opens a constrained span
// immediately when the delimiter token contains "<<". Inside the span, it never
// samples unconstrained. Instead, it always uses `ConstrainedStep`, which is
// parser-respecting and schema-aware. As soon as the constrained prefix becomes
// complete, it closes the span immediately with `CloseConstrainedSpan`; if
// `ConstrainedStep` returns EOS, generation stops immediately as required.
// 
// The key change is therefore: no soft unconstrained token choice while inside
// SQL, and no chunking that could skip over a good place to transition. This
// sacrifices some flexibility for much stronger adherence to the grammar and
// schema, which is the right tradeoff for Spider text-to-SQL.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span branch, either we emit EOS and break, or
//   we emit one unconstrained token. If that token opens a span, we set
//   `insideConstrainedOut := true` and `currentConstrainedOut := []`, which is
//   a valid parser prefix by precondition; otherwise we remain outside, so the
//   implication is vacuous. In the complete-prefix branch, `CloseConstrainedSpan`
//   makes `insideConstrainedOut` false, so the invariant holds vacuously. In
//   the constrained-step branch, `ConstrainedStep` provides a parser-respecting
//   next token (unless it returns EOS, in which case we break), and
//   `AppendConstrainedToken` preserves parser validity.
// suffix: In the outside-span branch, if we stay outside then the implication
//   is vacuous. If the emitted token opens a span, then `generated` ends with
//   the delimiter while `currentConstrainedOut` is `[]`; the empty sequence is
//   exactly the length-0 suffix of `generated`. In the complete-prefix branch,
//   `CloseConstrainedSpan` exits constrained mode and resets the tracked
//   constrained contents, so the implication is vacuous afterward. In the
//   constrained-step branch, `AppendConstrainedToken` appends the same token to
//   both `generated` and `currentConstrainedOut`, preserving the suffix
//   equality.
// progress: In the outside-span branch, one step is consumed and at most one
//   token is appended to `generated`, so `|generated| <= |generatedPrefix| +
//   steps` is preserved. In the complete-prefix branch, closing the span uses
//   one step and appends at most one token, so the bound is preserved. In the
//   constrained-step branch, one step is consumed; on EOS we break without
//   needing further preservation, and otherwise `AppendConstrainedToken` adds
//   exactly one token while `steps` increases by one, maintaining the bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if Contains(next, "<<") {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

