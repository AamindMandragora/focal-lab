Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy waited for the model to emit a token containing "<<"
// before ever entering constrained decoding. The evaluation failures show that
// this never happened on Spider, so no parser-governed SQL chunk was produced
// and the extractor found no `<< ... >>` answer at all. The core fix is to stop
// relying on the model to open the constrained region.
//
// This revision force-opens a constrained span immediately on the first step by
// calling `OpenConstrainedSpan`. After that, decoding stays inside the SQL span
// and uses parser-guided constrained steps to build the query token by token.
// This guarantees that every non-empty run uses an internal constrained chunk
// and that the final output contains the required delimiters.
//
// To avoid the earlier premature-close issue, the strategy still uses a late
// close policy: when the constrained prefix is complete, it closes only if the
// parser reports that there are no valid continuations. Otherwise it keeps
// decoding. If the active prefix ever ceases to be a live narrowable prefix, it
// rolls back to the longest valid prefix and continues from there. If the loop
// budget is about to end while still inside the span, it spends the final step
// closing the span when the current prefix is complete so the extractor still
// receives a delimited answer.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the forced-open branch, `OpenConstrainedSpan` enters
//   constrained mode with `currentConstrainedOut := []`, and `[]` is a valid
//   parser prefix by precondition. In the rollback branch, `RollbackToValidPrefix`
//   returns a valid prefix and `RollbackConstrainedSpan` realigns the generated
//   suffix to exactly that valid prefix. In the close branch,
//   `CloseConstrainedSpan` leaves constrained mode, so the implication is
//   vacuous. In the constrained-step branch, if EOS is returned we break;
//   otherwise `AppendConstrainedToken` extends the constrained prefix with a
//   parser-valid token, preserving validity.
// suffix: In the forced-open branch, the constrained content is `[]`, which is
//   the length-0 suffix of `generated`. In the rollback branch, the stable
//   prefix `generated[..|generated| - |currentConstrainedOut|]` is preserved and
//   `RollbackConstrainedSpan` resets the generated constrained suffix to the
//   rolled-back prefix, so the suffix relation holds. In the close branch,
//   constrained mode ends and the implication is vacuous. In the constrained-
//   step branch, `AppendConstrainedToken` appends the same token to both
//   `generated` and `currentConstrainedOut`, preserving suffix equality.
// progress: In the forced-open branch, one step is consumed and at most one
//   token is appended to `generated`, so the length bound advances with `steps`.
//   In the rollback branch, one step is consumed and `generated` does not grow.
//   In the close branch, one step is consumed and at most one token is appended.
//   In the constrained-step branch, one step is consumed; if EOS is returned we
//   break without growing `generated`, otherwise exactly one token is appended,
//   so `|generated| <= |generatedPrefix| + steps` is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant insideConstrainedOut ==> generated == generated[..|generated| - |currentConstrainedOut|] + currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    if steps + 1 == maxSteps {
      var completeLast := parser.IsCompletePrefix(currentConstrainedOut);
      if completeLast {
        var closedGeneratedLast, closedInsideLast, closedCurrentLast := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGeneratedLast;
        insideConstrainedOut := closedInsideLast;
        currentConstrainedOut := closedCurrentLast;
        steps := steps + 1;
      } else {
        break;
      }
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if !narrow {
        var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
          parser, stablePrefix, generated, currentConstrainedOut
        );
        generated := rolledGenerated;
        currentConstrainedOut := rolledCurrent;
        if parser.IsCompletePrefix(currentConstrainedOut) {
          var closedGeneratedRb, closedInsideRb, closedCurrentRb := helpers.CloseConstrainedSpan(
            lm, parser, generated, currentConstrainedOut
          );
          generated := closedGeneratedRb;
          insideConstrainedOut := closedInsideRb;
          currentConstrainedOut := closedCurrentRb;
        }
