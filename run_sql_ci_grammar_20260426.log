Strategy: {
  // CSD_RATIONALE_BEGIN
  // The previous strategy failed because it forced the model into a constrained
  // span immediately, before it had produced any task-specific intent in free
  // text. On Spider prompts, that often collapses generation to a generic short
  // SQL skeleton such as `SELECT <id> FROM <id>`, which is syntactically valid
  // but rarely correct for the question and schema.
  //
  // This revision delays entry into the constrained span. We first let the model
  // generate an unconstrained prefix chunk, stopping early if it emits the open
  // delimiter token `<<` or EOS. If the model does not open a span on its own,
  // we then force exactly one constrained span by inserting `<<`. The intent is
  // to preserve the required extractor-friendly `<< ... >>` output while giving
  // the model a short opportunity to express latent planning tokens before SQL
  // grammar enforcement begins.
  //
  // Inside the constrained span, decoding remains parser-governed token by token.
  // When the constrained prefix is incomplete, any non-EOS constrained token is
  // appended. When the constrained prefix is complete, we use EOS as the only
  // signal for closure: if constrained decoding returns EOS, we close the span;
  // if it returns a non-EOS token, we stop rather than extend a complete query
  // into likely garbage. If EOS appears while incomplete, we also stop, honoring
  // EOS terminality and avoiding fabricated repairs.
  //
  // Compared with the previous attempt, the main change is therefore strategic:
  // do not begin grammar-constrained SQL at position 0. Give the model a brief
  // unconstrained runway, then enforce one well-formed SQL span.
  // CSD_RATIONALE_END
  // CSD_PROOF_SKETCH_BEGIN
  // parser_validity:
  // - Unconstrained-chunk branch: this branch runs only when not inside a span,
  //   so `insideConstrainedOut` remains false and the implication is vacuous.
  // - Open-span branch: `OpenConstrainedSpan` enters constrained mode with empty
  //   constrained content, and `parser.IsValidPrefix([])` holds by precondition.
  // - Inside branch with non-EOS and incomplete prefix: we cache `completeNow`
  //   and call `AppendConstrainedToken` only when `!completeNow`; that helper
  //   preserves validity of the extended constrained prefix.
  // - Inside branch with EOS and close: `CloseConstrainedSpan` sets
  //   `insideConstrainedOut` to false, so the implication is vacuous afterward.
  // - Inside branch that breaks on EOS/incomplete or non-EOS/complete: state is
  //   unchanged before break, so the invariant is preserved.
  //
  // suffix:
  // - Unconstrained-chunk branch: it executes only when outside constrained mode,
  //   so the suffix implication is vacuous throughout.
  // - Open-span branch: after opening, the constrained content is empty, so the
  //   suffix of length 0 of `generated` equals `currentConstrainedOut`.
  // - Inside branch with non-EOS and incomplete prefix: `AppendConstrainedToken`
  //   appends the same token to both `generated` and `currentConstrainedOut`,
  //   preserving that the active constrained content is the generated suffix.
  // - Inside branch with EOS and close: after closing, `insideConstrainedOut` is
  //   false, so the implication becomes vacuous.
  // - Inside branch that breaks without mutation: generated and constrained state
  //   do not change, so the suffix relation is preserved.
  //
  // progress:
  // - Unconstrained-chunk branch: `steps` increases by `used`, and the helper
  //   appends at most one token per used step, so `|generated|` grows by at most
  //   the increase in `steps`.
  // - Open-span branch: one opening token is appended and `steps` increases by 1,
  //   preserving `|generated| <= |generatedPrefix| + steps`.
  // - Inside branch with non-EOS and incomplete prefix: one constrained sample
  //   consumes one step and appending that token increases `|generated|` by 1.
  // - Inside branch with EOS and close: the constrained sample costs 1 step and
  //   the close costs 1 more step while appending only the closing delimiter, so
  //   total growth is bounded by total step growth.
  // - Inside branch that breaks after sampling: `steps` increases by 1 and
  //   `generated` does not grow, so the bound still holds.
  //
  // cost accounting:
  // - `steps` is the returned cost counter. Every cost-bumping helper call is
  //   mirrored by the same increment to `steps`: `UnconstrainedChunk` adds the
  //   returned `used`, opening adds 1, each constrained sample adds 1, and a
  //   successful close adds 1.
  // - Non-bumping helpers (`AppendConstrainedToken` and parser queries) do not
  //   change `steps`. Thus `cost := steps` is consistent and `cost <= maxSteps`
  //   follows from the loop guard and guarded close.
  // CSD_PROOF_SKETCH_END
  generated := generatedPrefix;
  insideConstrainedOut := insideConstrained;
  currentConstrainedOut := currentConstrained;
  cost := 0;

  var steps := 0;
  var spanOpened := insideConstrained;

  while steps < maxSteps
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
    invariant |generated| <= |generatedPrefix| + steps
    invariant cost == 0
    decreases maxSteps - steps
  {
    if !insideConstrainedOut {
      if !spanOpened {
        var remaining := maxSteps - steps;
        var chunkBudget := remaining;
        if 3 < chunkBudget {
          chunkBudget := 3;
        }
        var chunkGenerated, stoppedOnOpen, stoppedOnEos, used := helpers.UnconstrainedChunk(
          lm, prompt, generated, chunkBudget, "<<", eosToken
        );
        generated := chunkGenerated;
        steps := steps + used;

        if stoppedOnEos {
          break;
        } else {
          if stoppedOnOpen {
            insideConstrainedOut := true;
            currentConstrainedOut := [];
            spanOpened := true;
          } else {
            if steps < maxSteps {
              var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
              generated := openedGenerated;
              insideConstrainedOut := openedInside;
              currentConstrainedOut := openedCurrent;
              steps := steps + 1;
              spanOpened := true;
            } else {
              break;
            }
          }
        }
      } else {
        break;
      }
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;

      if next == eosToken {
        if completeNow {
          if steps < maxSteps {
            var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
              lm, parser, generated, currentConstrainedOut
            );
            generated := closedGenerated;
            insideConstrainedOut := closedInside;
            currentConstrainedOut := closedCurrent;
            steps := steps + 1;
          }
          break;
        } else {
          break;
        }
      } else {
        if !completeNow {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        } else {
          break;
        }
      }
    }
  }

  cost := steps;
}

