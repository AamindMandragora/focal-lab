Strategy: {
  // CSD_RATIONALE_BEGIN
  // The previous strategy failed evaluation because it often never emitted any
  // constrained span delimiters at all: after one unconstrained token it could
  // break while still outside constrained mode, so the extractor never saw a
  // `<< ... >>` answer and the parser-governed chunk was never used.
  //
  // This revision changes the high-level policy to fit Spider extraction:
  // (1) if we start outside constrained mode, we immediately open exactly one
  //     constrained span before generating SQL tokens;
  // (2) while inside the span, every generation step is parser-governed via
  //     `ConstrainedStep`, so the SQL body is always produced by the constrained
  //     decoder;
  // (3) as soon as the parser reports a complete prefix, we close the span with
  //     `CloseConstrainedSpan`, yielding an extractable `<< ... >>` final answer;
  // (4) if EOS is sampled inside the constrained span, we close the span if the
  //     current prefix is complete, otherwise we stop to respect EOS terminality.
  //
  // The strategy is intentionally simple and extractor-friendly: it prioritizes
  // producing one schema-valid SQL chunk inside delimiters over any free-form
  // preamble/postamble. This directly addresses both reported failure modes:
  // missing constrained chunk and missing `<< >>`.
  // CSD_RATIONALE_END
  // CSD_PROOF_SKETCH_BEGIN
  // parser_validity:
  // - Open branch: `OpenConstrainedSpan` enters constrained mode with empty
  //   constrained content, which is parser-valid by the parser precondition.
  // - Constrained-step branch with non-EOS token: `ConstrainedStep` chooses a
  //   parser-valid next token and `AppendConstrainedToken` extends the current
  //   constrained prefix accordingly, so validity is preserved.
  // - Close branch after a complete prefix: `CloseConstrainedSpan` exits
  //   constrained mode, making the implication vacuous.
  // - EOS branch: if complete we close and the implication is vacuous; if not,
  //   we break immediately without changing state, so the invariant remains true.
  //
  // suffix:
  // - Open branch: after opening, the constrained content is empty, so the
  //   generated suffix of length 0 equals `currentConstrainedOut` trivially.
  // - Constrained-step append branch: `AppendConstrainedToken` appends the same
  //   token to both `generated` and `currentConstrainedOut`, preserving the
  //   suffix equality.
  // - Close branch after completeness: once closed, `insideConstrainedOut` is
  //   false, so the implication is vacuous.
  // - EOS branch without close: state is unchanged before break, so the suffix
  //   relation is preserved.
  //
  // progress:
  // - Open branch consumes one step and appends only the opening delimiter, so
  //   generated length increases by at most one while `steps` increases by one.
  // - Constrained-step append branch consumes one step and appends exactly one
  //   SQL token, so the bound `|generated| <= |generatedPrefix| + steps` is
  //   preserved.
  // - Close branch consumes one step and appends only the closing delimiter, so
  //   length growth is again at most the step growth.
  // - EOS break branch consumes one step but does not append a token before
  //   stopping, so the bound still holds.
  // CSD_PROOF_SKETCH_END
  generated := generatedPrefix;
  insideConstrainedOut := insideConstrained;
  currentConstrainedOut := currentConstrained;
  cost := 0;

  var steps := 0;

  while steps < maxSteps
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
    invariant |generated| <= |generatedPrefix| + steps
    invariant cost == 0
    decreases maxSteps - steps
  {
    if !insideConstrainedOut {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
      if completeNow {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
        break;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt := prompt + stablePrefix;
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          var completeOnEos := parser.IsCompletePrefix(currentConstrainedOut);
          if completeOnEos && steps < maxSteps {
            var closedGeneratedE, closedInsideE, closedCurrentE := helpers.CloseConstrainedSpan(
              lm, parser, generated, currentConstrainedOut
            );
            generated := closedGeneratedE;
            insideConstrainedOut := closedInsideE;
            currentConstrainedOut := closedCurrentE;
            steps := steps + 1;
          }
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }

  cost := steps;
}

