Strategy: {
  // CSD_RATIONALE_BEGIN
  // The prior strategy guaranteed a `<< ... >>` span and high syntax rate, but it
  // closed the span at the first parser-complete SQL prefix. On Spider, many
  // grammar-complete prefixes are semantically premature (for example a short
  // `SELECT ... FROM ...` prefix before filters, grouping, ordering, or limits),
  // so the decoder often emitted a truncated yet syntactically valid query.
  //
  // This revision keeps the single extractor-friendly constrained span, but
  // changes the stopping policy inside that span:
  // (1) we still open a constrained span immediately when outside, ensuring the
  //     output contains `<< >>`;
  // (2) once inside, generation remains parser-governed token-by-token;
  // (3) when the current constrained prefix is complete, we do NOT immediately
  //     close. Instead, we ask for one more constrained token. If the model now
  //     chooses EOS, we interpret that as evidence that the complete SQL query is
  //     actually finished and then close the span; otherwise we append the token
  //     and continue;
  // (4) if EOS appears while the current prefix is incomplete, we stop rather
  //     than fabricate tokens, respecting EOS terminality.
  //
  // Intuitively, parser completeness is treated as "may stop" rather than "must
  // stop". This addresses the observed truncation failures while preserving the
  // strong syntax guarantees from parser-constrained decoding.
  // CSD_RATIONALE_END
  // CSD_PROOF_SKETCH_BEGIN
  // parser_validity:
  // - Open branch: `OpenConstrainedSpan` starts a constrained span with empty
  //   constrained content, and the empty prefix is parser-valid by precondition.
  // - Inside branch, non-EOS token: `ConstrainedStep` is parser-aware and
  //   `AppendConstrainedToken` extends `currentConstrainedOut` with that token,
  //   preserving `parser.IsValidPrefix(currentConstrainedOut)`.
  // - Inside branch, EOS with complete prefix and close: `CloseConstrainedSpan`
  //   exits constrained mode, so the implication becomes vacuous.
  // - Inside branch, EOS with incomplete prefix and break: no state changes occur
  //   before break, so validity is preserved.
  //
  // suffix:
  // - Open branch: after opening, constrained content is empty, so the generated
  //   suffix of length 0 equals `currentConstrainedOut`.
  // - Inside branch, non-EOS token: `AppendConstrainedToken` appends the same
  //   token to `generated` and to the constrained content, preserving the suffix
  //   equality.
  // - Inside branch, EOS with complete prefix and close: after closing,
  //   `insideConstrainedOut` is false, so the implication is vacuous.
  // - Inside branch, EOS with incomplete prefix and break: state is unchanged, so
  //   the suffix invariant remains true.
  //
  // progress:
  // - Open branch: one helper step is consumed and only the opening delimiter is
  //   appended, so `|generated|` grows by at most the increment in `steps`.
  // - Inside branch, non-EOS token: one constrained step is counted and exactly
  //   one token is appended via `AppendConstrainedToken`, preserving
  //   `|generated| <= |generatedPrefix| + steps`.
  // - Inside branch, EOS with complete prefix and close: the EOS sampling uses
  //   one step and the close uses one more step while appending only the closing
  //   delimiter, so total growth is bounded by total step growth.
  // - Inside branch, EOS with incomplete prefix and break: `steps` increases by
  //   one and `generated` does not grow, so the bound still holds.
  //
  // cost accounting:
  // - `steps` is the sole returned cost counter. Each cost-bumping helper call in
  //   the loop is matched by the corresponding increment of `steps`: opening adds
  //   1, each constrained sample adds 1, and a successful close adds another 1.
  // - `AppendConstrainedToken` is non-bumping, so appending after a sampled token
  //   does not change `steps`. Therefore returning `cost := steps` is consistent
  //   with the intended accounting and always yields `cost <= maxSteps`.
  // CSD_PROOF_SKETCH_END
  generated := generatedPrefix;
  insideConstrainedOut := insideConstrained;
  currentConstrainedOut := currentConstrained;
  cost := 0;

  var steps := 0;

  while steps < maxSteps
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
    invariant |generated| <= |generatedPrefix| + steps
    invariant cost == 0
    decreases maxSteps - steps
  {
    if !insideConstrainedOut {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;

      if next == eosToken {
        var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
        if completeNow {
          if steps < maxSteps {
            var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
              lm, parser, generated, currentConstrainedOut
            );
            generated := closedGenerated;
            insideConstrainedOut := closedInside;
            currentConstrainedOut := closedCurrent;
            steps := steps + 1;
          }
          break;
        } else {
          break;
        }
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }

  cost := steps;
}

