Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL benefits from staying unconstrained for ordinary natural
// language / formatting tokens, but switching aggressively into grammar-guided
// decoding once a SQL span begins. This strategy tracks the full generated
// output (`generated`), whether we are currently inside a constrained SQL span
// (`insideConstrainedOut`), and the active SQL fragment without delimiters
// (`currentConstrainedOut`).
//
// Outside a constrained span, the strategy uses chunked unconstrained decoding
// to move quickly until either EOS or the open-span delimiter "<<" appears.
// Inside a constrained span, it distinguishes two cases: if the current SQL
// prefix is already complete, it closes immediately with `CloseConstrainedSpan`;
// otherwise it queries parser structure. When the parser reports a narrow state
// (`DeadEndDetection`), it uses hard constrained decoding (`ConstrainedStep`)
// to avoid drifting into invalid schema-specific SQL. When the parser is not
// narrow, it takes a speculative fast path: score the current context, test the
// model argmax against parser validity, and append it directly if valid;
// otherwise fall back to `ConstrainedStep`. This combines schema-aware validity
// with some fidelity to the model's preferred SQL continuations.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained-chunk branch, we either remain outside
//   the span or enter it only when `stoppedOpen` is true, at which point we set
//   `currentConstrainedOut := []`; `parser.IsValidPrefix([])` holds by the
//   method precondition. In the complete-prefix branch, `CloseConstrainedSpan`
//   sets `insideConstrainedOut` to false, so the implication is vacuous. In the
//   narrow constrained branch, `ConstrainedStep` returns either EOS (break) or
//   a parser-valid next token, and `AppendConstrainedToken` preserves validity.
//   In the speculative constrained branch, we call `AppendConstrainedToken`
//   only when `IsTokenValidNext` says the argmax is valid; otherwise we fall
//   back to `ConstrainedStep`, which again yields a valid next token or EOS.
// suffix: In the unconstrained-chunk branch, when we stay outside the span the
//   implication is vacuous; when `stoppedOpen` is true we set
//   `currentConstrainedOut := []`, and the length-0 suffix of `generated` is
//   `[]`. In the complete-prefix branch, `CloseConstrainedSpan` appends the
//   closing delimiter and resets `currentConstrainedOut` to `[]`, so the suffix
//   property holds trivially. In both constrained append branches,
//   `AppendConstrainedToken` appends the same token to `generated` and to
//   `currentConstrainedOut`, preserving the suffix equality.
// progress: In the unconstrained-chunk branch, `UnconstrainedChunk` returns
//   `stepsUsed` with `|generated|` increasing by at most `stepsUsed`; after
//   `steps := steps + stepsUsed`, the bound
//   `|generated| <= |generatedPrefix| + steps` is preserved. In the complete-
//   prefix branch, at most one token is appended and `steps` increases by 1.
//   In the narrow constrained branch and the speculative constrained branch,
//   each iteration increases `steps` by 1 and appends at most one token (or
//   breaks on EOS without appending), so the bound remains true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      if narrow {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated1, appendedInside1, appendedCurrent1 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated1;
          insideConstrainedOut := appendedInside1;
          currentConstrainedOut := appendedCurrent1;
        }
      } else {
        var constrainedPrompt2 := prompt + generated[..|generated| - |currentConstrainedOut|];
        lm.GenerateLogits(constrainedPrompt2 + currentConstrainedOut);
        var argmax := helpers.GetHighestLogitToken(lm);
        var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);
        if argmax != eosToken && argmaxValid {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, argmax
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
          helpers.cost := helpers.cost + 1;
          steps := steps + 1;
        } else {
          var next2 := helpers.ConstrainedStep(lm, parser, constrainedPrompt2, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if next2 == eosToken {
            break;
          } else {
            var appendedGenerated3, appendedInside3, appendedCurrent3 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next2
            );
            generated := appendedGenerated3;
            insideConstrainedOut := appendedInside3;
            currentConstrainedOut := appendedCurrent3;
          }
        }
      }
    }
  }
}

cost := steps;

