Strategy: {
  // CSD_RATIONALE_BEGIN
  // The prior strategy still underperformed because the short unconstrained
  // runway encouraged the model to emit generic planning text or to open a span
  // without enough task grounding, after which constrained decoding often fell
  // into a high-probability but semantically weak SQL template like
  // `SELECT <id> , <id> FROM <id>`. The syntax rate was already perfect, so the
  // problem is not grammaticality but insufficient semantic steering.
  //
  // This revision switches to an always-single-span strategy with stronger
  // in-span guidance. We open `<<` immediately (or continue an existing span),
  // because Spider expects the whole answer to be one SQL query and extra free
  // text is not useful. The key change is how constrained decoding proceeds:
  //
  // 1. While the constrained prefix is incomplete, we still sample through the
  //    parser, but we detect narrow / dead-end situations using parser queries.
  //    In such states, we avoid blindly trusting one sampled token. Instead we
  //    ask for a small set of top valid candidates and append the highest-ranked
  //    valid candidate. This is intended to keep decoding on a schema-grounded
  //    path when the grammar has become selective.
  //
  // 2. Once the constrained prefix is complete, we do not wait for the model to
  //    emit EOS. We immediately close the span with `>>` when budget permits.
  //    This prevents the model from extending a correct complete query into an
  //    overlong but still syntactically legal continuation.
  //
  // 3. If constrained sampling ever returns EOS before completion, we stop
  //    immediately. EOS remains terminal and we do not fabricate repairs.
  //
  // The intended effect is to preserve the excellent syntax rate while reducing
  // the dominant failure mode of generic low-information SQL skeletons by using
  // parser-aware candidate selection exactly when the grammar becomes narrow.
  // CSD_RATIONALE_END
  // CSD_PROOF_SKETCH_BEGIN
  // parser_validity:
  // - Open-span branch: `OpenConstrainedSpan` starts constrained mode with empty
  //   constrained content, and `parser.IsValidPrefix([])` holds by precondition.
  // - Immediate-close branch: it is taken only when `completeNow` is true, and
  //   `CloseConstrainedSpan` exits constrained mode, making the implication
  //   vacuous afterward.
  // - Regular constrained-sample branch: `ConstrainedStep` is called from a
  //   valid constrained prefix; if it returns EOS we break without mutation, and
  //   if it returns a token we append only through `AppendConstrainedToken`,
  //   which preserves parser-validity of the constrained prefix.
  // - Narrow-state candidate branch: `TopValidCandidates` returns valid next
  //   tokens for the current constrained prefix; appending the selected top
  //   candidate via `AppendConstrainedToken` therefore preserves validity.
  // - Break branches do not mutate state, so the invariant is preserved.
  //
  // suffix:
  // - Open-span branch: after opening, the constrained content is empty, so the
  //   suffix of length 0 of `generated` equals `currentConstrainedOut`.
  // - Immediate-close branch: after closing, `insideConstrainedOut` is false, so
  //   the suffix implication is vacuous.
  // - Regular constrained-sample branch: `AppendConstrainedToken` appends the
  //   chosen token to both `generated` and `currentConstrainedOut`, preserving
  //   that the active constrained content is exactly the generated suffix.
  // - Narrow-state candidate branch: the same helper-based append preserves the
  //   suffix relationship for the selected valid candidate.
  // - Break branches leave both sequences unchanged, so the invariant remains.
  //
  // progress:
  // - Open-span branch: one delimiter token is appended and `steps` increases by
  //   1, so `|generated|` grows by at most the increase in `steps`.
  // - Immediate-close branch: closing appends one delimiter token and also
  //   increments `steps` by 1, preserving the bound.
  // - Regular constrained-sample branch with append: one constrained sample
  //   consumes one step, and appending one token increases `|generated|` by 1.
  // - Narrow-state candidate branch: the query helpers do not change `generated`
  //   or `steps`; the one sampled step is already accounted for, and the final
  //   append adds exactly one token, so growth is still bounded by `steps`.
  // - Break branches either do not change `generated` or stop immediately after
  //   a sampled step, so the bound remains true.
  //
  // cost accounting:
  // - `steps` is the returned cost counter. Every cost-bumping helper call is
  //   mirrored exactly: `OpenConstrainedSpan` adds 1, each `ConstrainedStep`
  //   adds 1, and `CloseConstrainedSpan` adds 1.
  // - Parser queries and `AppendConstrainedToken` are non-bumping helpers, so
  //   they do not affect `steps`. Therefore `cost := steps` is sound and
  //   `cost <= maxSteps` follows from the loop guard and guarded close.
  // CSD_PROOF_SKETCH_END
  generated := generatedPrefix;
  insideConstrainedOut := insideConstrained;
  currentConstrainedOut := currentConstrained;
  cost := 0;

  var steps := 0;

  while steps < maxSteps
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
    invariant |generated| <= |generatedPrefix| + steps
    invariant cost == 0
    decreases maxSteps - steps
  {
    if !insideConstrainedOut {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
      if completeNow {
        if steps + 1 <= maxSteps {
          var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
            lm, parser, generated, currentConstrainedOut
          );
          generated := closedGenerated;
          insideConstrainedOut := closedInside;
          currentConstrainedOut := closedCurrent;
          steps := steps + 1;
        }
        break;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt := prompt + stablePrefix;
        var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
        if narrow {
          var candidates := helpers.TopValidCandidates(lm, parser, constrainedPrompt, currentConstrainedOut, 3, eosToken);
          var nextSample := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if nextSample == eosToken {
            break;
          } else {
            if 0 < |candidates| {
              var chosen := candidates[0];
              var appendedGenerated1, appendedInside1, appendedCurrent1 := helpers.AppendConstrainedToken(
                lm, parser, generated, currentConstrainedOut, chosen
              );
              generated := appendedGenerated1;
              insideConstrainedOut := appendedInside1;
              currentConstrainedOut := appendedCurrent1;
            } else {
              var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
                lm, parser, generated, currentConstrainedOut, nextSample
              );
              generated := appendedGenerated2;
              insideConstrainedOut := appendedInside2;
              currentConstrainedOut := appendedCurrent2;
            }
          }
        } else {
          var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if next == eosToken {
            break;
          } else {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
          }
        }
      }
    }
  }

  cost := steps;
}

