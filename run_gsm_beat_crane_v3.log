Strategy: // CSD_RATIONALE_BEGIN
// The previous version regressed because it tried to "detect" when to open `<<`
// by looking at logits and recent cues, but the actual control flow still let
// unconstrained text drift into accidental `<<` openings and then spend most of
// the budget inside malformed arithmetic. The trace confirms two concrete
// issues: (1) constrained mode effectively began too early or too unreliably,
// and (2) once inside, spans often grew long and never closed.
//
// This revision makes two targeted structural fixes while keeping the proven
// single-span design from the better runs. First, before any span has been
// produced, we use a tiny fixed unconstrained warmup and then open `<<`
// directly with `OpenConstrainedSpan` when available, instead of merely
// boosting it or depending on sampled delimiters. This guarantees the required
// `<< >>` segment and avoids the brittle "maybe open" behavior that caused the
// collapse in syntax rate.
//
// Second, inside the constrained span we switch back to the more reliable
// adaptive constrained step and add a hard span-length cap. We still close
// immediately when `parser.IsCompletePrefix(currentConstrainedOut)` holds, but
// if the span grows too long we stop generation rather than continuing an
// unterminated malformed fragment. This directly targets the observed long bad
// spans and runtime inflation.
//
// After the first span is closed, outside decoding mildly penalizes reopening
// `<<` and boosts EOS so answers stay concise. Overall this is a focused repair:
// deterministic single-span insertion after a short prose lead-in, parser-valid
// arithmetic growth with adaptive boosting, immediate close on completeness,
// and short post-span termination behavior.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In outside branches we either stay outside, so the
//   implication is vacuous, or open with OpenConstrainedSpan, which sets
//   currentConstrainedOut := [] and parser.IsValidPrefix([]) is given. In the
//   inside close branch, CloseConstrainedSpan sets insideConstrainedOut := false.
//   In the inside sampling branch, AdaptiveConstrainedStep returns either EOS or
//   a token that keeps the constrained prefix parser-valid; AppendConstrainedToken
//   then preserves parser validity of currentConstrainedOut.
// suffix: Outside branches are vacuous. OpenConstrainedSpan appends only `<<`
//   and sets currentConstrainedOut to [], so the empty suffix relation holds.
//   CloseConstrainedSpan makes the implication vacuous. In the inside append
//   branch, AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, preserving the suffix equality exactly.
// cost accounting: We return cost := steps. Every non-breaking branch increments
//   steps by exactly 1 after one cost-bumping helper call: UnconstrainedStep,
//   OpenConstrainedSpan, CloseConstrainedSpan, or AdaptiveConstrainedStep.
//   Branches that break do so immediately after a bounded amount of work and do
//   not need further progress. Hence steps <= maxSteps and cost <= maxSteps.
// progress bound: UnconstrainedStep appends at most one token and we increment
//   steps by 1. OpenConstrainedSpan appends exactly one delimiter token and we
//   increment steps by 1. CloseConstrainedSpan appends at most one token and we
//   increment steps by 1. The inside append branch appends exactly one token via
//   AppendConstrainedToken after one adaptive constrained sample step and then
//   increments steps by 1; EOS or hard-stop branches break immediately. Thus
//   every non-breaking branch preserves |generated| <= |generatedPrefix| + steps
//   and strictly decreases maxSteps - steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var completedSpan: bool := false;
var warmup: nat := 3;
var spanLimit: nat := 24;
var closePenaltyTokens: seq<Token> := ["<<"];

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if completedSpan {
      lm.GenerateLogits(prompt + generated);
      helpers.PenalizeTokenLogits(lm, closePenaltyTokens, 8.0);
      helpers.BoostTokenLogits(lm, [eosToken], 4.0);
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
      }
    } else {
      if "<<" in lm.Tokens && steps >= warmup && steps + 2 < maxSteps {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          generated := generated + [next];
        }
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
