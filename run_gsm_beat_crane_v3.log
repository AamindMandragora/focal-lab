Strategy: // CSD_RATIONALE_BEGIN
// Math-step CSD with delimiter-triggered constrained arithmetic spans.
// The strategy tracks the usual constrained-decoding state:
//   (1) whether generation is currently inside a << ... >> span, and
//   (2) the current constrained token prefix inside that span.
// Outside spans, it generates freely but watches for the token "<<" to open a
// constrained arithmetic segment. Inside spans, it uses parser-constrained
// decoding, with a mild preference for caller-supplied token groups via the
// verified AdaptiveConstrainedStep helper. When the parser reports that the
// current arithmetic fragment is complete, the strategy closes the span with
// ">>" immediately.
//
// This supports the task because normal explanatory text is left natural and
// unconstrained, while every arithmetic computation that appears between the
// delimiters is forced to remain a parser-valid arithmetic prefix. The group
// boosts are only a soft preference layered on top of parser validity, so they
// can encourage useful math tokens without permitting invalid constrained text.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Unconstrained branch: if the sampled token is not "<<", insideConstrainedOut
//   stays false, so the implication is vacuous. If the token is "<<", we enter
//   constrained mode with currentConstrainedOut := [], and parser.IsValidPrefix([])
//   is a precondition of the method.
//   Close branch: CloseConstrainedSpan sets insideConstrainedOut to false and
//   currentConstrainedOut to [], so the implication is vacuous afterward.
//   Constrained-sample branch: AdaptiveConstrainedStep guarantees either EOS or
//   a token whose append keeps parser validity; on the non-EOS path,
//   AppendConstrainedToken therefore yields parser.IsValidPrefix(currentConstrainedOut).
//
// suffix:
//   Unconstrained branch: when we remain outside, the implication is vacuous.
//   When we open on "<<", currentConstrainedOut is reset to [], and the length-0
//   suffix of generated matches [].
//   Close branch: CloseConstrainedSpan appends at most the closing delimiter and
//   resets currentConstrainedOut to [], so the implication is vacuous after the
//   branch.
//   Constrained-sample branch: AppendConstrainedToken appends the same next token
//   to generated and currentConstrainedOut, preserving that the constrained
//   prefix is exactly the suffix of generated.
//
// cost accounting:
//   Every non-breaking branch in this loop uses exactly one cost-bumping helper:
//   UnconstrainedStep, CloseConstrainedSpan, or AdaptiveConstrainedStep. The
//   branch then does steps := steps + 1. No branch manually changes helpers.cost,
//   and the returned cost is set from steps at the end, so returned cost equals
//   the number of loop iterations that consumed one decoding step and therefore
//   stays <= maxSteps.
//
// progress:
//   Unconstrained branch appends exactly one token to generated on the non-EOS
//   path and increments steps by 1; on EOS it breaks immediately.
//   Close branch appends at most one token and increments steps by 1.
//   Constrained-sample branch either breaks on EOS or appends exactly one token
//   via AppendConstrainedToken and increments steps by 1.
//   Therefore every non-breaking iteration strictly increases steps, satisfying
//   decreases maxSteps - steps, and |generated| <= |generatedPrefix| + steps is
//   preserved because generated grows by at most one token per increment.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var boostAmount: real := 4.0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, boostAmount, narrowThreshold, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

