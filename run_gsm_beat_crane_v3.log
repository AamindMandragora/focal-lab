Strategy: // CSD_RATIONALE_BEGIN
// The evaluation showed three concrete problems: the strategy often delayed or
// missed the required `<< >>` segment, sometimes left it unterminated, and
// spent too many tokens in free-form generation before ever reaching the
// arithmetic. The revised strategy therefore changes the control flow rather
// than merely retuning logits.
//
// First, we make a constrained arithmetic span an explicit early objective.
// If generation starts outside a span and `<<` is available, we open it after a
// short amount of free-form text, and we also force an opening near the end if
// none has appeared yet. This directly targets the `Contains << >>` failures.
//
// Second, once inside the constrained span, we prefer short arithmetic content
// and close as soon as the parser says the expression is complete. To avoid the
// malformed-span failures caused by broad unconstrained prose leaking into the
// arithmetic region, the constrained branch uses parser-valid constrained
// sampling every step and immediately exits on completeness.
//
// Third, after at least one span has been produced, we bias the outer decoding
// toward stopping quickly instead of continuing a long explanation. This
// addresses both runtime and answer truncation issues by encouraging concise
// "step-by-step with computation shown" outputs rather than long rambles.
//
// Overall, the main change is structural: reliably create one arithmetic span
// early, keep it parser-valid and short, close it immediately when complete,
// then encourage termination.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In unconstrained branches we either remain outside the span,
// making the implication vacuous, or open a span with OpenConstrainedSpan,
// which sets currentConstrainedOut to [] and the precondition gives
// parser.IsValidPrefix([]). In constrained branches, AdaptiveConstrainedStep
// returns EOS or a token whose append remains parser-valid, and
// AppendConstrainedToken preserves parser validity; the close branch calls
// CloseConstrainedSpan only when IsCompletePrefix holds, and afterwards we are
// outside the span so the implication is vacuous.
//
// suffix: Outside-span branches are vacuous unless we open a span; after
// OpenConstrainedSpan, currentConstrainedOut is [] so it is exactly the empty
// suffix of generated. In constrained append branches, AppendConstrainedToken
// appends the same token to generated and currentConstrainedOut, preserving the
// suffix equality. In close branches we leave constrained mode, so the suffix
// invariant is again vacuous.
//
// cost accounting: We use a local steps counter and set cost := steps at the
// end. Every non-breaking branch performs exactly one cost-bumping helper call
// (UnconstrainedStep, OpenConstrainedSpan, CloseConstrainedSpan, or
// AdaptiveConstrainedStep) and then increments steps by 1. Break branches exit
// immediately without needing further preservation.
//
// progress bound: UnconstrainedStep appends at most one token and then we do
// steps := steps + 1. OpenConstrainedSpan appends exactly one token (`<<`) and
// increments steps by 1; CloseConstrainedSpan appends at most one token and
// increments steps by 1; the constrained append branch appends exactly one
// token and increments steps by 1. EOS branches break immediately. Therefore
// |generated| never grows faster than steps, so
// |generated| <= |generatedPrefix| + steps is preserved, and every non-breaking
// branch strictly increases steps, satisfying decreases maxSteps - steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var sawSpan: bool := insideConstrained;
var forceOpenAfter: nat := 6;
var mustOpenBy: nat := 18;
var stopBiasTokens: seq<Token> := [eosToken];
var canOpen: bool := "<<" in lm.Tokens;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      sawSpan := true;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
