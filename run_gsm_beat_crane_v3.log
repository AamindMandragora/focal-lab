Attempt 25/25
============================================================
Strategy: // CSD_RATIONALE_BEGIN
// The previous best strategy was close, but the trace shows the core weakness:
// it almost never entered constrained mode at all (only ~0.2 constrained
// samples/example), so most outputs were fully unconstrained prose with either
// no arithmetic span or a malformed one. The targeted fix is therefore to keep
// the same reliable inside-span behavior, but change only the opening policy.
//
// Revised policy:
// (1) allow a very short unconstrained warmup so the model can start with
//     natural step-by-step wording;
// (2) if no constrained span is active after that warmup, directly open one
//     with OpenConstrainedSpan instead of waiting for the model to emit "<<";
// (3) inside the span, continue using parser-valid constrained decoding with
//     AdaptiveConstrainedStep and close immediately once the parser says the
//     arithmetic fragment is complete;
// (4) after the first span has been closed, never deliberately open another.
//     Outside the span we simply continue unconstrained until EOS or budget.
//
// This specifically addresses the measured failures:
// - missing / rare << >> segments: fixed by explicit opening after a short
//   warmup rather than passive delimiter detection;
// - malformed constrained content: still handled by parser-valid constrained
//   sampling and immediate close on completeness;
// - excessive free-form wandering: one early mandatory arithmetic span makes
//   the answer show a computation sooner, which is better aligned with the
//   task of step-by-step math solutions with arithmetic inside << >>.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside/unconstrained branch: if we stay outside, insideConstrainedOut is
//   false so the implication is vacuous. If we explicitly open with
//   OpenConstrainedSpan, currentConstrainedOut becomes [] and parser validity
//   holds by the method precondition parser.IsValidPrefix([]).
//   Close branch: CloseConstrainedSpan sets insideConstrainedOut to false and
//   currentConstrainedOut to [], so the implication is vacuous afterward.
//   Constrained-sample branch: AdaptiveConstrainedStep guarantees either EOS or
//   a token whose append preserves parser validity; on the non-EOS path,
//   AppendConstrainedToken therefore yields parser.IsValidPrefix(currentConstrainedOut).
//
// suffix:
//   Outside/unconstrained branch: when we remain outside, the implication is
//   vacuous. When we open explicitly, generated gains only the delimiter "<<"
//   while currentConstrainedOut is reset to [], and the empty suffix matches [].
//   Close branch: after CloseConstrainedSpan we are outside constrained mode, so
//   the implication is vacuous.
//   Constrained-sample branch: AppendConstrainedToken appends the same sampled
//   token to generated and currentConstrainedOut, preserving that the active
//   constrained prefix is exactly the suffix of generated.
//
// cost accounting:
//   Every non-breaking branch uses exactly one cost-bumping helper and then
//   increments steps by 1: UnconstrainedStep, OpenConstrainedSpan,
//   CloseConstrainedSpan, or AdaptiveConstrainedStep. AppendConstrainedToken is
//   non-bumping and is paired with the already-counted constrained sample.
//   Thus returned cost := steps is bounded by maxSteps.
//
// progress:
//   UnconstrainedStep appends exactly one token on the non-EOS path and we do
//   steps := steps + 1; on EOS we break immediately.
//   OpenConstrainedSpan appends exactly one delimiter token and we increment
//   steps by 1.
//   CloseConstrainedSpan appends at most one token and we increment steps by 1.
//   AdaptiveConstrainedStep either breaks on EOS or, on non-EOS, one token is
//   appended via AppendConstrainedToken and steps is incremented by 1.
//   Therefore every non-breaking iteration strictly increases steps, satisfying
//   decreases maxSteps - steps, and |generated| <= |generatedPrefix| + steps is
//   preserved because generated grows by at most one token per increment.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var boostAmount: real := 4.0;
var narrowThreshold: nat := 12;
var warmup: nat := 4;
var spanOpenedOrClosed: bool := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !spanOpenedOrClosed && steps >= warmup && "<<" in lm.Tokens {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      spanOpenedOrClosed := true;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          spanOpenedOrClosed := true;
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      spanOpenedOrClosed := true;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, boostAmount, narrowThreshold, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

