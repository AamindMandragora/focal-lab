Strategy: // CSD_RATIONALE_BEGIN
// The best prior strategy was close to threshold, so this revision keeps the
// same overall shape: mostly unconstrained text outside arithmetic spans, then
// parser-constrained decoding inside `<< >>`, with immediate closure once the
// parser reports completeness. The changes are targeted at the measured
// failures rather than a full redesign.
//
// First, opening `<<` is now delayed more conservatively. The failed run showed
// that entering constrained mode almost immediately is catastrophic: the model
// starts emitting raw arithmetic before any explanatory setup, and long
// malformed spans follow. To fix that, the strategy waits for both a stronger
// arithmetic cue and a minimum amount of already-generated text before it even
// considers boosting `<<`. This preserves natural step-by-step prose like
// "Let x =" or "So we compute" before the constrained arithmetic fragment.
//
// Second, once a cue has appeared and enough context exists, the strategy uses
// a mild `<<` boost only for a short window rather than forcing or heavily
// preferring it. This keeps delimiter presence likely without recreating the
// "open too early on nearly every example" failure mode.
//
// Third, inside the constrained span the strategy still uses adaptive
// constrained decoding, but now it also detects very long spans and closes them
// as soon as possible when complete. The prior bad run spent almost the entire
// token budget inside one unterminated span; preserving the immediate-close
// behavior from the better attempt is therefore essential.
//
// Finally, after one constrained span has been opened and closed, the strategy
// biases the remaining unconstrained decoding toward brevity by simply
// continuing token-by-token without reopening another span. This keeps outputs
// concise and reduces the chance of repetition loops while retaining the
// successful structure of the earlier 64%-accuracy approach.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In outside-span branches we either remain outside, making
//   the implication vacuous, or enter a span only when the sampled token is
//   `<<`, setting `currentConstrainedOut := []`; the precondition gives
//   parser.IsValidPrefix([]). In the close branch, CloseConstrainedSpan sets
//   insideConstrainedOut to false, so the implication is vacuous. In the
//   inside-span sampling branch, AdaptiveConstrainedStep ensures the sampled
//   token is either EOS or parser-valid after the current prefix; on non-EOS,
//   AppendConstrainedToken preserves parser validity.
// suffix: Outside a span, the invariant is vacuous. If we open on `<<`, then
//   currentConstrainedOut becomes `[]`, and the empty suffix of generated is
//   `[]`. In the close branch, we leave constrained mode, so the implication is
//   vacuous again. In the append branch, AppendConstrainedToken appends the
//   same token to both generated and currentConstrainedOut, preserving the
//   suffix equality.
// cost accounting: The loop maintains `cost == 0` and returns `cost := steps`.
//   Every non-breaking branch increments `steps` by exactly 1 after one
//   cost-bumping action: UnconstrainedStep, manual
//   GenerateLogits/ChooseNextTokenUnconstrained with explicit helper-cost bump,
//   CloseConstrainedSpan, or AdaptiveConstrainedStep. Thus `cost <= maxSteps`
//   at return.
// progress bound: Every non-breaking outside-span branch appends at most one
//   token and increments steps by 1. The close branch appends at most one token
//   and increments steps by 1. The inside-span append branch appends exactly
//   one token and increments steps by 1; EOS branches break immediately. Hence
//   `|generated| <= |generatedPrefix| + steps` is preserved, and the decreases
//   metric `maxSteps - steps` strictly decreases on every non-breaking path.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var recentMathCue: bool := false;
var sawSpan: bool := insideConstrained;
var freeTokens: nat := |generatedPrefix|;
var mathCueTokens: seq<Token> := ["=", "+", "-", "*", "/", "compute", "calculate", "total", "sum", "answer", "therefore"];
var openSpanTokens: seq<Token> := ["<<"];

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var canTryOpen := recentMathCue && !sawSpan && freeTokens >= 4 && steps + 2 < maxSteps && "<<" in lm.Tokens;
    if canTryOpen {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, openSpanTokens, 3.0);
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        freeTokens := freeTokens + 1;
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          recentMathCue := false;
          sawSpan := true;
        } else {
          recentMathCue := next in mathCueTokens;
        }
      }
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        freeTokens := freeTokens + 1;
        if next == "<<" && !sawSpan {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          recentMathCue := false;
          sawSpan := true;
        } else {
          recentMathCue := next in mathCueTokens;
        }
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      recentMathCue := false;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        recentMathCue := false;
      }
    }
  }
}

cost := steps;

