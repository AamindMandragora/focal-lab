Strategy: // CSD_RATIONALE_BEGIN
// This revision keeps the best prior structure — mostly unconstrained prose
// outside a single arithmetic span, parser-constrained decoding inside `<< >>`,
// and immediate closure when the arithmetic fragment is complete — but makes
// two targeted fixes for the measured failures.
//
// First, the previous regressed run almost never closed spans: it only entered
// constrained mode when the unconstrained model itself emitted the exact token
// `<<`, and once inside it could wander for many steps before reaching a
// complete arithmetic prefix. To fix that, this strategy deliberately opens a
// single constrained span after a short warmup if none has appeared yet, rather
// than waiting indefinitely for unconstrained generation to produce `<<` on its
// own. Inside the span it uses ordinary constrained sampling (or group-boosted
// constrained sampling when groups are available) and imposes a hard inside-span
// length cap: once the constrained content is reasonably long, the strategy
// stops extending it and closes immediately if complete, otherwise it breaks.
// This directly targets the dominant `unterminated_constrained_segment` failure
// and also reduces runtime.
//
// Second, after one span has been closed, the strategy never deliberately opens
// another. Outside constrained mode after the first completed span, it simply
// continues unconstrained token-by-token and stops naturally on EOS. This keeps
// the answer short and reduces repetition loops. The result is still the same
// high-level design as the best 70%-accuracy attempt, but with a mandatory
// single early arithmetic span and a safety cap to prevent pathological long
// constrained runs.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside branch: if we stay outside, insideConstrainedOut remains false so
//   the implication is vacuous; if we open a span via OpenConstrainedSpan,
//   currentConstrainedOut becomes [] and parser.IsValidPrefix([]) holds by
//   precondition.
//   Inside-close branch: CloseConstrainedSpan sets insideConstrainedOut to false
//   and currentConstrainedOut to [], so the implication is vacuous afterward.
//   Inside-append branch: ConstrainedSample / GroupBoostedConstrainedStep
//   guarantee EOS or a token whose append keeps parser validity; on the non-EOS
//   path, AppendConstrainedToken preserves parser.IsValidPrefix(currentConstrainedOut).
//
// suffix:
//   Outside branch: remaining outside makes the implication vacuous; opening a
//   span resets currentConstrainedOut to [], and the empty suffix relation holds
//   immediately.
//   Inside-close branch: after closing, insideConstrainedOut is false, so the
//   suffix implication is vacuous.
//   Inside-append branch: AppendConstrainedToken appends the same token to both
//   generated and currentConstrainedOut, so the constrained content remains the
//   suffix of generated.
//
// cost accounting:
//   Every non-breaking branch that changes state uses exactly one cost-bumping
//   helper and then increments steps by 1: UnconstrainedStep, OpenConstrainedSpan,
//   CloseConstrainedSpan, ConstrainedSample, or GroupBoostedConstrainedStep.
//   The only pure-query branch is the inside safety-cap break path, which breaks
//   immediately. Thus returned cost := steps is bounded by maxSteps.
//
// progress:
//   Unconstrained token branch appends exactly one token and increments steps by
//   1, or breaks on EOS. Open branch appends exactly the `<<` delimiter and
//   increments steps by 1. Inside-close branch appends at most one token and
//   increments steps by 1. Inside-append branch appends exactly one token and
//   increments steps by 1, or breaks on EOS. The safety-cap branch breaks
//   immediately. Therefore every non-breaking iteration strictly increases steps,
//   satisfying decreases maxSteps - steps, and |generated| <= |generatedPrefix| +
//   steps is preserved because generated grows by at most one token per step.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var openedOrClosedSpan: bool := insideConstrained;
var warmup: nat := 4;
var maxConstrainedLen: nat := 24;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      openedOrClosedSpan := true;
      steps := steps + 1;
    } else {
      if |currentConstrainedOut| >= maxConstrainedLen {
        break;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var next: Token;
        if |validTokenGroups| > 0 {
          next := helpers.GroupBoostedConstrainedStep(
            lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, eosToken
          );
        } else {
          lm.GenerateLogits(prompt + stablePrefix + currentConstrainedOut);
          next := helpers.ConstrainedSample(lm, parser, currentConstrainedOut, eosToken);
        }
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  } else {
    if !openedOrClosedSpan && steps >= warmup && "<<" in lm.Tokens {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedOrClosedSpan := true;
      steps := steps + 1;
    } else {
      var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      } else {
        generated := generated + [nextOutside];
        if nextOutside == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          openedOrClosedSpan := true;
        }
      }
    }
  }
}

