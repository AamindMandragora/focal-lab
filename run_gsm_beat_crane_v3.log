Strategy: // CSD_RATIONALE_BEGIN
// The best strategy so far already had the right high-level shape: short
// unconstrained step-by-step prose, one parser-constrained arithmetic span
// inside `<< >>`, and immediate closure once the arithmetic is complete. The
// main failure in the regressed run was not arithmetic syntax but span timing:
// it still entered constrained mode too early on many examples, producing a
// naked formula instead of a worked solution. The revision therefore keeps the
// successful single-span design but makes opening substantially more selective.
//
// The key change is a two-phase outside policy. Before any span has appeared,
// generation stays fully unconstrained for an initial warmup window so the
// model can emit natural setup words like "First", "We compute", or "So".
// After that warmup, `<<` is only softly encouraged when there is evidence of
// arithmetic context: either a recent cue token, or enough free-form text has
// already been produced that a computation is likely next. This directly
// targets the measured `entered_constrained_mode_too_early` failure while still
// preserving the required `<< >>` segment on most examples.
//
// Second, the strategy now tracks whether a span has already been completed and
// never deliberately opens a second one. After the first closed span, outside
// decoding mildly penalizes `<<` and slightly boosts EOS to keep answers short.
// This retains the concise behavior that worked well in the 65%-accuracy run.
//
// Third, inside the constrained span we keep the same reliable mechanism:
// parser-valid constrained decoding with caller-supplied group boosts, plus
// immediate closure exactly when `parser.IsCompletePrefix(currentConstrainedOut)`
// holds. This preserves syntax and avoids unterminated spans. A small safety
// tweak closes as soon as complete rather than taking any additional inside
// step, which is important for short-answer arithmetic outputs.
//
// Overall, this is a targeted refinement of the best attempt rather than a
// rewrite: later and more context-sensitive opening of the single arithmetic
// span, the same parser-valid arithmetic growth once inside, and concise
// termination after the span is closed.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In all outside-span branches we either remain outside, so
//   the implication is vacuous, or open a span with OpenConstrainedSpan, which
//   sets currentConstrainedOut to [] and parser.IsValidPrefix([]) holds by
//   precondition. In the inside close branch, CloseConstrainedSpan sets
//   insideConstrainedOut to false, again making the implication vacuous. In the
//   inside sampling branch, GroupBoostedConstrainedStep returns either EOS or a
//   token valid after currentConstrainedOut; on non-EOS, AppendConstrainedToken
//   preserves parser validity of the updated constrained prefix.
// suffix: Outside-span branches are vacuous. Opening with OpenConstrainedSpan
//   appends only the delimiter to generated and sets currentConstrainedOut := [],
//   so the empty suffix equality holds immediately. Closing makes the invariant
//   vacuous. In the append branch, AppendConstrainedToken appends the same token
//   to generated and currentConstrainedOut, so the tracked constrained prefix
//   remains exactly the suffix of generated.
// cost accounting: We return cost := steps. Every non-breaking branch advances
//   steps by exactly 1 after one cost-bumping action: UnconstrainedStep,
//   OpenConstrainedSpan, CloseConstrainedSpan, or GroupBoostedConstrainedStep.
//   No query-only branch leaves steps unchanged. Therefore steps never exceeds
//   maxSteps and the returned cost is bounded by maxSteps.
// progress bound: UnconstrainedStep appends at most one token and we increment
//   steps by 1, so |generated| <= |generatedPrefix| + steps is preserved.
//   OpenConstrainedSpan appends exactly one delimiter token and increments
//   steps by 1. CloseConstrainedSpan appends at most one token and increments
//   steps by 1. The inside append branch appends exactly one token via
//   AppendConstrainedToken after a single constrained sample step and then
//   increments steps by 1; EOS branches break immediately. Thus every
//   non-breaking path strictly decreases maxSteps - steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var sawSpan: bool := insideConstrained;
var completedSpan: bool := false;
var freeTokens: nat := |generatedPrefix|;
var recentMathCue: bool := false;
var warmup: nat := 4;
var cueTokens: seq<Token> := ["=", "+", "-", "*", "/", "compute", "calculat", "calculate", "total", "sum", "then", "so", "answer", "therefore"];
var openTokens: seq<Token> := ["<<"];
var closePenaltyTokens: seq<Token> := ["<<"];

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if completedSpan {
      lm.GenerateLogits(prompt + generated);
      helpers.PenalizeTokenLogits(lm, closePenaltyTokens, 8.0);
      helpers.BoostTokenLogits(lm, [eosToken], 3.0);
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        freeTokens := freeTokens + 1;
        recentMathCue := next in cueTokens;
      }
    } else {
      var shouldOpen := "<<" in lm.Tokens &&
                        freeTokens >= warmup &&
                        steps + 2 < maxSteps &&
                        (recentMathCue || freeTokens >= warmup + 3);
      if shouldOpen {
        lm.GenerateLogits(prompt + generated);
        helpers.BoostTokenLogits(lm, openTokens, 4.0);
        var topTok := helpers.GetHighestLogitToken(lm);
        if topTok == "<<" {
          var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
          generated := openedGenerated;
          insideConstrainedOut := openedInside;
          currentConstrainedOut := openedCurrent;
          sawSpan := true;
          recentMathCue := false;
          steps := steps + 1;
        } else {
          var next := helpers.UnconstrainedStep(lm, prompt, generated);
          steps := steps + 1;
          if next == eosToken {
            break;
          } else {
            generated := generated + [next];
            freeTokens := freeTokens + 1;
            if next == "<<" && !sawSpan {
              insideConstrainedOut := true;
              currentConstrainedOut := [];
              sawSpan := true;
              recentMathCue := false;
            } else {
              recentMathCue := next in cueTokens || Contains(next, "<<");
            }
          }
        }
      } else {
        var next := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          generated := generated + [next];
          freeTokens := freeTokens + 1;
          if next == "<<" && !sawSpan {
            insideConstrainedOut := true;
            currentConstrainedOut := [];
            sawSpan := true;
            recentMathCue := false;
          } else {
            recentMathCue := next in cueTokens || Contains(next, "=");
          }
        }
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      completedSpan := true;
      recentMathCue := false;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.GroupBoostedConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        recentMathCue := false;
      }
    }
  }
}

cost := steps;

