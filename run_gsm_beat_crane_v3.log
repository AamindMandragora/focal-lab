Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy almost never entered constrained mode: it waited for a
// soft math cue and then merely boosted "<<", so most generations stayed fully
// unconstrained, which explains both the missing `<< >>` segment and the low
// number of constrained helper calls in the trace. This revision fixes that by
// making constrained spans a first-class default behavior for math reasoning:
// when outside a span, the strategy strongly prefers opening `<<` early and
// also biases toward short, direct answer-style tokens to reduce long free-form
// rambles.
//
// Inside a constrained span, the strategy no longer relies on broad adaptive
// group boosting alone. Instead it uses a targeted constrained sampler with
// penalties against alphabetic/explanatory tokens and mild boosts for caller-
// supplied groups, steering the span toward arithmetic expressions rather than
// prose. As soon as the parser reports the arithmetic fragment is complete, the
// strategy immediately closes the span, ensuring well-formed `<< >>` segments.
// This directly addresses the observed failures: more reliable delimiter
// presence, less malformed constrained content, and shorter runtimes due to
// earlier entry into and exit from constrained spans.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In outside-span branches, either we remain outside so the
// implication is vacuous, or we open a span with OpenConstrainedSpan, which
// sets currentConstrainedOut to [] and parser validity follows from the method
// precondition on the empty prefix. In the inside-span append branch,
// ConstrainedSample guarantees the sampled token is EOS or parser-valid after
// the current prefix; on non-EOS, AppendConstrainedToken preserves
// parser.IsValidPrefix(currentConstrainedOut + [next]). In the close branch,
// CloseConstrainedSpan sets insideConstrainedOut to false, so the invariant is
// vacuous afterward.
//
// suffix: When outside and staying outside, the invariant is vacuous. When
// opening a span, OpenConstrainedSpan appends only the delimiter token to
// generated and resets currentConstrainedOut to [], so the required suffix is
// the empty suffix. In the inside append branch, AppendConstrainedToken appends
// the same token to both generated and currentConstrainedOut, preserving the
// suffix equality directly. In the close branch, we leave constrained mode, so
// the implication becomes vacuous.
//
// cost accounting: The loop tracks progress with a local `steps`. Every
// non-breaking branch increments `steps` by exactly 1 after one cost-bumping
// helper call: OpenConstrainedSpan, UnconstrainedStep, ConstrainedSample, or
// CloseConstrainedSpan. Query-only checks such as IsCompletePrefix do not bump
// cost, but they are paired with a subsequent cost-bumping action before the
// branch continues. At the end we assign `cost := steps`, so `cost <= maxSteps`.
//
// progress bound: The open-span branch appends exactly one token ("<<") and
// increments steps by 1. The unconstrained free-text branch appends at most one
// token and increments steps by 1, or breaks immediately on EOS. The inside
// append branch appends exactly one constrained token and increments steps by
// 1; on EOS it breaks immediately after the step increment. The close branch
// appends at most one token and increments steps by 1. Thus every non-breaking
// iteration strictly increases `steps`, satisfying the decreases clause, and
// `|generated| <= |generatedPrefix| + steps` is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var openedAnySpan: bool := insideConstrained;
var answerBiasTokens: seq<Token> := ["The", "the", "answer", "is", "=", "Therefore", "So", "First"];
var penalizeTokens: seq<Token> := ["Let", "let", "Suppose", "suppose", "Assume", "assume", "Remora", "dolphin", "feet", "inches", "Bodhi"];

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !openedAnySpan && "<<" in lm.Tokens {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, ["<<"], 100.0);
      helpers.BoostTokenLogits(lm, answerBiasTokens, 3.0);
      var openChoice := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if openChoice == eosToken {
        break;
      } else {
        if openChoice == "<<" {
          var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
          generated := openedGenerated;
          insideConstrainedOut := openedInside;
          currentConstrainedOut := openedCurrent;
          openedAnySpan := true;
        } else {
          generated := generated + [openChoice];
          if openChoice == "<<" {
            insideConstrainedOut := true;
            currentConstrainedOut := [];
            openedAnySpan := true;
          }
        }
      }
    } else {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, answerBiasTokens, 2.0);
      if !openedAnySpan && "<<" in lm.Tokens {
        helpers.BoostTokenLogits(lm, ["<<"], 8.0);
      }
      var nextOutside := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      } else {
        generated := generated + [nextOutside];
        if nextOutside == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          openedAnySpan := true;
        }
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(prompt + stablePrefix + currentConstrainedOut);
      if |validTokenGroups| > 0 {
        helpers.BoostValidGroups(lm, parser, currentConstrainedOut, validTokenGroups, 4.0);
      }
      helpers.PenalizeTokenLogits(lm, penalizeTokens, 8.0);
      var nextInside := helpers.ConstrainedSample(lm, parser, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if nextInside == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, nextInside
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

