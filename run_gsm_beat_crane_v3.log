Generating initial strategy for: Solve math word problems step by step, writing each arithmetic computation inside << >> delimiters.

============================================================
Attempt 1/25
============================================================
Strategy: // CSD_RATIONALE_BEGIN
// Step-by-step math CSD with delimiter-aware arithmetic spans. The strategy
// tracks the usual constrained-span state (`insideConstrainedOut` and
// `currentConstrainedOut`) plus a lightweight semantic signal:
// `recentMathCue`, which becomes true after tokens that often introduce an
// arithmetic computation (such as "=", "+", "-", "*", "/", or words like
// "compute"). Outside constrained spans, generation is mostly free, but when
// `recentMathCue` is true and the model has not yet opened a span, the strategy
// boosts the "<<" token so arithmetic is likely to be written inside a
// constrained region. Inside a constrained span, it uses adaptive constrained
// decoding with caller-supplied token groups to stay parser-valid while still
// allowing soft preferences over likely arithmetic tokens.
//
// The tracked state supports valid generation as follows: delimiter state keeps
// the parser-constrained substring aligned with the full generated output;
// `recentMathCue` nudges the model to open `<< >>` around computations without
// hard-forcing delimiters everywhere; and adaptive constrained sampling keeps
// each token inside `<< >>` parser-valid, closing the span only when the parser
// says the arithmetic fragment is complete.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span branch, we either stay outside
//   (`insideConstrainedOut == false`) or enter a span only when next == "<<",
//   setting `currentConstrainedOut := []`; the precondition gives
//   parser.IsValidPrefix([]). In the close-span branch, CloseConstrainedSpan
//   sets `insideConstrainedOut := false`, so the implication is vacuous. In the
//   inside-span sampling branch, AdaptiveConstrainedStep guarantees either EOS
//   or a parser-valid next token; on non-EOS we call AppendConstrainedToken,
//   whose postcondition preserves parser validity.
// suffix: In the outside-span branch, if we remain outside then the invariant
//   is vacuous; if we enter a span on "<<", we set `currentConstrainedOut := []`,
//   and the length-0 suffix of `generated` equals `[]`. In the close-span
//   branch, CloseConstrainedSpan appends the delimiter and resets the current
//   constrained prefix to `[]`, so the implication is again vacuous. In the
//   inside-span append branch, AppendConstrainedToken adds the same token to
//   both `generated` and `currentConstrainedOut`, preserving the suffix
//   equality directly.
// cost accounting: `cost` is kept at 0 during the loop and assigned from
//   `steps` at the end. Every non-breaking branch increments `steps` exactly
//   once after one cost-bumping action: outside-span sampling uses either
//   UnconstrainedStep or manual GenerateLogits/ChooseNextTokenUnconstrained
//   with an explicit helpers.cost bump; close-span uses CloseConstrainedSpan;
//   inside-span sampling uses AdaptiveConstrainedStep. Thus returned
//   `cost := steps` satisfies `cost <= maxSteps`.
// progress bound: Outside-span branches append at most one token and then do
//   `steps := steps + 1`; if EOS is sampled, the branch breaks immediately.
//   The close-span branch appends at most one token and increments `steps` by
//   1. The inside-span branch appends exactly one constrained token on non-EOS
//   and increments `steps` by 1; on EOS it breaks after incrementing. Since
//   `generated` never grows by more than one token per non-breaking iteration,
//   `|generated| <= |generatedPrefix| + steps` is preserved, and the decreases
//   metric `maxSteps - steps` strictly decreases on every non-breaking path.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var recentMathCue: bool := false;
var mathCueTokens: seq<Token> := ["=", "+", "-", "*", "/", "compute", "calculate", "total", "sum"];
var openSpanTokens: seq<Token> := ["<<"];

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if recentMathCue && "<<" in lm.Tokens {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, openSpanTokens, 8.0);
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          recentMathCue := false;
        } else {
          recentMathCue := next in mathCueTokens;
        }
      }
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          recentMathCue := false;
        } else {
          recentMathCue := next in mathCueTokens;
        }
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      recentMathCue := false;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        recentMathCue := false;
      }
    }
  }
}

cost := steps;

