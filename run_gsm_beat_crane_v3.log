// The verification issue was the extra "observable progress" loop invariant:
// although intuitively true, Dafny could not re-establish it uniformly across
// all branches. The minimal fix is to remove that invariant and instead prove
// the final disjunctive postcondition directly from a simpler invariant:
// `generated == generatedPrefix && insideConstrainedOut == insideConstrained ==> currentConstrainedOut == currentConstrained`.
// Combined with `cost := steps`, `steps == 0` on loop exit implies full state
// equality, while `steps > 0` implies `cost > 0`; this is enough to discharge
// the postcondition without changing the strategy.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside branch: if we stay outside, the implication is vacuous; if we open
//   a span via OpenConstrainedSpan, currentConstrainedOut becomes [] and
//   parser.IsValidPrefix([]) holds by precondition.
//   Inside-close branch: CloseConstrainedSpan sets insideConstrainedOut to
//   false, so the implication is vacuous. Inside-append branch: the sampled
//   token is parser-valid by ConstrainedSample / GroupBoostedConstrainedStep,
//   and AppendConstrainedToken preserves parser validity.
//
// suffix:
//   Outside branch: when outside, the implication is vacuous; opening a span
//   sets currentConstrainedOut to [], so the empty suffix relation holds.
//   Inside-close branch: after closing, insideConstrainedOut is false, so the
//   implication is vacuous. Inside-append branch: AppendConstrainedToken
//   appends the same token to generated and currentConstrainedOut, preserving
//   the suffix equality.
//
// cost accounting:
//   Every non-breaking state-changing branch uses exactly one cost-bumping
//   helper and then does steps := steps + 1: UnconstrainedStep,
//   OpenConstrainedSpan, CloseConstrainedSpan, ConstrainedSample, or
//   GroupBoostedConstrainedStep. Break branches stop immediately. Thus
//   cost := steps at the end yields cost <= maxSteps.
//
// progress:
//   Unconstrained token branch appends exactly one token and increments steps by
//   1, or breaks on EOS. Open branch appends exactly `<<` and increments steps
//   by 1. Inside-close branch appends at most one token and increments steps by
//   1. Inside-append branch appends exactly one token and increments steps by 1,
//   or breaks on EOS. Therefore every non-breaking branch strictly increases
//   steps, and |generated| <= |generatedPrefix| + steps is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var openedOrClosedSpan: bool := insideConstrained;
var warmup: nat := 4;
var maxConstrainedLen: nat := 24;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant generated == generatedPrefix && insideConstrainedOut == insideConstrained ==> currentConstrainedOut == currentConstrained
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      openedOrClosedSpan := true;
      steps := steps + 1;
    } else {
      if |currentConstrainedOut| >= maxConstrainedLen {
        break;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var next: Token;
        if |validTokenGroups| > 0 {
          next := helpers.GroupBoostedConstrainedStep(
            lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, eosToken
          );
        } else {
          lm.GenerateLogits(prompt + stablePrefix + currentConstrainedOut);
          next := helpers.ConstrainedSample(lm, parser, currentConstrainedOut, eosToken);
        }
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  } else {
    if !openedOrClosedSpan && steps >= warmup && "<<" in lm.Tokens {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedOrClosedSpan := true;
      steps := steps + 1;
    } else {
      var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      } else {
        generated := generated + [nextOutside];
        if nextOutside == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          openedOrClosedSpan := true;
        }
      }
    }
  }
}

