Strategy: // CSD_RATIONALE_BEGIN
// The last verified strategy was close on accuracy but failed the required
// `Contains << >>` threshold because it almost never actually opened a
// constrained span: the trace shows only 11 opens over 100 examples. The main
// issue was architectural, not arithmetic decoding quality. It spent many
// unconstrained steps repeatedly "considering" `<<` by boosting it, then fell
// back to ordinary unconstrained sampling, so the model often never committed
// to the delimiter before the answer ended.
//
// This revision fixes that by making a single arithmetic span mandatory and
// early, while still leaving a short natural-language prelude. Concretely:
// (1) before any span has been opened, we allow only a tiny warmup of a few
// unconstrained tokens to produce step-by-step lead-in text;
// (2) once the warmup is over, if `<<` is available we open the constrained
// span directly with `OpenConstrainedSpan` instead of merely boosting it;
// (3) inside the span, we use parser-valid constrained decoding every step and
// close immediately once the parser says the arithmetic fragment is complete;
// (4) after closing the first span, we strongly prefer a short finish by
// boosting EOS and penalizing reopening `<<`.
//
// This directly addresses the measured failures. Mandatory direct opening
// removes the missing-segment problem. Immediate parser-checked closure keeps
// syntax high. A very short prelude preserves "step by step" wording better
// than opening at token 0, while avoiding the previous trace pattern of dozens
// of unconstrained tokens with no span. Using AdaptiveConstrainedStep inside
// the span also helps malformed constrained content by relying on parser-valid
// next-token masking rather than free-form arithmetic prose.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In outside branches we either remain outside, so the
//   implication is vacuous, or open with OpenConstrainedSpan, which sets the
//   constrained prefix to [] and parser.IsValidPrefix([]) holds by precondition.
//   In the inside-close branch, CloseConstrainedSpan sets insideConstrainedOut
//   to false, so the implication is vacuous. In the inside-sample branch,
//   AdaptiveConstrainedStep returns either eosToken or a parser-valid next
//   token; on the non-EOS path, AppendConstrainedToken preserves validity of
//   currentConstrainedOut.
// suffix: Outside branches are vacuous unless we open a span; after
//   OpenConstrainedSpan, currentConstrainedOut is [], so the empty suffix
//   equality holds immediately. Closing makes the invariant vacuous. In the
//   inside append branch, AppendConstrainedToken appends the same token to both
//   generated and currentConstrainedOut, preserving the suffix relationship.
// cost accounting: We return cost := steps. Every non-breaking branch performs
//   exactly one cost-bumping helper call and then increments steps by 1:
//   UnconstrainedStep, OpenConstrainedSpan, CloseConstrainedSpan, or
//   AdaptiveConstrainedStep. EOS branches break immediately after the helper,
//   so no non-breaking branch leaves steps unchanged.
// progress bound: UnconstrainedStep appends at most one token and we increment
//   steps by 1, preserving |generated| <= |generatedPrefix| + steps.
//   OpenConstrainedSpan appends exactly one token and increments steps by 1.
//   CloseConstrainedSpan appends at most one token and increments steps by 1.
//   In the inside append branch, AdaptiveConstrainedStep contributes one step
//   and AppendConstrainedToken appends exactly one token, so the same bound is
//   preserved; on EOS we break immediately. Thus every non-breaking branch
//   strictly decreases maxSteps - steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var openedSpan: bool := insideConstrained;
var completedSpan: bool := false;
var warmup: nat := 3;
var openAvailable: bool := "<<" in lm.Tokens;
var reopenPenalty: seq<Token> := ["<<"];

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if completedSpan {
      lm.GenerateLogits(prompt + generated);
      helpers.PenalizeTokenLogits(lm, reopenPenalty, 12.0);
      helpers.BoostTokenLogits(lm, [eosToken], 8.0);
      var nextAfter := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if nextAfter == eosToken {
        break;
      } else {
        generated := generated + [nextAfter];
      }
    } else {
      if !openedSpan && openAvailable && steps >= warmup && steps + 2 <= maxSteps {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        openedSpan := true;
        steps := steps + 1;
      } else {
        var nextFree := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if nextFree == eosToken {
          if !openedSpan && openAvailable && steps < maxSteps {
            var forcedGenerated, forcedInside, forcedCurrent := helpers.OpenConstrainedSpan(lm, generated);
            generated := forcedGenerated;
            insideConstrainedOut := forcedInside;
            currentConstrainedOut := forcedCurrent;
            openedSpan := true;
            steps := steps + 1;
          } else {
            break;
          }
        } else {
          generated := generated + [nextFree];
          if nextFree == "<<" && !openedSpan {
            insideConstrainedOut := true;
            currentConstrainedOut := [];
            openedSpan := true;
          }
        }
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      completedSpan := true;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var nextConstrained := helpers.AdaptiveConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
      steps := steps + 1;
      if nextConstrained == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, nextConstrained
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

