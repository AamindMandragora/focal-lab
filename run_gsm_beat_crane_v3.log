Strategy: // CSD_RATIONALE_BEGIN
// This revision keeps the best-performing overall structure—free-form text
// outside, parser-constrained arithmetic inside << >>, and immediate closure
// once complete—but makes two targeted changes to address the measured
// failures.
//
// First, the previous run still spent too many steps fully unconstrained,
// which let the model ramble, omit the arithmetic span until late, or answer
// with prose instead of a short computed result. To fix that without repeating
// the catastrophic "open immediately at token 0" regression, this strategy
// uses a tiny warmup window of ordinary unconstrained decoding and then, if no
// span is active yet, directly opens a single constrained span with the
// verified OpenConstrainedSpan helper. This preserves a short step-by-step
// lead-in while making the required << >> computation much more reliable and
// earlier.
//
// Second, malformed constrained content often came from spans growing too long
// or from weak arithmetic steering inside the span. The revised inside policy
// still uses parser-valid constrained decoding, but now prefers the simpler
// GroupBoostedConstrainedStep helper and adds a hard length cap: if the span
// becomes long, we stop extending it and break rather than wandering into a
// malformed or truncated expression. As before, whenever the parser says the
// constrained prefix is complete, we close immediately with >>.
// 
// The resulting behavior is: a brief natural-language prelude, one early
// parser-valid arithmetic span, immediate closure on completeness, and then a
// short unconstrained finish. This directly targets the observed failures:
// fewer late/no spans, fewer malformed long spans, shorter outputs, and better
// alignment with "step by step, computations inside << >>" formatting.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside branch: if we stay outside after an unconstrained token, the
//   implication is vacuous; if we open a span with OpenConstrainedSpan, the new
//   constrained prefix is [], which is valid by precondition.
//   Inside-close branch: CloseConstrainedSpan sets insideConstrainedOut to
//   false, so the implication is vacuous afterward.
//   Inside-append branch: GroupBoostedConstrainedStep guarantees either EOS or
//   a token whose append preserves parser validity; on the non-EOS path,
//   AppendConstrainedToken therefore yields a valid constrained prefix.
//   Inside-length-cap branch: it breaks immediately, so invariants need not be
//   re-established for another loop iteration.
//
// suffix:
//   Outside branch: when remaining outside, the implication is vacuous; when
//   opening a span, currentConstrainedOut becomes [], which matches the empty
//   suffix of generated after appending "<<".
//   Inside-close branch: after closing, insideConstrainedOut is false, so the
//   implication is vacuous.
//   Inside-append branch: AppendConstrainedToken appends the same token to
//   generated and currentConstrainedOut, preserving that the constrained prefix
//   is exactly the suffix of generated.
//   Inside-length-cap branch breaks immediately.
//
// cost accounting:
//   Every non-breaking branch uses exactly one cost-bumping helper and then
//   increments steps by 1: UnconstrainedStep, OpenConstrainedSpan,
//   GroupBoostedConstrainedStep, or CloseConstrainedSpan. The returned cost is
//   assigned from steps at the end, so cost <= maxSteps follows from the loop
//   bound.
// 
// progress:
//   UnconstrainedStep appends exactly one token and we do steps := steps + 1;
//   OpenConstrainedSpan appends the delimiter token and we do steps := steps + 1;
//   GroupBoostedConstrainedStep either breaks on EOS or is followed by
//   AppendConstrainedToken, which appends one token, and we increment steps by 1;
//   CloseConstrainedSpan appends at most one token and we increment steps by 1;
//   the length-cap branch breaks immediately. Therefore every non-breaking
//   iteration strictly increases steps, satisfying decreases maxSteps - steps,
//   and |generated| <= |generatedPrefix| + steps is preserved because generated
//   grows by at most one token per step.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var openedSpan: bool := insideConstrained;
var warmup: nat := 3;
var boostAmount: real := 4.0;
var spanLenCap: nat := 24;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !openedSpan && steps >= warmup && "<<" in lm.Tokens {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedSpan := true;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          openedSpan := true;
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if |currentConstrainedOut| >= spanLenCap {
        break;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.GroupBoostedConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, boostAmount, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
