Strategy: // CSD_RATIONALE_BEGIN
// The trace shows the core problem clearly: the previous strategy almost never
// entered constrained mode at all (only ~0.1 constrained calls/example), so it
// mostly produced free-form prose and only occasionally emitted a malformed
// `<<...` fragment. The fix is therefore structural, not a small retuning.
//
// This revision makes a single arithmetic span an explicit early objective.
// Outside constrained mode, before any span has been produced, the strategy
// strongly boosts `<<` for the first several decoding steps. That directly
// addresses the observed failure that generations stayed unconstrained for the
// entire answer. Once one span has been opened and later closed, the strategy
// never deliberately opens another span; this keeps the output short and avoids
// the long malformed multi-span answers seen in failures.
//
// Inside the span, the strategy no longer relies on broad adaptive behavior.
// Instead it uses a narrower constrained step: if token groups are available it
// uses group-boosted constrained sampling; otherwise it uses ordinary
// constrained sampling. In both cases every sampled token is parser-valid, and
// the span is closed immediately once `parser.IsCompletePrefix` holds. This
// directly targets the malformed constrained-content failures such as
// `<< Remora` and truncated expressions.
//
// To improve answer brevity after the required arithmetic has been shown, once
// a span has been completed the outer decoding mildly penalizes reopening `<<`
// and mildly boosts EOS. This encourages concise completions after the single
// required computation, reducing repetition and truncation risk while still
// allowing the model to finish naturally.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In outside-span branches we either remain outside, so the
//   implication is vacuous, or open a span via OpenConstrainedSpan, which sets
//   currentConstrainedOut to [] and therefore satisfies parser validity by the
//   precondition on the parser. In the inside-span sampling branch,
//   GroupBoostedConstrainedStep / ConstrainedSample ensure the chosen token is
//   EOS or parser-valid after the current prefix; on non-EOS,
//   AppendConstrainedToken preserves parser validity. In the close branch,
//   insideConstrainedOut becomes false, so the implication is vacuous.
// suffix: Outside a span the invariant is vacuous. Opening a span appends only
//   the delimiter token to generated and sets currentConstrainedOut := [], so
//   the empty suffix relation holds immediately. Appending a constrained token
//   uses AppendConstrainedToken, which appends the same token to generated and
//   currentConstrainedOut, preserving suffix equality. Closing leaves
//   constrained mode, making the implication vacuous.
// cost accounting: The loop returns cost := steps. Every non-breaking branch
//   increments steps by exactly 1 after exactly one cost-bumping action:
//   UnconstrainedStep, manual unconstrained sample with explicit helper-cost
//   bump, OpenConstrainedSpan, GroupBoostedConstrainedStep / ConstrainedSample,
//   or CloseConstrainedSpan. Thus steps never exceeds maxSteps and returned
//   cost <= maxSteps.
// progress bound: In unconstrained token branches we append exactly one token
//   and increment steps by 1. Opening and closing a span append at most one
//   token and increment steps by 1. The constrained append branch samples one
//   parser-valid token, appends exactly one token with AppendConstrainedToken,
//   and increments steps by 1; the EOS branch breaks immediately. Therefore
//   |generated| increases by at most steps relative to generatedPrefix, and the
//   decreases metric maxSteps - steps strictly decreases on every non-breaking
//   path.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var sawSpan: bool := insideConstrained;
var completedSpan: bool := false;
var openTokSeq: seq<Token> := ["<<"];
var eosSeq: seq<Token> := [eosToken];

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var wantOpen := !sawSpan && "<<" in lm.Tokens && steps + 1 < maxSteps && |generated| <= |generatedPrefix| + 8;
    if wantOpen {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, openTokSeq, 100.0);
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        if next == "<<" {
          var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
          generated := openedGenerated;
          insideConstrainedOut := openedInside;
          currentConstrainedOut := openedCurrent;
          sawSpan := true;
        } else {
          generated := generated + [next];
        }
      }
    } else {
      lm.GenerateLogits(prompt + generated);
      if completedSpan {
        if "<<" in lm.Tokens {
          helpers.PenalizeTokenLogits(lm, openTokSeq, 8.0);
        }
        helpers.BoostTokenLogits(lm, eosSeq, 3.0);
      }
      var next2 := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next2 == eosToken {
        break;
      } else {
        if next2 == "<<" && !sawSpan && "<<" in lm.Tokens {
          var openedGenerated2, openedInside2, openedCurrent2 := helpers.OpenConstrainedSpan(lm, generated);
          generated := openedGenerated2;
          insideConstrainedOut := openedInside2;
          currentConstrainedOut := openedCurrent2;
          sawSpan := true;
        } else {
          generated := generated + [next2];
        }
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      completedSpan := true;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next3: Token;
      if |validTokenGroups| > 0 {
        next3 := helpers.GroupBoostedConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, eosToken
        );
      } else {
        lm.GenerateLogits(prompt + stablePrefix + currentConstrainedOut);
        next3 := helpers.ConstrainedSample(lm, parser, currentConstrainedOut, eosToken);
      }
      steps := steps + 1;
      if next3 == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next3
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

