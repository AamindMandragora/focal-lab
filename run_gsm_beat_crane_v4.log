Strategy: // CSD_RATIONALE_BEGIN
// Step-by-step math-solution CSD with delimiter-triggered arithmetic spans.
// The strategy tracks the usual constrained-span state:
//   - `insideConstrainedOut`: whether we are currently inside a `<< ... >>` span
//   - `currentConstrainedOut`: the tokens generated so far inside that active span
// and, additionally, a small strategy-local penalty cache `penaltyTokens` used
// to discourage immediately repeating a token after rolling back from a narrow
// dead-end inside an arithmetic expression.
//
// Outside `<< ... >>`, generation is unconstrained and natural. When the model
// emits `"<<"`, we open a constrained arithmetic span whose contents must stay
// parser-valid. Inside such a span, the strategy chooses between two actions:
//   1) if the parser says the span is complete, close it with `">>"`;
//   2) otherwise, generate the next arithmetic token with an adaptive
//      group-boosted constrained sampler, optionally penalizing one previously
//      excluded token after rollback recovery.
//
// The runtime `validTokenGroups` are used as soft preferences inside arithmetic
// spans: when the grammar is narrow, boosting caller-supplied groups can gently
// favor arithmetic-relevant tokens without violating parser validity. If the
// constrained prefix becomes too narrow after an append, we roll back to the
// last boundary token (here `","`) and remember the excluded divergence token
// so the next constrained step can penalize it. This tracked state supports
// valid step-by-step math generation because every token inside `<< >>` is
// parser-checked, complete arithmetic fragments are closed immediately, and
// rollback prevents the decoder from getting stuck in malformed subexpressions.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Unconstrained branch: if we stay outside, the implication is vacuous; if
//     next == "<<", we set currentConstrainedOut := [], and parser.IsValidPrefix([])
//     is a precondition.
//   - Close branch: CloseConstrainedSpan sets insideConstrainedOut := false, so
//     the implication becomes vacuous.
//   - Penalized/adaptive constrained append branch: the helper returns either
//     eosToken or a parser-valid next token; on non-EOS we call
//     AppendConstrainedToken, whose precondition is exactly that the extended
//     prefix is valid, so validity is preserved.
//   - Rollback recovery sub-branch: RollbackAndExclude ensures the repaired
//     prefix is parser-valid, and we assign that repaired prefix to
//     currentConstrainedOut.
//
// suffix:
//   - Unconstrained branch: when next != "<<", constrained state is unchanged
//     (outside, so implication vacuous); when next == "<<", currentConstrainedOut
//     becomes [], and the length-0 suffix of generated matches [].
//   - Close branch: CloseConstrainedSpan appends the delimiter and resets
//     currentConstrainedOut to [], so the implication is vacuous afterward.
//   - Constrained append branch: AppendConstrainedToken appends the same token
//     to both generated and currentConstrainedOut, preserving the suffix equality.
//   - Rollback recovery sub-branch: RollbackAndExclude ensures repaired is a
//     prefix of the old constrained content; trimming exactly the dropped suffix
//     from generated restores generated[|generated|-|repaired|..] == repaired.
//
// cost accounting:
//   - We return `cost := steps`, so the key invariant is that `steps` counts loop
//     progress and remains within maxSteps. Every non-breaking branch increments
//     steps by exactly 1 after one cost-bumping helper call
//     (UnconstrainedStep, CloseConstrainedSpan, PenalizedConstrainedStep, or
//     AdaptiveConstrainedStep). Rollback/query work is nested inside a branch
//     that already consumed that one step, so no extra step bump is needed.
//   - Break branches occur immediately after the step bump, so cost := steps at
//     the end still satisfies cost <= maxSteps.
//
// progress bound:
//   - Unconstrained branch: appends exactly one token and increments steps by 1,
//     so |generated| grows by at most 1.
//   - Close branch: CloseConstrainedSpan appends at most one token and steps += 1,
//     so the bound is preserved.
//   - Constrained append branch: AppendConstrainedToken adds exactly one token and
//     steps already increased by 1, so |generated| <= |generatedPrefix| + steps.
//   - Rollback recovery sub-branch: rollback may shrink generated after the append;
//     shrinking only makes the inequality easier to satisfy.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var boundaryToken: Token := ",";
var narrowThreshold: int := 2;
var penaltyTokens: seq<Token> := [];

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      penaltyTokens := [];
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next: Token;
      if 0 < |penaltyTokens| && (forall t :: t in penaltyTokens ==> t in lm.Tokens) {
        next := helpers.PenalizedConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, penaltyTokens, 5.0, eosToken
        );
        penaltyTokens := [];
      } else {
        next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
      }
      steps := steps + 1;

      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;

        var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
        if validCount < narrowThreshold && |currentConstrainedOut| > 0 {
          var repaired, excludedTok, hasExcluded := helpers.RollbackAndExclude(
            parser, currentConstrainedOut, boundaryToken
          );
          var dropped := |currentConstrainedOut| - |repaired|;
          generated := generated[..|generated| - dropped];
          currentConstrainedOut := repaired;
          if hasExcluded && excludedTok in lm.Tokens {
            penaltyTokens := [excludedTok];
          }
        }
      }
    }
  }
}

cost := steps;

