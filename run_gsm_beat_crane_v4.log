Strategy: // CSD_RATIONALE_BEGIN
// Step-by-step math-solution CSD with delimiter-triggered constrained spans.
// The strategy tracks the usual generation state (`generated`), whether we are
// currently inside a `<< ... >>` arithmetic span, and the active constrained
// contents (`currentConstrainedOut`) containing only the tokens between the
// delimiters.
//
// Outside a span, generation is mostly free-form, but when the model emits a
// token containing `<<` we immediately open a constrained span so the arithmetic
// content can be parser-checked. Inside a span, the strategy uses an adaptive
// constrained sampler: when caller-supplied token groups are available, they
// are softly boosted at narrow parser states; otherwise decoding falls back to
// ordinary constrained sampling. As soon as the parser reports the arithmetic
// expression is complete, the strategy closes the span by emitting `>>`.
//
// This state supports valid generation because every token added inside an
// active span is parser-valid, the active constrained content is always kept as
// the suffix of `generated`, and delimiter tokens themselves are never stored in
// `currentConstrainedOut`. That lets the model write natural reasoning text
// outside spans while ensuring computations inside `<< >>` remain syntactically
// valid arithmetic steps.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if the sampled token does not
//   open a span we leave insideConstrainedOut false; if it does, we set
//   currentConstrainedOut := [], which is valid by the method precondition
//   parser.IsValidPrefix([]). In the complete-prefix branch, CloseConstrainedSpan
//   returns insideConstrainedOut = false, so the implication is vacuous. In the
//   constrained-sampling branch, AdaptiveConstrainedStep / ConstrainedStep
//   ensure the sampled non-EOS token is parser-valid next, and
//   AppendConstrainedToken therefore preserves parser validity.
// suffix: In the unconstrained branch, either we remain outside the span or we
//   enter with currentConstrainedOut = [], and the length-0 suffix of generated
//   matches []. In the close branch, CloseConstrainedSpan appends only the
//   closing delimiter and resets currentConstrainedOut to [], so the invariant
//   holds vacuously afterward. In the constrained branch, AppendConstrainedToken
//   appends the same token to both generated and currentConstrainedOut, so the
//   constrained content remains exactly the suffix of generated.
// cost accounting: The loop uses a local `steps` counter and returns `cost := steps`.
//   UnconstrainedStep, CloseConstrainedSpan, AdaptiveConstrainedStep, and
//   ConstrainedStep each consume one decoding step, and the loop increments
//   steps by exactly 1 in those branches. No branch relies on helpers.cost for
//   the returned cost, so the returned accounting is simply steps <= maxSteps.
// progress: UnconstrainedStep appends exactly one token and steps := steps + 1,
//   so |generated| grows by at most 1. CloseConstrainedSpan appends at most one
//   token and also increments steps by 1. In the constrained branch, sampling a
//   non-EOS token followed by AppendConstrainedToken appends exactly one token
//   while steps increases by 1; the EOS sub-branch breaks immediately. Thus
//   every non-breaking branch strictly increases steps, satisfying the decreases
//   clause and preserving |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var useGroups: bool := 0 < |validTokenGroups|;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" || Contains(next, "<<") {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var nextConstrained: Token;
      if useGroups {
        nextConstrained := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
      } else {
        var g2, i2, c2, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := g2;
          insideConstrainedOut := i2;
          currentConstrainedOut := c2;
        }
        nextConstrained := eosToken;
      }

      if useGroups {
        steps := steps + 1;
        if nextConstrained == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, nextConstrained
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

