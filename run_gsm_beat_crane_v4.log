Strategy: // CSD_RATIONALE_BEGIN
// Revised from the 68%-accuracy baseline with two targeted changes aimed at the
// observed failures.
// 1) Missing or too-late `<< >>` spans: the baseline waited for the model to
//    emit `"<<"` on its own, and evaluation still showed examples with no
//    constrained computation. This version therefore forces exactly one early
//    arithmetic span after a short unconstrained prefix if none has appeared
//    yet. That directly improves the required "Contains << >>" condition while
//    still leaving room for natural-language setup before the computation.
// 2) Malformed/overlong constrained content: several failures showed symbolic
//    variable names or long expressions inside delimiters. To make spans shorter
//    and more arithmetic-like, inside a span we first prefer caller-supplied
//    arithmetic groups, but once the span has grown a bit we switch to a plain
//    parser-masked constrained step with no extra boosting. We also close
//    immediately whenever the parser says the expression is complete. This keeps
//    computations parser-valid and biases toward concise expressions such as
//    numbers and operator chains rather than verbose symbolic text.
//
// The overall strategy is still mostly natural-language outside spans, but it
// now guarantees an early well-formed arithmetic segment and uses a more
// conservative constrained decoder to reduce malformed math inside `<< >>`.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span branch, either we stay outside after an
//   unconstrained token, or we open a span with OpenConstrainedSpan, which sets
//   currentConstrainedOut := [] and [] is parser-valid by precondition. In the
//   close branch, CloseConstrainedSpan sets insideConstrainedOut := false, so
//   the implication is vacuous. In both constrained decoding branches, the
//   sampled token is guaranteed parser-valid after currentConstrainedOut unless
//   it is eosToken; on the non-EOS path, AppendConstrainedToken preserves
//   parser-validity of the updated constrained prefix.
// suffix: When outside the span, either we remain outside so the implication is
//   vacuous, or we open a span and set currentConstrainedOut := [], whose
//   length-0 suffix matches generated. In the close branch, CloseConstrainedSpan
//   resets currentConstrainedOut := [], so the suffix implication is vacuous
//   afterward. In each constrained append branch, AppendConstrainedToken appends
//   the same next token to both generated and currentConstrainedOut, preserving
//   exact suffix equality.
// cost accounting: We maintain cost == 0 in the loop and return cost := steps at
//   the end. Every non-breaking branch uses exactly one cost-bumping helper and
//   then increments steps by 1: UnconstrainedStep outside, OpenConstrainedSpan
//   for forced entry, CloseConstrainedSpan on completion, AdaptiveConstrainedStep
//   in the boosted constrained branch, and ConstrainedStep in the plain branch.
//   AppendConstrainedToken is non-bumping, so no extra accounting is needed.
// progress bound: UnconstrainedStep appends at most one token and we increment
//   steps by 1; OpenConstrainedSpan appends exactly one token and we increment
//   steps by 1; CloseConstrainedSpan appends at most one token and again steps
//   increases by 1. In the boosted constrained branch, AdaptiveConstrainedStep
//   either yields EOS and we break immediately, or we append exactly one token
//   with AppendConstrainedToken while steps has already increased by 1. In the
//   plain constrained branch, ConstrainedStep either breaks on EOS with state
//   unchanged or returns one more generated token while steps increases by 1.
//   Thus every non-breaking branch strictly increases steps, satisfying the
//   decreases clause and preserving |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var openedAnySpan: bool := insideConstrained;
var forceAfter: nat := 8;
var narrowThreshold: nat := 8;
var maxBoostedSpanLen: nat := 6;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !openedAnySpan && steps >= forceAfter {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedAnySpan := true;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          openedAnySpan := true;
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      if |validTokenGroups| > 0 && |currentConstrainedOut| < maxBoostedSpanLen {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var constrainedPrompt := prompt + stablePrefix;
        var g, i, c, hitEos := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := g;
          insideConstrainedOut := i;
          currentConstrainedOut := c;
        }
      }
    }
  }
}

cost := steps;

