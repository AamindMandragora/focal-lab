Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy relied on the model to *emit* `<<` naturally during
// unconstrained decoding. Evaluation showed that this almost never happened,
// so many answers contained no arithmetic spans at all, and when spans did
// appear they were sometimes malformed or left unterminated. The revised
// strategy therefore makes delimiter use explicit and cheap:
//
// 1) Outside constrained mode, decode normally only until we see evidence that
//    the model is about to perform a computation. In particular, if the sampled
//    token is `"<<"` we open a span immediately; additionally, if the sampled
//    token contains `"<<"`, we stop rather than continue with a malformed mixed
//    token. This directly addresses the "Contains << >>: no" failures.
//
// 2) Once inside `<< ... >>`, use only verified constrained helpers to extend
//    the arithmetic expression. We prefer `AdaptiveConstrainedStep` with the
//    caller-supplied token groups, but when the constrained prefix becomes
//    narrow we switch to `ConstrainedStep` for a plain parser-masked step.
//    This reduces malformed constrained content by avoiding extra recovery
//    machinery that previously rolled back to a comma boundary unrelated to the
//    arithmetic grammar.
//
// 3) As soon as `parser.IsCompletePrefix(currentConstrainedOut)` holds, close
//    the span immediately with `CloseConstrainedSpan`. EOS inside a constrained
//    span is treated as terminal and causes an immediate stop rather than
//    risking an unterminated or partially repaired expression.
//
// 4) To improve runtime, the unconstrained region is generated in chunks using
//    `UnconstrainedChunk` with open-span token `"<<"`. This sharply reduces the
//    large number of token-by-token unconstrained helper calls observed in the
//    trace, while still letting the strategy react exactly when a constrained
//    arithmetic span begins.
//
// Overall, the new design is simpler and more disciplined: chunked
// unconstrained generation to find `<<`, parser-only constrained generation
// inside the span, and immediate closure on completion.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Unconstrained-chunk branch: if we remain outside, the implication is
//     vacuous; if the chunk stops on an open span, we call OpenConstrainedSpan,
//     which sets currentConstrainedOut := [], and parser.IsValidPrefix([]) is a
//     precondition.
//   - Explicit-open branch from a sampled token `"<<"`: OpenConstrainedSpan
//     again establishes insideConstrainedOut with empty constrained content.
//   - Complete-prefix close branch: CloseConstrainedSpan sets
//     insideConstrainedOut := false, so the implication is vacuous afterward.
//   - Constrained-step branches: both AdaptiveConstrainedStep and
//     ConstrainedStep guarantee either eosToken or a parser-valid next token;
//     on non-EOS, AppendConstrainedToken preserves parser validity of the new
//     constrained prefix.
//
// suffix:
//   - Unconstrained-chunk branch: while outside constrained mode, the suffix
//     invariant is vacuous; if we open a span, currentConstrainedOut becomes [],
//     which matches the length-0 suffix of generated.
//   - Explicit-open branch: OpenConstrainedSpan appends only the delimiter and
//     resets currentConstrainedOut to [], so the suffix equality holds
//     trivially.
//   - Close branch: after CloseConstrainedSpan we are outside constrained mode,
//     making the implication vacuous.
//   - Constrained append branches: AppendConstrainedToken appends the same token
//     to generated and currentConstrainedOut, so
//     generated[|generated|-|currentConstrainedOut|..] == currentConstrainedOut
//     is preserved exactly.
//
// cost accounting:
//   - We return cost := steps. UnconstrainedChunk increases generated by
//     stepsUsed tokens and we do steps := steps + stepsUsed. Open, close, and
//     each constrained sampling branch consume exactly one helper step and we
//     increment steps by 1 accordingly.
//   - Break branches happen immediately after a helper step (or after a chunk
//     that already reported stepsUsed), so cost := steps remains <= maxSteps.
//
// progress bound:
//   - UnconstrainedChunk appends exactly stepsUsed tokens and we increment steps
//     by stepsUsed, so |generated| <= |generatedPrefix| + steps is preserved.
//   - OpenConstrainedSpan appends one delimiter token and we increment steps by
//     1.
//   - CloseConstrainedSpan appends at most one token and we increment steps by
//     1.
//   - Constrained append branches append exactly one token via
//     AppendConstrainedToken after one constrained sampling step, so the bound
//     advances in lockstep. Break-on-EOS branches append no token, which also
//     preserves the inequality.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var chunkLimit: nat := stepTokenBudget + 1;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remaining := maxSteps - steps;
    var maxChunk := if chunkLimit < remaining then chunkLimit else remaining;
    var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, maxChunk, "<<", eosToken
    );
    generated := chunkGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else {
      if stoppedOnOpenSpan {
        if steps < maxSteps {
          var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
          generated := openedGenerated;
          insideConstrainedOut := openedInside;
          currentConstrainedOut := openedCurrent;
          steps := steps + 1;
        }
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var next: Token;
      if validCount <= 2 {
        var stepGenerated, stepInside, stepCurrent, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := stepGenerated;
          insideConstrainedOut := stepInside;
          currentConstrainedOut := stepCurrent;
        }
      } else {
        next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

