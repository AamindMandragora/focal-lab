Strategy: // CSD_RATIONALE_BEGIN
// Revised from the 68%-accuracy delimiter-triggered baseline with two targeted
// changes that directly address the reported failures while staying close to the
// successful design.
//
// 1) Do not force early opening of `<<`. The failed forced-open variant entered
// constrained mode almost immediately and then spent nearly the whole budget
// inside an arithmetic span, producing long unterminated expressions. This
// version returns to the better baseline behavior outside spans: generation is
// unconstrained until the model itself emits the exact delimiter token `<<`.
// That avoids the "entered_constrained_mode_too_early" failure mode.
//
// 2) Add a hard cap on constrained-span length with graceful closure. The main
// remaining failure of the baseline was unterminated spans. Here, once inside a
// span, we still close immediately whenever the parser reports the arithmetic
// prefix is complete. But if the span grows beyond a small token budget, we
// stop extending it and terminate generation instead of continuing an endless
// arithmetic loop. This sacrifices some long derivations but strongly reduces
// malformed and unterminated outputs. To improve the chance of reaching a
// complete arithmetic phrase before that cap, the strategy uses plain
// ConstrainedStep after a few constrained tokens, while keeping the baseline's
// AdaptiveConstrainedStep early in the span when group boosts are most useful.
//
// The result is intentionally conservative: natural-language reasoning remains
// mostly unconstrained; arithmetic content inside `<< >>` stays parser-valid;
// complete expressions are closed as soon as possible; and runaway constrained
// loops are cut off before they consume the full decoding budget.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span branch, unconstrained sampling either
//   leaves us outside or appends the exact token `<<`, after which we set
//   currentConstrainedOut := []; parser.IsValidPrefix([]) is assumed. In the
//   close branch, CloseConstrainedSpan sets insideConstrainedOut := false, so
//   the implication is vacuous. In both constrained sampling branches,
//   AdaptiveConstrainedStep or ConstrainedStep returns either eosToken or a
//   parser-valid next token; on the non-EOS path, AppendConstrainedToken
//   preserves parser validity.
// suffix: Outside the span, remaining outside makes the implication vacuous; if
//   we see `<<`, we enter with empty constrained content, whose length-0 suffix
//   matches generated. In the close branch, we leave constrained mode, so the
//   implication is vacuous. In each constrained append branch, the same token is
//   appended to generated and currentConstrainedOut by AppendConstrainedToken,
//   preserving exact suffix equality.
// cost accounting: We maintain cost == 0 in the loop and return cost := steps.
//   Every non-breaking branch that performs work increments steps by 1 after one
//   cost-bumping helper: UnconstrainedStep, CloseConstrainedSpan,
//   AdaptiveConstrainedStep, or ConstrainedStep. The hard-cap branch breaks
//   immediately without changing state, which is allowed. Thus the returned cost
//   equals the counted steps and remains at most maxSteps.
// progress bound: UnconstrainedStep appends at most one token and then steps
//   increases by 1. CloseConstrainedSpan appends at most one token and also
//   increments steps by 1. The adaptive and plain constrained branches either
//   break on EOS with no append, or append exactly one token via
//   AppendConstrainedToken and then increment steps by 1. The hard-cap branch
//   breaks immediately. Therefore every non-breaking branch strictly increases
//   steps, satisfying decreases maxSteps - steps, and |generated| stays within
//   |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var sawPreferredArithmetic: bool := false;
var constrainedCap: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
        sawPreferredArithmetic := false;
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      sawPreferredArithmetic := false;
      steps := steps + 1;
    } else {
      if |currentConstrainedOut| >= constrainedCap {
        break;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        if |currentConstrainedOut| < 4 {
          var next := helpers.AdaptiveConstrainedStep(
            lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
          );
          steps := steps + 1;
          if next == eosToken {
            break;
          } else {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;

            if |validTokenGroups| > 0 {
              var grp := helpers.GroupContaining(validTokenGroups, next);
              if 0 <= grp {
                sawPreferredArithmetic := true;
              }
            }
          }
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2, hitEos := helpers.ConstrainedStep(
            lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
          );
          steps := steps + 1;
          if hitEos {
            break;
          } else {
            generated := appendedGenerated2;
            insideConstrainedOut := appendedInside2;
            currentConstrainedOut := appendedCurrent2;
          }
        }
      }
    }
  }
}

cost := steps;

