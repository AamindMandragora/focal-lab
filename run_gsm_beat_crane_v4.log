Strategy: // CSD_RATIONALE_BEGIN
// Revised from the 68%-accuracy delimiter-triggered baseline with one targeted
// change aimed at the main observed failure: many outputs never contained any
// `<< >>` span at all because the strategy waited for the model to emit `<<`
// spontaneously during unconstrained decoding. This version still keeps natural
// language generation mostly unconstrained, but it now forces a constrained span
// to open after a short unconstrained prefix if no span has appeared yet.
// Concretely: outside a span, for the first few decoding steps we sample
// normally; once a small threshold is reached and we still have not opened any
// arithmetic span, we call OpenConstrainedSpan directly. Inside a span, the
// behavior stays close to the successful baseline: if the arithmetic prefix is
// complete, close immediately with `>>`; otherwise generate the next token with
// AdaptiveConstrainedStep and append it only when parser-valid.
//
// This small intervention preserves the strengths of the prior strategy
// (parser-validated arithmetic, immediate closure of complete expressions, soft
// group bias on narrow arithmetic frontiers) while directly addressing the
// evaluation failures "Contains << >>: no" and many unterminated runs caused by
// opening too late or never. Forcing an early span makes it much more likely
// that every answer contains at least one well-formed computation inside
// delimiters, and immediate close on complete prefixes keeps those spans short.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span branch, ordinary unconstrained sampling
//   leaves insideConstrainedOut false unless next == "<<"; in that case we enter
//   with currentConstrainedOut := [], which is parser-valid by precondition.
//   The forced-open branch uses OpenConstrainedSpan, which also sets
//   currentConstrainedOut := []; validity therefore holds. In the close branch,
//   CloseConstrainedSpan sets insideConstrainedOut := false, so the implication
//   is vacuous. In the adaptive constrained branch, AdaptiveConstrainedStep
//   returns either eosToken or a parser-valid next token, and
//   AppendConstrainedToken preserves parser validity on the non-EOS path.
// suffix: Outside the span, if we stay outside the implication is vacuous; if
//   we open a span either by seeing "<<" or by OpenConstrainedSpan, then
//   currentConstrainedOut becomes [], whose length-0 suffix matches generated.
//   In the close branch, CloseConstrainedSpan resets currentConstrainedOut := []
//   and leaves us outside, so the implication is vacuous. In the constrained
//   append branch, AppendConstrainedToken appends the same token to generated
//   and currentConstrainedOut, preserving exact suffix equality.
// cost accounting: We use local steps and return cost := steps. Every
//   non-breaking branch performs exactly one costed helper action and then
//   increments steps by 1: UnconstrainedStep, OpenConstrainedSpan,
//   CloseConstrainedSpan, and AdaptiveConstrainedStep. AppendConstrainedToken is
//   non-bumping, so it does not affect the accounting. Breaks happen only after
//   a costed step has already been counted, so cost := steps satisfies
//   cost <= maxSteps.
// progress bound: UnconstrainedStep appends at most one token and steps grows by
//   1, preserving |generated| <= |generatedPrefix| + steps. OpenConstrainedSpan
//   appends exactly one token and also increments steps by 1. CloseConstrainedSpan
//   appends at most one token and increments steps by 1. The constrained branch
//   either breaks on EOS with no append, or appends exactly one token via
//   AppendConstrainedToken after one adaptive sampling step and increments steps
//   by 1. Thus every non-breaking branch strictly increases steps, satisfying
//   decreases maxSteps - steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var sawPreferredArithmetic: bool := false;
var openedAnySpan: bool := insideConstrained;
var forceOpenAfter: nat := 6;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !openedAnySpan && steps >= forceOpenAfter && "<<" in lm.Tokens {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedAnySpan := true;
      sawPreferredArithmetic := false;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          openedAnySpan := true;
          sawPreferredArithmetic := false;
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      sawPreferredArithmetic := false;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;

        if |validTokenGroups| > 0 {
          var grp := helpers.GroupContaining(validTokenGroups, next);
          if 0 <= grp {
            sawPreferredArithmetic := true;
          }
        }
      }
    }
  }
}

cost := steps;

