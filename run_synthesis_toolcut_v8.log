Strategy: // CSD_RATIONALE_BEGIN
// Step-by-step math solutions need arithmetic work to appear inside << >> spans.
// This strategy tracks the full generated output in generated, whether we are
// currently inside a constrained arithmetic span in insideConstrainedOut, and
// the contents of that active span in currentConstrainedOut. Outside a span, it
// generates freely but proactively opens a span when the model either emits "<<"
// directly or produces a token containing "<<". Inside a span, it prefers valid
// arithmetic continuations by checking the current argmax against the parser;
// if the argmax is invalid, it falls back to ConstrainedStep. Once the parser
// reports that the constrained prefix is complete, it closes the span with ">>".
// This tracked state ensures that only parser-valid text is accumulated between
// delimiters while the surrounding explanation remains unconstrained.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if we stay outside the span the
//   implication is vacuous; if we open a span (either because next == "<<" or
//   because Contains(next, "<<")), we set currentConstrainedOut := [], which is
//   valid by the method precondition on parser.IsValidPrefix([]). In the
//   complete-prefix branch, CloseConstrainedSpan sets insideConstrainedOut to
//   false, so the implication is vacuous afterward. In the inside-span branch,
//   the speculative fast path calls AppendConstrainedToken only after
//   IsTokenValidNext returned true, and the fallback uses ConstrainedStep then
//   AppendConstrainedToken, so the new constrained prefix remains valid.
// suffix: Outside a span, no suffix obligation is required; when we open a span
//   we append the opening delimiter to generated and set currentConstrainedOut
//   to [], so the length-0 suffix matches []. CloseConstrainedSpan atomically
//   appends ">>" and resets currentConstrainedOut to [], making the suffix fact
//   immediate. In both append branches inside a span, AppendConstrainedToken
//   appends the same token to generated and currentConstrainedOut, preserving
//   the suffix equality.
// cost: UnconstrainedStep, ConstrainedStep, and CloseConstrainedSpan each bump
//   helpers.cost by 1 internally, and we also increment steps by 1 in the same
//   iteration, so helpers.cost <= steps is preserved there. In the speculative
//   argmax-valid append branch, we only use queries plus AppendConstrainedToken,
//   which does not bump helpers.cost, while steps still increases by 1, so the
//   inequality remains true with extra slack.
// progress: In the unconstrained branch we append at most one token to
//   generated; opening a span on Contains(next, "<<") still appends only that
//   one token. CloseConstrainedSpan appends one closing delimiter token. Inside
//   a span, either AppendConstrainedToken appends one token or EOS breaks
//   without appending. Since steps increases by 1 in every non-breaking
//   iteration, |generated| <= |generatedPrefix| + steps is maintained.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        var sawOpen := Contains(next, "<<");
        if sawOpen {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);
      if argmaxValid && argmax != eosToken {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

cost := steps;

