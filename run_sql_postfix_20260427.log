Strategy: // CSD_RATIONALE_BEGIN
// The prior strategy was too prefix-greedy inside SQL: it often kept sampling
// locally plausible continuations yet failed to drive the constrained span to a
// complete query before budget exhaustion, yielding outputs that effectively
// stalled around very short prefixes such as "SELECT". The repetition failures
// also indicate that broad-token sampling inside the grammar allowed the model
// to dither instead of committing to completion.
//
// This revision adopts a much more completion-oriented policy for Spider:
//
// 1) Outside the constrained span, use one unconstrained chunk to reach "<<"
//    cheaply, preserving the required wrapper behavior.
// 2) Inside the constrained span, use only parser-constrained decoding; no
//    free-form token sampling and no broad valid-candidate boosting.
// 3) Once inside, reserve the final remaining step for closing ">>". Therefore,
//    while more than one step remains, we keep extending the SQL with exactly
//    one constrained token per step; as soon as the SQL prefix is complete and
//    at least one step remains, we close immediately.
// 4) If the parser reports a dead end, roll back to a valid constrained prefix.
//    If that rolled-back prefix is complete and one step remains, close it;
//    otherwise stop rather than spending steps on invalid wandering.
//
// The key change is removing the mixed broad-sampling branch that caused
// incomplete "SELECT"-style outputs and repetition. The strategy now spends the
// entire in-span budget on deterministic parser-respecting growth, prioritizing
// reaching a complete SQL query and then immediately emitting ">>".
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained-chunk branch we either remain outside
//   the span, or stop on "<<" and set currentConstrainedOut := [], which is a
//   valid parser prefix by precondition. In the constrained-step branch,
//   ConstrainedStep returns a parser-valid next token and AppendConstrainedToken
//   extends the constrained prefix with that token, preserving validity. In the
//   close branch, insideConstrainedOut becomes false, so the implication is
//   vacuous. In the rollback branch, RollbackConstrainedSpan restores a valid
//   constrained prefix by helper contract intuition; if we then close, the
//   implication is again vacuous, and otherwise we break immediately.
// suffix: Outside the span the invariant is vacuous; opening on "<<" sets
//   currentConstrainedOut to [] so the suffix equality holds trivially. In the
//   constrained-step branch, AppendConstrainedToken appends the same token to
//   generated and currentConstrainedOut, preserving suffix equality. Closing
//   makes insideConstrainedOut false, so the implication is vacuous. Rollback
//   explicitly restores generated/currentConstrainedOut to a matching valid
//   constrained suffix before any optional close or break.
// progress: UnconstrainedChunk appends stepsUsed tokens and we add exactly
//   stepsUsed to steps. Each constrained-step branch appends exactly one token
//   and increments steps by 1. Each close branch appends exactly one token and
//   increments steps by 1. Rollback itself is pure state repair; any rollback
//   branch either closes with one extra counted step or breaks immediately.
//   Therefore |generated| <= |generatedPrefix| + steps is preserved.
// cost accounting: We maintain a local steps counter and return cost := steps.
//   UnconstrainedChunk contributes stepsUsed, each ConstrainedStep contributes
//   1, and each CloseConstrainedSpan contributes 1. Query helpers and rollback
//   helpers do not change steps. Since the loop guard enforces steps < maxSteps
//   before any costed action and each action increases steps linearly, we end
//   with cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else {
      if stoppedOnOpenSpan {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        break;
      }
    }
  } else {
    var remaining: nat := maxSteps - steps;
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      if remaining >= 1 {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
      } else {
        break;
      }
    } else {
      if remaining <= 1 {
        break;
      } else {
        var deadEnd := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
        if deadEnd {
          var stablePrefixDead := generated[..|generated| - |currentConstrainedOut|];
          var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
            parser, stablePrefixDead, generated, currentConstrainedOut
          );
          generated := rolledGenerated;
          currentConstrainedOut := rolledCurrent;

          var completeAfterRollback := parser.IsCompletePrefix(currentConstrainedOut);
          if completeAfterRollback {
            if steps < maxSteps {
              var closedGenerated2, closedInside2, closedCurrent2 := helpers.CloseConstrainedSpan(
                lm, parser, generated, currentConstrainedOut
              );
              generated := closedGenerated2;
              insideConstrainedOut := closedInside2;
              currentConstrainedOut := closedCurrent2;
              steps := steps + 1;
            } else {
              break;
            }
          } else {
            break;
          }
        } else {
          var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
          var constrainedPrompt := prompt + stablePrefix;
          var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if next == eosToken {
            break;
          } else {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
          }
        }
      }
    }
  }
}

cost := steps;

