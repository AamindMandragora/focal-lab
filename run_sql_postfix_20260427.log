Strategy: // CSD_RATIONALE_BEGIN
// The evaluation shows the core problem was not SQL syntax inside the parser-
// governed state; syntax was already high. The real failure was that the final
// emitted text often lacked a clean extractable << ... >> span, with previews
// like `SELECT <id> FROM <id>>>` indicating the model was generating SQL-like
// text directly instead of reliably emitting the delimiter tokens as separate
// output tokens. So this revision changes the strategy more fundamentally:
//
// 1) Always begin by explicitly opening a constrained span via OpenConstrainedSpan,
//    then generate only inside that span until we can explicitly close it via
//    CloseConstrainedSpan. This guarantees at least one internal parser-governed
//    chunk is used and makes the final text contain the opening delimiter.
//
// 2) Once inside, never leave constrained mode except through the helper
//    CloseConstrainedSpan on a parser-complete prefix. This ensures the closing
//    delimiter is emitted structurally, not by hoping the model writes `>>` as
//    ordinary text.
//
// 3) Use ConstrainedSymbol as the main generation primitive, but close
//    immediately whenever the current constrained prefix is complete. This keeps
//    the SQL parser in control while prioritizing extractable completion over
//    extra elaboration.
//
// 4) If a dead end is detected, roll back to a valid constrained prefix and then
//    either close immediately if that rolled-back prefix is complete or continue
//    with another constrained-symbol step. This preserves parser validity and
//    avoids getting stuck in malformed partial SQL.
//
// 5) After closing the constrained span, stop immediately. Spider expects a
//    single SQL query, and extra trailing text only risks confusing extraction.
//
// In short: explicitly open `<<`, generate SQL only under parser control,
// explicitly close `>>` as soon as the SQL is complete, and stop. This directly
// targets the benchmark's missing-`<< >>` extraction failures.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open branch, OpenConstrainedSpan starts an empty
//   constrained segment, and [] is valid by precondition. In the constrained
//   generation branch, ConstrainedSymbol returns a parser-valid constrained
//   prefix; assigning generated := stablePrefix + currentOut keeps the tracked
//   constrained content equal to that valid prefix. In rollback, the helper
//   restores a valid constrained prefix. In close branches, insideConstrainedOut
//   becomes false, so the implication is vacuous.
//
// suffix: Outside constrained mode the invariant is vacuous. Opening creates an
//   empty constrained suffix, so the suffix of length 0 matches trivially. In
//   each constrained-generation branch we compute stablePrefix by removing the
//   old constrained suffix and then assign generated := stablePrefix + currentOut,
//   so generated ends exactly with currentConstrainedOut. RollbackConstrainedSpan
//   returns matching generated/current values. Closing makes the implication
//   vacuous because constrained mode ends.
//
// progress: OpenConstrainedSpan appends exactly 1 token and we increment steps
//   by 1. Each ConstrainedSymbol branch appends stepsUsed tokens relative to the
//   previous generated text because generated becomes stablePrefix + currentOut,
//   where currentOut extends the old constrained suffix by exactly the tokens
//   consumed in that call; we increment steps by the same stepsUsed. Each close
//   appends exactly 1 token and increments steps by 1. Rollback only shrinks or
//   preserves generated, so |generated| <= |generatedPrefix| + steps remains true.
//   Break branches leave all values unchanged.
//
// cost accounting: We use local steps as the returned cost. Every cost-bumping
//   helper call is mirrored by the same increase in steps: +1 for open and close,
//   +stepsUsed for ConstrainedSymbol. Query and rollback helpers do not increase
//   steps. All bumping branches first check remaining budget, so steps never
//   exceeds maxSteps, and we return cost := steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if steps + 1 <= maxSteps {
      var gOpen, inOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
      generated := gOpen;
      insideConstrainedOut := inOpen;
      currentConstrainedOut := cOpen;
      steps := steps + 1;
    } else {
      break;
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      if steps + 1 <= maxSteps {
        var gClose, inClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := gClose;
        insideConstrainedOut := inClose;
        currentConstrainedOut := cClose;
        steps := steps + 1;
        break;
      } else {
        break;
      }
    } else {
      var dead := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if dead {
        var stableDead := generated[..|generated| - |currentConstrainedOut|];
        var gRoll, cRoll := helpers.RollbackConstrainedSpan(parser, stableDead, generated, currentConstrainedOut);
        generated := gRoll;
        currentConstrainedOut := cRoll;
        insideConstrainedOut := true;

        var completeRolled := parser.IsCompletePrefix(currentConstrainedOut);
        if completeRolled {
          if steps + 1 <= maxSteps {
            var gClose2, inClose2, cClose2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
            generated := gClose2;
            insideConstrainedOut := inClose2;
            currentConstrainedOut := cClose2;
            steps := steps + 1;
            break;
          } else {
            break;
          }
        } else {
          var remaining1 := maxSteps - steps;
          if remaining1 == 0 || stepTokenBudget == 0 {
            break;
          } else {
            var stable1 := generated[..|generated| - |currentConstrainedOut|];
            var constrainedPrompt1 := prompt + stable1;
            var current1, hitEos1, used1 := helpers.ConstrainedSymbol(
              lm, parser, constrainedPrompt1, currentConstrainedOut, stepTokenBudget, eosToken
            );
            if hitEos1 || used1 == 0 {
              break;
            } else {
              if steps + used1 <= maxSteps {
                generated := stable1 + current1;
                currentConstrainedOut := current1;
                insideConstrainedOut := true;
                steps := steps + used1;
              } else {
                break;
              }
            }
          }
        }
      } else {
        var remaining2 := maxSteps - steps;
        if remaining2 == 0 || stepTokenBudget == 0 {
          break;
        } else {
          var stable2 := generated[..|generated| - |currentConstrainedOut|];
          var constrainedPrompt2 := prompt + stable2;
          var current2, hitEos2, used2 := helpers.ConstrainedSymbol(
            lm, parser, constrainedPrompt2, currentConstrainedOut, stepTokenBudget, eosToken
          );
          if hitEos2 || used2 == 0 {
            break;
          } else {
            if steps + used2 <= maxSteps {
              generated := stable2 + current2;
              currentConstrainedOut := current2;
              insideConstrainedOut := true;
              steps := steps + used2;
            } else {
              break;
            }
          }
        }
      }
    }
  }
}

cost := steps;

