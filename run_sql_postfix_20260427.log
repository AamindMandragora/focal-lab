Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy successfully produced a recognized constrained chunk, but
// it failed semantically because it opened the chunk too early and then generated
// SQL from an empty or weakly conditioned prefix. On Spider, the prompt already
// contains the schema and question; the intended behavior is to let the model
// draft SQL in-context, but force the final answer region itself to be parser-
// valid. The observed failures like `SELECT avg` suggest the constrained region
// was started before the model had enough unconstrained setup, causing short,
// incomplete SQL fragments.
//
// The revised strategy uses a two-phase policy:
//
// 1. Outside a constrained span, first take a bounded unconstrained chunk so the
//    model can naturally emit any answer preamble and, crucially, reach the point
//    where it wants to start SQL. We stop that chunk exactly when either `<<` or
//    EOS is reached. This leverages the model's own preference for where the SQL
//    should begin instead of forcing an immediate constrained start.
//
// 2. If the unconstrained chunk stops on an opening delimiter, we enter a single
//    parser-governed span and stay there until either the SQL prefix is complete
//    and we can legally close it, or we run out of budget. Inside the span we use
//    `helpers.ConstrainedStep`, which conditions on `prompt + stablePrefix` and
//    the current constrained prefix, giving token-level parser-valid expansion.
//    This is better aligned with text-to-SQL than symbol-level repair from an
//    empty prefix.
//
// 3. We never fabricate `<<` ourselves unless we were already inside a span on
//    entry. Instead, we rely on `UnconstrainedChunk` to stop on the model-chosen
//    opening delimiter token. This should preserve the evaluator-visible `<< >>`
//    chunk while improving SQL quality by letting the model decide when to begin
//    the constrained answer.
//
// 4. If we begin already inside a constrained span, we continue that span. If a
//    dead end is detected, we roll back to a valid constrained prefix and keep
//    going. We close only from a branch where `parser.IsCompletePrefix(...)` is
//    known, as required.
//
// In short, the key change is replacing "open constrained span immediately" with
// "use unconstrained drafting until the model opens `<<`, then enforce grammar
// inside that span". This directly targets the semantic failures while retaining
// the required `<< ... >>` structure.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained-chunk branch we remain outside a
//   constrained span, so the implication is vacuous. In the constrained-step
//   branch, `helpers.ConstrainedStep` returns a next token that is valid for the
//   parser prefix, and `AppendConstrainedToken` extends the constrained prefix
//   accordingly, preserving validity. In the rollback branch,
//   `RollbackConstrainedSpan` restores a valid constrained prefix by construction.
//   In the close branch, `insideConstrainedOut` becomes false, so the implication
//   is vacuous.
//
// suffix: UnconstrainedChunk only runs when outside a constrained span, so the
//   suffix invariant is vacuous there. In the constrained-step branch,
//   `AppendConstrainedToken` appends the chosen token both to `generated` and to
//   `currentConstrainedOut`, so the generated suffix remains exactly the tracked
//   constrained prefix. Rollback returns a repaired `(generated, current)` pair
//   satisfying the suffix relation. After closing, `insideConstrainedOut` is
//   false, so the implication is vacuous.
//
// progress: UnconstrainedChunk appends `usedChunk` tokens and we increment
//   `steps` by `usedChunk`. Each constrained-step append adds exactly 1 token and
//   we increment `steps` by 1; CloseConstrainedSpan also appends exactly 1 token
//   and increments `steps` by 1. Rollback and break branches do not increase
//   `generated` or `steps`. Thus `|generated| <= |generatedPrefix| + steps` is
//   preserved by linear arithmetic in every branch.
//
// cost accounting: The returned `cost` is the local `steps` counter. We add
//   `usedChunk` after each `UnconstrainedChunk`, add 1 after each
//   `ConstrainedStep`/append iteration, and add 1 after `CloseConstrainedSpan`.
//   Query-only and rollback branches do not change `steps`. Every increment is
//   guarded by the remaining budget, so `steps <= maxSteps` always holds and
//   `cost := steps` satisfies `cost <= maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var openedSeen: bool := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if openedSeen {
      break;
    } else {
      var remainingChunk := maxSteps - steps;
      if remainingChunk == 0 {
        break;
      } else {
        var gChunk, stoppedOnOpenSpan, stoppedOnEos, usedChunk :=
          helpers.UnconstrainedChunk(lm, prompt, generated, remainingChunk, "<<", eosToken);
        if usedChunk == 0 {
          break;
        } else {
          generated := gChunk;
          steps := steps + usedChunk;
          if stoppedOnEos {
            break;
          } else {
            if stoppedOnOpenSpan {
              insideConstrainedOut := true;
              currentConstrainedOut := [];
              openedSeen := true;
            } else {
              break;
            }
          }
        }
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      if steps + 1 <= maxSteps {
        var gClose, inClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := gClose;
        insideConstrainedOut := inClose;
        currentConstrainedOut := cClose;
        steps := steps + 1;
        break;
      } else {
        break;
      }
    } else {
      var dead := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if dead {
        var stableDead := generated[..|generated| - |currentConstrainedOut|];
        var gRoll, cRoll := helpers.RollbackConstrainedSpan(parser, stableDead, generated, currentConstrainedOut);
        generated := gRoll;
        currentConstrainedOut := cRoll;
        insideConstrainedOut := true;
      } else {
        if steps + 1 <= maxSteps {
          var next := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
          if next == eosToken {
            break;
          } else {
            var gApp, inApp, cApp := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
            generated := gApp;
            insideConstrainedOut := inApp;
            currentConstrainedOut := cApp;
            steps := steps + 1;
          }
        } else {
          break;
        }
      }
    }
  }
}

cost := steps;

