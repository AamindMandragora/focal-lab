Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy successfully produced parser-valid SQL prefixes, but it
// still failed the benchmark because the final text often did not contain an
// extractable completed << ... >> answer span. The result preview "SELECT <id>"
// strongly suggests the evaluator was reading raw generated text rather than an
// internally tracked constrained state. So this revision optimizes first for
// extractability, then for SQL quality.
//
// Main changes:
//
// 1) We still force immediate opening of a constrained span when outside, but
//    now we also force a close as soon as the constrained SQL becomes complete.
//    This directly targets the "Contains << >>: no" and extraction failures.
//    A complete SQL query inside delimiters is more valuable than continuing to
//    elaborate and risking an unclosed span.
//
// 2) We remove the earlier heuristic that waited for FROM or long length before
//    closing. That heuristic likely left many examples with an open span at the
//    end of generation. For Spider evaluation, a short complete query inside
//    << >> is preferable to a longer unfinished one.
//
// 3) Inside the constrained span, we use ConstrainedSymbol repeatedly with a
//    small per-call budget, so the parser drives construction of the SQL query
//    token by token / symbol by symbol. This keeps syntax high while allowing
//    frequent checks for completion and immediate closure.
//
// 4) On dead ends, we roll back to a valid constrained prefix and continue, but
//    if the rolled-back prefix is already complete we close immediately. This
//    preserves extractability even in recovery situations.
//
// 5) After closing one constrained span, we stop generation. This aims to emit
//    exactly one extractable SQL answer rather than risking extra text that may
//    confuse answer extraction.
//
// In short, the strategy is now: open immediately, grow under parser control,
// close immediately once complete, and stop. This directly addresses the
// evaluation's missing-delimiter and extraction failures while retaining high
// syntax from parser-governed generation.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open-span branch, OpenConstrainedSpan yields an empty
//   constrained content, which is parser-valid because [] is valid by
//   precondition. In the constrained-growth branch, ConstrainedSymbol returns a
//   parser-valid constrained prefix, and we assign that to
//   currentConstrainedOut. In rollback, RollbackConstrainedSpan restores a
//   parser-valid constrained prefix. In close branches, insideConstrainedOut
//   becomes false, so the implication is vacuous.
//
// suffix: Outside a constrained span, the suffix invariant is vacuous. Opening
//   a span sets currentConstrainedOut to empty, so generated's suffix of length
//   0 equals it trivially. In the constrained-growth branch, we compute
//   stablePrefix by removing the old constrained suffix and then set generated
//   := stablePrefix + currentSym, so generated ends with currentSym exactly.
//   RollbackConstrainedSpan returns matching generated/current pairs, and close
//   makes the implication vacuous by leaving the constrained mode.
//
// progress: OpenConstrainedSpan appends exactly 1 token and we increment steps
//   by 1. Each ConstrainedSymbol call appends stepsUsed tokens to the generated
//   text via generated := stablePrefix + currentSym, and we increment steps by
//   the same stepsUsed. CloseConstrainedSpan appends exactly 1 token and we
//   increment steps by 1. Rollback only shrinks or preserves generated, so the
//   bound |generated| <= |generatedPrefix| + steps is preserved. Break branches
//   leave state unchanged.
//
// cost accounting: We use a local steps counter only. Every branch that calls a
//   cost-bumping helper also increases steps by the same returned or fixed
//   amount: +1 for OpenConstrainedSpan and CloseConstrainedSpan, +stepsUsed for
//   ConstrainedSymbol. Rollback and parser-query helpers do not change steps.
//   All cost-increasing branches check remaining budget first, so steps never
//   exceeds maxSteps, and we return cost := steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if steps + 1 <= maxSteps {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      break;
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      if steps + 1 <= maxSteps {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
        break;
      } else {
        break;
      }
    } else {
      var deadEnd := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if deadEnd {
        var stablePrefixDead := generated[..|generated| - |currentConstrainedOut|];
        var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
          parser, stablePrefixDead, generated, currentConstrainedOut
        );
        generated := rolledGenerated;
        currentConstrainedOut := rolledCurrent;
        insideConstrainedOut := true;

        var completeAfterRollback := parser.IsCompletePrefix(currentConstrainedOut);
        if completeAfterRollback {
          if steps + 1 <= maxSteps {
            var closedGenerated2, closedInside2, closedCurrent2 := helpers.CloseConstrainedSpan(
              lm, parser, generated, currentConstrainedOut
            );
            generated := closedGenerated2;
            insideConstrainedOut := closedInside2;
            currentConstrainedOut := closedCurrent2;
            steps := steps + 1;
            break;
          } else {
            break;
          }
        } else {
          var remainingAfterRollback := maxSteps - steps;
          if remainingAfterRollback == 0 || stepTokenBudget == 0 {
            break;
          } else {
            var stablePrefix2 := generated[..|generated| - |currentConstrainedOut|];
            var constrainedPrompt2 := prompt + stablePrefix2;
            var currentSym2, hitEos2, stepsUsed2 := helpers.ConstrainedSymbol(
              lm, parser, constrainedPrompt2, currentConstrainedOut, stepTokenBudget, eosToken
            );
            if hitEos2 || stepsUsed2 == 0 {
              break;
            } else {
              if steps + stepsUsed2 > maxSteps {
                break;
              } else {
                generated := stablePrefix2 + currentSym2;
                currentConstrainedOut := currentSym2;
                insideConstrainedOut := true;
                steps := steps + stepsUsed2;
              }
            }
          }
        }
      } else {
        var remaining := maxSteps - steps;
        if remaining == 0 || stepTokenBudget == 0 {
          break;
        } else {
          var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
          var constrainedPrompt := prompt + stablePrefix;
          var currentSym, hitEos, stepsUsedSym := helpers.ConstrainedSymbol(
            lm, parser, constrainedPrompt, currentConstrainedOut, stepTokenBudget, eosToken
          );
          if hitEos || stepsUsedSym == 0 {
            break;
          } else {
            if steps + stepsUsedSym > maxSteps {
              break;
            } else {
              generated := stablePrefix + currentSym;
              currentConstrainedOut := currentSym;
              insideConstrainedOut := true;
              steps := steps + stepsUsedSym;
            }
          }
        }
      }
    }
  }
}

cost := steps;

