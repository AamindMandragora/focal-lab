Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy opened a constrained span with a helper and then relied on
// helper-managed delimiters, but the evaluator reported that the final text often
// did not literally contain `<<` and `>>`. For Spider, the task is simpler and
// higher-value than the prior cautious policy: emit exactly one constrained SQL
// chunk, make sure the delimiters are present in `generated`, and keep generating
// inside that chunk until the SQL grammar reaches a complete prefix, then close
// immediately.
//
// The revised strategy therefore does three things differently:
// 1. It manually appends the literal `<<` token as the first generated token, so
//    the required opening delimiter is guaranteed to appear in the output text.
// 2. While inside the constrained span, it repeatedly uses `ConstrainedSymbol`
//    with a positive local budget to extend the SQL prefix under the parser. If a
//    dead end is detected, it rolls back to a valid constrained prefix and keeps
//    going instead of drifting outside the constrained region.
// 3. Once the constrained prefix is complete, it manually appends the literal
//    `>>` token and stops immediately, guaranteeing a single extractable
//    constrained answer chunk.
//
// This directly addresses the observed failures: the output now necessarily
// contains `<< >>`, uses parser-governed constrained generation for the SQL body,
// and avoids unconstrained text around the answer.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the manual-open branch we set currentConstrainedOut := []
//   and validity follows from the precondition parser.IsValidPrefix([]). In the
//   ConstrainedSymbol branch, the helper returns currentOut that is a valid parser
//   prefix, and we assign it to currentConstrainedOut. In the rollback branch,
//   RollbackConstrainedSpan restores a valid constrained prefix by construction.
//   In the manual-close branch, insideConstrainedOut becomes false, so the
//   implication is vacuous.
//
// suffix: After manual open, generated becomes old generated + ["<<"] while the
//   constrained content is empty, so generated ends with currentConstrainedOut
//   trivially. In the ConstrainedSymbol branch we compute stablePrefix by
//   removing the old constrained suffix and then set generated := stablePrefix +
//   currentOut, so generated ends with currentConstrainedOut exactly. Rollback
//   returns matching generated/current values. After manual close,
//   insideConstrainedOut is false, so the implication is vacuous.
//
// progress: Manual open appends exactly 1 token and increments steps by 1.
//   ConstrainedSymbol appends used tokens to the constrained suffix and we
//   increment steps by used. Rollback does not increase generated and does not
//   change steps. Manual close appends exactly 1 token and increments steps by 1.
//   Break branches leave both sides unchanged, so |generated| <= |generatedPrefix|
//   + steps is preserved.
//
// cost accounting: The returned cost is the local steps counter. Manual token
//   choices for `<<` and `>>` each increment steps by 1 after a single token is
//   appended. Each ConstrainedSymbol call contributes exactly used steps and we
//   add used to steps. Rollback and parser-query branches do not change steps.
//   Therefore cost := steps is sound and remains <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var openedHere: bool := false;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if openedHere {
      break;
    } else {
      if steps + 1 <= maxSteps {
        generated := generated + ["<<"];
        insideConstrainedOut := true;
        currentConstrainedOut := [];
        openedHere := true;
        steps := steps + 1;
      } else {
        break;
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      if steps + 1 <= maxSteps {
        generated := generated + [">>"];
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        steps := steps + 1;
        break;
      } else {
        break;
      }
    } else {
      var dead := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if dead {
        var stableDead := generated[..|generated| - |currentConstrainedOut|];
        var gRoll, cRoll := helpers.RollbackConstrainedSpan(parser, stableDead, generated, currentConstrainedOut);
        generated := gRoll;
        currentConstrainedOut := cRoll;
        insideConstrainedOut := true;
      } else {
        if stepTokenBudget == 0 {
          break;
        } else {
          var remaining := maxSteps - steps;
          var localBudget: nat;
          if stepTokenBudget <= remaining {
            localBudget := stepTokenBudget;
          } else {
            localBudget := remaining;
          }

          var stable := generated[..|generated| - |currentConstrainedOut|];
          var constrainedPrompt := prompt + stable;
          var currentNew, hitEos, used := helpers.ConstrainedSymbol(
            lm, parser, constrainedPrompt, currentConstrainedOut, localBudget, eosToken
          );
          if hitEos || used == 0 {
            break;
          } else {
            if steps + used <= maxSteps {
              generated := stable + currentNew;
              currentConstrainedOut := currentNew;
              insideConstrainedOut := true;
              steps := steps + used;
            } else {
              break;
            }
          }
        }
      }
    }
  }
}

cost := steps;

