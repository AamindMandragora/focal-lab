Strategy: // CSD_RATIONALE_BEGIN
// The evaluation failures indicate that merely appending literal `<<` / `>>` into
// `generated` is not enough: the harness specifically wants an internal
// parser-governed chunk, and the previous version was flagged for
// `missing_constrained_chunk`. The likely cause is that the strategy never used
// the span-opening/closing helpers that the evaluator recognizes as constrained
// chunk boundaries.
//
// The revised strategy therefore switches to a single-span, helper-recognizable
// policy:
// 1. If we are not already inside a constrained span, immediately call
//    `helpers.OpenConstrainedSpan` exactly once. This creates a real constrained
//    chunk in the generated text and aligns the internal state with the emitted
//    delimiters.
// 2. Once inside, generate only parser-valid SQL content. We use
//    `helpers.ConstrainedSymbol` to advance by grammar symbols under a bounded
//    local budget, and then splice the returned constrained prefix back onto the
//    stable unconstrained prefix. This keeps the generated suffix equal to the
//    tracked constrained content.
// 3. As soon as the constrained prefix is complete, close the span with
//    `helpers.CloseConstrainedSpan` and stop immediately. We never close merely
//    because a sampled token resembles `>>`; closure happens only from a branch
//    where `parser.IsCompletePrefix(currentConstrainedOut)` is known.
// 4. If dead-end detection fires, we roll back the constrained suffix to a valid
//    parser prefix and continue. Rollback is pure state repair: it does not spend
//    steps and does not leave the constrained region.
//
// This directly addresses the reported failures: the output contains a helper-
// managed `<< ... >>` chunk, extraction can find that chunk, and the SQL body is
// generated under parser control rather than as plain unconstrained text.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open-span branch, `OpenConstrainedSpan` returns an empty
//   constrained prefix with `insideConstrainedOut == true`, and `[]` is valid by
//   precondition. In the constrained-generation branch, `ConstrainedSymbol`
//   returns `currentOut` that is still a valid parser prefix, and assigning
//   `currentConstrainedOut := currentOut` preserves the invariant. In the rollback
//   branch, `RollbackConstrainedSpan` restores a valid constrained prefix by
//   construction. In the close branch, `insideConstrainedOut` becomes false, so
//   the implication is vacuous.
//
// suffix: Opening a span adds delimiters but leaves the constrained content empty,
//   so the generated suffix corresponding to `currentConstrainedOut == []` matches
//   trivially. In the constrained-generation branch, we compute `stable` by
//   removing the old constrained suffix and then set `generated := stable +
//   currentNew`, so the new generated text ends exactly with `currentNew`. The
//   rollback helper returns a matching pair `(generated, current)` with the same
//   suffix relationship. After closing, `insideConstrainedOut` is false, so the
//   implication is vacuous.
//
// progress: `OpenConstrainedSpan` appends exactly 1 token and we increment
//   `steps` by 1. `ConstrainedSymbol` appends `used` constrained tokens and we
//   increment `steps` by `used`; replacing the old constrained suffix by the new
//   one keeps the total length increase bounded by `used`. `CloseConstrainedSpan`
//   appends exactly 1 token and we increment `steps` by 1. Rollback and break
//   branches do not increase `generated` or `steps`, so `|generated| <=
//   |generatedPrefix| + steps` is preserved.
//
// cost accounting: The returned `cost` is the local `steps` counter. We add 1 for
//   each helper-managed open/close action and add `used` after each successful
//   `ConstrainedSymbol` call. Query and rollback branches do not change `steps`.
//   Since every increment is guarded by `steps + delta <= maxSteps`, we maintain
//   `steps <= maxSteps`, hence `cost := steps` satisfies `cost <= maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var openedHere: bool := false;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if openedHere {
      break;
    } else {
      if steps + 1 <= maxSteps {
        var gOpen, inOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
        generated := gOpen;
        insideConstrainedOut := inOpen;
        currentConstrainedOut := cOpen;
        openedHere := true;
        steps := steps + 1;
      } else {
        break;
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      if steps + 1 <= maxSteps {
        var gClose, inClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := gClose;
        insideConstrainedOut := inClose;
        currentConstrainedOut := cClose;
        steps := steps + 1;
        break;
      } else {
        break;
      }
    } else {
      var dead := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if dead {
        var stableDead := generated[..|generated| - |currentConstrainedOut|];
        var gRoll, cRoll := helpers.RollbackConstrainedSpan(parser, stableDead, generated, currentConstrainedOut);
        generated := gRoll;
        currentConstrainedOut := cRoll;
        insideConstrainedOut := true;
      } else {
        if stepTokenBudget == 0 {
          break;
        } else {
          var remaining := maxSteps - steps;
          var localBudget: nat;
          if stepTokenBudget <= remaining {
            localBudget := stepTokenBudget;
          } else {
            localBudget := remaining;
          }

          var stable := generated[..|generated| - |currentConstrainedOut|];
          var constrainedPrompt := prompt + stable;
          var currentNew, hitEos, used := helpers.ConstrainedSymbol(
            lm, parser, constrainedPrompt, currentConstrainedOut, localBudget, eosToken
          );
          if hitEos || used == 0 {
            break;
          } else {
            if steps + used <= maxSteps {
              generated := stable + currentNew;
              currentConstrainedOut := currentNew;
              insideConstrainedOut := true;
              steps := steps + used;
            } else {
              break;
            }
          }
        }
      }
    }
  }
}

