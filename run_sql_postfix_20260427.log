Strategy: // CSD_RATIONALE_BEGIN
// The last strategy failed for a more basic reason than SQL quality: many
// outputs never contained a completed << ... >> span at all. The evaluation
// specifically reports missing delimiters and extraction failure, so the new
// strategy prioritizes reliably producing exactly one constrained SQL span
// quickly, then spending almost all remaining budget inside that span.
//
// Key changes:
//
// 1) If generation starts outside a constrained span, we do not wait for the
//    model to naturally emit "<<". Instead we force immediate entry into a
//    constrained span with OpenConstrainedSpan. This directly targets the
//    "Contains << >>: no" failure.
//
// 2) Once inside the span, we grow the SQL almost entirely with
//    ConstrainedSymbol, so the parser governs the query structure and schema
//    choices. This addresses the observed malformed/underspecified outputs like
//    "SELECT <id>" by insisting on parser-directed expansion rather than loose
//    unconstrained continuation.
//
// 3) We use a stronger close policy tailored to Spider SQL: only close when the
//    constrained prefix is complete and shows evidence of a real query body.
//    In particular, we prefer to close only after seeing FROM, or after the
//    query has become fairly long. This avoids prematurely closing trivial
//    complete prefixes such as bare SELECT expressions.
//
// 4) If the parser reaches a dead end, we roll back to a valid constrained
//    prefix and continue expanding rather than abandoning the span. This keeps
//    the final answer extractable and parser-valid.
//
// 5) EOS is terminal everywhere. We never continue after EOS, and we reserve
//    the final step to close the span once the SQL is complete enough.
//
// Overall, this revision changes the objective from "follow the model outside,
// then maybe constrain" to "guarantee one parser-governed SQL chunk with
// delimiters, then close it only after it looks like a substantive query".
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open-span branch, OpenConstrainedSpan sets
//   currentConstrainedOut to the empty constrained content, which is valid by
//   the method precondition on []. In ConstrainedSymbol branches, we assign the
//   returned current symbol prefix, which is parser-valid by helper contract;
//   rollback branches use RollbackConstrainedSpan to restore a valid prefix.
//   Close branches set insideConstrainedOut to false, making the implication
//   vacuous.
//
// suffix: Before opening or after closing, the invariant is vacuous. Opening a
//   span makes currentConstrainedOut empty, so the suffix equality holds
//   trivially. In every ConstrainedSymbol branch we compute stablePrefix by
//   removing the old constrained suffix and then set generated := stablePrefix
//   + currentSym, so the last |currentSym| tokens are exactly currentSym;
//   rollback restores a matching generated/current pair by helper contract.
//
// progress: OpenConstrainedSpan appends exactly one token and we increment
//   steps by 1. Each ConstrainedSymbol branch appends at most stepsUsed tokens
//   while we increment steps by stepsUsed, so |generated| remains bounded by
//   |generatedPrefix| + steps. Rollback can only shrink generated, and close
//   appends exactly one token with steps increased by 1. Break branches do not
//   change state, so the bound is preserved.
//
// cost accounting: We maintain a local steps counter and return cost := steps.
//   We add 1 for OpenConstrainedSpan and CloseConstrainedSpan, and add the
//   returned stepsUsed for each ConstrainedSymbol call. Rollback and query
//   helpers do not change steps. Every cost-increasing branch checks remaining
//   budget first, so steps never exceeds maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if steps < maxSteps {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      break;
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    var fromTail := helpers.ExtractAfterKeyword(currentConstrainedOut, "FROM");
    var canCloseNow := completeNow && (|fromTail| > 0 || |currentConstrainedOut| >= 20);

    if canCloseNow && steps + 1 <= maxSteps {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else {
      var deadEnd := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if deadEnd {
        var stablePrefixDead := generated[..|generated| - |currentConstrainedOut|];
        var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
          parser, stablePrefixDead, generated, currentConstrainedOut
        );
        generated := rolledGenerated;
        currentConstrainedOut := rolledCurrent;
        insideConstrainedOut := true;

        var completeAfterRollback := parser.IsCompletePrefix(currentConstrainedOut);
        var fromTailAfterRollback := helpers.ExtractAfterKeyword(currentConstrainedOut, "FROM");
        var canCloseAfterRollback := completeAfterRollback && (|fromTailAfterRollback| > 0 || |currentConstrainedOut| >= 20);

        if canCloseAfterRollback && steps + 1 <= maxSteps {
          var closedGenerated2, closedInside2, closedCurrent2 := helpers.CloseConstrainedSpan(
            lm, parser, generated, currentConstrainedOut
          );
          generated := closedGenerated2;
          insideConstrainedOut := closedInside2;
          currentConstrainedOut := closedCurrent2;
          steps := steps + 1;
          break;
        } else {
          var remainingAfterRollback: nat := maxSteps - steps;
          if remainingAfterRollback == 0 || stepTokenBudget == 0 {
            break;
          } else {
            var stablePrefix2 := generated[..|generated| - |currentConstrainedOut|];
            var constrainedPrompt2 := prompt + stablePrefix2;
            var currentSym2, hitEos2, stepsUsed2 := helpers.ConstrainedSymbol(
              lm, parser, constrainedPrompt2, currentConstrainedOut, stepTokenBudget, eosToken
            );
            if hitEos2 || stepsUsed2 == 0 {
              break;
            } else {
              if steps + stepsUsed2 > maxSteps {
                break;
              } else {
                generated := stablePrefix2 + currentSym2;
                currentConstrainedOut := currentSym2;
                insideConstrainedOut := true;
                steps := steps + stepsUsed2;
              }
            }
          }
        }
      } else {
        var remaining: nat := maxSteps - steps;
        if remaining == 0 || stepTokenBudget == 0 {
          break;
        } else {
          var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
          var constrainedPrompt := prompt + stablePrefix;
          var currentSym, hitEos, stepsUsedSym := helpers.ConstrainedSymbol(
            lm, parser, constrainedPrompt, currentConstrainedOut, stepTokenBudget, eosToken
          );
          if hitEos || stepsUsedSym == 0 {
            break;
          } else {
            if steps + stepsUsedSym > maxSteps {
              break;
            } else {
              generated := stablePrefix + currentSym;
              currentConstrainedOut := currentSym;
              insideConstrainedOut := true;
              steps := steps + stepsUsedSym;
            }
          }
        }
      }
    }
  }
}

cost := steps;

