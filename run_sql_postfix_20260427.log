Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy over-used ConstrainedSymbol in wide SQL states. On
// Spider, that often produced very short but semantically incomplete outputs
// like "SELECT <id>" inside the constrained span: syntactically valid prefixes,
// but not complete schema-grounded queries before the step budget ended.
//
// This revision switches to a completion-first policy tailored to text-to-SQL.
// Outside the span, it still cheaply chunks until "<<". Inside the span, it
// never uses ConstrainedSymbol. Instead it performs token-level constrained
// decoding throughout, with two schema-aware biases:
//
// 1) If the current SQL prefix is already complete, close immediately with ">>".
// 2) Otherwise, if the parser is at a dead end or extremely narrow, bias toward
//    high-logit valid continuations from the parser; if it is broader, still use
//    ConstrainedStep token-by-token so the parser can force full query growth.
//
// The key change is eliminating multi-token symbol replacement and insisting on
// incremental parser-validated growth until a complete SQL query is reached.
// This directly targets the observed incomplete-query failures while preserving
// the required << >> wrapping and grammar validity.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained-chunk branch, either we stay outside
//   the constrained span, or we stop on "<<" and set currentConstrainedOut := [],
//   which is a valid parser prefix by precondition. In the close branch,
//   insideConstrainedOut becomes false, so the implication is vacuous. In every
//   constrained token branch, the chosen next token comes from ConstrainedStep,
//   which respects the parser, and AppendConstrainedToken extends the current
//   constrained prefix with that valid token, preserving parser validity. Dead-
//   end rollback uses RollbackConstrainedSpan, which returns a valid prefix.
// suffix: Outside the span the implication is vacuous; when opening on "<<",
//   currentConstrainedOut is set to [], which is exactly the length-0 suffix.
//   Closing the span makes insideConstrainedOut false, so the implication is
//   vacuous. Appending a constrained token extends both generated and
//   currentConstrainedOut by the same token, preserving the suffix equality.
//   RollbackConstrainedSpan explicitly restores generated/currentConstrainedOut
//   so that the constrained content is again the suffix.
// progress: UnconstrainedChunk appends stepsUsed tokens and we add exactly
//   stepsUsed to steps. CloseConstrainedSpan appends one token and we increment
//   steps by 1. Each constrained token step appends exactly one token and we
//   increment steps by 1. Rollback branches break immediately after a pure state
//   repair, so no further arithmetic is needed. Thus |generated| never exceeds
//   |generatedPrefix| + steps.
// cost accounting: The returned cost is steps. UnconstrainedChunk contributes
//   stepsUsed, CloseConstrainedSpan contributes 1, and each ConstrainedStep
//   branch contributes 1; pure helper queries and rollback helpers do not affect
//   steps. Therefore assigning cost := steps at the end yields cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowCount: nat := 4;
var topK: nat := 6;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else {
      if stoppedOnOpenSpan {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var deadEnd := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if deadEnd {
        var stablePrefixDead := generated[..|generated| - |currentConstrainedOut|];
        var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
          parser, stablePrefixDead, generated, currentConstrainedOut
        );
        generated := rolledGenerated;
        currentConstrainedOut := rolledCurrent;
        var completeAfterRollback := parser.IsCompletePrefix(currentConstrainedOut);
        if completeAfterRollback {
          if steps < maxSteps {
            var closedGenerated2, closedInside2, closedCurrent2 := helpers.CloseConstrainedSpan(
              lm, parser, generated, currentConstrainedOut
            );
            generated := closedGenerated2;
            insideConstrainedOut := closedInside2;
            currentConstrainedOut := closedCurrent2;
            steps := steps + 1;
          }
        } else {
          break;
        }
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt := prompt + stablePrefix;
        var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);

        if validCount <= narrowCount {
          var nextTight := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if nextTight == eosToken {
            break;
          } else {
            var appendedGenerated1, appendedInside1, appendedCurrent1 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, nextTight
            );
            generated := appendedGenerated1;
            insideConstrainedOut := appendedInside1;
            currentConstrainedOut := appendedCurrent1;
          }
        } else {
          var candidates := helpers.TopValidCandidates(lm, parser, constrainedPrompt, currentConstrainedOut, topK, eosToken);
          lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
          helpers.BoostTokenLogits(lm, candidates, 8.0);
          var nextBroad := lm.ChooseNextToken();
          helpers.cost := helpers.cost + 1;
          steps := steps + 1;
          if nextBroad == eosToken {
            break;
          } else {
            var validBroad := helpers.IsTokenValidNext(parser, currentConstrainedOut, nextBroad);
            if validBroad {
              var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
                lm, parser, generated, currentConstrainedOut, nextBroad
              );
              generated := appendedGenerated2;
              insideConstrainedOut := appendedInside2;
              currentConstrainedOut := appendedCurrent2;
            } else {
              var nextFallback := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
              if nextFallback == eosToken {
                break;
              } else {
                var appendedGenerated3, appendedInside3, appendedCurrent3 := helpers.AppendConstrainedToken(
                  lm, parser, generated, currentConstrainedOut, nextFallback
                );
                generated := appendedGenerated3;
                insideConstrainedOut := appendedInside3;
                currentConstrainedOut := appendedCurrent3;
              }
            }
          }
        }
      }
    }
  }
}

cost := steps;

