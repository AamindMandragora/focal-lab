Strategy: // CSD_RATIONALE_BEGIN
// The evaluation shows a very specific failure pattern: syntax is perfect and
// delimiters are present, but most outputs collapse to extremely short complete
// SQL such as just "SELECT". That means the prior strategy over-trusted
// parser-level completeness. In Spider, many grammars admit very short complete
// prefixes, but those are rarely semantically correct answers.
//
// This revision changes the policy from "close as soon as complete" to
// "prefer to continue while the constrained prefix still looks underspecified".
// The strategy is:
//
// 1) Outside a constrained span, use one UnconstrainedChunk to reach the next
//    "<<", preserving the model's natural preamble behavior.
// 2) Inside the span, grow by parser symbols using ConstrainedSymbol, which is
//    much better than raw token sampling for schema-grounded SQL.
// 3) Do NOT immediately close on the first complete prefix. Instead, require
//    both completeness and a minimal content signal before closing:
//      - the constrained prefix must contain "FROM", or
//      - it must be at least moderately long.
//    This directly targets the observed degenerate outputs like "SELECT".
// 4) If complete-but-too-short, keep expanding with ConstrainedSymbol so the
//    model has a chance to add table references, predicates, grouping, etc.
// 5) If the parser reports a dead end, roll back to a valid constrained prefix;
//    after rollback, close only if the repaired prefix satisfies the stronger
//    close criterion, otherwise continue expanding.
// 6) EOS remains terminal, and if ConstrainedSymbol makes no progress we stop.
//
// The key behavioral change is the stronger close criterion. This sacrifices a
// bit of eagerness in exchange for much better semantic depth, which is exactly
// what the evaluation failure indicates is missing.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained-chunk branch we are either still
//   outside the span or we enter a fresh constrained span with
//   currentConstrainedOut := [], which is valid by the method precondition on
//   the empty prefix. In every ConstrainedSymbol branch we assign the returned
//   currentSym/currentSym2 to currentConstrainedOut; that helper returns a
//   parser-valid prefix. In rollback branches, RollbackConstrainedSpan restores
//   a valid constrained prefix. In close branches, insideConstrainedOut becomes
//   false, so the implication is vacuous.
// suffix: Outside the span the invariant is vacuous; after opening, the active
//   constrained suffix is empty, so it holds trivially. In every symbol-growth
//   branch we compute stablePrefix as generated without the old constrained
//   suffix and then set generated := stablePrefix + currentSym, so the final
//   suffix of length |currentSym| is exactly currentSym. Rollback restores a
//   matching generated/current pair by contract. Closing makes the implication
//   vacuous.
// progress: UnconstrainedChunk appends exactly stepsUsed tokens and we increase
//   steps by stepsUsed. Each ConstrainedSymbol branch appends
//   |currentSym| - |oldCurrent| tokens to generated while increasing steps by
//   stepsUsed; one LM step can add at most one token, so the append length is
//   at most stepsUsed, preserving |generated| <= |generatedPrefix| + steps.
//   CloseConstrainedSpan appends exactly one token and we increment steps by 1.
//   Rollback can only shrink generated, which also preserves the bound. Break
//   branches preserve all invariants immediately.
// cost accounting: We maintain a local steps counter and return cost := steps.
//   UnconstrainedChunk contributes its returned stepsUsed, each
//   ConstrainedSymbol contributes its returned stepsUsed, and each
//   CloseConstrainedSpan contributes 1. Query helpers and rollback helpers do
//   not change steps. Guards prevent any update with steps + delta > maxSteps,
//   so cost <= maxSteps at return.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else {
      if stoppedOnOpenSpan {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        break;
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    var hasFromNow := helpers.ExtractAfterKeyword(currentConstrainedOut, "FROM");
    var canCloseNow := completeNow && (|hasFromNow| > 0 || |currentConstrainedOut| >= 12);

    if canCloseNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var deadEnd := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if deadEnd {
        var stablePrefixDead := generated[..|generated| - |currentConstrainedOut|];
        var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
          parser, stablePrefixDead, generated, currentConstrainedOut
        );
        generated := rolledGenerated;
        currentConstrainedOut := rolledCurrent;
        insideConstrainedOut := true;

        var completeAfterRollback := parser.IsCompletePrefix(currentConstrainedOut);
        var hasFromAfterRollback := helpers.ExtractAfterKeyword(currentConstrainedOut, "FROM");
        var canCloseAfterRollback := completeAfterRollback && (|hasFromAfterRollback| > 0 || |currentConstrainedOut| >= 12);

        if canCloseAfterRollback {
          if steps < maxSteps {
            var closedGenerated2, closedInside2, closedCurrent2 := helpers.CloseConstrainedSpan(
              lm, parser, generated, currentConstrainedOut
            );
            generated := closedGenerated2;
            insideConstrainedOut := closedInside2;
            currentConstrainedOut := closedCurrent2;
            steps := steps + 1;
          } else {
            break;
          }
        } else {
          var remainingAfterRollback: nat := maxSteps - steps;
          if remainingAfterRollback == 0 || stepTokenBudget == 0 {
            break;
          } else {
            var stablePrefix2 := generated[..|generated| - |currentConstrainedOut|];
            var constrainedPrompt2 := prompt + stablePrefix2;
            var oldLen2: nat := |currentConstrainedOut|;
            var currentSym2, hitEos2, stepsUsed2 := helpers.ConstrainedSymbol(
              lm, parser, constrainedPrompt2, currentConstrainedOut, stepTokenBudget, eosToken
            );
            if hitEos2 || stepsUsed2 == 0 {
              break;
            } else {
              if steps + stepsUsed2 > maxSteps {
                break;
              } else {
                generated := stablePrefix2 + currentSym2;
                currentConstrainedOut := currentSym2;
                insideConstrainedOut := true;
                steps := steps + stepsUsed2;
                if |currentConstrainedOut| < oldLen2 {
                  break;
                }
              }
            }
          }
        }
      } else {
        var remaining: nat := maxSteps - steps;
        if remaining == 0 || stepTokenBudget == 0 {
          break;
        } else {
          var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
          var constrainedPrompt := prompt + stablePrefix;
          var oldLen: nat := |currentConstrainedOut|;
          var currentSym, hitEos, stepsUsedSym := helpers.ConstrainedSymbol(
            lm, parser, constrainedPrompt, currentConstrainedOut, stepTokenBudget, eosToken
          );
          if hitEos || stepsUsedSym == 0 {
            break;
          } else {
            if steps + stepsUsedSym > maxSteps {
              break;
            } else {
              generated := stablePrefix + currentSym;
              currentConstrainedOut := currentSym;
              insideConstrainedOut := true;
              steps := steps + stepsUsedSym;
              if |currentConstrainedOut| < oldLen {
                break;
              }
            }
          }
        }
      }
    }
  }
}

