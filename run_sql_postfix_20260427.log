Attempt 1/20
============================================================
Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL usually has a long unconstrained preamble (schema/question
// text already in the prompt) followed by one SQL query that should be fully
// grammar-valid under the schema-aware parser. This strategy therefore tracks
// only the standard constrained-span state: whether we are inside the SQL span
// and the current constrained SQL prefix itself.
//
// Outside the span, it generates in chunks until either EOS or the opening
// delimiter "<<" appears, which amortizes cost over the free-form region.
// Inside the span, it adapts to parser narrowness: when only a few next tokens
// are valid, it uses tight token-level constrained decoding; when many tokens
// are valid, it uses ConstrainedSymbol so multi-token SQL units such as
// identifiers or keywords can be emitted in one step. As soon as the parser
// reports a complete SQL prefix, it closes the span immediately.
//
// The tracked constrained prefix is exactly the suffix of generated inside the
// delimiters, so every constrained action is justified against the parser's
// current schema-narrowed SQL state, supporting valid query generation.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained-chunk branch, insideConstrainedOut
//   stays false unless the chunk stops on "<<"; in that case we set
//   currentConstrainedOut := [], which is a valid prefix by precondition.
//   In the close branch, CloseConstrainedSpan sets insideConstrainedOut to
//   false, so the implication is vacuous. In the tight constrained branch,
//   ConstrainedStep returns either EOS (break) or a parser-valid next token;
//   AppendConstrainedToken therefore preserves parser.IsValidPrefix. In the
//   loose constrained branch, ConstrainedSymbol returns symbolOut that is a
//   valid parser prefix, and we assign currentConstrainedOut := symbolOut.
// suffix: In the unconstrained-chunk branch, when we remain outside the span
//   the implication is vacuous; when we enter on "<<", we set
//   currentConstrainedOut := [], and the length-0 suffix of generated is [].
//   In the close branch, CloseConstrainedSpan appends the closing delimiter and
//   resets currentConstrainedOut to [], making the suffix condition vacuous.
//   In the tight branch, AppendConstrainedToken appends the same token to both
//   generated and currentConstrainedOut. In the loose branch, with
//   stablePrefix := generated[..|generated|-|currentConstrainedOut|], we set
//   generated := stablePrefix + symbolOut and currentConstrainedOut := symbolOut,
//   so the final suffix of generated is exactly currentConstrainedOut.
// progress: UnconstrainedChunk appends at most stepsUsed tokens and we update
//   steps := steps + stepsUsed, so |generated| stays within
//   |generatedPrefix| + steps. CloseConstrainedSpan appends exactly one token
//   and steps increases by 1. Tight constrained decoding appends exactly one
//   token via AppendConstrainedToken and increments steps by 1. Loose decoding
//   replaces the old constrained suffix by the longer symbolOut; the net growth
//   is bounded by stepsUsed, and we increment steps by that same stepsUsed.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var narrowThreshold: nat := 12;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpenSpan {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      if validCount <= narrowThreshold {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var symbolBudget: nat := maxSteps - steps;
        var symbolOut, hitEos, symbolStepsUsed := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, symbolBudget, eosToken
        );
        generated := stablePrefix + symbolOut;
        insideConstrainedOut := true;
        currentConstrainedOut := symbolOut;
        steps := steps + symbolStepsUsed;
        if hitEos {
          break;
        }
      }
    }
  }
}

cost := steps;

