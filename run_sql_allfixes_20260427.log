Strategy: // CSD_RATIONALE_BEGIN
// The prior strategy forced every answer to begin a constrained span immediately,
// so the model effectively emitted only the SQL interior and often stopped after
// a tiny complete prefix such as "SELECT <id>". On Spider, the task expects a
// single SQL query as the full output, but the evaluator also requires that the
// output contain << >> delimiters somewhere. The fix is therefore structural:
//
// 1. First emit a short unconstrained preamble chunk so the model can produce the
//    required opening delimiter token naturally instead of us hard-forcing the
//    answer to start with a constrained span.
// 2. Once inside a constrained span, aggressively continue generation while the
//    SQL prefix is incomplete, using ConstrainedSymbol when there is budget and
//    only considering closing after the parser reports completeness.
// 3. When the constrained SQL becomes complete, close the span immediately so the
//    model can emit the trailing delimiter and any remaining unconstrained text.
// 4. Outside a span after at least one open, continue unconstrained chunking until
//    EOS or budget exhaustion; if no span has been opened yet, keep chunking until
//    one opens.
//
// This directly targets the observed failure "SELECT <id>" by no longer treating
// the earliest complete SQL prefix as the whole answer and by separating the
// delimiter-production problem from the SQL-body-production problem.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In unconstrained-chunk branches we are outside a span, so the
//   implication is vacuous. OpenConstrainedSpan sets currentConstrainedOut := [],
//   which is a valid prefix. In the incomplete constrained branch,
//   AppendConstrainedToken preserves validity for a non-EOS token, while a hitEos
//   break leaves state unchanged. In the ConstrainedSymbol branch the helper
//   returns currentOut that is itself a valid parser prefix. In the close branch
//   we exit the span, so the implication is again vacuous.
// suffix: Outside-span branches are vacuous. After opening, currentConstrainedOut
//   is empty, so generated's suffix of length 0 equals it. AppendConstrainedToken
//   appends the same token to generated and currentConstrainedOut, preserving the
//   suffix equality. In the ConstrainedSymbol branch, with
//   stablePrefix = generated[..|generated|-|oldCurrent|], assigning
//   generated := stablePrefix + symbolOut and currentConstrainedOut := symbolOut
//   makes the final suffix equal to currentConstrainedOut by construction. After
//   closing we are outside a span, so the implication is vacuous.
// cost accounting: steps starts at 0 and is increased only by helper-reported
//   token counts: +stepsUsed for UnconstrainedChunk, +1 for OpenConstrainedSpan,
//   +1 for CloseConstrainedSpan, and +stepsUsed for ConstrainedSymbol. Breaks do
//   not add extra cost beyond the helper call already accounted for. Therefore
//   cost := steps is sound and steps never exceeds maxSteps because every helper
//   is called with the remaining budget.
// progress: UnconstrainedChunk appends exactly stepsUsed tokens and we increment
//   steps by stepsUsed. OpenConstrainedSpan and CloseConstrainedSpan append exactly
//   1 token and we increment steps by 1. AppendConstrainedToken is paired with the
//   ConstrainedSymbol-free token branch only when one token has been consumed by a
//   cost-bumping helper; generated grows by 1 and steps has already grown by 1.
//   In the ConstrainedSymbol branch, replacing the old constrained suffix by
//   symbolOut changes total length by |symbolOut| - |oldCurrent|, which is bounded
//   by stepsUsed, and we increment steps by stepsUsed. Break branches preserve the
//   inequality immediately.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var sawOpen: bool := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var rem0: nat := maxSteps - steps;
    if rem0 == 0 {
      break;
    } else {
      var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
        lm, prompt, generated, rem0, "<<", eosToken
      );
      generated := chunkGenerated;
      steps := steps + stepsUsed;

      if stoppedOnEos {
        break;
      } else {
        if stoppedOnOpenSpan {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          sawOpen := true;
        } else {
          if sawOpen {
            break;
          }
        }
      }
    }
  } else {
    var rem1: nat := maxSteps - steps;
    if rem1 == 0 {
      break;
    } else {
      var complete := parser.IsCompletePrefix(currentConstrainedOut);
      if complete {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt := prompt + stablePrefix;
        if rem1 == 1 {
          var symbolOut1, hitEos1, stepsUsed1 := helpers.ConstrainedSymbol(
            lm, parser, constrainedPrompt, currentConstrainedOut, rem1, eosToken
          );
          generated := stablePrefix + symbolOut1;
          insideConstrainedOut := true;
          currentConstrainedOut := symbolOut1;
          steps := steps + stepsUsed1;
          if hitEos1 {
            break;
          }
        } else {
          var symbolOut, hitEos, stepsUsed2 := helpers.ConstrainedSymbol(
            lm, parser, constrainedPrompt, currentConstrainedOut, rem1, eosToken
          );
          generated := stablePrefix + symbolOut;
          insideConstrainedOut := true;
          currentConstrainedOut := symbolOut;
          steps := steps + stepsUsed2;
          if hitEos {
            break;
          }
        }
      }
    }
  }
}

cost := steps;

