Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL usually has a long unconstrained preamble (schema/question
// narration or delimiter search) followed by one constrained SQL span whose
// grammar is narrowed to the current schema. This strategy tracks only the
// standard span state: whether we are inside the SQL span and the current SQL
// prefix being validated by the parser.
//
// Outside the span, it uses chunked unconstrained decoding so the model can
// quickly reach the SQL region or EOS. Inside the span, it adapts to parser
// narrowness: when few next tokens are valid, it uses token-level
// ConstrainedStep; when many continuations are valid, it uses ConstrainedSymbol
// so multi-token SQL units such as identifiers, aliases, or expressions can be
// emitted in one step. As soon as the parser reports a complete SQL query, the
// strategy closes the span immediately.
//
// The tracked constrained prefix is exactly the SQL text between delimiters, so
// parser validity directly certifies schema-consistent SQL generation, while
// the suffix relation keeps generated text and parser state synchronized.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, insideConstrainedOut
//   stays false unless the chunk stops on "<<"; in that case we set
//   currentConstrainedOut := [], which is a valid prefix by precondition.
//   In the complete-prefix branch, CloseConstrainedSpan sets
//   insideConstrainedOut := false, so the implication is vacuous. In the tight
//   constrained branch, ConstrainedStep returns either eosToken (break) or a
//   parser-valid next token, and AppendConstrainedToken preserves validity. In
//   the loose constrained branch, ConstrainedSymbol returns currentOut that is
//   itself a valid parser prefix.
// suffix: In the unconstrained chunk branch, when we remain outside the span
//   the implication is vacuous; when we enter on "<<", we set
//   currentConstrainedOut := [], and the length-0 suffix of generated is [].
//   In the complete-prefix branch, CloseConstrainedSpan appends the closing
//   delimiter and resets currentConstrainedOut to [], so the implication is
//   vacuous. In the tight branch, AppendConstrainedToken appends the same token
//   to generated and currentConstrainedOut. In the loose branch, with
//   stablePrefix := generated[..|generated| - |currentConstrainedOut|], we set
//   generated := stablePrefix + symbolOut and currentConstrainedOut := symbolOut,
//   so the suffix of generated of length |currentConstrainedOut| is exactly
//   currentConstrainedOut.
// progress: UnconstrainedChunk appends at most stepsUsed tokens and we do
//   steps := steps + stepsUsed, so |generated| <= |generatedPrefix| + steps is
//   preserved linearly. CloseConstrainedSpan appends one token and steps grows
//   by 1. Tight constrained decoding appends one token via
//   AppendConstrainedToken and increments steps by 1. Loose constrained
//   decoding replaces the old constrained suffix by a longer valid prefix
//   symbolOut; the net growth is |symbolOut| - |oldCurrent|, which is bounded
//   by stepsUsed, and we increment steps by stepsUsed. Break branches do not
//   modify state, so all invariants remain true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var narrowThreshold: nat := 12;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpenSpan {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= narrowThreshold {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var symbolBudget: nat := maxSteps - steps;
        var symbolOut, hitEos, stepsUsed2 := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, symbolBudget, eosToken
        );
        generated := stablePrefix + symbolOut;
        insideConstrainedOut := true;
        currentConstrainedOut := symbolOut;
        steps := steps + stepsUsed2;
        if hitEos {
          break;
        }
      }
    }
  }
}

cost := steps;

