Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy over-used semantic heuristics and ConstrainedSymbol in
// wide SQL regions. On Spider this led to many prefixes that were grammatically
// valid but semantically under-specified or prematurely truncated, e.g. ending
// near "ORDER". The evaluation showed syntax was already perfect, so the main
// problem was token choice quality inside the constrained SQL span rather than
// delimiter handling.
//
// This revision simplifies the constrained policy and makes it more decisive:
// once inside the SQL span, it always decodes one grammar-valid token at a time
// with ConstrainedStep. Before each constrained step it biases logits toward a
// small set of parser-valid candidates, with stronger bias for SQL clause
// keywords that typically complete Spider queries ("SELECT", "FROM", "WHERE",
// "GROUP", "BY", "ORDER", "LIMIT", "JOIN", "ON", aggregation tokens, etc.).
// It also mildly penalizes eosToken while the SQL prefix is incomplete so the
// decoder is less likely to stop at prefixes like "... ORDER". When the parser
// says the SQL prefix is complete, the strategy immediately closes the span,
// ensuring the final output still contains << >> and terminates cleanly.
//
// Outside the constrained span, the strategy remains chunked for efficiency:
// UnconstrainedChunk quickly advances until "<<", then constrained decoding
// takes over. The key change is therefore replacing the previous mixed
// token/symbol semantic-context policy with a clause-aware, always-tokenwise
// constrained decoder that better matches Spider's need for complete SQL
// clauses.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, if we remain outside the
//   span the implication is vacuous; if we stop on "<<", we enter constrained
//   mode with currentConstrainedOut := [], which is valid by precondition. In
//   the complete-prefix branch, CloseConstrainedSpan makes insideConstrainedOut
//   false, so the implication is vacuous. In the constrained-step branch,
//   ConstrainedStep is called with a valid prefix; if it returns eosToken we
//   break without changing the constrained state, otherwise
//   AppendConstrainedToken preserves validity of the constrained prefix.
//
// suffix: Outside the span the implication is vacuous; when UnconstrainedChunk
//   stops on "<<", currentConstrainedOut is set to [] so the empty suffix
//   relation holds. CloseConstrainedSpan exits constrained mode, making the
//   implication vacuous. In the constrained-step branch, AppendConstrainedToken
//   appends the chosen token to both generated and currentConstrainedOut, so the
//   tracked constrained prefix remains exactly the suffix of generated; if
//   eosToken is returned we break with state unchanged.
//
// progress: UnconstrainedChunk appends stepsUsed tokens and we add exactly
//   stepsUsed to steps. CloseConstrainedSpan appends exactly 1 token and we add
//   1 to steps. ConstrainedStep consumes exactly 1 decoding step; if it returns
//   eosToken we increment steps by 1 and break with generated unchanged, and if
//   it returns a normal token then AppendConstrainedToken appends exactly 1
//   token and we also increment steps by 1. Thus every non-breaking iteration
//   respects |generated| <= |generatedPrefix| + steps and strictly decreases
//   maxSteps - steps.
//
// cost accounting: The loop maintains cost == 0 because returned cost is not
//   tracked incrementally in the out-parameter. Instead, steps is the sole
//   accounting variable: UnconstrainedChunk contributes stepsUsed, closing a
//   complete span contributes 1, and each constrained token decision contributes
//   1. Therefore assigning cost := steps at the end yields cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var clauseTokens: seq<Token> := ["SELECT", "FROM", "WHERE", "GROUP", "BY", "ORDER", "LIMIT", "HAVING", "JOIN", "ON", "ASC", "DESC", "AND", "OR", "NOT", "IN", "EXISTS", "COUNT", "SUM", "AVG", "MIN", "MAX", "DISTINCT"];
var structureTokens: seq<Token> := [",", "(", ")", "=", ">", "<"];
var boostTokens: seq<Token>;
var topCandidates: seq<Token>;
var keywordBias: seq<Token>;
var punctBias: seq<Token>;
var completeNow: bool;
var next: Token;
var constrainedPrompt: Prefix;
var stablePrefix: Prefix;
var chunkBudget: nat;
var chunkedGenerated: Prefix;
var stoppedOnOpenSpan: bool;
var stoppedOnEos: bool;
var stepsUsed: nat;
var closedGenerated: Prefix;
var closedInside: bool;
var closedCurrent: Prefix;
var appendedGenerated: Prefix;
var appendedInside: bool;
var appendedCurrent: Prefix;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    chunkBudget := maxSteps - steps;
    chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else {
      if stoppedOnOpenSpan {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      constrainedPrompt := prompt + stablePrefix;

      topCandidates := helpers.TopValidCandidates(
        lm, parser, constrainedPrompt, currentConstrainedOut, 24, eosToken
      );
      keywordBias := helpers.IntersectTokenSets(topCandidates, clauseTokens);
      punctBias := helpers.IntersectTokenSets(topCandidates, structureTokens);
      boostTokens := helpers.IntersectTokenSets(topCandidates, topCandidates);

      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      if |keywordBias| > 0 {
        helpers.BoostTokenLogits(lm, keywordBias, 8.0);
      }
      if |punctBias| > 0 {
        helpers.BoostTokenLogits(lm, punctBias, 3.0);
      }
      if |boostTokens| > 0 {
        helpers.BoostTokenLogits(lm, boostTokens, 1.5);
      }
      helpers.PenalizeTokenLogits(lm, [eosToken], 12.0);

      next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

