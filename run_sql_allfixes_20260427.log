Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL generation benefits from tracking lightweight SQL-specific
// semantic context inside the constrained span. This strategy tracks two local
// token sets extracted from the current SQL prefix: tokens following "FROM"
// (likely table names / aliases already introduced) and tokens following
// "SELECT" (likely projected columns). Outside a constrained span it uses
// chunked unconstrained generation to move quickly through ordinary text until
// the SQL span opens. Inside the span it first checks how narrow the parser is:
// when the grammar is narrow, it uses tight token-level constrained decoding;
// when the grammar is wider, it uses symbol-level decoding with a token budget
// and softly boosts parser-valid candidates that intersect the tracked context.
// The tracked state supports valid generation by never bypassing parser checks:
// all committed constrained content comes either from ConstrainedStep plus
// AppendConstrainedToken, or from ConstrainedSymbol, both of which preserve
// parser-valid prefixes. The semantic context only biases logits among already
// parser-compatible continuations, which is useful for schema-conditioned SQL.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   UnconstrainedChunk branch preserves the invariant because we remain outside
//   the span unless stoppedOnOpenSpan, in which case we set currentConstrainedOut
//   := [], and parser.IsValidPrefix([]) holds by precondition. Complete-prefix
//   close branch calls CloseConstrainedSpan only when parser.IsCompletePrefix(
//   currentConstrainedOut) is known, and the returned insideConstrainedOut is
//   false, so the implication is vacuous. In the narrow constrained branch,
//   ConstrainedStep returns either eosToken (break, no state update) or a valid
//   next token; AppendConstrainedToken therefore preserves parser validity. In
//   the wide constrained branch, ConstrainedSymbol returns a valid constrained
//   prefix symbolOut, and we assign currentConstrainedOut := symbolOut.
// suffix:
//   In the unconstrained chunk branch, if we stay outside the span the
//   implication is vacuous; if we enter on stoppedOnOpenSpan, we set
//   currentConstrainedOut := [], and the length-0 suffix of generated equals [].
//   In the close branch, CloseConstrainedSpan appends the delimiter and resets
//   currentConstrainedOut to [], so the implication is vacuous afterward. In
//   the narrow constrained branch, AppendConstrainedToken appends the same token
//   to generated and currentConstrainedOut, preserving suffix equality. In the
//   wide constrained branch, we write generated := stablePrefix + symbolOut and
//   currentConstrainedOut := symbolOut, so generated's suffix of that length is
//   exactly currentConstrainedOut.
// progress:
//   UnconstrainedChunk appends at most stepsUsed tokens and we do
//   steps := steps + stepsUsed, so |generated| <= |generatedPrefix| + steps is
//   preserved by linear arithmetic. CloseConstrainedSpan appends exactly one
//   token and we increment steps by 1. The narrow constrained branch appends
//   exactly one token only when it does not break, and also increments steps by
//   1. The wide constrained branch appends the symbol produced by
//   ConstrainedSymbol and increments steps by the returned stepsUsed, so the
//   same linear bound is maintained.
// cost accounting:
//   The loop maintains cost == 0 and uses a separate local steps counter for the
//   returned cost. Every cost-bumping action is mirrored in steps exactly as
//   required by the branch shape: +stepsUsed for UnconstrainedChunk, +1 for
//   CloseConstrainedSpan, +1 for ConstrainedStep, and +stepsUsed for
//   ConstrainedSymbol. Break branches leave steps unchanged after the bump that
//   already occurred in that iteration, so assigning cost := steps at the end
//   yields cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var fromContext: seq<Token> := [];
var selectContext: seq<Token> := [];
var narrowThreshold: nat := 12;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
      fromContext := [];
      selectContext := [];
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
