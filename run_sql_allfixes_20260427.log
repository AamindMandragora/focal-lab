Strategy: // CSD_RATIONALE_BEGIN
// The prior strategy entered a constrained span only when the model itself
// emitted "<<". That preserved syntax, but on Spider it often let the model
// spend many tokens outside SQL and then produce short, under-specified SQL
// such as "SELECT <id>". To fix that, this strategy actively steers generation
// into a single SQL span early and then stays there until a complete query is
// formed or EOS is reached.
//
// Concretely: outside a constrained span, we do only a very small amount of
// unconstrained decoding. If the model does not immediately open "<<", we
// force-open the constrained span with OpenConstrainedSpan so the parser starts
// governing SQL generation. Inside the span, we prefer ConstrainedSymbol with
// the full remaining budget, because Spider SQL is dominated by multi-token
// units (SELECT lists, table names, aliases, predicates, joins). When the
// parser reports completion, we close immediately with ">>". When the valid
// frontier is very narrow, we fall back to token-level ConstrainedStep.
//
// This change directly targets the observed failure mode: instead of waiting
// for the model to decide when SQL begins, we enter constrained SQL promptly,
// giving the grammar and schema-aware parser control over most of the answer.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the short unconstrained branch, if we remain outside the
//   span then currentConstrainedOut stays [] so the implication is vacuous; if
//   the chunk stops on "<<", we set currentConstrainedOut := [], a valid
//   prefix. In the force-open branch, OpenConstrainedSpan enters with empty
//   constrained content, again a valid prefix. In the complete-prefix branch,
//   CloseConstrainedSpan exits the span so the implication is vacuous. In the
//   token branch, ConstrainedStep either returns eosToken and we break, or
//   AppendConstrainedToken extends to another valid parser prefix. In the
//   symbol branch, ConstrainedSymbol returns currentOut that is itself a valid
//   prefix.
// suffix: Outside the span the implication is vacuous. When a chunk stops on
//   "<<", or when we force-open with OpenConstrainedSpan, we enter with
//   currentConstrainedOut := [], and the length-0 suffix of generated is [].
//   CloseConstrainedSpan resets the constrained state to empty, so the
//   implication is vacuous after closing. AppendConstrainedToken appends the
//   same token to generated and currentConstrainedOut, preserving the suffix
//   equality. In the symbol branch, with stablePrefix defined as generated
//   without the old constrained suffix, assigning generated := stablePrefix +
//   symbolOut and currentConstrainedOut := symbolOut makes the new suffix equal
//   to currentConstrainedOut by construction.
// cost accounting: steps starts at 0 and only increases by helper-reported
//   token counts: +stepsUsed for UnconstrainedChunk, +1 for OpenConstrainedSpan,
//   +1 for CloseConstrainedSpan, +1 for ConstrainedStep, and +stepsUsed2 for
//   ConstrainedSymbol. No branch decreases steps, and break branches leave it
//   unchanged, so cost := steps at the end is sound and bounded by maxSteps.
// progress: UnconstrainedChunk appends exactly the returned number of tokens,
//   and we add stepsUsed to steps. OpenConstrainedSpan and CloseConstrainedSpan
//   each append one token and we increment steps by 1. AppendConstrainedToken
//   appends one token after a ConstrainedStep, so generated grows by 1 while
//   steps also grows by 1. In the symbol branch, replacing the old constrained
//   suffix by symbolOut increases total length by |symbolOut| - |oldCurrent|,
//   which is bounded by stepsUsed2, and we add stepsUsed2 to steps. Break
//   branches do not modify generated, so the bound is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 4;
var openedOnce: bool := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if openedOnce {
      var rem0: nat := maxSteps - steps;
      if rem0 == 0 {
        break;
      } else {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        openedOnce := true;
        steps := steps + 1;
      }
    } else {
      var rem1: nat := maxSteps - steps;
      if rem1 == 0 {
        break;
      } else {
        var chunkBudget: nat := 1;
        var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
          lm, prompt, generated, chunkBudget, "<<", eosToken
        );
        generated := chunkedGenerated;
        steps := steps + stepsUsed;
        if stoppedOnEos {
          break;
        } else if stoppedOnOpenSpan {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          openedOnce := true;
        } else {
          if steps < maxSteps {
            var openedGenerated2, openedInside2, openedCurrent2 := helpers.OpenConstrainedSpan(lm, generated);
            generated := openedGenerated2;
            insideConstrainedOut := openedInside2;
            currentConstrainedOut := openedCurrent2;
            openedOnce := true;
            steps := steps + 1;
          }
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var rem2: nat := maxSteps - steps;
      if rem2 == 0 {
        break;
      } else {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
      }
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var rem3: nat := maxSteps - steps;
      if rem3 == 0 {
        break;
      } else if validCount <= narrowThreshold {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var symbolOut, hitEos, stepsUsed2 := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, rem3, eosToken
        );
        generated := stablePrefix + symbolOut;
        insideConstrainedOut := true;
        currentConstrainedOut := symbolOut;
        steps := steps + stepsUsed2;
        if hitEos {
          break;
        }
      }
    }
  }
}

cost := steps;

