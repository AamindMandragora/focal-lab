        var focused := helpers.IntersectTokenSets(candidates, selectContext);
        if |scoped| > 0 {
          helpers.BoostTokenLogits(lm, scoped, 5.0);
        }
        if |focused| > 0 {
          helpers.BoostTokenLogits(lm, focused, 3.0);
        }

        var symbolBudget: nat := maxSteps - steps;
        var symbolOut, hitEos, stepsUsed2 := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, symbolBudget, eosToken
        );
        generated := stablePrefix + symbolOut;
        currentConstrainedOut := symbolOut;
        steps := steps + stepsUsed2;
        if hitEos {
          break;
        }
      }
    }
  }
}

