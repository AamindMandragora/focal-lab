Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy still relied on the model to emit the opening delimiter
// in free-form text, and then it allowed constrained generation to stop at very
// short complete prefixes. The evaluation failures ("SELECT count") indicate that
// the SQL body was often truncated to an early complete fragment rather than a
// full Spider query.
//
// The revised strategy is simpler and more forceful:
//
// 1. If we are not already inside a constrained span, immediately open one with
//    OpenConstrainedSpan. This guarantees the required << delimiter appears and
//    removes dependence on unconstrained text for delimiter production.
// 2. While inside the span, keep generating constrained symbols using
//    ConstrainedSymbol with all remaining budget. We do not close merely because
//    the parser first reports completeness after a tiny fragment; instead, we
//    keep extending until either EOS is hit, budget is exhausted, or the parser
//    is complete and the valid-next-token set is small enough that continuing is
//    likely unnecessary.
// 3. Once we decide to stop inside a complete constrained prefix, we close the
//    span immediately with CloseConstrainedSpan so the output contains both <<
//    and >>.
// 4. We avoid any unconstrained tail generation after closing, since Spider wants
//    a single SQL query and extra text is harmful.
//
// This directly addresses the observed truncation by spending nearly all budget
// on schema-constrained SQL generation rather than on unconstrained text or on
// premature closing at the first complete prefix.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: Opening a span sets currentConstrainedOut to [], which is a
//   valid parser prefix. In the constrained-generation branch, ConstrainedSymbol
//   returns currentOut that is itself a valid prefix, and assigning it to
//   currentConstrainedOut preserves the invariant. In the close branch we leave
//   the span, so the implication becomes vacuous; break branches leave the state
//   unchanged.
// suffix: After opening, currentConstrainedOut is empty, so the suffix property
//   holds trivially. In the constrained-generation branch, with
//   stablePrefix = generated[..|generated|-|oldCurrent|], assigning
//   generated := stablePrefix + currentOut and currentConstrainedOut := currentOut
//   makes the final suffix equal to currentConstrainedOut by construction. After
//   closing we are outside the span, so the implication is vacuous.
// cost accounting: steps starts at 0 and is increased only by helper-reported
//   costs: +1 for OpenConstrainedSpan, +1 for CloseConstrainedSpan, and
//   +stepsUsed for ConstrainedSymbol. Query helpers such as ValidTokenCount and
//   IsCompletePrefix do not affect steps. Thus cost := steps is sound, and
//   helpers are always called with remaining budget so steps never exceeds
//   maxSteps.
// progress: OpenConstrainedSpan appends exactly 1 token and we increment steps by
//   1. CloseConstrainedSpan appends exactly 1 token and we increment steps by 1.
//   In the ConstrainedSymbol branch, replacing the old constrained suffix by
//   currentOut changes total length by |currentOut| - |oldCurrent|, which is
//   bounded by stepsUsed, and we increment steps by stepsUsed. Break branches
//   preserve the inequality immediately.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var shouldStop: bool := false;

while steps < maxSteps && !shouldStop
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var rem0: nat := maxSteps - steps;
    if rem0 == 0 {
      shouldStop := true;
    } else {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    }
  } else {
    var rem1: nat := maxSteps - steps;
    if rem1 == 0 {
      shouldStop := true;
    } else {
      var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
      if completeNow {
        var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
        if validCount <= 1 || rem1 == 1 {
          var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
            lm, parser, generated, currentConstrainedOut
          );
          generated := closedGenerated;
          insideConstrainedOut := closedInside;
          currentConstrainedOut := closedCurrent;
          steps := steps + 1;
          shouldStop := true;
        } else {
          var stablePrefix1 := generated[..|generated| - |currentConstrainedOut|];
          var constrainedPrompt1 := prompt + stablePrefix1;
          var currentOut1, hitEos1, stepsUsed1 := helpers.ConstrainedSymbol(
            lm, parser, constrainedPrompt1, currentConstrainedOut, rem1, eosToken
          );
          generated := stablePrefix1 + currentOut1;
          insideConstrainedOut := true;
          currentConstrainedOut := currentOut1;
          steps := steps + stepsUsed1;
          if hitEos1 {
            shouldStop := true;
          }
        }
      } else {
        var stablePrefix2 := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt2 := prompt + stablePrefix2;
        var currentOut2, hitEos2, stepsUsed2 := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt2, currentConstrainedOut, rem1, eosToken
        );
        generated := stablePrefix2 + currentOut2;
        insideConstrainedOut := true;
        currentConstrainedOut := currentOut2;
        steps := steps + stepsUsed2;
        if hitEos2 {
          shouldStop := true;
        }
      }
    }
  }
}

cost := steps;

