Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL generation benefits from two kinds of state: the ordinary
// constrained-span state (insideConstrainedOut/currentConstrainedOut), and a
// lightweight SQL semantic context extracted from the current span after the
// keyword "FROM". The constrained state guarantees grammar validity against the
// schema-specialized SQL parser; the semantic context approximates which table /
// alias tokens are currently in scope.
//
// The strategy is chunked outside the SQL span and adaptive inside it. Outside
// the span, it uses UnconstrainedChunk to move quickly until either EOS or the
// opening delimiter "<<". Inside the span, if the current SQL prefix is already
// complete, it closes immediately. Otherwise it first refreshes the semantic
// context from the current SQL prefix, then measures parser narrowness. At
// narrow positions it uses exact ConstrainedStep token-by-token; at wider
// positions it uses ConstrainedSymbol so multi-token SQL units can be emitted
// naturally within a bounded token budget.
//
// Minimal verification fix: keep the strategy unchanged, but add an explicit
// progress branch when the wide constrained branch computes symbolBudget == 0.
// Without that branch, Dafny cannot prove the loop's decreases metric because
// there exists a path (remainingSteps > 0 and stepTokenBudget == 0) that neither
// breaks nor increases steps. Breaking in that zero-budget case preserves the
// strategy shape and makes every non-breaking iteration strictly reduce
// maxSteps - steps.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: Outside the span, insideConstrainedOut stays false unless
//   UnconstrainedChunk stops on "<<"; then we set currentConstrainedOut := [],
//   which is valid by parser.IsValidPrefix([]). In the complete-prefix branch,
//   CloseConstrainedSpan makes insideConstrainedOut false, so the implication is
//   vacuous. In the narrow constrained branch, ConstrainedStep either returns
//   eosToken and we break, or returns a valid next token; AppendConstrainedToken
//   preserves parser validity. In the wide branch, ConstrainedSymbol is called
//   only with positive budget; it returns currentOut that is a valid prefix, and
//   we assign currentConstrainedOut := symbolOut. If symbolBudget == 0, we
//   break immediately, so the invariant is preserved trivially.
//
// suffix: Outside the span, when not inside constrained decoding the invariant
//   is vacuous; if UnconstrainedChunk stops on "<<", we enter constrained mode
//   with currentConstrainedOut := [], and the empty suffix relation holds.
//   CloseConstrainedSpan resets constrained tracking, so the implication is
//   vacuous. In the narrow branch, AppendConstrainedToken appends the same token
//   to generated and currentConstrainedOut, preserving the suffix equality. In
//   the wide branch, stablePrefix is generated without the old constrained
//   suffix, and assigning generated := stablePrefix + symbolOut together with
//   currentConstrainedOut := symbolOut makes the new trailing suffix equal to
//   currentConstrainedOut by construction. If symbolBudget == 0, we break with
//   state unchanged.
//
// progress: Chunk branch: UnconstrainedChunk appends stepsUsed tokens with
//   stepsUsed bounded by the remaining budget maxSteps - steps, then we add the
//   same stepsUsed to steps, so |generated| <= |generatedPrefix| + steps is
//   preserved. Close branch: CloseConstrainedSpan appends exactly 1 token and we
//   increment steps by 1. Narrow branch: ConstrainedStep + AppendConstrainedToken
//   appends exactly 1 token and we increment steps by 1; if eosToken is returned
//   we break immediately after the increment with generated unchanged. Wide
//   branch: ConstrainedSymbol is called only when symbolBudget > 0 and extends
//   the constrained suffix by at most stepsUsed2 tokens; we increment steps by
//   the same stepsUsed2. If symbolBudget == 0, we break immediately, so no
//   non-progressing iteration remains.
//
// cost accounting: cost remains 0 during the loop, so invariant cost == 0 is
//   preserved in every branch. The actual returned accounting is carried by
//   steps: chunk adds stepsUsed, close adds 1, narrow constrained decoding adds
//   1, and wide constrained decoding adds stepsUsed2 bounded by the remaining
//   budget. The new zero-budget branch breaks instead of looping without
//   progress, which is exactly what makes the decreases argument go through.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var fromKeyword: Token := "FROM";
var semanticContext: seq<Token> := [];
var narrowThreshold: nat := 12;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpenSpan {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
      semanticContext := [];
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      semanticContext := [];
      steps := steps + 1;
    } else {
      semanticContext := helpers.ExtractAfterKeyword(currentConstrainedOut, fromKeyword);
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);

      if validCount <= narrowThreshold {
        if |semanticContext| > 0 {
          var focusedCandidates := helpers.TopValidCandidates(
            lm, parser, constrainedPrompt, currentConstrainedOut, 12, eosToken
          );
          var focusedBoost := helpers.IntersectTokenSets(focusedCandidates, semanticContext);
          lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
          if |focusedBoost| > 0 {
            helpers.BoostTokenLogits(lm, focusedBoost, 6.0);
          }
        }

        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var remainingSteps: nat := maxSteps - steps;
        if remainingSteps > 0 {
          if |semanticContext| > 0 {
            var wideCandidates := helpers.TopValidCandidates(
              lm, parser, constrainedPrompt, currentConstrainedOut, 20, eosToken
            );
            var wideBoost := helpers.IntersectTokenSets(wideCandidates, semanticContext);
            lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
            if |wideBoost| > 0 {
              helpers.BoostTokenLogits(lm, wideBoost, 4.0);
            }
          }

          var symbolBudget: nat := remainingSteps;
          if stepTokenBudget < symbolBudget {
            symbolBudget := stepTokenBudget;
          }
          if symbolBudget > 0 {
            var symbolOut, hitEos, stepsUsed2 := helpers.ConstrainedSymbol(
              lm, parser, constrainedPrompt, currentConstrainedOut, symbolBudget, eosToken
            );
            generated := stablePrefix + symbolOut;
            currentConstrainedOut := symbolOut;
            steps := steps + stepsUsed2;
            if hitEos {
              break;
            }
          } else {
            break;
          }
        }
      }
    }
  }
}

cost := steps;

