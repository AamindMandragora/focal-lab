Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy succeeded syntactically but still under-generated on
// Spider, frequently emitting very short complete SQL such as "SELECT count".
// That failure pattern suggests the decoder was letting the parser stop at the
// earliest complete prefix instead of pushing toward a fuller query body.
//
// This revision changes the policy in two ways. First, it opens the constrained
// SQL span immediately whenever we are outside it, so nearly all generation is
// parser-governed. Second, once inside the span, it does not close as soon as
// the prefix is complete. Instead it uses a completion-aware bias: if the
// prefix is complete but still has valid continuations, we keep generating while
// budget remains, only closing when the valid frontier is exhausted or when we
// are at the last available step. This directly targets the observed "short but
// valid" outputs by preferring longer schema-consistent SQL over minimal
// complete prefixes.
//
// Operationally, inside the span we use token-level constrained decoding when
// the parser frontier is narrow or when the prefix is already complete, because
// those are exactly the moments where a single token can decide whether we
// extend with FROM / WHERE / GROUP BY / ORDER BY or terminate. When the
// frontier is broader and the prefix is incomplete, we use ConstrainedSymbol to
// advance multiple tokens efficiently. EOS remains terminal.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: Opening a constrained span sets currentConstrainedOut := [],
//   which is a valid parser prefix. In the close branch we leave the span, so
//   the implication is vacuous. In the ConstrainedStep branch, if next is EOS
//   we break without changing state; otherwise AppendConstrainedToken extends
//   the constrained content to another valid prefix. In the ConstrainedSymbol
//   branch, the helper returns currentOut that is itself a valid prefix.
// suffix: After opening, currentConstrainedOut is empty, so the suffix claim is
//   immediate. After closing, we are outside the span so the implication is
//   vacuous. AppendConstrainedToken appends the same token to generated and the
//   constrained suffix, preserving equality. In the ConstrainedSymbol branch,
//   with stablePrefix = generated[..|generated|-|oldCurrent|], assigning
//   generated := stablePrefix + symbolOut and currentConstrainedOut := symbolOut
//   makes the final suffix equal to currentConstrainedOut by construction.
// cost accounting: steps starts at 0 and increases only by helper-reported
//   token counts: +1 for OpenConstrainedSpan, +1 for CloseConstrainedSpan, +1
//   for ConstrainedStep, and +stepsUsed for ConstrainedSymbol. Break branches
//   leave steps unchanged. Thus cost := steps is sound and never exceeds
//   maxSteps because every increment is guarded by remaining budget.
// progress: OpenConstrainedSpan and CloseConstrainedSpan append exactly one
//   token and steps increases by 1. In the ConstrainedStep branch, a non-EOS
//   token appends exactly one token and steps also increases by 1; if EOS is
//   returned we break immediately. In the ConstrainedSymbol branch, replacing
//   the old constrained suffix by symbolOut changes total length by
//   |symbolOut| - |oldCurrent|, which is bounded by stepsUsed, and we increase
//   steps by stepsUsed. Therefore |generated| <= |generatedPrefix| + steps is
//   preserved in every branch.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 6;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var rem0: nat := maxSteps - steps;
    if rem0 == 0 {
      break;
    } else {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    }
  } else {
    var rem1: nat := maxSteps - steps;
    if rem1 == 0 {
      break;
    } else {
      var complete := parser.IsCompletePrefix(currentConstrainedOut);
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;

      if complete && (validCount == 0 || rem1 == 1) {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
      } else if complete || validCount <= narrowThreshold {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var symbolOut, hitEos, stepsUsed := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, rem1, eosToken
        );
        generated := stablePrefix + symbolOut;
        insideConstrainedOut := true;
        currentConstrainedOut := symbolOut;
        steps := steps + stepsUsed;
        if hitEos {
          break;
        }
      }
    }
  }
}

cost := steps;

