[Unit]
Description=Dynamic CSD warm-recovery queue supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/aadivyar/csd-generation
Environment=PYTHONUNBUFFERED=1
ExecStart=/apps/conda/aadivyar/envs/csd/bin/python /home/aadivyar/csd-generation/scripts/runtime/supervise_warm_task_recovery.py --repo /home/aadivyar/csd-generation --manifest /home/aadivyar/csd-generation/saved-results/2026-07-14-warm-task-recovery-manifest.json --controller /home/aadivyar/csd-generation/scripts/runtime/run_warm_task_recovery_queue.py --resume-script /home/aadivyar/csd-generation/.context/resume_http429_cells.sh --python /apps/conda/aadivyar/envs/csd/bin/python --controller-lock /home/aadivyar/csd-generation/.context/warm_task_recovery_0714/controller.lock --controller-pid-file /home/aadivyar/csd-generation/.context/warm_task_recovery_0714/controller.pid --state-file /home/aadivyar/csd-generation/.context/warm_task_recovery_0714/supervisor_state.json --pending-manifest /home/aadivyar/csd-generation/.context/warm_task_recovery_0714/pending_manifest.json --poll-seconds 30 --retry-seconds 3600
Restart=on-failure
RestartSec=60
KillMode=control-group
TimeoutStopSec=30
StandardOutput=append:/home/aadivyar/csd-generation/logs/paid_synth_warmfix_supervisor.log
StandardError=inherit

[Install]
WantedBy=default.target
