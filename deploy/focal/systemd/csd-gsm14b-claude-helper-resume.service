[Unit]
Description=Resume GSM 14B with final helper menu and Claude Code Max authoring
After=default.target
Conflicts=csd-gsm14b-claude-resume.service

[Service]
Type=simple
WorkingDirectory=/home/aadivyar/csd-generation
ExecStart=/home/aadivyar/csd-generation/.recovery/claude-code-gsm14b/launch_resume_from55_helpers.sh
Restart=on-abnormal
RestartSec=30
SuccessExitStatus=75
KillMode=control-group

[Install]
WantedBy=default.target
