[Unit]
Description=Dynamic CSD Claude helper-recovery queue
After=default.target
Conflicts=csd-gsm14b-claude-durable.service csd-gsm14b-claude-helper-resume.service csd-gsm14b-claude-resume.service

[Service]
Type=simple
WorkingDirectory=/home/aadivyar/csd-generation
ExecStartPre=/apps/conda/aadivyar/envs/csd/bin/python /home/aadivyar/csd-generation/scripts/runtime/claude_recovery/prepare_manifest.py --source /home/aadivyar/csd-generation/saved-results/2026-07-15-claude-helper-recovery-manifest.json --output /home/aadivyar/csd-generation/.context/claude_recovery_queue_0715/ordered_manifest.json --gpu-total-mib 40960
ExecStart=/apps/conda/aadivyar/envs/csd/bin/python /home/aadivyar/csd-generation/scripts/runtime/supervise_warm_task_recovery.py --repo /home/aadivyar/csd-generation --manifest /home/aadivyar/csd-generation/.context/claude_recovery_queue_0715/ordered_manifest.json --controller /home/aadivyar/csd-generation/scripts/runtime/run_warm_task_recovery_queue.py --resume-script /home/aadivyar/csd-generation/.recovery/claude-code-queue/launch_cell.sh --python /apps/conda/aadivyar/envs/csd/bin/python --controller-lock /home/aadivyar/csd-generation/.context/claude_recovery_queue_0715/controller.lock --controller-pid-file /home/aadivyar/csd-generation/.context/claude_recovery_queue_0715/controller.pid --state-file /home/aadivyar/csd-generation/.context/claude_recovery_queue_0715/supervisor_state.json --pending-manifest /home/aadivyar/csd-generation/.context/claude_recovery_queue_0715/pending_manifest.json --poll-seconds 30 --retry-seconds 3600
Restart=on-failure
RestartSec=30
KillMode=control-group

[Install]
WantedBy=default.target
