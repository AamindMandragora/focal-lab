Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL usually has one constrained region containing the SQL
// query itself. We track the full generated output in `generated`, whether we
// are currently inside the constrained SQL span in `insideConstrainedOut`, and
// the SQL-only suffix being validated by the schema-specialized parser in
// `currentConstrainedOut`.
// 
// Outside the constrained span, we decode freely but bias toward opening `"<<"
// when its logit is close to the current argmax; this helps enter SQL decoding
// promptly after the schema/question preamble. Inside the span, we use
// symbol-level constrained decoding (`ConstrainedSymbol`) so one outer step can
// accept up to `stepTokenBudget` SQL tokens while preserving parser validity.
// As soon as the parser reports a complete SQL prefix, we close the span with
// `">>"`. EOS always terminates immediately.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
// - Outside-span branch: if we stay outside, the implication is vacuous. If we
//   open a span (either by committing `"<<“` or by eager-opening when its logit
//   is close), we set `currentConstrainedOut := []`, and `parser.IsValidPrefix([])`
//   holds by the method precondition.
// - Complete-prefix branch: we call `CloseConstrainedSpan` only when
//   `parser.IsCompletePrefix(currentConstrainedOut)` is already known. It flips
//   `insideConstrainedOut` to false, so the implication becomes vacuous.
// - Constrained-symbol branch: `ConstrainedSymbol` returns a parser-valid
//   constrained prefix; assigning that result to `currentConstrainedOut`
//   preserves `insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)`.
// 
// suffix:
// - Outside-span branch: if we remain outside, `currentConstrainedOut == []` by
//   invariant, so the implication is vacuous. If we open a span, we append only
//   the delimiter `"<<“` to `generated` and set `currentConstrainedOut := []`;
//   the length-0 suffix of `generated` is `[]`.
// - Complete-prefix branch: `CloseConstrainedSpan` appends the closing delimiter
//   and resets `currentConstrainedOut := []`, so the suffix implication is again
//   vacuous afterward.
// - Constrained-symbol branch: let `stablePrefix` be `generated` without the old
//   constrained suffix. We set `generated := stablePrefix + symbolOut` and
//   `currentConstrainedOut := symbolOut`, so the final `|symbolOut|` tokens of
//   `generated` are exactly `currentConstrainedOut`.
// 
// cost accounting:
// - We use a local `steps` counter and return `cost := steps` at the end.
// - Every loop branch increments `steps` by exactly 1 after doing one outer
//   decoding action (free token/sample, close-span action, or constrained
//   symbol action). Therefore `steps <= maxSteps` by the loop guard and
//   `cost <= maxSteps` at return.
// 
// progress:
// - Outside-span branch appends at most one token (`"<<“` or one sampled token),
//   and `stepTokenBudget >= 1`, so one outer step allows that growth.
// - Complete-prefix branch appends only the closing delimiter, again at most one
//   token, which fits within one step's budget.
// - Constrained-symbol branch may append multiple SQL tokens, but
//   `ConstrainedSymbol` is called with `stepTokenBudget`, so the accepted symbol
//   adds at most `stepTokenBudget` tokens in that outer step. Hence
//   `|generated| <= |generatedPrefix| + steps * stepTokenBudget` is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;

    if openLogit >= argmaxLogit - 2.0 && argmax != eosToken && argmax != "<<" {
      generated := generated + ["<<"];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var symbolOut, hitEos, stepsUsed := helpers.ConstrainedSymbol(
        lm, parser, constrainedPrompt, currentConstrainedOut, stepTokenBudget, eosToken
      );
      generated := stablePrefix + symbolOut;
      insideConstrainedOut := true;
      currentConstrainedOut := symbolOut;
      steps := steps + 1;
      if hitEos {
        break;
      }
    }
  }
}

cost := steps;

