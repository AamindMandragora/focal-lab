Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy was too permissive inside the SQL span: it let the LM
// autoregress token-by-token for the entire query, which produced syntactically
// valid but semantically drifting SQL, especially on long Spider examples. The
// traces showed hundreds of constrained single-token steps and one example that
// ran all the way to maxSteps.
//
// This revision makes two concrete changes.
//
// 1. Enter the constrained SQL span immediately and avoid a long unconstrained
//    search for "<<". Spider expects a single SQL query output, so spending many
//    steps outside the grammar is unnecessary. If we are not already inside a
//    constrained span, we open one directly with OpenConstrainedSpan.
//
// 2. Inside the SQL span, bias strongly toward schema/question token groups and
//    terminate aggressively when the parser reaches a complete query. We use
//    GroupBoostedConstrainedStep on every constrained token so caller-provided
//    schema-aware groups influence decoding throughout the query, not only in
//    narrow states. To reduce semantic drift and runaway continuations, once the
//    query becomes complete we immediately close the span, and we also stop
//    generation on EOS. This keeps outputs short and focused on one SQL query.
//
// The state discipline remains standard: generated stores the full text
// including delimiters, while currentConstrainedOut stores only the SQL tokens
// between them. All constrained appends update both in lockstep, so parser
// validity and suffix alignment are maintained.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open-span branch, OpenConstrainedSpan sets
//   currentConstrainedOut := [] and insideConstrainedOut := true, and
//   parser.IsValidPrefix([]) holds by precondition. In the close branch,
//   insideConstrainedOut becomes false, so the implication is vacuous. In the
//   group-boosted constrained branch, GroupBoostedConstrainedStep guarantees the
//   sampled token is either eosToken or parser-valid next; on non-EOS,
//   AppendConstrainedToken extends currentConstrainedOut to a valid prefix.
// suffix: In the open-span branch, generated gains only the delimiter while
//   currentConstrainedOut is reset to [], so the length-0 suffix relation holds.
//   In the close branch, insideConstrainedOut becomes false, so the implication
//   is vacuous. In the constrained append branch, AppendConstrainedToken appends
//   the same token to generated and currentConstrainedOut, preserving suffix
//   equality.
// cost accounting: We maintain cost == 0 during the loop and return cost :=
//   steps afterward. OpenConstrainedSpan, CloseConstrainedSpan, and
//   GroupBoostedConstrainedStep are cost-bumping helpers with unit cost, while
//   AppendConstrainedToken is non-bumping; therefore each non-breaking branch
//   that uses them increments steps by exactly 1.
// progress bound: OpenConstrainedSpan appends exactly one token and we do
//   steps := steps + 1. CloseConstrainedSpan appends at most one token and we
//   also increment steps by 1. GroupBoostedConstrainedStep either returns EOS
//   and we break immediately, or AppendConstrainedToken appends exactly one
//   token while steps increases by 1. Thus every non-breaking branch strictly
//   increases steps, preserving |generated| <= |generatedPrefix| + steps and
//   satisfying decreases maxSteps - steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.GroupBoostedConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 8.0, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

