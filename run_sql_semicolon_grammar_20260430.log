Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL often has a long unconstrained preamble (schema/question
// text and the opening delimiter) followed by a single constrained SQL span.
// This strategy tracks only the standard delimiter state:
//   * generated: full emitted text, including delimiters
//   * insideConstrainedOut: whether we are currently inside the SQL span
//   * currentConstrainedOut: just the SQL tokens between "<<" and ">>"
//
// Outside the span, we amortize work with UnconstrainedChunk so the model can
// freely emit prompt-following text until it either reaches EOS or opens the
// SQL span with "<<". Inside the span, we use the SQL parser plus schema-aware
// validTokenGroups supplied by the caller. When the grammar is narrow, we use
// AdaptiveConstrainedStep to softly boost caller-preferred groups while still
// hard-masking to parser-valid SQL tokens. When the grammar is very narrow, we
// instead use ConstrainedStep directly, since boosting matters less when only a
// few SQL continuations are legal. As soon as the parser reports a complete SQL
// query, we close the span with CloseConstrainedSpan.
//
// The tracked constrained suffix is exactly the parser-visible SQL query, so
// parser validity and generated/current suffix alignment are maintained by
// construction across append and close operations.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, insideConstrainedOut
//   stays false unless the chunk stops on "<<"; in that case we set
//   currentConstrainedOut := [], and parser.IsValidPrefix([]) holds by the
//   method precondition. In the close branch, CloseConstrainedSpan returns
//   insideOut == false, so the implication is vacuous. In the direct
//   constrained-step branch, ConstrainedStep either breaks on EOS with state
//   unchanged or returns parser-valid updated currentOut. In the adaptive
//   branch, AdaptiveConstrainedStep guarantees that any non-EOS next token is
//   parser-valid next, and AppendConstrainedToken preserves validity.
// suffix: In the unconstrained chunk branch, when we remain outside the span
//   the implication is vacuous; when we enter on "<<", currentConstrainedOut is
//   reset to [], and the length-0 suffix of generated equals []. In the close
//   branch, CloseConstrainedSpan appends the delimiter and resets
//   currentConstrainedOut to [], so the suffix invariant is immediate. In the
//   direct constrained-step branch, ConstrainedStep preserves the suffix
//   relation internally. In the adaptive branch, AppendConstrainedToken appends
//   the same token to generated and currentConstrainedOut, preserving suffix
//   equality.
// cost accounting: We return cost := steps at the end and keep invariant
//   cost == 0 during the loop. Each non-breaking branch increases steps by the
//   exact amount of generation work performed: UnconstrainedChunk uses the
//   returned stepsUsed, CloseConstrainedSpan uses 1, ConstrainedStep uses 1,
//   and AdaptiveConstrainedStep + AppendConstrainedToken uses 1 because only
//   the sampling helper is cost-bumping. Thus final cost == steps <= maxSteps.
// progress bound: UnconstrainedChunk appends at most stepsUsed tokens and we do
//   steps := steps + stepsUsed, so |generated| <= |generatedPrefix| + steps is
//   preserved. CloseConstrainedSpan appends at most one token and steps grows
//   by 1. ConstrainedStep either breaks immediately on EOS or appends exactly
//   one token while steps grows by 1. AdaptiveConstrainedStep either breaks on
//   EOS or, after AppendConstrainedToken, appends exactly one token while steps
//   grows by 1. Therefore every non-breaking branch strictly increases steps,
//   satisfying decreases maxSteps - steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 6;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpenSpan {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);

      if validCount <= 1 {
        var steppedGenerated, steppedInside, steppedCurrent, hitEos := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := steppedGenerated;
          insideConstrainedOut := steppedInside;
          currentConstrainedOut := steppedCurrent;
        }
      } else {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

