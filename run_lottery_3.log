Strategy: // CSD_RATIONALE_BEGIN
// Revised strategy: the prior version improved accuracy but still produced too
// many malformed or unfinished arithmetic spans and spent too many steps inside
// free-form derivations. To raise syntax rate and runtime reliability, this
// version becomes much more conservative and delimiter-centric.
//
// Key changes:
// 1. Outside constrained mode, we strongly bias toward opening a span whenever
//    the current high-probability token looks arithmetic-relevant (digits,
//    "=", "+", "-", "*", "/"), but we do not force long free-form templates.
//    This increases the chance that actual computations appear inside << >>.
// 2. Inside constrained mode, we never use a raw argmax append path. Instead we
//    either close immediately when the parser says the arithmetic prefix is
//    complete, or we use ConstrainedStep to obtain a parser-compatible next
//    token. This avoids malformed spans such as "<<n1 + n2>>" with symbolic
//    variables or unfinished expressions.
// 3. We add dead-end recovery: if the current constrained prefix has very few or
//    no valid continuations, we roll back to the longest valid prefix and, if
//    that rolled prefix is complete, close promptly. This prevents getting stuck
//    in low-syntax states.
// 4. We keep each loop iteration to at most one emitted token and one unit of
//    step budget, preserving the simple proof obligations and keeping runtime
//    bounded.
//
// Overall, the design trades some creativity for much stronger well-formedness:
// outside spans we lightly steer toward arithmetic, and inside spans we rely on
// parser-guided generation plus eager closure.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
// - Outside-span normal-token branch: we remain outside constrained mode, so the
//   implication is vacuous.
// - Outside-span open branch: OpenConstrainedSpan sets currentConstrainedOut to
//   [] while entering constrained mode; [] is valid by the precondition.
// - Inside-span close branch: CloseConstrainedSpan exits constrained mode and
//   resets currentConstrainedOut to [], so the implication is vacuous.
// - Inside-span rollback branch: RollbackToValidPrefix returns a valid prefix;
//   assigning that prefix preserves parser validity, and if it is complete we
//   immediately close.
// - Inside-span constrained-step append branch: ConstrainedStep is used only to
//   choose a parser-compatible next token, and AppendConstrainedToken extends
//   the valid prefix with that token, preserving validity. If ConstrainedStep
//   returns eosToken we break without changing the constrained state.
//
// suffix:
// - Outside-span normal-token branch: we stay outside constrained mode, so the
//   suffix invariant is vacuous.
// - Outside-span open branch: OpenConstrainedSpan appends "<<" to generated and
//   sets currentConstrainedOut := []; the length-0 suffix equals [].
// - Inside-span close branch: CloseConstrainedSpan appends ">>" and exits
//   constrained mode, making the implication vacuous.
// - Inside-span rollback branch: rollback only shortens currentConstrainedOut to
//   a valid prefix already equal to the suffix of generated, so the suffix
//   equality still holds; if we then close, the implication becomes vacuous.
// - Inside-span constrained-step append branch: AppendConstrainedToken appends
//   the same token to generated and currentConstrainedOut, preserving suffix
//   equality.
//
// cost:
// - Outside-span normal-token branch uses ChooseNextTokenUnconstrained and then
//   manually increments helpers.cost by 1; steps is incremented once too.
// - Outside-span open branch uses OpenConstrainedSpan, which bumps helpers.cost
//   by 1 internally; steps is incremented once.
// - Inside-span close branch uses CloseConstrainedSpan, which bumps helpers.cost
//   by 1 internally; steps is incremented once.
// - Inside-span rollback-only branch uses only non-bumping helpers, so
//   helpers.cost stays unchanged while steps may increase by at most 1 later in
//   the iteration through close or constrained step.
// - Inside-span constrained-step branch uses ConstrainedStep, which bumps cost
//   by 1 internally; steps is incremented once. Thus helpers.cost <= steps is
//   preserved in every branch.
//
// progress:
// - Every iteration increments steps exactly once before any possible break.
// - Outside constrained mode, we append at most one token: either a sampled
//   token or the opening delimiter via OpenConstrainedSpan.
// - Inside constrained mode, we either append one closing delimiter, append one
//   constrained token, or only modify currentConstrainedOut by rollback without
//   growing generated.
// - Therefore generated grows by at most one token per step, so
//   |generated| <= |generatedPrefix| + steps is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant helpers.cost <= steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var shouldOpen :=
      argmax == "<<" ||
      Contains(argmax, "=") ||
      Contains(argmax, "+") ||
      Contains(argmax, "-") ||
      Contains(argmax, "*") ||
      Contains(argmax, "/") ||
      Contains(argmax, "0") ||
      Contains(argmax, "1") ||
      Contains(argmax, "2") ||
      Contains(argmax, "3") ||
      Contains(argmax, "4") ||
      Contains(argmax, "5") ||
      Contains(argmax, "6") ||
      Contains(argmax, "7") ||
      Contains(argmax, "8") ||
      Contains(argmax, "9");

    if shouldOpen {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else if next == "<<" {
        var openedGenerated2, openedInside2, openedCurrent2 := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated2;
        insideConstrainedOut := openedInside2;
        currentConstrainedOut := openedCurrent2;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if narrow {
        var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
        currentConstrainedOut := rolled;
        var completeAfterRollback := parser.IsCompletePrefix(currentConstrainedOut);
        if completeAfterRollback {
          var closedGenerated2, closedInside2, closedCurrent2 := helpers.CloseConstrainedSpan(
            lm, parser, generated, currentConstrainedOut
          );
          generated := closedGenerated2;
          insideConstrainedOut := closedInside2;
          currentConstrainedOut := closedCurrent2;
          steps := steps + 1;
        } else {
          var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
          var next2 := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if next2 == eosToken {
            break;
          } else {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next2
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
          }
        }
      } else {
        var constrainedPrompt2 := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next3 := helpers.ConstrainedStep(lm, parser, constrainedPrompt2, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next3 == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next3
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

cost := steps;

