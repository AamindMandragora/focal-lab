Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy produced syntactically valid outputs wrapped in `<< >>`,
// but accuracy was 0% and the anonymized preview `SELECT` strongly suggests the
// decoder often closed the constrained span after emitting only a short valid
// SQL prefix. For Spider, many SQL grammars treat prefixes like `SELECT` or
// `SELECT col` as valid complete statements under some permissive top-level
// production, so "close as soon as complete" is too aggressive.
// 
// This revision changes the stopping policy completely. We still open exactly
// one constrained span and keep all SQL inside it, but once inside we do not
// close immediately on the first complete prefix. Instead, we continue decoding
// until one of three conditions holds: (1) EOS is sampled, which is terminal;
// (2) we have reached the step budget; or (3) the parser says the prefix is
// complete and there is only a very small continuation set, indicating a likely
// natural stopping point rather than an early underspecified prefix. This aims
// to prevent trivial outputs like `SELECT` while still allowing termination on
// finished queries.
// 
// To improve token choice in broad SQL states, the strategy uses a two-mode
// constrained policy. In narrow states we trust `ConstrainedStep` directly. In
// wider states we first query a small set of high-logit valid candidates and
// explicitly boost them before sampling with `ChooseNextToken`, while heavily
// penalizing EOS unless the current SQL prefix is already complete. This keeps
// grammar validity but discourages premature termination and encourages the LM
// to commit to semantically rich schema-grounded continuations.
// 
// Finally, if the loop ends while still inside a constrained span and the
// current prefix is complete, we spend one final step to emit the closing `>>`.
// This preserves the required delimiters while avoiding the earlier behavior of
// closing too early.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, `OpenConstrainedSpan` enters
//   constrained mode with empty constrained content, and `parser.IsValidPrefix([])`
//   is a precondition. In the constrained decoding branch, if EOS is chosen we
//   do not modify `currentConstrainedOut`; otherwise we only append a token that
//   is parser-valid next, either because it came from `ConstrainedStep` or
//   because we explicitly checked `IsTokenValidNext` before `AppendConstrainedToken`.
//   In the close branch, `CloseConstrainedSpan` exits constrained mode, so the
//   implication is vacuous afterward.
// 
// suffix: After `OpenConstrainedSpan`, the constrained content is empty, so the
//   suffix relation holds trivially. In the decoding branch, EOS leaves both
//   `generated` and `currentConstrainedOut` unchanged; otherwise
//   `AppendConstrainedToken` appends the same token to the generated sequence
//   and the constrained suffix, preserving equality. In the close branch we are
//   no longer inside constrained mode, so the implication is vacuous.
// 
// progress: `OpenConstrainedSpan` appends one delimiter token and we increment
//   `steps` by 1, so `|generated| <= |generatedPrefix| + steps` remains true.
//   In each decoding iteration we increment `steps` by 1; if EOS is chosen then
//   `generated` does not grow, and if a normal token is appended then
//   `generated` grows by exactly one, so the bound is preserved. In the final
//   close branch, closing appends at most one delimiter token and also consumes
//   one step, preserving the same inequality.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var done := false;

while steps < maxSteps && !done
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    var validCountNow := helpers.ValidTokenCount(parser, currentConstrainedOut);

    if completeNow && validCountNow <= 1 {
      done := true;
    } else {
      var next := eosToken;
      if validCountNow <= 3 {
        var constrainedPrompt1 := prompt + generated[..|generated| - |currentConstrainedOut|];
        next := helpers.ConstrainedStep(lm, parser, constrainedPrompt1, currentConstrainedOut, eosToken);
      } else {
        var constrainedPrompt2 := prompt + generated[..|generated| - |currentConstrainedOut|];
        lm.GenerateLogits(constrainedPrompt2 + currentConstrainedOut);
        var cands := helpers.TopValidCandidates(lm, parser, constrainedPrompt2, currentConstrainedOut, 6, eosToken);
        helpers.BoostTokenLogits(lm, cands, 8.0);
        if !completeNow {
          helpers.PenalizeTokenLogits(lm, [eosToken], 100.0);
        }
        next := lm.ChooseNextToken();
        helpers.cost := helpers.cost + 1;
        var validNext := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
        if next != eosToken && !validNext {
          var constrainedPrompt3 := prompt + generated[..|generated| - |currentConstrainedOut|];
          next := helpers.ConstrainedStep(lm, parser, constrainedPrompt3, currentConstrainedOut, eosToken);
        }
      }

      steps := steps + 1;
      if next == eosToken {
        done := true;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

if insideConstrainedOut && steps < maxSteps {
  var completeEnd := parser.IsCompletePrefix(currentConstrainedOut);
  if completeEnd {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  }
}

cost := steps;

