Strategy: // CSD_RATIONALE_BEGIN
// The evaluation shows syntax is already perfect, so the bottleneck is semantic
// token choice inside the SQL span. The previous strategy delegated almost every
// in-span decision to a generic constrained step, which stayed grammatical but
// frequently followed bland high-probability SQL continuations and produced
// schema-misaligned junk such as malformed identifier chains.
//
// The revised strategy therefore keeps strict constrained decoding, but adds a
// lightweight schema-aware rescue policy inside the span. On each constrained
// step, it first asks whether the current prefix is in a narrow or dead-end
// region of the grammar. When the valid next-token set is small, it computes a
// short list of top valid candidates and explicitly boosts them before sampling;
// this preserves grammaticality while sharpening selection among schema-valid
// tables, columns, and operators that already score well under the LM. If the
// prefix ever drifts to an invalid continuation state, the strategy rolls back
// to the nearest valid constrained prefix and continues from there instead of
// compounding the error.
//
// Outside the span, the strategy no longer spends several free-form planning
// tokens. For Spider, the required output is a single SQL query, so extra
// unconstrained text mostly hurts accuracy. We therefore open the constrained
// span immediately when starting outside it, decode SQL under grammar control
// with candidate boosting and rollback, and close the span as soon as the parser
// reports a complete query. This directly targets the observed failure mode:
// keep syntax guarantees, but make in-span token choice more discriminative and
// recover quickly from bad partial paths.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the explicit open branch, OpenConstrainedSpan enters
//   constrained mode with an empty constrained prefix, which is parser-valid. In
//   the rollback branch, RollbackToValidPrefix returns a valid constrained
//   prefix, and RollbackConstrainedSpan updates generated/current together to
//   that valid prefix. In the close branch, CloseConstrainedSpan exits
//   constrained mode, so the implication is vacuous. In the constrained append
//   branch, either ConstrainedStep returns EOS and state is unchanged before
//   break, or AppendConstrainedToken extends the current constrained prefix with
//   a parser-valid next token, preserving validity.
//
// suffix: In the open branch, currentConstrainedOut becomes [] so the suffix
//   equality is immediate. In the rollback branch, RollbackConstrainedSpan
//   rewrites generated and currentConstrainedOut consistently to the rolled-back
//   constrained suffix, so the suffix relation is restored. In the close branch
//   we leave constrained mode, making the implication vacuous. In the append
//   branch, AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, preserving the suffix equality; the EOS sub-branch
//   changes neither sequence.
//
// progress: Initially generated == generatedPrefix and steps == 0. In the open
//   and close branches, exactly one token is appended and then steps is
//   incremented by 1, so |generated| grows by at most steps. In the rollback
//   branch, generated can only shrink or stay the same while steps is unchanged,
//   so the bound is preserved. In the constrained-step branch, steps increases
//   by 1; if EOS is returned then generated is unchanged, otherwise one token is
//   appended, so |generated| <= |generatedPrefix| + steps still holds.
//
// cost_accounting: cost stays 0 throughout the loop and is assigned only once at
//   the end as cost := steps, so the loop invariant cost == 0 is preserved. Each
//   decoding helper that consumes budget is matched by a step increment: open,
//   close, and constrained-step each contribute exactly 1. Query helpers,
//   boosting, dead-end detection, rollback queries, and rollback state updates do
//   not consume decoding budget, so they do not change steps. Hence returned
//   cost equals the accounted decoding steps and remains <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 3);
      if narrow {
        var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
        if |rolled| < |currentConstrainedOut| {
          var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
          var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
            parser, stablePrefix, generated, currentConstrainedOut
          );
          generated := rolledGenerated;
          currentConstrainedOut := rolledCurrent;
        } else {
          var constrainedPrompt0 := prompt + generated[..|generated| - |currentConstrainedOut|];
          lm.GenerateLogits(constrainedPrompt0 + currentConstrainedOut);
          var candidates0 := helpers.TopValidCandidates(lm, parser, constrainedPrompt0, currentConstrainedOut, 5, eosToken);
          helpers.BoostTokenLogits(lm, candidates0, 8.0);
          var next0 := helpers.ConstrainedStep(lm, parser, constrainedPrompt0, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if next0 == eosToken {
            break;
          } else {
            var appendedGenerated0, appendedInside0, appendedCurrent0 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next0
            );
            generated := appendedGenerated0;
            insideConstrainedOut := appendedInside0;
            currentConstrainedOut := appendedCurrent0;
          }
        }
      } else {
        var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        if validCount <= 8 {
          lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
          var candidates := helpers.TopValidCandidates(lm, parser, constrainedPrompt, currentConstrainedOut, 6, eosToken);
          helpers.BoostTokenLogits(lm, candidates, 8.0);
        } else {
          if validCount <= 16 {
            lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
            var candidates2 := helpers.TopValidCandidates(lm, parser, constrainedPrompt, currentConstrainedOut, 4, eosToken);
            helpers.BoostTokenLogits(lm, candidates2, 3.0);
          }
        }
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

