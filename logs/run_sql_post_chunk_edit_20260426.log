Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed mainly by trusting the model argmax too often
// inside SQL, which produced parser-valid but semantically weak continuations
// like repeated identifiers. For Spider, the constrained region is the whole
// answer that matters, so this revision makes the SQL span dominant rather than
// speculative: once `<<` is opened, every interior token is chosen by
// `ConstrainedStep`, never by raw argmax. This removes the high-frequency
// degenerate pattern where the model keeps emitting locally plausible IDs.
// 
// To reduce repetition and malformed long tails, the strategy also closes the
// constrained span as soon as the parser says the SQL prefix is complete, and
// it opens the span immediately with `OpenConstrainedSpan` instead of relying
// on long unconstrained chunks to discover structure. Outside the span, at most
// one unconstrained step is used, primarily to preserve flexibility if the
// prompt format expects some pre-span tokenization behavior; after that, any
// observed `<<` is normalized through `OpenConstrainedSpan`. The resulting
// state machine is simple: optional short unconstrained prelude, one fully
// grammar-constrained SQL segment, immediate closure on completeness, and stop
// on EOS.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, either we stay outside after one
//   unconstrained token (implication vacuous), stop on EOS, or detect/open a
//   span with `OpenConstrainedSpan`, which sets the active constrained content
//   to `[]`; the precondition gives `parser.IsValidPrefix([])`. In the
//   complete-prefix branch, `CloseConstrainedSpan` exits constrained mode, so
//   the implication is vacuous. In the active constrained decoding branch,
//   `ConstrainedStep` returns EOS or a parser-valid next token, and
//   `AppendConstrainedToken` preserves parser validity.
// suffix: In the outside branch, if we remain outside or stop on EOS the
//   implication is vacuous; if we open a span, `currentConstrainedOut := []`,
//   and the empty suffix of `generated` is `[]`. In the complete-prefix branch,
//   `CloseConstrainedSpan` resets constrained tracking, so the implication is
//   vacuous. In the active constrained decoding branch, `AppendConstrainedToken`
//   appends the same token to both `generated` and `currentConstrainedOut`,
//   preserving exact suffix equality.
// progress: In the outside branch, at most one token is appended by
//   `UnconstrainedStep` or `OpenConstrainedSpan`, and `steps` increases by 1.
//   In the complete-prefix branch, `CloseConstrainedSpan` adds at most one
//   token and `steps` increases by 1. In the active constrained decoding
//   branch, `ConstrainedStep` consumes one step; if it returns EOS we break
//   without appending, otherwise `AppendConstrainedToken` adds one token, so
//   `|generated| <= |generatedPrefix| + steps` is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var openedOnce := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !openedOnce {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedOnce := true;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if Contains(next, "<<") {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next2 := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next2 == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next2
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

