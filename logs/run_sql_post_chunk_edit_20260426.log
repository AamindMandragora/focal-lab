//   gives `parser.IsValidPrefix([])`. In the complete-prefix branch,
//   `CloseConstrainedSpan` exits the constrained mode, so the implication is
//   vacuous afterward. In the speculative constrained branch, we call
//   `AppendConstrainedToken` only after `IsTokenValidNext` says the argmax is a
//   valid continuation, so the new constrained prefix stays valid. In the
//   fallback constrained branch, `ConstrainedStep` returns either EOS (break)
//   or a parser-valid next token, and then `AppendConstrainedToken` preserves
//   validity.
// suffix: In the chunked unconstrained branch, if we stay outside the span the
//   implication is vacuous; if `stoppedOpen` is true, we have just ended on the
//   delimiter and set `currentConstrainedOut := []`, so the length-0 suffix of
//   `generated` equals `[]`. In the complete-prefix branch,
//   `CloseConstrainedSpan` appends the closing delimiter and resets the current
//   constrained fragment to `[]`, making the suffix condition vacuous. In both
//   constrained append branches, `AppendConstrainedToken` appends the same
//   token to `generated` and `currentConstrainedOut`, preserving exact suffix
//   equality.
// progress: In the chunked unconstrained branch, `UnconstrainedChunk` returns a
//   `stepsUsed` count and a `generated` whose length increases by at most that
//   many tokens; after `steps := steps + stepsUsed`, the bound
//   `|generated| <= |generatedPrefix| + steps` is preserved. In the
//   complete-prefix branch, at most one token (the close delimiter) is added
//   and `steps` increases by 1. In the speculative constrained append branch
//   and the fallback constrained branch, at most one token is appended to
//   `generated` and `steps` increases by 1; on EOS fallback we break without
//   appending, which also preserves the bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
