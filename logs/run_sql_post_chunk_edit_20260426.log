Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL generation benefits from spending most tokens in a single
// schema-constrained SQL span while still allowing a short unconstrained prefix
// before the span opens. We track: the full generated output (`generated`),
// whether we are currently inside the constrained SQL span
// (`insideConstrainedOut`), and the active SQL prefix inside that span
// (`currentConstrainedOut`).
//
// Outside the span, we use chunked unconstrained decoding so the model can
// quickly emit any free-form preamble until either EOS or the open delimiter
// "<<" appears. If the chunk does not open a span and there is still budget, we
// proactively open one, because this task ultimately wants a single SQL query.
// Inside the span, we consult parser structure: if the SQL prefix is complete
// we close immediately; if the parser reports a narrow frontier, we use the
// hard constrained helper; otherwise we softly bias toward top valid SQL
// continuations and sample, appending only parser-valid samples.
// This tracked state lets the parser validate only the SQL content between
// delimiters while the full output still contains the delimiters themselves.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained-chunk branch, we either remain outside
//   the span (implication vacuous), or we enter the span by setting
//   currentConstrainedOut := [], which is valid by the method precondition
//   parser.IsValidPrefix([]). In the proactive-open branch we likewise append
//   "<<" and set currentConstrainedOut := []. In the complete-prefix branch,
//   CloseConstrainedSpan sets insideConstrainedOut to false, so the implication
//   becomes vacuous. In the narrow-frontier branch, ConstrainedStep is the
//   constrained decoder; on non-EOS output we append via AppendConstrainedToken,
//   which preserves parser validity. In the soft-bias branch, we call
//   AppendConstrainedToken only when IsTokenValidNext says the sampled token is
//   valid; the !valid sub-branch leaves state unchanged.
// suffix: Outside the span, the invariant is vacuous. When a chunk stops on
//   "<<" or when we proactively open, we set currentConstrainedOut := [], so the
//   required suffix is the empty suffix of generated. CloseConstrainedSpan
//   atomically appends the close delimiter and resets currentConstrainedOut to
//   [], preserving the implication. In both constrained append branches,
//   AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, so the suffix equality is maintained; the !valid
//   soft-bias sub-branch leaves both sequences unchanged.
// progress: In the chunk branch, UnconstrainedChunk returns stepsUsed tokens at
//   most, and we update steps := steps + stepsUsed, so
//   |generated| <= |generatedPrefix| + steps is preserved. In the proactive-open,
//   close, narrow-frontier, and valid soft-bias branches, exactly one token is
//   appended and steps increases by 1. In the EOS and !valid soft-bias
//   sub-branches, generated does not grow after the step increment, so the bound
//   still holds.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpen, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else if steps < maxSteps {
      generated := generated + ["<<"];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
      steps := steps + 1;
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 3);
      if narrow {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated1, appendedInside1, appendedCurrent1 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated1;
          insideConstrainedOut := appendedInside1;
          currentConstrainedOut := appendedCurrent1;
        }
      } else {
        var candidates := helpers.TopValidCandidates(
          lm, parser, constrainedPrompt, currentConstrainedOut, 4, eosToken
        );
        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
        helpers.BoostTokenLogits(lm, candidates, 8.0);
        var next := lm.ChooseNextTokenUnconstrained();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
          if valid {
            var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated2;
            insideConstrainedOut := appendedInside2;
            currentConstrainedOut := appendedCurrent2;
          }
        }
      }
    }
  }
}

cost := steps;

