Strategy: // CSD_RATIONALE_BEGIN
// The failure pattern `SELECT <id> .!!!` indicates the prior strategy was too
// myopic inside SQL: pure `ConstrainedStep` kept every token grammar-valid, but
// it did not sufficiently prefer globally useful continuations when the grammar
// allowed many locally valid options. On Spider, this often shows up after a
// table alias or identifier prefix, where several parser-valid next tokens
// exist and the model drifts into low-value punctuation or repeated fragments.
// 
// This revision keeps the whole SQL body inside one constrained span, but adds
// a lightweight recovery policy for ambiguous parser states. When the active
// SQL prefix has very few valid continuations, we trust `ConstrainedStep`.
// When the parser reports a wider branching factor, we first ask whether the
// current prefix is near a dead end; if so, we roll back to the longest valid
// stable prefix inside the constrained span before continuing. Otherwise we
// still use `ConstrainedStep`, but only after this dead-end check. This
// directly targets the observed bad tails: instead of extending a brittle
// prefix like `SELECT t .`, we retract to a stable valid prefix and let the
// constrained decoder choose again.
// 
// Outside the span, we no longer spend unconstrained steps on content search.
// We open the constrained span immediately, decode SQL under grammar control,
// close it immediately once complete, and then stop. This matches the task
// format, preserves the required `<< >>` delimiters, and avoids wasting budget
// on irrelevant unconstrained text after the SQL query is done.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the initial outside branch, `OpenConstrainedSpan` enters
//   constrained mode with empty constrained content, and `parser.IsValidPrefix([])`
//   is given. In the complete-prefix branch, `CloseConstrainedSpan` exits
//   constrained mode, so the implication becomes vacuous. In the rollback
//   branch, `RollbackToValidPrefix` returns a valid constrained prefix and
//   `RollbackConstrainedSpan` installs exactly that prefix, preserving parser
//   validity. In the decoding branch, either EOS causes a break, or
//   `AppendConstrainedToken` extends the constrained prefix with a parser-valid
//   token returned by `ConstrainedStep`.
// 
// suffix: After `OpenConstrainedSpan`, the constrained content is `[]`, so the
//   tracked suffix property holds trivially. After `CloseConstrainedSpan`, we
//   are outside constrained mode, so the implication is vacuous. In the
//   rollback branch, `RollbackConstrainedSpan` rewrites `generated` so that its
//   active constrained suffix is exactly the rolled-back valid prefix. In the
//   decoding branch, `AppendConstrainedToken` appends the same token to both
//   `generated` and `currentConstrainedOut`, preserving suffix equality.
// 
// progress: Opening the span appends at most one token and increments `steps`
//   by 1. Closing the span appends at most one token and increments `steps` by
//   1. The rollback branch does not increase `|generated|`, but it increments
//   `steps` by 1, so the upper bound still holds. In the decoding branch,
//   `ConstrainedStep` consumes one step; if it returns EOS we append nothing
//   and break, otherwise `AppendConstrainedToken` adds one token, so
//   `|generated| <= |generatedPrefix| + steps` is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var done := false;

while steps < maxSteps && !done
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      if steps + 1 <= maxSteps {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
      }
      done := true;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      if !narrow && validCount > 2 && |currentConstrainedOut| > 0 {
        var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
        if |rolled| < |currentConstrainedOut| {
          var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
          var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
            parser, stablePrefix, generated, currentConstrainedOut
          );
          generated := rolledGenerated;
          currentConstrainedOut := rolledCurrent;
        }
        steps := steps + 1;
      } else {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          done := true;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

