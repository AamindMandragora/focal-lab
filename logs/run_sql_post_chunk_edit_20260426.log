Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy let the model spend tokens outside the SQL grammar and
// also used a soft-bias branch inside the constrained span. On Spider, that led
// to many parser-valid but semantically bad continuations and malformed-looking
// delimiter interactions near the end of the query. The revised strategy makes
// the task much more SQL-centric: if we are outside a constrained span, we open
// one immediately; once inside, every decoding step is grammar-constrained.
//
// Concretely, the method now aims to emit exactly one constrained SQL segment
// delimited by "<<" and ">>". There is no unconstrained chunking and no soft
// sampling from arbitrary tokens while inside the SQL span. Instead, while the
// SQL prefix is incomplete, we repeatedly call the constrained helper so that
// every emitted token is parser-approved. As soon as the parser says the SQL
// prefix is complete, we spend one step to close the span and stop. This removes
// the main failure mode where unconstrained or weakly constrained choices
// produced low-accuracy SQL despite perfect syntax.
//
// The state remains simple and aligned with the specification: `generated` holds
// the full output including delimiters, while `currentConstrainedOut` tracks
// only the SQL content between delimiters. The strategy prefers reliability over
// stylistic freedom because Spider expects a single SQL query as the answer.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open-span branch, OpenConstrainedSpan sets
//   currentConstrainedOut to [] while entering constrained mode, and [] is a
//   valid parser prefix by precondition. In the complete-prefix branch,
//   CloseConstrainedSpan exits constrained mode, so the implication becomes
//   vacuous. In the constrained-step branch, if the sampled token is not EOS we
//   append it only via AppendConstrainedToken, which preserves parser validity;
//   if it is EOS, we break without changing constrained state.
//
// suffix: In the open-span branch, after appending the open delimiter we set
//   currentConstrainedOut := [], and the empty sequence is the suffix required by
//   the invariant. In the complete-prefix branch, CloseConstrainedSpan exits
//   constrained mode, so the suffix implication is vacuous afterward. In the
//   constrained-step branch, AppendConstrainedToken appends the same token to
//   both `generated` and `currentConstrainedOut`, preserving the suffix
//   equality; the EOS sub-branch leaves both unchanged before termination.
//
// progress: Initially `generated == generatedPrefix` and `steps == 0`. In the
//   open-span and close-span branches, exactly one token is added and we also
//   increment `steps` by 1, so the bound is preserved. In the constrained-step
//   branch, we increment `steps` by 1; if the token is appended, `generated`
//   grows by one as well, and if the token is EOS then `generated` does not grow,
//   so in either case `|generated| <= |generatedPrefix| + steps` remains true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

