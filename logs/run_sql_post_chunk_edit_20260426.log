Strategy: // CSD_RATIONALE_BEGIN
// The prior strategy still trusted local LM logits too much inside the SQL span.
// On Spider with a schema-narrowed SQL grammar, that produced many syntax-valid
// but semantically implausible continuations such as malformed identifier/punct
// runs. The evaluation pattern ("SELECT <id> .!!!") indicates that once inside
// SQL, even choosing among parser-valid top candidates by raw logit is too weak:
// the grammar may allow many locally valid tokens, but the benchmark strongly
// prefers a conservative left-to-right SQL derivation.
//
// This revision therefore replaces the mixed policy with a parser-dominant one.
// We open the constrained span immediately, then while inside it we almost
// always use ConstrainedStep directly. That helper is the safest available
// schema-aware decoding primitive because it consults the parser at every step.
// We only add one structural control around it: if the current constrained
// prefix is already complete, we close the span immediately instead of asking
// for another token. This directly targets the observed overgeneration after a
// valid query has already been formed.
//
// To reduce the chance of getting stuck in a bad but still valid local branch,
// we also add a rollback escape hatch. When the parser state is very narrow and
// the constrained prefix has positive length, we compute a rolled-back valid
// prefix and, if it is strictly shorter, replace the active constrained suffix
// with that shorter valid prefix before continuing. This is a conservative
// repair step: it never invents unconstrained text, keeps the parser-validity
// invariant, and gives subsequent ConstrainedStep calls a cleaner state.
//
// The resulting strategy is intentionally simple and schema-grammar-first:
// open immediately, repeatedly take parser-constrained steps, close as soon as
// complete, and occasionally roll back from narrow dead ends. This is designed
// to improve exact SQL generation quality rather than merely preserve syntax.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open-span branch, OpenConstrainedSpan sets the active
//   constrained content to [] while entering constrained mode, and [] is a
//   valid parser prefix by precondition. In the close branch,
//   CloseConstrainedSpan exits constrained mode, so the implication is vacuous.
//   In the rollback branch, RollbackToValidPrefix returns a valid parser prefix,
//   and RollbackConstrainedSpan updates currentConstrainedOut to exactly that
//   rolled-back prefix, preserving validity. In the constrained-step branch, if
//   ConstrainedStep returns EOS we break without changing constrained state;
//   otherwise AppendConstrainedToken appends a parser-valid next token selected
//   for the current valid prefix, so validity is preserved.
//
// suffix: Opening a span initializes currentConstrainedOut to [], so the suffix
//   equality is immediate. Closing a span sets insideConstrainedOut to false, so
//   the implication becomes vacuous. In the rollback branch,
//   RollbackConstrainedSpan rewrites generated and currentConstrainedOut
//   together so that the constrained content is again exactly the suffix of
//   generated. In the constrained-step branch, AppendConstrainedToken appends
//   the same token to generated and currentConstrainedOut, preserving the
//   suffix relation; the EOS sub-branch changes neither, so the relation also
//   persists there.
//
// progress: Opening the span appends one token and increments steps by 1, so
//   |generated| grows by at most the step increase. Closing similarly appends
//   at most one token and increments steps by 1. The rollback branch increments
//   no steps and only shortens or preserves generated, so the upper bound by
//   |generatedPrefix| + steps is maintained. In the constrained-step branch we
//   increment steps by 1; if EOS is returned, generated is unchanged, and if a
//   token is appended then generated grows by exactly one, so both sub-branches
//   preserve the bound.
//
// cost accounting: cost is initialized to 0 and never modified in the loop, so
//   the invariant cost == 0 is preserved in every branch. The only loop-control
//   counter is steps, which increases by at most 1 per decoding action and is
//   bounded by maxSteps via the loop guard and invariant. Assigning cost :=
//   steps after the loop therefore yields cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var didRollback := false;
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      if narrow && 0 < |currentConstrainedOut| {
        var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
        if |rolled| < |currentConstrainedOut| {
          var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
          var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
            parser, stablePrefix, generated, currentConstrainedOut
          );
          generated := rolledGenerated;
          currentConstrainedOut := rolledCurrent;
          didRollback := true;
        }
      }
      if !didRollback {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

