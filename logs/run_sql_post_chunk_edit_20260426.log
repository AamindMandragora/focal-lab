Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL often benefits from staying unconstrained for boilerplate
// narration/preamble, then switching into grammar-checked decoding once a SQL-
// looking region begins. This strategy tracks the full generated output in
// `generated`, whether we are currently inside a constrained SQL span in
// `insideConstrainedOut`, and the active SQL substring itself in
// `currentConstrainedOut`.
// 
// Outside a span, we use chunked unconstrained decoding for efficiency, but we
// stop early on EOS or on the delimiter token "<<". We also support eager span
// entry: if the model's current argmax token contains "SELECT" or the open-span
// token "<<" is within a modest logit margin of the argmax, we open a
// constrained span immediately. This is meant to capture the point where the
// answer transitions into the actual SQL query.
// 
// Inside a span, we keep the SQL prefix parser-valid at all times. When the
// current constrained prefix is complete, we close the span with the dedicated
// helper. Otherwise, we first try a speculative fast path: if the model's
// argmax token is parser-valid, append it directly. If not, we fall back to the
// parser-aware constrained decoder. This tracked state ensures that the active
// SQL substring always remains a valid grammar/schema prefix and stays aligned
// with the suffix of the full generated output.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, we either remain outside
//   the span (implication vacuous) or enter a span only when we append "<<"
//   and set currentConstrainedOut := [], which is valid by the method
//   precondition parser.IsValidPrefix([]). In the eager-open branch we likewise
//   append "<<" and initialize the constrained prefix to []. In the complete-
//   prefix branch, CloseConstrainedSpan sets insideConstrainedOut to false, so
//   the implication is vacuous afterward. In the speculative constrained branch
//   we call AppendConstrainedToken only after IsTokenValidNext returned true;
//   in the fallback branch ConstrainedStep provides a valid next token (or EOS,
//   which breaks), so the appended constrained prefix remains valid.
// suffix: In both span-entry branches, after appending "<<", we set
//   currentConstrainedOut := [], and the length-0 suffix of generated equals
//   []. In the unconstrained-outside case where no span opens, the implication
//   is vacuous because insideConstrainedOut stays false. CloseConstrainedSpan
//   atomically appends the close delimiter and resets currentConstrainedOut to
//   [], so the suffix condition holds trivially. In both constrained append
//   branches, AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, preserving suffix equality.
// progress: In the chunk branch, UnconstrainedChunk guarantees the new
//   generated length increases by at most stepsUsed, and we update
//   steps := steps + stepsUsed, so |generated| <= |generatedPrefix| + steps is
//   preserved. In the eager-open branch we append exactly one token ("<<") and
//   increment steps by 1. In the close-span branch we append at most one token
//   and increment steps by 1. In the constrained append and constrained
//   fallback branches we append at most one token and increment steps by 1; on
//   EOS break, generated is unchanged while steps has already increased by 1,
//   so the bound still holds.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
    var openLogit := helpers.GetTokenLogit(lm, "<<");

    if Contains(argmax, "SELECT") || openLogit >= argmaxLogit - 4.0 {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var chunkBudget: nat := maxSteps - steps;
      var chunkedG, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
        lm, prompt, generated, chunkBudget, "<<", eosToken
      );
      generated := chunkedG;
      steps := steps + stepsUsed;
      if stoppedEos {
        break;
      } else if stoppedOpen {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);
      if argmax != eosToken && argmaxValid {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

