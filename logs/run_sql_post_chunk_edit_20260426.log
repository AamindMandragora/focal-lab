Strategy: // CSD_RATIONALE_BEGIN
// The prior strategy over-corrected toward grammar purity: it opened the SQL
// span immediately and then forced every token through the constrained decoder.
// That achieved perfect syntax, but Spider accuracy collapsed because the model
// never got to "think in natural language" before committing to SQL, and the
// constrained helper often followed generic high-probability SQL patterns such
// as `SELECT count ( * )` rather than schema- and question-specific queries.
//
// The revised strategy keeps the required `<< ... >>` structure but changes when
// constraint is applied. Outside a constrained span, it first lets the model
// generate a short unconstrained reasoning/planning prefix, stopping early if it
// wants to open a span or emit EOS. This preserves the model's ability to absorb
// the schema/question context and form a plan in free text. If no span is opened
// during that short chunk, the strategy opens one explicitly so that output still
// contains `<< >>`.
//
// Once inside the constrained span, decoding is still grammar-safe, but no extra
// soft-bias logic is added: every SQL token comes from the constrained helper,
// and when the parser reports a complete SQL query we immediately close the span.
// This combination targets the observed failure mode directly: use a brief
// unconstrained prelude to improve semantic accuracy, then use strict grammar
// control only for the SQL itself.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained-chunk branch we stay outside the
//   constrained span, so the implication is vacuous; if the chunk stops on an
//   open-span token then the helper returns with an empty active constrained
//   prefix, which is valid by precondition. In the explicit open branch,
//   OpenConstrainedSpan likewise enters constrained mode with [] and preserves
//   validity. In the close branch, CloseConstrainedSpan exits constrained mode,
//   so the implication becomes vacuous. In the constrained-step branch, if the
//   helper returns EOS we leave state unchanged before breaking; otherwise
//   AppendConstrainedToken extends the constrained prefix with a parser-valid
//   token, preserving parser validity.
//
// suffix: During unconstrained chunking while outside constrained mode, the
//   suffix invariant is vacuous; if the chunk ends by opening a span, the active
//   constrained prefix is [] so the required suffix equality holds trivially. In
//   the explicit open branch, the same reasoning applies. In the close branch we
//   leave constrained mode, making the implication vacuous. In the constrained
//   append branch, AppendConstrainedToken appends the same token to both
//   `generated` and `currentConstrainedOut`, preserving the suffix relation; the
//   EOS sub-branch changes neither sequence.
//
// progress: Initially `generated == generatedPrefix` and `steps == 0`. In the
//   unconstrained-chunk branch, the helper returns `stepsUsed` and appends at
//   most that many tokens, so after `steps := steps + stepsUsed` we still have
//   `|generated| <= |generatedPrefix| + steps`. In the explicit open and close
//   branches, one token is appended and `steps` increases by 1. In the
//   constrained-step branch, `steps` increases by 1; if EOS is returned then
//   `generated` is unchanged, otherwise one token is appended via
//   AppendConstrainedToken, so the bound is preserved in either sub-branch.
//
// cost_accounting: `cost` is kept at 0 throughout the loop and assigned only at
//   the end as `cost := steps`, so the loop invariant `cost == 0` is preserved
//   by every branch. Every helper that can consume decoding budget is matched by
//   the corresponding increment to `steps`: `UnconstrainedChunk` by `stepsUsed`,
//   and `OpenConstrainedSpan`, `CloseConstrainedSpan`, and `ConstrainedStep` by
//   exactly 1. Therefore the returned `cost` equals the total loop-accounted
//   steps and is bounded by `maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var didPrelude := false;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !didPrelude {
      var remaining := maxSteps - steps;
      var chunkLimit := if remaining < 6 then remaining else 6;
      if chunkLimit == 0 {
      } else {
        var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
          lm, prompt, generated, chunkLimit, "<<", eosToken
        );
        generated := chunkGenerated;
        steps := steps + stepsUsed;
        didPrelude := true;
        if stoppedOnEos {
          break;
        } else {
          if stoppedOnOpenSpan {
            insideConstrainedOut := true;
            currentConstrainedOut := [];
          } else {
            if steps < maxSteps {
              var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
              generated := openedGenerated;
              insideConstrainedOut := openedInside;
              currentConstrainedOut := openedCurrent;
              steps := steps + 1;
            }
          }
        }
      }
    } else {
      var openedGenerated2, openedInside2, openedCurrent2 := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated2;
      insideConstrainedOut := openedInside2;
      currentConstrainedOut := openedCurrent2;
      steps := steps + 1;
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

