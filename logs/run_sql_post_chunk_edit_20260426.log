Strategy: {
  // CSD_RATIONALE_BEGIN
  // The prior revision fixed syntax but still under-generated: the dominant
  // failure preview `SELECT <id> FROM <id>` shows that waiting for a "natural"
  // completion point inside the constrained span is still too eager for Spider.
  // Many SQL prefixes remain parser-complete long before the intended query is
  // semantically finished, so any completion-sensitive stopping rule tends to
  // truncate after a short skeleton.
  //
  // This strategy therefore switches to a much simpler high-recall policy:
  // open one constrained span immediately, keep every SQL token inside it, and
  // once inside never close early based on parser completeness. Instead, we
  // decode constrained tokens until either EOS is produced or the step budget is
  // exhausted. Only after the loop, if we are still inside a constrained span
  // and the parser says the SQL prefix is complete, do we spend one final step
  // to emit the closing delimiter. This directly targets the observed truncation
  // failure by treating parser completeness as a prerequisite for final closure,
  // not as a reason to stop generating content.
  //
  // Token selection is also simplified. Every constrained step uses
  // `ConstrainedStep`, which guarantees grammar-valid continuation while letting
  // the LM choose among valid SQL tokens. This avoids the earlier custom
  // candidate-boosting logic, which added complexity and extra opportunities for
  // short high-probability skeletons without evidence of accuracy gains.
  //
  // To ensure the evaluator sees `<< >>`, we reserve one step for closure when
  // possible: the main loop runs while `steps + 1 < maxSteps`, so if any budget
  // remains after opening/content generation, one final step is available for
  // `CloseConstrainedSpan`. If the budget is too small to both generate content
  // and close, we still prioritize validity and return the longest constrained
  // prefix we could produce.
  // CSD_RATIONALE_END
  // CSD_PROOF_SKETCH_BEGIN
  // parser_validity: In the outside branch, `OpenConstrainedSpan` enters
  //   constrained mode with empty constrained content, and `parser.IsValidPrefix([])`
  //   holds by precondition. In the inside branch, `ConstrainedStep` returns either
  //   EOS or a parser-valid next token; on EOS the constrained state is unchanged,
  //   and on non-EOS `AppendConstrainedToken` preserves validity. In the final close
  //   branch, `CloseConstrainedSpan` exits constrained mode, so the implication is vacuous.
  //
  // suffix: After `OpenConstrainedSpan`, the constrained content is empty, so the
  //   generated suffix equal to `currentConstrainedOut` holds trivially. In the
  //   constrained branch, EOS leaves both values unchanged; non-EOS appending uses
  //   `AppendConstrainedToken`, which extends both the generated text and constrained
  //   suffix by the same token. After closing, we are outside constrained mode, so
  //   the suffix implication is vacuous.
  //
  // progress: Opening the constrained span appends one delimiter token and we also
  //   increment `steps` by 1, preserving `|generated| <= |generatedPrefix| + steps`.
  //   Each constrained non-EOS step appends at most one token and increments `steps`
  //   by 1, so the bound is preserved. EOS appends nothing and still increments
  //   `steps` by 1, which only weakens the right-hand side. The final close branch
  //   appends at most one delimiter token and also increments `steps` by 1.
  //
  // cost accounting: `steps` is the sole returned cost. Every helper that consumes
  //   one decoding step (`OpenConstrainedSpan`, `ConstrainedStep`, `CloseConstrainedSpan`)
  //   is paired with exactly one `steps := steps + 1`. `AppendConstrainedToken` does
  //   not bump helper cost and is paired with no extra step increment. Thus `cost := steps`
  //   at the end soundly upper-bounds by `maxSteps`.
  // CSD_PROOF_SKETCH_END
  generated := generatedPrefix;
  insideConstrainedOut := insideConstrained;
  currentConstrainedOut := currentConstrained;
  cost := 0;

  var steps := 0;
  var stopped := false;

  while steps + 1 < maxSteps && !stopped
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
    invariant |generated| <= |generatedPrefix| + steps
    invariant cost == 0
    decreases maxSteps - steps
  {
    if !insideConstrainedOut {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var stableGenerated := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, prompt + stableGenerated, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        stopped := true;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }

  if insideConstrainedOut && steps < maxSteps {
    var completeEnd := parser.IsCompletePrefix(currentConstrainedOut);
