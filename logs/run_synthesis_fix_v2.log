Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy was too slow because it allowed long unconstrained prose
// before and around constrained spans, and it sometimes left a span open. This
// revision makes decoding aggressively span-oriented:
// 1) Outside a constrained span, use chunked unconstrained decoding with a very
//    small chunk limit so we can react quickly to "<<", EOS, or to outputs that
//    already contain delimiters.
// 2) If the model emits any token containing "<<", immediately enter constrained
//    mode using OpenConstrainedSpan so arithmetic can start right away.
// 3) Inside a constrained span, always use strict parser-guided constrained
//    decoding (ConstrainedStep), not soft decoding, to avoid wandering and
//    rollback loops.
// 4) As soon as the parser says the arithmetic prefix is complete, immediately
//    close with ">>". This directly addresses unterminated constrained segments.
// 5) If only one decoding step remains while inside a constrained span, prefer
//    closing a complete span rather than risking exhaustion with an open span.
// These changes trade some flexibility for much faster, more reliable production
// of closed << >> arithmetic computations.
// CSD_RATIONALE_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
