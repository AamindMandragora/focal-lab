Strategy: // CSD_RATIONALE_BEGIN
// This strategy tracks the full generated output, whether decoding is currently
// inside a constrained arithmetic span, and the current constrained substring
// between << and >>. Outside constrained spans it uses chunked unconstrained
// decoding as the default fast path, stopping early if it encounters << or EOS.
// Inside constrained spans it uses parser-guided decoding so arithmetic content
// remains a valid prefix, closing the span only when the parser says the current
// constrained prefix is complete. It also uses dead-end detection to switch to
// stricter constrained decoding when the valid continuation set is narrow, which
// helps keep step-by-step computations inside << >> well-formed.
// CSD_RATIONALE_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkLimit := maxSteps - steps;
    if chunkLimit > 8 {
      chunkLimit := 8;
    }
    var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkLimit, "<<", eosToken
    );
    generated := chunkGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else {
      if stoppedOnOpenSpan {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      if narrow {
        var next := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var next, isValid := helpers.SoftConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, 2.0, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          if isValid {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
          } else {
            var repairedGenerated, repairedCurrent := helpers.RollbackConstrainedSpan(
              parser, stablePrefix, generated, currentConstrainedOut
            );
            generated := repairedGenerated;
            currentConstrainedOut := repairedCurrent;
            if parser.IsValidPrefix(currentConstrainedOut) {
              insideConstrainedOut := true;
            } else {
              insideConstrainedOut := false;
              currentConstrainedOut := [];
            }
          }
        }
      }
    }
  }
}

cost := steps;

