    if chunkLimit > 2 {
      chunkLimit := 2;
    }
    var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkLimit, "<<", eosToken
    );
    generated := chunkGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else {
      if stoppedOnOpenSpan {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(
          lm, generated
        );
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
      } else {
        if |generated| > 0 {
          var lastTok := generated[|generated| - 1];
          if Contains(lastTok, "<<") {
