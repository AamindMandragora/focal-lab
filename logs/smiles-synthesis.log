Strategy: // CSD_RATIONALE_BEGIN
// This strategy tracks the visible output `generated`, whether generation is
// currently inside a chemistry answer span, and the active constrained span
// contents `currentConstrainedOut`. Outside a span it generates freely until it
// either observes the visible opening delimiter "<<" or, if a chemistry cue has
// recently appeared, explicitly opens a span. Inside a span it uses parser-hard
// constrained decoding, with caller-supplied token groups as soft preferences,
// and closes the span as soon as the parser reports a complete answer.
// The tracked state supports valid molecular-string generation because the
// parser remains the authority over every token emitted inside << >>, while the
// cue-tracking only affects when to begin the constrained region where the
// chemistry answer is expected.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span free-generation branch, the invariant is
//   vacuous unless we observe next == "<<"; in that case we set
//   currentConstrainedOut := [], which is a valid prefix by the precondition
//   parser.IsValidPrefix([]). In the explicit-open branch, OpenConstrainedSpan
//   also returns an empty constrained prefix, so validity holds immediately
//   after entering the span. In the complete-prefix branch,
//   CloseConstrainedSpan sets insideConstrainedOut to false, making the
//   implication vacuous. In the active constrained branch,
//   AdaptiveConstrainedStep returns either EOS or a parser-valid next token;
//   on the non-EOS path, AppendConstrainedToken preserves
//   parser.IsValidPrefix(currentConstrainedOut).
// progress: In the free-generation branch, UnconstrainedStep consumes one token
//   step and we append at most one visible token, so
//   |generated| <= |generatedPrefix| + steps is preserved after steps := steps+1.
//   In the explicit-open branch, OpenConstrainedSpan consumes one token step for
//   the forced delimiter and appends exactly that delimiter, so the same linear
//   bound is preserved. In the close branch, CloseConstrainedSpan consumes one
//   step and appends at most the visible close delimiter, again preserving the
//   bound. In the constrained-token branch, AdaptiveConstrainedStep consumes one
//   step; EOS appends nothing, and the non-EOS path appends exactly one token
//   via AppendConstrainedToken, so visible growth is at most the consumed
//   budget.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var chemistryCueSeen: bool := false;
var lastTok, foundLast := helpers.LastTokenBefore(generated, ">>");
if foundLast {
  if lastTok == ":" || lastTok == "SMILES" || lastTok == "smiles" || lastTok == "=" {
    chemistryCueSeen := true;
  }
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if chemistryCueSeen {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      chemistryCueSeen := false;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          chemistryCueSeen := false;
        } else if next == ":" || next == "SMILES" || next == "smiles" || next == "=" {
          chemistryCueSeen := true;
        }
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    chemistryCueSeen := false;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

