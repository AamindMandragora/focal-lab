Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy repeatedly reopened tiny visible spans and almost never
// left the final answer in the last visible span, producing unmatched close
// delimiters and many invalid chemistry strings. The measured weak point is
// therefore not parser-hard token validity inside a span, but over-eager
// re-entry into new spans after one span completes.
// This revision keeps the evidence-backed ingredients that helped: mostly free
// generation outside, explicit span entry, hard constrained progression inside,
// group-aware bias, and immediate close on complete prefixes. The single causal
// change is span-entry policy: open at most one answer span during this call,
// and after a completed span stop instead of resuming free generation that can
// churn into many extra spans. To reduce token-budget exhaustion inside the
// chemistry core while preserving parser validity, the inside branch uses
// bounded symbol decoding when the parser is wide and one-token adaptive
// constrained decoding when the parser is narrow.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span free-generation branch, the invariant is
//   vacuous unless we observe next == "<<"; then we call
//   EnterObservedConstrainedSpan, which sets currentConstrainedOut := [] and so
//   yields a parser-valid constrained prefix. In the explicit-open branch,
//   OpenConstrainedSpan likewise enters with the empty constrained prefix, valid
//   by parser.IsValidPrefix([]). In the close-and-stop branch,
//   CloseConstrainedSpan sets insideConstrainedOut to false, so the implication
//   becomes vacuous before the loop exits. In the narrow constrained branch,
//   AdaptiveConstrainedStep returns EOS or a parser-valid next token; on the
//   non-EOS path, AppendConstrainedToken preserves parser validity. In the wide
//   constrained-symbol branch, ConstrainedSymbolInGenerated returns a longest
//   parser-valid accepted prefix, so assigning currentConstrainedOut := symbolOut
//   preserves parser validity.
// progress: In the free-generation branch, UnconstrainedStep consumes one token
//   step and appends at most one visible token, so after steps := steps + 1 the
//   bound |generated| <= |generatedPrefix| + steps is preserved. In the
//   explicit-open branch, OpenConstrainedSpan consumes one token step and
//   appends exactly the visible opener, preserving the linear bound. In the
//   close-and-stop branch, CloseConstrainedSpan consumes one token step and
//   appends at most the visible close delimiter, again preserving the bound. In
//   the narrow constrained branch, AdaptiveConstrainedStep consumes one token
//   step; EOS appends nothing and the non-EOS path appends exactly one token
//   via AppendConstrainedToken, so visible growth is at most the consumed
//   budget. In the wide constrained-symbol branch, ConstrainedSymbolInGenerated
//   consumes stepsUsed token steps and may accept only a prefix of what was
//   generated; therefore visible growth is at most stepsUsed, which preserves
//   |generated| <= |generatedPrefix| + steps after steps := steps + stepsUsed.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var chemistryCueSeen: bool := false;
var spanOpenedThisCall: bool := insideConstrained;
var completedSpanThisCall: bool := false;
var lastTok, foundLast := helpers.LastTokenBefore(generated, ">>");
if foundLast {
  if lastTok == ":" || lastTok == "SMILES" || lastTok == "smiles" || lastTok == "=" {
    chemistryCueSeen := true;
  }
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if completedSpanThisCall {
    break;
  } else if !insideConstrainedOut {
    if !spanOpenedThisCall && chemistryCueSeen {
