Strategy: // CSD_RATIONALE_BEGIN
// The last revision regressed because it chunked outside-span generation and
// force-opened spans aggressively, which produced many tiny or repeated visible
// spans and much worse syntax. The best prior behavior came from the simpler
// shape: one-token unconstrained generation outside, context-triggered opening,
// and token-by-token constrained decoding inside.
// 
// This revision therefore returns to that successful outer-loop structure and
// makes only one targeted inside-span change: early constrained tokens use
// GroupBoostedConstrainedStep to better exploit caller-supplied chemistry token
// groups when the answer is just starting, then switch back to
// AdaptiveConstrainedStep for the rest of the span. This preserves the strong
// syntax behavior of the earlier strategy while reintroducing the small
// chemistry-aware bias that helped a later attempt without repeating the
// chunking/forced-open failure mode.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span free-token branch, either we stay
//   outside, or we observe next == "<<" and call EnterObservedConstrainedSpan,
//   which sets currentConstrainedOut := [], valid by parser.IsValidPrefix([]).
//   In the context-triggered open branch, OpenConstrainedSpan also enters with
//   an empty constrained prefix, so the invariant holds. In the complete-prefix
//   branch, CloseConstrainedSpan exits constrained mode and clears
//   currentConstrainedOut, making the implication vacuous. In the active
//   constrained branch, both GroupBoostedConstrainedStep and
//   AdaptiveConstrainedStep return EOS or a parser-valid next token; on the
//   non-EOS path, AppendConstrainedToken preserves parser validity.
// progress: In the outside-span free-token branch, UnconstrainedStep consumes
//   1 token-step; EOS appends nothing and a non-EOS token appends exactly one
//   visible token, so after steps := steps + 1 we still have
//   |generated| <= |generatedPrefix| + steps. In the context-triggered open
//   branch and the close branch, the helper consumes exactly 1 token-step and
//   appends at most one visible delimiter, preserving the bound. In the active
//   constrained branch, the selected constrained-step helper consumes 1
//   token-step; EOS appends nothing and a non-EOS token is appended once via
//   AppendConstrainedToken, so visible growth is at most the consumed budget.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var chemistryArmed: bool := false;
var recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if chemistryArmed {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      chemistryArmed := false;
      recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          var enteredGenerated, enteredInside, enteredCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
          generated := enteredGenerated;
          insideConstrainedOut := enteredInside;
          currentConstrainedOut := enteredCurrent;
          chemistryArmed := false;
        } else {
          recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");
          if next == "SMILES" || next == "smiles" || next == "molecule" || next == "molecular" || |recentAfterAnswer| > 0 {
            chemistryArmed := true;
          }
        }
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
    chemistryArmed := false;
    recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");
  } else {
    var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
    var constrainedPrompt := prompt + stablePrefix;
    var next := eosToken;
    if |currentConstrainedOut| < 2 {
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, eosToken
      );
    } else {
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

