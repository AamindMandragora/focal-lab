Strategy: // CSD_RATIONALE_BEGIN
// The best prior accuracy came from the simple context-triggered outer loop, so
// this revision preserves that core shape instead of retuning the same profile.
// The observed failure mode is that answers almost never appear in a final
// visible << >> span: most constrained activity happened in hidden/nonfinal
// chunks while free generation dominated runtime. To address that, the strategy
// makes one structural change: once a chemistry cue is seen, it enters a
// dedicated answer-writing phase that opens exactly one constrained span and
// then stays focused on completing and visibly closing that span rather than
// returning to long unconstrained wandering.
// 
// Inside the span, the strategy also changes from pure one-token adaptive
// stepping to a hybrid. When the parser state is narrow, it keeps token-level
// control with AdaptiveConstrainedStep; when the state is broader, it uses a
// bounded ConstrainedSymbolInGenerated call so the model can emit multi-token
// chemistry fragments efficiently while still accepting only the longest valid
// parser prefix. This is intended to improve both syntax and answer fidelity
// without repeating the always-open or always-symbol profiles that previously
// underperformed.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span branch, either we remain outside after
//   UnconstrainedStep, or we enter via OpenConstrainedSpan /
//   EnterObservedConstrainedSpan, both of which set currentConstrainedOut := []
//   and therefore preserve parser.IsValidPrefix(currentConstrainedOut). In the
//   complete-prefix branch, CloseConstrainedSpan exits constrained mode and
//   clears currentConstrainedOut, so the implication remains true.
// parser_validity: In the active constrained branch, the narrow sub-branch uses
//   AdaptiveConstrainedStep, which returns EOS or a parser-valid next token;
//   on the non-EOS path, AppendConstrainedToken preserves validity. The broad
//   sub-branch uses ConstrainedSymbolInGenerated, whose returned currentOut is a
//   parser-valid prefix, so assigning currentConstrainedOut := currentOut also
//   preserves the invariant.
// progress: In the outside branch, UnconstrainedStep consumes 1 token-step and
//   appends at most one visible token; OpenConstrainedSpan consumes 1 token-step
//   and appends one visible delimiter; EnterObservedConstrainedSpan consumes 0
//   and appends nothing. Thus after increasing steps by the consumed budget,
//   |generated| <= |generatedPrefix| + steps is preserved.
// progress: In the complete-prefix branch, CloseConstrainedSpan consumes 1
//   token-step and appends at most one visible close delimiter. In the narrow
//   constrained branch, AdaptiveConstrainedStep consumes 1 token-step and
//   AppendConstrainedToken appends at most that one already-budgeted token. In
//   the broad branch, ConstrainedSymbolInGenerated consumes stepsUsed tokens;
//   some may be EOS or rejected suffix tokens, but visible growth is at most
//   stepsUsed, so the output-length bound still holds after
//   steps := steps + stepsUsed.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var chemistryArmed: bool := false;
var answerMode: bool := insideConstrained;
var recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if chemistryArmed || answerMode {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      chemistryArmed := false;
      answerMode := true;
      recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          var enteredGenerated, enteredInside, enteredCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
          generated := enteredGenerated;
          insideConstrainedOut := enteredInside;
          currentConstrainedOut := enteredCurrent;
          chemistryArmed := false;
          answerMode := true;
        } else {
          recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");
          if next == "SMILES" || next == "smiles" || next == "molecule" || next == "molecular" || |recentAfterAnswer| > 0 {
            chemistryArmed := true;
            answerMode := true;
          }
        }
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
    chemistryArmed := false;
    answerMode := false;
    recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");
  } else {
    var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
    var constrainedPrompt := prompt + stablePrefix;
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    if validCount <= 16 || stepTokenBudget == 0 || maxSteps - steps == 1 {
      var next := eosToken;
      if |currentConstrainedOut| < 2 {
        next := helpers.GroupBoostedConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, eosToken
