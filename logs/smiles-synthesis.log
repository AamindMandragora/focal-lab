Strategy: // CSD_RATIONALE_BEGIN
// Revised molecular-answer CSD. The prior attempt relied on free generation to
// decide when to open the answer span, and evaluation showed that complete
// visible spans were almost never produced. This revision makes the span
// transition explicit and early: when not already inside a constrained span and
// there is remaining budget, the strategy opens a visible "<<" immediately
// instead of waiting for a cue from unconstrained text. That directly targets
// the observed failure mode of missing final visible spans.
// 
// Inside the span, the strategy keeps parser validity as the hard authority but
// changes the decoding shape substantially. Rather than single-token adaptive
// steps, it uses bounded multi-token constrained-symbol decoding so the model
// can emit a longer SMILES fragment per LM call while still accepting only the
// longest parser-valid prefix. This is paired with immediate closing once the
// parser reports completeness, making the final answer more likely to end in a
// complete visible << >> span within budget.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the explicit-open branch, OpenConstrainedSpan sets
//   insideConstrainedOut := true and currentConstrainedOut := [], which is a
//   valid parser prefix by the precondition parser.IsValidPrefix([]). In the
//   complete-prefix branch, CloseConstrainedSpan exits constrained mode and
//   clears the constrained prefix, so the implication is vacuous afterward. In
//   the active constrained branch, ConstrainedSymbolInGenerated returns a
//   longest accepted parser-valid prefix for the constrained content, so the
//   updated currentConstrainedOut remains parser-valid.
// progress: The explicit-open and close branches each consume one token-step
//   and append at most one visible delimiter, so |generated| <= |generatedPrefix|
//   + steps is preserved after incrementing steps by 1. In the constrained
//   symbol branch, steps increases by stepsUsed, and visible growth is at most
//   the accepted constrained-prefix growth, which is no more than the consumed
//   token budget even if EOS or rejected suffix tokens were also charged.
//   Therefore each branch preserves |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
    var constrainedPrompt := prompt + stablePrefix;
    var remaining: nat := maxSteps - steps;
    var symbolBudget: nat := if stepTokenBudget == 0 || stepTokenBudget > remaining then remaining else stepTokenBudget;
    var symbolGenerated, symbolOut, hitEos, stepsUsed := helpers.ConstrainedSymbolInGenerated(
      lm, parser, constrainedPrompt, generated, currentConstrainedOut, symbolBudget, eosToken
    );
    generated := symbolGenerated;
    insideConstrainedOut := true;
    currentConstrainedOut := symbolOut;
    steps := steps + stepsUsed;
    if hitEos {
      break;
    }
  }
}

cost := steps;

