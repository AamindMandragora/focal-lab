Strategy: // CSD_RATIONALE_BEGIN
// Molecular-answer CSD. The strategy tracks whether generation is currently
// inside a chemistry answer span delimited by "<<" and ">>", together with the
// active constrained contents of that span. Outside a span it generates freely
// but watches for either an observed "<<" token or a lightweight chemistry cue
// in the recent text; after such a cue, it explicitly opens a constrained span
// so the requested molecular string can be produced in the expected location.
// Inside a span, the parser remains the hard validity authority, while
// caller-supplied token groups are used as a soft preference through an
// adaptive constrained step. This tracked state supports valid generation by
// ensuring constrained contents are always parser-valid prefixes and by closing
// the span as soon as the parser reports completeness.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the free-generation branch, insideConstrainedOut stays
//   false unless we either observe next == "<<" or call OpenConstrainedSpan;
//   both transitions set currentConstrainedOut := [] (or the helper returns [])
//   and parser.IsValidPrefix([]) holds by precondition. In the observed-open
//   branch, EnterObservedConstrainedSpan only changes bookkeeping and returns an
//   empty constrained prefix, so validity is preserved. In the complete-prefix
//   branch, CloseConstrainedSpan exits constrained mode, making the implication
//   vacuous. In the active constrained branch, AdaptiveConstrainedStep returns
//   either EOS or a parser-valid next token, and AppendConstrainedToken
//   preserves parser validity of currentConstrainedOut.
// progress: The unconstrained-token branch uses UnconstrainedStep, so steps
//   increases by 1 and visible output grows by at most 1. The explicit-open and
//   close branches each consume one delimiter step and append at most one token,
//   so |generated| <= |generatedPrefix| + steps is preserved. The observed-open
//   bookkeeping branch consumes 0 steps and does not change generated. The
//   constrained-token branch uses AdaptiveConstrainedStep, so steps increases by
//   1; if EOS is returned, no visible token is appended, and otherwise
//   AppendConstrainedToken adds exactly one visible token, still within the
//   consumed budget. Thus every branch preserves |generated| <=
//   |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var chemistryArmed: bool := false;
var recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if chemistryArmed {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      chemistryArmed := false;
      recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          var enteredGenerated, enteredInside, enteredCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
          generated := enteredGenerated;
          insideConstrainedOut := enteredInside;
          currentConstrainedOut := enteredCurrent;
          chemistryArmed := false;
        } else {
          recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");
          if next == "SMILES" || next == "smiles" || next == "molecule" || next == "molecular" || |recentAfterAnswer| > 0 {
            chemistryArmed := true;
          }
        }
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
    chemistryArmed := false;
    recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");
  } else {
    var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
    var constrainedPrompt := prompt + stablePrefix;
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

