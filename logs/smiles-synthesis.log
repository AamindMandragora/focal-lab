Strategy: // CSD_RATIONALE_BEGIN
// The last revision failed because it opened and closed constrained spans almost
// continuously, producing many tiny visible spans and severe delimiter churn.
// Evaluation showed hundreds of OpenConstrainedSpan/CloseConstrainedSpan calls,
// average visible span length near 1 token, and many max-step hits. That means
// the core failure was not parser validity but over-eager span cycling.
// 
// This revision returns to the stronger shape from the earlier best attempt:
// stay mostly unconstrained until local answer-like cues appear, then open one
// constrained span and decode it token by token with parser-hard control. To
// improve answer quality inside the span without reintroducing churn, the
// constrained branch is made structurally different from both prior attempts:
// it uses a length-sensitive policy. Early in the span it uses
// GroupBoostedConstrainedStep to bias toward caller-supplied chemistry tokens;
// once the span has some content it switches to AdaptiveConstrainedStep for
// parser-hard decoding with contextual soft preference. This preserves the
// successful "single meaningful span" behavior of the best-so-far attempt while
// adding a chemistry-aware constrained policy aimed at raising membership.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span branch, either we stay outside after an
//   UnconstrainedStep, or we enter constrained mode only via OpenConstrainedSpan
//   or EnterObservedConstrainedSpan; both set currentConstrainedOut := [], which
//   is valid by parser.IsValidPrefix([]). In the complete-prefix branch,
//   CloseConstrainedSpan exits constrained mode and clears currentConstrainedOut,
//   so the implication becomes vacuous. In the active constrained branch, both
//   GroupBoostedConstrainedStep and AdaptiveConstrainedStep return either EOS or
//   a parser-valid next token; on non-EOS we call AppendConstrainedToken, which
//   preserves parser validity of currentConstrainedOut.
// progress: In the armed-open branch and the close branch, the helper consumes
//   exactly 1 token-step and appends at most one visible delimiter, so after
//   steps := steps + 1 the bound |generated| <= |generatedPrefix| + steps is
//   preserved. In the free-generation branch, UnconstrainedStep consumes 1 step;
//   EOS appends nothing, and a non-EOS token appends exactly one visible token,
//   so the same bound holds. In the active constrained branch, each constrained
//   step helper consumes 1 token-step; EOS may append nothing, while a non-EOS
//   token is appended once via AppendConstrainedToken, so visible growth is at
//   most the consumed budget and the invariant is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var chemistryArmed: bool := false;
var recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if chemistryArmed {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      chemistryArmed := false;
      recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          var enteredGenerated, enteredInside, enteredCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
          generated := enteredGenerated;
          insideConstrainedOut := enteredInside;
          currentConstrainedOut := enteredCurrent;
          chemistryArmed := false;
        } else {
          recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");
          if next == "SMILES" || next == "smiles" || next == "molecule" || next == "molecular" || |recentAfterAnswer| > 0 {
            chemistryArmed := true;
          }
        }
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
    chemistryArmed := false;
    recentAfterAnswer := helpers.ExtractAfterKeyword(generated, "answer");
  } else {
    var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
    var constrainedPrompt := prompt + stablePrefix;
    var next := eosToken;
    if |currentConstrainedOut| < 2 {
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, eosToken
      );
    } else {
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

