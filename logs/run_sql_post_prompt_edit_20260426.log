// wrong tokenization assumptions. The observed outputs like
// `SELECT <id>>><id>` indicate the model was being allowed to emit SQL-looking
// text while the constrained span boundaries and parser-valid candidates were
// fighting each other token-by-token.
//
// This revision changes the strategy in a more structural way:
//
// 1. Stay parser-led for the entire SQL region, but add confidence shaping when
//    the valid set is small. We query the number of valid next tokens and, when
//    the grammar is narrow, strongly bias decoding toward the parser-approved
//    top valid candidates. This is aimed at schema-grounded SQL generation,
//    where many decision points have only a few correct table/column/operator
//    continuations.
// 2. Detect dead-end pressure and sharpen logits aggressively before sampling.
//    If the parser reports a narrow or risky state, we scale logits and boost a
//    small parser-approved candidate set, reducing drift into odd but still
//    locally valid continuations.
// 3. Close only when the parser says the SQL prefix is complete, and otherwise
//    never treat delimiter-looking text as a reason to close. This directly
//    avoids the earlier `>>`-style corruption mode.
// 4. Use exactly one constrained SQL span. If we start outside, we open it
//    immediately, generate the query inside it, close as soon as complete, and
//    then strongly prefer EOS. This matches the benchmark format while keeping
//    all SQL content under grammar control.
// 5. Keep the loop simple enough to prove: each counted step performs at most
//    one token-generation action or one delimiter action, so progress and cost
//    remain straightforward.
//
// In short, the fix is to make constrained decoding not just mandatory but
// sharper at narrow grammar states, while preserving a single clean `<<SQL>>`
// span and immediate termination after closure.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open-span branch, `OpenConstrainedSpan` creates an
// empty constrained content, and `parser.IsValidPrefix([])` holds by
// precondition. In the active constrained branch, if the prefix is complete we
// close with `CloseConstrainedSpan`, making `insideConstrainedOut` false so the
// invariant is vacuous; otherwise we obtain a parser-approved token from
// `ConstrainedStep` and extend with `AppendConstrainedToken`, which preserves
// parser validity of the tracked constrained prefix. In the final outside
// branch, we remain outside constrained mode, so the implication is vacuous.
//
// suffix: After opening, the tracked constrained content is empty, so it is
// trivially the suffix of `generated`. In the constrained append branch,
// `AppendConstrainedToken` appends the same chosen token to both `generated` and
// `currentConstrainedOut`, preserving that the tracked constrained content is
// exactly the suffix. In close and outside branches, `insideConstrainedOut` is
// false afterward, so the suffix invariant holds vacuously.
//
// progress: Each non-breaking iteration increments `steps` exactly once. Opening
// adds one delimiter token, constrained append adds at most one token, closing
// adds one delimiter token, and the post-close outside branch either breaks on
// EOS or appends one token. Therefore the generated length grows by at most one
// per counted step, preserving `|generated| <= |generatedPrefix| + steps`.
//
// cost accounting: The returned `cost` is assigned from `steps` at the end.
// Every branch that performs one decoding/delimiter action increments `steps`
// exactly once, and no branch increments it twice. Since the loop guard is
// `steps < maxSteps`, we maintain `0 <= steps <= maxSteps`, so `cost <=
// maxSteps` on return.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var openedOnce := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var gClose, iClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := gClose;
      insideConstrainedOut := iClose;
      currentConstrainedOut := cClose;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 4);
      if narrow {
        lm.GenerateLogits(prompt + generated);
        helpers.ScaleAllLogits(lm, 0.5);
        var candNarrow := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 6, eosToken);
        helpers.BoostTokenLogits(lm, candNarrow, 8.0);
      } else {
        if validCount <= 8 {
          lm.GenerateLogits(prompt + generated);
          var candSmall := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 8, eosToken);
          helpers.BoostTokenLogits(lm, candSmall, 3.0);
        }
      }
      var nextInside := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if nextInside == eosToken {
        break;
      } else {
        var gAppend, iAppend, cAppend := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, nextInside);
        generated := gAppend;
        insideConstrainedOut := iAppend;
        currentConstrainedOut := cAppend;
      }
    }
  } else {
    if !openedOnce {
      var gOpen, iOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
      generated := gOpen;
      insideConstrainedOut := iOpen;
      currentConstrainedOut := cOpen;
      openedOnce := true;
      steps := steps + 1;
    } else {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, [eosToken], 100.0);
      var nextOutside := lm.ChooseNextToken();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      } else {
        generated := generated + [nextOutside];
      }
    }
  }
}

cost := steps;

