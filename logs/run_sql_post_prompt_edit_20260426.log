Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy kept the SQL body grammar-valid, but it still let the
// model drive token choice too directly inside the constrained span. On Spider,
// that produced many syntactically valid yet semantically poor queries with
// unstable identifier choices and repeated local patterns such as `>>><id>`.
// The evaluation preview strongly suggests that once the model drifted toward a
// bad local mode, pure constrained sampling kept following it instead of
// steering back toward high-probability valid SQL continuations.
// 
// This revision makes constrained decoding more corrective and less free-running:
// - we still open the SQL span exactly once with `OpenConstrainedSpan` so the
//   emitted text and tracked constrained suffix remain synchronized;
// - inside the span, before choosing a token, we inspect the number of valid
//   next tokens and whether the parser reports a narrow / dead-end-like state;
// - when the valid set is small or the parser is narrow, we use
//   `TopValidCandidates` to obtain a short list of valid continuations and boost
//   them strongly before sampling with `ChooseNextToken`; this keeps generation
//   schema- and grammar-valid while biasing toward the model's best valid SQL
//   options;
// - when the valid set is broader, we still use `ConstrainedStep`, which already
//   respects the parser;
// - after the constrained prefix becomes complete, we immediately close with
//   `CloseConstrainedSpan`, and once closed we prefer EOS by heavily boosting it
//   during unconstrained decoding so the output is a single SQL query wrapped in
//   `<< >>` rather than drifting into extra text.
// 
// Relative to the failed attempt, the key change is replacing always-on raw
// constrained sampling with a hybrid strategy that explicitly re-ranks toward
// top valid candidates in narrow SQL states and terminates aggressively after
// closure. This directly targets the observed bad identifier runs and local
// repetition while preserving the verified alignment between generated text and
// constrained-prefix tracking.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the initial outside branch, `OpenConstrainedSpan` enters
// constrained mode with empty tracked content, and `parser.IsValidPrefix([])` is
// a precondition, so validity holds. In the outside-after-close branch, we never
// re-enter constrained mode; either we break on EOS or append one unconstrained
// token, leaving the implication vacuous. In the inside-complete branch,
// `CloseConstrainedSpan` exits constrained mode, again making the implication
// vacuous. In the inside-active branches, if EOS is chosen we break without
// mutating the constrained state; otherwise `AppendConstrainedToken` is called
// only with a token produced either by `ConstrainedStep` or from
// `TopValidCandidates`, both intended to be valid next tokens, so the updated
// constrained prefix remains parser-valid.
// 
// suffix: Outside constrained mode the invariant is vacuous unless we open; just
// after `OpenConstrainedSpan`, the tracked constrained content is empty, so it is
// trivially the suffix of `generated`. In the complete-prefix branch,
// `CloseConstrainedSpan` sets `insideConstrainedOut` false and clears the tracked
// content, so the implication is vacuous. In either active constrained branch,
// `AppendConstrainedToken` appends the same chosen token to `generated` and to
// `currentConstrainedOut`, preserving that the tracked constrained content is
// exactly the suffix of `generated`.
// 
// progress: Every non-breaking iteration increments `steps` exactly once. The
// opening branch appends only the opening delimiter via `OpenConstrainedSpan`, so
// generated length increases by at most one. The outside-after-close branch
// either breaks on EOS or appends exactly one unconstrained token. The
// inside-complete branch appends only the closing delimiter via
// `CloseConstrainedSpan`. The inside-active branches either break on EOS or
// append exactly one constrained token via `AppendConstrainedToken`. Hence after
// each non-breaking iteration, `|generated|` increases by at most one while
// `steps` increases by one, preserving `|generated| <= |generatedPrefix| + steps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var openedOnce := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !openedOnce {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedOnce := true;
      steps := steps + 1;
    } else {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, [eosToken], 100.0);
      var next := lm.ChooseNextToken();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 3);
      if narrow || validCount <= 8 {
        lm.GenerateLogits(prompt + generated);
        var candidates := helpers.TopValidCandidates(lm, parser, prompt + generated, currentConstrainedOut, 6, eosToken);
        helpers.BoostTokenLogits(lm, candidates, 8.0);
        helpers.PenalizeTokenLogits(lm, [eosToken], 100.0);
        var next := lm.ChooseNextToken();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var next := helpers.ConstrainedStep(lm, parser, prompt + generated, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

cost := steps;

