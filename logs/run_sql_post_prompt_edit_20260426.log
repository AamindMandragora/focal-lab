Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy was too permissive inside the SQL span: it sometimes
// sampled from a softly biased unrestricted distribution and then merely checked
// local token validity. On Spider this allowed malformed-but-locally-valid
// continuations, delimiter-like junk, and repetitive drifting inside the SQL
// segment, which hurt execution accuracy despite perfect syntax rate.
// 
// The revised strategy is stricter and simpler. It opens the constrained span
// eagerly, then stays fully grammar-guided for essentially all SQL tokens by
// using `ConstrainedStep` while inside the span. It closes the span immediately
// once the parser says the SQL prefix is complete. Outside the span, it avoids
// free-form wandering: if not already inside, it strongly prefers to emit the
// opening delimiter right away so the actual query is generated under the
// schema-narrowed SQL grammar. This directly targets the observed failures:
// fewer unconstrained SQL-looking tokens, no soft invalid drift, and less
// repetition because each in-span step must remain parser-valid.
// 
// In short: eager entry into `<< ... >>`, deterministic grammar-respecting
// decoding inside, immediate closure on completeness, and EOS respected as
// terminal.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, opening the constrained span sets
// `currentConstrainedOut := []`, which is a valid parser prefix by precondition;
// if instead EOS is chosen or an unconstrained token is appended while staying
// outside, the implication is vacuous. In the complete-prefix branch,
// `CloseConstrainedSpan` exits constrained mode, so the implication is vacuous.
// In the active constrained branch, `ConstrainedStep` supplies either EOS
// (causing break with no state mutation afterward) or a parser-valid next token;
// `AppendConstrainedToken` then preserves parser validity of the updated
// constrained prefix.
// 
// suffix: Outside the span, the invariant is vacuous unless we open it; when we
// open, we append only `"<<“` and keep `currentConstrainedOut == []`, so the
// empty suffix matches. In the complete-prefix branch, closing resets
// `currentConstrainedOut` to `[]`, making the suffix condition trivial. In the
// active constrained append branch, `AppendConstrainedToken` appends the same
// token to both `generated` and `currentConstrainedOut`, so the tracked suffix
// relationship is preserved.
// 
// progress: Every non-breaking iteration increments `steps` exactly once. The
// outside branch appends at most one token (either `"<<“` or one unconstrained
// token). The complete-prefix branch appends only the closing delimiter token,
// still at most one token. The active constrained branch appends at most one
// token via `AppendConstrainedToken`; if EOS is returned we break immediately.
// Hence `|generated| <= |generatedPrefix| + steps` is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if |generated| == |generatedPrefix| {
      generated := generated + ["<<"];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else if next == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

