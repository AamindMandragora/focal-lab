Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy entered constrained decoding too late and also mixed a
// free-running token sampler with only light validity checks inside SQL spans.
// That allowed malformed local continuations, delimiter-adjacent junk, and
// repetition patterns to accumulate even though the final text still contained
// << >>. For Spider text-to-SQL, syntax is already strong, so the main need is
// to keep generation tightly aligned with the schema-narrowed SQL grammar from
// the moment the SQL answer begins.
//
// This revised strategy therefore front-loads constrained decoding: if we are
// not already inside a constrained span, we immediately open one on the first
// step instead of waiting for a competitive "<<". Once inside, we avoid the
// previous "sample then maybe reject" pattern. Instead, ordinary constrained
// generation always uses helpers.ConstrainedStep, which selects under parser
// constraints, and then appends only that valid token. Complete SQL prefixes
// are closed immediately with >>, and dead ends are repaired by rolling back to
// the longest valid constrained prefix before taking another constrained step.
// This removes the main source of malformed SQL continuations and sharply
// reduces repetition caused by unconstrained local sampling.
//
// The tracked state remains simple: generated stores the full answer including
// delimiters, while currentConstrainedOut stores only the active SQL substring
// after << and before >>. Every branch either opens a fresh empty constrained
// span, appends one parser-approved constrained token, closes a complete span,
// or rolls back to a valid constrained prefix and then appends one valid token.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the opening branch, we append "<<" and set
//   currentConstrainedOut := [], which is a valid parser prefix by precondition.
//   In the complete-prefix branch, CloseConstrainedSpan makes
//   insideConstrainedOut false, so the implication is vacuous. In the dead-end
//   branch, RollbackToValidPrefix returns a valid prefix; after resetting
//   generated and currentConstrainedOut to that rolled prefix, ConstrainedStep
//   provides a parser-approved next token, and AppendConstrainedToken preserves
//   validity. In the ordinary constrained branch, ConstrainedStep again chooses
//   a valid next token, and AppendConstrainedToken preserves validity.
// suffix: In the opening branch, currentConstrainedOut becomes empty, so the
//   suffix property holds trivially. In the complete-prefix branch,
//   CloseConstrainedSpan resets currentConstrainedOut to [], so the invariant is
//   immediate. In the dead-end branch, generated is reassigned to the previous
//   unconstrained base plus the rolled valid constrained prefix, so it ends with
//   currentConstrainedOut; then AppendConstrainedToken extends both generated
//   and currentConstrainedOut by the same token. In the ordinary constrained
//   branch, AppendConstrainedToken likewise extends both in lockstep.
// progress: Each non-breaking iteration increments steps by exactly 1. Opening
//   a constrained span appends one token. Closing a complete span appends one
//   token. The dead-end branch may first shorten generated by rollback and then
//   append one token, so generated cannot exceed the new bound
//   |generatedPrefix| + steps. The ordinary constrained branch appends exactly
//   one token, so the bound is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if narrow {
        var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
        var baseGenerated := generated[..|generated| - |currentConstrainedOut|];
        generated := baseGenerated + rolled;
        currentConstrainedOut := rolled;

        var constrainedPrompt := prompt + baseGenerated;
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var baseGenerated := generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.ConstrainedStep(lm, parser, prompt + baseGenerated, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

