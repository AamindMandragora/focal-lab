Strategy: // CSD_RATIONALE_BEGIN
// The evaluation shows the previous strategy achieved perfect syntax but almost
// no task accuracy, with failures like `SELECT count>>(*)`. That pattern means
// we were closing the constrained span as soon as the parser considered the SQL
// prefix complete, even when the language model still strongly preferred an
// immediately following SQL token such as `(`. In Spider, many queries have
// locally complete prefixes that should be extended, so "close on first
// completeness" is too eager.
//
// This revision changes the strategy in two important ways:
//
// 1. We still force exactly one `<< ... >>` constrained region, but inside that
//    region we no longer close immediately on `parser.IsCompletePrefix(...)`.
//    Instead, when the prefix is complete we look at the model's next-token
//    preference under the current context. If the top token appears to continue
//    SQL (in particular if it contains `<<`, which would be bad, or if it is a
//    parser-valid next token), we keep generating inside the constrained span.
//    We close only when the prefix is complete and the model does not appear to
//    want a valid SQL continuation. This directly targets the observed
//    `count>>(` truncation failure.
//
// 2. Token choice inside the constrained span is made more deterministic and
//    validity-focused. Rather than lightly boosting a shortlist and then
//    sampling from all tokens, we ask `ConstrainedStep` for a parser-respecting
//    token on every active constrained iteration. This avoids drifting toward
//    invalid-but-high-logit tokens and better preserves the model's strongest
//    valid SQL continuation. When the prefix is complete, we additionally use
//    parser queries (`IsTokenValidNext`) and the model's top-token signal to
//    decide whether to continue or close.
//
// After the constrained span is closed, we strongly prefer EOS so the output is
// a single wrapped SQL query with no trailing explanation text.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: Opening uses `OpenConstrainedSpan`, which enters constrained
// mode with empty tracked content, and `parser.IsValidPrefix([])` is assumed. In
// the outside-after-close branch we either break on EOS or append one ordinary
// token while remaining outside constrained mode, so the implication is vacuous.
// In the inside-close branch, `CloseConstrainedSpan` exits constrained mode, so
// the implication is again vacuous. In the inside-append branch, the chosen
// token comes from `ConstrainedStep`; if it is EOS we break without changing the
// constrained state, otherwise `AppendConstrainedToken` extends the constrained
// prefix with a parser-valid next token, preserving validity.
//
// suffix: After `OpenConstrainedSpan`, the tracked constrained content is empty,
// so it is trivially the suffix of `generated`. Outside constrained mode the
// invariant is vacuous. In the close branch, `CloseConstrainedSpan` leaves
// constrained mode and clears the tracked content, making the implication
// vacuous. In the append branch, `AppendConstrainedToken` appends the same token
// to both `generated` and `currentConstrainedOut`, so the tracked constrained
// text remains exactly the suffix of `generated`.
//
// progress: Every non-breaking iteration increments `steps` exactly once. The
// open branch appends only the opening delimiter; the post-close branch either
// breaks on EOS or appends exactly one token; the close branch appends only the
// closing delimiter; and the active constrained branch either breaks on EOS or
// appends exactly one constrained token. Thus `generated` grows by at most one
// token per increment of `steps`, preserving `|generated| <= |generatedPrefix| +
// steps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var openedOnce := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !openedOnce {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedOnce := true;
      steps := steps + 1;
    } else {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, [eosToken], 100.0);
      var nextOutside := lm.ChooseNextToken();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      } else {
        generated := generated + [nextOutside];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      lm.GenerateLogits(prompt + generated);
      helpers.PenalizeTokenLogits(lm, [eosToken], 100.0);
      var topToken := helpers.GetHighestLogitToken(lm);
      var topContinues := helpers.IsTokenValidNext(parser, currentConstrainedOut, topToken);
      if topContinues || Contains(topToken, "<<") {
        var nextInsideComplete := helpers.ConstrainedStep(lm, parser, prompt + generated, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextInsideComplete == eosToken {
          var closedGenerated0, closedInside0, closedCurrent0 := helpers.CloseConstrainedSpan(
            lm, parser, generated, currentConstrainedOut
          );
          generated := closedGenerated0;
          insideConstrainedOut := closedInside0;
          currentConstrainedOut := closedCurrent0;
        } else {
          var appendedGenerated0, appendedInside0, appendedCurrent0 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, nextInsideComplete
          );
          generated := appendedGenerated0;
          insideConstrainedOut := appendedInside0;
