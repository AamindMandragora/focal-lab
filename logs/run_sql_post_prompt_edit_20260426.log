                generated := gAppend2;
                insideConstrainedOut := iAppend2;
                currentConstrainedOut := cAppend2;
              } else {
                break;
              }
            } else {
              break;
            }
          }
        }
      } else {
        break;
      }
    }
  }

  if insideConstrainedOut {
    var completeEnd := parser.IsCompletePrefix(currentConstrainedOut);
    if completeEnd && steps < maxSteps {
      var gCloseEnd, iCloseEnd, cCloseEnd := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := gCloseEnd;
      insideConstrainedOut := iCloseEnd;
      currentConstrainedOut := cCloseEnd;
      steps := steps + 1;
    }
  }

