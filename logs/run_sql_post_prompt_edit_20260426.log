  // CSD_RATIONALE_BEGIN
  // The evaluation failure is decisive: syntax was 100% and delimiters were
  // present, but every answer looked like a tiny locally-valid SQL fragment
  // closed far too early (for example `SELECT count>><id>`). So the strategy
  // must change qualitatively, not just be patched.
  //
  // This revision adopts a "stay inside until EOS or budget exhaustion" policy.
  // We open exactly one constrained span, generate only grammar-valid SQL tokens
  // while inside it, and never close merely because the current prefix is a
  // complete query. Completion is treated as a soft signal for stronger bias
  // toward EOS, but if EOS is not selected we continue extending with valid SQL.
  // This directly addresses the observed premature-closing failure mode.
  //
  // Inside the constrained span, the strategy uses parser-aware narrowing:
  // - when the valid-next set is small or the parser reports a narrow state, we
  //   strongly boost top valid candidates;
  // - when the current prefix is already complete, we additionally boost EOS so
  //   the model can terminate cleanly, but we still allow continuation;
  // - sampled invalid/EOS outcomes are repaired by falling back to the top valid
  //   candidate whenever possible, so generation remains productive.
  //
  // We only call `CloseConstrainedSpan` in states already known complete, and
  // only when we are actually ready to terminate the constrained SQL output:
  // either EOS was chosen while complete, or the step budget is exhausted and
  // the current prefix is complete. This keeps the output wrapped in `<< >>`
  // while avoiding the earlier "close as soon as complete" pathology.
  // CSD_RATIONALE_END
  // CSD_PROOF_SKETCH_BEGIN
  // parser_validity: Opening sets the constrained payload to empty, which is a
  // valid prefix by precondition. In every inside append branch, we first check
  // `IsTokenValidNext` on the chosen token (sampled token or fallback), and then
  // `AppendConstrainedToken` preserves validity. In the close branch,
  // `insideConstrainedOut` becomes false, so the implication holds vacuously.
  //
  // suffix: After opening, the constrained payload is empty, so it is trivially
  // the suffix of `generated`. Every append branch extends both `generated` and
  // `currentConstrainedOut` by the same token via `AppendConstrainedToken`,
  // preserving the exact-suffix relationship. After closing, the invariant is
  // vacuous because `insideConstrainedOut` is false.
  //
  // progress: Each non-breaking iteration increments `steps` exactly once and
  // appends at most one token to `generated`: opening appends `<<`, each inside
  // append appends one SQL token, and closing appends `>>`. Branches that break
  // do so after the step increment for that iteration and without further loop
  // iterations, so `|generated| <= |generatedPrefix| + steps` is preserved.
  //
  // cost accounting: We return `cost := steps`. Every iteration performs at most
  // one counted generation action: `OpenConstrainedSpan`, `ConstrainedStep`, or
  // `CloseConstrainedSpan`, each corresponding to the single `steps := steps + 1`
  // in that iteration. Since the loop guard is `steps < maxSteps`, we maintain
  // `steps <= maxSteps`, hence `cost <= maxSteps` on return.
  // CSD_PROOF_SKETCH_END
  generated := generatedPrefix;
  insideConstrainedOut := insideConstrained;
  currentConstrainedOut := currentConstrained;
  cost := 0;

  var steps := 0;
  var openedOnce := insideConstrained;

  while steps < maxSteps
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
    invariant |generated| <= |generatedPrefix| + steps
    invariant cost == 0
    decreases maxSteps - steps
  {
    if !openedOnce {
      var gOpen, iOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
      generated := gOpen;
      insideConstrainedOut := iOpen;
      currentConstrainedOut := cOpen;
      openedOnce := true;
      steps := steps + 1;
    } else {
      if insideConstrainedOut {
        var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
        var validCountNow := helpers.ValidTokenCount(parser, currentConstrainedOut);
        var narrowNow := helpers.DeadEndDetection(parser, currentConstrainedOut, 6);

        lm.GenerateLogits(prompt + generated);

        if completeNow {
