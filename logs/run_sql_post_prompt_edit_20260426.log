// used a very weak completion policy. In practice that let the model keep
// emitting grammar-valid fragments and then close at poor times, producing
// malformed SQL-like content such as `SELECT <id>>><id>`.
//
// This revision changes the strategy materially:
//
// 1. Use a single dedicated constrained SQL span: if not already inside one, we
//    immediately open `<<`, generate SQL entirely inside it, and then close it
//    once the parser reports a complete prefix. This matches the evaluation
//    requirement that output contain `<< >>` while keeping all SQL tokens under
//    grammar control.
// 2. Inside the constrained span, decoding is now parser-led on every step via
//    `ConstrainedStep`. We do not inspect arbitrary unconstrained top tokens to
//    decide whether to continue. That removes the previous source of unstable
//    close/continue behavior.
// 3. Once the constrained prefix is complete, we close immediately rather than
//    trying to extend a complete SQL query. For Spider text-to-SQL, emitting one
//    complete query is the target behavior; continuing after completeness was the
//    main cause of bad outputs.
// 4. After closing the one SQL span, we strongly prefer EOS and stop on it;
//    otherwise at most one unconstrained token is appended per step, preserving
//    simple progress reasoning.
//
// In short, the fix is to make constrained decoding dominate the SQL region and
// to close as soon as a complete schema-valid SQL query has been formed.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the opening branch, `OpenConstrainedSpan` starts a fresh
// constrained region with empty tracked content, and `parser.IsValidPrefix([])`
// is a precondition. In the active constrained branch, if the prefix is already
// complete we call `CloseConstrainedSpan`, after which `insideConstrainedOut` is
// false so the implication is vacuous; otherwise `ConstrainedStep` chooses a
// parser-valid next token and `AppendConstrainedToken` extends the tracked
// prefix, preserving validity. In the post-close outside branch, we remain
// outside constrained mode, so the invariant is vacuous.
//
// suffix: After opening, the tracked constrained content is empty, so it is the
// suffix of `generated` trivially. In the append branch, `AppendConstrainedToken`
// appends the same token to both `generated` and `currentConstrainedOut`, so the
// tracked constrained content remains exactly the suffix. In branches that close
// or stay outside, `insideConstrainedOut` is false afterward, so the suffix
// invariant holds vacuously.
//
// progress: Each non-breaking iteration increments `steps` exactly once. The
// opening branch adds one delimiter token, the constrained-append branch adds at
// most one token, the close branch adds one closing delimiter, and the outside
// branch either breaks on EOS or appends one token. Therefore generated length
// increases by at most one per counted step, preserving
// `|generated| <= |generatedPrefix| + steps`.
//
// cost accounting: Returned `cost` is set to `steps`. Every branch that performs
// one decoding action increments `steps` exactly once, and no branch increments
// it twice. Since the loop guard is `steps < maxSteps`, we maintain
// `0 <= steps <= maxSteps`, so `cost <= maxSteps` on return.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var openedOnce := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var g0, i0, c0 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := g0;
      insideConstrainedOut := i0;
      currentConstrainedOut := c0;
      steps := steps + 1;
    } else {
      var nextInside := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if nextInside == eosToken {
        break;
      } else {
        var g1, i1, c1 := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, nextInside);
        generated := g1;
        insideConstrainedOut := i1;
        currentConstrainedOut := c1;
      }
    }
  } else {
    if !openedOnce {
      var g2, i2, c2 := helpers.OpenConstrainedSpan(lm, generated);
      generated := g2;
      insideConstrainedOut := i2;
      currentConstrainedOut := c2;
      openedOnce := true;
      steps := steps + 1;
    } else {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, [eosToken], 100.0);
      var nextOutside := lm.ChooseNextToken();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      } else {
        generated := generated + [nextOutside];
      }
    }
  }
}

cost := steps;

