Strategy: // CSD_RATIONALE_BEGIN
// The last strategy failed because it mixed two incompatible views of the SQL
// span. It manually appended `"<<“` to `generated` without using the opening
// helper, then inside the span it passed a prompt with the tracked constrained
// suffix removed. On Spider this desynchronized the model context from the true
// emitted text, so constrained decoding often chose tokens as if parts of the
// SQL were absent; the resulting outputs showed misplaced `>>`, broken `count`
// forms, and long repetitive drifts over schema identifiers.
// 
// The revised strategy fixes that by making the constrained span state fully
// consistent with the emitted text at every step:
// - enter the SQL span only via `OpenConstrainedSpan`, never by manual `"<<“`
//   concatenation;
// - while inside the span, call `ConstrainedStep` with the full `prompt +
//   generated` context and the exact tracked `currentConstrainedOut`;
// - append SQL tokens only through `AppendConstrainedToken`, so the generated
//   suffix and tracked constrained prefix stay aligned;
// - close the span immediately, and only, when `parser.IsCompletePrefix(...)`
//   holds, using `CloseConstrainedSpan`;
// - outside the span, avoid free-form wandering by opening immediately on the
//   first step, and after a closed query prefer EOS rather than generating more
//   text.
// 
// This directly addresses the observed failures: no context mismatch, no
// accidental early `>>`, much less repetition, and the SQL body remains fully
// grammar-guided under the schema-narrowed parser.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, `OpenConstrainedSpan` enters with
// `currentConstrainedOut := []`, which is valid by the method precondition
// `parser.IsValidPrefix([])`; if EOS is sampled while outside, we break without
// changing state, so the invariant is preserved. In the complete-prefix branch,
// `CloseConstrainedSpan` sets `insideConstrainedOut` false, making the
// implication vacuous. In the active constrained branch, `ConstrainedStep` is
// used only when already inside and not complete; if it returns EOS we break
// with no further mutation, otherwise `AppendConstrainedToken` preserves parser
// validity of the updated constrained prefix.
// 
// suffix: Outside the span the invariant is vacuous unless we open; after
// `OpenConstrainedSpan`, the tracked constrained content is empty, so the suffix
// equality holds trivially. In the complete-prefix branch, `CloseConstrainedSpan`
// exits constrained mode and resets the tracked content, so the implication is
// vacuous. In the active constrained branch, `AppendConstrainedToken` appends
// the same token to both `generated` and `currentConstrainedOut`, preserving
// that the tracked constrained content is exactly the suffix of `generated`.
// 
// progress: Every non-breaking iteration increments `steps` exactly once. The
// outside opening branch appends only the opening delimiter via
// `OpenConstrainedSpan`, so generated length increases by at most one. The
// outside post-close branch either breaks on EOS or appends at most one
// unconstrained token. The complete-prefix branch appends only the closing
// delimiter via `CloseConstrainedSpan`. The active constrained branch either
// breaks on EOS or appends exactly one constrained token via
// `AppendConstrainedToken`. Therefore `|generated| <= |generatedPrefix| + steps`
// is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var openedOnce := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !openedOnce {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedOnce := true;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var next := helpers.ConstrainedStep(lm, parser, prompt + generated, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

