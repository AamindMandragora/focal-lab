Strategy: // CSD_RATIONALE_BEGIN
// The evaluation shows syntax is already perfect and delimiters are present, but
// semantic accuracy is near zero with outputs such as `SELECT <id>>> FROM <id>`.
// That pattern strongly suggests the strategy is still letting the model sample
// delimiter/EOS-like tokens *inside* the SQL span before the grammar has reached
// a complete query, so the constrained content is being truncated into a short
// but syntactically valid fragment.
//
// This revision therefore changes the policy from "sample inside the grammar"
// to "stay maximally parser-forced until a complete query is reached":
//
// 1. Open a single constrained span immediately if we start outside.
// 2. While inside the span and the parser is not complete, always take a
//    constrained step and append that token; if the helper returns `eosToken`,
//    we do not terminate early. Instead we fall back to a parser-valid token
//    chosen from the parser-approved candidate set and append that. This avoids
//    the observed premature `>>>` / early-stop corruption mode.
// 3. Only call `CloseConstrainedSpan` when `parser.IsCompletePrefix(...)` is
//    already true. We never close merely because a sampled token resembles a
//    delimiter.
// 4. After closing the single SQL span, strongly prefer EOS and stop as soon as
//    it is sampled. This keeps the output in the required `<< ... >>` format.
// 5. Add stronger parser-guided logit shaping in narrow states by boosting a
//    small parser-approved candidate set before the constrained step. This keeps
//    generation schema-grounded without sacrificing the proof obligations.
//
// The key fix is the no-premature-termination rule inside the constrained SQL
// region: the strategy now keeps generating parser-valid SQL until the parser
// itself says the query is complete, then closes exactly once.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open branch, `OpenConstrainedSpan` starts an empty
// constrained payload, and `parser.IsValidPrefix([])` holds. In the constrained
// branch, if the prefix is complete we close, so `insideConstrainedOut` becomes
// false and the implication is vacuous; otherwise we append either the token
// returned by `ConstrainedStep` or a fallback token taken from
// `TopValidCandidates`, and `AppendConstrainedToken` preserves parser validity.
// In the final outside-after-close branch we stay outside, so the invariant is
// again vacuous.
//
// suffix: Opening yields empty constrained content, which is trivially the
// suffix. In the append sub-branches, `AppendConstrainedToken` extends both
// `generated` and `currentConstrainedOut` by the same token, so the tracked
// constrained content remains exactly the suffix of `generated`. In the close
// and outside-after-close branches, `insideConstrainedOut` is false afterward,
// so the suffix condition holds vacuously.
//
// progress: Each iteration that does not break increments `steps` exactly once.
// Opening adds one delimiter token, closing adds one delimiter token, appending
// inside adds exactly one token, and the post-close outside branch appends at
// most one token before either breaking or continuing. Therefore
// `|generated| <= |generatedPrefix| + steps` is preserved.
//
// cost accounting: `steps` is the sole returned cost. Every branch performs at
// most one counted generation/delimiter action and then increments `steps` once;
// no branch increments it twice. Since the loop guard is `steps < maxSteps`, we
// maintain `steps <= maxSteps`, hence `cost := steps` ensures `cost <= maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var openedOnce := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var gClose, iClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := gClose;
      insideConstrainedOut := iClose;
      currentConstrainedOut := cClose;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= 6 {
        lm.GenerateLogits(prompt + generated);
        var candSmall := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 6, eosToken);
        helpers.BoostTokenLogits(lm, candSmall, 12.0);
      } else {
        var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 4);
        if narrow {
          lm.GenerateLogits(prompt + generated);
          var candNarrow := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 8, eosToken);
          helpers.BoostTokenLogits(lm, candNarrow, 8.0);
        }
      }

      var nextInside := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if nextInside == eosToken {
        var fallback := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 1, eosToken);
        if |fallback| > 0 {
          var chosen := fallback[0];
          var gAppendFallback, iAppendFallback, cAppendFallback := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, chosen);
          generated := gAppendFallback;
          insideConstrainedOut := iAppendFallback;
          currentConstrainedOut := cAppendFallback;
        } else {
          break;
        }
      } else {
        var gAppend, iAppend, cAppend := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, nextInside);
        generated := gAppend;
        insideConstrainedOut := iAppend;
        currentConstrainedOut := cAppend;
      }
    }
  } else {
    if !openedOnce {
      var gOpen, iOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
      generated := gOpen;
      insideConstrainedOut := iOpen;
      currentConstrainedOut := cOpen;
      openedOnce := true;
      steps := steps + 1;
    } else {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, [eosToken], 100.0);
      var nextOutside := lm.ChooseNextToken();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      } else {
        generated := generated + [nextOutside];
      }
    }
  }
}

cost := steps;

