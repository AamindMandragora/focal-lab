Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy let the model decide when to open the constrained SQL
// span and also allowed unconstrained text before the SQL. That is a poor fit
// for Spider evaluation, which expects the answer itself to be the SQL query;
// allowing free-form preamble text makes it easy for the model to emit short
// malformed-but-grammar-compatible fragments such as `SELECT <id>` inside the
// span or to waste steps outside the span. The revised strategy therefore
// aggressively canonicalizes the output into exactly one constrained SQL span:
// if generation is not already inside a constrained span, it immediately opens
// one with `<<` as the first generation action, and after that it stays fully
// grammar-constrained until the SQL prefix is complete, at which point it
// immediately emits `>>` and stops.
//
// Inside the span, the strategy removes the earlier wide-symbol path that was
// too permissive and could jump to weak partial prefixes. Instead it uses
// token-level constrained decoding throughout, with a small amount of logit
// shaping based on parser state. When the parser is at a dead end, it rolls the
// constrained suffix back to the longest valid prefix before continuing. When
// the parser has very few valid continuations, it boosts those candidates so the
// model commits decisively; otherwise it still samples via `ConstrainedStep`.
// This keeps every emitted token schema-valid while avoiding the previous
// tendency to drift into tiny incomplete prefixes or local repetition.
//
// The key behavioral change is thus: no unconstrained chunking, immediate span
// opening, token-by-token constrained SQL generation, rollback on dead ends, and
// immediate closure once `parser.IsCompletePrefix` holds. This directly targets
// the observed low accuracy while preserving the required `<< ... >>` format and
// keeping the proof obligations simple.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the immediate-open branch, OpenConstrainedSpan sets
//   `insideConstrainedOut` true and `currentConstrainedOut` to the empty
//   constrained prefix, which is valid by precondition. In the rollback branch,
//   RollbackConstrainedSpan returns a valid constrained prefix by construction.
//   In the close branch, CloseConstrainedSpan sets `insideConstrainedOut` false,
//   so the implication is vacuous. In the token-step branch, either EOS causes
//   an immediate break with no state change to the constrained prefix, or
//   AppendConstrainedToken extends `currentConstrainedOut` with a parser-valid
//   token returned by ConstrainedStep, preserving validity.
//
// suffix: After OpenConstrainedSpan, the constrained content is empty, so the
//   suffix property holds trivially. RollbackConstrainedSpan rewrites both the
//   generated suffix and `currentConstrainedOut` together to the same valid
//   constrained prefix, so the suffix equality is preserved. CloseConstrainedSpan
//   exits constrained mode, making the implication vacuous. In the token-step
//   branch, AppendConstrainedToken appends the same token to the generated text
//   and the constrained prefix, so the suffix remains exactly
//   `currentConstrainedOut`.
//
// cost accounting: `cost` stays 0 during the loop and is assigned `steps` at the
//   end. Each state-changing helper branch increments `steps` by the exact unit
//   work performed: OpenConstrainedSpan by 1, CloseConstrainedSpan by 1, and
//   each ConstrainedStep by 1. RollbackConstrainedSpan is pure state repair and
//   does not change `steps`. Every break happens only after either no change or
//   a preceding accounted step, so `cost := steps` is sound.
//
// progress bound: OpenConstrainedSpan appends one token and increments `steps` by
//   1. RollbackConstrainedSpan can only shorten or preserve `generated`, so
//   `|generated| <= |generatedPrefix| + steps` remains true without changing
//   `steps`. CloseConstrainedSpan appends one token and increments `steps` by 1.
//   In the constrained token-step branch, EOS breaks after `steps := steps + 1`
//   with no generated-length increase, while a normal token appends exactly one
//   token via AppendConstrainedToken and also increments `steps` by 1. Thus every
//   branch preserves the linear bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var narrowThreshold: nat := 6;
var deadEndThreshold: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, deadEndThreshold);
      if narrow {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var repairedGenerated, repairedCurrent := helpers.RollbackConstrainedSpan(
          parser, stablePrefix, generated, currentConstrainedOut
        );
        generated := repairedGenerated;
        currentConstrainedOut := repairedCurrent;
      } else {
        var stablePrefix2 := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt := prompt + stablePrefix2;
        var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
        if validCount <= narrowThreshold {
          lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
          var candidates := helpers.TopValidCandidates(
            lm, parser, constrainedPrompt, currentConstrainedOut, 4, eosToken
          );
          helpers.BoostTokenLogits(lm, candidates, 8.0);
        }
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

