Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy spent many steps outside the SQL span and relied on
// broad unconstrained generation before entering the grammar. On Spider, that
// causes the model to emit short generic SQL prefixes like `SELECT count` that
// are syntactically valid prefixes but semantically incomplete or misaligned
// with the schema-conditioned parser. The evaluation signal strongly suggests
// the task expects the answer to be essentially a single constrained SQL query
// wrapped in `<<` and `>>`, not a free-form preamble followed by SQL.
//
// This revision therefore switches to an "open immediately, stay constrained"
// strategy. If we start outside a constrained span, we spend exactly one step
// to open `<<` right away, making the remaining budget focus on SQL tokens.
// Once inside the span, generation is always parser-guided. When the grammar is
// narrow, near completion, or the token budget is tiny, we use one-token
// `ConstrainedStep` to carefully choose the next valid SQL token. Otherwise we
// use `ConstrainedSymbol` to let the model emit a longer parser-valid SQL
// fragment efficiently. As soon as the parser reports a complete SQL query, we
// immediately emit the closing delimiter via `CloseConstrainedSpan`; we do not
// keep extending a complete query. EOS remains terminal in every branch.
//
// This change directly addresses the observed failure mode: instead of allowing
// unconstrained natural-language or partial-SQL drift before the constrained
// region, nearly all decoding budget is dedicated to producing one complete
// schema-valid SQL query inside `<< >>`.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the initial open branch, OpenConstrainedSpan enters the
//   span with currentConstrainedOut := [], and parser.IsValidPrefix([]) holds.
//   In the close branch, CloseConstrainedSpan sets insideConstrainedOut to
//   false, so the implication is vacuous. In the single-token constrained
//   branch, ConstrainedStep either returns eosToken and we break without state
//   change, or it returns a parser-valid next token; AppendConstrainedToken then
//   preserves parser validity. In the multi-token branch, ConstrainedSymbol
//   returns currentOut that is itself a valid parser prefix, so assigning it to
//   currentConstrainedOut preserves the invariant.
// suffix: In the initial open branch, currentConstrainedOut becomes [], so the
//   suffix condition holds trivially. In the close branch, insideConstrainedOut
//   becomes false, so the implication is vacuous. In the single-token branch,
//   AppendConstrainedToken appends the same token to both generated and the
//   constrained suffix, preserving equality of the suffix and
//   currentConstrainedOut. In the multi-token branch, with
//   stablePrefix := generated[..|generated| - |currentConstrainedOut|], we set
//   generated := stablePrefix + symbolOut and currentConstrainedOut := symbolOut,
//   so the final suffix of length |symbolOut| is exactly symbolOut.
// cost accounting: `cost` remains 0 during the loop and is assigned only once
//   at the end as `steps`, so the loop invariant `cost == 0` is preserved. Each
//   state-changing helper branch increments `steps` exactly by its work: +1 for
//   OpenConstrainedSpan, CloseConstrainedSpan, and the ConstrainedStep branch,
//   and +stepsUsed for ConstrainedSymbol. Break branches do not change steps.
//   The guards ensure these increments fit within the remaining budget, so
//   final cost := steps satisfies cost <= maxSteps.
// progress: The open branch appends exactly one token and increments steps by
//   1. The close branch also appends exactly one token and increments steps by
//   1. The single-token constrained branch either breaks on EOS immediately or
//   appends exactly one token via AppendConstrainedToken after incrementing
//   steps by 1. In the multi-token branch, ConstrainedSymbol appends at most
//   stepsUsed tokens and we increment steps by that same stepsUsed, so
//   |generated| <= |generatedPrefix| + steps is preserved by linear arithmetic.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var narrowThreshold: nat := 8;
var minValidCount: nat := 2;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, minValidCount);
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var remaining: nat := maxSteps - steps;
      if remaining == 0 {
        break;
      } else if narrow || validCount <= narrowThreshold || stepTokenBudget <= 1 || stepTokenBudget > remaining {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var symbolOut, hitEos, stepsUsed := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, stepTokenBudget, eosToken
        );
        generated := stablePrefix + symbolOut;
        insideConstrainedOut := true;
        currentConstrainedOut := symbolOut;
        steps := steps + stepsUsed;
        if hitEos {
          break;
        }
      }
    }
  }
}

cost := steps;

