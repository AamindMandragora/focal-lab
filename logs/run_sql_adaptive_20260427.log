Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL generation benefits from treating the SQL query itself as
// one constrained span, while still allowing the model to decide when to enter
// that span. The strategy tracks three pieces of state: the full generated
// output (`generated`), whether we are currently inside the SQL-constrained
// region (`insideConstrainedOut`), and the parser-tracked SQL prefix inside
// that region (`currentConstrainedOut`).
//
// Outside the constrained region, generation is chunked with UnconstrainedChunk
// so schema/question preamble text or other free-form tokens can be emitted
// efficiently until either EOS or the open delimiter "<<" is reached. Inside
// the SQL span, the strategy adapts to grammar narrowness: when the current SQL
// prefix has few valid next tokens, it uses tight token-level constrained
// decoding (`ConstrainedStep`); when the grammar is wider, it uses
// `ConstrainedSymbol` with the provided token budget to accept a longer valid
// parser prefix at once. As soon as the parser reports the SQL prefix complete,
// the strategy closes the constrained span with ">>".
//
// The minimal verification fix is to guard the ConstrainedSymbol call with
// `0 < stepTokenBudget`, and otherwise fall back to the existing tight
// token-level constrained branch. This prevents an unprovable precondition and
// also keeps the `steps` arithmetic within the loop bounds so the final length
// and cost postconditions follow from the loop invariants.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, if we remain outside then
//   the implication is vacuous; if the chunk stops on "<<", we set
//   currentConstrainedOut := [], which is a valid prefix by precondition. In
//   the complete-prefix branch, CloseConstrainedSpan sets insideConstrainedOut
//   to false, so the implication becomes vacuous. In the tight constrained
//   branch (including the fallback when stepTokenBudget == 0), ConstrainedStep
//   returns either EOS (break) or a parser-valid next token, and
//   AppendConstrainedToken preserves validity. In the loose symbol branch,
//   ConstrainedSymbol returns a valid prefix directly, so assigning it to
//   currentConstrainedOut preserves the invariant.
//
// suffix: In the unconstrained chunk branch, when we stay outside the invariant
//   is vacuous; when we enter on "<<", we set currentConstrainedOut := [], and
//   the length-0 suffix of generated equals []. In the close branch,
//   CloseConstrainedSpan appends the closing delimiter and resets
//   currentConstrainedOut to [], so the implication is vacuous. In the tight
//   branch, AppendConstrainedToken appends the same token to both generated and
//   currentConstrainedOut. In the loose symbol branch, we write
//   generated := stablePrefix + symbolOut and currentConstrainedOut := symbolOut,
//   so the suffix of generated of length |currentConstrainedOut| is exactly
//   currentConstrainedOut.
//
// cost accounting: `cost` is kept at 0 throughout the loop and assigned only at
//   the end as `cost := steps`. The loop variable `steps` is incremented by
//   exactly the amount of work done: by `stepsUsed` after UnconstrainedChunk, by
//   1 after CloseConstrainedSpan, by 1 after ConstrainedStep, and by `stepsUsed`
//   after ConstrainedSymbol. The added guard `0 < stepTokenBudget` ensures the
//   symbol helper is only called when its precondition holds; otherwise the
//   fallback branch uses the already-accounted single-step update.
//
// progress bound: In the chunk branch, UnconstrainedChunk appends at most
//   `stepsUsed` tokens and we do `steps := steps + stepsUsed`, so
//   |generated| <= |generatedPrefix| + steps is preserved. In the close branch,
//   one delimiter token is appended and steps increases by 1. In the tight
//   branch, either EOS causes an immediate break after steps += 1, or one token
//   is appended by AppendConstrainedToken and steps increases by 1. In the
//   loose symbol branch, the accepted symbol extends the constrained suffix by
//   at most `stepsUsed` tokens and we increase steps by that same `stepsUsed`;
//   with the guarded call, the loop can maintain `steps <= maxSteps` and thus
//   the final generated-length and returned-cost bounds follow.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var narrowThreshold: nat := 12;
var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpenSpan {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= narrowThreshold || stepTokenBudget == 0 {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var symbolOut, hitEos, stepsUsed := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, stepTokenBudget, eosToken
        );
        generated := stablePrefix + symbolOut;
        insideConstrainedOut := true;
        currentConstrainedOut := symbolOut;
        steps := steps + stepsUsed;
        if hitEos {
          break;
        }
      }
    }
  }
}

cost := steps;

