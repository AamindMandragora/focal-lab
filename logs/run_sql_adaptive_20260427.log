Strategy: // CSD_RATIONALE_BEGIN
// The last strategy proved that grammar-constrained decoding can keep syntax at
// 100%, but the evaluation failures show a different problem: it was still too
// eager to settle on short, generic SQL prefixes. The repeated anonymized preview
// `SELECT AVG` is a strong signal that the decoder was following the model's most
// common high-probability SQL openings without enough pressure to continue toward
// a question-specific full query. In Spider, many examples require joins, where
// clauses, grouping, ordering, or nested structure; a strategy that happily
// closes once a short complete query is available will score very poorly even if
// every output is grammatical.
//
// This revision therefore changes the constrained policy from "grow valid SQL and
// close when complete enough" to "stay constrained for the whole SQL answer and
// explicitly resist premature closure while the parser still has many valid next
// moves." Concretely:
//
// 1. We still allow unconstrained generation only until the benchmark-required
//    `<<` delimiter is reached.
// 2. Once inside the constrained SQL span, we decode one constrained token at a
//    time using `ConstrainedStep`, which lets us inspect the chosen token and the
//    parser state after each step.
// 3. If the parser says the current SQL prefix is complete but there are still
//    several valid continuations, we do NOT close yet. Instead we keep growing.
//    This directly targets the observed collapse to tiny generic queries.
// 4. We close only when the SQL prefix is complete and one of the following holds:
//    (a) the constrained prefix is already fairly substantial, or
//    (b) the parser's valid-next-token count is very small, indicating that the
//        query is naturally near termination, or
//    (c) we are at the step budget boundary and must finish.
// 5. Dead-end rollback is retained as a repair path, but the main improvement is
//    the anti-premature-closure rule, not rollback.
// 6. EOS remains terminal everywhere.
//
// The intended effect is to preserve the perfect syntax behavior while pushing
// the model to elaborate beyond generic `SELECT AVG ...` skeletons into more
// complete schema- and question-specific SQL before emitting `>>`.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, either we stay outside the span
//   (vacuous) or OpenConstrainedSpan enters with empty constrained content, which
//   is valid. In the rollback branch, RollbackConstrainedSpan returns a valid
//   constrained prefix. In the constrained-step branch, ConstrainedStep returns a
//   token sequence that remains a valid parser prefix; rebuilding generated from
//   the stable prefix plus that returned constrained prefix preserves validity.
//   In the close branch, insideConstrainedOut becomes false, so the implication is
//   vacuous.
// suffix: Outside the span the property is vacuous. Opening creates empty
//   constrained content, so the suffix of length 0 matches. Rollback updates
//   generated and currentConstrainedOut together so that the constrained suffix is
//   restored. ConstrainedStep extends currentConstrainedOut, and generated is
//   reassigned to stablePrefix + currentConstrainedOut, so the suffix equality
//   holds by construction. Closing exits constrained mode, making the implication
//   vacuous.
// cost accounting: The returned cost is `steps`. UnconstrainedChunk appends
//   `stepsUsed` tokens and the loop adds exactly `stepsUsed` to `steps`.
//   OpenConstrainedSpan and CloseConstrainedSpan each append one delimiter token
//   and the loop adds 1. ConstrainedStep bumps helper cost by 1 and the loop adds
//   exactly 1 to `steps`. Rollback and parser queries are pure and do not change
//   `steps`.
// progress: UnconstrainedChunk appends `stepsUsed` tokens and `steps` increases by
//   `stepsUsed`. OpenConstrainedSpan and CloseConstrainedSpan each append exactly
//   one token and increment `steps` by 1. ConstrainedStep appends exactly one
//   constrained token and the loop increments `steps` by 1. Rollback only shortens
//   or preserves generated, so `|generated| <= |generatedPrefix| + steps` remains
//   true. Break branches perform no further mutation.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var openTok: Token := "<<";
var minCloseLen: nat := 40;
var nearEndChoices: nat := 2;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remaining := maxSteps - steps;
    if remaining == 0 {
      break;
    } else {
      var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
        lm, prompt, generated, remaining, openTok, eosToken
      );
      generated := chunkGenerated;
      steps := steps + stepsUsed;
      if stoppedOnEos {
        break;
      } else {
        if stoppedOnOpenSpan && steps < maxSteps {
          var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
          generated := openedGenerated;
          insideConstrainedOut := openedInside;
          currentConstrainedOut := openedCurrent;
          steps := steps + 1;
        }
      }
    }
  } else {
    var deadEnd := helpers.DeadEndDetection(parser, currentConstrainedOut, 0);
    if deadEnd {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var repairedGenerated, repairedCurrent := helpers.RollbackConstrainedSpan(
        parser, stablePrefix, generated, currentConstrainedOut
      );
      generated := repairedGenerated;
      currentConstrainedOut := repairedCurrent;
    } else {
      var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var remaining2 := maxSteps - steps;

      if completeNow && (minCloseLen <= |currentConstrainedOut| || validCount <= nearEndChoices || remaining2 == 1) {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
        break;
      } else {
        if remaining2 == 0 {
          break;
        } else {
          var next := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
          if next == eosToken {
            break;
          } else {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
            steps := steps + 1;
          }
        }
      }
    }
  }
}

cost := steps;

