Strategy: // CSD_RATIONALE_BEGIN
// The evaluation showed the prior strategy achieved perfect syntax but very low
// task accuracy, with many outputs collapsing to short generic fragments such as
// `SELECT <id>`. That indicates the decoder was staying grammar-valid but was
// closing far too early on weak locally likely prefixes. For Spider, the parser's
// notion of "complete prefix" can admit many short SQL queries, but evaluation
// needs the semantically correct one for the question and schema. The revised
// strategy therefore changes the objective from "close as soon as complete" to
// "delay closure and force richer SQL content before allowing completion."
//
// Concretely, the method still canonicalizes the answer into a single
// constrained span by opening `<<` immediately and never emitting any
// unconstrained preamble. However, once inside the span it now uses a staged
// policy:
//
// 1. Early growth phase: while the constrained SQL is still short, the strategy
//    strongly penalizes EOS and also penalizes the top valid candidates when the
//    parser has only a tiny branching factor. This discourages the model from
//    greedily taking the shortest admissible query skeleton.
// 2. Middle phase: it continues token-by-token constrained decoding, but only
//    allows closure after a minimum SQL length has been reached and the prefix is
//    complete.
// 3. Dead-end repair: if the parser state is detected as too narrow, it rolls
//    back the constrained suffix to the longest valid prefix and resumes.
// 4. Completion phase: once the SQL is both parser-complete and long enough, it
//    immediately closes `>>` and stops, preserving the required wrapper format.
//
// The key fix relative to the failed attempt is the explicit anti-short-query
// bias: completion is gated by a minimum constrained length, and EOS is
// downweighted before that point. This directly targets the observed failure mode
// of emitting tiny but valid SQL fragments, while keeping every emitted token
// schema-valid and maintaining a simple proof story.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: OpenConstrainedSpan enters constrained mode with empty
//   constrained content, which is a valid prefix by precondition. In the rollback
//   branch, RollbackConstrainedSpan returns a valid constrained prefix by
//   construction. In the close branch, insideConstrainedOut becomes false, so the
//   implication is vacuous. In the sampling branch, either EOS causes an
//   immediate break without changing currentConstrainedOut, or
//   AppendConstrainedToken extends it by a token produced by ConstrainedStep,
//   which preserves parser validity.
// suffix: After opening, currentConstrainedOut is empty, so the suffix property
//   holds trivially. RollbackConstrainedSpan updates generated and
//   currentConstrainedOut coherently to the same valid constrained suffix.
//   Closing leaves constrained mode, making the implication vacuous. Appending a
//   constrained token adds the same token to generated and currentConstrainedOut,
//   preserving the suffix equality.
// cost accounting: The loop maintains `cost == 0` and returns `cost := steps`.
//   OpenConstrainedSpan and CloseConstrainedSpan each correspond to one counted
//   step, so the body increments `steps` by 1 there. The constrained sampling
//   branch uses one ConstrainedStep and increments `steps` by 1; if EOS is
//   sampled, the loop breaks immediately after that counted step. Rollback is a
//   pure repair action and does not change steps.
// progress bound: OpenConstrainedSpan appends one token and increments steps by
//   1. RollbackConstrainedSpan only shortens or preserves generated, so the bound
//   remains true without changing steps. CloseConstrainedSpan appends one token
//   and increments steps by 1. In the constrained sampling branch, either one
//   token is appended and steps increases by 1, or EOS causes a break after
//   steps increases by 1 with no growth in generated. Thus
//   `|generated| <= |generatedPrefix| + steps` is preserved in every branch.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var minCloseLen: nat := 12;
var deadEndThreshold: nat := 0;
var tinyBranchThreshold: nat := 2;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow && minCloseLen <= |currentConstrainedOut| {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else {
      var deadEnd := helpers.DeadEndDetection(parser, currentConstrainedOut, deadEndThreshold);
      if deadEnd {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var repairedGenerated, repairedCurrent := helpers.RollbackConstrainedSpan(
          parser, stablePrefix, generated, currentConstrainedOut
        );
        generated := repairedGenerated;
        currentConstrainedOut := repairedCurrent;
      } else {
        var stablePrefix2 := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt := prompt + stablePrefix2;

        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);

        if |currentConstrainedOut| < minCloseLen {
          helpers.PenalizeTokenLogits(lm, [eosToken], 100.0);
          var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
          if validCount <= tinyBranchThreshold {
            var candidates := helpers.TopValidCandidates(
              lm, parser, constrainedPrompt, currentConstrainedOut, 3, eosToken
            );
            helpers.PenalizeTokenLogits(lm, candidates, 3.0);
          }
        }

        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

