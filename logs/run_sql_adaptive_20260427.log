Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL benefits from treating the SQL query as one constrained
// span whose contents must stay inside a schema-specialized SQL grammar. The
// strategy tracks three pieces of state: the full emitted text `generated`, a
// flag `insideConstrainedOut` saying whether we are currently inside the SQL
// span, and `currentConstrainedOut`, the delimiter-free SQL prefix currently
// being validated by the parser.
//
// Outside the constrained span, generation is chunked: we let the model emit
// several free tokens at once until it either reaches EOS or the opening
// delimiter "<<". This is efficient for the natural-language preamble or any
// prompt-format scaffolding. Once inside the SQL span, the strategy adapts to
// parser narrowness. If the grammar is narrow (few valid next tokens, or a
// dead-end warning), it uses tight token-level constrained decoding
// (`ConstrainedStep`). If the grammar is wider, it uses `ConstrainedSymbol`
// with the provided token budget so the model can emit a longer SQL fragment
// naturally while still remaining within the parser's valid-prefix set.
//
// The tracked constrained prefix is always exactly the suffix of `generated`
// between delimiters. That suffix relationship is what lets us safely switch
// between chunked unconstrained generation, token-level constrained extension,
// symbol-level constrained extension, and parser-approved closing of the SQL
// span when the SQL query is complete.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, we either remain outside
//   the span (implication vacuous) or enter on stoppedOnOpen, where we set
//   currentConstrainedOut := []; parser.IsValidPrefix([]) holds by precondition.
//   In the complete-prefix branch, CloseConstrainedSpan sets insideConstrainedOut
//   to false, so the implication becomes vacuous. In the tight constrained
//   branch, ConstrainedStep returns either EOS (break, no state update) or a
//   parser-valid next token; AppendConstrainedToken therefore preserves
//   parser.IsValidPrefix. In the loose constrained branch, ConstrainedSymbol
//   returns a valid constrained prefix directly, so assigning
//   currentConstrainedOut := symbolOut preserves validity.
// suffix: In the unconstrained chunk branch, if we stay outside the span the
//   implication is vacuous; if we enter on stoppedOnOpen we set
//   currentConstrainedOut := [], and the length-0 suffix of generated is [].
//   In the close branch, CloseConstrainedSpan appends the closing delimiter and
//   resets currentConstrainedOut to [], so the implication is vacuous. In the
//   tight branch, AppendConstrainedToken appends the same token to generated
//   and currentConstrainedOut. In the loose branch, with
//   stablePrefix := generated[..|generated| - |currentConstrainedOut|], we set
//   generated := stablePrefix + symbolOut and currentConstrainedOut := symbolOut,
//   so the final |symbolOut|-length suffix of generated is exactly symbolOut.
// cost accounting: `cost` stays 0 throughout the loop, so the loop invariant is
//   preserved trivially. Actual returned cost is assigned once at the end as
//   `cost := steps`. The loop maintains 0 <= steps <= maxSteps; every helper
//   branch increments steps by exactly the helper-reported work: +stepsUsed for
//   UnconstrainedChunk and ConstrainedSymbol, +1 for CloseConstrainedSpan and
//   ConstrainedStep. Break branches do not modify steps, so final cost <= maxSteps.
// progress: UnconstrainedChunk returns generatedOut with at most stepsUsed new
//   tokens, and we set steps := steps + stepsUsed, so
//   |generated| <= |generatedPrefix| + steps is preserved linearly. The close
//   branch appends one token and increments steps by 1. The tight constrained
//   branch either breaks on EOS immediately or appends exactly one token via
//   AppendConstrainedToken after steps := steps + 1. The loose branch replaces
//   the old constrained suffix by a longer valid prefix `symbolOut`; the number
//   of newly appended tokens is bounded by stepsUsed, and we increment steps by
//   that same stepsUsed. Thus every non-break branch preserves
//   |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var narrowThreshold: nat := 12;
var minValidCount: nat := 2;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpen, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, minValidCount);
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if narrow || validCount <= narrowThreshold || stepTokenBudget <= 1 {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var symbolOut, hitEos, stepsUsed := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, stepTokenBudget, eosToken
        );
        generated := stablePrefix + symbolOut;
        insideConstrainedOut := true;
        currentConstrainedOut := symbolOut;
        steps := steps + stepsUsed;
        if hitEos {
          break;
        }
      }
    }
  }
}

cost := steps;

