Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy over-optimized for parser-validity and minimum length,
// which produced grammatically correct but semantically impoverished SQL such as
// short `SELECT ...` skeletons. The evaluation trace strongly suggests the model
// was being forced into constrained decoding too early and then terminated as
// soon as any complete SQL became available. For Spider, that is the wrong bias:
// the natural-language question and schema often require several semantically
// informative choices before the correct query becomes likely.
//
// This revision changes the strategy in two major ways.
//
// First, it no longer opens the constrained span immediately. Instead it uses an
// unconstrained chunk to let the model emit its preferred answer framing until it
// reaches the `<<` token, which the benchmark requires. This preserves more of
// the model's native planning behavior before grammar pressure begins. If EOS is
// reached before `<<`, generation stops; otherwise the span is opened exactly
// once and all subsequent SQL is grammar-constrained.
//
// Second, once inside the constrained span, the strategy performs bounded
// multi-token constrained growth with `ConstrainedSymbol` rather than single-step
// greedy closure pressure. The span is only closed when the parser says the SQL
// prefix is complete and it has reached a more substantial minimum length. Before
// that point, complete prefixes are intentionally kept open. Dead-end rollback is
// retained as a repair mechanism, but the main decoding path is now "grow several
// valid tokens, then re-check completeness" rather than "sample one token and
// close at the first opportunity." This directly targets the observed failure
// mode of collapsing to generic short queries.
//
// The resulting strategy is:
// 1. Outside a span, use `UnconstrainedChunk` to search for `<<` while preserving
//    the model's natural preamble behavior.
// 2. After `<<`, repeatedly ask `ConstrainedSymbol` for up to `stepTokenBudget`
//    valid constrained tokens at a time.
// 3. If the constrained prefix becomes complete and long enough, close with `>>`.
// 4. If a dead end is detected, roll back to a valid constrained prefix and keep
//    going.
// 5. EOS is always terminal.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained-chunk branch we remain outside the span,
//   so the implication is vacuous; if the chunk stops on `<<`, OpenConstrainedSpan
//   initializes an empty constrained prefix, which is valid. In the rollback
//   branch, RollbackConstrainedSpan returns a valid constrained prefix by
//   construction. In the constrained-growth branch, ConstrainedSymbol returns a
//   currentOut that is still a valid parser prefix; if EOS is hit we break
//   without changing it further. In the close branch, insideConstrainedOut becomes
//   false, so the implication is vacuous.
// suffix: Outside the span, the invariant is vacuous. Opening sets
//   currentConstrainedOut to empty, so the generated suffix of length 0 matches.
//   RollbackConstrainedSpan updates generated and currentConstrainedOut together
//   so that the constrained content is again exactly the suffix after the stable
//   prefix. ConstrainedSymbol extends the constrained content within generated in
//   lockstep, preserving suffix equality. Closing exits constrained mode, making
//   the implication vacuous.
// cost accounting: The method returns `cost := steps`. UnconstrainedChunk bumps
//   helper cost by `stepsUsed`, and the loop adds exactly `stepsUsed` to `steps`.
//   OpenConstrainedSpan and CloseConstrainedSpan each correspond to one generated
//   delimiter token and the loop increments `steps` by 1. ConstrainedSymbol
//   returns `stepsUsed`, and the loop adds exactly that amount. Rollback is pure
//   state repair and does not change steps.
// progress: UnconstrainedChunk appends `stepsUsed` tokens and the loop increases
//   `steps` by `stepsUsed`, so `|generated| <= |generatedPrefix| + steps` is
//   preserved. OpenConstrainedSpan and CloseConstrainedSpan each append exactly
//   one token and increment `steps` by 1. ConstrainedSymbol appends at most
//   `stepsUsed` tokens and the loop increments `steps` by `stepsUsed`; if it hits
//   EOS, the loop breaks immediately after that counted progress. Rollback only
//   shortens or preserves generated, so the bound remains true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var minCloseLen: nat := 24;
var openTok: Token := "<<";

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remaining := maxSteps - steps;
    if remaining == 0 {
      break;
    } else {
      var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
        lm, prompt, generated, remaining, openTok, eosToken
      );
      generated := chunkGenerated;
      steps := steps + stepsUsed;
      if stoppedOnEos {
        break;
      } else {
        if stoppedOnOpenSpan && steps < maxSteps {
          var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
          generated := openedGenerated;
          insideConstrainedOut := openedInside;
          currentConstrainedOut := openedCurrent;
          steps := steps + 1;
        }
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow && minCloseLen <= |currentConstrainedOut| {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else {
      var deadEnd := helpers.DeadEndDetection(parser, currentConstrainedOut, 0);
      if deadEnd {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var repairedGenerated, repairedCurrent := helpers.RollbackConstrainedSpan(
          parser, stablePrefix, generated, currentConstrainedOut
        );
        generated := repairedGenerated;
        currentConstrainedOut := repairedCurrent;
      } else {
        var remaining2 := maxSteps - steps;
        if remaining2 == 0 {
          break;
        } else {
          var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
          var budget := stepTokenBudget;
          if remaining2 < budget {
            budget := remaining2;
          }
          if budget == 0 {
            break;
          } else {
            var grownCurrent, hitEos, stepsUsed2 := helpers.ConstrainedSymbol(
              lm, parser, constrainedPrompt, currentConstrainedOut, budget, eosToken
            );
            generated := generated[..|generated| - |currentConstrainedOut|] + grownCurrent;
            currentConstrainedOut := grownCurrent;
            steps := steps + stepsUsed2;
            if hitEos {
              break;
            }
          }
        }
      }
    }
  }
}

cost := steps;

