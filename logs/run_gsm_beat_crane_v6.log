============================================================
Strategy: // CSD_RATIONALE_BEGIN
// Revised from the best prior strategy with two targeted changes aimed directly
// at the observed failures.
//
// Main diagnosis from the traces:
// 1. Many failures never opened a constrained span early enough, so the model
//    produced long free-form text or even a bare final answer with no << >>.
// 2. Many syntax failures came from constrained spans that grew too long before
//    completion.
//
// Changes:
// 1. Outside constrained mode, we now strongly encourage an early first "<<"
//    after a short warmup, and strongly discourage additional "<<" once one has
//    already appeared in generated. We still heavily penalize raw ">>" outside
//    constrained mode. This specifically targets missing/late constrained
//    segments while avoiding repeated openings.
// 2. Inside constrained mode, we switch from manual GenerateLogits +
//    BoostValidGroups + ConstrainedSample to AdaptiveConstrainedStep on the
//    stable prompt, with a much shorter span cap. This keeps the arithmetic
//    parser-valid, uses caller-supplied token groups only when the grammar is
//    narrow, and reduces malformed long spans.
// 3. If a constrained span becomes too long, we roll back to a valid prefix
//    rather than to a specific boundary token. This is a safer generic repair
//    for arithmetic syntax and avoids getting stuck when no "(" boundary exists.
// 4. As before, once the parser reports the constrained content is complete, we
//    close immediately via CloseConstrainedSpan and never wait for a literal
//    ">>" token from the model.
//
// Overall, this keeps the successful delimiter-steering idea from the previous
// best attempt, but makes first-span entry earlier and constrained spans shorter
// and more robust.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, either we remain outside constrained
//   mode, making the implication vacuous, or we open a span with
//   currentConstrainedOut := [], which is parser-valid by precondition. In the
//   close branch, CloseConstrainedSpan sets insideConstrainedOut to false. In
//   the rollback branch, RollbackToValidPrefix returns a parser-valid repaired
//   prefix and we assign it to currentConstrainedOut. In the adaptive
//   constrained branch, AdaptiveConstrainedStep returns either EOS or a token
//   that keeps currentConstrainedOut + [next] parser-valid, and
//   AppendConstrainedToken preserves that validity.
// suffix: In the outside branch, staying outside makes the implication vacuous;
//   opening a span sets currentConstrainedOut to [] after appending "<<", so the
//   suffix relation holds trivially. In the close branch we exit constrained
//   mode, so the implication is vacuous. In the rollback branch, repaired is a
//   prefix of the old constrained content, and trimming generated by exactly the
//   removed suffix preserves that generated ends with repaired. In the adaptive
//   constrained branch, AppendConstrainedToken appends the same token to both
//   generated and currentConstrainedOut, preserving the suffix relation.
// cost accounting: We return cost := steps. Every non-breaking branch increases
//   steps by exactly 1: the outside branch uses ChooseNextTokenUnconstrained and
//   manually bumps helpers.cost; the close branch uses CloseConstrainedSpan; the
//   rollback branch is query-only and therefore explicitly does
//   steps := steps + 1; the adaptive constrained branch uses
//   AdaptiveConstrainedStep. Breaking happens only immediately after a
//   cost-bumping helper or primitive sampling step, so cost <= maxSteps.
// progress: In the outside branch, generated grows by exactly 1 and steps grows
//   by 1. In the close branch, generated grows by at most 1 and steps grows by
//   1. In the rollback branch, generated shrinks or stays the same while steps
//   still grows by 1, so the bound is immediate. In the adaptive constrained
//   branch, EOS breaks immediately; otherwise exactly one token is appended and
//   steps grows by 1. Thus |generated| <= |generatedPrefix| + steps is
//   preserved, and every non-breaking branch strictly increases steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 10;
var sawOpen := "<<" in generated;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    if ">>" in lm.Tokens {
      helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
    }
    if "<<" in lm.Tokens {
      if sawOpen {
        helpers.PenalizeTokenLogits(lm, ["<<"], 20.0);
      } else {
        if |generated| < 4 {
          helpers.PenalizeTokenLogits(lm, ["<<"], 6.0);
        } else {
          helpers.BoostTokenLogits(lm, ["<<"], 10.0);
        }
      }
    }
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      if next == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        sawOpen := true;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if |currentConstrainedOut| >= stepTokenBudget + 3 {
        var repaired := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
        generated := generated[..|generated| - (|currentConstrainedOut| - |repaired|)];
        currentConstrainedOut := repaired;
        insideConstrainedOut := true;
        steps := steps + 1;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 6.0, narrowThreshold, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

