Strategy: // CSD_RATIONALE_BEGIN
// Revised strategy: make constrained arithmetic spans much more likely to be
// well-formed and much shorter, while avoiding accidental raw ">>" outside a
// constrained span.
//
// What changed from the previous attempt:
// 1. Outside constrained mode, we no longer use plain UnconstrainedStep. Instead
//    we manually generate logits, strongly penalize ">>", mildly penalize "<<"
//    at the very beginning, and boost "<<" once some explanatory text has been
//    produced. This directly targets the observed failures where the model
//    emitted stray closing delimiters outside a span or entered a span too early.
// 2. Inside constrained mode, we prefer a manual constrained sample with strong
//    group boosts and a targeted penalty on "<<". This keeps arithmetic content
//    parser-valid while discouraging nested openings and improving the chance of
//    concise valid expressions.
// 3. We close a constrained span immediately once the parser reports the span is
//    complete, never waiting for the model to emit a literal ">>" token itself.
//    This addresses malformed constrained content and truncated outputs.
// 4. We add a lightweight recovery branch for very long constrained spans: if
//    the active constrained content grows large, we roll back to a parser-valid
//    boundary and spend one step on recovery. This is aimed at the long failed
//    examples that wandered inside a span.
//
// Overall, the strategy is still delimiter-triggered, but now it actively
// steers delimiter behavior instead of passively hoping the unconstrained model
// places them correctly.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: Outside constrained mode, manual unconstrained sampling
//   either keeps insideConstrainedOut false or opens a new span with
//   currentConstrainedOut := [], and parser.IsValidPrefix([]) is assumed.
//   In the close branch, CloseConstrainedSpan sets insideConstrainedOut false,
//   so the implication is vacuous. In the recovery branch, RollbackToBoundary
//   returns a parser-valid repaired prefix, and we set currentConstrainedOut to
//   that repaired prefix. In the manual constrained-sampling branch,
//   ConstrainedSample guarantees either EOS or a token that keeps
//   currentConstrainedOut + [next] parser-valid, and AppendConstrainedToken
//   preserves that validity.
// suffix: Outside constrained mode, if we stay outside then the implication is
//   vacuous; if we open a span, currentConstrainedOut becomes [], which matches
//   the empty suffix of generated after appending "<<". In the close branch,
//   we leave constrained mode, so the implication is vacuous. In the recovery
//   branch, repaired is a prefix of the old currentConstrainedOut, and trimming
//   exactly |old|-|repaired| tokens from generated preserves that the suffix of
//   the trimmed generated equals repaired. In the manual constrained branch,
//   AppendConstrainedToken appends the same token to generated and
//   currentConstrainedOut, so the suffix relation is preserved.
// cost accounting: We return cost := steps. Every non-breaking branch increases
//   steps by exactly 1. The outside manual-sampling branch uses
//   ChooseNextTokenUnconstrained and then manually bumps helpers.cost; the close
//   branch uses CloseConstrainedSpan; the recovery branch is query-only and so
//   explicitly does steps := steps + 1; the constrained manual-sampling branch
//   uses ConstrainedSample and then either breaks on EOS or appends one token.
//   Thus cost <= maxSteps and every non-breaking iteration makes progress.
// progress bound: In the outside branch, generated grows by exactly 1 and
//   steps increases by 1. In the close branch, generated grows by at most 1 and
//   steps increases by 1. In the recovery branch, generated shrinks or stays
//   the same while steps still increases by 1, so the bound is immediate. In
//   the constrained manual branch, EOS breaks immediately; otherwise exactly one
//   token is appended and steps increases by 1. Therefore
//   |generated| <= |generatedPrefix| + steps is preserved in all branches.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var flatGroups := helpers.FlattenTokenGroups(validTokenGroups);

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    if ">>" in lm.Tokens {
      helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
    }
    if "<<" in lm.Tokens {
      if |generated| < 8 {
        helpers.PenalizeTokenLogits(lm, ["<<"], 8.0);
      } else {
        helpers.BoostTokenLogits(lm, ["<<"], 3.0);
      }
    }
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      if next == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if |currentConstrainedOut| >= stepTokenBudget + 8 {
        var repaired := helpers.RollbackToBoundary(parser, currentConstrainedOut, "(");
        generated := generated[..|generated| - (|currentConstrainedOut| - |repaired|)];
        currentConstrainedOut := repaired;
        insideConstrainedOut := true;
        steps := steps + 1;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        lm.GenerateLogits(prompt + stablePrefix + currentConstrainedOut);
        if |validTokenGroups| > 0 {
          helpers.BoostValidGroups(lm, parser, currentConstrainedOut, validTokenGroups, 8.0);
        }
        if "<<" in lm.Tokens {
          helpers.PenalizeTokenLogits(lm, ["<<"], 100.0);
        }
        var next := helpers.ConstrainedSample(lm, parser, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

