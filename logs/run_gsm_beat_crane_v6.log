Strategy: // CSD_RATIONALE_BEGIN
// Revised from the last actually successful strategy (attempt 3, 67% accuracy)
// with one primary fix aimed directly at the new catastrophic failures.
//
// Diagnosis from the failing traces:
// - The 0%-syntax run consistently opened a constrained span only near the end
//   of generation, then ran out of steps before closing it. The traces show
//   long unconstrained prefixes like "Let x = ..." followed by a late "<<"
//   and an unterminated arithmetic fragment.
// - So the main problem was not arithmetic validity inside spans; it was late
//   span entry caused by over-reliance on free unconstrained generation.
//
// Targeted changes:
// 1. Outside constrained mode, we now force much earlier entry into the first
//    constrained span. After a very short warmup, if "<<" is available we open
//    it directly with OpenConstrainedSpan instead of waiting for unconstrained
//    sampling to choose that token. This is the key fix for the observed
//    unterminated-span failures.
// 2. Before that short warmup, we still generate a little unconstrained text,
//    but we strongly penalize raw ">>" and mildly penalize early "<<". This
//    keeps the model from opening immediately at token 0 while still entering
//    early enough to leave budget for closing.
// 3. Inside constrained mode, we keep the previously strong design: close
//    immediately when the parser says the arithmetic span is complete; otherwise
//    use manual constrained sampling with valid-group boosts and a strong
//    penalty on "<<". This preserves the better-performing arithmetic behavior
//    from attempt 3.
// 4. We keep a short-span recovery branch, but make the cap tighter so that
//    malformed arithmetic fragments are rolled back sooner, again preserving
//    budget for a successful close.
// 5. After at least one constrained span has appeared, outside-mode generation
//    reverts to ordinary unconstrained sampling with ">>" still heavily
//    penalized and "<<" discouraged, to avoid repeatedly opening new spans.
//
// Overall, this is a small but decisive edit: force the first arithmetic span
// early, then retain the prior successful constrained decoding and immediate
// closing behavior.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, either we stay outside after an
//   unconstrained token, making the implication vacuous, or we force/open a new
//   span with currentConstrainedOut := [], which is parser-valid by the method
//   precondition. In the close branch, CloseConstrainedSpan sets
//   insideConstrainedOut to false, so the implication is vacuous. In the
//   rollback branch, RollbackToBoundary returns a parser-valid repaired prefix,
//   which we assign to currentConstrainedOut. In the constrained-sampling
//   branch, ConstrainedSample guarantees EOS or a parser-valid next token, and
//   AppendConstrainedToken preserves validity.
// suffix: In outside-mode unconstrained generation, remaining outside makes the
//   implication vacuous; in the forced-open/open branch, currentConstrainedOut
//   becomes [] after appending "<<", so the suffix relation holds trivially. In
//   the close branch we leave constrained mode, so the implication is vacuous.
//   In the rollback branch, repaired is a prefix of the old constrained suffix,
//   and trimming generated by exactly the removed amount preserves that the new
//   suffix equals repaired. In the constrained append branch, the same token is
//   appended to generated and currentConstrainedOut, preserving the suffix
//   equality.
// cost accounting: We return cost := steps. Every non-breaking branch increases
//   steps by exactly 1: outside unconstrained sampling uses
//   ChooseNextTokenUnconstrained plus a manual helpers.cost bump; forced opening
//   uses OpenConstrainedSpan; close uses CloseConstrainedSpan; rollback is
//   query-only so it explicitly increments steps; constrained sampling uses
//   ConstrainedSample and then either breaks on EOS or appends one token. Thus
//   cost <= maxSteps.
// progress: In the outside unconstrained branch, generated grows by exactly 1
//   and steps increases by 1. In the forced-open branch, generated grows by 1
//   and steps increases by 1. In the close branch, generated grows by at most 1
//   and steps increases by 1. In the rollback branch, generated shrinks or
//   stays the same while steps still increases by 1. In the constrained-sample
//   branch, EOS breaks immediately; otherwise exactly one token is appended and
//   steps increases by 1. Therefore |generated| <= |generatedPrefix| + steps is
//   preserved, and every non-breaking branch strictly advances the decreases
//   measure.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var sawOpen := "<<" in generated;
var warmup: nat := 3;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !sawOpen && "<<" in lm.Tokens && |generated| >= warmup {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      sawOpen := true;
      steps := steps + 1;
    } else {
      lm.GenerateLogits(prompt + generated);
      if ">>" in lm.Tokens {
        helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
      }
      if "<<" in lm.Tokens {
        if !sawOpen {
          if |generated| < warmup {
            helpers.PenalizeTokenLogits(lm, ["<<"], 6.0);
          } else {
            helpers.BoostTokenLogits(lm, ["<<"], 20.0);
          }
        } else {
          helpers.PenalizeTokenLogits(lm, ["<<"], 20.0);
        }
      }
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        if next == "<<" {
          var openedGenerated2, openedInside2, openedCurrent2 := helpers.OpenConstrainedSpan(lm, generated);
          generated := openedGenerated2;
          insideConstrainedOut := openedInside2;
          currentConstrainedOut := openedCurrent2;
          sawOpen := true;
        } else {
          generated := generated + [next];
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if |currentConstrainedOut| >= stepTokenBudget + 4 {
        var repaired := helpers.RollbackToBoundary(parser, currentConstrainedOut, "(");
        generated := generated[..|generated| - (|currentConstrainedOut| - |repaired|)];
        currentConstrainedOut := repaired;
        insideConstrainedOut := true;
        steps := steps + 1;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        lm.GenerateLogits(prompt + stablePrefix + currentConstrainedOut);
        if |validTokenGroups| > 0 {
          helpers.BoostValidGroups(lm, parser, currentConstrainedOut, validTokenGroups, 8.0);
        }
        if "<<" in lm.Tokens {
          helpers.PenalizeTokenLogits(lm, ["<<"], 100.0);
        }
        var next := helpers.ConstrainedSample(lm, parser, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

