Strategy: // CSD_RATIONALE_BEGIN
// Math-step CSD with delimiter-triggered constrained arithmetic spans.
// The strategy tracks the usual constrained-decoding state:
//   - generated: full output so far, including any delimiter tokens
//   - insideConstrainedOut: whether we are currently inside a << ... >> span
//   - currentConstrainedOut: only the contents of the active constrained span
//
// Outside a span, generation is unconstrained except that seeing "<<" opens a
// constrained arithmetic segment. Inside a span, the parser defines which next
// tokens keep the arithmetic computation syntactically valid. The strategy uses
// caller-supplied validTokenGroups to softly bias constrained decoding toward
// preferred arithmetic tokens via AdaptiveConstrainedStep when such groups are
// available, and otherwise falls back to ConstrainedStep. Once the parser says
// the span is complete, the strategy closes it immediately with ">>".
//
// This supports the task because free-form explanation text can be generated
// naturally outside delimiters, while every arithmetic computation inside
// << >> is parser-valid and therefore stays well-formed step by step.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if we do not open a span then
//   insideConstrainedOut stays false; if we do open on next == "<<", we set
//   currentConstrainedOut := [], and parser.IsValidPrefix([]) is a precondition.
//   In the close branch, CloseConstrainedSpan sets insideConstrainedOut to
//   false, so the implication is vacuous. In the constrained decoding branch,
//   both AdaptiveConstrainedStep and ConstrainedStep return either EOS (and we
//   break without changing state) or a parser-valid next token; AppendConstrainedToken
//   then preserves parser validity of currentConstrainedOut.
//
// suffix: In the unconstrained branch, when next != "<<" we remain outside the
//   span so the implication is vacuous; when next == "<<", we set the active
//   constrained content to [], and the length-0 suffix of generated matches [].
//   In the close branch, CloseConstrainedSpan appends the closing delimiter and
//   resets currentConstrainedOut to [], so the implication is again vacuous.
//   In the constrained decoding branch, AppendConstrainedToken appends the same
//   token to generated and currentConstrainedOut, preserving that the active
//   constrained content is exactly the suffix of generated.
//
// cost accounting: cost itself is kept at 0 during the loop and assigned
//   cost := steps at the end. Every non-breaking branch increments steps by 1:
//   UnconstrainedStep in the outside branch, CloseConstrainedSpan in the close
//   branch, and either AdaptiveConstrainedStep or ConstrainedStep in the inside
//   decoding branch. Break branches stop immediately after a cost-bumping helper,
//   so returning cost := steps is consistent and ensures cost <= maxSteps.
//
// progress bound: In the outside branch, we append exactly one token and do
//   steps := steps + 1, so |generated| grows by at most 1. In the close branch,
//   CloseConstrainedSpan appends at most one token and steps also grows by 1.
//   In the constrained decoding branch, on EOS we break with generated unchanged;
//   otherwise AppendConstrainedToken appends exactly one token and steps grows
//   by 1. Thus every non-breaking iteration preserves
//   |generated| <= |generatedPrefix| + steps, and decreases maxSteps - steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next: Token;
      if |validTokenGroups| > 0 {
        next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
      } else {
        var g, i, c, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
        );
        if hitEos {
          next := eosToken;
        } else {
          next := c[|c| - 1];
        }
      }
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

