Strategy: // CSD_RATIONALE_BEGIN
// Revised strategy in response to the evaluation traces:
// 1. The biggest failure was opening the first constrained span far too late or
//    not at all, causing long free-form reasoning and wrong final answers. So
//    outside constrained mode we now strongly encourage an early first "<<"
//    after only a short prefix, and we heavily penalize additional "<<" after
//    one has already appeared in generated. This aims for the target format
//    "step text + <<arithmetic>>" repeatedly instead of a long unconstrained
//    derivation.
// 2. Another major failure was malformed or overly long constrained content.
//    Inside constrained mode we now use AdaptiveConstrainedStep directly on the
//    stable prompt, with a short-span cap. If the span gets too long, we roll
//    back to a valid prefix and immediately spend a recovery step. This favors
//    short arithmetic snippets like "3 + 4" or "20 / 5".
// 3. To reduce accidental symbolic prose inside arithmetic spans, we flatten the
//    caller-supplied token groups and, when available, penalize tokens that were
//    rolled back from a dead-end prefix. This helps avoid repeating the same bad
//    constrained continuation.
// 4. We still close immediately whenever parser.IsCompletePrefix holds. This
//    directly targets unterminated spans and keeps each arithmetic computation
//    isolated inside its own << >> delimiters.
// Overall, the strategy is more aggressive about entering constrained mode
// early, more conservative about span length, and more resistant to repeating
// bad constrained continuations.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In unconstrained branches, either we stay outside (so the
// implication is vacuous), or OpenConstrainedSpan sets currentConstrainedOut to
// [], which is parser-valid by precondition. In the close branch we leave
// constrained mode, so the implication is vacuous. In the recovery branch,
// RollbackAndExclude returns a parser-valid repaired prefix, which we assign to
// currentConstrainedOut. In the adaptive constrained branch, next is either EOS
// or parser-valid after currentConstrainedOut, and AppendConstrainedToken
// preserves parser validity.
// suffix: In unconstrained branches, staying outside makes the implication
// vacuous; opening a span gives currentConstrainedOut == [], which is the empty
// suffix of generated after appending "<<". In the close branch we leave
// constrained mode, so the implication is vacuous. In the recovery branch,
// repaired is a prefix of the old constrained content, and trimming exactly the
// dropped suffix from generated preserves that the end of generated equals the
// repaired constrained prefix. In the adaptive constrained branch,
// AppendConstrainedToken appends the same token to generated and
// currentConstrainedOut, preserving the suffix relation.
// cost accounting: We return cost := steps. Every non-breaking branch increases
// steps by exactly 1. The unconstrained manual-sampling branches use
// ChooseNextTokenUnconstrained and manually bump helpers.cost. The close branch
// uses CloseConstrainedSpan, which is a cost-bumping helper, and we also
// increment steps by 1. The recovery branch is query-only except for optional
// penalized constrained sampling on the repaired prefix; regardless, it spends
// one loop step by setting steps := steps + 1, and if it samples then that
// helper already bumps helper cost. The adaptive constrained append branch uses
// AdaptiveConstrainedStep, then either breaks on EOS or appends one token.
// progress bound: In unconstrained branches, generated either grows by exactly 1
// token or by exactly 1 token via OpenConstrainedSpan, and steps increases by 1.
// In the close branch, generated grows by at most 1 and steps increases by 1.
// In the recovery branch, generated shrinks or stays the same while steps still
// increases by 1, so |generated| <= |generatedPrefix| + steps remains true. In
// the adaptive constrained branch, EOS breaks immediately; otherwise exactly one
// token is appended and steps increases by 1.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var flatGroups := helpers.FlattenTokenGroups(validTokenGroups);
var hasOpenedAny := Contains(generated, "<<");

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    if ">>" in lm.Tokens {
      helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
    }
    if "<<" in lm.Tokens {
      if hasOpenedAny {
        helpers.PenalizeTokenLogits(lm, ["<<"], 20.0);
      } else {
        if |generated| < 4 {
          helpers.PenalizeTokenLogits(lm, ["<<"], 4.0);
        } else {
          helpers.BoostTokenLogits(lm, ["<<"], 12.0);
        }
      }
    }
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      if next == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        hasOpenedAny := true;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if |currentConstrainedOut| >= stepTokenBudget + 3 || |currentConstrainedOut| >= 12 {
        var repaired, excludedTok, hasExcluded := helpers.RollbackAndExclude(parser, currentConstrainedOut, "(");
        generated := generated[..|generated| - (|currentConstrainedOut| - |repaired|)];
        currentConstrainedOut := repaired;
        insideConstrainedOut := true;
        steps := steps + 1;
        if steps < maxSteps {
          var repairedComplete := parser.IsCompletePrefix(currentConstrainedOut);
          if repairedComplete {
            // do nothing this iteration beyond recovery; next iteration will close
          } else {
            var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
            if hasExcluded && excludedTok in lm.Tokens {
              var penalizedNext := helpers.PenalizedConstrainedStep(
                lm, parser, prompt + stablePrefix, currentConstrainedOut, [excludedTok], 8.0, eosToken
              );
              if penalizedNext == eosToken {
                break;
              } else {
                var appendedGenerated1, appendedInside1, appendedCurrent1 := helpers.AppendConstrainedToken(
                  lm, parser, generated, currentConstrainedOut, penalizedNext
                );
                generated := appendedGenerated1;
                insideConstrainedOut := appendedInside1;
                currentConstrainedOut := appendedCurrent1;
              }
            }
          }
        }
      } else {
        var stablePrefix2 := generated[..|generated| - |currentConstrainedOut|];
        var next2 := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix2, currentConstrainedOut, validTokenGroups, 8.0, 12, eosToken
        );
        steps := steps + 1;
        if next2 == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next2
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

