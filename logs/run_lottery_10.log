Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy verified, but evaluation exposed a crucial mismatch:
// it sometimes emitted a raw "<<" token via unconstrained sampling instead of
// entering constrained mode through OpenConstrainedSpan. That broke the state
// correspondence between generated text and currentConstrainedOut, leading to
// textual openings that were not reliably closed and to malformed outputs such
// as `<<... >` or duplicated delimiters.
//
// The revised strategy fixes this by making delimiter production state-driven
// rather than sample-driven:
//
// 1. Outside constrained mode, the strategy never allows unconstrained sampling
//    to emit `<<` or `>>`. We explicitly penalize both delimiters in ordinary
//    text generation. The only way to produce `<<` is the dedicated
//    OpenConstrainedSpan helper, which simultaneously updates generated and the
//    constrained-state variables consistently.
// 2. Once inside constrained mode, the only way to produce `>>` is the dedicated
//    CloseConstrainedSpan helper, and only when
//    parser.IsCompletePrefix(currentConstrainedOut) already holds.
// 3. To ensure the required `<< >>` pattern actually appears often enough, we
//    use a simple one-shot policy: if we are outside constrained mode, have not
//    yet generated any constrained span in this call, and have enough remaining
//    budget to open, emit at least one constrained token, and close, then we
//    force an opening immediately. This avoids depending on the model to choose
//    `<<` on its own.
// 4. Inside constrained mode, closure has priority whenever legal. If the span
//    is incomplete and there is not enough remaining budget for one content step
//    plus a future close, we stop instead of risking an unterminated segment.
// 5. EOS remains terminal in every branch.
//
// This replacement directly targets the observed failures: no raw unconstrained
// delimiter emission, no duplicate or stray closers, and no opening unless the
// strategy itself can maintain and close the span.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the forced-open branch, OpenConstrainedSpan enters
//   constrained mode with empty tracked content, which is a valid parser
//   prefix. In unconstrained ordinary-token branches we stay outside, so the
//   implication is vacuous. In the inside-complete branch, CloseConstrainedSpan
//   exits constrained mode, again making the implication vacuous. In the inside
//   content branch, ConstrainedStep chooses a parser-valid next token (or EOS);
//   on the non-EOS path, AppendConstrainedToken extends the constrained prefix
//   while preserving parser validity.
// suffix: After OpenConstrainedSpan, the tracked constrained content is empty,
//   so the generated suffix of length 0 equals []. In unconstrained ordinary
//   generation we remain outside constrained mode, so the implication is
//   vacuous. In the close branch we exit constrained mode, so vacuous again. In
//   the constrained append branch, AppendConstrainedToken appends the same token
//   to generated and currentConstrainedOut, preserving that the tracked content
//   is exactly the suffix of generated.
// cost: The forced-open, close, and constrained-step branches each use a helper
//   that bumps helpers.cost once internally, and we increment steps once in the
//   same iteration. In the ordinary unconstrained branch we call
//   ChooseNextToken() and then manually increment helpers.cost once, followed by
//   steps := steps + 1. Query-only work and logit adjustments do not bump cost,
//   and break branches do not increase either quantity, so helpers.cost <= steps
//   is preserved.
// progress: Every branch that changes generated appends at most one token and
//   then increments steps by exactly one: OpenConstrainedSpan adds `<<`,
//   CloseConstrainedSpan adds `>>`, unconstrained ordinary generation adds one
//   token, and AppendConstrainedToken adds one constrained token. Branches that
//   break do not grow generated. Therefore |generated| increases by at most one
//   per step, preserving |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;
var openedHere := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if steps + 2 > maxSteps {
        break;
      } else {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var nextConstrained := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextConstrained == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, nextConstrained
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  } else {
    if !openedHere && steps + 3 <= maxSteps {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedHere := true;
      steps := steps + 1;
    } else {
      lm.GenerateLogits(prompt + generated);
      helpers.PenalizeTokenLogits(lm, ["<<", ">>"], 100.0);
      var next := lm.ChooseNextToken();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
      }
    }
  }
}

cost := steps;

