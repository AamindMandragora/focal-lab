Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it could open a `<<` span opportunistically
// and then spend remaining budget inside the span without guaranteeing a later
// `>>`, producing unterminated arithmetic segments. To fix that, this strategy
// is deliberately conservative about opening constrained mode: it opens a span
// only when there is enough remaining budget to both emit at least one
// constrained token and then close the span on a later step.
// 
// Concretely, outside constrained mode we use ordinary unconstrained generation
// unless the model strongly signals `<<` (either the argmax is `<<` or its text
// contains `<<`) and there are at least 2 steps left after the current one.
// When we do open, we do so through `OpenConstrainedSpan`, keeping helper cost
// accounting aligned with actual generation.
// 
// Inside constrained mode, completion is prioritized: if the current constrained
// prefix is complete, we immediately call `CloseConstrainedSpan` before doing
// anything else. If it is not complete and only one step remains, we stop
// rather than risk leaving the span open. Otherwise we take exactly one
// constrained token step using `ConstrainedStep`; on EOS we stop immediately,
// and on a normal token we append it with `AppendConstrainedToken`.
// 
// This change directly targets the evaluation failure mode: every opened span is
// opened only with enough future budget to close, and closure is greedily
// preferred whenever legal. The result is a safer step-by-step math style that
// still produces `<< ... >>` arithmetic computations, but avoids unterminated
// constrained segments.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained non-opening branch we either stay
//   outside constrained mode or append an ordinary token while remaining
//   outside, so the implication is vacuous. In the opening branch,
//   OpenConstrainedSpan sets currentConstrainedOut to the empty constrained
//   content, which is a valid parser prefix. In the close branch,
//   CloseConstrainedSpan exits constrained mode, so the implication is vacuous.
//   In the constrained append branch, ConstrainedStep chooses a parser-valid
//   next token (or EOS); on the non-EOS path, AppendConstrainedToken preserves
//   parser validity.
// suffix: In the unconstrained non-opening branch, if we remain outside the
//   implication is vacuous. In the opening branch, generated gains the `<<`
//   delimiter while currentConstrainedOut becomes [], so the length-0 suffix
//   equals []. In the close branch, we leave constrained mode, making the
//   implication vacuous. In the constrained append branch,
//   AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, so the tracked constrained content remains exactly
//   the suffix.
// cost: In the unconstrained ordinary-token branch we use ChooseNextToken and
//   then manually bump helpers.cost once; steps is also incremented once. In
//   the opening branch, OpenConstrainedSpan bumps helpers.cost internally once,
//   and we increment steps once. In the close branch, CloseConstrainedSpan
//   bumps helpers.cost internally once, and we increment steps once. In the
//   constrained-step branch, ConstrainedStep bumps helpers.cost internally once;
//   AppendConstrainedToken is non-bumping; again steps increases once. Branches
//   that break before generation do not increase helpers.cost and therefore
//   preserve helpers.cost <= steps.
// progress: Every generating branch increments steps exactly once and appends at
//   most one token to generated: ordinary unconstrained emission appends one
//   token, opening appends `<<`, closing appends `>>`, and constrained append
//   appends one constrained token. Break branches append nothing. Therefore
//   after each iteration, |generated| grows by at most the one unit of progress
//   accounted for in steps, preserving |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if steps + 1 >= maxSteps {
        break;
      } else {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  } else {
    lm.GenerateLogits(prompt + generated);
    var top := helpers.GetHighestLogitToken(lm);

    if top == eosToken {
      break;
    } else {
      if (top == "<<" || Contains(top, "<<")) && steps + 2 < maxSteps {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        steps := steps + 1;
      } else {
        var next := lm.ChooseNextToken();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          generated := generated + [next];
          if next == "<<" {
            insideConstrainedOut := true;
            currentConstrainedOut := [];
          }
        }
      }
    }
  }
}

cost := steps;

