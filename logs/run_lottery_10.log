Strategy: // CSD_RATIONALE_BEGIN
// The prior strategy failed evaluation because it forced a constrained span
// almost immediately, before the model had produced any natural-language setup.
// Once inside, ConstrainedStep often drifted into long malformed prefixes that
// never became complete, so the span stayed open until budget exhaustion.
//
// This revision changes the policy substantially:
//
// 1. Delayed opening: outside constrained mode, we first generate a short
//    unconstrained prefix ("lead-in") and strongly suppress both delimiters.
//    This directly addresses the "entered_constrained_mode_too_early" failure.
// 2. Single short span: after that lead-in, we allow at most one constrained
//    span in this call. Inside the span, we cap its content length aggressively.
//    If the span is complete, we close immediately. If it is not complete and
//    the cap/budget would be exceeded, we stop rather than leaving a likely
//    malformed open span.
// 3. No raw delimiters outside: ordinary unconstrained sampling still heavily
//    penalizes `<<` and `>>`, so delimiter tokens are only emitted through
//    OpenConstrainedSpan and CloseConstrainedSpan, keeping state synchronized.
// 4. Budget-aware closure: we only open when enough budget remains to open,
//    emit at least one constrained token, and still have room to close later.
//    While inside, if only one step remains and the prefix is incomplete, we
//    break instead of appending more text that cannot be closed.
// 5. EOS remains terminal in all branches.
//
// The intended effect is to produce some ordinary reasoning text first, then a
// brief arithmetic span like `<<3+4=7>>`, and to avoid the previous pattern of
// opening immediately and getting stuck inside an unterminated constrained
// segment.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the delayed-open branch, OpenConstrainedSpan creates an
//   empty constrained prefix, which is valid. In ordinary unconstrained
//   branches we remain outside constrained mode, so the implication is vacuous.
//   In the close branch we exit constrained mode, again making the implication
//   vacuous. In the constrained-token branch, ConstrainedStep returns a valid
//   next token for the current constrained prefix (or EOS); on the non-EOS
//   path, AppendConstrainedToken preserves parser validity of the extended
//   prefix.
// suffix: After OpenConstrainedSpan, currentConstrainedOut is empty, so the
//   generated suffix of length 0 equals []. In ordinary unconstrained branches
//   we stay outside constrained mode, so the implication is vacuous. In the
//   close branch we exit constrained mode, so vacuous again. In the constrained
//   append branch, AppendConstrainedToken appends the same token to generated
//   and to the tracked constrained content, preserving the suffix relation.
// cost: OpenConstrainedSpan, CloseConstrainedSpan, and ConstrainedStep each
//   bump helpers.cost by 1 internally, and in those branches we also increment
//   steps by 1. In the ordinary unconstrained branch we call ChooseNextToken()
//   and then manually increment helpers.cost once before incrementing steps.
//   Query/logit-adjustment operations do not bump helpers.cost, and break
//   branches leave both quantities unchanged, so helpers.cost <= steps holds.
// progress: Each branch that modifies generated appends at most one token:
//   OpenConstrainedSpan adds `<<`, CloseConstrainedSpan adds `>>`, ordinary
//   unconstrained generation adds one token, and AppendConstrainedToken adds
//   one constrained token. In each such branch we increment steps by exactly
//   one; branches that break do not grow generated. Hence
//   |generated| <= |generatedPrefix| + steps is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;
var openedHere := insideConstrained;
var leadSteps := 0;
var constrainedLen := |currentConstrainedOut|;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant 0 <= leadSteps <= steps
  invariant 0 <= constrainedLen
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    constrainedLen := |currentConstrainedOut|;
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      constrainedLen := 0;
      steps := steps + 1;
    } else {
      if steps + 1 >= maxSteps {
        break;
      } else {
        if constrainedLen >= 8 {
          break;
        } else {
          var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
          var nextConstrained := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if nextConstrained == eosToken {
            break;
          } else {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, nextConstrained
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
            constrainedLen := |currentConstrainedOut|;
          }
        }
      }
    }
  } else {
    if !openedHere && leadSteps >= 6 && steps + 3 <= maxSteps {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedHere := true;
      constrainedLen := 0;
      steps := steps + 1;
    } else {
      lm.GenerateLogits(prompt + generated);
      helpers.PenalizeTokenLogits(lm, ["<<", ">>"], 100.0);
      var next := lm.ChooseNextToken();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        leadSteps := leadSteps + 1;
      }
    }
  }
}

cost := steps;

