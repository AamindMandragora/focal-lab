Strategy: // CSD_RATIONALE_BEGIN
// The evaluation failures show that merely reacting to a likely `<<` token is
// not enough: the model often opened a constrained segment and then wandered
// into invalid punctuation or ran out of budget before closure, yielding
// unterminated spans and zero syntax rate. The revised strategy therefore makes
// constrained generation completion-first and budget-gated more aggressively.
//
// Main changes:
// 1. Outside constrained mode, we only open a constrained span when there are at
//    least 3 steps remaining including the current one: one to emit `<<`, at
//    least one constrained content token, and one to emit `>>`.
// 2. Once inside constrained mode, we never spend the last remaining step on
//    content. If the constrained prefix is complete, we close immediately. If it
//    is incomplete and fewer than 2 future generation steps remain, we stop
//    rather than risk an unterminated span.
// 3. While inside constrained mode, we bias toward closure readiness by checking
//    parser completion before every content step, and we use only
//    `ConstrainedStep` plus `AppendConstrainedToken` for content growth. We do
//    not treat a raw sampled `">>"` as closure.
// 4. To improve the chance that arithmetic spans actually appear, outside
//    constrained mode we positively bias `<<` when there is enough remaining
//    budget, but still preserve EOS terminal behavior and exact cost tracking.
//
// This directly addresses the observed failure mode: every opened span is backed
// by enough remaining budget for content plus closure, and closure is always
// taken at the earliest legal moment.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-constrained ordinary-token branch we remain
//   outside constrained mode, so the implication is vacuous. In the opening
//   branch, OpenConstrainedSpan enters constrained mode with empty tracked
//   content, which is a valid parser prefix. In the inside complete branch,
//   CloseConstrainedSpan exits constrained mode, so the implication is vacuous.
//   In the inside content branch, ConstrainedStep returns a parser-allowed token
//   (or EOS); on the non-EOS path, AppendConstrainedToken preserves validity of
//   the constrained prefix.
// suffix: In outside-constrained branches the implication is vacuous unless we
//   open; after OpenConstrainedSpan the tracked constrained content is empty, so
//   the generated suffix of length 0 equals []. In the close branch we exit
//   constrained mode, making the implication vacuous. In the constrained append
//   branch, AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, preserving that currentConstrainedOut is exactly the
//   suffix of generated.
// cost: In the ordinary unconstrained branch we call ChooseNextToken and then
//   manually increment helpers.cost once; steps also increases by one. In the
//   opening, closing, and constrained-step branches, the respective helper
//   (OpenConstrainedSpan, CloseConstrainedSpan, ConstrainedStep) bumps
//   helpers.cost once internally, and we increment steps once. Query-only
//   branches and break branches do not increase helpers.cost, so helpers.cost <=
//   steps is preserved.
// progress: Each generating branch appends at most one token to generated and
//   increments steps by exactly one: opening adds `<<`, closing adds `>>`,
//   ordinary unconstrained generation adds one token, and constrained append
//   adds one constrained token. Branches that break add nothing. Hence
//   |generated| can grow by at most one per step, preserving
//   |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if steps + 2 > maxSteps {
        break;
      } else {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  } else {
    lm.GenerateLogits(prompt + generated);
    if steps + 3 <= maxSteps {
      helpers.BoostTokenLogits(lm, ["<<"], 8.0);
    }
    var top := helpers.GetHighestLogitToken(lm);

    if top == eosToken {
      break;
    } else {
      if (top == "<<" || Contains(top, "<<")) && steps + 3 <= maxSteps {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        steps := steps + 1;
      } else {
        var next := lm.ChooseNextToken();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          if next == "<<" {
            if steps + 2 <= maxSteps {
              generated := generated + [next];
              insideConstrainedOut := true;
              currentConstrainedOut := [];
            } else {
              break;
            }
          } else {
            generated := generated + [next];
          }
        }
      }
    }
  }
}

cost := steps;

