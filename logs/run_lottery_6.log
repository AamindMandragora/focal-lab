Strategy: // CSD_RATIONALE_BEGIN
// Revised strategy: the previous attempt let unconstrained prose and symbolic
// variable names leak into arithmetic spans, which hurt syntax rate and slowed
// decoding. This version is much more decisive about constrained generation.
// Outside a constrained span, we still decode normally, but we strongly bias
// toward opening "<<" whenever it is competitive, so arithmetic is likely to be
// emitted inside delimiters. Inside a constrained span, we never use a raw
// sampled token unless it is first checked parser-valid; otherwise we fall back
// immediately to ConstrainedStep. We also avoid symbolic/open-ended arithmetic
// by aggressively steering toward parser-valid top candidates and by closing as
// soon as the constrained prefix is complete. This directly targets the observed
// failures where spans started with invalid text like variable names or were
// left malformed.
// 
// Concretely, compared with the previous attempt: (1) opening a constrained
// span is more strongly encouraged outside spans; (2) inside spans, the fast
// path only appends a token after validating the sampled token, and otherwise
// uses constrained decoding instead of silently stalling; (3) if the parser
// reports a dead end or very few valid continuations, we rely on the
// constrained helper immediately; and (4) complete constrained expressions are
// closed immediately, never because a sampled token merely resembles ">>".
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In unconstrained branches, either we stay outside a span, so
// the implication is vacuous, or we open a span with currentConstrainedOut := [],
// which is valid by the precondition parser.IsValidPrefix([]). In the close
// branch, CloseConstrainedSpan sets insideConstrainedOut false, so the
// implication is vacuous. In constrained append branches, we only call
// AppendConstrainedToken with a token already shown valid by
// IsTokenValidNext or returned by ConstrainedStep, so validity is preserved.
// 
// suffix: While outside a span, the implication is vacuous. Opening a span
// appends "<<" to generated and sets currentConstrainedOut := [], so the
// length-0 suffix matches []. Closing a span resets currentConstrainedOut := []
// and leaves us outside, so the implication is vacuous. Any constrained append
// uses AppendConstrainedToken, which appends the same token to generated and
// currentConstrainedOut, preserving the suffix equality.
// 
// cost: In the unconstrained helper branch, UnconstrainedStep bumps
// helpers.cost internally and we increment steps once. In the eager-open branch
// and constrained fast path, we use ChooseNextTokenUnconstrained and manually
// increment helpers.cost once, then increment steps once. In the constrained
// fallback and close branches, ConstrainedStep and CloseConstrainedSpan bump
// helpers.cost internally and we increment steps once. Query helpers do not
// change helpers.cost. Hence helpers.cost <= steps is preserved.
// 
// progress: steps starts at 0 and increases by exactly 1 on every loop
// iteration that performs work. Unconstrained branches append at most one token
// to generated, opening a span also appends only one token, constrained append
// branches append one token, and closing appends only the closing delimiter,
// again one token. Break-on-EOS does not increase generated after the step.
// Therefore |generated| grows by at most 1 per iteration, preserving
// |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var top := helpers.GetHighestLogitToken(lm);
    var topLogit := helpers.GetTokenLogit(lm, top);
    var openLogit := helpers.GetTokenLogit(lm, "<<");

    if top != eosToken && openLogit >= topLogit - 1.0 {
      helpers.BoostTokenLogits(lm, ["<<"], 100.0);
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else if next == "<<" {
        generated := generated + [next];
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        generated := generated + [next];
      }
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else if next == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
