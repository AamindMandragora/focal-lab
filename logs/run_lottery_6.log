Strategy: // CSD_RATIONALE_BEGIN
// The prior strategy failed because it forced entry into constrained mode at the
// very start of generation. That created two evaluation problems at once: the
// output began with `<<` too early, and once inside the constrained parser the
// model often wandered for many steps without ever reaching a complete prefix,
// so `>>` was rarely emitted.
//
// This revision delays constrained decoding until the model itself signals an
// arithmetic step by proposing a token that contains `<<`. Outside constrained
// mode, we therefore use ordinary unconstrained generation, which avoids the
// "entered too early" failure. Inside constrained mode, we keep the parser-valid
// constrained content growing token by token; but if the constrained prefix
// reaches a dead end or there are no valid continuations, we roll back to the
// nearest valid prefix and, when that rolled-back prefix is complete, close the
// span immediately. This directly targets the "unterminated segment" failure by
// preferring closure as soon as completion is available rather than continuing
// to sample indefinitely.
//
// The strategy is thus: generate normally until a `<<` token is actually chosen;
// then stay parser-guided, closing as soon as complete, breaking on EOS, and
// using rollback-to-valid-prefix to recover from dead ends so that `>>` can be
// emitted within the step budget.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, UnconstrainedStep either keeps us
// outside constrained mode or transitions via the helper into a fresh valid
// constrained state, so validity is preserved. In the inside-complete branch,
// CloseConstrainedSpan makes insideConstrainedOut false, so the implication is
// vacuous. In the rollback branch, RollbackToValidPrefix returns a valid prefix;
// if it is complete we close immediately, otherwise we remain inside with that
// valid rolled prefix. In the normal constrained-step branch, ConstrainedStep
// supplies a parser-valid next token and AppendConstrainedToken preserves
// validity.
//
// suffix: Outside constrained mode the invariant is vacuous unless
// UnconstrainedStep enters constrained mode, in which case the helper sets the
// tracked constrained content to the generated suffix by construction. Closing
// a complete span makes insideConstrainedOut false, so the implication becomes
// vacuous. In the rollback branch we simultaneously rewrite generated to drop
// the invalid tail and set currentConstrainedOut to the rolled prefix, so the
// constrained content is again exactly the suffix. In the append branch,
// AppendConstrainedToken extends both generated and currentConstrainedOut by the
// same token, preserving suffix alignment.
//
// cost: Each loop iteration performs exactly one cost-bumping helper call:
// UnconstrainedStep, CloseConstrainedSpan, or ConstrainedStep. Query helpers and
// RollbackToValidPrefix are non-bumping. We increment steps exactly once in each
// iteration after the bumping helper call, so helpers.cost <= steps is
// preserved in every branch.
//
// progress: UnconstrainedStep appends at most one token, so generated grows by
// at most one when steps increases by one. CloseConstrainedSpan appends only the
// closing delimiter token, again at most one token for one step. In the rollback
// branch, replacing generated by a shorter prefix cannot violate the upper
// bound; if we then close, that adds at most one token in the same stepped
// iteration. In the normal constrained-step branch, eosToken causes a break with
// no append, while AppendConstrainedToken adds exactly one token, so
// |generated| <= |generatedPrefix| + steps remains true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if Contains(next, "<<") {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        insideConstrainedOut := false;
        currentConstrainedOut := [];
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if validCount == 0 || narrow {
        var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
        generated := generated[..|generated| - |currentConstrainedOut|] + rolled;
        currentConstrainedOut := rolled;
        var rolledComplete := parser.IsCompletePrefix(currentConstrainedOut);
        if rolledComplete {
          var closedGenerated2, closedInside2, closedCurrent2 := helpers.CloseConstrainedSpan(
            lm, parser, generated, currentConstrainedOut
          );
          generated := closedGenerated2;
          insideConstrainedOut := closedInside2;
          currentConstrainedOut := closedCurrent2;
          steps := steps + 1;
        } else {
          var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
          var next2 := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if next2 == eosToken {
            break;
          } else {
            var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next2
            );
            generated := appendedGenerated2;
            insideConstrainedOut := appendedInside2;
            currentConstrainedOut := appendedCurrent2;
          }
        }
      } else {
        var constrainedPrompt2 := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next3 := helpers.ConstrainedStep(lm, parser, constrainedPrompt2, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next3 == eosToken {
          break;
        } else {
          var appendedGenerated3, appendedInside3, appendedCurrent3 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next3
          );
          generated := appendedGenerated3;
          insideConstrainedOut := appendedInside3;
          currentConstrainedOut := appendedCurrent3;
        }
      }
    }
  }
}

cost := steps;

