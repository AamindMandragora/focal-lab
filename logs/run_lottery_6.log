Strategy: // CSD_RATIONALE_BEGIN
// The evaluation failures show that waiting for the model to naturally emit a
// token containing `<<` is too brittle: it often emits a lone `<` or begins an
// arithmetic span without ever reaching a parser-complete state, so `>>` is
// never produced. To fix that, this strategy takes explicit control of span
// boundaries.
//
// Outside constrained mode, we still generate normally unless we see a strong
// signal that arithmetic is starting: either the sampled token already contains
// `<<`, or it contains `<`, or it contains arithmetic-looking characters such as
// digits or operator symbols. In any of those cases, we immediately open a
// constrained span with `OpenConstrainedSpan`, which guarantees the literal `<<`
// is inserted as a proper delimiter token rather than relying on the model to
// finish it.
//
// Once inside constrained mode, we prioritize termination. If the constrained
// prefix is complete, we close immediately with `CloseConstrainedSpan`; we never
// keep sampling after completeness. Otherwise we take a parser-guided
// `ConstrainedStep`, append the token, and on the next iteration re-check for
// completion. If the constrained prefix becomes narrow or has no valid
// continuations, we roll back to the nearest valid prefix; if that rolled prefix
// is complete we close immediately, otherwise we continue from the repaired
// prefix. This design directly targets the observed unterminated-span failures:
// opening is explicit, and closing happens as soon as the parser allows it.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the plain outside branch, we remain outside and set
// currentConstrainedOut to [], so the implication is vacuous. In the outside
// branch that opens a span, OpenConstrainedSpan establishes a fresh valid
// constrained prefix. In the inside-complete branch, CloseConstrainedSpan exits
// constrained mode, making the implication vacuous. In the rollback branch,
// RollbackToValidPrefix returns a valid prefix; if it is complete we close,
// otherwise we stay inside with that valid prefix. In the normal constrained
// branch, ConstrainedStep chooses a parser-valid next token and
// AppendConstrainedToken preserves validity.
//
// suffix: While outside constrained mode the invariant is vacuous. When we open
// a span, OpenConstrainedSpan sets generated and currentConstrainedOut so that
// the tracked constrained content is exactly the generated suffix. Closing a
// complete span makes insideConstrainedOut false, so the implication is vacuous.
// In rollback, we replace generated by its unconstrained prefix plus the rolled
// constrained prefix, so the suffix again matches currentConstrainedOut. In the
// append branch, AppendConstrainedToken extends generated and
// currentConstrainedOut in lockstep, preserving the suffix relation.
//
// cost: Each stepped iteration contains exactly one cost-bumping helper call:
// either UnconstrainedStep, OpenConstrainedSpan, CloseConstrainedSpan, or
// ConstrainedStep. Query helpers, RollbackToValidPrefix, and
// AppendConstrainedToken do not bump cost. We increment steps exactly once in
// the same iteration after the bumping helper, so helpers.cost <= steps is
// preserved.
//
// progress: In the plain outside branch, UnconstrainedStep appends at most one
// token, so generated grows by at most one when steps increases by one. In the
// outside-open branch, we discard the sampled trigger token and instead use
// OpenConstrainedSpan, which appends only the opening delimiter token, again at
// most one token for one step. CloseConstrainedSpan appends only the closing
// delimiter token. Rollback can only shorten generated before any possible
// close. In the constrained append branch, eosToken breaks without appending;
// otherwise AppendConstrainedToken adds one constrained token after the single
// stepped ConstrainedStep, so |generated| <= |generatedPrefix| + steps remains
// true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    if next == eosToken {
      steps := steps + 1;
      break;
    } else {
      var shouldOpen := Contains(next, "<<") || Contains(next, "<") || Contains(next, "0") || Contains(next, "1") ||
                        Contains(next, "2") || Contains(next, "3") || Contains(next, "4") || Contains(next, "5") ||
                        Contains(next, "6") || Contains(next, "7") || Contains(next, "8") || Contains(next, "9") ||
                        Contains(next, "+") || Contains(next, "-") || Contains(next, "*") || Contains(next, "/") ||
                        Contains(next, "=");
      if shouldOpen {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        steps := steps + 1;
      } else {
        generated := generated + [next];
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        steps := steps + 1;
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if validCount == 0 || narrow {
        var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
        generated := generated[..|generated| - |currentConstrainedOut|] + rolled;
        currentConstrainedOut := rolled;
        var rolledComplete := parser.IsCompletePrefix(currentConstrainedOut);
        if rolledComplete {
          var closedGenerated2, closedInside2, closedCurrent2 := helpers.CloseConstrainedSpan(
            lm, parser, generated, currentConstrainedOut
          );
          generated := closedGenerated2;
          insideConstrainedOut := closedInside2;
          currentConstrainedOut := closedCurrent2;
          steps := steps + 1;
        } else {
          var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
          var next2 := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if next2 == eosToken {
            break;
          } else {
            var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next2
            );
            generated := appendedGenerated2;
            insideConstrainedOut := appendedInside2;
            currentConstrainedOut := appendedCurrent2;
          }
        }
      } else {
        var constrainedPrompt2 := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next3 := helpers.ConstrainedStep(lm, parser, constrainedPrompt2, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next3 == eosToken {
          break;
        } else {
          var appendedGenerated3, appendedInside3, appendedCurrent3 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next3
          );
          generated := appendedGenerated3;
          insideConstrainedOut := appendedInside3;
          currentConstrainedOut := appendedCurrent3;
        }
      }
    }
  }
}

cost := steps;

