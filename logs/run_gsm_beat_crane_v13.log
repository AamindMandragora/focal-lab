// CSD_RATIONALE_BEGIN
// Step-by-step math CSD with delimiter-sensitive modes. The strategy tracks
// whether generation is currently inside an arithmetic span (`insideConstrainedOut`)
// and, when it is, the exact constrained contents between `<<` and `>>`
// (`currentConstrainedOut`). Outside spans it generates freely, but as soon as
// it sees the opening delimiter token `"<<"` it switches to parser-constrained
// decoding so the arithmetic content stays parser-valid.
//
// Inside a constrained span, the strategy chooses between two verified actions
// based on local structure. If the parser says the span is complete, it closes
// the span immediately with `CloseConstrainedSpan`. Otherwise it uses
// `AdaptiveConstrainedStep` with the caller-supplied `validTokenGroups` to
// softly favor preferred arithmetic tokens when the parser's valid-next set is
// narrow, while still hard-masking to parser-valid continuations plus EOS.
// This tracked state ensures that the constrained suffix of `generated` always
// matches `currentConstrainedOut`, which is exactly what lets the parser govern
// the contents of each `<< ... >>` arithmetic derivation.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if the sampled token is not
//   `"<<"` we remain outside the span, so the implication is vacuous; if it is
//   `"<<"` we set `currentConstrainedOut := []`, and `parser.IsValidPrefix([])`
//   holds by precondition. In the close branch, `CloseConstrainedSpan` returns
//   `insideConstrainedOut == false`, again making the implication vacuous. In
//   the adaptive constrained branch, `AdaptiveConstrainedStep` guarantees either
//   EOS or a token whose append preserves parser validity; on non-EOS we call
//   `AppendConstrainedToken`, whose precondition is exactly that validity fact.
// suffix: In the unconstrained branch, when we stay outside the span the suffix
//   invariant is vacuous; when we open a span on `"<<"`, we set
//   `currentConstrainedOut := []`, and the length-0 suffix of `generated` is
//   `[]`. In the close branch, `CloseConstrainedSpan` appends at most the close
//   delimiter and resets `currentConstrainedOut` to `[]`, so the implication is
//   vacuous afterward. In the adaptive constrained branch, the sampled non-EOS
//   token is appended to both `generated` and `currentConstrainedOut` via
//   `AppendConstrainedToken`, so the generated suffix continues to equal the
//   constrained prefix.
// cost accounting: We use a local `steps` counter and increment it exactly once
//   for each cost-bumping helper call in the loop body: `UnconstrainedStep`,
//   `CloseConstrainedSpan`, or `AdaptiveConstrainedStep`. No branch uses only
//   non-bumping helpers without also doing such an increment, and the append
//   helper is non-bumping so it does not affect returned cost. Thus `cost := steps`
//   at the end yields `cost <= maxSteps`.
// progress bound: In the unconstrained branch, `UnconstrainedStep` appends at
//   most one token and we do `steps := steps + 1`, so
//   `|generated| <= |generatedPrefix| + steps` is preserved. In the close
//   branch, `CloseConstrainedSpan` appends at most one token and `steps` grows
//   by 1, preserving the same bound. In the adaptive constrained branch, EOS
//   breaks immediately after `steps` increases by 1 with no append; otherwise
//   `AppendConstrainedToken` appends exactly one token and `steps` has already
//   increased by 1, so the bound still holds. Therefore every non-breaking
//   branch strictly increases `steps`, satisfying `decreases maxSteps - steps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var boostAmount: real := 4.0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, boostAmount, narrowThreshold, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

