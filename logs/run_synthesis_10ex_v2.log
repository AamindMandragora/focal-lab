Strategy: // CSD_RATIONALE_BEGIN
// The evaluation failures show that merely allowing constrained spans is not enough:
// the model often opens `<<` and then emits symbolic or natural-language algebra
// (`frac_1 * n`, `x * k`) instead of concrete arithmetic, which hurts answer
// accuracy even when syntax is mostly valid. The revised strategy therefore makes
// constrained spans much more aggressive and completion-oriented:
//
// - Outside constrained mode, we explicitly bias toward opening a constrained span
//   whenever the next token is likely to be a delimiter or when the unconstrained
//   top token looks like it is drifting into symbolic math text. This increases
//   the chance that arithmetic gets produced inside `<< >>` rather than as free
//   text.
// - Inside constrained mode, we favor short, parser-complete arithmetic snippets.
//   If the current constrained prefix is complete, we immediately close it rather
//   than letting the model elaborate. If it is not complete, we use
//   ConstrainedStep and append exactly one parser-valid token.
// - We still never close merely because a sampled token resembles `>>`; closure is
//   only driven by parser completeness, satisfying the safety requirement.
// - EOS remains terminal in every mode.
//
// This change targets the observed failure mode of unfinished or symbolic spans by
// repeatedly steering generation into short valid arithmetic islands and closing
// them as soon as they are complete.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside/unconstrained branch, either we stay outside via
//   UnconstrainedStep (so the implication is vacuous) or we open a span with
//   OpenConstrainedSpan, which sets the constrained content to [] and thus valid by
//   parser.IsValidPrefix([]). In the inside branch, if the prefix is complete then
//   CloseConstrainedSpan exits constrained mode, making the implication vacuous;
//   otherwise ConstrainedStep followed by AppendConstrainedToken extends the current
//   constrained prefix by a parser-valid token, preserving validity. Break-on-EOS
//   branches leave the state unchanged.
// suffix: When we remain outside constrained mode, the implication is vacuous. On
//   OpenConstrainedSpan, generated gains only the delimiter while
//   currentConstrainedOut becomes [], so the empty suffix matches. On
//   CloseConstrainedSpan, constrained mode ends and the implication is vacuous. On
//   AppendConstrainedToken, the helper appends the same token to generated and to
//   currentConstrainedOut, so the suffix equality is preserved. EOS break branches
//   do not mutate generated/currentConstrainedOut.
// cost: The only cost-bumping helpers used are OpenConstrainedSpan,
//   UnconstrainedStep, ConstrainedStep, and CloseConstrainedSpan. In every branch
//   where one of these is called, steps is incremented exactly once in the same
//   iteration. Query/logit-adjustment helpers do not bump helpers.cost, and
//   AppendConstrainedToken also does not, so helpers.cost <= steps is preserved.
// progress: Each non-break branch appends at most one token to generated:
//   UnconstrainedStep appends one token, OpenConstrainedSpan appends one delimiter,
//   AppendConstrainedToken appends one constrained token, and CloseConstrainedSpan
//   appends one closing delimiter. In each such branch, steps increases by exactly
//   one, so |generated| <= |generatedPrefix| + steps remains true. Break branches
//   stop without further growth.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var nextIn := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if nextIn == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, nextIn);
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  } else {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 8.0);
    helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
    var best := helpers.GetHighestLogitToken(lm);
    var openNow := false;
    if best == "<<" {
      openNow := true;
    } else {
      if Contains(best, "<<") {
        openNow := true;
      } else {
        if Contains(best, "*") {
          openNow := true;
        } else {
          if Contains(best, "=") {
            openNow := true;
          } else {
            if Contains(best, "/") {
              openNow := true;
            }
          }
        }
      }
    }

    if openNow {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
      }
    }
  }
}

