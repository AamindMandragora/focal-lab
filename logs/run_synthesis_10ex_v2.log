Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy opened constrained spans opportunistically based on
// logits, which caused two evaluation problems: many generations never emitted
// any << >> pair at all, and some generations opened a span late and then ran
// out of steps before closing it. This revision makes delimiter behavior
// explicit and deterministic at the strategy level.
//
// Concretely: on the very first step, if we are not already inside a
// constrained span, we force-open one with helpers.OpenConstrainedSpan. That
// guarantees the output contains a << marker whenever maxSteps > 0. Once inside
// a span, we use parser-guided constrained generation, but we also bias toward
// early closure: if the current constrained prefix is complete, we immediately
// close with helpers.CloseConstrainedSpan. To avoid long or wandering spans
// that hurt syntax rate and runtime, we additionally cap the active constrained
// content length; once the span has reached a small bound and is complete, we
// close immediately, and if it reaches the bound without completeness we stop
// rather than appending more unconstrained junk. Outside constrained mode after
// the initial span, generation is simple unconstrained sampling with EOS as a
// hard stop.
//
// This design directly addresses the failures: it guarantees at least one
// constrained segment is opened, closes spans as soon as parser completeness is
// available, never calls CloseConstrainedSpan unless completeness is known, and
// avoids speculative long derivations that previously timed out or ended with
// unterminated spans.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the initial/opening branch we use OpenConstrainedSpan,
//   which enters constrained mode with currentConstrainedOut := [], a valid
//   parser prefix. In the outside/unconstrained branch we either stay outside
//   or stop on EOS, so the implication remains vacuous. In the inside-complete
//   branch, CloseConstrainedSpan exits constrained mode, again making the
//   implication vacuous. In the inside-append branch, the next token comes from
//   ConstrainedStep, and AppendConstrainedToken preserves validity of the
//   constrained prefix.
// suffix: Opening appends only the delimiter and sets currentConstrainedOut :=
//   [], so the empty suffix matches. Outside constrained mode the premise is
//   false. Closing resets currentConstrainedOut := [] and leaves us outside, so
//   the property is trivial. In the append branch, AppendConstrainedToken adds
//   the same token to generated and currentConstrainedOut, preserving the
//   suffix equality.
// cost: OpenConstrainedSpan, ConstrainedStep, and CloseConstrainedSpan each
//   bump helpers.cost by 1 internally, and in each such branch we also do
//   steps := steps + 1. In the raw unconstrained branch we manually increment
//   helpers.cost once after ChooseNextTokenUnconstrained and also increment
//   steps once. Branches that merely break do not increase helpers.cost after
//   the corresponding step increment, so helpers.cost <= steps is preserved.
// progress: Every iteration increments steps exactly once before any possible
//   break. Opening adds one token ("<<"); unconstrained sampling adds at most
//   one token and adds none on EOS; closing adds one token (">>"); constrained
//   append adds one token; the bounded-stop branch adds none. Thus generated
//   grows by at most one token per step, preserving |generated| <=
//   |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var openedAny := insideConstrained;
var maxConstrainedLen := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !openedAny && !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    openedAny := true;
    steps := steps + 1;
  } else {
    if insideConstrainedOut {
      var complete := parser.IsCompletePrefix(currentConstrainedOut);
      if complete {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
      } else {
        if |currentConstrainedOut| >= maxConstrainedLen {
          steps := steps + 1;
          break;
        } else {
          var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
          var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if next == eosToken {
            break;
          } else {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
          }
        }
      }
    } else {
      var next2 := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next2 == eosToken {
        break;
      } else {
        generated := generated + [next2];
      }
    }
  }
}

if insideConstrainedOut {
  var completeAtEnd := parser.IsCompletePrefix(currentConstrainedOut);
  if completeAtEnd && steps < maxSteps {
    var closedGenerated2, closedInside2, closedCurrent2 := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated2;
    insideConstrainedOut := closedInside2;
    currentConstrainedOut := closedCurrent2;
    steps := steps + 1;
  }
}

cost := steps;

