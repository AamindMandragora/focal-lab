// Math-step CSD with eager delimiter entry and parser-guided interior decoding.
// The strategy tracks the full generated output in `generated`, whether we are
// currently inside a constrained arithmetic span in `insideConstrainedOut`, and
// the contents of the active span (excluding delimiters) in
// `currentConstrainedOut`.
// Outside a span, it generates freely but also watches for arithmetic-looking
// tokens: if the sampled token contains "<<", or if the model already strongly
// prefers the explicit opening delimiter, it opens a constrained span so the
// arithmetic that follows can be parser-checked. Inside a span, it first tries
// the model argmax when that token is parser-valid, and otherwise falls back to
// `ConstrainedStep` to obtain a valid continuation. Once the parser reports the
// current constrained prefix is complete, it closes the span with `>>`.
// This tracked state supports valid generation because only parser-valid tokens
// are appended to `currentConstrainedOut`, and the suffix relation ties that
// constrained state back to the actual generated text.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, either we stay outside the span
//   (implication vacuous) or we open a span and set currentConstrainedOut := [],
//   which is valid by precondition parser.IsValidPrefix([]). In the complete-
//   prefix branch, CloseConstrainedSpan sets insideConstrainedOut to false, so
//   the implication is vacuous. In the constrained argmax-fast-path and
//   ConstrainedStep fallback, we call AppendConstrainedToken only after a valid-
//   next check (explicitly in the fast path, and by ConstrainedStep's contract
//   in the fallback), so the new constrained prefix remains valid.
// suffix: Outside the span, opening a new span sets currentConstrainedOut := []
//   after appending "<<", and the length-0 suffix matches []. Closing uses
//   CloseConstrainedSpan, which appends ">>" and resets currentConstrainedOut to
//   [] atomically. In both constrained append branches, AppendConstrainedToken
//   appends the same token to generated and currentConstrainedOut, preserving
//   the suffix equality.
// cost: UnconstrainedStep, ConstrainedStep, OpenConstrainedSpan, and
//   CloseConstrainedSpan each bump helpers.cost by 1 internally; in each such
//   branch we also do steps := steps + 1. In the constrained argmax-fast-path
//   we use only queries plus AppendConstrainedToken, which does not bump cost;
//   we still increment steps by 1, so helpers.cost <= steps is preserved with
//   slack. No branch manually bumps helpers.cost without also consuming one step.
// progress: Every branch appends at most one token to generated, except opening
//   or closing a span, which also append exactly one delimiter token; in all
//   cases generated grows by at most 1 while steps grows by exactly 1. Break
//   branches do not modify generated further, so |generated| <= |generatedPrefix|
//   + steps is maintained.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var best := helpers.GetHighestLogitToken(lm);
    var bestLogit := helpers.GetTokenLogit(lm, best);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    if best == "<<" || openLogit >= bestLogit - 2.0 {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" || Contains(next, "<<") {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);
      if argmax != eosToken && argmaxValid {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

cost := steps;

