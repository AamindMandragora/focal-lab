Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it tried to "notice" arithmetic spans from
// ordinary unconstrained sampling and then entered constrained mode too late or
// on malformed tokens such as tokens merely containing "<<". That allowed spans
// to start without a reliable path to a parser-complete interior, producing many
// unterminated `<<` segments.
// 
// This revision makes delimiter handling explicit and conservative:
// - Outside constrained mode, we either generate one normal token with
//   UnconstrainedStep, or we deliberately open a span only when the model's top
//   token is exactly `<<`.
// - Once inside constrained mode, we never inspect raw sampled `">>"` to decide
//   closure. We only close when `parser.IsCompletePrefix(currentConstrainedOut)`
//   is already true, then call CloseConstrainedSpan.
// - Inside a span, every non-EOS step is obtained from ConstrainedStep and then
//   appended with AppendConstrainedToken, so the interior remains parser-valid.
// - If EOS is produced outside a span we stop immediately; if EOS is proposed
//   inside a span, ConstrainedStep returns it and we stop immediately as
//   required, without pretending the span is complete.
// 
// The key change is removing heuristic delimiter detection from arbitrary tokens
// and using a simple two-mode controller with explicit opening and parser-driven
// closing. This directly targets the evaluation failure mode of unterminated
// constrained segments while still ensuring some generations can contain `<< >>`
// when the model explicitly chooses to open them.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, UnconstrainedStep leaves the mode
//   unchanged, so if we remain outside the implication is vacuous; OpenConstrainedSpan
//   sets currentConstrainedOut to [], which is valid by parser.IsValidPrefix([]).
//   In the inside branch, if the prefix is complete then CloseConstrainedSpan
//   exits constrained mode, making the implication vacuous. Otherwise, if
//   ConstrainedStep yields EOS we break without changing state; if it yields a
//   token, AppendConstrainedToken extends currentConstrainedOut by a parser-valid
//   next token, preserving validity.
// suffix: Outside constrained mode, UnconstrainedStep only appends to generated
//   while staying outside, so the implication is vacuous; OpenConstrainedSpan
//   appends `<<` and sets currentConstrainedOut := [], and the empty suffix
//   matches. In the inside branch, CloseConstrainedSpan appends `>>` and resets
//   currentConstrainedOut := [], so the implication becomes vacuous. In the
//   append branch, AppendConstrainedToken appends the same token to generated
//   and currentConstrainedOut, preserving the suffix equality.
// cost: Every branch that consumes one loop iteration also increments steps by 1.
//   The only helpers used that bump helpers.cost are UnconstrainedStep,
//   OpenConstrainedSpan, ConstrainedStep, and CloseConstrainedSpan; each is used
//   in a branch where steps is also incremented exactly once. AppendConstrainedToken
//   does not bump helpers.cost, so helpers.cost <= steps is preserved.
// progress: UnconstrainedStep appends at most one token to generated; opening and
//   closing append exactly one delimiter token; constrained append appends one
//   token. In every non-break branch, generated grows by at most 1 while steps
//   increases by exactly 1, so |generated| <= |generatedPrefix| + steps remains
//   true. Break branches do not modify generated after the check.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var best := helpers.GetHighestLogitToken(lm);
    if best == "<<" {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var nextIn := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if nextIn == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, nextIn
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

