Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL benefits from two kinds of state: (1) whether we are
// already inside the constrained SQL span, and (2) lightweight SQL-semantic
// context extracted from the current constrained prefix. This strategy tracks
// the tokens that follow "FROM" as a schema-scope proxy and uses parser
// narrowness to switch modes.
//
// Outside the SQL span, generation is chunked so the model can freely emit
// setup text until it opens "<<", amortizing overhead. Inside the span, if the
// parser is narrow we use tight token-by-token constrained decoding; if it is
// wide we use ConstrainedSymbol to accept a longer valid chunk. Before a tight
// step, we boost parser-valid candidates that also appear in the tracked
// FROM-context, gently steering table/column reuse without breaking validity.
//
// The tracked state supports validity as follows: currentConstrainedOut is the
// only parser-relevant mutable state and is updated only by helpers that
// preserve parser validity; semanticContext is read-only guidance derived from
// currentConstrainedOut and never passed back as parser state.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, insideConstrainedOut
//   stays false unless stoppedOpen is true, in which case we set
//   currentConstrainedOut := []; parser.IsValidPrefix([]) holds by precondition.
//   In the complete-prefix branch, CloseConstrainedSpan sets
//   insideConstrainedOut to false, so the implication is vacuous. In the tight
//   constrained branch, after masking valid-next tokens, any non-EOS chosen
//   token is parser-valid, and AppendConstrainedToken preserves validity. In
//   the loose branch, ConstrainedSymbol returns a valid constrained prefix.
// suffix: In the unconstrained chunk branch, when stoppedOpen is true we enter
//   the span with currentConstrainedOut := [], so the length-0 suffix of
//   generated matches []; otherwise insideConstrainedOut remains false. In the
//   close branch, CloseConstrainedSpan appends the delimiter and resets the
//   constrained prefix to []. In the tight branch, AppendConstrainedToken
//   appends the same token to generated and currentConstrainedOut. In the loose
//   branch, with stablePrefix := generated[..|generated|-|currentConstrainedOut|],
//   setting generated := stablePrefix + symbolOut and currentConstrainedOut :=
//   symbolOut makes the suffix equality immediate.
// progress: UnconstrainedChunk appends stepsUsed tokens and we do
//   steps := steps + stepsUsed, so |generated| grows by at most stepsUsed.
//   CloseConstrainedSpan appends one token and steps increases by 1. The tight
//   branch appends exactly one token when it does not break on EOS, and still
//   increments steps by 1. The loose branch advances by stepsUsed and replaces
//   the constrained suffix by a longer valid symbolOut, so generated grows by
//   at most stepsUsed. All arithmetic is linear.
// cost accounting: cost is kept at 0 during the loop and assigned only once at
//   the end as cost := steps. Every branch increments steps by exactly the same
//   amount of decoding work it performs: 1 for CloseConstrainedSpan and tight
//   token steps, stepsUsed for UnconstrainedChunk and ConstrainedSymbol, or it
//   breaks immediately after that accounted work. Hence the returned cost is
//   bounded by maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var semanticContext: seq<Token> := [];
var scopeKeyword: Token := "FROM";
var narrowThreshold: nat := 12;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
      semanticContext := [];
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      semanticContext := [];
      steps := steps + 1;
    } else {
      semanticContext := helpers.ExtractAfterKeyword(currentConstrainedOut, scopeKeyword);
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;

      if validCount <= narrowThreshold {
        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
        if |semanticContext| > 0 {
          var candidates := helpers.TopValidCandidates(
            lm, parser, constrainedPrompt, currentConstrainedOut, 20, eosToken
          );
          var focused := helpers.IntersectTokenSets(candidates, semanticContext);
          if |focused| > 0 {
            helpers.BoostTokenLogits(lm, focused, 6.0);
          }
        }
        lm.MaskValidNextAndEos(parser, currentConstrainedOut, eosToken);
        var next := lm.ChooseNextToken();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var symbolBudget: nat := maxSteps - steps;
        var symbolOut, hitEos, stepsUsed2 := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, symbolBudget, eosToken
        );
        generated := stablePrefix + symbolOut;
        insideConstrainedOut := true;
        currentConstrainedOut := symbolOut;
        steps := steps + stepsUsed2;
        if hitEos {
          break;
        }
      }
    }
  }
}

cost := steps;

