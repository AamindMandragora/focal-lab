Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy over-used multi-token constrained expansion in wide
// parser states. On Spider, those wide states often occur around JOIN/ON,
// binary predicates, and clause transitions; accepting a whole "symbol" there
// made it easy to stop mid-condition or drift into repeated local patterns.
// The revision therefore switches to a mostly token-level constrained policy
// with targeted logit shaping, and uses chunking only outside the SQL span.
//
// Inside the constrained SQL span, the strategy distinguishes three cases.
// First, if the current SQL prefix is complete, it immediately closes with ">>".
// Second, if the parser is in a dead-end or extremely narrow state, it performs
// a single masked token step to recover safely. Third, in ordinary states it
// still performs a single masked token step, but biases logits toward likely
// clause-closing and anti-repetition choices instead of taking a larger symbol.
// This directly addresses the observed incomplete JOIN/ON predicates and local
// repetition loops by forcing revalidation after every token.
//
// The guidance is lightweight and parser-safe: when the current prefix already
// contains FROM, we extract the following tokens as a schema-scope context and
// softly boost valid candidates overlapping that context; we also penalize the
// most recent token to discourage immediate repeats, and when the parser state
// is already complete we never keep generating SQL content. Validity is still
// maintained solely through parser masking and helper updates.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, either we remain outside
//   the constrained span, or we open a fresh span with currentConstrainedOut := [];
//   the implication then holds because parser.IsValidPrefix([]) is a precondition.
//   In the close branch, CloseConstrainedSpan makes insideConstrainedOut false,
//   so the implication is vacuous. In each constrained token branch, we first
//   mask to parser-valid next tokens plus EOS; if EOS is chosen we break without
//   changing currentConstrainedOut, and otherwise AppendConstrainedToken
//   preserves parser validity for the appended token.
// suffix: In the unconstrained chunk branch, if we open a span then
//   currentConstrainedOut is reset to [] and the empty suffix matches;
//   otherwise insideConstrainedOut is false. In the close branch, the helper
//   appends the closing delimiter and clears currentConstrainedOut, so the
//   implication is vacuous. In each constrained token branch, the chosen token
//   is appended to both generated and currentConstrainedOut by
//   AppendConstrainedToken, preserving suffix equality.
// progress: UnconstrainedChunk appends stepsUsed tokens and we set
//   steps := steps + stepsUsed, so |generated| grows by at most stepsUsed.
//   CloseConstrainedSpan appends one token and we increment steps by 1.
//   Each constrained token branch performs exactly one token choice; if EOS is
//   chosen we break after steps := steps + 1 with generated unchanged, and if a
//   normal token is chosen then exactly one token is appended and steps also
//   increases by 1. All arithmetic is linear.
// cost accounting: The loop keeps cost == 0 and returns cost := steps once.
//   UnconstrainedChunk contributes stepsUsed work, CloseConstrainedSpan
//   contributes 1, and each direct ChooseNextToken call is followed by exactly
//   one manual helpers.cost bump and steps := steps + 1. Branches that break do
//   so only after the corresponding accounted work, so returned cost is bounded
//   by maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var scopeKeyword: Token := "FROM";
var narrowThreshold: nat := 6;
var deadEndMinValid: nat := 2;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else {
      if stoppedOpen {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, deadEndMinValid);
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);

      if |currentConstrainedOut| > 0 {
        var lastTok := currentConstrainedOut[|currentConstrainedOut| - 1];
        var repeatPenalty: seq<Token> := [lastTok];
        helpers.PenalizeTokenLogits(lm, repeatPenalty, 3.0);
      }

      var semanticContext := helpers.ExtractAfterKeyword(currentConstrainedOut, scopeKeyword);
      if |semanticContext| > 0 {
        var candidates := helpers.TopValidCandidates(
          lm, parser, constrainedPrompt, currentConstrainedOut, 24, eosToken
        );
        var focused := helpers.IntersectTokenSets(candidates, semanticContext);
        if |focused| > 0 {
          helpers.BoostTokenLogits(lm, focused, 4.0);
        }
      }

      if narrow || validCount <= narrowThreshold {
        helpers.ScaleAllLogits(lm, 1.15);
      } else {
        helpers.ScaleAllLogits(lm, 1.05);
      }

      lm.MaskValidNextAndEos(parser, currentConstrainedOut, eosToken);
      var next := lm.ChooseNextToken();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;

      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

