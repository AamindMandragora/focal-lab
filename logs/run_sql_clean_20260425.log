Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL needs two kinds of state: the full emitted answer in
// generated, and when we are inside a constrained SQL span, the SQL-only suffix
// currentConstrainedOut that the schema-specialized parser validates. Outside a
// span we decode freely but bias toward opening "<<" when the model already
// gives it competitive probability or when the sampled token itself contains
// "<<", which is a useful trigger for entering grammar-constrained SQL mode.
// Inside a span we inspect parser state: if the current SQL prefix is complete
// we close immediately; if the parser reports a narrow or dead-end frontier we
// use hard constrained decoding; otherwise we softly boost a few top valid SQL
// candidates and sample, appending only parser-valid tokens. This tracked split
// between full output and SQL suffix lets us preserve parser validity while
// still allowing natural unconstrained text before the SQL query.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, entering a span only sets
//   currentConstrainedOut := [], which is valid by the method precondition on
//   parser.IsValidPrefix([]); otherwise insideConstrainedOut stays false so the
//   implication is vacuous. In the complete-prefix branch, CloseConstrainedSpan
//   sets insideConstrainedOut to false, again making the implication vacuous.
//   In the hard-constrained branch, ConstrainedStep is used only while already
//   inside a valid prefix and AppendConstrainedToken extends that prefix with a
//   parser-valid next token. In the soft branch, we call AppendConstrainedToken
//   only when IsTokenValidNext returns true; the rejection branch leaves the
//   state unchanged.
// suffix: In unconstrained decoding, if we open a span we append "<<" to
//   generated and set currentConstrainedOut := [], so the length-0 suffix
//   matches. CloseConstrainedSpan atomically appends the closing delimiter and
//   resets currentConstrainedOut to [], so the invariant holds. In both hard
//   and soft constrained append branches, AppendConstrainedToken appends the
//   same token to generated and currentConstrainedOut; in the soft rejection
//   branch nothing changes.
// cost: UnconstrainedStep, ConstrainedStep, OpenConstrainedSpan, and
//   CloseConstrainedSpan each bump helpers.cost by 1 internally, and we do
//   steps := steps + 1 in the same iteration. In the soft branch we use
//   GenerateLogits and logit edits, which do not bump cost, then a primitive
//   ChooseNextTokenUnconstrained followed by helpers.cost := helpers.cost + 1;
//   again steps is incremented once, so helpers.cost <= steps is preserved.
//   Pure queries like DeadEndDetection, ValidTokenCount, TopValidCandidates,
//   IsTokenValidNext, and GetTokenLogit do not affect the accounting.
// progress: Every branch increases steps by exactly 1 before looping again or
//   breaking. UnconstrainedStep and constrained append branches append at most
//   one token to generated; OpenConstrainedSpan and CloseConstrainedSpan append
//   one delimiter token; the soft rejection branch appends nothing. Therefore
//   |generated| can grow by at most one per iteration, maintaining
//   |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
helpers.cost := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    if openLogit >= argmaxLogit - 2.0 && argmax != eosToken {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" || Contains(next, "<<") {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if narrow || validCount <= 3 {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var candidates := helpers.TopValidCandidates(
          lm, parser, constrainedPrompt, currentConstrainedOut, 4, eosToken
        );
        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
        helpers.BoostTokenLogits(lm, candidates, 8.0);
        helpers.PenalizeTokenLogits(lm, [eosToken], 100.0);
        var next := lm.ChooseNextTokenUnconstrained();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
          if valid {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
          }
        }
      }
    }
  }
}

cost := steps;

