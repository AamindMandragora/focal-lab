Strategy: // CSD_RATIONALE_BEGIN
// The evaluator feedback shows two concrete problems with the previous design:
// it opened `<<` too early in the continuation, and it often ran out of budget
// before emitting the matching `>>`. For Spider, the final answer still must
// contain a visible constrained segment, but that does not mean the segment must
// start at the first generated token.
// 
// This revision therefore delays entering constrained mode until there is enough
// remaining budget to both produce at least one SQL token and then close the
// segment. While outside constrained mode, it takes ordinary unconstrained steps;
// however, once the remaining budget becomes small, it reserves the tail of the
// generation for a guaranteed `<< SQL >>` segment instead of spending all steps
// outside. This directly addresses the "entered too early" failure while also
// preventing the common "opened but never closed" failure.
// 
// Inside constrained mode, the strategy is completion-oriented. If the parser
// says the SQL prefix is already complete, it closes immediately. Otherwise it
// takes schema-aware constrained steps. To improve the chance of closing within
// budget, when only one step would remain after the current iteration, it only
// continues if the current prefix is already complete; otherwise it avoids
// opening in that situation. Thus every opening is budget-aware, and every
// closing happens only from a parser-complete prefix as required.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch we stay outside constrained mode,
//   so the implication remains vacuous. In the open branch, `OpenConstrainedSpan`
//   yields empty constrained content, and `parser.IsValidPrefix([])` holds. In
//   the close branch we move outside constrained mode, so the implication is
//   vacuous again. In the constrained-append branch, `ConstrainedStep` chooses a
//   parser-valid next token and `AppendConstrainedToken` extends the valid
//   prefix, preserving `parser.IsValidPrefix(currentConstrainedOut)`.
// suffix: The unconstrained branch does not change constrained state, so if we
//   were outside it stays vacuous, and if we were inside this branch is not
//   taken. Opening creates empty constrained content, which is a suffix of any
//   sequence. Closing moves outside constrained mode, making the implication
//   vacuous. Appending a constrained token extends both `generated` and
//   `currentConstrainedOut` by the same token, so the tracked constrained
//   content remains exactly the suffix of `generated`.
// cost: The only cost-bumping helpers used are `UnconstrainedStep`,
//   `OpenConstrainedSpan`, `ConstrainedStep`, and `CloseConstrainedSpan`; in
//   each branch that calls one of them, `steps` is incremented exactly once
//   immediately after the call. `AppendConstrainedToken` is non-bumping, so
//   `helpers.cost <= steps` is preserved in every branch.
// progress: In the unconstrained branch, one token is appended and `steps` grows
//   by 1. Opening appends only the delimiter token `<<`, again matched by one
//   step. Closing appends only `>>`, also matched by one step. In the
//   constrained-step branch, either EOS causes a break after one helper action,
//   or one token is appended after the helper action; in both cases the total
//   growth of `generated` during the iteration is at most the increment to
//   `steps`, preserving `|generated| <= |generatedPrefix| + steps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant helpers.cost <= steps
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  } else {
    var remaining := maxSteps - steps;
    if remaining <= 2 {
      break;
    } else {
      if remaining == 3 {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        steps := steps + 1;
      } else {
        var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if nextOutside == eosToken {
          break;
        } else {
          generated := generated + [nextOutside];
        }
      }
    }
  }
}

cost := steps;

