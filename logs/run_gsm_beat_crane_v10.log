// CSD_RATIONALE_BEGIN
// Math-step CSD with delimiter-triggered constrained arithmetic spans.
// The strategy tracks the usual generated text plus whether we are currently
// inside a `<< ... >>` arithmetic segment, and the active constrained segment
// contents `currentConstrainedOut` (without delimiters). Outside a span it
// generates freely, but it watches for the opening delimiter token `"<<"`.
// Inside a span it uses parser-constrained decoding so every token sequence
// between delimiters remains a valid arithmetic-computation prefix.
//
// To better support step-by-step math, the strategy uses caller-supplied
// `validTokenGroups` as a soft bias only while inside constrained spans:
// when the arithmetic grammar is relatively narrow, it uses an adaptive
// group-boosted constrained step; otherwise it uses a plain constrained step.
// Once the parser reports that the arithmetic span is complete, the strategy
// closes it with `">>"`. This state tracking ensures delimiter structure is
// explicit while the parser guarantees validity of the arithmetic content.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, entering a span happens only
// when the emitted token is `"<<"`; we then set currentConstrainedOut := [],
// which is a valid parser prefix by precondition. In the close-span branch,
// CloseConstrainedSpan sets insideConstrainedOut to false, so the implication
// becomes vacuous. In the plain constrained-step branch, ConstrainedStep
// returns parser-valid updated constrained content on non-EOS. In the adaptive
// group-boost branch, GroupBoostedConstrainedStep returns either eosToken or a
// parser-valid next token; on the non-EOS path AppendConstrainedToken extends
// the valid prefix to another valid prefix.
//
// suffix: In the unconstrained branch, if we stay outside then the implication
// is vacuous; if we open a span, currentConstrainedOut is [] so the length-0
// suffix of generated matches []. In the close-span branch, CloseConstrainedSpan
// appends the closing delimiter and resets currentConstrainedOut to [], making
// the suffix condition vacuous afterward. In the plain constrained-step branch,
// ConstrainedStep preserves the suffix relation internally. In the adaptive
// group-boost branch, AppendConstrainedToken appends the same token to both
// generated and currentConstrainedOut, so the generated suffix remains exactly
// currentConstrainedOut.
//
// progress: Every non-breaking branch increases steps by exactly 1. The
// unconstrained branch appends exactly one token and does steps := steps + 1.
// The close-span branch appends at most one token and also increments steps by
// 1. The plain constrained-step branch either breaks on EOS or returns a state
// with generated length increased by 1 and then steps is incremented by 1. The
// adaptive group-boost branch samples one constrained token, breaks on EOS, or
// appends exactly one token via AppendConstrainedToken and increments steps by
// 1. Therefore |generated| <= |generatedPrefix| + steps is preserved.
//
// cost accounting: The returned cost is the local steps counter, not
// helpers.cost. Every non-breaking branch performs exactly one costed decoding
// action and then increments steps by 1; break branches do not need further
// preservation because the loop exits immediately. Since steps starts at 0 and
// only increases while steps < maxSteps, assigning cost := steps at the end
// yields cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= narrowThreshold {
        var next := helpers.GroupBoostedConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var g, i, c, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := g;
          insideConstrainedOut := i;
          currentConstrainedOut := c;
        }
      }
    }
  }
}

cost := steps;
