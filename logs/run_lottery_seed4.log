Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it could open a constrained span and then
// spend many steps trying to build arithmetic text token-by-token, often running
// out of budget before emitting the mandatory closing delimiter. To fix that, this
// strategy is deliberately conservative: it only opens a constrained span when
// there is enough remaining budget to both open and close it, and once inside a
// span it prioritizes immediate closure as soon as the parser says the current
// constrained content is complete. Outside a span, it strongly prefers opening
// only on an explicit "<<" token signal; otherwise it generates unconstrainedly.
// Inside a span, it uses ConstrainedStep to obtain parser-valid tokens and appends
// them, but if the remaining budget drops to 1 it closes only when already
// complete and otherwise stops rather than leaving an unterminated span. This
// change directly targets the evaluation failure mode: every opened span is either
// closed within the available budget or not opened at all.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, unconstrained generation leaves
//   insideConstrainedOut false, or OpenConstrainedSpan starts a fresh empty span;
//   by the precondition/parser invariant, [] is a valid prefix. In the inside
//   branch, CloseConstrainedSpan sets insideConstrainedOut false, so the
//   implication is vacuous; otherwise we append only a token returned by
//   ConstrainedStep, which is intended for valid constrained continuation, and
//   AppendConstrainedToken preserves parser validity.
//
// suffix: Outside constrained mode the invariant is vacuous. Opening a span
//   appends "<<" while setting currentConstrainedOut to [], so the empty suffix
//   condition holds. Closing a span resets insideConstrainedOut to false, making
//   the implication vacuous. Appending a constrained token extends both generated
//   and currentConstrainedOut by the same token, preserving the suffix equality.
//
// cost: UnconstrainedStep, OpenConstrainedSpan, ConstrainedStep, and
//   CloseConstrainedSpan each bump helpers.cost by 1 internally, and every branch
//   that calls one of them also increments steps by 1. AppendConstrainedToken and
//   parser queries do not change helpers.cost. Therefore helpers.cost never
//   exceeds steps.
//
// progress: steps increases by exactly 1 on each non-breaking iteration. Each
//   such iteration appends at most one token to generated: one unconstrained
//   token, one opening delimiter, one constrained token, or one closing
//   delimiter. Hence generated grows by at most steps beyond generatedPrefix.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remaining := maxSteps - steps;
    if remaining >= 2 {
      lm.GenerateLogits(prompt + generated);
      var top := helpers.GetHighestLogitToken(lm);
      if top == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          if next == "<<" {
            if steps < maxSteps {
              generated := generated + [next];
              insideConstrainedOut := true;
              currentConstrainedOut := [];
            } else {
              break;
            }
          } else {
            generated := generated + [next];
          }
        }
      }
    } else {
      var next2 := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next2 == eosToken {
        break;
      } else {
        if next2 == "<<" {
          break;
        } else {
          generated := generated + [next2];
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var remainingInside := maxSteps - steps;
      if remainingInside <= 1 {
        break;
      } else {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next3 := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next3 == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next3
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

