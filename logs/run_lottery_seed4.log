Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy opened constrained spans opportunistically from normal
// decoding and also tried to decode inside a span token-by-token before the
// parser had necessarily reached a complete arithmetic expression. Evaluation
// showed that this frequently produced unterminated `<< ...` segments. The
// revised strategy therefore makes opening and closing much more disciplined:
// outside a span, it strongly prefers ordinary unconstrained decoding and only
// opens a span on an explicit `<<` token (or a sampled token containing `<<`);
// once inside a span, it uses only parser-guided constrained decoding until the
// parser reports a complete prefix, and then it immediately closes with `>>` on
// the next iteration before doing anything else. This removes speculative
// half-open spans and guarantees that every opened constrained segment is either
// closed promptly or generation stops without opening one in the first place.
// 
// Concretely, the loop has three branches: unconstrained decoding outside spans;
// mandatory close when the current constrained prefix is complete; and strictly
// constrained token generation otherwise. The constrained branch never treats a
// raw sampled `">>"` as a reason to close; only parser completeness triggers
// `CloseConstrainedSpan`, as required. Because every non-breaking iteration adds
// at most one token to `generated` and increments `steps` once, the standard
// size and cost bounds are preserved.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if we remain outside a span then
//   the implication is vacuous; if we open a span, OpenConstrainedSpan sets the
//   active constrained prefix to [], which is a valid parser prefix by the
//   method precondition. In the mandatory-close branch, CloseConstrainedSpan
//   exits constrained mode, so the implication is vacuous afterward. In the
//   constrained-generation branch, ConstrainedStep returns a parser-permitted
//   next token (or eosToken, in which case we break before changing state), and
//   AppendConstrainedToken preserves validity of the constrained prefix.
// suffix: In the unconstrained branch, staying outside makes the invariant
//   vacuous; opening via OpenConstrainedSpan appends the delimiter while setting
//   currentConstrainedOut := [], and the empty suffix matches generated. In the
//   close branch, CloseConstrainedSpan resets currentConstrainedOut to [] and
//   leaves us outside, so the implication is vacuous. In the constrained
//   generation branch, AppendConstrainedToken appends the same token to both
//   generated and currentConstrainedOut, preserving the suffix equality.
// cost: In the unconstrained branch, UnconstrainedStep bumps helpers.cost by 1
//   and we increment steps once. In the close branch, CloseConstrainedSpan bumps
//   helpers.cost by 1 and steps also increases by 1. In the constrained
//   generation branch, ConstrainedStep bumps helpers.cost by 1; if it returns
//   eosToken we break after the step increment, otherwise AppendConstrainedToken
//   is non-bumping, so helpers.cost <= steps is preserved in all cases.
// progress: In the unconstrained branch, either UnconstrainedStep appends at
//   most one token or OpenConstrainedSpan appends exactly one delimiter token,
//   and then steps increases by 1. In the close branch, CloseConstrainedSpan
//   appends exactly one closing delimiter token while steps increases by 1. In
//   the constrained-generation branch, either we break on eosToken without
//   changing generated, or AppendConstrainedToken appends one token; again steps
//   increases by 1, so |generated| <= |generatedPrefix| + steps is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;

    if next == eosToken {
      break;
    } else if next == "<<" || Contains(next, "<<") {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
    } else {
      generated := generated + [next];
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var baseGenerated := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, prompt + baseGenerated, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

