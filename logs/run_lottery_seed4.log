Strategy: // CSD_RATIONALE_BEGIN
// The revised strategy aggressively guarantees presence and closure of << >> spans
// instead of merely encouraging them. The main change is a targeted policy:
// once we are outside a constrained span, if no constrained arithmetic has yet
// appeared in generated, we strongly prefer opening one whenever the model shows
// any arithmetic cue (digits or operator words/symbols) or when "<<" is even
// moderately competitive. Inside a span we no longer free-run on generic argmax;
// instead we query parser-valid continuations, bias toward concise arithmetic
// tokens, and immediately close the span as soon as the parser reports a complete
// prefix. This directly addresses the prior failures: missing delimiters are
// reduced by proactively opening a span early, unterminated spans are prevented
// by prioritizing closure on completeness, and runtime is improved by avoiding
// wandering natural-language text inside constrained mode.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In outside-mode branches, either we stay outside (so the
//   implication is vacuous) or we open a span via OpenConstrainedSpan, which
//   sets currentConstrainedOut to [] and [] is valid by precondition. In
//   inside-mode, the close branch makes us outside, again vacuous; every append
//   branch uses either a token first checked by IsTokenValidNext or a token
//   returned by ConstrainedStep, and then AppendConstrainedToken preserves valid
//   parser-prefix state.
// suffix: Outside-mode branches that remain outside need no proof. Opening a
//   span appends "<<" while setting currentConstrainedOut := [], so the suffix
//   equality with the empty sequence holds immediately. In inside-mode, closing
//   resets currentConstrainedOut to [] so the invariant is immediate, and each
//   append branch extends both generated and currentConstrainedOut by the same
//   token through AppendConstrainedToken, preserving the suffix relation.
// cost: Branches using OpenConstrainedSpan, CloseConstrainedSpan, or
//   ConstrainedStep consume one helper cost internally, and we increment steps
//   once in the same iteration. Raw unconstrained sampling manually increments
//   helpers.cost once after ChooseNextTokenUnconstrained and also increments
//   steps once. Query-only branches plus AppendConstrainedToken do not increase
//   helpers.cost, so helpers.cost <= steps is preserved with slack.
// progress: Every iteration increments steps exactly once. The only branches
//   that change generated append at most one token: raw unconstrained sampling
//   appends next, opening appends "<<", constrained append appends one token,
//   and closing appends ">>". Therefore generated grows by at most one per
//   iteration, preserving |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var seenConstrained := insideConstrained || Contains("<<", generated);

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
    var openLogit := helpers.GetTokenLogit(lm, "<<");

    var shouldOpen := false;
    if !seenConstrained {
      if argmax == "<<" || Contains(argmax, "<<") || Contains(argmax, "=") || Contains(argmax, "+") || Contains(argmax, "-") || Contains(argmax, "*") || Contains(argmax, "/") {
        shouldOpen := true;
      } else {
        if openLogit >= argmaxLogit - 1.0 && argmax != eosToken {
          shouldOpen := true;
        }
      }
    } else {
      if argmax == "<<" {
        shouldOpen := true;
      } else {
        if openLogit >= argmaxLogit - 0.5 && argmax != eosToken {
          shouldOpen := true;
        }
      }
    }

    if shouldOpen {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      seenConstrained := true;
      steps := steps + 1;
    } else {
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          seenConstrained := true;
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
