Strategy: // CSD_RATIONALE_BEGIN
// This strategy tracks the full generated output in `generated`, whether we are
// currently inside a constrained arithmetic span in `insideConstrainedOut`, and
// the contents of the active span in `currentConstrainedOut`. Outside spans it
// generates mostly freely, but it proactively opens a span when the token "<<"
// is competitive with the current argmax or when the sampled token itself
// contains "<<", since this task wants arithmetic computations explicitly marked.
// Inside spans it keeps the span parser-valid by preferring valid next tokens:
// it first tries the current argmax if valid, otherwise falls back to the
// helper's constrained step. Once the parser reports a complete constrained
// prefix, it closes the span with ">>". This tracked state ensures that the
// suffix of the generated text matches the active constrained contents and that
// constrained spans remain parser-valid throughout generation.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if we proactively or explicitly
//   open a span, we set currentConstrainedOut := [], which is a valid prefix by
//   precondition; otherwise we remain outside, so the implication is vacuous.
//   In the complete-prefix branch, CloseConstrainedSpan sets insideConstrainedOut
//   to false, again making the implication vacuous. In the in-span argmax-valid
//   branch and the constrained-step fallback branch, we call
//   AppendConstrainedToken only for a token established to be valid next, so
//   the resulting currentConstrainedOut remains a valid prefix.
// suffix: Outside spans the invariant is vacuous. When opening a span we append
//   "<<" to generated and set currentConstrainedOut := [], so the length-0
//   suffix matches []. CloseConstrainedSpan appends the closing delimiter and
//   resets currentConstrainedOut to [], preserving the implication. In both
//   append branches, AppendConstrainedToken appends the same token to generated
//   and currentConstrainedOut, so the suffix equality is preserved.
// cost: In the unconstrained raw-sampling branch we manually increment
//   helpers.cost by 1 exactly when we consume one primitive sampling step, and
//   we also increment steps by 1. OpenConstrainedSpan, ConstrainedStep, and
//   CloseConstrainedSpan each bump helpers.cost internally by 1, and each such
//   branch also increments steps by 1. AppendConstrainedToken and parser/logit
//   queries do not bump helpers.cost, so helpers.cost <= steps is maintained.
// progress: Each loop iteration increments steps by exactly 1. The branches
//   append at most one token to generated, except the explicit close branch
//   which appends one closing delimiter token; thus generated grows by at most
//   one token per step. Therefore |generated| <= |generatedPrefix| + steps is
//   preserved in every branch.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    if openLogit >= argmaxLogit - 2.0 && argmax != eosToken && argmax != ">>" {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" || Contains(next, "<<") {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);
      if argmaxValid && argmax != eosToken {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

