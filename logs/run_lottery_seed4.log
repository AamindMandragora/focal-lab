Strategy: // CSD_RATIONALE_BEGIN
// The evaluation failures show that merely being conservative about budget is not
// enough: the model still often writes arithmetic placeholders like `frac * n`
// inside constrained spans, which satisfy parser-style local validity but do not
// produce concrete computations, and it can still leave a span unterminated when
// generation drifts. The revised strategy therefore becomes much more aggressive
// about delimiter control.
//
// Key changes:
// 1. Outside constrained mode, the strategy strongly biases toward opening a span
//    whenever there is enough budget, instead of waiting for the model to prefer
//    "<<". This directly targets the "Contains << >>" requirement.
// 2. Inside constrained mode, if the current constrained prefix is complete, the
//    strategy closes immediately before doing anything else. This minimizes the
//    chance of unterminated spans.
// 3. While inside a span, the strategy uses parser-guided constrained generation,
//    but also detects weak situations (few valid continuations / dead-end risk)
//    and closes as soon as completion becomes available rather than continuing to
//    elaborate symbolic text. This shortens spans and favors compact arithmetic
//    snippets like `12+3` over longer natural-language fragments.
// 4. The strategy never opens a span unless at least two steps remain, so every
//    opening still reserves room for a later close.
//
// Overall, this revision trades some stylistic freedom for reliability: produce
// many short, promptly closed constrained computations rather than a few long,
// fragile spans.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, either we stay outside after an
//   unconstrained token, making the implication vacuous, or OpenConstrainedSpan
//   starts a fresh empty constrained segment, and [] is valid by precondition.
//   In the inside branch, CloseConstrainedSpan exits constrained mode so the
//   implication is vacuous; otherwise ConstrainedStep chooses a parser-valid next
//   token and AppendConstrainedToken extends currentConstrainedOut while
//   preserving parser validity.
//
// suffix: Outside constrained mode the invariant is vacuous; opening a span sets
//   currentConstrainedOut to [] so the suffix equation holds trivially. In the
//   inside branch, closing makes the implication vacuous, and appending a
//   constrained token extends both generated and currentConstrainedOut by the
//   same token, preserving the suffix relationship.
//
// cost: Every branch that calls a cost-bumping helper
//   (UnconstrainedStep/OpenConstrainedSpan/ConstrainedStep/CloseConstrainedSpan)
//   also increments steps exactly once. Query helpers such as DeadEndDetection,
//   ValidTokenCount, and IsTokenValidNext do not change helpers.cost. Hence
//   helpers.cost remains bounded by steps in all branches.
//
// progress: On each non-breaking iteration, steps increases by 1. The only
//   state-changing generation helpers used in such iterations append at most one
//   token to generated: one unconstrained token, one opening delimiter, one
//   constrained token, or one closing delimiter. Therefore |generated| grows by
//   at most steps beyond |generatedPrefix|.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var remainingInside := maxSteps - steps;
      if remainingInside <= 1 {
        break;
      } else {
        var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
        var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var nextIn := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextIn == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, nextIn
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  } else {
    var remaining := maxSteps - steps;
    if remaining >= 2 {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, ["<<"], 100.0);
      helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
      var top := helpers.GetHighestLogitToken(lm);
      if top == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        steps := steps + 1;
      } else {
        var nextOut := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if nextOut == eosToken {
          break;
        } else {
          if nextOut == "<<" {
            generated := generated + [nextOut];
            insideConstrainedOut := true;
            currentConstrainedOut := [];
          } else {
            generated := generated + [nextOut];
          }
        }
      }
    } else {
      var nextLast := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextLast == eosToken {
        break;
      } else {
        if nextLast == "<<" {
          break;
        } else {
          generated := generated + [nextLast];
        }
      }
    }
  }
}

cost := steps;

