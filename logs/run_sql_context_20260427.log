Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL usually has a long unconstrained preamble containing the
// natural-language answer framing and then one constrained SQL span whose
// tokens must match a schema-narrowed SQL grammar. This strategy tracks only
// the standard constrained-decoding state: whether we are inside the SQL span
// and the current constrained suffix being parsed.
//
// Outside the span, it uses UnconstrainedChunk so the model can quickly emit
// free-form tokens until either EOS or the opening delimiter "<<". Inside the
// span, it adapts to grammar narrowness. When the parser reports only a small
// number of valid next tokens, it uses tight token-level constrained decoding
// (ConstrainedStep), which is appropriate for SQL punctuation/keywords and
// schema-sensitive positions. When the grammar is wider, it uses
// ConstrainedSymbol with stepTokenBudget so the model can emit a longer valid
// SQL fragment in one shot, which better matches multi-token identifiers and
// expressions. As soon as the SQL prefix is complete, it closes the span with
// ">>".
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, insideConstrainedOut
//   stays false unless stoppedOpen is true, in which case we set
//   currentConstrainedOut := []; parser.IsValidPrefix([]) holds by precondition.
//   In the complete-prefix branch, CloseConstrainedSpan sets
//   insideConstrainedOut to false, so the implication is vacuous. In the tight
//   constrained branch, ConstrainedStep returns either eosToken (break) or a
//   parser-valid next token; AppendConstrainedToken therefore preserves
//   parser.IsValidPrefix. In the loose branch, ConstrainedSymbol returns a new
//   constrained prefix symbolOut that is parser-valid.
// suffix: In the unconstrained chunk branch, when stoppedOpen is false we stay
//   outside the span, so the implication is vacuous; when stoppedOpen is true
//   we have just ended with the open delimiter and set currentConstrainedOut
//   := [], whose length-0 suffix matches generated. In the complete-prefix
//   branch, CloseConstrainedSpan appends the closing delimiter and resets the
//   constrained suffix to []. In the tight constrained branch,
//   AppendConstrainedToken appends the same token to both generated and
//   currentConstrainedOut. In the loose branch, writing
//   generated := stablePrefix + symbolOut and currentConstrainedOut := symbolOut
//   makes the final |symbolOut|-length suffix exactly symbolOut.
// cost accounting: We return cost := steps. In the chunk branch we add the
//   returned stepsUsed to steps; in the complete-prefix branch we increment
//   steps by 1 after CloseConstrainedSpan; in the tight branch we increment
//   steps by 1 after ConstrainedStep; in the loose branch we increment steps by
//   the returned stepsUsed from ConstrainedSymbol. Break branches do not modify
//   cost directly; final assignment cost := steps establishes cost <= maxSteps.
// progress: UnconstrainedChunk appends at most stepsUsed tokens and we do
//   steps := steps + stepsUsed, so |generated| <= |generatedPrefix| + steps is
//   preserved. CloseConstrainedSpan appends one token and we increment steps by
//   1. ConstrainedStep + AppendConstrainedToken appends one token and we
//   increment steps by 1. ConstrainedSymbol replaces the old constrained suffix
//   with a longer valid one; its generated growth is bounded by stepsUsed, and
//   we add exactly stepsUsed to steps. Break branches preserve the invariant
//   because they do not enlarge generated after the break point.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var narrowThreshold: nat := 12;
var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= narrowThreshold {
        var next := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var symbolOut, hitEos, stepsUsed2 := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, stepTokenBudget, eosToken
        );
        generated := stablePrefix + symbolOut;
        currentConstrainedOut := symbolOut;
        steps := steps + stepsUsed2;
        if hitEos {
          break;
        }
      }
    }
  }
}

