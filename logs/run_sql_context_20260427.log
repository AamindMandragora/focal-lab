Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy over-used ConstrainedSymbol inside the SQL span. On
// Spider, that caused the model to emit short but incomplete SQL fragments such
// as "SELECT <id>" and then stop, yielding excellent syntax validity but very
// poor exact-match accuracy. The core issue is that symbol-level jumps let the
// model terminate or drift before committing to the full clause structure.
//
// This revision switches to a much more conservative SQL-span policy:
// - Outside a constrained span, still use UnconstrainedChunk to cheaply reach
//   the opening delimiter "<<", preserving throughput.
// - Inside the SQL span, generate one token at a time with ConstrainedStep.
//   This keeps every decision aligned with the schema-narrowed grammar and
//   avoids large speculative symbol jumps.
// - Do not permit early closure merely because the prefix is complete once.
//   Instead, require completeness and then immediately close on the next loop
//   iteration; otherwise keep extending the SQL query token-by-token.
// - Add a simple dead-end recovery path: if the current constrained prefix has
//   very few or no valid continuations, roll it back to the nearest valid
//   prefix before continuing. This is meant to reduce local repetition or
//   getting stuck in a brittle partial clause.
//
// In short, the main change is replacing aggressive symbol-level constrained
// generation with steady token-level SQL decoding plus rollback-based recovery.
// This targets the observed "short incomplete SQL" failures while keeping the
// required << >> span structure.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, either we remain outside
//   the span, making the implication vacuous, or we stop on "<<", set
//   currentConstrainedOut := [], and use parser.IsValidPrefix([]) from the
//   precondition. In the rollback branch, RollbackToValidPrefix returns a valid
//   prefix and we rebuild generated so its active constrained suffix is exactly
//   that valid prefix. In the close branch, CloseConstrainedSpan exits the span,
//   so the implication is vacuous. In the constrained token branch,
//   ConstrainedStep returns either eosToken (break) or a valid next token, and
//   AppendConstrainedToken preserves parser validity.
//
// suffix: In the unconstrained chunk branch, outside-span states make the
//   implication vacuous; when entering the span on "<<", currentConstrainedOut
//   becomes [], which is the length-0 suffix of generated. In the rollback
//   branch, with stablePrefix := generated[..|generated|-|currentConstrainedOut|],
//   we assign generated := stablePrefix + rolled and currentConstrainedOut := rolled,
//   so the suffix equality holds by construction. In the close branch, the span
//   closes and the implication is vacuous. In the constrained token branch,
//   AppendConstrainedToken appends the same token to generated and to the active
//   constrained suffix, preserving equality.
//
// progress: UnconstrainedChunk appends exactly stepsUsed tokens and we then do
//   steps := steps + stepsUsed, preserving |generated| <= |generatedPrefix| + steps.
//   The rollback branch does not increase generated length and does not change
//   steps, so the bound is preserved. CloseConstrainedSpan appends exactly 1
//   token and we increment steps by 1. ConstrainedStep followed by
//   AppendConstrainedToken appends exactly 1 token and increments steps by 1;
//   if ConstrainedStep returns eosToken, we break immediately after incrementing
//   steps by 1, which still satisfies the linear bound.
//
// cost accounting: cost is kept at 0 during the loop and assigned only at the
//   end as cost := steps. Every generation branch that consumes decoding work
//   increments steps by the same amount as the helper's generation effort
//   (+stepsUsed for UnconstrainedChunk, +1 for CloseConstrainedSpan and
//   ConstrainedStep). The rollback branch is pure state repair and leaves steps
//   unchanged. Since the loop guard is steps < maxSteps and each costful branch
//   respects the remaining budget, the final cost := steps satisfies cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var rollbackThreshold: nat := 1;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    assert stepsUsed <= chunkBudget;
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else {
      if stoppedOnOpenSpan {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    if validCount <= rollbackThreshold && 0 < |currentConstrainedOut| {
      var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      generated := stablePrefix + rolled;
      insideConstrainedOut := true;
      currentConstrainedOut := rolled;
    } else {
      var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
      if isComplete {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
      } else {
        var stablePrefix2 := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt := prompt + stablePrefix2;
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

