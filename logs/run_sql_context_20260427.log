// The previous strategy over-weighted parser-valid candidates but still let the
// LM choose among raw tokenizer pieces. The evaluation failures (`SELECT <id>
// FROM <id>>>`) show the parser accepted placeholder/nonterminal-like tokens as
// locally valid next symbols, and the decoder then emitted them verbatim. For
// Spider, we need the constrained span to realize a concrete SQL query, not a
// grammar sketch.
//
// This revision therefore switches from token-level constrained sampling to a
// symbol-oriented constrained policy:
//
// 1. Open `<<` immediately and keep the entire SQL query inside the constrained
//    span.
//
// 2. Inside the span, use `ConstrainedSymbol` as the primary generator. That
//    helper expands a parser-approved symbol under a token budget, which is much
//    better aligned with schema-grounded SQL terminals than choosing arbitrary
//    raw tokens one by one. This directly targets the observed placeholder-like
//    outputs.
//
// 3. If the current prefix is already complete, close immediately with `>>`.
//    We never call `CloseConstrainedSpan` unless completion is known.
//
// 4. If `ConstrainedSymbol` reports EOS, stop immediately because EOS is
//    terminal. Otherwise append the returned concrete symbol tokens to the
//    constrained prefix one token at a time with `AppendConstrainedToken`.
//    This preserves the exact generated/currentConstrained relationship while
//    still letting symbol-level planning drive the choice.
//
// 5. To avoid wasting steps outside the SQL query, once the constrained span is
//    closed we stop. The output is exactly one wrapped SQL query.
//
// The key change is replacing raw next-token competition with schema-aware
// symbol expansion. That is the direct response to the low-accuracy but
// high-syntax-rate failure pattern: grammar compliance was already solved, but
// the decoder needed to force concrete SQL realizations instead of emitting
// parser artifacts.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: Opening a span sets the constrained content to empty, which
//   is a valid parser prefix. In the symbol branch, `ConstrainedSymbol` returns
//   a continuation intended to stay within the parser language; appending its
//   tokens one by one with `AppendConstrainedToken` preserves validity after
//   each token. In the close branch, `insideConstrainedOut` becomes false, so
//   the implication is vacuous. Break branches leave the state unchanged.
//
// suffix: After opening, the constrained content is empty, so generated
//   trivially ends with it. In the symbol branch, every call to
//   `AppendConstrainedToken` updates both `generated` and
//   `currentConstrainedOut` consistently, so after each appended token the
//   generated suffix equals the constrained content. Closing makes
//   `insideConstrainedOut` false, so the suffix invariant becomes vacuous.
//   Break branches preserve the previous relation.
//
// progress: `OpenConstrainedSpan` appends exactly 1 token and we increment
//   `steps` by 1. `CloseConstrainedSpan` appends exactly 1 token and we
//   increment `steps` by 1. In the symbol branch, if `ConstrainedSymbol` returns
//   `stepsUsed`, we append exactly `|symbolOut| - |currentConstrainedOut|`
//   tokens, require that this equals `stepsUsed`, and increment `steps` by that
//   same amount; if EOS is hit we break immediately. Thus
//   `|generated| <= |generatedPrefix| + steps` is preserved by linear
//   arithmetic in every branch.
//
// cost accounting: The returned `cost` is `steps`. Query-only parser/helper
//   calls do not change `steps`. Opening and closing each consume one step and
//   increment `steps` by one. In the symbol branch, we use the returned
//   `stepsUsed` and increment `steps` by exactly that amount after appending the
//   same number of tokens. Therefore the final assignment `cost := steps` is
//   consistent with the loop accounting.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var remaining := maxSteps - steps;
      var budget := stepTokenBudget;
      if remaining < budget {
        budget := remaining;
      }
      if budget == 0 {
        break;
      } else {
        var symbolOut, hitEos, stepsUsed := helpers.ConstrainedSymbol(lm, parser, prompt, currentConstrainedOut, budget, eosToken);
        if hitEos {
          break;
        } else {
          var oldCurrent := currentConstrainedOut;
          var delta := symbolOut[|oldCurrent|..];
          var i := 0;
          while i < |delta|
            invariant 0 <= i <= |delta|
            invariant lm.ValidTokensIdsLogits()
            invariant !insideConstrainedOut ==> currentConstrainedOut == []
            invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
            invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
            invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
            invariant insideConstrainedOut
            invariant currentConstrainedOut == oldCurrent + delta[..i]
            invariant |generated| <= |generatedPrefix| + steps + i
            decreases |delta| - i
          {
            var tok := delta[i];
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, tok);
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
            i := i + 1;
          }
          steps := steps + stepsUsed;
        }
      }
    }
  }

  if !insideConstrainedOut {
    break;
  }
}

cost := steps;

