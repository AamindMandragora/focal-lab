Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy let the model spend many tokens outside the SQL span and
// also used broad constrained-symbol generation inside the span. On Spider, the
// target is almost always exactly one SQL query, and the failure preview
// ("SELECT <id>") suggests the model often stopped after a short valid prefix
// instead of completing the full statement. So this revision makes two major
// changes.
//
// First, if generation starts outside a constrained span, we immediately open
// one in a single step instead of allowing any unconstrained preamble. This
// forces the output to contain a SQL span promptly and spends nearly all budget
// on SQL itself.
//
// Second, once inside the span, decoding is entirely token-by-token with
// ConstrainedStep. This is slower than chunking, but it is much better aligned
// with schema-narrowed SQL grammars and avoids the earlier under-generation and
// malformed long jumps. To reduce premature stopping and repetition, the loop
// only closes the span when the parser says the prefix is complete and either
// (a) the remaining budget is too small to safely continue, or (b) a simple
// dead-end/narrowness check indicates we should finalize now. Otherwise it keeps
// extending the SQL query. EOS remains terminal if sampled.
//
// In short: open the SQL span immediately, spend the budget on grammar-checked
// SQL tokens, and delay closing until the query is truly complete and it is a
// good time to stop. This directly targets the low-accuracy "short prefix"
// failures while preserving guaranteed syntax validity.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: The open-span branch sets currentConstrainedOut := [], which
//   is parser-valid by precondition. The close-span branch exits constrained
//   mode, so the implication becomes vacuous. The constrained-step branch either
//   breaks on eosToken without mutating the constrained state, or
//   AppendConstrainedToken extends currentConstrainedOut with a parser-valid next
//   token returned by ConstrainedStep, preserving validity.
// suffix: Opening a span appends only the delimiter and leaves
//   currentConstrainedOut empty, so the empty suffix condition holds. Closing a
//   span resets currentConstrainedOut to [], making the implication vacuous.
//   Appending a constrained token updates generated and currentConstrainedOut by
//   the same token, so generated's suffix remains exactly currentConstrainedOut.
// progress: Initially generated == generatedPrefix. OpenConstrainedSpan and
//   CloseConstrainedSpan each append exactly 1 token and we increment steps by
//   1. ConstrainedStep + AppendConstrainedToken appends exactly 1 token and we
//   increment steps by 1. Break branches do not enlarge generated, so
//   |generated| <= |generatedPrefix| + steps is preserved.
// cost accounting: We maintain a local steps counter and return cost := steps.
//   Every helper used for state-changing generation here is a one-step helper:
//   OpenConstrainedSpan, CloseConstrainedSpan, and ConstrainedStep each justify
//   adding 1 to steps. Query helpers (IsCompletePrefix, DeadEndDetection,
//   ValidTokenCount) do not affect steps. Every mutating branch checks
//   steps < maxSteps before incrementing, so steps stays within maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var finalizeThreshold: nat := 2;
var narrowFinalizeCount: nat := 1;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if steps + 1 > maxSteps {
      break;
    } else {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var remaining: nat := maxSteps - steps;
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, narrowFinalizeCount);
      if remaining <= finalizeThreshold || narrow {
        if steps + 1 > maxSteps {
          break;
        } else {
          var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
            lm, parser, generated, currentConstrainedOut
          );
          generated := closedGenerated;
          insideConstrainedOut := closedInside;
          currentConstrainedOut := closedCurrent;
          steps := steps + 1;
        }
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt := prompt + stablePrefix;
        var next := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    } else {
      var stablePrefix2 := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt2 := prompt + stablePrefix2;
      var next2 := helpers.ConstrainedStep(
        lm, parser, constrainedPrompt2, currentConstrainedOut, eosToken
      );
      steps := steps + 1;
      if next2 == eosToken {
        break;
      } else {
        var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next2
        );
        generated := appendedGenerated2;
        insideConstrainedOut := appendedInside2;
        currentConstrainedOut := appendedCurrent2;
      }
    }
  }
}

cost := steps;

