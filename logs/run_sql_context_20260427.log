Strategy: // CSD_RATIONALE_BEGIN
// The last strategy guaranteed grammatical SQL inside `<< >>`, but the emitted
// queries often contained low-information placeholder-like continuations such as
// `SELECT <id> .!!!`. That pattern strongly suggests a tokenization mismatch:
// the parser can validate schema-aware SQL prefixes, but the decoder was still
// letting the LM choose arbitrary raw tokens through `ConstrainedStep`, then
// merely appending them if they happened to pass. On Spider, many crucial SQL
// decisions are at identifier/operator positions where unrestricted LM tokens
// can drift into punctuation or fragmented pieces even while remaining locally
// recoverable.
//
// This revision changes the constrained core to a candidate-filtered policy:
//
// 1. Enter the constrained span immediately and keep all SQL inside `<< ... >>`.
//
// 2. While inside the span, never free-sample arbitrary tokens. Instead, ask
//    for a small set of top parser-valid candidates with `TopValidCandidates`.
//    We then explicitly boost those valid candidates, heavily penalize EOS while
//    the SQL prefix is incomplete, and choose from the adjusted logits. This
//    keeps generation aligned with LM preferences but only among parser-valid
//    next tokens.
//
// 3. If the parser reports completion, close immediately with `>>`. We do not
//    wait for the model to emit a closing delimiter, and we never call
//    CloseConstrainedSpan unless completion is already known.
//
// 4. If no good valid candidates are available, fall back to
//    `ConstrainedStep`, which still respects the parser. This preserves
//    robustness without making it the default path.
//
// 5. EOS remains terminal. Outside the constrained span we stop immediately
//    after opening/closing, so the output is exactly one wrapped SQL query.
//
// The key fix is therefore not merely "more parser guidance" but "LM choice only
// over parser-valid candidates", which directly targets the observed malformed
// identifier/punctuation continuations while preserving the already-perfect
// syntax-rate behavior.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: Opening creates an empty constrained span, which is a valid
//   parser prefix. In the candidate-choice and fallback branches, we append only
//   a token obtained either from TopValidCandidates or ConstrainedStep, then use
//   AppendConstrainedToken, so the new constrained prefix remains valid. In the
//   close branch, insideConstrainedOut becomes false, making the implication
//   vacuous. Break branches do not mutate state.
//
// suffix: After opening, currentConstrainedOut is empty, so generated trivially
//   ends with it. In both append branches, AppendConstrainedToken updates
//   generated and currentConstrainedOut together, preserving that generated ends
//   with the constrained contents. Closing sets insideConstrainedOut to false,
//   so the suffix invariant is vacuous thereafter. Break branches preserve the
//   previous relation.
//
// progress: OpenConstrainedSpan appends exactly 1 token and we increment steps
//   by 1. CloseConstrainedSpan also appends exactly 1 token and we increment
//   steps by 1. In the candidate-choice branch we manually choose exactly 1
//   token and append exactly 1 token, so steps increases by 1. In the fallback
//   branch ConstrainedStep yields one token and AppendConstrainedToken appends
//   one token, so again steps increases by 1. Any EOS or stop branch breaks
//   without mutation. Thus `|generated| <= |generatedPrefix| + steps` is
//   preserved by linear arithmetic.
//
// cost accounting: Returned cost is `steps`. Every mutating branch appends
//   exactly one token and increments steps by exactly one. Query-only calls such
//   as IsCompletePrefix, TopValidCandidates, DeadEndDetection, and
//   ValidTokenCount do not affect steps. In the manual candidate-choice branch,
//   we also manually bump `helpers.cost`, but returned `cost` still equals
//   `steps`, as required.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var candidates := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 8, eosToken);
      if |candidates| > 0 {
        lm.GenerateLogits(prompt + generated);
        helpers.BoostTokenLogits(lm, candidates, 8.0);
        helpers.PenalizeTokenLogits(lm, [eosToken], 100.0);
        var next := lm.ChooseNextToken();
        helpers.cost := helpers.cost + 1;
        if next == eosToken {
          break;
        } else {
          var isValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
          if isValid {
            var appendedGenerated1, appendedInside1, appendedCurrent1 := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
            generated := appendedGenerated1;
            insideConstrainedOut := appendedInside1;
            currentConstrainedOut := appendedCurrent1;
            steps := steps + 1;
          } else {
            var backup := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
            if backup == eosToken {
              break;
            } else {
              var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, backup);
              generated := appendedGenerated2;
              insideConstrainedOut := appendedInside2;
              currentConstrainedOut := appendedCurrent2;
              steps := steps + 1;
            }
          }
        }
      } else {
        var next2 := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
        if next2 == eosToken {
          break;
        } else {
          var appendedGenerated3, appendedInside3, appendedCurrent3 := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next2);
          generated := appendedGenerated3;
          insideConstrainedOut := appendedInside3;
          currentConstrainedOut := appendedCurrent3;
          steps := steps + 1;
        }
      }
    }
  }

  if !insideConstrainedOut {
    break;
  }
}

cost := steps;

