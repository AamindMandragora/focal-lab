Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed not on syntax but on semantics: it opened a
// constrained SQL span immediately and then relied on token-by-token constrained
// decoding from an empty SQL prefix. On Spider, that deprived the model of its
// strongest prior about how to begin the answer and led to schema-valid but
// nonsensical SQL-like continuations such as repeated identifiers.
//
// This revision switches to a two-phase strategy:
//
// 1. First, generate unconstrained text until either `<<` appears or EOS
//    appears. This lets the model naturally emit the answer wrapper expected by
//    evaluation instead of forcing SQL generation from an empty constrained
//    state. We use `UnconstrainedChunk` for efficiency and to preserve a simple
//    progress argument.
//
// 2. Once inside `<< ...`, decode SQL with the schema-aware parser. But unlike
//    the prior attempt, we do not blindly continue until budget exhaustion.
//    If the constrained prefix is complete, we close immediately. Otherwise we
//    inspect the valid-next-token count: when the parser reports a very narrow
//    frontier, we use `ConstrainedSymbol` to let the parser drive through a
//    short deterministic region; otherwise we take a single `ConstrainedStep`.
//    This reduces drifting repetitions while still allowing model choice when
//    the grammar leaves meaningful ambiguity.
//
// 3. EOS remains terminal everywhere. If unconstrained generation hits EOS we
//    stop; if constrained generation returns EOS we stop without ignoring it.
//
// The key change in response to the evaluation results is therefore: do not
// force the model to start SQL immediately after an artificial opening step.
// Instead, allow the model to produce the `<<` delimiter naturally, then apply
// parser guidance only within the SQL span, with aggressive close-on-complete.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained-chunk branch, either we stay outside
//   the constrained region (implication vacuous) or we stop exactly on opening
//   `<<`, after which OpenConstrainedSpan initializes an empty constrained
//   prefix, valid by the method precondition on parser.IsValidPrefix([]). In
//   the close branch, insideConstrainedOut becomes false, so the implication is
//   vacuous. In the ConstrainedSymbol branch, the helper returns a new
//   constrained prefix produced under parser control, so validity is preserved;
//   if EOS is hit we break without mutation. In the single-token constrained
//   branch, ConstrainedStep chooses a valid next token and
//   AppendConstrainedToken extends the prefix accordingly; EOS again breaks
//   without mutation.
//
// suffix: While outside the constrained region, currentConstrainedOut is [] so
//   the suffix invariant is vacuous. Opening the span appends only the `<<`
//   delimiter and leaves currentConstrainedOut empty, so the invariant holds.
//   Closing clears currentConstrainedOut, again making the implication vacuous.
//   ConstrainedSymbol and AppendConstrainedToken both extend generated and the
//   tracked constrained suffix in lockstep, so generated's trailing
//   |currentConstrainedOut| tokens remain exactly currentConstrainedOut. Break
//   branches do not mutate state.
//
// progress: UnconstrainedChunk appends exactly stepsUsed tokens and we increase
//   steps by stepsUsed. OpenConstrainedSpan and CloseConstrainedSpan append
//   exactly 1 token and we increase steps by 1. ConstrainedSymbol appends
//   exactly stepsUsed constrained tokens and we increase steps by stepsUsed;
//   if it reports EOS, generated may grow by fewer than or equal to stepsUsed
//   tokens, which still preserves the inequality. The single-token constrained
//   branch increases steps by 1; if EOS is returned, generated is unchanged,
//   otherwise AppendConstrainedToken appends exactly 1 token. All arithmetic is
//   linear.
//
// cost accounting: We maintain a local `steps` counter and return `cost :=
//   steps`. Every generation helper branch increments `steps` by exactly the
//   helper-reported amount: 1 for OpenConstrainedSpan and CloseConstrainedSpan,
//   `stepsUsed` for UnconstrainedChunk and ConstrainedSymbol, and 1 for each
//   ConstrainedStep attempt. Pure parser queries such as IsCompletePrefix and
//   ValidTokenCount do not affect steps. The guard and branch conditions ensure
//   `steps` never exceeds `maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var openSpanToken := "<<";

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remaining := maxSteps - steps;
    var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, remaining, openSpanToken, eosToken
    );
    generated := chunkGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else {
      if stoppedOnOpenSpan && steps < maxSteps {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        steps := steps + 1;
      } else {
        break;
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var remainingInside := maxSteps - steps;
      if validCount <= 2 && 0 < remainingInside {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt := prompt + stablePrefix;
        var symbolCurrent, hitEos, symbolSteps := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, remainingInside, eosToken
        );
        var oldLen := |currentConstrainedOut|;
        currentConstrainedOut := symbolCurrent;
        generated := generated + currentConstrainedOut[oldLen..];
        steps := steps + symbolSteps;
        if hitEos {
          break;
        }
      } else {
        var stablePrefix2 := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt2 := prompt + stablePrefix2;
        var next := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt2, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

