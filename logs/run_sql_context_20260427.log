Strategy: // CSD_RATIONALE_BEGIN
// The prior revision over-corrected toward "never stop early": it kept extending
// constrained decoding unless budget pressure forced closure. On Spider, that
// produced syntactically valid but semantically drifting SQL, with previews like
// "SELECT count!" indicating the model often wanted to emit a complete short
// aggregate query but was pushed to continue past the best stopping point.
//
// This revision changes the policy from "continue unless forced to stop" to
// "stop as soon as the SQL prefix looks decisively complete, otherwise extend
// conservatively". Concretely:
//
// 1. We still open the constrained span immediately, because Spider expects the
//    answer to be a single SQL query and the evaluator requires << >>.
//
// 2. Inside the span, decoding remains token-by-token with ConstrainedStep for
//    schema-aware precision, but completion handling is now aggressive:
//    whenever parser.IsCompletePrefix(currentConstrainedOut) holds, we close the
//    span immediately on the next available step. This directly addresses the
//    observed under-accuracy from over-generation after a valid complete query.
//
// 3. For incomplete prefixes, we keep extending one constrained token at a time.
//    If ConstrainedStep returns eosToken, EOS is terminal and we stop
//    immediately as required.
//
// This strategy is intentionally simple and completion-biased: for Spider, a
// short exact SQL query is usually better than a longer valid continuation that
// changes semantics. The design also keeps proof obligations straightforward by
// using only one-token state transitions whose effects on parser validity,
// suffix tracking, and progress are easy to state.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open-span branch, OpenConstrainedSpan starts a fresh
//   constrained segment with empty currentConstrainedOut, which is a valid
//   parser prefix by precondition. In the close-span branch, insideConstrainedOut
//   becomes false, so the implication is vacuous. In the append branch,
//   ConstrainedStep supplies a parser-valid next token for the current prefix,
//   and AppendConstrainedToken extends currentConstrainedOut by exactly that
//   token, preserving parser validity. EOS branches break without mutation.
//
// suffix: Opening the span appends only the delimiter and leaves
//   currentConstrainedOut empty, so the suffix property holds trivially. Closing
//   the span clears currentConstrainedOut, so the implication is vacuous.
//   Appending a constrained token extends both generated and
//   currentConstrainedOut by the same one token, so generated's trailing suffix
//   remains exactly currentConstrainedOut. Break branches preserve the existing
//   relation unchanged.
//
// progress: Initially generated == generatedPrefix. OpenConstrainedSpan and
//   CloseConstrainedSpan each append exactly 1 token and we increment steps by
//   1. ConstrainedStep followed by AppendConstrainedToken appends exactly 1
//   token and we increment steps by 1. If ConstrainedStep returns eosToken, we
//   increment steps by 1 for that sampled step and then break without appending,
//   so |generated| still satisfies |generated| <= |generatedPrefix| + steps.
//   All arithmetic is linear.
//
// cost accounting: We use a local steps counter and return cost := steps.
//   Every mutating generation branch increments steps by exactly the amount of
//   generation work performed: 1 for OpenConstrainedSpan, 1 for
//   CloseConstrainedSpan, and 1 for each ConstrainedStep attempt. Query helpers
//   like IsCompletePrefix do not affect steps. The loop guard ensures
//   steps <= maxSteps throughout.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var next := helpers.ConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

