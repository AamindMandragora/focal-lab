Strategy: // CSD_RATIONALE_BEGIN
// The prior strategy over-generated unconstrained wrapper text before entering
// the SQL span, and then mixed parser-driven decoding with model-driven single
// token choices. The evaluation failures show a characteristic semantic error:
// the model often produced malformed wrapper/transition structure around an
// otherwise grammar-valid SQL fragment, yielding outputs like `... FROM <id>>><id>`.
// In other words, syntax inside the SQL grammar was fine, but the boundary
// management around `<< ... >>` and the late opening of the constrained span
// let the model drift.
//
// This revision makes the strategy much more direct and Spider-specific:
//
// 1. If we are not already inside a constrained span, immediately open one.
//    This guarantees the output contains `<<` early and that essentially all
//    useful generation budget is spent on schema-constrained SQL rather than on
//    unconstrained wrapper prose.
//
// 2. While inside the span, prefer parser-driven multi-token advancement via
//    `ConstrainedSymbol`. This lets the grammar carry the decode through common
//    SQL units instead of repeatedly exposing the model to fragile local choices
//    after every token. When the parser reports completion, close immediately;
//    we never wait for the model to emit `>>`.
//
// 3. EOS remains terminal. If the constrained helper reports EOS, we stop
//    rather than trying to recover. This avoids creating extra junk after a
//    plausible partial query.
//
// 4. Outside a constrained span after closure, we stop immediately instead of
//    generating any trailing unconstrained text. Spider expects a single SQL
//    query, so extra text after `>>` only hurts accuracy.
//
// The main change, therefore, is to remove the unconstrained prelude and nearly
// all unconstrained post-processing, turning the method into an "open early,
// stay constrained, close as soon as complete" decoder.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the opening branch, OpenConstrainedSpan sets
//   currentConstrainedOut to the empty constrained prefix, which is valid by the
//   method precondition on parser.IsValidPrefix([]). In the constrained-symbol
//   branch, the helper returns a parser-approved continuation, so the updated
//   currentConstrainedOut remains a valid prefix; if EOS is hit we break without
//   further mutation. In the close branch, insideConstrainedOut becomes false,
//   making the implication vacuous. The final outside branch only breaks.
//
// suffix: Opening appends only the `<<` delimiter and leaves
//   currentConstrainedOut empty, so the suffix property holds immediately.
//   During constrained-symbol decoding, we name the stable prefix
//   `generated[..|generated| - |currentConstrainedOut|]` and rebuild generated
//   as that stable prefix plus the new constrained suffix returned by the
//   helper, so the trailing tokens are exactly currentConstrainedOut. Closing
//   clears the constrained suffix, making the implication vacuous. Break-only
//   branches do not mutate state.
//
// progress: OpenConstrainedSpan appends exactly 1 token and we increment steps
//   by 1. ConstrainedSymbol appends exactly stepsUsed tokens and we increment
//   steps by stepsUsed. CloseConstrainedSpan appends exactly 1 token and we
//   increment steps by 1. Any branch that cannot safely append instead breaks
//   immediately. Hence `|generated| <= |generatedPrefix| + steps` is preserved
//   by linear arithmetic.
//
// cost accounting: We return `cost := steps`. Every mutating generation branch
//   updates steps by exactly the amount specified by the helper contract: 1 for
//   OpenConstrainedSpan and CloseConstrainedSpan, and `stepsUsed` for
//   ConstrainedSymbol. Query-only operations like IsCompletePrefix do not affect
//   steps. The loop guard and branch conditions ensure steps never exceeds
//   maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant insideConstrainedOut ==> generated == generated[..|generated| - |currentConstrainedOut|] + currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var remaining := maxSteps - steps;
      if remaining == 0 {
        break;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt := prompt + stablePrefix;
        var symbolCurrent, hitEos, stepsUsed := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, remaining, eosToken
        );
        currentConstrainedOut := symbolCurrent;
        generated := stablePrefix + currentConstrainedOut;
        steps := steps + stepsUsed;
        if hitEos {
          break;
        }
      }
    }
  }

  if !insideConstrainedOut {
    break;
  }
}

cost := steps;

