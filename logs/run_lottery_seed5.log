Strategy: // CSD_RATIONALE_BEGIN
// This strategy tracks the full generated output in `generated`, whether we are
// currently inside a constrained arithmetic span in `insideConstrainedOut`, and
// the contents of the active span in `currentConstrainedOut`. Outside spans it
// generates mostly freely, but it proactively opens a span when either the
// sampled token is "<<" or the delimiter token is competitively scored. Inside
// spans it uses parser-aware constrained decoding, with a small speculative
// fast path: if the current argmax token is parser-valid, append it directly;
// otherwise fall back to ConstrainedStep. This tracked state ensures that text
// between delimiters is always a parser-valid arithmetic prefix and remains the
// suffix of the full generated output until the span is closed.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if we open a span we set
//   currentConstrainedOut := [], which is a valid prefix by precondition on the
//   parser. If we merely append a non-delimiter token, insideConstrainedOut
//   stays false, so the implication is vacuous. In the complete-prefix branch,
//   CloseConstrainedSpan resets insideConstrainedOut to false, again making the
//   implication vacuous. In the speculative constrained branch we only call
//   AppendConstrainedToken after IsTokenValidNext says the argmax token is
//   valid; in the fallback branch ConstrainedStep supplies a valid next token
//   (or eosToken, which breaks), so validity is preserved there too.
// suffix: In unconstrained generation, when we open a span we have just
//   appended "<<" and set currentConstrainedOut := [], so the length-0 suffix
//   matches. If we stay outside a span, the implication is vacuous. In the
//   complete-prefix branch, CloseConstrainedSpan appends ">>" and resets the
//   constrained prefix to [], so the suffix property is vacuous afterward. In
//   both constrained append branches, AppendConstrainedToken appends the same
//   token to generated and currentConstrainedOut, preserving suffix equality.
// cost: UnconstrainedStep, ConstrainedStep, and CloseConstrainedSpan each bump
//   helpers.cost by 1 internally, and in exactly those branches we also do
//   steps := steps + 1. Query helpers and AppendConstrainedToken do not bump
//   helpers.cost; in the speculative argmax-valid branch we still increase
//   steps by 1, so helpers.cost <= steps remains true with slack.
// progress: In the unconstrained branch we append at most one token to
//   generated; in the complete-prefix branch we append only the closing
//   delimiter; in each constrained append branch we append exactly one token;
//   and on EOS branches we break without further growth. Since steps increases
//   by 1 once per non-breaking iteration, |generated| <= |generatedPrefix| +
//   steps is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var top := helpers.GetHighestLogitToken(lm);
    var topLogit := helpers.GetTokenLogit(lm, top);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    if openLogit >= topLogit - 2.0 && top != eosToken && top != "<<" {
      generated := generated + ["<<"];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);
      if argmax != eosToken && argmaxValid {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

cost := steps;

