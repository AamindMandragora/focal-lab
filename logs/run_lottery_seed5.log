Strategy: // CSD_RATIONALE_BEGIN
// The revised strategy is stricter and simpler inside constrained spans to
// improve syntax rate and runtime. The previous attempt sometimes opened spans
// too eagerly and let the model place natural-language variable names or other
// non-arithmetic text inside `<< >>`, producing malformed constrained content
// such as `<<n1 + n2>>` or incomplete expressions. This version therefore uses
// a conservative policy:
//
// 1. Outside constrained mode, generation is mostly unconstrained, but we only
//    proactively open `<<` when its logit is the current argmax. This reduces
//    accidental entry into constrained mode.
// 2. Inside constrained mode, we never speculatively append an unconstrained
//    argmax token. Every token is chosen by `ConstrainedStep`, so the span
//    contents remain parser-valid at every step.
// 3. As soon as the constrained prefix is complete, we immediately close with
//    `>>`; we never inspect a sampled `">>"` token and never keep generating
//    after completion.
// 4. We add a lightweight dead-end recovery: if the valid-next-token count is
//    very small and dead-end detection reports danger, we roll back the active
//    constrained prefix to a valid earlier prefix, update the generated suffix
//    consistently, and continue from there without spending a decoding step.
//    This directly addresses truncated or malformed arithmetic spans.
// 5. We avoid extra logit generation work inside constrained mode except where
//    helper methods already encapsulate it, which improves runtime.
//
// The result is a more reliable "step-by-step with arithmetic in << >>"
// decoder: natural language is generated outside spans, while arithmetic spans
// are produced only through parser-aware constrained decoding.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Outside constrained mode, either we stay outside (so the implication is
//     vacuous), or we open a new span and set currentConstrainedOut := [], which
//     is valid by the parser precondition.
//   - In the rollback branch, RollbackToValidPrefix returns a valid prefix and
//     we keep insideConstrainedOut true, so validity is preserved.
//   - In the complete branch, CloseConstrainedSpan sets insideConstrainedOut
//     false, making the implication vacuous afterward.
//   - In the constrained-step branch, ConstrainedStep supplies a parser-valid
//     next token unless it returns eosToken, and AppendConstrainedToken extends
//     the valid prefix accordingly.
//
// suffix:
//   - Outside constrained mode, if we remain outside then the implication is
//     vacuous; if we open a span, generated gains only `<<` and the active
//     constrained content becomes empty, so the empty suffix matches.
//   - In the rollback branch, we set generated to the old unconstrained prefix
//     plus the rolled-back constrained prefix, so the new suffix is exactly
//     currentConstrainedOut.
//   - In the complete branch, closing resets insideConstrainedOut to false, so
//     the implication is vacuous.
//   - In the constrained-step append branch, AppendConstrainedToken appends the
//     same token to generated and currentConstrainedOut, preserving the suffix
//     equality.
//
// cost:
//   - UnconstrainedStep, ConstrainedStep, OpenConstrainedSpan, and
//     CloseConstrainedSpan each bump helpers.cost by 1 internally, and in each
//     such branch we also increment steps by 1.
//   - Query helpers (ValidTokenCount, DeadEndDetection, RollbackToValidPrefix,
//     GetHighestLogitToken, GetTokenLogit) do not bump helpers.cost, and the
//     rollback branch does not change steps, so helpers.cost <= steps is
//     preserved there as well.
//   - Break branches occur only immediately after a cost-bumping helper and a
//     matching steps increment.
//
// progress:
//   - In unconstrained generation, a decoding step appends at most one token, or
//     OpenConstrainedSpan appends only `<<`; both happen only when steps is
//     incremented by 1, so |generated| grows by at most 1 per charged step.
//   - In the rollback branch, generated can only shrink or stay the same, and
//     steps is unchanged, so the bound is preserved.
//   - In the complete branch, closing appends only `>>` while steps increases by
//     1.
//   - In the constrained-step branch, either eosToken causes a break with no
//     growth, or one constrained token is appended while steps increases by 1.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var top := helpers.GetHighestLogitToken(lm);
    if top == "<<" {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      if narrow && validCount <= 1 {
        var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
        generated := generated[..|generated| - |currentConstrainedOut|] + rolled;
        currentConstrainedOut := rolled;
      } else {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

