Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it opened constrained spans too eagerly
// from unconstrained text and then often never reached a verified close, causing
// unterminated `<< ...` output and zero syntax rate. The revised strategy is
// conservative: it never opens a constrained span speculatively from ordinary
// unconstrained sampling. Instead, outside a span it strongly biases toward the
// literal `<<` token and, if that token is chosen, immediately enters a parser-
// tracked constrained segment with empty contents; otherwise it emits the sampled
// token normally. Inside a span, it prioritizes guaranteed well-formed closure:
// if the constrained prefix is complete, it closes immediately with `>>`; if not,
// it uses parser-guided constrained decoding and appends only parser-valid next
// tokens. This directly targets the evaluation failure mode by making every open
// span come from an explicit `<<` token and making closure happen as soon as the
// parser allows it, so generated arithmetic spans are much more likely to be
// syntactically complete as `<< computation >>`.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, if `<<` is not chosen then
//   insideConstrainedOut remains false, so the implication is vacuous; if `<<`
//   is chosen, OpenConstrainedSpan sets currentConstrainedOut to [] and the
//   precondition gives parser.IsValidPrefix([]). In the inside-complete branch,
//   CloseConstrainedSpan makes insideConstrainedOut false, so the implication is
//   vacuous. In the inside-incomplete branch, ConstrainedStep supplies a parser-
//   admissible token (or eosToken, which breaks), and AppendConstrainedToken
//   preserves parser validity.
// suffix: Outside without opening, constrained state is unchanged so any prior
//   suffix relation is preserved vacuously or directly. Opening uses
//   OpenConstrainedSpan, which appends `<<` while setting currentConstrainedOut
//   to [], so the length-0 suffix matches. Closing uses CloseConstrainedSpan,
//   which resets the constrained state to empty. Appending a constrained token
//   via AppendConstrainedToken extends both generated and currentConstrainedOut
//   by the same token, preserving suffix equality.
// cost: In the outside branch we use ChooseNextToken and manually increment
//   helpers.cost once, then increment steps once, so helpers.cost <= steps is
//   preserved. OpenConstrainedSpan, ConstrainedStep, and CloseConstrainedSpan
//   each bump helpers.cost by 1 internally, and each corresponding branch also
//   increments steps once. AppendConstrainedToken does not bump helpers.cost, so
//   performing it in the same iteration after a costed constrained step still
//   keeps helpers.cost <= steps.
// progress: Every continuing iteration increases steps by exactly 1. Outside
//   without opening, generated gains one sampled token; opening adds exactly the
//   single delimiter token `<<`; closing adds exactly `>>`; and constrained
//   append adds exactly one token. Thus generated grows by at most one token per
//   step, maintaining |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 8.0);
    helpers.PenalizeTokenLogits(lm, [eosToken], 3.0);
    var next := lm.ChooseNextToken();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;

    if next == eosToken {
      break;
    } else if next == "<<" {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
    } else {
      generated := generated + [next];
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

