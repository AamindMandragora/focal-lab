Strategy: // CSD_RATIONALE_BEGIN
// Strategy for step-by-step math solutions with arithmetic spans in << >>.
// The state tracks the full generated answer in `generated`, whether we are
// currently inside a constrained arithmetic span in `insideConstrainedOut`, and
// the current span contents alone in `currentConstrainedOut`. Outside a span we
// decode mostly freely, but if the model's logit for "<<" is close to the
// current argmax, or if the sampled token itself is "<<", we open a constrained
// span so arithmetic text is generated under parser control. Inside a span we
// first try a speculative argmax token when it is parser-valid; otherwise we
// fall back to `ConstrainedStep`, and once the parser reports a complete prefix
// we close with `>>`. This tracked split between full output and active span
// suffix is what lets the method preserve parser-valid arithmetic content while
// still allowing natural unconstrained explanation text between computations.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, either we stay outside the span
//   (implication vacuous) or we open a span by appending "<<" and setting
//   currentConstrainedOut := [], which is a valid prefix by precondition on the
//   parser. In the complete-prefix branch, CloseConstrainedSpan sets
//   insideConstrainedOut to false, so the implication is vacuous afterward. In
//   the speculative constrained branch we call AppendConstrainedToken only when
//   IsTokenValidNext says the argmax token is valid; in the fallback branch,
//   ConstrainedStep supplies a valid next token or eosToken, and on non-EOS we
//   append that valid token, preserving parser validity.
// suffix: In unconstrained generation, if we remain outside the span the suffix
//   invariant is vacuous; if we open a span, currentConstrainedOut becomes []
//   so the length-0 suffix of generated matches it. In the close branch,
//   CloseConstrainedSpan appends ">>" and resets currentConstrainedOut to [],
//   making the implication vacuous. In both constrained append branches,
//   AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, so the tracked span remains the suffix.
// cost: In the unconstrained raw-sampling branch we use GenerateLogits and
//   queries without cost, then ChooseNextTokenUnconstrained and manually bump
//   helpers.cost by 1; steps is also incremented by 1. CloseConstrainedSpan and
//   ConstrainedStep each bump helpers.cost internally, and we increment steps
//   once in those branches as well. The speculative argmax-valid append branch
//   increments steps but uses only non-bumping queries plus AppendConstrainedToken,
//   so helpers.cost <= steps is preserved with slack.
// progress: In the unconstrained branch we append at most one token to
//   generated; in the close branch CloseConstrainedSpan appends exactly one
//   token; in each constrained append branch AppendConstrainedToken appends one
//   token. Since steps increases by 1 on every non-breaking iteration,
//   |generated| <= |generatedPrefix| + steps is preserved in every branch.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    if openLogit >= argmaxLogit - 2.0 && argmax != eosToken {
      generated := generated + ["<<"];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
      steps := steps + 1;
    } else {
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);
      if argmaxValid && argmax != eosToken {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

