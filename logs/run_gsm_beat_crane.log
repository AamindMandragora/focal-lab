Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy opened constrained spans based on a loose trigger and
// then tried to let the parser drive arbitrary arithmetic content. Evaluation
// shows that this produced almost-always unterminated `<< ...` segments and
// very poor syntax. The core problem is not a small bug; it is the strategy:
// opening a span too early without a reliable closing plan is fatal when the
// task requires literal `<< >>` arithmetic snippets.
//
// This revision switches to a much more conservative two-phase policy:
//   1. Stay unconstrained for almost the entire answer.
//   2. Open at most one constrained span, and only very late in generation,
//      after some ordinary text has already been produced.
//   3. Once inside the span, use parser-constrained stepping only until the
//      constrained prefix is complete, then immediately close with `>>`.
//   4. If constrained decoding hits EOS before completion, roll back the whole
//      constrained content to `[]` and keep going; this guarantees we do not
//      leave malformed partial arithmetic inside the output.
//   5. If a span grows too long without becoming complete, also roll it back to
//      `[]` and exit constrained mode rather than risking an unterminated span.
//
// The intended effect is to trade some creativity for reliability: generate
// normal chain-of-thought text first, then insert one short verified arithmetic
// segment and close it promptly. This directly addresses the measured failure
// mode `unterminated_constrained_segment`, while still using the parser to
// enforce valid arithmetic inside `<< >>`.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Unconstrained branches either remain outside constrained mode, or open a
//     fresh span with `currentConstrainedOut := []`; validity holds because
//     `parser.IsValidPrefix([])` is required.
//   - The constrained append branch uses `ConstrainedStep`, which guarantees
//     that on non-EOS the returned constrained prefix is parser-valid.
//   - The constrained close branch exits constrained mode, so the implication
//     becomes vacuous.
//   - The rollback/abort branch sets `currentConstrainedOut := []` and
//     `insideConstrainedOut := false`, so validity is again vacuous.
//
// suffix:
//   - Outside constrained mode the invariant is vacuous.
//   - Opening a span appends only the delimiter `<<` and sets the tracked
//     constrained content to `[]`, which is the empty suffix.
//   - `ConstrainedStep` preserves the suffix relation by appending the same
//     token to both `generated` and `currentConstrainedOut`.
//   - Closing or aborting a span leaves constrained mode, so the suffix
//     implication becomes vacuous afterward.
//   - In the abort branch we trim exactly `|currentConstrainedOut|` trailing
//     constrained tokens from `generated` before clearing the constrained
//     state, so no stale constrained suffix remains.
//
// progress:
//   - The ordinary unconstrained branch appends exactly one token via
//     `UnconstrainedStep` and increments `steps` by 1.
//   - The open-span branch appends exactly one delimiter token via
//     `OpenConstrainedSpan` and increments `steps` by 1.
//   - The constrained append branch uses `ConstrainedStep`; on non-EOS it
//     appends exactly one token and increments `steps` by 1.
//   - The constrained close branch appends at most one token and increments
//     `steps` by 1.
//   - The abort branch may shrink `generated`, appends no tokens, and still
//     increments `steps` by 1, so `|generated| <= |generatedPrefix| + steps`
//     is preserved trivially.
//   - EOS branches break immediately.
//
// cost accounting:
//   - We use `steps` as the returned cost and keep `cost == 0` throughout the
//     loop.
//   - Every non-breaking branch increases `steps` by exactly 1, including the
//     pure recovery branch that trims a failed constrained span.
//   - Since the loop guard enforces `steps < maxSteps`, we maintain
//     `steps <= maxSteps`; assigning `cost := steps` at the end gives the
//     required `cost <= maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var openedSpan := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var gClose, iClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := gClose;
      insideConstrainedOut := iClose;
      currentConstrainedOut := cClose;
      steps := steps + 1;
    } else {
      if 12 <= |currentConstrainedOut| {
        generated := generated[..|generated| - |currentConstrainedOut|];
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        steps := steps + 1;
      } else {
        var gStep, iStep, cStep, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt, generated, currentConstrainedOut, eosToken
        );
        if hitEos {
          generated := generated[..|generated| - |currentConstrainedOut|];
          insideConstrainedOut := false;
          currentConstrainedOut := [];
          steps := steps + 1;
        } else {
          generated := gStep;
          insideConstrainedOut := iStep;
          currentConstrainedOut := cStep;
          steps := steps + 1;
        }
      }
    }
  } else {
    if !openedSpan && "<<" in lm.Tokens && steps + 2 < maxSteps && 8 <= |generated| {
      var gOpen, iOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
      generated := gOpen;
      insideConstrainedOut := iOpen;
      currentConstrainedOut := cOpen;
      openedSpan := true;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      generated := generated + [next];
      steps := steps + 1;
      if next == eosToken {
        break;
      }
    }
  }
}

