Strategy: // CSD_RATIONALE_BEGIN
// The failed strategy over-corrected: it forced `<<` almost immediately, so the
// model spent nearly the whole answer inside one constrained span and produced a
// generic algebraic template instead of solving the actual problem. The traces
// show exactly that failure mode: early open, long constrained expression, then
// shallow prose. To fix this, the new strategy delays constrained decoding until
// there is already some ordinary explanatory text in `generated`. That directly
// targets the evaluator's complaint `entered_constrained_mode_too_early`.
//
// Concretely, outside constrained mode the strategy now has three phases.
// First, for a short warmup prefix it simply generates unconstrained tokens.
// Second, once enough text exists and no arithmetic span has appeared yet, it
// performs a single targeted attempt to open `<<` by boosting that token. Third,
// after a span has already appeared, it returns to ordinary unconstrained
// generation. This makes `<< >>` likely to occur at least once, but not at the
// very beginning of the answer.
//
// Inside constrained mode, the strategy is intentionally simple and local:
// generate exactly one parser-valid token at a time with
// `AdaptiveConstrainedStep`, append it, and as soon as the constrained prefix is
// complete, close immediately with `CloseConstrainedSpan`. This avoids the prior
// malformed/unterminated spans while still guaranteeing that every token inside
// `<< >>` is parser-valid. The strategy never closes merely because a sampled
// token looks like `">>"`; closure happens only from a branch where
// `parser.IsCompletePrefix(currentConstrainedOut)` is known.
//
// The revision also removes the broad penalties that pushed the model toward a
// repeated symbolic template (`k * y / x * 100`). Those penalties improved local
// syntax but hurt semantic accuracy by overwhelming the problem-specific context.
// The new constrained branch uses only adaptive group boosting supplied by the
// caller, which is milder and lets the parser shape arithmetic form without
// forcing the same expression every time.
//
// Finally, the loop is kept proof-friendly: every non-breaking branch increases
// `steps` by exactly 1, EOS always stops immediately, and the constrained suffix
// relation is preserved by only using `AppendConstrainedToken` to extend the
// active span.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Warmup / ordinary unconstrained branch: we stay outside constrained mode,
//     so `insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)`
//     is vacuous. If the sampled token is `"<<"`, we enter constrained mode with
//     `currentConstrainedOut := []`, and `parser.IsValidPrefix([])` holds.
//   - Complete-prefix branch: `CloseConstrainedSpan` returns outside mode with
//     empty current span, so the implication is vacuous afterward.
//   - Constrained sampling branch: `AdaptiveConstrainedStep` ensures the sampled
//     token is EOS or parser-valid after the current prefix; on non-EOS,
//     `AppendConstrainedToken` updates `currentConstrainedOut` to that valid
//     extension, preserving parser validity.
//
// suffix:
//   - Unconstrained branches: while outside constrained mode the suffix
//     implication is vacuous; if `"<<"` is appended, we enter constrained mode
//     with empty constrained content, and the suffix of length 0 is `[]`.
//   - Complete-prefix branch: after `CloseConstrainedSpan` we are outside, so
//     the suffix implication is vacuous.
//   - Constrained sampling branch: `AppendConstrainedToken` appends the same
//     token to both `generated` and `currentConstrainedOut`, so the final
//     `|currentConstrainedOut|` tokens of `generated` equal the constrained
//     prefix.
//
// progress:
//   - Warmup / ordinary unconstrained / open-attempt branch: each performs one
//     unconstrained sample, increments `steps` by 1, and appends exactly one
//     token on non-EOS.
//   - Complete-prefix branch: `CloseConstrainedSpan` appends at most one token
//     and we increment `steps` by 1.
//   - Constrained sampling branch: one adaptive constrained sample is taken,
//     `steps` is incremented by 1, and on non-EOS exactly one token is appended.
//   - EOS branches break immediately after the step increment, satisfying the
//     decreases discipline.
//
// cost accounting:
//   - `cost` is initialized to 0 and unchanged inside the loop, so invariant
//     `cost == 0` is preserved.
//   - Every non-breaking loop branch increments local `steps` by exactly 1;
//     helper-internal bookkeeping may vary, but the returned method cost is set
//     explicitly to `steps` at the end, so `cost <= maxSteps` and returned cost
//     matches the loop progress measure.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var warmupTokens: nat := 8;
var openThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    if "<<" !in generated && "<<" in lm.Tokens && |generated| >= warmupTokens && |generated| <= openThreshold {
      helpers.BoostTokenLogits(lm, ["<<"], 8.0);
    }
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var g1, i1, c1 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := g1;
      insideConstrainedOut := i1;
      currentConstrainedOut := c1;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var g2, i2, c2 := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := g2;
        insideConstrainedOut := i2;
        currentConstrainedOut := c2;
      }
    }
  }
}

cost := steps;

