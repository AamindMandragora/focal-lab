Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it treated any unconstrained occurrence
// of "<<" as the start of a tracked constrained span. In the traces, the model
// often emitted "<<" very early (for example `<<x =`) and then the strategy
// dutifully entered parser-constrained mode, where it could not reliably finish
// the intended arithmetic snippet before budget exhaustion. That produced almost
// universal unterminated spans and destroyed answer quality.
//
// This revision makes two decisive changes:
//
// 1. We never infer constrained mode from unconstrained text. An unconstrained
//    chunk may contain "<<" in the raw output, but we do not set
//    `insideConstrainedOut := true` from that event. This directly eliminates
//    the prior runaway behavior where accidental early `<<` trapped the loop in
//    constrained generation.
// 2. We use a deliberate tail strategy: generate almost everything
//    unconstrained, then reserve the final few steps for one explicit,
//    verified constrained span opened by `OpenConstrainedSpan`. Inside that
//    span we use `AdaptiveConstrainedStep` to append parser-valid arithmetic
//    tokens, and as soon as the parser reports completeness we call
//    `CloseConstrainedSpan`. Because the span is opened only by us, we can
//    guarantee it is tracked and closed properly.
//
// Additional details:
// - We reserve up to 6 final steps for the explicit `<< ... >>` segment.
// - Outside constrained mode, EOS from unconstrained generation is ignored if
//   we still have room to add the required span; instead we open the tail span.
// - Once inside constrained mode, EOS is terminal as required: if the helper
//   samples EOS, we stop immediately.
// - We use `prompt + generated` as the stable prefix for adaptive constrained
//   sampling, so the LM sees the full already-written solution context.
// - The strategy is intentionally simple in the hot path: one unconstrained
//   chunk branch, one explicit open branch, one constrained append branch, and
//   one close branch. This is aimed at recovering the previously observed good
//   regime where normal solution text drives accuracy, while still ensuring a
//   well-formed `<< >>` arithmetic segment is actually emitted.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Unconstrained-chunk branches leave `insideConstrainedOut == false` and
//     keep `currentConstrainedOut == []`, so the implication is vacuous.
//   - The explicit open branch uses `OpenConstrainedSpan`, which sets the
//     tracked constrained prefix to `[]`; `parser.IsValidPrefix([])` holds by
//     precondition.
//   - The constrained append branch uses `AdaptiveConstrainedStep`, whose
//     result token is either EOS or parser-valid next; on the non-EOS path,
//     `AppendConstrainedToken` extends a valid prefix to another valid prefix.
//   - The close branch uses `CloseConstrainedSpan` only when
//     `parser.IsCompletePrefix(currentConstrainedOut)` is known, and afterward
//     we are outside constrained mode, so the implication is vacuous.
//
// suffix:
//   - While outside constrained mode, the implication is vacuous.
//   - After `OpenConstrainedSpan`, the tracked interior is `[]`, so the suffix
//     of length 0 of `generated` equals `currentConstrainedOut`.
//   - In the constrained append branch, `AdaptiveConstrainedStep` returns a
//     token that is parser-valid after the current prefix; then
//     `AppendConstrainedToken` appends that same token to both `generated` and
//     `currentConstrainedOut`, preserving the suffix relationship exactly.
//   - The close branch exits constrained mode, making the implication vacuous.
//
// progress:
//   - The unconstrained-chunk branch appends `stepsUsed` tokens and we set
//     `steps := steps + stepsUsed`; if EOS is observed and we choose not to
//     continue, we break immediately.
//   - The explicit open branch appends exactly one token (`"<<"`) and
//     increments `steps` by 1.
//   - The constrained append branch increments `steps` by 1; on EOS it breaks
//     immediately, otherwise exactly one token is appended by
//     `AppendConstrainedToken`.
//   - The close branch increments `steps` by 1 and appends at most one token.
//   - There are no query-only looping branches, so every non-breaking branch
//     strictly increases `steps`, satisfying `decreases maxSteps - steps`.
//
// cost accounting:
//   - We keep the out-parameter `cost` initialized to 0 throughout the loop,
//     so the loop invariant `cost == 0` is preserved in every branch.
//   - Each non-breaking branch increases `steps` by the exact amount of work
//     performed, and the loop invariant maintains `steps <= maxSteps`.
//   - After the loop we assign `cost := steps`, so the returned cost is at most
//     `maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var reserveTail: nat := 6;
var chunkSize: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      if steps + 1 <= maxSteps {
        var gClose, iClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := gClose;
        insideConstrainedOut := iClose;
        currentConstrainedOut := cClose;
        steps := steps + 1;
      } else {
        break;
      }
    } else {
      if steps + 1 <= maxSteps {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + generated, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var gApp, iApp, cApp := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := gApp;
          insideConstrainedOut := iApp;
          currentConstrainedOut := cApp;
        }
      } else {
        break;
      }
    }
  } else {
    var remaining := maxSteps - steps;
    var canOpen := false;
    if "<<" in lm.Tokens && remaining <= reserveTail && remaining >= 2 {
      canOpen := true;
    }

    if canOpen {
      var gOpen, iOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
      generated := gOpen;
      insideConstrainedOut := iOpen;
      currentConstrainedOut := cOpen;
      steps := steps + 1;
    } else {
      var maxChunk := chunkSize;
      if remaining > reserveTail {
        if remaining - reserveTail < maxChunk {
          maxChunk := remaining - reserveTail;
        }
      } else {
        if remaining < maxChunk {
          maxChunk := remaining;
        }
      }

      if maxChunk == 0 {
        break;
      } else {
        var gChunk, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
          lm, prompt, generated, maxChunk, "<<", eosToken
        );
        generated := gChunk;
        steps := steps + stepsUsed;
        if stoppedOnEos {
          if "<<" in lm.Tokens && steps < maxSteps && maxSteps - steps >= 2 {
            var gOpen2, iOpen2, cOpen2 := helpers.OpenConstrainedSpan(lm, generated);
            generated := gOpen2;
            insideConstrainedOut := iOpen2;
            currentConstrainedOut := cOpen2;
            steps := steps + 1;
          } else {
            break;
          }
        }
      }
    }
  }
}

cost := steps;

