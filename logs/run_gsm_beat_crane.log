// `AdaptiveConstrainedStep` with caller-supplied token groups to softly bias
// toward preferred arithmetic-symbol groups while still hard-masking to valid
// parser continuations. If the grammar is wider, it uses `ConstrainedSymbol` to
// let the model produce a short parser-valid chunk within the current arithmetic
// expression. The verification fix is minimal: cap the multi-token
// `ConstrainedSymbol` branch by the remaining loop budget, and only take that
// branch when the remaining budget is positive. This makes `steps := steps +
// stepsUsed` provably stay within `maxSteps`, which in turn restores the loop
// invariant and the final `|generated|` and `cost` postconditions.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Unconstrained branch: if EOS is sampled we break with state unchanged; if
//     a normal token is appended and it is not `"<<"`, we remain outside so the
//     implication is vacuous; if it is `"<<"`, we enter constrained mode with
//     `currentConstrainedOut := []`, which is valid by the method precondition.
//   - Complete-prefix branch: `CloseConstrainedSpan` sets `insideConstrainedOut`
//     to false and `currentConstrainedOut` to [], so the implication is vacuous.
//   - Narrow constrained branch and the zero-budget fallback: `AdaptiveConstrainedStep`
//     ensures either EOS or a parser-valid next token; on non-EOS,
//     `AppendConstrainedToken` therefore yields a parser-valid updated constrained prefix.
//   - Wide constrained branch with positive remaining budget: `ConstrainedSymbol`
//     directly ensures the returned constrained prefix is parser-valid; assigning
//     it to `currentConstrainedOut` preserves the invariant.
//
// suffix:
//   - Unconstrained branch: while outside, the implication is vacuous; when we
//     enter on `"<<"`, `currentConstrainedOut` becomes [], and the length-0
//     suffix of `generated` equals [].
//   - Complete-prefix branch: `CloseConstrainedSpan` appends the closing
//     delimiter and resets `currentConstrainedOut` to [], so the suffix
//     implication is vacuous afterward.
//   - Narrow constrained branch and the zero-budget fallback:
//     `AppendConstrainedToken` appends the same token to both `generated` and
//     `currentConstrainedOut`, preserving suffix equality.
//   - Wide constrained branch with positive remaining budget: with
//     `stablePrefix := generated[..|generated| - |currentConstrainedOut|]`, after
//     `ConstrainedSymbol` we assign `generated := stablePrefix + symbolOut` and
//     `currentConstrainedOut := symbolOut`, so the final `|symbolOut|` tokens of
//     `generated` are exactly `symbolOut`.
//
// progress:
//   - Unconstrained branch appends exactly one token on non-EOS and increments
//     `steps` by 1; on EOS it breaks immediately after incrementing `steps` by 1.
//   - Complete-prefix branch appends at most one closing delimiter and
//     increments `steps` by 1.
//   - Narrow constrained branch and the zero-budget fallback use one constrained
//     token step, increment `steps` by 1, and append exactly one token on non-EOS.
//   - Wide constrained branch computes `remaining := maxSteps - steps` and
//     `symbolBudget := if stepTokenBudget < remaining then stepTokenBudget else remaining`;
//     the branch is taken only when `symbolBudget > 0`, so `ConstrainedSymbol`
//     returns `stepsUsed <= symbolBudget <= remaining`, making
//     `steps := steps + stepsUsed` preserve `steps <= maxSteps`. Rebuilding
//     `generated` as `stablePrefix + symbolOut` adds at most `stepsUsed` tokens,
//     so `|generated| <= |generatedPrefix| + steps` is preserved.
//
// cost accounting:
//   - `cost` is kept at 0 throughout the loop and assigned only once at the end
//     as `cost := steps`, so the loop invariant `cost == 0` is preserved.
//   - Every non-breaking branch increases `steps` by exactly the amount of work
//     done: 1 for `UnconstrainedStep`, `CloseConstrainedSpan`, and the adaptive
//     one-token constrained branches, or `stepsUsed` for `ConstrainedSymbol`.
//     Because the wide branch now caps `stepsUsed` by the remaining budget, the
//     returned `cost` equals `steps` and is bounded by `maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var remaining := maxSteps - steps;
      var symbolBudget := if stepTokenBudget < remaining then stepTokenBudget else remaining;
      if validCount <= narrowThreshold || symbolBudget == 0 {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var symbolOut, hitEos, stepsUsed := helpers.ConstrainedSymbol(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, symbolBudget, eosToken
        );
        generated := stablePrefix + symbolOut;
        insideConstrainedOut := true;
        currentConstrainedOut := symbolOut;
        steps := steps + stepsUsed;
        if hitEos {
          break;
        }
      }
    }
  }
}

cost := steps;

