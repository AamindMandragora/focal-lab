Strategy: // CSD_RATIONALE_BEGIN
// Step-by-step math-solution CSD with delimiter-triggered constrained spans and
// lightweight arithmetic-aware steering. The strategy tracks the usual span
// state (`insideConstrainedOut`, `currentConstrainedOut`) plus a small local
// signal derived from the current constrained prefix: whether the span already
// contains arithmetic-looking tokens such as "+", "-", "*", "/", or "=".
//
// Outside spans, generation is unconstrained until the model emits "<<", which
// opens a constrained arithmetic segment. Inside spans, if the parser reports
// the span is complete we immediately close it with ">>". Otherwise we choose
// between two constrained decoders: when caller-supplied token groups are
// available we use `AdaptiveConstrainedStep` to softly boost preferred groups;
// when no groups are available we use `ConstrainedStep` for plain hard
// constrained decoding. The arithmetic-looking signal is used only to choose a
// narrower adaptive threshold, encouraging more decisive constrained decoding
// once an explicit computation is underway.
//
// This tracked state supports valid generation because delimiter handling keeps
// `currentConstrainedOut` equal to exactly the active contents between `<<` and
// `>>`, parser-guided constrained helpers ensure every in-span token preserves
// grammar validity, and immediate closure on complete prefixes prevents the
// strategy from emitting stray tokens after a finished computation.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Unconstrained branch: if EOS we break; otherwise we append one token to
//   `generated`. We only enter constrained mode when that token is "<<", and
//   then set `currentConstrainedOut := []`, which is valid by precondition
//   `parser.IsValidPrefix([])`.
//   Complete-prefix branch: `CloseConstrainedSpan` sets `insideConstrainedOut`
//   to false and `currentConstrainedOut` to [], so the implication is vacuous.
//   Constrained decoding branches: both `AdaptiveConstrainedStep` and
//   `ConstrainedStep` either hit EOS and leave state unchanged before break, or
//   return parser-valid updated constrained prefixes directly, which we assign.
//
// suffix:
//   Unconstrained branch: when remaining outside, the antecedent is false. When
//   opening a span on "<<", we set `currentConstrainedOut := []`, and the
//   length-0 suffix of `generated` is [].
//   Complete-prefix branch: `CloseConstrainedSpan` appends at most the closing
//   delimiter and resets the constrained prefix to [], so the implication is
//   again vacuous after the assignment.
//   Constrained decoding branches: `ConstrainedStep` preserves the suffix
//   invariant by postcondition. For `AdaptiveConstrainedStep`, on non-EOS we
//   append exactly the returned valid token to both `generated` and
//   `currentConstrainedOut`, so the suffix equality is preserved by
//   construction.
//
// cost accounting:
//   We return `cost := steps`, so the loop invariant keeps `cost == 0` until
//   the end. Each non-breaking branch increments `steps` by exactly 1 after one
//   cost-bumping helper call (`UnconstrainedStep`, `CloseConstrainedSpan`,
//   `AdaptiveConstrainedStep`, or `ConstrainedStep`). Break branches also have
//   already consumed one helper call and incremented `steps` before breaking,
//   so final `cost = steps <= maxSteps`.
//   No branch relies on `helpers.cost` for the returned value, so returned cost
//   is verifier-friendly and matches the explicit step counter.
//
// progress bound:
//   Unconstrained branch appends exactly one token when it does not break and
//   then increments `steps` by 1, so `|generated| <= |generatedPrefix| + steps`
//   is preserved. If it breaks on EOS, `generated` is unchanged and the bound
//   still holds.
//   Complete-prefix branch appends at most one closing delimiter and increments
//   `steps` by 1, preserving the linear bound.
//   Constrained decoding branches either break on EOS with unchanged generated
//   state, or append exactly one token and increment `steps` by 1. Hence every
//   non-breaking branch strictly decreases `maxSteps - steps`, satisfying the
//   loop decreases clause.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var arithmeticMarkers: seq<Token> := ["+", "-", "*", "/", "="];

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var arithmeticContext := helpers.IntersectTokenSets(currentConstrainedOut, arithmeticMarkers);
      if |validTokenGroups| > 0 {
        var narrowThreshold: nat := 12;
        if |arithmeticContext| > 0 {
          narrowThreshold := 4;
        }
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var steppedGenerated, steppedInside, steppedCurrent, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := steppedGenerated;
          insideConstrainedOut := steppedInside;
          currentConstrainedOut := steppedCurrent;
        }
      }
    }
  }
}

cost := steps;

