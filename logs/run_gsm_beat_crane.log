Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy almost never entered constrained mode because it waited
// for the model to emit "<<" on its own during unconstrained decoding. The
// traces show long runs of `UnconstrainedStep` and very few constrained calls,
// which explains both the missing `<< >>` segments and the malformed arithmetic
// when a span did appear. To fix this, the revised strategy proactively opens a
// constrained span near the beginning of generation whenever possible, instead
// of passively hoping the model chooses the delimiter.
//
// Inside a constrained span, the goal is no longer generic grammar-following
// text. We specifically want short arithmetic computations. So the strategy
// uses caller-supplied `validTokenGroups` when available to bias decoding toward
// arithmetic-style tokens, and otherwise falls back to plain constrained
// sampling. As soon as the parser says the constrained prefix is complete, we
// immediately close the span. This makes the generated `<< ... >>` segment
// short, syntactically clean, and much more likely to contain exactly one
// arithmetic computation.
//
// Outside the span, after one computation has been produced and closed, the
// strategy emits only a very small amount of additional unconstrained text.
// This reduces runtime and avoids drifting into verbose or repetitive prose
// after the answer. The net effect is: guaranteed early delimiter use when the
// token exists, stronger constrained arithmetic generation, immediate closure of
// complete computations, and much less unconstrained wandering.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Forced-open branch: `OpenConstrainedSpan` sets `insideConstrainedOut := true`
//   and `currentConstrainedOut := []`; `parser.IsValidPrefix([])` holds by
//   precondition. Unconstrained branch that stays outside leaves the implication
//   vacuous.
//   Complete-prefix close branch: `CloseConstrainedSpan` returns outside mode
//   with empty current prefix, so the implication is vacuous afterward.
//   Constrained sampling branches: `AdaptiveConstrainedStep` /
//   `GroupBoostedConstrainedStep` / `ConstrainedStep` guarantee either EOS with
//   unchanged state or a next token that keeps the constrained prefix valid; on
//   non-EOS we append that token with `AppendConstrainedToken`, whose
//   precondition is exactly that the extended prefix is valid.
//
// suffix:
//   Forced-open branch opens a span by appending only the delimiter token and
//   setting `currentConstrainedOut := []`; the length-0 suffix of the new
//   `generated` is therefore `[]`. Ordinary outside generation keeps the
//   antecedent false.
//   Close branch makes `insideConstrainedOut` false, so the suffix implication
//   is vacuous after closing.
//   Constrained append branches preserve the suffix because
//   `AppendConstrainedToken` appends the same sampled token to both `generated`
//   and `currentConstrainedOut`. `ConstrainedStep` preserves the suffix by its
//   postcondition directly.
//
// cost accounting:
//   We use a local `steps` counter and return `cost := steps`. Every non-breaking
//   branch increments `steps` by exactly 1 after one cost-bumping helper call:
//   `OpenConstrainedSpan`, `UnconstrainedStep`, `CloseConstrainedSpan`,
//   `AdaptiveConstrainedStep`, `GroupBoostedConstrainedStep`, or
//   `ConstrainedStep`.
//   Breaking branches either occur immediately after such a helper and also do
//   `steps := steps + 1`, or they break before any state change only when the
//   loop guard fails. Hence `cost <= maxSteps` and the returned cost matches the
//   explicit step counter rather than hidden helper bookkeeping.
//
// progress:
//   Forced-open and ordinary unconstrained branches append exactly one token and
//   then increment `steps` by 1, so `|generated| <= |generatedPrefix| + steps`
//   is preserved.
//   Close branch appends at most one delimiter token and increments `steps` by
//   1, so the bound remains linear.
//   Constrained append branches either break on EOS with unchanged `generated`
//   after incrementing `steps` by 1, or append exactly one token and increment
//   `steps` by 1. Therefore every non-breaking branch strictly increases
//   `steps`, satisfying `decreases maxSteps - steps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var openedAnySpan: bool := insideConstrained;
var postCloseBudget: nat := 0;
var canForceOpen: bool := "<<" in lm.Tokens;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !openedAnySpan && canForceOpen {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedAnySpan := true;
      steps := steps + 1;
    } else {
      if openedAnySpan && postCloseBudget == 0 {
        break;
      } else {
        var next := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          generated := generated + [next];
          if next == "<<" {
            insideConstrainedOut := true;
            currentConstrainedOut := [];
            openedAnySpan := true;
          } else {
            if openedAnySpan && postCloseBudget > 0 {
              postCloseBudget := postCloseBudget - 1;
            }
          }
        }
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      postCloseBudget := 1;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      if |validTokenGroups| > 1 {
        var next1 := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 8.0, 8, eosToken
        );
        steps := steps + 1;
        if next1 == eosToken {
          break;
        } else {
          var appendedGenerated1, appendedInside1, appendedCurrent1 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next1
          );
          generated := appendedGenerated1;
          insideConstrainedOut := appendedInside1;
          currentConstrainedOut := appendedCurrent1;
        }
      } else if |validTokenGroups| == 1 {
        var next2 := helpers.GroupBoostedConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 8.0, eosToken
        );
        steps := steps + 1;
        if next2 == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next2
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      } else {
        var steppedGenerated, steppedInside, steppedCurrent, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := steppedGenerated;
          insideConstrainedOut := steppedInside;
          currentConstrainedOut := steppedCurrent;
        }
      }
    }
  }
}

cost := steps;

