Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy waited until the very end to force a constrained span,
// so most of the answer was produced unconstrained and often contained either
// malformed arithmetic delimiters or semantically wrong prose. The traces show
// almost no successful closes, confirming that the constrained region was too
// short and too late to shape the output.
//
// This revision switches to an "early constrained core" design:
//   1. If we are not already inside a constrained span, we take at most one
//      unconstrained token to preserve any useful leading text the model may
//      want, then immediately open a constrained span as soon as possible.
//   2. While inside the constrained span, we use parser-guided constrained
//      decoding on every step, with group boosting to favor arithmetic-style
//      tokens supplied by the caller.
//   3. As soon as the parser reports a complete constrained prefix, we close
//      the span immediately. This directly addresses the prior malformed
//      constrained-content failures.
//   4. After closing, we stop instead of resuming free-form generation. For
//      the target task, the important requirement is that arithmetic
//      computations appear inside << >>; stopping after one well-formed span
//      avoids drifting into extra incorrect explanation text.
//
// The strategy is intentionally simple and aggressively grammar-centered:
// produce at most a tiny unconstrained prelude, then one parser-valid
// arithmetic span, then terminate. This should improve syntax rate and reduce
// semantic drift compared with the previous long-unconstrained-chunk approach.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Unconstrained-step and open/close branches either leave us outside
//     constrained mode or set `currentConstrainedOut := []`; therefore
//     `insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)`
//     is immediate from `parser.IsValidPrefix([])`.
//   - In the constrained-sampling branch, `GroupBoostedConstrainedStep`
//     guarantees the sampled token is either EOS or parser-valid after the
//     current prefix; on non-EOS, `AppendConstrainedToken` updates
//     `currentConstrainedOut` to that valid extension.
//   - The break-on-EOS branch leaves state unchanged, so validity is preserved.
//
// suffix:
//   - Outside constrained mode the implication is vacuous.
//   - Opening a span sets `currentConstrainedOut == []`, so the tracked
//     constrained content is the empty suffix of `generated`.
//   - In the constrained append branch, `AppendConstrainedToken` appends the
//     same token to both `generated` and `currentConstrainedOut`, preserving
//     the suffix relationship exactly.
//   - Closing sets `insideConstrainedOut := false`, so the implication becomes
//     vacuous again.
//
// progress:
//   - The single unconstrained-token branch appends exactly one token via
//     `UnconstrainedStep` and increments `steps` by 1.
//   - The open branch appends exactly one token (`"<<"`) and increments
//     `steps` by 1.
//   - The constrained branch either breaks on EOS immediately, or appends
//     exactly one token and increments `steps` by 1.
//   - The close branch appends at most one token and increments `steps` by 1,
//     then breaks; thus every non-breaking branch strictly increases `steps`.
//
// cost accounting:
//   - We keep the returned `cost` independent from helper bookkeeping during
//     the loop and maintain `cost == 0` as an invariant.
//   - Every non-breaking branch increments `steps` by exactly the amount of
//     generation work it performs, and `steps <= maxSteps` is preserved.
//   - After the loop we set `cost := steps`, yielding `cost <= maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var usedPrelude := false;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      if steps + 1 <= maxSteps {
        var gClose, iClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := gClose;
        insideConstrainedOut := iClose;
        currentConstrainedOut := cClose;
        steps := steps + 1;
        break;
      } else {
        break;
      }
    } else {
      if steps + 1 <= maxSteps {
        var next := helpers.GroupBoostedConstrainedStep(
          lm, parser, prompt + generated, currentConstrainedOut, validTokenGroups, 4.0, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var gApp, iApp, cApp := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := gApp;
          insideConstrainedOut := iApp;
          currentConstrainedOut := cApp;
        }
      } else {
        break;
      }
    }
  } else {
    if "<<" in lm.Tokens && !usedPrelude && steps + 2 <= maxSteps {
      var nextUn := helpers.UnconstrainedStep(lm, prompt, generated);
      generated := generated + [nextUn];
      steps := steps + 1;
      usedPrelude := true;
      if nextUn == eosToken {
        break;
      }
    } else {
      if "<<" in lm.Tokens && steps + 1 <= maxSteps {
        var gOpen, iOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
        generated := gOpen;
        insideConstrainedOut := iOpen;
        currentConstrainedOut := cOpen;
        steps := steps + 1;
      } else {
        if steps + 1 <= maxSteps {
          var nextFree := helpers.UnconstrainedStep(lm, prompt, generated);
          generated := generated + [nextFree];
          steps := steps + 1;
          if nextFree == eosToken {
            break;
          }
        } else {
          break;
        }
      }
    }
  }
}

cost := steps;

