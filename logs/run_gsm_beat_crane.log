//     preserves parser validity of the extended constrained prefix.
//   - The close branch is taken only after `parser.IsCompletePrefix(...)` is
//     established, and after closing we are outside constrained mode, so the
//     implication is vacuous.
//
// suffix:
//   - Outside constrained mode, the suffix implication is vacuous.
//   - After opening, the constrained content is empty, so the suffix of length
//     0 of `generated` equals `currentConstrainedOut`.
//   - In the constrained append branch, the same sampled token is appended to
//     both `generated` and `currentConstrainedOut` via
//     `AppendConstrainedToken`, so the tracked constrained content remains the
//     exact suffix of `generated`.
//   - After closing, `insideConstrainedOut` becomes false, so the implication
//     is vacuous.
//
// progress:
//   - The unconstrained chunk branch appends `stepsUsed` tokens and we update
//     `steps := steps + stepsUsed`; if EOS is observed and we do not open a
//     span, we break immediately.
//   - The open branch appends exactly one token (`"<<"`) and increments
//     `steps` by 1.
//   - The constrained append branch increments `steps` by 1; on EOS it breaks
//     immediately, otherwise exactly one token is appended.
//   - The close branch increments `steps` by 1 and appends at most one token.
//   - There are no query-only looping branches, so every non-breaking branch
//     strictly increases `steps`, satisfying the decreases metric.
//
// cost accounting:
//   - We maintain the loop invariant `cost == 0`; helper-internal bookkeeping
//     is ignored for the returned value.
//   - Every non-breaking branch updates `steps` by the exact amount of work
//     performed, and the invariant `steps <= maxSteps` is preserved.
//   - After the loop we assign `cost := steps`, yielding `cost <= maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var reserveSpan: nat := 8;
var chunkSize: nat := 24;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      if steps + 1 <= maxSteps {
        var gClose, iClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := gClose;
        insideConstrainedOut := iClose;
        currentConstrainedOut := cClose;
        steps := steps + 1;
      } else {
        break;
      }
    } else {
      if steps + 1 <= maxSteps {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + generated, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var gApp, iApp, cApp := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := gApp;
          insideConstrainedOut := iApp;
          currentConstrainedOut := cApp;
        }
      } else {
        break;
      }
    }
  } else {
    var remaining := maxSteps - steps;
    var shouldOpen := false;
    if "<<" in lm.Tokens && remaining >= 2 && remaining <= reserveSpan {
      shouldOpen := true;
    }

    if shouldOpen {
      var gOpen, iOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
      generated := gOpen;
      insideConstrainedOut := iOpen;
      currentConstrainedOut := cOpen;
      steps := steps + 1;
    } else {
      var maxChunk := chunkSize;
      if remaining > reserveSpan {
        if remaining - reserveSpan < maxChunk {
          maxChunk := remaining - reserveSpan;
        }
      } else {
        if remaining < maxChunk {
          maxChunk := remaining;
        }
      }

      if maxChunk == 0 {
        break;
      } else {
        var gChunk, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
          lm, prompt, generated, maxChunk, eosToken, eosToken
        );
        generated := gChunk;
        steps := steps + stepsUsed;
        if stoppedOnEos {
          if "<<" in lm.Tokens && steps < maxSteps && maxSteps - steps >= 2 {
            var gOpen2, iOpen2, cOpen2 := helpers.OpenConstrainedSpan(lm, generated);
            generated := gOpen2;
            insideConstrainedOut := iOpen2;
            currentConstrainedOut := cOpen2;
            steps := steps + 1;
          } else {
            break;
          }
        }
      }
    }
  }
}

cost := steps;

