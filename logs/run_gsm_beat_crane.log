Strategy: // CSD_RATIONALE_BEGIN
// The last strategy failed semantically because it forced entry into constrained
// mode near the beginning of generation, so the model produced `<< ... >>` as
// prompt continuation text instead of as arithmetic annotations embedded inside
// a normal solution. The traces show this clearly: nearly every example opened
// a constrained span immediately, then kept generating malformed symbolic text.
//
// This revision switches to a conservative hybrid policy:
//
// 1. Stay unconstrained by default, using chunked unconstrained generation for
//    most of the answer so the model can write natural step-by-step prose.
// 2. Only open a constrained span after we have already generated some normal
//    text and only when the recent context strongly suggests an arithmetic
//    computation site. We detect this cheaply by looking at the token
//    immediately before the last `=` in the generated text; if such a token
//    exists, we treat that as evidence that the model is at a computation
//    boundary.
// 3. Once inside a constrained span, use adaptive constrained sampling so the
//    parser governs the arithmetic expression, then close the span as soon as
//    the parser reports completeness. EOS is always terminal.
// 4. If the constrained prefix becomes narrow/dead-end, repair by rolling back
//    to a boundary token and trimming `generated` to keep the suffix relation.
//    This recovery branch explicitly consumes one step even though it may append
//    nothing, satisfying the decreases discipline.
// 5. To improve syntax-rate robustness, if we are inside a complete constrained
//    span and have budget, we close it immediately rather than sampling more.
//
// Compared with the failed version, the key behavioral change is that opening
// `<<` is no longer aggressively boosted at the start. Instead, opening is
// delayed until after some unconstrained text has been produced and a local
// cue (`=`-adjacent context) suggests that a computation should be written.
// This directly targets the observed `entered_constrained_mode_too_early`
// failure while still ensuring the output can contain `<< >>` around arithmetic
// computations.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Unconstrained chunk and unconstrained single-token branches either stay
//     outside constrained mode, making the implication vacuous, or open a span
//     with `currentConstrainedOut := []`; `parser.IsValidPrefix([])` is given.
//   - The close branch is entered only when `parser.IsCompletePrefix(currentConstrainedOut)`
//     holds; `CloseConstrainedSpan` exits constrained mode with empty current
//     span, so the implication is vacuous afterward.
//   - The constrained append branch uses `AdaptiveConstrainedStep`, which
//     ensures EOS or a parser-valid next token; on the non-EOS path,
//     `AppendConstrainedToken` preserves parser validity.
//   - The recovery branch sets `currentConstrainedOut := repaired` where
//     `RollbackToBoundary` ensures `parser.IsValidPrefix(repaired)`.
//
// suffix:
//   - Outside constrained mode the implication is vacuous. Opening a span adds
//     only `"<<"` to `generated` and sets the constrained content to `[]`, so
//     the suffix of length 0 matches immediately.
//   - The close branch exits constrained mode, so the suffix implication is
//     vacuous after the branch.
//   - The constrained append branch preserves the suffix relation because
//     `AppendConstrainedToken` appends the same token to both `generated` and
//     `currentConstrainedOut`.
//   - The recovery branch trims exactly `|oldCurrent| - |repaired|` tokens from
//     the end of `generated`; since `repaired` is a prefix of the old
//     constrained suffix, the new generated suffix is exactly `repaired`.
//
// progress:
//   - `UnconstrainedChunk` appends `stepsUsed` tokens and we do `steps := steps + stepsUsed`;
//     if it stops on EOS or open-span we break or transition immediately.
//   - The unconstrained single-token branch appends exactly one token and does
//     `steps := steps + 1`; if the token is EOS we break immediately.
//   - The close branch appends at most one token and increments `steps` by 1.
//   - The constrained append branch increments `steps` by 1; on EOS it breaks
//     with no state change, otherwise it appends exactly one token.
//   - The recovery branch may append no tokens and may shrink `generated`, but
//     it explicitly increments `steps` by 1, so the decreases metric still
//     drops and the bound `|generated| <= |generatedPrefix| + steps` is
//     preserved trivially.
//
// cost accounting:
//   - `cost` is initialized to 0 and kept unchanged in the loop, so the loop
//     invariant `cost == 0` is preserved.
//   - The returned `cost` is assigned from `steps` after the loop. Every
//     non-breaking branch either increases `steps` by 1 or by `stepsUsed` from
//     `UnconstrainedChunk`, so `cost <= maxSteps` follows from `steps <= maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var chunkSize: nat := 8;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var canTryOpen := false;
    if "<<" in lm.Tokens && |generated| > |generatedPrefix| {
      var prevTok, foundEq := helpers.LastTokenBefore(generated, "=");
      if foundEq {
        canTryOpen := true;
      }
    }

    if canTryOpen && steps + 1 <= maxSteps {
      var gOpen, iOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
      generated := gOpen;
      insideConstrainedOut := iOpen;
      currentConstrainedOut := cOpen;
      steps := steps + 1;
    } else {
      var remaining := maxSteps - steps;
      var maxChunk := chunkSize;
      if remaining < maxChunk {
        maxChunk := remaining;
      }
      var gChunk, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
        lm, prompt, generated, maxChunk, "<<", eosToken
      );
      generated := gChunk;
      steps := steps + stepsUsed;
      if stoppedOnEos {
        break;
      } else {
        if stoppedOnOpenSpan {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var gClose, iClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := gClose;
      insideConstrainedOut := iClose;
      currentConstrainedOut := cClose;
      steps := steps + 1;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if narrow {
        var repaired := helpers.RollbackToBoundary(parser, currentConstrainedOut, "=");
        generated := generated[..|generated| - (|currentConstrainedOut| - |repaired|)];
        currentConstrainedOut := repaired;
        steps := steps + 1;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var gApp, iApp, cApp := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := gApp;
          insideConstrainedOut := iApp;
          currentConstrainedOut := cApp;
        }
      }
    }
  }
}

cost := steps;

