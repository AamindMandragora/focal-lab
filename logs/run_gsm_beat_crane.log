Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy almost never entered constrained mode because it waited
// for the base LM to emit the opening delimiter token `"<<"` on its own. The
// trace confirms that: nearly all steps were plain `UnconstrainedStep`, and
// `CloseConstrainedSpan` was essentially never called. That directly explains
// the evaluation failures: missing `<< >>` spans, low arithmetic-syntax
// coverage, and weak answer accuracy.
//
// This revision makes constrained arithmetic spans proactive rather than
// incidental. Outside constrained mode, if the generated text does not yet
// contain `"<<"`, the strategy strongly prefers opening a constrained span
// immediately by sampling from logits after boosting `"<<"`. If `"<<"` is
// sampled, it enters constrained mode with empty constrained content; otherwise
// it still appends the sampled token and keeps going. This materially raises the
// probability that every solution contains at least one arithmetic span.
//
// Inside constrained mode, the strategy avoids long free-form constrained chunks
// that previously produced malformed arithmetic content. Instead it uses only
// single-token constrained sampling helpers (`AdaptiveConstrainedStep` or
// `PenalizedConstrainedStep`) and appends tokens one at a time, so every token
// added inside `<< >>` is parser-valid by construction. When the constrained
// prefix is complete, it immediately closes the span with `CloseConstrainedSpan`;
// it never treats a sampled `">>"` token as sufficient evidence to close.
//
// To improve usefulness for math word problems, the constrained branch applies a
// mild penalty to obvious non-arithmetic prose tokens when such tokens exist in
// the LM vocabulary, while still hard-masking to parser-valid continuations.
// This keeps the arithmetic span compact and expression-like. The overall design
// therefore addresses the observed failures by: (1) actively creating a `<< >>`
// segment, (2) ensuring constrained contents are grammar-valid token by token,
// and (3) closing the span as soon as the parser says the arithmetic expression
// is complete.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Outside branch: if EOS is sampled we break unchanged; if a non-`"<<"`
//     token is appended we remain outside so the implication is vacuous; if
//     `"<<"` is appended we set `insideConstrainedOut := true` and
//     `currentConstrainedOut := []`, which is parser-valid from the precondition.
//   - Complete constrained branch: `CloseConstrainedSpan` returns
//     `insideConstrainedOut == false` and `currentConstrainedOut == []`, so the
//     implication is vacuous afterward.
//   - Penalized/adaptive constrained branches: each helper ensures either EOS or
//     a parser-valid next token; on non-EOS, `AppendConstrainedToken` extends the
//     constrained prefix with that valid token, preserving parser validity.
//
// suffix:
//   - Outside branch: while outside, the implication is vacuous; when `"<<"` is
//     appended and we enter constrained mode, `currentConstrainedOut` is `[]`, so
//     the suffix of length 0 of `generated` equals `[]`.
//   - Complete constrained branch: after `CloseConstrainedSpan`, we are outside,
//     so the suffix implication is vacuous.
//   - Penalized/adaptive constrained branches: `AppendConstrainedToken` appends
//     the same token to both `generated` and `currentConstrainedOut`, so the last
//     `|currentConstrainedOut|` tokens of `generated` remain exactly the current
//     constrained prefix.
//
// progress:
//   - Outside branch uses one manual sample step, increments `steps` by 1, and
//     appends exactly one token on non-EOS.
//   - Complete constrained branch uses `CloseConstrainedSpan`, increments
//     `steps` by 1, and appends at most one token.
//   - Penalized/adaptive constrained branches each perform one constrained token
//     step, increment `steps` by 1, and append exactly one token on non-EOS.
//   - EOS branches break immediately after the step increment, satisfying the
//     decreases discipline.
//
// cost accounting:
//   - `cost` stays 0 throughout the loop and is assigned only once at the end as
//     `cost := steps`, so the loop invariant `cost == 0` is preserved.
//   - In the outside manual-sampling branch we explicitly do
//     `helpers.cost := helpers.cost + 1` and `steps := steps + 1`; in the
//     constrained branches we call helpers that internally bump helper cost by 1
//     and we also increment `steps` by 1. Thus returned `cost` matches `steps`
//     and remains bounded by `maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;
var flatGroups := helpers.FlattenTokenGroups(validTokenGroups);
var tokensToPenalize: seq<Token> := [];
if "Let" in lm.Tokens {
  tokensToPenalize := tokensToPenalize + ["Let"];
}
if "let" in lm.Tokens {
  tokensToPenalize := tokensToPenalize + ["let"];
}
if "P" in lm.Tokens {
  tokensToPenalize := tokensToPenalize + ["P"];
}
if "Therefore" in lm.Tokens {
  tokensToPenalize := tokensToPenalize + ["Therefore"];
}
if "So" in lm.Tokens {
  tokensToPenalize := tokensToPenalize + ["So"];
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    if !Contains(generated, "<<") && "<<" in lm.Tokens {
      helpers.BoostTokenLogits(lm, ["<<"], 100.0);
      if |flatGroups| > 0 {
        helpers.BoostTokenLogits(lm, flatGroups, 3.0);
      }
    } else if |flatGroups| > 0 {
      helpers.PenalizeTokenLogits(lm, flatGroups, 1.0);
    }
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if |tokensToPenalize| > 0 && validCount > narrowThreshold {
        var next := helpers.PenalizedConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, tokensToPenalize, 5.0, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

