Strategy: // CSD_RATIONALE_BEGIN
// The last strategy failed catastrophically because it forced constrained mode
// at the beginning of generation. The traces show a consistent bad pattern:
// the model emitted only a tiny unfinished arithmetic prefix like `<<x =` and
// then spent the whole budget inside the constrained parser. That destroys both
// answer accuracy and the required `<< >>` syntax metric.
//
// This revision switches to a late-insertion strategy:
//
// 1. Default behavior is plain unconstrained generation in small chunks. This
//    lets the LM produce the natural-language solution and final answer first,
//    which is where the accuracy signal lives for these short math tasks.
// 2. We never open a constrained span early just to satisfy the metric.
//    Instead, while outside constrained mode, we watch for an already-generated
//    `<<` token from unconstrained text and only then begin tracking the span.
// 3. We reserve a tiny tail budget for a fallback. Only when we are very near
//    the end, still outside constrained mode, and `<<` is available do we open
//    one explicit constrained span. Once inside, we use only `ConstrainedStep`
//    and close immediately when the parser reports completeness. This directly
//    addresses the previous `entered_constrained_mode_too_early` failure.
// 4. We remove the expensive dead-end probing loop from the hot path. The prior
//    attempt called `DeadEndDetection` on nearly every step and still got stuck;
//    here we rely on the verified constrained sampler plus immediate closing,
//    which is both cheaper and less likely to wander.
// 5. To keep the fallback short and well-formed, we only trigger it when there
//    are at most a few steps left. The intent is to append one compact
//    arithmetic snippet `<< ... >>` after the main answer rather than replacing
//    the whole answer with a constrained fragment.
//
// In short: generate the answer normally first, then add a short constrained
// arithmetic segment only at the tail if needed. This is the opposite of the
// failed strategy and is targeted specifically at the observed traces.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - In unconstrained-chunk branches we remain outside constrained mode unless
//     the chunk stops on an already-generated `<<`; then we set
//     `currentConstrainedOut := []`, which is parser-valid by precondition.
//   - The explicit late-open branch uses `OpenConstrainedSpan`, whose result has
//     empty constrained content, so parser validity holds immediately.
//   - The constrained-step branch uses `ConstrainedStep`; on non-EOS it returns
//     a parser-valid constrained prefix by specification.
//   - The close branch uses `CloseConstrainedSpan` only when
//     `parser.IsCompletePrefix(currentConstrainedOut)` is known, and afterward
//     we are outside constrained mode so the implication is vacuous.
//
// suffix:
//   - Outside constrained mode the implication is vacuous.
//   - If an unconstrained chunk stops on `<<`, that delimiter is already in
//     `generated`; we begin tracking only the interior, so the suffix of length
//     0 equals `[]`.
//   - `OpenConstrainedSpan` appends only `"<<"` and sets the tracked interior to
//     `[]`, so the suffix relation holds immediately.
//   - `ConstrainedStep` preserves the suffix invariant on every non-EOS step by
//     its postcondition.
//   - `CloseConstrainedSpan` exits constrained mode, making the implication
//     vacuous again.
//
// progress:
//   - `UnconstrainedChunk` appends `stepsUsed` tokens and we do
//     `steps := steps + stepsUsed`; if it stops on EOS we break immediately.
//   - The explicit late-open branch appends exactly one token and increments
//     `steps` by 1.
//   - The constrained-step branch increments `steps` by 1; on EOS it breaks,
//     otherwise exactly one constrained token is appended.
//   - The close branch increments `steps` by 1 and appends at most one token.
//   - There are no query-only looping branches, so every non-breaking branch
//     strictly increases `steps`, satisfying the decreases discipline.
//
// cost accounting:
//   - `cost` is initialized before the loop and kept equal to 0 in the loop,
//     so the invariant `cost == 0` is preserved.
//   - We return `cost := steps` after the loop. Since every non-breaking branch
//     increases `steps` and the loop invariant maintains `steps <= maxSteps`,
//     the returned cost is at most `maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var chunkSize: nat := 8;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      if steps + 1 <= maxSteps {
        var gClose, iClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := gClose;
        insideConstrainedOut := iClose;
        currentConstrainedOut := cClose;
        steps := steps + 1;
      } else {
        break;
      }
    } else {
      if steps + 1 <= maxSteps {
        var gStep, iStep, cStep, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := gStep;
          insideConstrainedOut := iStep;
          currentConstrainedOut := cStep;
        }
      } else {
        break;
      }
    }
  } else {
    var remaining := maxSteps - steps;
    var shouldLateOpen := false;
    if "<<" in lm.Tokens && remaining <= 3 && remaining >= 2 {
      shouldLateOpen := true;
    }

    if shouldLateOpen {
      var gOpen, iOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
      generated := gOpen;
      insideConstrainedOut := iOpen;
      currentConstrainedOut := cOpen;
      steps := steps + 1;
    } else {
      var maxChunk := chunkSize;
      if remaining < maxChunk {
        maxChunk := remaining;
      }
      var gChunk, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
        lm, prompt, generated, maxChunk, "<<", eosToken
      );
      generated := gChunk;
      steps := steps + stepsUsed;
      if stoppedOnEos {
        break;
      } else {
        if stoppedOnOpenSpan {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  }
}

cost := steps;

