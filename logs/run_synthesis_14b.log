Strategy: // CSD_RATIONALE_BEGIN
// This CSD strategy processes inputs from the GSM-Symbolic dataset to solve math word problems step by step.
// The strategy uses a constrained window approach where arithmetic computations are written inside << >> delimiters.
// The unconstrained phase generates reasoning text until "<<" triggers the constrained window.
// Inside the constrained window, the ValidTokenCount drives the temperature: wide grammar → T=1.2, narrow grammar → T=0.5.
// The EOS token is always allowed in constrained steps for early termination.
// CSD_RATIONALE_END

generated := [];
var steps: nat := 0;
var insideConstrained: bool := false;
var currentConstrained: Prefix := [];

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant |generated| == steps
  invariant helpers.cost == steps
  invariant lm.ValidTokensIdsLogits()
  invariant insideConstrained ==> parser.IsValidPrefix(currentConstrained)
  decreases maxSteps - steps, if insideConstrained then 1 else 0
{
  if !insideConstrained {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    if next == eosToken { break; }
    generated := generated + [next];
    steps := steps + 1;
    if Contains(next, "<<") {
      insideConstrained := true;
      currentConstrained := [];
    }
  } else {
    if parser.IsCompletePrefix(currentConstrained) {
      insideConstrained := false;
    } else {
      var count := helpers.ValidTokenCount(parser, currentConstrained);
      var next: Token;
      if count > 10 {
        next := helpers.TemperatureConstrainedStep(lm, parser, prompt, currentConstrained, 1.2, eosToken);
      } else {
        next := helpers.TemperatureConstrainedStep(lm, parser, prompt, currentConstrained, 0.5, eosToken);
      }
      if next == eosToken { break; }
      generated := generated + [next];
      currentConstrained := currentConstrained + [next];
      steps := steps + 1;
      if Contains(next, ">>") { insideConstrained := false; }
    }
  }
}
cost := helpers.cost;

