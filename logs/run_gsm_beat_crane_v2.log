Strategy: // CSD_RATIONALE_BEGIN
// The last strategy failed for two concrete reasons shown by the traces:
// (1) it forcibly inserted `<<` after only a few tokens, so spans began far too
// early and corrupted the natural answer prefix, and
// (2) once inside, it often kept sampling arithmetic tokens without ever
// reaching a complete parser state, so `>>` was almost never emitted.
//
// The best prior attempt was the conservative one that did NOT force open spans;
// it preserved answer quality much better, though it still missed the required
// delimiter format too often. This revision keeps that conservative backbone and
// adds only a late, single fallback insertion policy.
//
// Strategy:
// 1. If we start inside a constrained span, finish or safely repair that span.
// 2. Otherwise, stay unconstrained and let the LM write the normal solution.
//    This directly addresses the "entered_constrained_mode_too_early" failures.
// 3. Detect a model-produced open delimiter by checking whether the newly
//    generated token contains `"<<"`; only then enter constrained tracking.
// 4. Inside a span, use the simplest verified one-step helper
//    `ConstrainedStep`, which preserves the suffix invariant directly and tends
//    to be easier to close than longer adaptive policies.
// 5. Close immediately when `parser.IsCompletePrefix(currentConstrainedOut)`
//    becomes true. If the span grows too long, roll back to a boundary and
//    abandon the span if repair empties it, preventing unterminated segments.
// 6. Only as a late fallback, near the end of the budget and only if no span
//    has yet appeared, explicitly open one constrained span. This gives a final
//    chance to satisfy the required `<< >>` format without damaging the common
//    case where the LM can produce a correct answer naturally.
// 7. Outside spans, decode token-by-token rather than chunking so we can detect
//    delimiter-containing tokens precisely and stop immediately on EOS.
//
// The key change from the failed forced-open attempt is therefore: defer
// explicit opening until late, rely on natural unconstrained reasoning first,
// and use short, aggressively closed constrained spans only when they actually
// occur or when a last-resort fallback is needed.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
// - In the unconstrained branch we either remain outside, making the invariant
//   vacuous, or enter constrained mode only when a token containing `<<` was
//   emitted; then we set `currentConstrainedOut := []`, which is parser-valid by
//   precondition.
// - In the constrained-step branch, `ConstrainedStep` preserves parser validity
//   on non-EOS returns; on EOS we break immediately with unchanged valid state.
// - In the close branch, `CloseConstrainedSpan` sets `insideConstrainedOut` to
//   false, so the implication is vacuous.
// - In the rollback branch, `RollbackToBoundary` returns a parser-valid repaired
//   prefix; if it is empty we leave constrained mode, otherwise we keep that
//   valid repaired prefix.
//
// suffix:
// - While outside constrained mode the implication is vacuous.
// - On delimiter-detection entry or explicit late open, we enter constrained
//   mode with empty constrained content, so the suffix relation holds trivially.
// - `ConstrainedStep` preserves the suffix relation by specification.
// - `CloseConstrainedSpan` exits constrained mode, so the implication is again
//   vacuous.
// - In rollback repair, the repaired prefix is a prefix of the old constrained
//   content; trimming the same number of dropped constrained tokens from the end
//   of `generated` restores exact suffix equality.
//
// cost accounting:
// - We use a local `steps` counter and return `cost := steps`.
// - `UnconstrainedStep`, `ConstrainedStep`, `OpenConstrainedSpan`, and
//   `CloseConstrainedSpan` each correspond to one unit of progress, so their
//   branches increment `steps` by 1.
// - The rollback branch uses only non-bumping helpers and local sequence
//   updates, so it explicitly does `steps := steps + 1`.
// - Any EOS case breaks immediately after bounded work.
//
// progress:
// - `UnconstrainedStep` appends exactly one token and we increment `steps` by 1,
//   preserving `|generated| <= |generatedPrefix| + steps`.
// - The late explicit-open branch appends exactly one token and increments
//   `steps` by 1.
// - `ConstrainedStep` either breaks on EOS with unchanged state or appends one
//   constrained token and increments `steps` by 1.
// - `CloseConstrainedSpan` appends at most one token and increments `steps` by 1.
// - The rollback branch appends no tokens and may shrink `generated`; after the
//   explicit `steps := steps + 1`, the progress bound still holds and the
//   decreases metric strictly drops.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var sawAnySpan: bool := insideConstrained;
var lateOpenThreshold: nat := 0;
if maxSteps > 3 {
  lateOpenThreshold := maxSteps - 3;
} else {
  lateOpenThreshold := maxSteps;
}
var maxConstrainedLen: nat := 8;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else if |currentConstrainedOut| >= maxConstrainedLen {
      var repaired := helpers.RollbackToBoundary(parser, currentConstrainedOut, "=");
      generated := generated[..|generated| - (|currentConstrainedOut| - |repaired|)];
      currentConstrainedOut := repaired;
      if |currentConstrainedOut| == 0 {
        insideConstrainedOut := false;
      }
      steps := steps + 1;
    } else {
      var steppedGenerated, steppedInside, steppedCurrent, hitEos := helpers.ConstrainedStep(
        lm, parser, prompt, generated, currentConstrainedOut, eosToken
      );
      steps := steps + 1;
      if hitEos {
        break;
      } else {
        generated := steppedGenerated;
        insideConstrainedOut := steppedInside;
        currentConstrainedOut := steppedCurrent;
      }
    }
  } else {
    if !sawAnySpan && steps >= lateOpenThreshold && steps + 1 < maxSteps {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      sawAnySpan := true;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if Contains(next, "<<") {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          sawAnySpan := true;
        }
      }
    }
  }
}

cost := steps;

