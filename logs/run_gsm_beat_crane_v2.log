      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var generated2, inside2, current2, hitEos := helpers.ConstrainedStep(
        lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
      );
      steps := steps + 1;
      if hitEos {
        break;
      } else {
        generated := generated2;
        insideConstrainedOut := inside2;
        currentConstrainedOut := current2;
      }
    }
  }
}

