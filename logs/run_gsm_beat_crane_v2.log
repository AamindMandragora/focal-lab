Strategy: // CSD_RATIONALE_BEGIN
// The current strategy still spends almost the entire budget on unconstrained
// decoding, as confirmed by the trace showing ~64 unconstrained steps/example.
// That produces long natural-language solutions, but many outputs truncate
// before the final answer and many `<< ... >>` segments are malformed because
// the model starts an arithmetic span in free text and never cleanly finishes
// it. The failed examples also show a consistent pattern: the model often
// writes a plausible setup and even starts a computation, but the answer is cut
// off before the final number.
//
// Revised policy:
// 1. If we inherit an active constrained span, finish it conservatively:
//    close immediately when complete; otherwise allow only a tiny bounded
//    amount of parser-valid progress, then abandon safely.
// 2. If we start outside constrained mode, force one minimal closed span `<<>>`
//    immediately (or as soon as possible). This guarantees the required
//    delimiter format before any EOS and avoids malformed constrained content
//    because the span is empty and closed right away.
// 3. After that, allow only a *moderate* amount of unconstrained generation,
//    then stop rather than spending dozens of steps on rambling text. The task
//    family is short-answer math; concise outputs are better than long partial
//    explanations.
// 4. We never treat an unconstrained token containing `<<` as opening a tracked
//    constrained span. Earlier attempts that did so produced malformed payloads
//    and syntax failures.
// 5. EOS remains terminal.
//
// The key change is therefore a control-policy reset: guaranteed early `<<>>`
// for syntax, plus a hard cap on later unconstrained wandering for accuracy and
// runtime. This directly targets the observed failure modes of truncated
// solutions, malformed constrained content, and excessive unconstrained steps.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
// - In the outside-mode branches (`OpenConstrainedSpan`, unconstrained step,
//   and the early break), either we remain outside constrained mode or we open
//   with `currentConstrainedOut := []`; thus
//   `insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)` is
//   vacuous or follows from `parser.IsValidPrefix([])`.
// - In inherited constrained mode, `CloseConstrainedSpan` exits constrained
//   mode so the implication becomes vacuous; `ConstrainedStep` preserves parser
//   validity by specification; the abandonment branch explicitly sets
//   `insideConstrainedOut := false` and `currentConstrainedOut := []`.
//
// suffix:
// - Outside constrained mode the suffix implication is vacuous. After
//   `OpenConstrainedSpan`, the active constrained prefix is empty, so
//   `generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut`
//   holds trivially.
// - In constrained mode, `ConstrainedStep` preserves the suffix relation by
//   postcondition. Closing or abandoning the span sets
//   `insideConstrainedOut := false`, making the implication vacuous.
//
// cost accounting:
// - We use a local `steps` counter and return `cost := steps`.
// - Every non-breaking advancing branch increases `steps` by exactly 1:
//   `OpenConstrainedSpan`, `CloseConstrainedSpan`, `ConstrainedStep`, and
//   `UnconstrainedStep`.
// - The pure abandonment branch appends no tokens and uses no cost-bumping
//   helper, so it explicitly does `steps := steps + 1`.
// - Break branches occur only after prior progress or after a charged helper
//   step, so the final returned `cost` matches `steps`.
//
// progress:
// - `OpenConstrainedSpan` appends exactly one token and we increment `steps` by
//   1, preserving `|generated| <= |generatedPrefix| + steps`.
// - `CloseConstrainedSpan` appends at most one token and increments `steps` by
//   1; `ConstrainedStep` appends exactly one token on non-EOS and increments
//   `steps` by 1; `UnconstrainedStep` appends exactly one token on non-EOS and
//   increments `steps` by 1.
// - The abandonment branch appends no tokens but still increments `steps` by
//   1, so the bound holds trivially because `|generated|` does not increase.
// - The explicit break branches break immediately; they do not need to preserve
//   the decreases relation beyond the current iteration.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var inheritedCap: nat := 3;
var tailCap: nat := 24;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else if |currentConstrainedOut| >= inheritedCap {
      insideConstrainedOut := false;
      currentConstrainedOut := [];
      steps := steps + 1;
    } else {
      var steppedGenerated, steppedInside, steppedCurrent, hitEos := helpers.ConstrainedStep(
        lm, parser, prompt, generated, currentConstrainedOut, eosToken
      );
      steps := steps + 1;
      if hitEos {
        break;
      } else {
        generated := steppedGenerated;
        insideConstrainedOut := steppedInside;
        currentConstrainedOut := steppedCurrent;
      }
    }
  } else {
    if steps == 0 && maxSteps >= 2 {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else if steps >= tailCap {
      break;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
      }
    }
  }
}

cost := steps;

