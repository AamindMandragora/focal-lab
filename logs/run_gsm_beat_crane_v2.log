Strategy: // CSD_RATIONALE_BEGIN
// The evaluation makes the failure mode unambiguous: spending dozens of
// unconstrained tokens before any guaranteed `<< >>` span both misses the
// required format and burns most of the budget, while late-opening spans then
// remain unterminated. For these math tasks, a short arithmetic span early is
// much more useful than a long free-form preamble.
//
// This revision therefore replaces the previous "mostly unconstrained" policy
// with a deliberately front-loaded, bounded plan:
//
// 1. If we are already inside a constrained span, finish it immediately using
//    one-token constrained steps and close as soon as the parser says the span
//    is complete.
// 2. If we are outside and have not yet produced any span, explicitly open one
//    right away (or very early) instead of waiting for the model to emit `<<`.
//    This directly fixes the "Contains << >>: no" failures.
// 3. Inside the first span, use `AdaptiveConstrainedStep` so arithmetic-like
//    token groups can help when the parser-valid set is narrow, but the helper
//    still guarantees parser-valid next tokens. This aims to improve syntax
//    over raw unconstrained decoding.
// 4. Keep the span short: if it becomes complete, close immediately; if it
//    grows beyond a small cap without becoming complete, roll back to a valid
//    boundary, trim `generated` to match, and if nothing remains, abandon the
//    span rather than looping forever. This directly targets the high rate of
//    unterminated or malformed constrained segments.
// 5. After at least one span has been produced, allow only a small amount of
//    unconstrained continuation. This preserves some natural wording while
//    keeping runtime low and avoiding the previous 50+ unconstrained forward
//    passes per example.
// 6. EOS is always terminal.
//
// Relative to the previous attempt, the key change is not a local tweak but a
// control-policy reversal: guaranteed early span insertion, aggressively short
// constrained generation, and only limited free-form text afterward.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
// - Explicit open uses `OpenConstrainedSpan`, which sets `currentConstrainedOut`
//   to `[]`; by precondition `parser.IsValidPrefix([])` holds.
// - The adaptive constrained branch samples `next` with a helper whose post-
//   condition guarantees `next == eosToken || parser.IsValidPrefix(currentConstrainedOut + [next])`;
//   on non-EOS we append with `AppendConstrainedToken`, so validity is preserved.
// - The close branch exits constrained mode, making the implication vacuous.
// - The rollback branch replaces the constrained prefix by `RollbackToBoundary`'s
//   repaired prefix, which is parser-valid by specification; if we abandon the
//   span, we set `insideConstrainedOut := false`, again making the implication vacuous.
// - The unconstrained branch keeps us outside constrained mode, so the invariant
//   remains vacuous there.
//
// suffix:
// - On explicit open, constrained content is empty, so the suffix relation holds
//   trivially.
// - In the adaptive constrained branch, non-EOS tokens are appended to both the
//   full `generated` sequence and `currentConstrainedOut` via
//   `AppendConstrainedToken`, so the constrained content remains exactly the
//   suffix of `generated`.
// - The close branch exits constrained mode, so the implication is vacuous.
// - In rollback, `repaired` is a prefix of the old constrained content; trimming
//   exactly `|old|-|repaired|` tokens from the end of `generated` restores
//   `generated[|generated|-|repaired|..] == repaired`. If `repaired` is empty and
//   we abandon the span, the implication is vacuous.
// - Outside constrained mode, the invariant is vacuous.
//
// cost accounting:
// - We maintain a local `steps` counter and return `cost := steps`.
// - `OpenConstrainedSpan`, `AdaptiveConstrainedStep`, `CloseConstrainedSpan`,
//   and `UnconstrainedStep` each correspond to one unit of progress, so those
//   branches do `steps := steps + 1`.
// - The rollback branch uses only non-bumping helpers and local sequence
//   updates, so it explicitly increments `steps` by 1.
// - Any EOS branch breaks immediately after bounded work; returned cost is still
//   `steps`.
//
// progress:
// - Explicit open appends exactly one token and increments `steps` by 1, so
//   `|generated| <= |generatedPrefix| + steps` is preserved.
// - The adaptive constrained branch appends exactly one token on non-EOS and
//   increments `steps` by 1; on EOS it breaks immediately with unchanged state.
// - `CloseConstrainedSpan` appends at most one token and increments `steps` by 1.
// - `UnconstrainedStep` appends exactly one token and increments `steps` by 1.
// - The rollback branch appends no tokens and may shrink `generated`; after the
//   explicit `steps := steps + 1`, the progress bound still holds trivially and
//   the decreases metric strictly drops.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var sawSpan: bool := insideConstrained;
var maxConstrainedLen: nat := 6;
var unconstrainedTailBudget: nat := 4;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      sawSpan := true;
      steps := steps + 1;
    } else if |currentConstrainedOut| >= maxConstrainedLen {
      var repaired := helpers.RollbackToBoundary(parser, currentConstrainedOut, "=");
      generated := generated[..|generated| - (|currentConstrainedOut| - |repaired|)];
      currentConstrainedOut := repaired;
      if |currentConstrainedOut| == 0 {
        insideConstrainedOut := false;
      }
      steps := steps + 1;
    } else {
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, prompt + generated[..|generated| - |currentConstrainedOut|], currentConstrainedOut,
        validTokenGroups, 4.0, 12, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  } else {
    if !sawSpan {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      sawSpan := true;
      steps := steps + 1;
    } else if steps < maxSteps && steps < unconstrainedTailBudget + |generated| - |generatedPrefix| {
      var nextTail := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextTail == eosToken {
        break;
      } else {
        generated := generated + [nextTail];
      }
    } else {
      break;
    }
  }
}

