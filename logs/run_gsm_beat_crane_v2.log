Strategy: // CSD_RATIONALE_BEGIN
// The latest evaluation makes the bug concrete: the strategy opened `<<` after
// one unconstrained token, but then stayed inside constrained mode trying to
// generate payload tokens. On these very short math tasks, that immediately
// corrupts the answer (`Let<<x =`) and almost never reaches a complete prefix,
// so `>>` is never emitted. The trace confirms the failure pattern:
// UnconstrainedStep -> OpenConstrainedSpan -> ConstrainedStep -> ConstrainedStep.
// That is exactly the behavior we must eliminate.
//
// The best historical result came from a much simpler idea: keep almost all
// decoding unconstrained for answer quality, and use a guaranteed *empty*
// closed span only to satisfy the required `<< >>` syntax. The critical lesson
// from the failed run is that opening a span is safe only if we also reserve
// the very next step to close it immediately; never spend interior steps trying
// to synthesize arithmetic content unless we inherited an already-open span.
//
// Revised policy:
// 1. If we inherit an active constrained span, finish it conservatively:
//    close immediately when complete; otherwise allow at most one constrained
//    step, then stop rather than risking a long malformed fragment.
// 2. If we are outside constrained mode, decode unconstrained by default.
// 3. Deterministically reserve the final two available steps for a minimal
//    guaranteed fallback span `<<>>`: when exactly two steps remain, call
//    OpenConstrainedSpan; on the next iteration, the empty constrained prefix
//    is complete, so CloseConstrainedSpan fires immediately.
// 4. We never enter constrained tracking from an unconstrained token that
//    merely contains `<<`; prior attempts showed that this drags arbitrary free
//    text into constrained mode and harms both accuracy and syntax.
// 5. EOS is terminal.
//
// What changed in response to the evaluation: we removed the early fallback
// opening that caused immediate corruption, and restored the proven
// last-two-steps `Open` then immediate `Close` schedule so the fallback span is
// always well formed and never followed by parser-content generation.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch we stay outside constrained mode,
// so the implication is vacuous. In the fallback-open branch,
// OpenConstrainedSpan sets currentConstrainedOut to [], which is a valid parser
// prefix by precondition. In the inherited constrained branch, ConstrainedStep
// preserves parser validity on non-EOS, and CloseConstrainedSpan exits
// constrained mode so the implication becomes vacuous.
//
// suffix: Outside constrained mode the suffix invariant is vacuous. Opening the
// fallback span yields currentConstrainedOut == [], and the empty sequence is a
// suffix of any generated prefix. In inherited constrained mode,
// ConstrainedStep preserves the suffix relation by specification; closing the
// span resets insideConstrainedOut to false, making the implication vacuous.
//
// cost accounting: Every non-breaking branch calls exactly one cost-bumping
// helper and then increments steps by 1: UnconstrainedStep, OpenConstrainedSpan,
// CloseConstrainedSpan, or ConstrainedStep. Breaking branches occur only after
// EOS or an explicit stop, so returning cost := steps gives cost <= maxSteps.
//
// progress bound: UnconstrainedStep appends exactly one token on non-EOS and we
// increment steps by 1. OpenConstrainedSpan appends exactly one token `<<` and
// steps increases by 1; CloseConstrainedSpan appends at most one token and
// steps increases by 1. ConstrainedStep either breaks immediately on EOS with
// no state change, or appends exactly one token and we increment steps by 1.
// Thus every non-breaking branch strictly increases steps, satisfying the
// decreases clause, and |generated| <= |generatedPrefix| + steps is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var inheritedConstrainedSteps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant 0 <= inheritedConstrainedSteps <= steps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if inheritedConstrainedSteps >= 1 {
        break;
      } else {
        var steppedGenerated, steppedInside, steppedCurrent, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        inheritedConstrainedSteps := inheritedConstrainedSteps + 1;
        if hitEos {
          break;
        } else {
          generated := steppedGenerated;
          insideConstrainedOut := steppedInside;
          currentConstrainedOut := steppedCurrent;
        }
      }
    }
  } else {
    if maxSteps - steps == 2 {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
      }
    }
  }
}

cost := steps;

