Strategy: // CSD_RATIONALE_BEGIN
// Step-by-step math CSD with delimiter-triggered constrained spans. The
// strategy tracks the standard span state: whether generation is currently
// inside a `<< ... >>` arithmetic-computation segment, plus the current token
// prefix of that active constrained segment.
//
// Outside a constrained span, generation is mostly free-form so the model can
// explain the solution naturally. To encourage the requested format, the
// strategy watches for tokens containing "<<" and, when outside a span, uses
// chunked unconstrained decoding so it can stop immediately on an explicit
// open-span token. Inside a constrained span, the strategy switches to parser-
// valid decoding and uses caller-supplied token groups adaptively: when the
// parser says the next-token set is narrow, it boosts preferred groups to
// steer arithmetic formatting; otherwise it uses ordinary constrained decoding.
// Once the parser reports the arithmetic fragment is complete, the strategy
// closes the span with `>>` and returns to free-form explanation.
//
// This tracked state supports valid generation because the constrained state
// always mirrors exactly the suffix of `generated` between delimiters, and all
// inside-span token choices are parser-valid. That lets the model write normal
// reasoning text while ensuring each `<< ... >>` computation remains a valid
// arithmetic fragment.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span chunk branch, insideConstrainedOut stays
//   false unless stoppedOnOpenSpan is reported, in which case we set
//   currentConstrainedOut := [], which is parser-valid by precondition. In the
//   close branch, CloseConstrainedSpan sets insideConstrainedOut := false, so
//   the implication is vacuous. In the adaptive constrained branch,
//   GroupBoostedConstrainedStep and ConstrainedStep both return either EOS or a
//   parser-valid next token; on non-EOS we call AppendConstrainedToken, whose
//   precondition is exactly that validity fact, so the updated constrained
//   prefix remains parser-valid.
// suffix: Outside the span, the implication is vacuous because
//   insideConstrainedOut is false; if the chunk stops on an open span, we set
//   currentConstrainedOut := [], and the length-0 suffix of generated matches
//   []. In the close branch, CloseConstrainedSpan appends the closing delimiter
//   and resets currentConstrainedOut to [], so the implication is again
//   vacuous. In the constrained append branches, AppendConstrainedToken adds
//   the same token to generated and currentConstrainedOut, preserving the
//   suffix equality.
// cost accounting: We return cost := steps at the end. Every non-breaking
//   branch increments steps by exactly the amount of work performed: the chunk
//   branch adds stepsUsed from UnconstrainedChunk, the close branch adds 1 for
//   CloseConstrainedSpan, and each constrained sampling branch adds 1 for the
//   single constrained helper call. No branch decrements steps, so cost <=
//   maxSteps follows from the loop guard/invariant.
// progress: Chunk branch appends at most stepsUsed tokens and sets
//   steps := steps + stepsUsed, so |generated| <= |generatedPrefix| + steps is
//   preserved. Close and constrained-append branches append at most one token
//   and increment steps by 1. Breaking branches stop immediately after a
//   positive step increment (or after chunking consumed steps), satisfying the
//   decreases discipline because every non-break branch strictly increases
//   steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpenSpan {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= narrowThreshold {
        var next := helpers.GroupBoostedConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var constrainedPrompt := prompt + stablePrefix;
        var steppedGenerated, steppedInside, steppedCurrent, hitEos := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := steppedGenerated;
          insideConstrainedOut := steppedInside;
          currentConstrainedOut := steppedCurrent;
        }
      }
    }
  }
}

cost := steps;

