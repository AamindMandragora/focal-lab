Strategy: // CSD_RATIONALE_BEGIN
// The evaluation indicates the previous strategy's central flaw: it almost never
// produced any `<< >>` spans at all, because it waited for the base model to
// volunteer `<<` during unconstrained decoding. For this task family, that is
// the wrong control policy. The format requirement is mandatory, so the strategy
// must actively create short, well-formed constrained computations rather than
// passively hope they appear.
//
// This revision therefore switches to an explicit, budgeted two-phase policy:
//
// 1. If generation is already inside a constrained span, finish that span first:
//    generate parser-valid arithmetic tokens, and close immediately once the
//    parser says the expression is complete.
// 2. If generation is outside constrained mode, allow only a very short
//    unconstrained preamble. After that, explicitly open a constrained span with
//    `OpenConstrainedSpan`, so the output reliably contains `<<`.
// 3. Inside a span, prefer `AdaptiveConstrainedStep` with caller-supplied token
//    groups, because these tasks want arithmetic-like content and the helper
//    keeps every token parser-valid while still letting the LM choose among
//    valid options.
// 4. Keep spans short. If a span grows too long without becoming complete,
//    rollback to a valid boundary and, if that leaves nothing useful, abandon
//    the span by restoring consistency and exiting constrained mode rather than
//    wasting many more steps.
// 5. As soon as a complete constrained expression is available, call
//    `CloseConstrainedSpan`; EOS is always terminal.
// 6. To improve runtime, use `UnconstrainedChunk` outside spans instead of
//    token-by-token unconstrained decoding. The chunk stops early on either an
//    open-span token or EOS, reducing the large number of forward passes seen in
//    the trace.
//
// Relative to the failed attempt, the key change is replacing passive
// delimiter-detection with active span insertion plus immediate close-on-
// completeness. That directly targets both major observed failures:
// "Contains << >>: no" and "unterminated_constrained_segment".
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
// - In the outside-span chunk branch, we remain outside unless the chunk stops
//   on an already-emitted open-span token; in that case we set
//   `currentConstrainedOut := []`, which is parser-valid by precondition.
// - In the explicit-open branch, `OpenConstrainedSpan` enters constrained mode
//   with empty constrained content, so validity holds immediately.
// - In the close branch, `CloseConstrainedSpan` makes `insideConstrainedOut`
//   false, so the implication is vacuous afterward.
// - In the constrained-sampling branch, `AdaptiveConstrainedStep` returns either
//   EOS or a token whose append preserves parser validity; `AppendConstrainedToken`
//   then installs exactly that valid prefix.
// - In the rollback branch, `RollbackToBoundary` returns a parser-valid prefix;
//   if empty we exit constrained mode, otherwise we stay inside with that valid
//   repaired prefix.
//
// suffix:
// - Outside constrained mode the implication is vacuous. If a chunk ends on an
//   emitted `<<`, we enter with empty constrained content, and the length-0
//   suffix of `generated` is `[]`.
// - `OpenConstrainedSpan` appends only the delimiter and sets current content to
//   empty, so the suffix relation holds trivially.
// - In the constrained append branch, the sampled token is parser-valid and
//   `AppendConstrainedToken` appends it to both `generated` and
//   `currentConstrainedOut`, preserving exact suffix equality.
// - `CloseConstrainedSpan` exits constrained mode, making the implication
//   vacuous.
// - In rollback repair, `repaired` is a prefix of the old constrained content;
//   trimming exactly the dropped suffix from `generated` restores the equality
//   between the end of `generated` and `currentConstrainedOut`.
//
// cost accounting:
// - We maintain a local `steps` counter and return `cost := steps`.
// - `UnconstrainedChunk` returns `stepsUsed`; the branch adds exactly that to
//   `steps`.
// - `OpenConstrainedSpan`, `AdaptiveConstrainedStep`, and `CloseConstrainedSpan`
//   each cost 1, and their branches increment `steps` by 1.
// - The rollback branch uses only non-bumping helpers and local sequence
//   updates, so it explicitly does `steps := steps + 1`.
// - Any EOS branch breaks immediately after bounded work.
//
// progress:
// - In the chunk branch, `UnconstrainedChunk` appends exactly `stepsUsed` tokens
//   and we increment `steps` by `stepsUsed`, so
//   `|generated| <= |generatedPrefix| + steps` is preserved.
// - `OpenConstrainedSpan` appends exactly one token and increments `steps` by 1.
// - The constrained append branch appends exactly one token via
//   `AppendConstrainedToken` after one constrained sample step, and increments
//   `steps` by 1.
// - The close branch appends at most one token and increments `steps` by 1.
// - The rollback branch appends no tokens and may shrink `generated`; it still
//   increments `steps` by 1 explicitly, so the bound remains true and the
//   decreases metric strictly drops on every non-breaking iteration.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var preambleBudget: nat := 6;
var maxChunk: nat := 4;
var maxConstrainedLen: nat := 10;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else if |currentConstrainedOut| >= maxConstrainedLen {
      var repaired := helpers.RollbackToBoundary(parser, currentConstrainedOut, "=");
      generated := generated[..|generated| - (|currentConstrainedOut| - |repaired|)];
      currentConstrainedOut := repaired;
      if |currentConstrainedOut| == 0 {
        insideConstrainedOut := false;
      }
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  } else {
    if steps < preambleBudget {
      var remaining := maxSteps - steps;
      var chunkSize := maxChunk;
      if remaining < chunkSize {
        chunkSize := remaining;
      }
      if chunkSize == 0 {
        break;
      } else {
        var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
          lm, prompt, generated, chunkSize, "<<", eosToken
        );
        generated := chunkGenerated;
        steps := steps + stepsUsed;
        if stoppedOnEos {
          break;
        } else if stoppedOnOpenSpan {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    } else {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    }
  }
}

cost := steps;

