Strategy: // CSD_RATIONALE_BEGIN
// The last attempt failed for a very specific reason visible in the traces:
// forcing `OpenConstrainedSpan` at the start caused many outputs to be just
// `<<` or an unterminated arithmetic fragment. That satisfies neither answer
// quality nor the delimiter requirement. The best prior accuracy came from the
// conservative policy that let the model answer normally first.
//
// This revision therefore switches back to a late-fallback strategy:
//
// 1. Outside constrained mode, decode normally with `UnconstrainedStep`.
//    This preserves the model's ability to produce the actual math answer,
//    which is essential because many examples are extremely short.
// 2. Detect a naturally produced open delimiter by checking whether an
//    unconstrained token contains `"<<"`. Only then enter constrained tracking.
//    This avoids the "entered_constrained_mode_too_early" failure.
// 3. If already inside a constrained span, use the simplest verified helper
//    `ConstrainedStep` and close immediately when the parser reports
//    completeness. This minimizes malformed or unterminated spans.
// 4. If a constrained span grows too long, roll back to a boundary and abandon
//    it if necessary rather than spending many steps chasing completion.
// 5. Only near the very end of the budget, and only if no span has appeared
//    yet, explicitly open a single fallback span. After opening that fallback
//    span, spend only a tiny bounded number of constrained steps and close as
//    soon as possible; if EOS appears, stop immediately.
// 6. EOS is always terminal.
//
// Compared with the failed attempt, the key change is a full policy reversal:
// no early forced opening, mostly natural answer generation, and a single late
// fallback insertion solely to satisfy the required `<< >>` format when the
// model never produced one itself.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
// - Unconstrained branches either stay outside constrained mode or, when a
//   token containing `<<` is detected, enter constrained mode with
//   `currentConstrainedOut := []`; by precondition the empty prefix is valid.
// - The `ConstrainedStep` branch preserves parser validity by its postcondition
//   on non-EOS, and the close branch exits constrained mode so the implication
//   becomes vacuous.
// - The rollback branch sets `currentConstrainedOut` to the result of
//   `RollbackToBoundary`, which is guaranteed parser-valid; if we abandon the
//   span we set `insideConstrainedOut := false`, again making the implication
//   vacuous.
// - The late fallback open branch uses `OpenConstrainedSpan`, which sets the
//   constrained prefix to `[]`, preserving validity.
//
// suffix:
// - While outside constrained mode the invariant is vacuous.
// - When an unconstrained token containing `<<` is appended, we enter
//   constrained mode with empty constrained content, so the suffix relation
//   holds trivially.
// - `ConstrainedStep` preserves the suffix relation directly by specification;
//   `CloseConstrainedSpan` exits constrained mode so the implication is vacuous.
// - In rollback, `repaired` is a prefix of the old constrained content; trimming
//   exactly the dropped suffix from `generated` restores the suffix equality.
// - `OpenConstrainedSpan` appends only the delimiter and sets constrained
//   content to empty, so the suffix relation again holds trivially.
//
// cost accounting:
// - We use a local `steps` counter and return `cost := steps`.
// - `UnconstrainedStep`, `ConstrainedStep`, `CloseConstrainedSpan`, and
//   `OpenConstrainedSpan` each consume one unit, and the corresponding branch
//   increments `steps` by 1.
// - The rollback branch uses only non-bumping helpers and local sequence
//   updates, so it explicitly performs `steps := steps + 1`.
// - Any EOS branch breaks immediately after a branch that has already charged
//   its step, so returned cost remains bounded by `maxSteps`.
//
// progress:
// - `UnconstrainedStep` appends exactly one token and we increment `steps` by 1,
//   so `|generated| <= |generatedPrefix| + steps` is preserved.
// - `ConstrainedStep` appends either zero tokens on EOS and breaks immediately,
//   or one token on non-EOS with `steps := steps + 1`, preserving the bound.
// - `CloseConstrainedSpan` appends at most one token and increments `steps` by 1.
// - `OpenConstrainedSpan` appends exactly one token and increments `steps` by 1.
// - The rollback branch appends no tokens and may shrink `generated`; after the
//   explicit `steps := steps + 1`, the progress bound holds trivially and the
//   decreases metric strictly decreases.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var sawSpan: bool := insideConstrained;
var maxConstrainedLen: nat := 8;
var fallbackWindow: nat := 3;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      sawSpan := true;
      steps := steps + 1;
    } else if |currentConstrainedOut| >= maxConstrainedLen {
      var repaired := helpers.RollbackToBoundary(parser, currentConstrainedOut, "=");
      generated := generated[..|generated| - (|currentConstrainedOut| - |repaired|)];
      currentConstrainedOut := repaired;
      if |currentConstrainedOut| == 0 {
        insideConstrainedOut := false;
      }
      steps := steps + 1;
    } else {
      var steppedGenerated, steppedInside, steppedCurrent, hitEos := helpers.ConstrainedStep(
        lm, parser, prompt, generated, currentConstrainedOut, eosToken
      );
      steps := steps + 1;
      if hitEos {
        break;
      } else {
        generated := steppedGenerated;
        insideConstrainedOut := steppedInside;
        currentConstrainedOut := steppedCurrent;
      }
    }
  } else {
    if !sawSpan && steps + fallbackWindow >= maxSteps {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if Contains(next, "<<") {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          sawSpan := true;
        }
      }
    }
  }
}

cost := steps;

