============================================================
Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy waited for the base model to *voluntarily* emit `<<` in
// unconstrained text, then spent many steps inside a constrained span. The
// evaluation showed that this almost never produced a closed `<< ... >>`
// segment, causing severe syntax failures and long runtimes. The fix is to make
// delimiter production explicit and cheap:
//
// 1. Outside constrained mode, decode one unconstrained token at a time.
// 2. If the token itself is EOS, stop immediately.
// 3. If the token contains `<<`, treat that as the trigger to enter constrained
//    mode with an empty constrained payload.
// 4. If we are still outside constrained mode after a small number of free-form
//    tokens, forcibly open a constrained span using `OpenConstrainedSpan` so
//    the output reliably contains `<< >>`.
// 5. Inside constrained mode, generate parser-valid arithmetic content one token
//    at a time, using adaptive/group-boosted constrained sampling when helpful.
//    As soon as the parser says the arithmetic fragment is complete, close it
//    immediately with `CloseConstrainedSpan`.
// 6. If the constrained prefix grows too long without becoming complete, roll it
//    back to a valid prefix and spend one step on recovery; if it becomes empty,
//    break rather than looping forever.
//
// This directly addresses the observed failures: explicit opening guarantees the
// presence of `<<`, immediate closure on parser completeness prevents
// unterminated spans, and bounded recovery / bounded free-form preamble reduce
// repetition and runtime.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
// - Free-form unconstrained branches either keep `insideConstrainedOut == false`
//   or enter constrained mode with `currentConstrainedOut := []`; since
//   `parser.IsValidPrefix([])` holds, the invariant is preserved.
// - The close branch uses `CloseConstrainedSpan`, which sets
//   `insideConstrainedOut := false`, so the implication is vacuous.
// - The constrained sampling branch gets a token from
//   `AdaptiveConstrainedStep`/`GroupBoostedConstrainedStep`, whose postcondition
//   says the token is EOS or extends to a parser-valid prefix; on non-EOS,
//   `AppendConstrainedToken` preserves parser validity.
// - The rollback recovery branch sets `currentConstrainedOut` to a prefix
//   returned by `RollbackToBoundary`, which is guaranteed parser-valid.
//
// suffix:
// - In unconstrained branches the implication is vacuous unless we just entered
//   constrained mode, in which case `currentConstrainedOut == []` and the
//   length-0 suffix of `generated` equals `[]`.
// - `AppendConstrainedToken` appends the same token to both `generated` and the
//   constrained prefix, so the suffix relation is preserved.
// - `CloseConstrainedSpan` exits constrained mode, making the implication
//   vacuous.
// - In rollback recovery, `RollbackToBoundary` returns a prefix of the old
//   constrained content; trimming exactly the removed suffix from `generated`
//   restores `generated[|generated|-|currentConstrainedOut|..] == currentConstrainedOut`.
//
// cost accounting:
// - We return `cost := steps`.
// - `UnconstrainedStep`, `OpenConstrainedSpan`, `AdaptiveConstrainedStep`,
//   `GroupBoostedConstrainedStep`, and `CloseConstrainedSpan` each consume one
//   generation step, and the branch increments `steps` by 1 accordingly.
// - `AppendConstrainedToken` and rollback helpers do not bump cost themselves;
//   in branches using only those after a cost-bumping helper, `steps` was
//   already incremented for the sampling helper, and in the pure recovery branch
//   we explicitly do `steps := steps + 1`.
// - Breaking branches stop immediately after zero or one bounded helper calls,
//   so `steps <= maxSteps` remains true.
//
// progress:
// - Every non-breaking unconstrained branch appends exactly one token via
//   `UnconstrainedStep` or `OpenConstrainedSpan` and increments `steps` by 1,
//   so `|generated| <= |generatedPrefix| + steps` is preserved.
// - The constrained append branch samples one valid token, increments `steps` by
//   1, and appends exactly one token, preserving the bound.
// - The close branch increments `steps` by 1 and appends at most one token,
//   preserving the bound.
// - The rollback recovery branch may shrink `generated` but appends nothing; it
//   still increments `steps` by 1 explicitly, so the bound holds trivially and
//   the decreases metric strictly drops on every non-breaking iteration.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var freeTokens: nat := 0;
var forcedOpenAfter: nat := 6;
var maxConstrainedLen: nat := 24;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if freeTokens >= forcedOpenAfter {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
      freeTokens := 0;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        freeTokens := freeTokens + 1;
        if Contains(next, "<<") {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          freeTokens := 0;
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      freeTokens := 0;
    } else if |currentConstrainedOut| >= maxConstrainedLen {
      var repaired := helpers.RollbackToBoundary(parser, currentConstrainedOut, "=");
      generated := generated[..|generated| - (|currentConstrainedOut| - |repaired|)];
      currentConstrainedOut := repaired;
      steps := steps + 1;
      if |currentConstrainedOut| == 0 {
        break;
      }
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var nextConstrained: Token;
      if validCount <= 12 {
        nextConstrained := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
      } else {
        nextConstrained := helpers.GroupBoostedConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 3.0, eosToken
        );
      }
      steps := steps + 1;
      if nextConstrained == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, nextConstrained
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

