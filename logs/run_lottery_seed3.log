Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy still let the model decide too much of the arithmetic
// text inside `<< >>`. That produced malformed constrained content such as
// variable names or prose fragments (`<<Beach speed ...>>`), which directly
// caused the syntax-rate failures. It also sometimes opened after generic cue
// tokens like "=" in setup prose, which was still too early.
//
// This revision changes the policy substantially:
//
// 1. Delimiters are now opened only after a *numeric-looking token* has just
//    been generated. This targets actual arithmetic moments like `12`, `5`, or
//    `24` rather than prose/setup markers like `=`.
// 2. Once inside constrained mode, generation is intentionally very short-lived.
//    We allow at most two constrained tokens to be appended. This biases spans
//    toward tiny arithmetic snippets such as `12+3`, `8*4`, or `15/3`, and
//    prevents long malformed spans containing words.
// 3. While inside constrained mode, we query the parser for dead-end pressure.
//    If the current constrained prefix is already complete, we close
//    immediately. If it looks risky and there is not enough budget to continue
//    safely, we stop rather than emit an unterminated or malformed span.
// 4. Outside constrained mode, we continue ordinary generation but strongly
//    penalize both delimiter tokens so accidental raw delimiters are unlikely.
// 5. The strategy remains conservative on budget: it only opens when there is
//    room to open, add at least one constrained token, and later close.
//
// The key evaluation-oriented change is therefore: constrain only around short,
// parser-guided arithmetic expressions that begin right after numeric tokens,
// instead of trying to synthesize larger computations from general reasoning
// context.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In unconstrained branches we remain outside constrained mode,
//   so the implication is vacuous. Opening uses OpenConstrainedSpan, which sets
//   the tracked constrained content to [] and thus valid. The constrained-step
//   branch gets a parser-approved next token from ConstrainedStep and then
//   extends the tracked content with AppendConstrainedToken, preserving parser
//   validity. The close branch exits constrained mode, making the implication
//   vacuous. Break branches leave the state unchanged.
//
// suffix: When outside constrained mode, the suffix invariant is vacuous.
//   OpenConstrainedSpan appends only the opening delimiter and sets
//   currentConstrainedOut to [], so the suffix of length 0 matches. In the
//   append branch, AppendConstrainedToken appends the same token to generated
//   and to currentConstrainedOut, preserving the suffix equality. Closing exits
//   constrained mode, so the invariant becomes vacuous again. Breaks preserve
//   the existing state.
//
// cost: Every branch that uses a cost-bumping helper (OpenConstrainedSpan,
//   ConstrainedStep, CloseConstrainedSpan) also increments steps by 1 exactly
//   once. In the unconstrained sampling branch, after ChooseNextTokenUnconstrained
//   we manually increment helpers.cost by 1 and also increment steps by 1.
//   Query helpers such as DeadEndDetection and IsTokenValidNext do not change
//   helpers.cost, and break branches do not increase it, so helpers.cost <=
//   steps is preserved.
//
// progress: In the unconstrained branch we append at most one token to generated
//   and increment steps by 1. OpenConstrainedSpan appends exactly one token and
//   increments steps by 1. The constrained append branch appends at most one
//   token after a single step increment. CloseConstrainedSpan appends exactly
//   one closing delimiter and increments steps by 1. Query-only and break
//   branches do not increase generated, so |generated| <= |generatedPrefix| +
//   steps remains preserved in every branch.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;
var constrainedTokensUsed := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant 0 <= constrainedTokensUsed
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      constrainedTokensUsed := 0;
      steps := steps + 1;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      if steps + 2 > maxSteps {
        break;
      } else {
        if constrainedTokensUsed >= 2 {
          break;
        } else {
          if narrow && constrainedTokensUsed > 0 {
            break;
          } else {
            var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
            var nextConstrained := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
            steps := steps + 1;
            if nextConstrained == eosToken {
              break;
            } else {
              var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
                lm, parser, generated, currentConstrainedOut, nextConstrained
              );
              generated := appendedGenerated;
              insideConstrainedOut := appendedInside;
              currentConstrainedOut := appendedCurrent;
              constrainedTokensUsed := constrainedTokensUsed + 1;
            }
          }
        }
      }
    }
  } else {
    var shouldOpen := false;
    if steps + 3 <= maxSteps {
      if 0 < |generated| {
        var prev := generated[|generated| - 1];
        if Contains(prev, "0") {
          shouldOpen := true;
        } else {
          if Contains(prev, "1") {
            shouldOpen := true;
          } else {
            if Contains(prev, "2") {
              shouldOpen := true;
            } else {
              if Contains(prev, "3") {
                shouldOpen := true;
              } else {
                if Contains(prev, "4") {
                  shouldOpen := true;
                } else {
                  if Contains(prev, "5") {
                    shouldOpen := true;
                  } else {
                    if Contains(prev, "6") {
                      shouldOpen := true;
                    } else {
                      if Contains(prev, "7") {
                        shouldOpen := true;
                      } else {
                        if Contains(prev, "8") {
                          shouldOpen := true;
                        } else {
                          if Contains(prev, "9") {
                            shouldOpen := true;
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }

    if shouldOpen {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      constrainedTokensUsed := 0;
      steps := steps + 1;
    } else {
      lm.GenerateLogits(prompt + generated);
      helpers.PenalizeTokenLogits(lm, ["<<"], 100.0);
      helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        if next == "<<" {
          break;
        } else {
          if next == ">>" {
            break;
          } else {
            generated := generated + [next];
          }
        }
      }
    }
  }
}

cost := steps;

