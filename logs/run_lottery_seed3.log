Strategy: // CSD_RATIONALE_BEGIN
// This strategy tracks the full generated output in `generated`, whether we are
// currently inside a math-computation span in `insideConstrainedOut`, and the
// current contents of that span in `currentConstrainedOut`. Outside a span we
// decode mostly freely, but we proactively open a constrained span either when
// the model emits the delimiter token "<<" or when the token text contains "<<",
// because this task wants arithmetic computations written inside delimiters.
// Inside a span we keep the parser-valid prefix invariant by preferring the
// current argmax when it is parser-valid, and otherwise falling back to the
// verified constrained sampler. Once the parser says the span is complete, we
// close it with ">>". This state discipline makes every active constrained
// segment parser-valid and aligned with the suffix of the emitted text.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if we do not enter a span then
//   `insideConstrainedOut` stays false, so the implication is vacuous. If we
//   append a normal token and it is exactly "<<" or merely contains "<<", we
//   set `currentConstrainedOut := []`, which is valid by the method precondition
//   `parser.IsValidPrefix([])`. In the complete-prefix branch,
//   CloseConstrainedSpan sets `insideConstrainedOut` false, so the implication
//   is again vacuous. In the active constrained branch, the speculative argmax
//   path first checks `IsTokenValidNext`, and the fallback path uses
//   ConstrainedStep; both feed only valid-next tokens to AppendConstrainedToken,
//   so the resulting constrained prefix remains valid.
// suffix: In unconstrained decoding without opening, the invariant is vacuous.
//   When we open a span, we append one delimiter token to `generated` and set
//   `currentConstrainedOut := []`; the length-0 suffix of `generated` is `[]`.
//   CloseConstrainedSpan appends the closing delimiter and resets the current
//   constrained prefix to `[]`, so the implication holds. In either constrained
//   append path, AppendConstrainedToken appends the same token to `generated`
//   and `currentConstrainedOut`, preserving the suffix equality.
// cost: UnconstrainedStep, ConstrainedStep, and CloseConstrainedSpan each bump
//   `helpers.cost` by 1 internally; in those same branches we increment
//   `steps := steps + 1`, so `helpers.cost <= steps` is preserved. The
//   speculative argmax-inside-span branch uses only queries plus
//   AppendConstrainedToken, which does not bump helper cost; we still increment
//   `steps`, so the inequality remains true with extra slack.
// progress: Each branch appends at most one token to `generated`, except the
//   complete-prefix branch which appends the single closing delimiter token.
//   Every non-break iteration increments `steps` by 1, so
//   `|generated| <= |generatedPrefix| + steps` is maintained.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        if Contains(next, "<<") {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);
      if argmaxValid && argmax != eosToken {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

