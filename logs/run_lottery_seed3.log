Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it relied on the model to emit the
// opening delimiter and then tried to continue token-by-token inside the span;
// in practice that often produced an opened `<<` without a matching `>>`.
// This revision makes delimiter handling explicit and conservative.
// Outside constrained mode, if the model emits EOS we stop. If it emits the
// exact delimiter token `<<`, we do not merely append it; instead we call the
// verified helper `OpenConstrainedSpan`, which updates all three tracked states
// consistently. While inside constrained mode, we never decode freely. If the
// parser says the constrained prefix is complete, we immediately close via
// `CloseConstrainedSpan`, guaranteeing a matching `>>`. Otherwise we use the
// verified constrained sampler `ConstrainedStep` and append only parser-valid
// tokens with `AppendConstrainedToken`.
// To improve evaluation behavior for math formatting, we also bias the
// unconstrained logits toward the exact token `<<` and against tokens that only
// contain the substring `<<`; this avoids malformed pseudo-delimiters while
// still encouraging actual constrained spans. The result is a simple state
// machine: unconstrained text, explicit open, parser-valid constrained content,
// explicit close, with EOS treated as terminal.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch without opening, either we break
//   on EOS or append a normal token while staying outside constrained mode, so
//   the implication is vacuous. In the exact-`<<` branch, OpenConstrainedSpan
//   enters constrained mode with empty constrained content, and `[]` is valid
//   by precondition. In the complete-prefix branch, CloseConstrainedSpan exits
//   constrained mode, making the implication vacuous. In the active constrained
//   append branch, ConstrainedStep returns a parser-valid next token and
//   AppendConstrainedToken extends the constrained prefix with that token, so
//   validity is preserved.
// suffix: Outside constrained mode the invariant is vacuous. OpenConstrainedSpan
//   appends the opening delimiter to `generated` and sets the constrained
//   content to `[]`, whose suffix relation holds trivially. CloseConstrainedSpan
//   appends only the closing delimiter and resets constrained tracking to `[]`,
//   so the implication is vacuous afterward. AppendConstrainedToken appends the
//   same token to both `generated` and `currentConstrainedOut`, preserving the
//   suffix equality.
// cost: In the normal unconstrained branch we manually choose a token and then
//   increment both `helpers.cost` and `steps` by 1. OpenConstrainedSpan,
//   ConstrainedStep, and CloseConstrainedSpan each bump helper cost by 1
//   internally, and in those same branches we increment `steps` by 1, so
//   `helpers.cost <= steps` is preserved. Pure logit-bias operations and
//   AppendConstrainedToken do not bump helper cost, so they cannot violate the
//   inequality.
// progress: Every non-break iteration increments `steps` by 1. The unconstrained
//   append branch adds one token to `generated`; the opening branch appends the
//   single `<<` token; the constrained append branch appends one constrained
//   token; and the close branch appends the single `>>` token. Thus each step
//   increases `|generated|` by at most 1, preserving
//   `|generated| <= |generatedPrefix| + steps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 8.0);
    helpers.PenalizeTokenLogits(lm, [">>"], 8.0);
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      if next == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

