// 1. Outside constrained mode, never sample raw delimiter tokens into the
//    output. We strongly penalize both "<<" and ">>" during unconstrained
//    sampling, so ordinary prose cannot accidentally emit them.
// 2. When enough budget remains, we deliberately open exactly one constrained
//    span using OpenConstrainedSpan, generate only parser-valid arithmetic
//    content inside it via ConstrainedStep/AppendConstrainedToken, and as soon
//    as the parser reports completeness we immediately close it with
//    CloseConstrainedSpan before doing anything else.
// 3. If we are already inside a constrained span on entry, we prioritize
//    finishing and closing that span before any other generation.
// 4. We reserve one step for closing whenever we are inside constrained mode:
//    if only one step remains and the constrained content is not yet complete,
//    we stop rather than append more content that we would be unable to close.
//
// This directly targets the evaluation failures: delimiter tokens are now only
// produced by the dedicated open/close helpers, and every opened span is either
// closed immediately upon completeness or generation stops before extending an
// uncloseable partial span.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-no-open branch we remain outside constrained
//   mode, so the implication is vacuous. In the deliberate opening branch,
//   OpenConstrainedSpan sets currentConstrainedOut to [], which is valid by the
//   precondition on the parser. In the inside-complete branch,
//   CloseConstrainedSpan exits constrained mode, so the implication is vacuous.
//   In the inside-append branch, ConstrainedStep returns a parser-valid next
//   token and AppendConstrainedToken extends the constrained prefix accordingly,
//   preserving validity; the break branches do not modify the state.
//
// suffix: When outside constrained mode and not opening, the implication is
//   vacuous. OpenConstrainedSpan appends only the opening delimiter and sets the
//   tracked constrained content to [], so generated's suffix of length 0 equals
//   currentConstrainedOut. CloseConstrainedSpan exits constrained mode, making
//   the implication vacuous. In the append branch, AppendConstrainedToken adds
//   the same token to generated and to currentConstrainedOut, preserving the
//   suffix equality; break branches leave the state unchanged.
//
// cost: In the outside-no-open branch we use one unconstrained sample and then
//   manually increment helpers.cost and steps by 1. In the deliberate opening
//   branch, OpenConstrainedSpan is the only cost-bumping operation, so steps is
//   incremented by 1 as well. In the inside-complete branch,
//   CloseConstrainedSpan bumps helper cost by 1 and we increment steps by 1. In
//   the inside-append branch, ConstrainedStep bumps helper cost by 1 and we
//   increment steps by 1 before the pure AppendConstrainedToken call. Query-only
//   checks and break branches do not increase helper cost, so helpers.cost <=
//   steps is preserved everywhere.
//
// progress: The outside-no-open branch appends at most one token to generated
//   while steps increases by 1. The deliberate opening branch appends exactly
//   one token ("<<") and also increments steps by 1. The inside-complete branch
//   appends exactly one token (">>") and increments steps by 1. The
//   inside-append branch appends at most one constrained token and increments
//   steps by 1 before the append. Break branches do not increase generated, so
//   |generated| <= |generatedPrefix| + steps is preserved in every branch.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if steps + 1 < maxSteps {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var nextConstrained := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextConstrained == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, nextConstrained
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        break;
      }
    }
  } else {
    if steps + 1 < maxSteps {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      lm.GenerateLogits(prompt + generated);
      helpers.PenalizeTokenLogits(lm, ["<<"], 100.0);
      helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        if next == "<<" {
          break;
        } else {
          if next == ">>" {
            break;
          } else {
            generated := generated + [next];
          }
        }
      }
    }
  }
}

cost := steps;

