```dafny
// CSD_RATIONALE_BEGIN
// Math-step CSD with delimiter-triggered constrained spans. The strategy tracks
// the usual generated text plus whether we are currently inside a `<< ... >>`
// arithmetic span, where `currentConstrainedOut` stores only the span contents.
// Outside spans, generation is unconstrained so the model can write natural
// step-by-step explanations. When a `<<` token is emitted, the strategy enters
// constrained mode and uses adaptive group-boosted constrained sampling to keep
// arithmetic text parser-valid while softly preferring caller-supplied token
// groups when the grammar is narrow. As soon as the parser reports that the
// current arithmetic fragment is complete, the strategy closes the span with
// `>>`.
//
// The key observation is that this task alternates between free-form prose and
// tightly structured arithmetic snippets. Tracking the active constrained suffix
// lets the strategy hand the arithmetic region to the parser without losing the
// surrounding explanation text, and the complete-prefix check ensures `>>` is
// only emitted when the arithmetic inside `<< >>` is already valid.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if the sampled token is not
//   `<<`, we stay outside the span so the implication remains vacuous; if it is
//   `<<`, we set insideConstrainedOut := true and currentConstrainedOut := [],
//   which is valid by the method precondition parser.IsValidPrefix([]). In the
//   complete-prefix branch, CloseConstrainedSpan sets insideConstrainedOut to
//   false, again making the implication vacuous. In the active constrained
//   branch, AdaptiveConstrainedStep guarantees either EOS or a parser-valid next
//   token; on non-EOS, AppendConstrainedToken extends the constrained prefix to
//   another parser-valid prefix.
// suffix: In the unconstrained branch, when we remain outside the span the
//   invariant is vacuous; when we enter a span on `<<`, currentConstrainedOut is
//   reset to [], and the length-0 suffix of generated is []. In the complete-
//   prefix branch, CloseConstrainedSpan appends at most the closing delimiter
//   and resets currentConstrainedOut to [], so the implication is vacuous. In
//   the active constrained branch, AppendConstrainedToken appends the same token
//   to generated and currentConstrainedOut, preserving that the generated suffix
//   equals the constrained contents.
// cost accounting: The loop uses a local `steps` counter and returns cost :=
//   steps. UnconstrainedStep, CloseConstrainedSpan, and AdaptiveConstrainedStep
//   are all cost-bumping helpers for one step, and each corresponding non-break
//   branch does steps := steps + 1 exactly once. Break branches do not need to
//   preserve a stronger equality afterward because cost is assigned from steps
//   only after the loop exits.
// progress: UnconstrainedStep appends exactly one token to generated when it is
//   not EOS, and we increment steps by 1; if it is EOS we break immediately.
//   CloseConstrainedSpan appends at most one token and steps increases by 1.
//   AdaptiveConstrainedStep itself only samples the next constrained token; on
//   non-EOS we append exactly one token with AppendConstrainedToken and then
//   increment steps by 1, while on EOS we break after the same single-step
//   accounting. Thus every non-breaking branch strictly increases steps and
//   generated grows by at most that much, preserving |generated| <=
//   |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;
