// This revision targets the largest observed failure mode: malformed_constrained_content.
// The single edit is to increase the group-boost amount in the active constrained
// branch from 4.0 to 8.0 while keeping the best-performing strategy otherwise
// identical. The failure traces show arithmetic spans that remain parser-shaped
// enough to open `<< >>` but drift into symbolic templates like `k * y / 12`
// instead of concrete arithmetic. A stronger always-on boost for caller-supplied
// token groups is the smallest change that may further bias constrained decoding
// toward well-formed arithmetic tokens without altering unconstrained prose or
// delimiter handling.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if the sampled token is not
//   `<<`, we remain outside constrained mode so the implication is vacuous; if
//   it is `<<`, we enter constrained mode with currentConstrainedOut := [], and
//   parser.IsValidPrefix([]) holds by precondition. In the complete-prefix
//   branch, CloseConstrainedSpan sets insideConstrainedOut to false, so the
//   implication is vacuous. In the active constrained branch,
//   GroupBoostedConstrainedStep guarantees either EOS or a token that keeps the
//   constrained prefix parser-valid; on non-EOS, AppendConstrainedToken extends
//   currentConstrainedOut to that valid prefix.
// suffix: In the unconstrained branch, staying outside constrained mode makes
//   the suffix invariant vacuous; when `<<` is appended, currentConstrainedOut
//   becomes [], which matches the length-0 suffix of generated. In the
//   complete-prefix branch, CloseConstrainedSpan resets currentConstrainedOut to
//   [], so the implication is vacuous. In the active constrained branch,
//   AppendConstrainedToken appends the same sampled token to generated and to
//   currentConstrainedOut, preserving that the generated suffix equals the
//   constrained contents.
// cost accounting: The loop tracks progress with local steps and returns
//   cost := steps. UnconstrainedStep, CloseConstrainedSpan, and
//   GroupBoostedConstrainedStep each consume one decoding step, and every
//   corresponding non-breaking branch increments steps by exactly 1. Break
//   branches occur only after a helper already consumed that step, so assigning
//   cost := steps after the loop is consistent.
// progress: UnconstrainedStep appends exactly one token on non-EOS and we do
//   steps := steps + 1; on EOS we break immediately after the same step charge.
//   CloseConstrainedSpan appends at most one token and then increments steps by
//   1, so |generated| grows by at most the step increase. In the active
//   constrained branch, GroupBoostedConstrainedStep uses one step; on non-EOS,
//   AppendConstrainedToken appends exactly one token and then steps increases by
//   1, while on EOS we break immediately. Thus every non-breaking branch
//   strictly increases steps and preserves |generated| <= |generatedPrefix| +
//   steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
