Strategy: // CSD_RATIONALE_BEGIN
// This strategy tracks the full generated output in `generated`, whether we are
// currently inside a constrained arithmetic span in `insideConstrainedOut`, and
// the delimiter-free contents of that active span in `currentConstrainedOut`.
// Outside a span, generation is mostly free, but if the model strongly favors
// the opening delimiter "<<" (or emits it directly) we enter constrained mode.
// Inside a span, we first detect dead ends; if the current constrained prefix
// has become too narrow, we roll it back to a parser-valid prefix and repair
// the generated suffix to match. When the parser reports completeness we close
// with ">>"; otherwise we prefer a parser-valid argmax token and fall back to a
// constrained helper step when needed. This keeps arithmetic text inside << >>
// parser-valid while preserving ordinary free-form reasoning outside spans.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, either we stay outside
//   constrained mode, or we append "<<" and set currentConstrainedOut := [],
//   which is valid by precondition. In the rollback branch, we replace the
//   active constrained prefix by RollbackToValidPrefix, which is parser-valid by
//   construction. In the complete-prefix branch, CloseConstrainedSpan sets
//   insideConstrainedOut to false, making the implication vacuous. In the
//   constrained argmax and fallback branches, AppendConstrainedToken is only
//   used after a valid-next check or after ConstrainedStep, so validity is
//   preserved.
// suffix: Outside constrained mode the implication is vacuous. On entry via
//   "<<" we set currentConstrainedOut := [], so the length-0 suffix matches.
//   In the rollback branch we simultaneously set
//   generated := generated[..|generated|-|currentConstrainedOut|] + rolled and
//   currentConstrainedOut := rolled, so the generated suffix equals the new
//   constrained prefix. CloseConstrainedSpan appends ">>" and resets the active
//   constrained prefix to [], and AppendConstrainedToken appends the same token
//   to both generated and currentConstrainedOut.
// cost: UnconstrainedStep, ConstrainedStep, and CloseConstrainedSpan each bump
//   helpers.cost by 1 internally, and we increment steps by 1 in the same
//   branch. Query helpers such as DeadEndDetection, RollbackToValidPrefix,
//   IsTokenValidNext, GetHighestLogitToken, and GetTokenLogit do not bump cost.
//   In the raw-logit unconstrained eager-open branch we manually do
//   helpers.cost := helpers.cost + 1 together with steps := steps + 1. The
//   rollback repair branch does not bump cost and also does not increment
//   steps, so helpers.cost <= steps is preserved.
// progress: The unconstrained sample branch appends at most one token and then
//   increments steps. The eager-open branch appends exactly one token ("<<")
//   and increments steps. The rollback branch may shorten generated, so it
//   certainly preserves |generated| <= |generatedPrefix| + steps. The close and
//   constrained-append branches append at most one token and increment steps by
//   1. Therefore every branch preserves the progress bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    if openLogit >= argmaxLogit - 2.0 && argmax != eosToken && !Contains(argmax, "<<") {
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      generated := generated + ["<<"];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
    if narrow {
      var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
      generated := generated[..|generated| - |currentConstrainedOut|] + rolled;
      currentConstrainedOut := rolled;
    } else if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);
      if argmaxValid && argmax != eosToken {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

