Strategy: // CSD_RATIONALE_BEGIN
// Step-by-step math CSD with delimiter-aware mode switching and lightweight
// arithmetic-token steering. The strategy tracks the usual constrained-span
// state (`insideConstrainedOut`, `currentConstrainedOut`) plus a local
// `arithContext` sequence extracted from the current span after arithmetic
// cue tokens such as "=". Outside a span it generates freely until either EOS
// or the opening delimiter "<<" appears. Inside a span, if the parser says the
// current arithmetic fragment is complete, it closes immediately with ">>".
// Otherwise it chooses the next constrained token using an adaptive policy:
// when the grammar is narrow it uses AdaptiveConstrainedStep with the caller's
// validTokenGroups; when the grammar is wider it manually boosts tokens from
// the caller groups and from the extracted arithmetic context, then masks to
// parser-valid tokens and samples.
//
// The tracked arithmetic context is not required for correctness; correctness
// comes from the parser-valid mask and the delimiter discipline. The context
// only biases generation toward locally relevant arithmetic continuations,
// helping the model keep computations coherent while every token inside << >>
// remains parser-valid.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, the only way we enter a span is
//   after generating "<<", and then we set currentConstrainedOut := [], which is
//   valid by precondition parser.IsValidPrefix([]). In the close branch,
//   CloseConstrainedSpan sets insideConstrainedOut to false, so the implication
//   becomes vacuous. In the adaptive constrained branch, AdaptiveConstrainedStep
//   returns either eosToken or a parser-valid next token; on non-EOS,
//   AppendConstrainedToken preserves parser validity. In the manual boost+mask
//   branch, MaskValidNextAndEos ensures any sampled non-EOS token is valid next,
//   so AppendConstrainedToken again preserves validity.
// suffix: In the unconstrained branch, when we are outside a span the invariant
//   is vacuous; if we open a span, currentConstrainedOut becomes [] so the
//   length-0 suffix of generated matches it immediately. In the close branch,
//   CloseConstrainedSpan appends the closing delimiter and resets the tracked
//   constrained content to [], making the suffix implication vacuous. In both
//   constrained token-generation branches, AppendConstrainedToken appends the
//   same token to generated and currentConstrainedOut, preserving the suffix
//   equality.
// cost accounting: `cost` stays 0 throughout the loop and is assigned from the
//   local `steps` only once at the end. Every non-breaking branch increments
//   `steps` by exactly 1 after one cost-bumping action (UnconstrainedStep,
//   CloseConstrainedSpan, AdaptiveConstrainedStep, or manual masked sampling
//   with explicit helpers.cost bump), so returning `cost := steps` yields
//   cost <= maxSteps.
// progress: UnconstrainedStep appends exactly one token and we do steps :=
//   steps + 1. CloseConstrainedSpan appends at most one token and we increment
//   steps by 1. The adaptive constrained branch appends one constrained token
//   only on non-EOS and still increments steps by 1; on EOS it breaks
//   immediately after the increment. The manual boost+mask branch likewise
//   appends at most one token and increments steps by 1, or breaks on EOS.
//   Therefore every non-breaking branch strictly increases `steps`, satisfying
//   the decreases clause, and |generated| <= |generatedPrefix| + steps is
//   preserved because generated grows by at most one token per iteration.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;
var arithmeticCue: Token := "=";
var arithContext: seq<Token> := [];

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
        arithContext := [];
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      arithContext := [];
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      arithContext := helpers.ExtractAfterKeyword(currentConstrainedOut, arithmeticCue);
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);

      if validCount <= narrowThreshold {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        lm.GenerateLogits(prompt + stablePrefix + currentConstrainedOut);

        if |validTokenGroups| > 0 {
          helpers.BoostValidGroups(lm, parser, currentConstrainedOut, validTokenGroups, 3.0);
        }

        if |arithContext| > 0 {
          var candidates := helpers.TopValidCandidates(
            lm, parser, prompt + stablePrefix, currentConstrainedOut, 20, eosToken
          );
          var focused := helpers.IntersectTokenSets(candidates, arithContext);
          if |focused| > 0 {
            helpers.BoostTokenLogits(lm, focused, 6.0);
          }
        }

        lm.MaskValidNextAndEos(parser, currentConstrainedOut, eosToken);
        var next := lm.ChooseNextToken();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;

        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

cost := steps;

