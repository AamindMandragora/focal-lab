Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy almost never entered constrained mode early enough and,
// once inside, allowed long free-form arithmetic/text spans that often remained
// unclosed or syntactically malformed. The traces showed overwhelmingly many
// unconstrained single-token steps, so the model wandered instead of reliably
// producing short `<<...>>` computations.
//
// This revision changes the policy substantially:
// 1. Outside constrained mode, it aggressively steers toward opening a span by
//    boosting "<<" whenever the current generated text contains arithmetic cues
//    (such as "=", "+", "-", "*", "/", or words like "total"). This is done
//    with explicit logit manipulation instead of plain UnconstrainedStep.
// 2. Once inside constrained mode, it keeps spans short and syntax-safe. If the
//    current constrained prefix is complete, it closes immediately. Otherwise it
//    uses only verified constrained sampling helpers, preferring group-boosted
//    constrained sampling when caller groups are available and plain
//    ConstrainedStep otherwise.
// 3. To avoid malformed long spans, it also closes early after a modest span
//    length whenever the parser already marks the prefix complete.
// 4. EOS is always terminal.
//
// The design goal is not sophisticated reasoning inside the span; it is high
// syntax reliability for arithmetic snippets inside `<< >>`, while still
// letting the model explain the solution outside the delimiters.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch we either stay outside, or append "<<"
// and set currentConstrainedOut := [], which is parser-valid by precondition.
// In the close branch, CloseConstrainedSpan makes insideConstrainedOut false, so
// the implication is vacuous. In the constrained-sampling branches,
// ConstrainedStep and GroupBoostedConstrainedStep guarantee either EOS or a
// parser-valid next token; on non-EOS, AppendConstrainedToken preserves
// parser-validity of currentConstrainedOut.
//
// suffix: While outside constrained mode the invariant is vacuous. Opening a
// span appends only the delimiter and resets currentConstrainedOut to [], so the
// generated suffix of length 0 matches. Closing a span resets inside to false,
// so the implication is vacuous. In constrained append branches,
// AppendConstrainedToken appends the same sampled token to both generated and
// currentConstrainedOut, preserving the suffix equality.
//
// cost accounting: Returned cost is assigned from the local steps counter at the
// end. Every non-breaking branch increments steps by exactly 1 after exactly one
// cost-bumping action: manual unconstrained sample with explicit helpers.cost
// bump, OpenConstrainedSpan, CloseConstrainedSpan, ConstrainedStep, or
// GroupBoostedConstrainedStep. Therefore steps never exceeds maxSteps and
// cost := steps satisfies cost <= maxSteps.
//
// progress: The outside manual-sample branch appends exactly one token and then
// increments steps by 1, or breaks immediately on EOS after the increment. The
// explicit open branch appends exactly one token ("<<") and increments steps by
// 1. The close branch appends at most one token and increments steps by 1. The
// constrained branches either append exactly one token and increment steps by 1,
// or break on EOS after the increment. Hence every non-breaking branch strictly
// increases steps, satisfying decreases maxSteps - steps, and |generated| <=
// |generatedPrefix| + steps is preserved because generated grows by at most one
// token per iteration.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var shouldOpen: bool := false;
var stablePrefix: Prefix := [];
var next: Token := eosToken;
var flatGroups: seq<Token> := helpers.FlattenTokenGroups(validTokenGroups);

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    shouldOpen := false;
    if "<<" in lm.Tokens {
      if Contains(generated, "=") {
        shouldOpen := true;
      } else {
        if Contains(generated, "+") {
          shouldOpen := true;
        } else {
          if Contains(generated, "-") {
            shouldOpen := true;
          } else {
            if Contains(generated, "*") {
              shouldOpen := true;
            } else {
              if Contains(generated, "/") {
                shouldOpen := true;
              } else {
                if Contains(generated, "total") {
                  shouldOpen := true;
                }
              }
            }
          }
        }
      }
    }

    if shouldOpen {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      lm.GenerateLogits(prompt + generated);
      if "<<" in lm.Tokens {
        helpers.BoostTokenLogits(lm, ["<<"], 8.0);
      }
      if |flatGroups| > 0 {
        helpers.PenalizeTokenLogits(lm, flatGroups, 1.0);
      }
      next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      if |validTokenGroups| > 0 {
        next := helpers.GroupBoostedConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var generatedOut, insideOut, currentOut, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := generatedOut;
          insideConstrainedOut := insideOut;
          currentConstrainedOut := currentOut;
        }
      }
    }
  }
}

cost := steps;

