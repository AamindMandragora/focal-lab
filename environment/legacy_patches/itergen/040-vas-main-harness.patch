+    def _sampling_logits_processors(self, input_ids_seq_length: int) -> LogitsProcessorList:
+        """Sampling logits warp steps; supports transformers with or without ``_get_logits_warper``."""
+        model = self.model
+        gc = self.generation_config
+        device = self.device
+        if hasattr(model, "_get_logits_warper"):
+            return model._get_logits_warper(gc, device=device)
+        lp = model._get_logits_processor(
+            gc,
+            input_ids_seq_length=input_ids_seq_length,
+            device=device,
+        )
+        if not gc.do_sample:
+            return LogitsProcessorList()
+        warper_types = (
+            "TemperatureLogitsWarper",
+            "TopKLogitsWarper",
+            "TopPLogitsWarper",
+            "TypicalLogitsWarper",
+            "EpsilonLogitsWarper",
+            "EtaLogitsWarper",
+            "MinPLogitsWarper",
+            "TopHLogitsWarper",
+        )
+        out = LogitsProcessorList()
+        for p in lp:
+            if type(p).__name__ in warper_types:
+                out.append(p)
+        return out
+
