index 0000000..2d45e82
--- /dev/null
+++ b/tests/test_prompt_cache_input.py
@@ -0,0 +1,24 @@
+from itergen.main import IterGen
+
+
+class _ConfigAllocatedCache:
+    def __init__(self, sequence_length: int):
+        self.sequence_length = sequence_length
+
+    def __bool__(self) -> bool:
+        return True
+
+    def get_seq_length(self) -> int:
+        return self.sequence_length
+
+
+def test_truthy_empty_cache_is_not_ready_for_latest_token_generation():
+    assert not IterGen._cache_has_tokens(
+        _ConfigAllocatedCache(sequence_length=0)
+    )
+
+
+def test_populated_cache_is_ready_for_latest_token_generation():
+    assert IterGen._cache_has_tokens(
+        _ConfigAllocatedCache(sequence_length=2)
+    )
