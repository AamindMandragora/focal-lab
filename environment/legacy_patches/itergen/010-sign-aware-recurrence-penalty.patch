@@ -0,0 +1,18 @@
+import pytest
+import torch
+
+from itergen.main import IterGen
+
+
+def test_recurrence_penalty_lowers_positive_and_negative_repeated_token_logits():
+    scores = torch.tensor([[-2.0, 4.0, 1.5]])
+
+    adjusted = IterGen._apply_recurrence_penalty(
+        scores.clone(),
+        token_ids=[0, 1],
+        penalty=0.3,
+    )
+
+    assert adjusted[0, 0].item() == pytest.approx(-2.0 / 0.3)
+    assert adjusted[0, 1].item() == pytest.approx(4.0 * 0.3)
+    assert adjusted[0, 2].item() == pytest.approx(1.5)
