@@ -172,1 +172,29 @@ class IterGen:
+    @staticmethod
+    def _apply_recurrence_penalty(
+        next_token_scores: torch.Tensor,
+        token_ids: list[int],
+        penalty: float,
+    ) -> torch.Tensor:
+        """Make every repeated token less likely without reversing negative logits."""
+        if penalty <= 0:
+            raise ValueError("recurrence_penalty must be greater than zero")
+        if penalty == 1.0 or len(token_ids) == 0:
+            return next_token_scores
+
+        repeated_scores = next_token_scores[0, token_ids]
+        if penalty < 1.0:
+            adjusted_scores = torch.where(
+                repeated_scores < 0,
+                repeated_scores / penalty,
+                repeated_scores * penalty,
+            )
+        else:
+            adjusted_scores = torch.where(
+                repeated_scores < 0,
+                repeated_scores * penalty,
+                repeated_scores / penalty,
+            )
+        next_token_scores[0, token_ids] = adjusted_scores
+        return next_token_scores
+
