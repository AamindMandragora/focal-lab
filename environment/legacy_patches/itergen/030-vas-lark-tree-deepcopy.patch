From: VAS baseline harness <vas@local>
Subject: [PATCH] 030 vas lark tree deepcopy

--- a/itergen/syncode/syncode/larkm/tree.py
+++ b/itergen/syncode/syncode/larkm/tree.py
@@ -204,7 +204,15 @@
                     yield c
 
     def __deepcopy__(self, memo):
-        return type(self)(self.data, deepcopy(self.children, memo), meta=self._meta)
+        # Cyclic-safe copy: LALR interactive parsing can stack Trees that share
+        # back-edges; deepcopy(self.children) without memoizing self recurses
+        # until RecursionError (see incremental_parser accepts()/parser_state copy).
+        if id(self) in memo:
+            return memo[id(self)]
+        dup = type(self)(self.data, [], meta=self._meta)
+        memo[id(self)] = dup
+        dup.children = deepcopy(self.children, memo)
+        return dup
 
     def copy(self) -> 'Tree[_Leaf_T]':
         return type(self)(self.data, self.children)
