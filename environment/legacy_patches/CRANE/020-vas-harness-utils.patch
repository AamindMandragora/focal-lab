+def load_manifest_indices(manifest_path: str, split_name: str = "eval") -> List[int]:
+    """Load integer row indices from a tracked train/eval split manifest JSON."""
+    with open(manifest_path, "r", encoding="utf-8") as f:
+        manifest = json.load(f)
+    keys_to_try = []
+    if split_name in ("eval", "test"):
+        keys_to_try.extend(["test_indices", "eval_indices"])
+    keys_to_try.append(f"{split_name}_indices")
+    seen = set()
+    for key in keys_to_try:
+        if key in seen:
+            continue
+        seen.add(key)
+        if key not in manifest:
+            continue
+        indices = manifest[key]
+        if not isinstance(indices, list) or not all(isinstance(i, int) for i in indices):
+            raise ValueError(f"{key} in {manifest_path} must be a list of integers")
+        return list(indices)
+    available = sorted(k for k in manifest if k.endswith("_indices"))
+    raise ValueError(
+        f"Split manifest {manifest_path} has no indices for split {split_name!r}; "
+        f"available: {available}"
+    )
+
+
+def limit_dataset_examples(
+    dataset,
+    *,
+    num_examples: int = -1,
+    manifest_path: Optional[str] = None,
+    split_name: str = "eval",
+):
+    """Select manifest indices first, then optionally cap with ``num_examples``."""
+    if manifest_path:
+        indices = load_manifest_indices(manifest_path, split_name)
+        size = len(dataset)
+        bad = [i for i in indices if i < 0 or i >= size]
+        if bad:
+            raise IndexError(
+                f"Manifest index out of range for dataset size {size}: {bad[:5]}"
+            )
+        dataset = dataset.select(indices)
+    if num_examples > 0:
+        dataset = dataset.take(num_examples)
+    return dataset
+
