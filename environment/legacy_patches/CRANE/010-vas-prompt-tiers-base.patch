 from copy import deepcopy
 
+VAS_TIER_DATASETS = frozenset({"gsm_symbolic", "spider", "smiles"})
+
+
+def _vas_repo_root():
+    """Walk up to verified-agent-synthesis root (contains synthesis/run_synthesis.py)."""
+    here = os.path.dirname(os.path.abspath(__file__))
+    cur = here
+    for _ in range(28):
+        marker = os.path.join(cur, "synthesis", "run_synthesis.py")
+        if os.path.isfile(marker):
+            return cur
+        parent = os.path.dirname(cur)
+        if parent == cur:
+            return None
+        cur = parent
+    return None
+
+
+def _parse_spider_row(row):
+    """Normalize CRANE Spider rows to db_info + plain question for tier templates."""
+    db_info = str(row.get("db_info") or "").strip()
+    qtext = str(row.get("question") or "")
+    if "### Question:" in qtext:
+        if not db_info and "SQL tables information:" in qtext:
+            mid = qtext.split("SQL tables information:", 1)[1]
+            db_info = mid.split("### Question:", 1)[0].strip()
+        question = qtext.split("### Question:", 1)[-1].strip()
+        if question.endswith("SQL:"):
+            question = question[:-4].strip()
+        return {"db_info": db_info, "question": question, "db_id": row.get("db_id", "")}
+    return {"db_info": db_info, "question": qtext.strip(), "db_id": row.get("db_id", "")}
+
+
+def _row_for_vas_prompt(dataset, row):
+    if dataset == "gsm_symbolic":
+        question = str(row.get("question") or "").strip()
+        return {"question_parsed": question, "question": question}
+    if dataset == "spider":
+        return _parse_spider_row(row)
+    if dataset == "smiles":
+        prompt_body = str(row.get("prompt") or "")
+        props = prompt_body.split("Molecule:")[0].split("SMILES:")[0].strip()
+        if props.startswith("Properties:"):
+            props = props.split(":", 1)[1].strip()
+        return {
+            "class_name": row.get("class_name", "smiles"),
+            "smiles_properties": props,
+            "prompt": prompt_body,
+            "prompt_exemplars": row.get("prompt_exemplars", []),
+        }
+    return None
+
