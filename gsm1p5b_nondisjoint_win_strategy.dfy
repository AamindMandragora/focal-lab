// CSD_RATIONALE_BEGIN
// The best result (attempt 2) achieved 42% accuracy and 80% syntax.
// Attempt 4 regressed badly because the per-span token budget with RollbackConstrainedSuffix
// caused 24/50 examples to never close their spans (the rollback + ConfidenceGatedStep
// combination was failing to reach IsCompletePrefix).
//
// Root cause analysis of attempt 4:
// - 24/50 examples: span opened but never closed. The model generates "Let's think step
//   by step. On<<d" - it opens a span then gets stuck generating template variable names
//   like "d1", "n1" etc. which may be valid parser prefixes but never complete.
// - The rollback approach was counterproductive: it reset spanTokensUsed but still
//   couldn't force the parser to IsCompletePrefix.
//
// Key insight from best attempt (attempt 2):
// - Use UnconstrainedChunk with freeChunkSize=15, then force OpenConstrainedSpan.
// - Use ConfidenceGatedStep inside spans (preserves model reasoning).
// - Close immediately when IsCompletePrefix.
//
// Why attempt 4 failed vs attempt 2:
// - Added RollbackConstrainedSuffix which doesn't consume steps but leaves the span
//   open when IsCompletePrefix is false after rollback. The fallback ConfidenceGatedStep
//   then generates another token but the loop keeps hitting the spanTokensUsed >= maxSpanTokens
//   branch, effectively spinning.
// - The maxSpanTokens=15 was too small for complex expressions.
//
// Fix: Return to attempt 2's strategy but fix the syntax issues:
// 1. Keep freeChunkSize=15 and force OpenConstrainedSpan after that.
// 2. Use ConfidenceGatedStep inside spans - no per-span token cap.
// 3. Add a hard span-token cap but only to break out of the span (not rollback).
//    If we hit the cap, force-close by jumping to the close branch.
//    But we can only close if IsCompletePrefix - otherwise we're stuck.
// 4. Better approach: add a per-span token limit. If we exceed it and IsCompletePrefix
//    is false, use TopValidCandidates to check if EOS is available (meaning the parser
//    accepts the current state as completable), and if not, just keep going until
//    IsCompletePrefix or EOS.
//
// Actually the simplest fix: go back to attempt 2 exactly, but reduce freeChunkSize
// to force spans more often, ensuring the final answer span gets closed.
// The problem in attempt 4 was the RollbackConstrainedSuffix + spanTokensUsed cap.
//
// New strategy (minimal delta from best attempt 2):
// 1. freeChunkSize = 10 (slightly smaller to force more spans earlier)
// 2. No per-span token cap (let the parser drive completion)
// 3. Use ConfidenceGatedStep inside spans
// 4. If we're near the end of budget (e.g., steps + 30 > maxSteps) and we're inside
//    a span, keep using ConfidenceGatedStep aggressively until IsCompletePrefix.
// 5. The main issue from attempt 4 was that spans never completed. The solution is
//    to NOT add artificial caps that prevent completion.
//
// Why did attempt 2 get 80% syntax but not 90%?
// Failure modes from attempt 2: syntax_valid_semantic_mismatch=20, no_valid_visible_span=6.
// The 6 no-valid-visible-span cases are the unterminated spans.
// The 20 syntax_valid_semantic_mismatch means the spans exist but wrong content.
//
// For this attempt, focus on:
// 1. Ensuring spans always close (primary problem from attempt 4).
// 2. Return to attempt 2's structure exactly.
// 3. Slightly smaller freeChunkSize to get more spans in.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Free-chunk branch (!insideConstrainedOut, UnconstrainedChunk): insideConstrainedOut
//     remains false so the implication is vacuous. If stoppedOnOpenSpan, we call
//     EnterObservedConstrainedSpan which sets currentConstrainedOut := [], valid by
//     parser.IsValidPrefix([]) precondition.
//   OpenConstrainedSpan branch: sets currentConstrainedOut := [], valid by
//     parser.IsValidPrefix([]) precondition. insideConstrainedOut := true.
//   ConfidenceGatedStep branch: postcondition guarantees the returned token t satisfies
//     parser.IsValidPrefix(currentConstrainedOut + [t]) (or t == eosToken).
//     AppendConstrainedToken extends currentConstrainedOut by t, preserving validity.
//   CloseConstrainedSpan branch: requires IsCompletePrefix (checked before call),
//     sets insideConstrainedOut := false, making the implication vacuous after the call.
//
// progress:
//   UnconstrainedChunk: steps += stepsUsed (≥ 1), generated grows by at most stepsUsed
//     tokens (the chunk result is already extended by the helper), so
//     |generated| <= |generatedPrefix| + steps. ✓
//   OpenConstrainedSpan: steps += 1, generated grows by exactly 1 ("<<"). ✓
//   ConfidenceGatedStep: steps += 1, AppendConstrainedToken grows generated by at most 1.
//     So |generated| <= |generatedPrefix| + steps. ✓
//   CloseConstrainedSpan: steps += 1, generated grows by at most 1 (">>"). ✓
//   All branches: |generated| <= |generatedPrefix| + steps is maintained throughout.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve the math word problem step by step. Wrap every arithmetic expression and the final answer inside << >> delimiters. Keep each visible << >> span to a single arithmetic expression, never put prose inside the span, and close the span immediately after the expression. Example: <<3+4>>. Final answer: <<7>>.");

var steps: nat := 0;
var freeChunkSize: nat := 10;
var tokensSinceLastSpan: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if tokensSinceLastSpan >= freeChunkSize && steps + 2 <= maxSteps {
      // Force open a constrained span
      var openGenerated, openInside, openCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openGenerated;
      insideConstrainedOut := openInside;
      currentConstrainedOut := openCurrent;
      steps := steps + 1;
      tokensSinceLastSpan := 0;
    } else {
      // Generate a free chunk, stopping if "<<" appears naturally
      var remainingSteps := maxSteps - steps;
      var chunkSize := freeChunkSize;
      if chunkSize > remainingSteps {
        chunkSize := remainingSteps;
      }
      if chunkSize == 0 {
        break;
      }
      var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed :=
        helpers.UnconstrainedChunk(lm, prompt, generated, chunkSize, "<<", eosToken);
      generated := chunkGenerated;
      steps := steps + stepsUsed;
      tokensSinceLastSpan := tokensSinceLastSpan + stepsUsed;
      if stoppedOnEos {
        break;
      }
      if stoppedOnOpenSpan {
        var enterGenerated, enterInside, enterCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := enterGenerated;
        insideConstrainedOut := enterInside;
        currentConstrainedOut := enterCurrent;
        tokensSinceLastSpan := 0;
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
    tokensSinceLastSpan := 0;
  } else {
    // Inside a constrained span: use ConfidenceGatedStep
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next, wasConstrained := helpers.ConfidenceGatedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;