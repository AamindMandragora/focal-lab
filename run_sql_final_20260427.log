Strategy: // CSD_RATIONALE_BEGIN
// The prior revision proved that a parser-valid SQL prefix can be produced, but
// the evaluation failure pattern (`SELECT <id> <id> ,`) shows the core problem:
// token-by-token constrained decoding was too myopic. It stayed syntactically
// valid yet often chose locally plausible continuations that never assembled a
// full SQL clause structure. In Spider, exact match depends much more on getting
// a complete query skeleton than on delicately steering every single token.
// 
// This revision therefore changes the constrained phase from single-token
// decoding to chunked grammar-symbol decoding with `ConstrainedSymbol`. The
// strategy still opens a constrained SQL span immediately so nearly all budget
// is spent on SQL, but once inside the span it asks the parser-guided helper to
// advance by up to `stepTokenBudget` tokens per outer step. That lets the parser
// complete short structural units such as `SELECT col`, `FROM table`, `WHERE`
// predicates, and closing punctuation in one move, reducing the repeated
// half-formed prefixes seen in evaluation.
// 
// We also add an eager-completion policy: after each chunk, if the parser says
// the constrained prefix is complete, we close the span immediately. If the
// helper reports EOS, we stop immediately as required. This keeps the output to
// a single SQL query while preserving the required `<< >>` delimiters. The net
// effect is a "single constrained SQL span, chunked parser-led expansion,
// immediate close on completion" strategy aimed directly at the observed Spider
// failure mode of syntactically valid but structurally unfinished SQL.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open-span branch, `OpenConstrainedSpan` enters
//   constrained mode with empty constrained content, and `parser.IsValidPrefix([])`
//   holds by precondition. In the constrained-symbol branch,
//   `ConstrainedSymbol` returns a `currentAfter` that remains a parser-valid
//   prefix whether it extends the prefix or leaves it unchanged on EOS; if EOS
//   occurs we break immediately, and if completion is detected then
//   `CloseConstrainedSpan` exits constrained mode so the implication becomes
//   vacuous. In the final close branch, `CloseConstrainedSpan` sets
//   `insideConstrainedOut` false, again making the implication vacuous.
// suffix: After opening, the constrained content is empty, so it is trivially
//   the suffix of `generated`. In the constrained-symbol branch, we rebuild
//   `generated` as the stable prefix before the constrained span plus the new
//   constrained content `currentAfter`; therefore, while still inside
//   constrained mode, the last `|currentAfter|` tokens of `generated` are
//   exactly `currentAfter`. If we then close the span, constrained mode ends and
//   the implication is vacuous.
// cost accounting: `steps` is the only returned cost measure. Each outer-loop
//   iteration increments `steps` exactly once: opening consumes one step, and a
//   constrained-symbol iteration also consumes one step regardless of whether it
//   hits EOS, extends the prefix, or closes afterward. Thus `0 <= steps <=
//   maxSteps` is preserved and `cost := steps` yields `cost <= maxSteps`.
// progress: Before the loop we have `|generated| = |generatedPrefix|`. In the
//   open-span branch, at most one delimiter token is appended, and since
//   `stepTokenBudget >= 1`, after incrementing `steps` the bound
//   `|generated| <= |generatedPrefix| + steps * stepTokenBudget` holds. In the
//   constrained-symbol branch, `ConstrainedSymbol` adds at most
//   `stepTokenBudget` constrained tokens to `currentAfter`; rebuilding
//   `generated` replaces the old constrained suffix with the new one, so the net
//   growth in that iteration is at most `stepTokenBudget`. If we additionally
//   close the span in the same branch, that close appends only the terminating
//   delimiter after completion; we break immediately afterward, and the
//   invariant needed for the next loop head is not re-established because there
//   is no next iteration.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var done := false;

while steps < maxSteps && !done
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant cost == 0
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
    var currentAfter, hitEos, used := helpers.ConstrainedSymbol(
      lm, parser, prompt, currentConstrainedOut, stepTokenBudget, eosToken
    );
    currentConstrainedOut := currentAfter;
    generated := stablePrefix + currentConstrainedOut;
    steps := steps + 1;
    if hitEos {
      done := true;
    } else {
      var complete := parser.IsCompletePrefix(currentConstrainedOut);
      if complete {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        done := true;
      }
    }
  }
}

cost := steps;

