Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy underperformed because it spent many outer steps in
// unconstrained preamble generation and then advanced the SQL span with
// `ConstrainedSymbol`, which is safe but too weakly biased for Spider: it often
// stopped after a short valid prefix such as `SELECT <id>` and never reliably
// completed a full query. The evaluation also showed occasional repetition.
// 
// This revision switches to a "single SQL span first" strategy tailored to
// text-to-SQL. If generation starts outside a constrained span, we immediately
// open one in the first step, ensuring the output contains `<< >>` and that
// nearly all budget is spent on SQL itself rather than on free-form text.
// Inside the span, we decode one constrained token per outer step with
// `ConstrainedStep`, not `ConstrainedSymbol`. This gives finer control and lets
// the parser steer every token, which is a better fit for schema-narrowed SQL.
// As soon as the current prefix is complete, we immediately close the span.
// 
// To address the observed short-prefix and repetition failures, when inside the
// constrained span we first query a small dead-end signal. If the parser reports
// a narrow frontier, we still rely on `ConstrainedStep`, but the strategy keeps
// the loop token-granular so the parser can force disambiguating continuations
// instead of jumping in larger chunks. This sacrifices some speed for much
// better completion behavior on Spider's exact-match objective.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open-span branch, `OpenConstrainedSpan` starts a new
//   constrained region with empty constrained content, and `parser.IsValidPrefix([])`
//   holds by precondition. In the close branch, `CloseConstrainedSpan` returns
//   `insideConstrainedOut = false`, so the implication is vacuous. In the
//   constrained-step branch, `ConstrainedStep` returns either a valid next token
//   or EOS; when a token is appended via `AppendConstrainedToken`, the helper
//   updates `currentConstrainedOut` to a parser-valid prefix.
// suffix: In the open-span branch, the constrained content is empty, so the
//   generated suffix relation holds immediately. In the close branch we leave
//   constrained mode, so the implication is vacuous. In the constrained-step
//   branch, the loop invariant gives that `currentConstrainedOut` is exactly the
//   current suffix of `generated`; `AppendConstrainedToken` appends the chosen
//   valid token both to `generated` and to `currentConstrainedOut`, preserving
//   the suffix equality.
// cost accounting: We maintain `steps` as the exact outer-step counter and keep
//   `cost == 0` inside the loop. Opening a span uses one helper step, closing a
//   span uses one helper step, and each constrained decoding iteration uses one
//   `ConstrainedStep`; therefore every branch increments `steps` by exactly 1
//   and preserves `0 <= steps <= maxSteps`.
// progress: Opening or closing a span appends at most one delimiter token in a
//   step, and since `stepTokenBudget >= 1`, the bound
//   `|generated| <= |generatedPrefix| + steps * stepTokenBudget` is preserved
//   after incrementing `steps` by 1. In the constrained-step branch,
//   `ConstrainedStep` itself does not mutate `generated`; if it returns EOS we
//   stop with no length increase, otherwise `AppendConstrainedToken` appends one
//   token, which is within the per-step budget and preserves the bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant cost == 0
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      var next := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

