Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL is naturally a single constrained SQL segment bracketed by
// delimiters in the generated text. We track three pieces of state: the full
// generated output (`generated`), whether we are currently inside the SQL span
// (`insideConstrainedOut`), and the SQL-only suffix being validated by the
// schema-specialized parser (`currentConstrainedOut`).
//
// Outside the constrained span, we generate in chunks to cheaply pass through
// explanatory/preamble text until either EOS or the open delimiter "<<" is
// reached. Inside the span, we decode one SQL "symbol step" at a time with
// `ConstrainedSymbol`, allowing up to `stepTokenBudget` tokens per outer step;
// this matches SQL's subword-heavy identifiers and keywords better than strict
// token-by-token decoding. As soon as the parser says the current SQL prefix is
// complete, we close the span with `CloseConstrainedSpan`.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-chunk branch, `insideConstrainedOut` remains
//   false unless `stoppedOpen` is true; in that case we set
//   `currentConstrainedOut := []`, which is a valid prefix by precondition.
//   In the complete-prefix branch, `CloseConstrainedSpan` sets
//   `insideConstrainedOut` to false, so the implication becomes vacuous. In the
//   constrained-symbol branch, `ConstrainedSymbol` returns a parser-valid
//   prefix `symbolOut`, and we assign `currentConstrainedOut := symbolOut`.
// suffix: In the outside-chunk branch, when we remain outside the span the
//   implication is vacuous; when `stoppedOpen` is true we have just ended on
//   the opener and set `currentConstrainedOut := []`, so the length-0 suffix of
//   `generated` equals `[]`. In the close branch, `CloseConstrainedSpan`
//   appends the closing delimiter and resets the constrained suffix to `[]`.
//   In the constrained-symbol branch, with `stablePrefix` equal to the old
//   unconstrained prefix, we set `generated := stablePrefix + symbolOut` and
//   `currentConstrainedOut := symbolOut`, so the generated suffix of length
//   `|currentConstrainedOut|` is exactly `currentConstrainedOut`.
// cost accounting: We keep `cost == 0` as a loop invariant and use a separate
//   `steps` counter for the returned cost. Every branch increases `steps` by at
//   least 1 and by no more than the remaining budget: outside-chunk adds the
//   returned `stepsUsed`, close adds 1, constrained-symbol adds 1. Since the
//   loop guard is `steps < maxSteps`, each update preserves `steps <= maxSteps`.
// progress bound: In the outside-chunk branch, `UnconstrainedChunk` appends at
//   most `stepsUsed` tokens and we do `steps := steps + stepsUsed`; because
//   `stepTokenBudget >= 1`, `stepsUsed <= stepsUsed * stepTokenBudget`, so the
//   bound lifts to the new `steps`. In the close branch, at most one token is
//   appended and one token is within one step budget. In the constrained-symbol
//   branch, `symbolOut` extends the old constrained suffix by at most
//   `stepTokenBudget` tokens, so replacing `generated` by
//   `stablePrefix + symbolOut` increases length by at most `stepTokenBudget`
//   while `steps` increases by exactly 1.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var symbolOut, hitEos, symbolStepsUsed := helpers.ConstrainedSymbol(
        lm, parser, constrainedPrompt, currentConstrainedOut, stepTokenBudget, eosToken
      );
      generated := stablePrefix + symbolOut;
      insideConstrainedOut := true;
      currentConstrainedOut := symbolOut;
      steps := steps + 1;
      if hitEos {
        break;
      }
    }
  }
}

