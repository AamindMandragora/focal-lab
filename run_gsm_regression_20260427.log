Strategy: // CSD_RATIONALE_BEGIN
// Math-word-problem CSD with two tracked modes: free-form natural-language
// generation outside delimiters, and parser-validated arithmetic generation
// inside delimiters. The strategy tracks whether it is currently inside a
// constrained span (`insideConstrainedOut`) and the current arithmetic suffix
// inside that span (`currentConstrainedOut`).
//
// Outside a span, it uses chunked unconstrained decoding so the model can
// explain its reasoning naturally until it emits "<<" or EOS. Inside a span,
// it adaptively chooses between a tight one-token constrained step when the
// parser's valid-next set is narrow, and a wider `ConstrainedSymbol` step when
// many continuations are valid. As soon as the parser reports the arithmetic
// prefix is complete, it closes the span with ">>".
//
// This tracked state supports validity because `currentConstrainedOut` always
// mirrors exactly the generated suffix between delimiters, so parser queries
// are made on the true arithmetic prefix. The parser therefore governs only
// the arithmetic expression region, while the model remains unconstrained on
// surrounding natural-language reasoning.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span chunk branch, either we remain outside
//   (implication vacuous) or we enter a span only when stoppedOnOpen is true,
//   setting currentConstrainedOut := [], which is valid by precondition. In
//   the complete-prefix branch, CloseConstrainedSpan sets insideConstrainedOut
//   to false, so the implication becomes vacuous. In the tight constrained
//   branch, ConstrainedStep returns a parser-valid next token (or EOS, which
//   breaks), and AppendConstrainedToken preserves validity. In the wide
//   constrained branch, ConstrainedSymbol returns currentOut that is itself a
//   valid parser prefix.
// suffix: In the outside-span branch, when we stay outside the implication is
//   vacuous; when we enter on "<<", currentConstrainedOut becomes [], and the
//   length-0 suffix of generated matches []. In the complete-prefix branch,
//   CloseConstrainedSpan appends ">>" and resets currentConstrainedOut to [],
//   so the implication is vacuous afterward. In the tight constrained branch,
//   AppendConstrainedToken appends the same token to both generated and
//   currentConstrainedOut. In the wide constrained branch, we keep
//   stablePrefix := generated[..|generated|-|currentConstrainedOut|] and then
//   set generated := stablePrefix + symbolOut and currentConstrainedOut :=
//   symbolOut, so the generated suffix is exactly currentConstrainedOut.
// cost accounting: `cost` is kept at 0 throughout the loop and assigned only
//   once at the end as `steps`. Every non-break branch increases `steps` by the
//   exact amount of generation work performed: +stepsUsed for UnconstrainedChunk,
//   +1 for CloseConstrainedSpan and tight ConstrainedStep, and +stepsUsed for
//   ConstrainedSymbol. Since the loop guard enforces steps < maxSteps and each
//   increment is bounded by the remaining budget passed to the helper, the
//   final assigned cost satisfies cost <= maxSteps.
// progress: Outside-span chunk branch appends at most stepsUsed tokens and then
//   does steps := steps + stepsUsed. CloseConstrainedSpan appends one token and
//   increments steps by 1. Tight constrained branch appends one token exactly
//   when it does not break on EOS, and steps increases by 1. Wide constrained
//   branch replaces the old constrained suffix by a longer valid symbolOut and
//   increases steps by stepsUsed; the helper's symbol budget is capped by the
//   remaining step budget, so linear arithmetic gives
//   |generated| <= |generatedPrefix| + steps after every branch.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var narrowThreshold: nat := 12;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpen, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= narrowThreshold {
        var next := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var remaining: nat := maxSteps - steps;
        var localBudget: nat := stepTokenBudget;
        if remaining < localBudget {
          localBudget := remaining;
        }
        var symbolOut, hitEos, stepsUsed2 := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, localBudget, eosToken
        );
        generated := stablePrefix + symbolOut;
        insideConstrainedOut := true;
        currentConstrainedOut := symbolOut;
        steps := steps + stepsUsed2;
        if hitEos {
          break;
        }
      }
    }
  }
}

