Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy over-biased opening `<<` and then relied on generic
// constrained token generation to make progress inside the span. In evaluation,
// that caused repeated openings with no reliable closure, yielding unterminated
// constrained segments and zero syntax rate. The revised strategy is therefore
// closure-first and conservative:
//
// 1. Outside constrained mode, we only open `<<` when there is enough remaining
//    budget to both open and later close the span. We explicitly reserve one
//    future step for `>>` by requiring at least 3 remaining steps before opening.
// 2. Once inside constrained mode, we never stop while the span is complete if we
//    still have a step available; instead we immediately close with
//    `CloseConstrainedSpan`. This directly addresses the unterminated-span failure.
// 3. If inside constrained mode and only one step remains, we also close
//    immediately when complete; otherwise we break rather than risk ending with an
//    open span.
// 4. While building an incomplete constrained span, we use parser-guided
//    constrained steps and append only non-EOS tokens. We never call
//    `CloseConstrainedSpan` merely because a sampled token resembles `">>"`; we
//    close only from branches where completeness is already known.
// 5. Outside constrained mode, when we do not open, we take a normal
//    unconstrained step and stop immediately on EOS.
//
// This change prioritizes syntactic well-formedness of `<< ... >>` spans over
// aggressive opening, which is the key issue exposed by evaluation.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In outside-mode branches, either UnconstrainedStep keeps us
// outside so the implication is vacuous, or OpenConstrainedSpan enters with an
// empty constrained prefix, which is a valid parser prefix. In inside-mode,
// CloseConstrainedSpan exits constrained mode so the implication becomes
// vacuous; in the append branch, we are in the explicit `!complete` case and
// ConstrainedStep followed by AppendConstrainedToken preserves validity. Break
// branches do not change state.
//
// suffix: Outside unconstrained generation leaves constrained tracking
// unchanged, so the invariant is preserved vacuously; OpenConstrainedSpan adds
// only the opening delimiter and sets the constrained content to empty, so the
// suffix equality holds trivially. In the append branch, AppendConstrainedToken
// appends the same token to generated and currentConstrainedOut, preserving the
// suffix relation. In close branches we leave constrained mode, so the
// implication is vacuous; break branches preserve state.
//
// cost: The only cost-bumping helpers used are UnconstrainedStep,
// OpenConstrainedSpan, ConstrainedStep, and CloseConstrainedSpan. Every branch
// that invokes one increments `steps` by exactly 1 afterward, while query/logit
// helpers do not change helpers.cost. Break branches perform no additional
// cost-bumping action, so helpers.cost <= steps remains true.
//
// progress: Each step-consuming branch appends at most one token to `generated`:
// UnconstrainedStep contributes one token when non-EOS, OpenConstrainedSpan adds
// the opening delimiter, AppendConstrainedToken adds one constrained token, and
// CloseConstrainedSpan adds the closing delimiter. Since each such branch also
// increments `steps` by 1, the bound |generated| <= |generatedPrefix| + steps is
// preserved. Query-only and break branches append nothing, so the bound remains
// valid.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remaining := maxSteps - steps;
    if remaining >= 3 {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, ["<<"], 6.0);
      helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
      var topOutside := helpers.GetHighestLogitToken(lm);
      if topOutside == "<<" {
        var gOpen, iOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
        generated := gOpen;
        insideConstrainedOut := iOpen;
        currentConstrainedOut := cOpen;
        steps := steps + 1;
      } else {
        var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if nextOutside == eosToken {
          break;
        } else {
          generated := generated + [nextOutside];
        }
      }
    } else {
      var nextOutside2 := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextOutside2 == eosToken {
        break;
      } else {
        generated := generated + [nextOutside2];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var gClose, iClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := gClose;
      insideConstrainedOut := iClose;
      currentConstrainedOut := cClose;
      steps := steps + 1;
    } else {
      if steps + 1 >= maxSteps {
        break;
      } else {
        lm.GenerateLogits(prompt + generated);
        helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
        var nextInside := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextInside == eosToken {
          break;
        } else {
          var gApp, iApp, cApp := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, nextInside);
          generated := gApp;
          insideConstrainedOut := iApp;
          currentConstrainedOut := cApp;
        }
      }
    }
  }
}
cost := steps;

