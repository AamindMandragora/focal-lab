Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it could open a constrained span from an
// unconstrained sample and then spend many steps trying to build the arithmetic
// text token-by-token, often reaching the step limit before emitting ">>".
// That caused unterminated spans and zero syntax success. The revised strategy
// therefore makes span handling conservative and completion-oriented:
// outside a span, it only opens one when the model explicitly emits "<<" or a
// token containing "<<"; it does not proactively force openings. Once inside a
// span, it prioritizes closing quickly and safely: if the prefix is complete it
// immediately calls CloseConstrainedSpan; otherwise it asks the parser for the
// number of valid continuations and uses ConstrainedStep to obtain a parser-
// valid next token whenever there is any ambiguity or risk. A fast path appends
// the argmax token only when that token is parser-valid. This design preserves
// parser validity while reducing the chance of wandering inside a span. EOS is
// always terminal, and no closing helper is called unless completeness is known.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span branch, either we stay outside, making
//   the implication vacuous, or we open a span and set currentConstrainedOut to
//   [], which is valid by precondition. In the complete branch, we call
//   CloseConstrainedSpan only after parser.IsCompletePrefix(currentConstrainedOut),
//   and it exits the constrained mode, so the implication is vacuous afterward.
//   In the in-span append branches, AppendConstrainedToken is used only with a
//   token proved valid by IsTokenValidNext or returned by ConstrainedStep, so
//   the new constrained prefix remains valid.
// suffix: When outside a span and remaining outside, there is no obligation.
//   When opening a span, generated gains "<<" while currentConstrainedOut
//   becomes [], so the required suffix of length 0 matches. Closing a complete
//   span resets insideConstrainedOut to false, so the implication is vacuous.
//   In either append branch, AppendConstrainedToken appends the same token to
//   both generated and currentConstrainedOut, preserving the suffix relation.
// cost: The outside raw sampling branch manually increments helpers.cost once
//   after ChooseNextTokenUnconstrained and also increments steps once. The
//   CloseConstrainedSpan and ConstrainedStep branches each use a helper that
//   bumps helpers.cost by 1 internally, and the loop increments steps once in
//   the same iteration. The argmax-valid append branch uses no cost-bumping
//   helper, so after steps increases by 1 the inequality helpers.cost <= steps
//   still holds.
// progress: In the outside branch, we append at most one token to generated and
//   then increment steps by 1. In the close branch, CloseConstrainedSpan
//   appends exactly one token and steps increases by 1. In the append branches,
//   AppendConstrainedToken appends exactly one token and the iteration also
//   increments steps by 1; if EOS is returned by ConstrainedStep we break
//   without changing generated, so the bound remains true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;

    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" || Contains(next, "<<") {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);

      if validCount <= 1 {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated1, appendedInside1, appendedCurrent1 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated1;
          insideConstrainedOut := appendedInside1;
          currentConstrainedOut := appendedCurrent1;
        }
      } else {
        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
        var argmax := helpers.GetHighestLogitToken(lm);
        var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);

        if argmaxValid && argmax != eosToken {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, argmax
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
          steps := steps + 1;
        } else {
          var next2 := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if next2 == eosToken {
            break;
          } else {
            var appendedGenerated3, appendedInside3, appendedCurrent3 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next2
            );
            generated := appendedGenerated3;
            insideConstrainedOut := appendedInside3;
            currentConstrainedOut := appendedCurrent3;
          }
        }
      }
    }
  }
}

cost := steps;

