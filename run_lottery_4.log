Strategy: // CSD_RATIONALE_BEGIN
// The evaluation failures show that merely "managing naturally opened spans"
// is not enough: the model frequently emits `<<` on its own and then drifts into
// invalid parser prefixes that never become complete, leaving the segment
// unterminated. To fix that, this strategy switches to an active, completion-
// oriented policy.
//
// Revised strategy:
// 1. Stay unconstrained until we deliberately decide to open a math span.
// 2. Open only when there is enough remaining budget to both write at least one
//    constrained token and then close the span. Concretely, we require at least
//    3 remaining steps before opening.
// 3. Once outside, we bias toward opening whenever the model's top token is
//    `<<`; otherwise we take a normal unconstrained step. This increases the
//    chance of producing the required delimiters.
// 4. Once inside, never let the model freely improvise. If the constrained
//    prefix is complete, close immediately. Otherwise take a parser-guided
//    constrained step. If that step returns EOS, stop rather than corrupting the
//    state.
// 5. Crucially, if we are inside and the remaining budget is exactly 1, we do
//    not continue: either the prefix is already complete and we spend that last
//    step to close, or we stop. This prevents opening spans that cannot be
//    terminated within budget.
//
// This directly addresses the observed failure mode: every deliberate opening is
// paired with a completion-first inside policy, and openings are suppressed when
// there is not enough budget left to close them.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-open branch, OpenConstrainedSpan returns an
//   empty constrained prefix in constrained mode, and [] is a valid parser
//   prefix. In the outside-unconstrained branch we remain outside, so the
//   implication is vacuous. In the inside-close branch, CloseConstrainedSpan
//   exits constrained mode, again making the implication vacuous. In the
//   inside-append branch, ConstrainedStep chooses a parser-valid next token and
//   AppendConstrainedToken extends currentConstrainedOut with that token, so
//   validity is preserved; break branches do not modify the state.
//
// suffix: In the outside-open branch, the helper appends the opening delimiter
//   to generated while setting currentConstrainedOut to empty, so the empty
//   sequence is trivially the tracked suffix. In the outside-unconstrained and
//   break branches, either we remain outside or state is unchanged, so the
//   invariant is preserved. In the inside-append branch, AppendConstrainedToken
//   appends the same next token to generated and currentConstrainedOut, so the
//   suffix relation is maintained exactly. In the inside-close branch we leave
//   constrained mode, so the implication becomes vacuous.
//
// cost: The only cost-bumping helpers used are UnconstrainedStep,
//   OpenConstrainedSpan, ConstrainedStep, and CloseConstrainedSpan; each bumps
//   helpers.cost by 1 internally, and in the same branch we increment steps by
//   1. Query-only branches and break branches do not change helpers.cost or
//   steps, so helpers.cost <= steps remains true throughout.
//
// progress: Each step-consuming branch appends at most one token to generated:
//   UnconstrainedStep contributes one token, OpenConstrainedSpan contributes the
//   opening delimiter token, ConstrainedStep paired with AppendConstrainedToken
//   contributes one constrained token, and CloseConstrainedSpan contributes the
//   closing delimiter token. Since each such branch also increments steps by 1,
//   |generated| <= |generatedPrefix| + steps is preserved. Branches that break
//   append nothing, so the bound still holds.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remaining := maxSteps - steps;
    if remaining >= 3 {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, ["<<"], 100.0);
      var topToken := helpers.GetHighestLogitToken(lm);
      if topToken == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        steps := steps + 1;
      } else {
        var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if nextOutside == eosToken {
          break;
        } else {
          generated := generated + [nextOutside];
        }
      }
    } else {
      var nextOutside2 := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextOutside2 == eosToken {
        break;
      } else {
        generated := generated + [nextOutside2];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if steps + 1 >= maxSteps {
        break;
      } else {
        var nextInside := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextInside == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, nextInside);
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}
cost := steps;

