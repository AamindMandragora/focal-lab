Strategy: // CSD_RATIONALE_BEGIN
// The evaluation failures show the prior policy was fundamentally misaligned
// with the task: waiting for the model to "naturally" emit `<<` meant that once
// a span opened, the model often produced malformed arithmetic text and never
// reached a valid complete constrained prefix before the step budget ended.
// Every failure was an unterminated constrained segment, and syntax rate was 0%.
//
// Revised strategy:
// 1. Proactively open exactly one constrained span early, rather than waiting for
//    the model to stumble into one. This directly targets the requirement that
//    outputs contain `<< >>`.
// 2. Inside the constrained span, never free-run. Every token is chosen by
//    parser-guided constrained decoding so the span contents stay a valid parser
//    prefix at all times.
// 3. As soon as the constrained prefix is complete, close immediately with `>>`.
//    We do not delay closure, and we never call CloseConstrainedSpan unless
//    completeness is already known.
// 4. Reserve budget for closure: if we are inside and have no step left to both
//    continue and eventually close, we stop rather than risk extending a span
//    that cannot be terminated. This is the key change motivated by the observed
//    unterminated-span failures.
// 5. Outside constrained mode, after the first closed computation we allow normal
//    unconstrained generation for the remaining budget. If we ever see a natural
//    `<<` later, we can enter constrained mode again with an empty tracked prefix,
//    but the main guarantee comes from the proactive first span.
//
// In short, the fix is to force one short, parser-valid computation span and to
// close it at the earliest provable moment, instead of relying on unconstrained
// text to discover and finish arithmetic markup on its own.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the proactive-open branch, OpenConstrainedSpan returns
//   inside with empty constrained content, which is a valid parser prefix. In the
//   outside-unconstrained branch, either we remain outside (vacuous) or a natural
//   opening token moves us inside with currentConstrainedOut := [], again valid.
//   In the inside-complete branch, CloseConstrainedSpan moves outside so the
//   implication is vacuous. In the inside-append branch, ConstrainedStep chooses
//   a parser-valid next token and AppendConstrainedToken extends the constrained
//   prefix while preserving parser validity; if EOS is returned we break without
//   changing state.
//
// suffix: After proactive opening, currentConstrainedOut is empty, so it is the
//   suffix of generated trivially. In the outside-unconstrained branch, remaining
//   outside makes the implication vacuous; entering due to a natural opening also
//   sets the tracked constrained content to empty, so the suffix property holds.
//   In the close branch we move outside, making the implication vacuous. In the
//   append branch, AppendConstrainedToken appends the same token to generated and
//   currentConstrainedOut, so the tracked constrained content remains exactly the
//   suffix of generated.
//
// cost: OpenConstrainedSpan, UnconstrainedStep, ConstrainedStep, and
//   CloseConstrainedSpan each bump helpers.cost by 1 internally, and every branch
//   that calls one of them increments steps by 1 in the same iteration. Query and
//   boolean-check branches do not change helpers.cost. Break branches perform no
//   extra helper-cost changes after the last matched step increment, so
//   helpers.cost <= steps is preserved.
//
// progress: OpenConstrainedSpan appends one delimiter token and we increment
//   steps once, so generated grows by at most one per step. UnconstrainedStep and
//   CloseConstrainedSpan likewise append at most one token each and are paired
//   with one step increment. In the inside-append branch, ConstrainedStep is
//   followed by AppendConstrainedToken, which appends one token to generated after
//   a single step increment. Branches that break do not append, so
//   |generated| <= |generatedPrefix| + steps remains true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;
var openedAny := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !openedAny && steps + 1 < maxSteps {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openedAny := true;
      steps := steps + 1;
    } else {
      var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      } else {
        generated := generated + [nextOutside];
        if nextOutside == "<<" || Contains(nextOutside, "<<") {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          openedAny := true;
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if steps + 1 >= maxSteps {
        break;
      } else {
        var nextInside := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextInside == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, nextInside);
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

