Strategy: // CSD_RATIONALE_BEGIN
// The evaluation failures show that merely reacting to naturally sampled "<<" is
// not enough: once a constrained span opens, the model often emits malformed
// arithmetic and never reaches ">>" before the step limit. To fix that, this
// strategy changes from passive span handling to aggressive completion control.
// Outside constrained mode, if there is enough budget left to both open and
// close a span, the strategy strongly biases toward opening a span immediately;
// this directly targets the requirement that outputs contain << >>. Inside a
// span, it no longer trusts unconstrained argmax for arithmetic text. Instead,
// it uses parser-guided constrained generation almost exclusively, and as soon
// as the constrained prefix is complete it immediately closes with
// CloseConstrainedSpan. This makes every opened span completion-oriented.
//
// The strategy is also budget-aware. It only opens a new constrained span when
// at least two steps remain, because an opening without enough remaining budget
// to close is exactly what caused the observed unterminated segments. If already
// inside a span and only one step remains, it refrains from extending with risky
// raw sampling; the only productive action is to close if complete, otherwise it
// stops rather than making the malformed span longer. EOS is always terminal.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, either we remain outside after an
//   unconstrained step, so the implication is vacuous, or we call
//   OpenConstrainedSpan, which sets currentConstrainedOut to [] and therefore
//   preserves parser validity. In the inside-complete branch, we call
//   CloseConstrainedSpan only after checking completeness, and afterward we are
//   outside constrained mode, so the implication is vacuous. In the inside-
//   incomplete branch, any appended token comes from ConstrainedStep, so
//   AppendConstrainedToken extends the constrained prefix with a parser-valid
//   token and validity is preserved; if EOS is returned we break without state
//   change.
//
// suffix: Outside constrained mode, remaining outside imposes no suffix
//   obligation. If we open a span, generated gains the delimiter while
//   currentConstrainedOut becomes [], so the suffix relation for length 0 holds.
//   If we close a complete span, insideConstrainedOut becomes false, so the
//   implication is vacuous. In the append branch, AppendConstrainedToken appends
//   the same token to generated and currentConstrainedOut, preserving that the
//   generated suffix equals the constrained prefix.
//
// cost: Every iteration that uses UnconstrainedStep, OpenConstrainedSpan,
//   ConstrainedStep, or CloseConstrainedSpan consumes exactly one helper-bumped
//   cost unit, and the loop increments steps by 1 in the same iteration. Branches
//   that break do so immediately after such a helper call or without changing
//   helpers.cost further, so helpers.cost <= steps remains true throughout.
//
// progress: UnconstrainedStep appends at most one token to generated and then we
//   increment steps by 1, preserving |generated| <= |generatedPrefix| + steps.
//   OpenConstrainedSpan and CloseConstrainedSpan each append one delimiter token
//   and are paired with a single step increment, so the bound is preserved.
//   AppendConstrainedToken appends one token after a ConstrainedStep iteration,
//   again matched by one step increment. If EOS causes a break, generated is not
//   extended after that point, so the bound still holds.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if steps + 1 < maxSteps {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, ["<<"], 100.0);
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextOutside == eosToken {
        break;
      } else {
        generated := generated + [nextOutside];
        if nextOutside == "<<" || Contains(nextOutside, "<<") {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if steps + 1 == maxSteps {
        break;
      } else {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var nextInside := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextInside == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, nextInside
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

