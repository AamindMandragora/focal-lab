Strategy: // CSD_RATIONALE_BEGIN
// The observed failures show that merely waiting for the model to choose `<<` is
// not enough. The model often opens a span around variable assignments or other
// non-final algebraic fragments, then continues with prose or leaves the span
// incomplete, hurting both accuracy and syntax. To fix this, the strategy is now
// strongly arithmetic-focused:
//
// 1. Outside constrained mode, we explicitly bias toward opening `<<` whenever
//    there is enough remaining budget, because the task requires arithmetic to
//    appear inside delimiters.
// 2. Once inside constrained mode, we do not simply follow generic parser-guided
//    continuation. Instead, we inspect the constrained prefix and prefer an
//    early close as soon as the arithmetic expression is complete and has
//    reached a minimally substantive length. This reduces long malformed spans
//    like `<<n * frac_1 * f`.
// 3. If the constrained prefix is complete but still very short, we allow one
//    more constrained token; otherwise we close immediately. This balances
//    avoiding trivial spans with avoiding runaway spans.
// 4. Near the budget limit, we close completed spans and otherwise stop rather
//    than appending an interior token that cannot be closed.
// 5. Outside constrained mode, when not opening, we still use ordinary
//    unconstrained generation and honor EOS immediately.
//
// This revision directly targets the evaluation failures by making delimiter use
// deliberate and by shortening arithmetic spans to complete expressions instead
// of variable-definition text.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In outside branches, either we stay outside via
//   UnconstrainedStep or enter via OpenConstrainedSpan with empty constrained
//   content, so validity is vacuous or immediate. In the inside-close branch we
//   exit constrained mode, making the implication vacuous. In the inside-append
//   branch, ConstrainedStep supplies a parser-valid next token and
//   AppendConstrainedToken extends the tracked constrained prefix accordingly,
//   preserving parser validity. Break branches leave the state unchanged.
//
// suffix: Outside-unconstrained leaves constrained tracking unchanged, so the
//   suffix invariant persists vacuously. OpenConstrainedSpan appends only `<<`
//   and sets currentConstrainedOut to empty, so the generated suffix equal to
//   currentConstrainedOut holds trivially. AppendConstrainedToken appends the
//   same token to both generated and currentConstrainedOut, preserving suffix
//   equality. CloseConstrainedSpan leaves constrained mode, so the implication
//   becomes vacuous. Break branches preserve the existing relation.
//
// cost: The only cost-bumping helpers used are UnconstrainedStep,
//   OpenConstrainedSpan, ConstrainedStep, and CloseConstrainedSpan, and every
//   branch using one also increments steps by exactly 1. Query and logit-shaping
//   helpers do not change helpers.cost or steps. Therefore helpers.cost <= steps
//   is maintained in every branch, including breaks where neither changes.
//
// progress: Every step-consuming branch appends at most one token to generated:
//   UnconstrainedStep appends one non-EOS token, OpenConstrainedSpan appends the
//   opening delimiter, AppendConstrainedToken appends one constrained token, and
//   CloseConstrainedSpan appends the closing delimiter. Since each such branch
//   also increments steps by 1, |generated| <= |generatedPrefix| + steps is
//   preserved. Query-only and break branches append nothing, so the bound
//   remains true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remaining := maxSteps - steps;
    if remaining >= 3 {
      lm.GenerateLogits(prompt + generated);
      helpers.BoostTokenLogits(lm, ["<<"], 8.0);
      helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
      var topOutside := helpers.GetHighestLogitToken(lm);
      if topOutside == "<<" {
        var gOpen, iOpen, cOpen := helpers.OpenConstrainedSpan(lm, generated);
        generated := gOpen;
        insideConstrainedOut := iOpen;
        currentConstrainedOut := cOpen;
        steps := steps + 1;
      } else {
        var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if nextOutside == eosToken {
          break;
        } else {
          generated := generated + [nextOutside];
        }
      }
    } else {
      var nextOutside2 := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextOutside2 == eosToken {
        break;
      } else {
        generated := generated + [nextOutside2];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    var clen := |currentConstrainedOut|;
    if complete && clen >= 3 {
      var gClose, iClose, cClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := gClose;
      insideConstrainedOut := iClose;
      currentConstrainedOut := cClose;
      steps := steps + 1;
    } else {
      if steps + 1 >= maxSteps {
        if complete {
          var gClose2, iClose2, cClose2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := gClose2;
          insideConstrainedOut := iClose2;
          currentConstrainedOut := cClose2;
          steps := steps + 1;
        } else {
          break;
        }
      } else {
        lm.GenerateLogits(prompt + generated);
        if complete {
          helpers.BoostTokenLogits(lm, [">>"], 12.0);
        } else {
          helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
        }
        var nextInside := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextInside == eosToken {
          break;
        } else {
