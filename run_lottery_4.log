Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it actively forced `<<` near the start of
// generation and then relied on parser-guided continuation inside the span.
// Empirically, that produced openings like `<<n =` or `<<frac =` almost
// immediately, after which the model stalled and never reached `>>`. The key
// lesson is that for this task we should not enter constrained mode eagerly, and
// we should only do so when the model itself is already signaling an arithmetic
// expression.
//
// Revised strategy:
// 1. Default to ordinary unconstrained generation both outside and inside any
//    inherited constrained span. We never boost `<<` globally.
// 2. Outside constrained mode, we inspect logits and open a constrained span
//    only when the model's highest-logit token is already `<<` and there are at
//    least 3 steps remaining (open, at least one interior token, close). If not,
//    we just take an unconstrained step.
// 3. If unconstrained generation emits EOS, we stop immediately.
// 4. If we start inside a constrained span from the caller, or if we open one,
//    we use a completion-first policy: close immediately when the parser says
//    the current constrained prefix is complete; otherwise take parser-guided
//    constrained steps. If EOS is proposed inside, we stop rather than corrupt
//    the constrained state.
// 5. When inside and there is only one step left, we close if complete;
//    otherwise we stop. This guarantees we never spend the last step on an
//    uncloseable interior token.
// 6. We also suppress opening when the remaining budget is too small, which
//    avoids late unterminated spans.
//
// This directly addresses the observed failures: no more artificial early
// openings, and any actual constrained span is handled conservatively with an
// explicit budget for eventual closure.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-unconstrained branch, we remain outside, so
//   the implication is vacuous. In the outside-open branch, OpenConstrainedSpan
//   enters constrained mode with the helper-managed initial constrained prefix,
//   which is valid. In the inside-close branch, we leave constrained mode, so
//   the implication becomes vacuous. In the inside-append branch,
//   ConstrainedStep returns a parser-valid next token and AppendConstrainedToken
//   extends the constrained prefix accordingly, preserving validity. Break
//   branches leave state unchanged.
//
// suffix: Outside-unconstrained and break branches do not alter constrained-mode
//   tracking, so the invariant is preserved. OpenConstrainedSpan appends only
//   the opening delimiter and sets the tracked constrained content to empty, so
//   the suffix relation holds trivially. AppendConstrainedToken appends the same
//   token to both generated and currentConstrainedOut, preserving exact suffix
//   equality. CloseConstrainedSpan exits constrained mode, making the
//   implication vacuous.
//
// cost: The only cost-bumping helpers used are UnconstrainedStep,
//   OpenConstrainedSpan, ConstrainedStep, and CloseConstrainedSpan, each of
//   which increases helpers.cost by 1 internally; every such branch also does
//   steps := steps + 1. Query-only operations like GenerateLogits and
//   GetHighestLogitToken do not change helpers.cost or steps. Break branches do
//   not change either quantity. Hence helpers.cost <= steps is preserved.
//
// progress: Each step-consuming helper appends at most one token to generated:
//   UnconstrainedStep contributes one token when not EOS, OpenConstrainedSpan
//   contributes the opening delimiter, ConstrainedStep paired with
//   AppendConstrainedToken contributes one interior token, and
//   CloseConstrainedSpan contributes the closing delimiter. Since each such
//   branch also increments steps by exactly 1, the bound
//   |generated| <= |generatedPrefix| + steps is maintained. Break branches append
//   nothing, so the bound remains true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remaining := maxSteps - steps;
    if remaining >= 3 {
      lm.GenerateLogits(prompt + generated);
      var topToken := helpers.GetHighestLogitToken(lm);
      if topToken == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
        steps := steps + 1;
      } else {
        var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if nextOutside == eosToken {
          break;
        } else {
          generated := generated + [nextOutside];
        }
      }
    } else {
      var nextOutside2 := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if nextOutside2 == eosToken {
        break;
      } else {
        generated := generated + [nextOutside2];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if steps + 1 >= maxSteps {
        break;
      } else {
        var nextInside := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextInside == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, nextInside);
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}
cost := steps;

