Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it forced a constrained span almost
// immediately. The parser then steered generation into generic math-expression
// prefixes like `n =` or `frac =`, but with realistic budgets the model often
// never reached a complete parser state and therefore never legally triggered
// CloseConstrainedSpan. That produced both observed failure modes at once:
// opening too early and leaving the span unterminated.
//
// Revised strategy:
// 1. Do not proactively open `<<`. Stay unconstrained for the whole rollout.
//    This directly removes the "entered_constrained_mode_too_early" failure.
// 2. Still detect natural openings produced by the model. If an unconstrained
//    token contains `<<`, we mark that we are inside a constrained span with an
//    empty tracked prefix, preserving the required state relation.
// 3. Once inside, be aggressively conservative: if the constrained prefix is
//    complete, close immediately; otherwise take at most one parser-guided step,
//    and if budget is tight or EOS appears, stop rather than digging deeper.
//    This minimizes the chance of extending an accidental span into a long,
//    uncloseable fragment.
// 4. Because evaluation showed that forced constrained decoding was far worse
//    than ordinary continuation, the main policy is now "never force markup;
//    only manage it safely if it appears naturally."
//
// This is a substantial replacement, not a local tweak: the strategy now
// prioritizes avoiding malformed `<< ...` segments over trying to synthesize one.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-unconstrained branch, if the sampled token
//   does not open a span we remain outside and the implication is vacuous; if it
//   does open a span, we set currentConstrainedOut := [], which is valid because
//   parser.IsValidPrefix([]) holds. In the inside-close branch, CloseConstrainedSpan
//   exits constrained mode so the implication is vacuous. In the inside-append
//   branch, ConstrainedStep returns a parser-valid next token and
//   AppendConstrainedToken preserves validity of the tracked constrained prefix;
//   if EOS is returned we break without changing the state.
//
// suffix: In the outside branch, remaining outside makes the implication
//   vacuous; entering due to a natural opening sets currentConstrainedOut := [],
//   and the empty sequence is trivially a suffix of generated. In the close
//   branch we move outside, so the implication is vacuous. In the append branch,
//   AppendConstrainedToken appends the chosen token to both generated and
//   currentConstrainedOut, preserving the suffix relationship exactly.
//
// cost: Each call to UnconstrainedStep, ConstrainedStep, or CloseConstrainedSpan
//   bumps helpers.cost by 1 internally, and in the same branch we increment
//   steps by 1. Branches that only inspect booleans or break without another
//   helper call do not increase helpers.cost, so helpers.cost <= steps remains
//   true.
//
// progress: UnconstrainedStep appends at most one token to generated and is
//   paired with one increment of steps. CloseConstrainedSpan also appends at
//   most one token and is paired with one step increment. In the inside-append
//   branch, one ConstrainedStep plus AppendConstrainedToken results in at most
//   one additional generated token for one increment of steps. Break branches do
//   not append tokens, so |generated| <= |generatedPrefix| + steps is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if nextOutside == eosToken {
      break;
    } else {
      generated := generated + [nextOutside];
      if nextOutside == "<<" || Contains(nextOutside, "<<") {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      if steps + 1 >= maxSteps {
        break;
      } else {
        var nextInside := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if nextInside == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, nextInside);
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

