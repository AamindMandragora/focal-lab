Strategy: // CSD_RATIONALE_BEGIN
// Revised from the 71%-accuracy baseline with one targeted behavioral change:
// keep the successful delimiter-triggered structure, but make constrained spans
// less likely to drift into long or unfinished arithmetic fragments.
//
// The evaluation failures show two main issues: some spans were left open, and
// some constrained contents kept growing into malformed partial expressions like
// `<< (100 * b` or `<<k * y / 12 / shark!`. Those traces suggest that once a
// span opens, always continuing with the same adaptive sampler can over-generate
// symbolic text instead of finishing a short arithmetic computation.
//
// This version therefore keeps unconstrained generation exactly as in the strong
// baseline, but changes the inside-span policy to be phase-based. Early in a
// constrained span we still use `AdaptiveConstrainedStep` with the caller's
// token groups, which helps write arithmetic structure. Once the span becomes
// moderately long, we switch to plain `ConstrainedStep`, removing the extra
// group bias so the parser-valid distribution can finish naturally. If the span
// becomes long enough that continued growth is more likely to hurt than help,
// we force termination as soon as the parser reports completeness; otherwise we
// still continue one token at a time under parser control. This is a small edit
// to the best prior strategy, aimed specifically at reducing unterminated and
// malformed spans without reintroducing the harmful eager-open bias.
//
// As before, `generated` stores the full output including delimiters, while
// `currentConstrainedOut` stores only the active contents between `<<` and `>>`.
// Inside constrained mode, parser-valid tokens are appended to both in lockstep,
// preserving the suffix relationship; when the constrained prefix is complete,
// we close only through `CloseConstrainedSpan`, never by treating `">>"` as an
// ordinary sampled token.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, either we remain outside a span
//   or we append `"<<"` and set `currentConstrainedOut := []`, which is valid by
//   precondition. In the close branch, `CloseConstrainedSpan` sets
//   `insideConstrainedOut := false`, so the implication is vacuous. In both
//   inside sampling branches, `AdaptiveConstrainedStep` and `ConstrainedStep`
//   guarantee either EOS or a parser-valid next token; on non-EOS,
//   `AppendConstrainedToken` preserves parser validity of the updated prefix.
//
// suffix: In the unconstrained branch, staying outside makes the implication
//   vacuous; entering on `"<<"` sets `currentConstrainedOut := []`, which equals
//   the empty suffix. In the close branch, `insideConstrainedOut` becomes false,
//   so the implication is again vacuous. In each inside append branch,
//   `AppendConstrainedToken` appends the same token to `generated` and
//   `currentConstrainedOut`, preserving exact suffix equality.
//
// cost accounting: We return `cost := steps`, so we maintain `0 <= steps <=
//   maxSteps`. Every non-breaking branch uses exactly one cost-bumping helper:
//   `UnconstrainedStep`, `CloseConstrainedSpan`, `AdaptiveConstrainedStep`, or
//   `ConstrainedStep`; then we do `steps := steps + 1`. Break branches also
//   increment `steps` first when they consumed a decoding step, so returned
//   `cost` matches loop progress and stays within `maxSteps`.
//
// progress bound: In the unconstrained branch, a non-EOS step appends exactly
//   one token and increments `steps` by 1. In the close branch,
//   `CloseConstrainedSpan` appends at most one token and `steps` grows by 1. In
//   the adaptive inside branch, EOS breaks after the increment with no append;
//   otherwise `AppendConstrainedToken` appends exactly one token. In the plain
//   constrained branch, `ConstrainedStep` either breaks on EOS with no append or
//   returns a state with `|generated|` increased by exactly 1; in both cases we
//   increment `steps` by 1 first. Thus every non-breaking branch strictly
//   increases `steps`, satisfying `decreases maxSteps - steps`, and
//   `|generated| <= |generatedPrefix| + steps` is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;
var switchLen: nat := 6;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      if |currentConstrainedOut| < switchLen {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var steppedGenerated, steppedInside, steppedCurrent, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := steppedGenerated;
          insideConstrainedOut := steppedInside;
          currentConstrainedOut := steppedCurrent;
        }
      }
    }
  }
}

cost := steps;

