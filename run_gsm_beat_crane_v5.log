Strategy: // CSD_RATIONALE_BEGIN
// Revised from the 71%-accuracy baseline with one targeted change: keep the
// successful delimiter-triggered design, but make constrained spans easier to
// finish once they have started.
//
// The failed follow-up attempt showed that aggressively biasing `"<<"` outside
// constrained mode was harmful: it opened spans almost immediately, reduced
// syntax rate, and often left spans unterminated. So this version returns to
// the baseline policy outside constrained mode: plain `UnconstrainedStep` with
// no manual opening bias. That preserves the model's ability to write ordinary
// step-by-step text and avoids entering `<< ... >>` too early.
//
// Inside constrained mode, the baseline already closed spans immediately when
// `parser.IsCompletePrefix(currentConstrainedOut)` held. The main targeted edit
// is to strengthen token selection for arithmetic content by using
// `GroupBoostedConstrainedStep` instead of the narrower adaptive heuristic.
// This always applies the caller-provided arithmetic token-group preferences
// before parser masking, which should help the model complete short arithmetic
// expressions more decisively and reduce wandering / unterminated spans, while
// still guaranteeing every non-EOS token is parser-valid.
//
// As before, `generated` stores the full answer including delimiters, while
// `currentConstrainedOut` stores only the active arithmetic contents between
// `<<` and `>>`. When outside constrained mode the tracked constrained prefix is
// empty; when inside constrained mode it exactly matches the suffix of
// `generated` after the opening delimiter. This lets us append parser-valid
// arithmetic tokens to both structures in lockstep and then close the span only
// when the parser says the arithmetic prefix is complete.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if the sampled token is not
//   `"<<"` then we remain outside constrained mode and the implication is
//   vacuous; if it is `"<<"`, we enter constrained mode with
//   `currentConstrainedOut := []`, which is valid by precondition. In the
//   close-span branch, `CloseConstrainedSpan` sets `insideConstrainedOut` to
//   false, so the implication is vacuous afterward. In the inside-span sampling
//   branch, `GroupBoostedConstrainedStep` guarantees `next == eosToken ||
//   parser.IsValidPrefix(currentConstrainedOut + [next])`; on non-EOS,
//   `AppendConstrainedToken` preserves parser validity.
//
// suffix: In the unconstrained branch, staying outside makes the implication
//   vacuous; if we open on `"<<"`, then `currentConstrainedOut` becomes `[]`,
//   which equals the length-0 suffix of `generated`. In the close branch,
//   `insideConstrainedOut` becomes false, so the suffix implication is vacuous.
//   In the inside-span append branch, `AppendConstrainedToken` appends the same
//   token to both `generated` and `currentConstrainedOut`, preserving exact
//   suffix equality.
//
// cost accounting: We return `cost := steps`, so it suffices to maintain
//   `0 <= steps <= maxSteps`. Every non-breaking branch uses exactly one
//   cost-bumping helper: `UnconstrainedStep`, `CloseConstrainedSpan`, or
//   `GroupBoostedConstrainedStep`; then the loop does `steps := steps + 1`.
//   Break branches also increment `steps` first when they consumed a decoding
//   step, so returned cost matches the number of decoding steps used.
//
// progress bound: In the unconstrained branch, a non-EOS step appends exactly
//   one token and increments `steps` by 1, so
//   `|generated| <= |generatedPrefix| + steps` is preserved. In the close-span
//   branch, `CloseConstrainedSpan` appends at most one token and we increment
//   `steps` by 1. In the inside-span sampling branch, EOS breaks immediately
//   after `steps := steps + 1` with no append; otherwise
//   `AppendConstrainedToken` appends exactly one token and `steps` also grows by
//   1. Thus every non-breaking branch strictly increases `steps`, satisfying
//   `decreases maxSteps - steps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.GroupBoostedConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

