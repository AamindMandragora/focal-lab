Generating initial strategy for: Solve math word problems step by step, writing each arithmetic computation inside << >> delimiters.

============================================================
Attempt 1/25
============================================================
Strategy: // CSD_RATIONALE_BEGIN
// Math-step CSD with delimiter-triggered constrained arithmetic spans.
// The strategy tracks the usual generation state (`generated`), whether we are
// currently inside a `<< ... >>` constrained region, and the current contents
// of that region (`currentConstrainedOut`). Inside a constrained span it also
// uses the caller-provided `validTokenGroups` as soft preferences for tokens
// that are useful in arithmetic expressions, via an adaptive constrained
// sampler.
//
// Action choice is driven by three observations: outside a span we generate
// freely so the model can write natural language reasoning; when the token
// `"<<"` appears we enter constrained mode with an empty arithmetic prefix;
// while inside the span, if the parser says the arithmetic prefix is complete
// we close with `">>"`, otherwise we sample the next token from the parser-
// valid set, softly boosted by `validTokenGroups` when the grammar is narrow.
//
// This state supports valid generation because `currentConstrainedOut` always
// mirrors exactly the suffix of `generated` between delimiters, so parser-valid
// updates can be appended to both simultaneously. The parser therefore governs
// every token written inside `<< >>`, ensuring arithmetic computations are
// emitted as valid constrained spans while leaving explanatory text outside the
// delimiters unconstrained.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, the only way we enter a span is
//   after generating `"<<"`; then we set `currentConstrainedOut := []`, which
//   is valid by the precondition `parser.IsValidPrefix([])`. In the close-span
//   branch, `CloseConstrainedSpan` sets `insideConstrainedOut := false`, so the
//   implication becomes vacuous. In the inside-span sampling branch,
//   `AdaptiveConstrainedStep` guarantees `next == eosToken ||
//   parser.IsValidPrefix(currentConstrainedOut + [next])`; on non-EOS we call
//   `AppendConstrainedToken`, whose precondition is exactly that validity fact,
//   so the updated constrained prefix remains parser-valid.
//
// suffix: In the unconstrained branch, if we stay outside then the implication
//   is vacuous; if we enter a span after appending `"<<"`, we set
//   `currentConstrainedOut := []`, and the length-0 suffix of `generated` is
//   `[]`. In the close-span branch, `CloseConstrainedSpan` appends the closing
//   delimiter and resets `currentConstrainedOut` to `[]`, so again the suffix
//   implication is vacuous. In the inside-span append branch,
//   `AppendConstrainedToken` appends the same `next` token to both `generated`
//   and `currentConstrainedOut`, preserving
//   `generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut`.
//
// cost accounting: We return `cost := steps`, so the loop only needs to keep
//   `0 <= steps <= maxSteps`. Every non-breaking branch uses exactly one
//   cost-bumping helper: `UnconstrainedStep`, `CloseConstrainedSpan`, or
//   `AdaptiveConstrainedStep`; after that helper call we do `steps := steps + 1`.
//   Break branches also increment `steps` first when they consumed a decoding
//   step, so the final returned `cost` matches the number of loop steps used
//   and therefore stays within `maxSteps`.
//
// progress bound: In the unconstrained branch, a non-EOS step appends exactly
//   one token to `generated` and then increments `steps` by 1, so
//   `|generated| <= |generatedPrefix| + steps` is preserved. In the close-span
//   branch, `CloseConstrainedSpan` appends at most one token and we increment
//   `steps` by 1, so the same linear bound holds. In the inside-span sampling
//   branch, EOS breaks immediately after `steps := steps + 1` with no append;
//   otherwise `AppendConstrainedToken` appends exactly one token and steps also
//   grows by 1. Thus every non-breaking branch strictly increases `steps`,
//   satisfying `decreases maxSteps - steps`, and the generation-length bound is
//   maintained throughout.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

