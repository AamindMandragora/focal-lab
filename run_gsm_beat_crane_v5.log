Attempt 2/25
============================================================
Strategy: // CSD_RATIONALE_BEGIN
// Revised strategy: reduce malformed arithmetic spans and encourage the model to
// actually emit `<< ... >>` computations during math reasoning, while still
// keeping the proof obligations simple.
//
// The previous version waited for the base model to emit `"<<"` on its own and
// then sampled arithmetic content with only mild group boosting. The trace shows
// that this almost never entered constrained mode, so most outputs stayed fully
// unconstrained; when constrained mode was entered, some spans wandered into bad
// content or were left open. To fix that, this strategy makes two targeted
// changes.
//
// First, outside constrained mode it biases generation toward opening a span
// once enough ordinary text has been produced and no active span exists. It does
// this with a manual unconstrained sampling step: generate logits, strongly
// boost `"<<"`, mildly penalize EOS, then sample. This preserves natural text
// before the computation while making arithmetic delimiters much more likely to
// appear in step-by-step solutions.
//
// Second, inside constrained mode it uses a stricter arithmetic policy. When the
// current constrained prefix is complete, it immediately closes the span using
// `CloseConstrainedSpan`; it never treats a sampled `">>"` token as ordinary
// content. Otherwise it uses `AdaptiveConstrainedStep` with the caller-supplied
// groups, and if the constrained prefix looks narrow / dead-end-prone it
// additionally falls back to a rollback-to-boundary recovery branch that trims
// the constrained suffix to a valid earlier prefix before continuing. Recovery
// consumes a step even though it may append no token, which keeps the loop
// provable and prevents repeated malformed continuations.
//
// Overall, the design aims to increase syntax rate by opening spans more
// reliably and closing them as soon as the parser allows, and to improve answer
// accuracy by forcing arithmetic text inside `<< >>` to remain parser-valid.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
// - Outside-span manual sampling either stays outside, in which case the
//   implication is vacuous, or opens a span exactly when the sampled token is
//   `"<<"`; then `currentConstrainedOut := []`, valid by precondition.
// - In the close branch, `CloseConstrainedSpan` sets `insideConstrainedOut` to
//   false, so the implication is vacuous afterward.
// - In the constrained append branch, `AdaptiveConstrainedStep` guarantees the
//   sampled token is EOS or parser-valid after the current prefix; on non-EOS,
//   `AppendConstrainedToken` preserves parser validity.
// - In the rollback recovery branch, `RollbackToBoundary` returns a valid prefix,
//   and we keep `insideConstrainedOut := true`, so validity is preserved.
//
// suffix:
// - Outside-span manual sampling preserves the invariant vacuously while outside;
//   if `"<<"` is sampled, we append that delimiter to `generated` and set
//   `currentConstrainedOut := []`, so the tracked constrained suffix is the
//   empty suffix.
// - In the close branch, `insideConstrainedOut` becomes false, so the suffix
//   implication is vacuous.
// - In the constrained append branch, `AppendConstrainedToken` appends the same
//   token to both `generated` and `currentConstrainedOut`, preserving exact
//   suffix equality.
// - In the rollback branch, `repaired` is a prefix of the old constrained
//   suffix; trimming exactly `|currentConstrainedOut| - |repaired|` tokens from
//   the end of `generated` restores the suffix relation with `repaired`.
//
// cost accounting:
// - The loop tracks cost with `steps`, and we return `cost := steps`.
// - The outside manual sampling branch calls `ChooseNextTokenUnconstrained` and
//   then manually bumps helper cost; we also do `steps := steps + 1`.
// - The close branch uses `CloseConstrainedSpan`, a cost-bumping helper, then
//   increments `steps` by 1.
// - The constrained sampling branch uses `AdaptiveConstrainedStep`, a
//   cost-bumping helper, then increments `steps` by 1 whether it appends or
//   breaks on EOS.
// - The rollback branch uses only non-bumping helpers, so it explicitly does
//   `steps := steps + 1` after repairing state.
//
// progress:
// - Outside manual sampling appends at most one token and increments `steps` by
//   1, so `|generated| <= |generatedPrefix| + steps` is preserved.
// - Closing a span appends at most one token and increments `steps` by 1.
// - Constrained sampling either breaks after incrementing `steps` by 1 with no
//   append, or appends exactly one token and also increments `steps` by 1.
// - Rollback recovery may shrink `generated`, never enlarge it, and still
//   increments `steps` by 1, so the bound holds trivially. Every non-breaking
//   branch strictly increases `steps`, satisfying `decreases maxSteps - steps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 8;
var openBiasAfter: nat := 8;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    if "<<" in lm.Tokens {
      if |generated| >= |generatedPrefix| + openBiasAfter {
        helpers.BoostTokenLogits(lm, ["<<"], 100.0);
      } else {
        helpers.BoostTokenLogits(lm, ["<<"], 8.0);
      }
    }
    helpers.PenalizeTokenLogits(lm, [eosToken], 3.0);
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var dead := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if dead {
        var repaired := helpers.RollbackToBoundary(parser, currentConstrainedOut, "=");
        generated := generated[..|generated| - (|currentConstrainedOut| - |repaired|)];
        currentConstrainedOut := repaired;
        insideConstrainedOut := true;
        steps := steps + 1;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 6.0, narrowThreshold, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

