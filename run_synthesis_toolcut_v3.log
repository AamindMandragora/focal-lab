Strategy: // CSD_RATIONALE_BEGIN
// Strategy state consists of the full generated output, a flag saying whether we
// are currently inside a << >> arithmetic span, and the currently generated
// constrained substring between the delimiters. Outside a span, generation is
// mostly free, but we proactively open a constrained span when either the model
// emits "<<" directly or the sampled token text contains "<<" so arithmetic
// work is likely beginning. Inside a span, we inspect parser information: if the
// current constrained text is complete we close it immediately; if the parser
// reports a narrow or dead-end region we use ConstrainedStep for a hard-valid
// next token; otherwise we softly bias toward top valid candidates and sample.
// This tracked state lets us maintain that currentConstrainedOut is always a
// parser-valid prefix and exactly matches the suffix of generated that lies
// between the most recent opening delimiter and the current position.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, appending a normal token keeps
//   insideConstrainedOut false, so the implication is vacuous; when we open a
//   span, we set currentConstrainedOut := [], and parser.IsValidPrefix([]) holds
//   by precondition. In the complete-prefix branch, CloseConstrainedSpan resets
//   insideConstrainedOut to false, again making the implication vacuous. In the
//   hard-constrained branch, ConstrainedStep supplies a parser-valid next token
//   (or eosToken, which breaks), and AppendConstrainedToken preserves validity.
//   In the soft-bias branch, we call AppendConstrainedToken only after
//   IsTokenValidNext returns true; the invalid-sample subbranch leaves state
//   unchanged, so validity is preserved.
// suffix: In the unconstrained branch, if we stay outside a span the invariant
//   is vacuous; if we open a span we append "<<" and set currentConstrainedOut
//   to [], whose length-0 suffix matches generated. In the complete-prefix
//   branch, CloseConstrainedSpan appends ">>" and resets currentConstrainedOut
//   to [], so the suffix relation holds trivially. In both constrained append
//   branches, AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut. In the invalid-sample subbranch we do not modify
//   generated or currentConstrainedOut, so the old suffix relation remains true.
// cost: UnconstrainedStep, ConstrainedStep, and CloseConstrainedSpan each bump
//   helpers.cost by 1 internally, and we increment steps by 1 in the same loop
//   iteration. In the soft-bias branch we use ChooseNextTokenUnconstrained, so
//   we manually do helpers.cost := helpers.cost + 1 and also steps := steps + 1.
//   Query helpers and AppendConstrainedToken do not bump helpers.cost, so
//   helpers.cost <= steps is preserved in every branch.
// progress: Each iteration increments steps exactly once. The unconstrained
//   branch appends at most one token to generated; the complete-prefix branch
//   appends only the closing delimiter token; the hard-constrained and soft-bias
//   branches append at most one constrained token, while the invalid-sample
//   subbranch appends none. Therefore |generated| increases by at most 1 per
//   iteration, so |generated| <= |generatedPrefix| + steps is maintained.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" || Contains(next, "<<") {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      if narrow {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var candidates := helpers.TopValidCandidates(
          lm, parser, constrainedPrompt, currentConstrainedOut, 3, eosToken
        );
        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
        helpers.BoostTokenLogits(lm, candidates, 5.0);
        helpers.PenalizeTokenLogits(lm, [">>"], 8.0);
        var next := lm.ChooseNextTokenUnconstrained();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
          if valid {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
          }
        }
      }
    }
  }
}

cost := steps;

