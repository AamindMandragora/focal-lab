Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it could open `<<` from unconstrained
// text and then continue token-by-token inside the constrained region without a
// reliable mechanism to reach and emit the closing `>>` before the step budget
// expired. To fix that, this strategy is deliberately conservative: it never
// opens a constrained span speculatively from ordinary text. Instead, outside a
// span it strongly boosts `<<` only when the model already appears ready to emit
// it, and otherwise generates unconstrained text. Once inside a span, it uses a
// parser-driven policy that prioritizes reaching a complete arithmetic prefix;
// as soon as the prefix is complete, it immediately closes with `>>` on the next
// step. It also avoids sampling invalid interior tokens: if the unconstrained
// argmax is not parser-valid, it falls back directly to `ConstrainedStep`.
// This change directly targets the observed failure mode of unterminated spans:
// opening is rarer, completion is parser-guided, and closure happens eagerly the
// moment completion is detected.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, if no span is opened then
//   insideConstrainedOut remains false and the implication is vacuous; if a span
//   is opened via OpenConstrainedSpan, the helper returns an empty constrained
//   prefix, which is valid by precondition. In the inside-complete branch,
//   CloseConstrainedSpan sets insideConstrainedOut to false, so the implication
//   is vacuous. In the inside-incomplete branches, AppendConstrainedToken is
//   used only after IsTokenValidNext or ConstrainedStep has produced a valid
//   token, so parser validity is preserved.
// suffix: In outside non-opening cases there is no active constrained suffix, so
//   the invariant is vacuous. When OpenConstrainedSpan is used, the active
//   constrained content becomes empty, and the length-0 suffix matches. When
//   CloseConstrainedSpan is used, the active span is removed, so the implication
//   is again vacuous. In constrained append branches, AppendConstrainedToken
//   appends the same token to generated and currentConstrainedOut, preserving
//   the suffix equality.
// cost: Every branch that performs a generation step also increments `steps` by
//   exactly 1. The helpers OpenConstrainedSpan, CloseConstrainedSpan, and
//   ConstrainedStep each bump helpers.cost internally by 1, while the raw
//   ChooseNextToken branch manually increments helpers.cost by 1; pure queries
//   and AppendConstrainedToken do not bump cost. Therefore helpers.cost never
//   exceeds steps.
// progress: Initially generated == generatedPrefix. Each loop iteration
//   increases steps by exactly 1 before any break. The outside raw-sampling
//   branch appends at most one token; OpenConstrainedSpan appends only the
//   opening delimiter; CloseConstrainedSpan appends only the closing delimiter;
//   each AppendConstrainedToken appends exactly one token; EOS appends none.
//   Hence generated grows by at most one token per step, preserving the bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var gClose, inClose, curClose := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := gClose;
      insideConstrainedOut := inClose;
      currentConstrainedOut := curClose;
      steps := steps + 1;
    } else {
      var basePrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(basePrompt + currentConstrainedOut);
      var best := helpers.GetHighestLogitToken(lm);
      var bestValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, best);
      if bestValid && best != eosToken {
        var sampledInside := lm.ChooseNextToken();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;
        if sampledInside == eosToken {
          break;
        } else {
          var sampledInsideValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, sampledInside);
          if sampledInsideValid {
            var gApp1, inApp1, curApp1 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, sampledInside
            );
            generated := gApp1;
            insideConstrainedOut := inApp1;
            currentConstrainedOut := curApp1;
          } else {
            var gApp2, inApp2, curApp2 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, best
            );
            generated := gApp2;
            insideConstrainedOut := inApp2;
            currentConstrainedOut := curApp2;
          }
        }
      } else {
        var forced := helpers.ConstrainedStep(lm, parser, basePrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if forced == eosToken {
          break;
        } else {
          var gApp3, inApp3, curApp3 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, forced
          );
          generated := gApp3;
          insideConstrainedOut := inApp3;
          currentConstrainedOut := curApp3;
        }
      }
    }
  } else {
    lm.GenerateLogits(prompt + generated);
    var top := helpers.GetHighestLogitToken(lm);
    var openScore := helpers.GetTokenLogit(lm, "<<");
    var topScore := helpers.GetTokenLogit(lm, top);
    if top == "<<" || openScore >= topScore - 0.5 {
      var gOpen, inOpen, curOpen := helpers.OpenConstrainedSpan(lm, generated);
      generated := gOpen;
      insideConstrainedOut := inOpen;
      currentConstrainedOut := curOpen;
      steps := steps + 1;
    } else {
      var next := lm.ChooseNextToken();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        insideConstrainedOut := false;
        currentConstrainedOut := [];
      }
    }
  }
}

cost := steps;

