Strategy: // CSD_RATIONALE_BEGIN
// Revised GSM-symbolic strategy. The previous attempt achieved syntax 70.6%
// (above 44% target) but accuracy 17.6% (below 41% target). The dominant
// failure mode was syntax-valid-but-semantically-wrong math expressions
// (e.g. using `/` instead of `//`, dropping variables, mixing currency
// tokens into expressions). One example also timed out at the 90s budget.
// Two focused changes:
// (1) Much more explicit task guidance: spell out Python operators (// for
//     integer division), insist on using every placeholder variable, exclude
//     currency/unit placeholders from math, and require the
//     '<<expression=result>>' form followed by '#### N'. This targets the
//     mode_A/B/D semantic-mismatch and mode_C/E malformed-expression cases.
// (2) Cap the effective step budget at 700 to leave wall-clock headroom
//     (Qwen 1.5B emits roughly 100 ms per token; 900 tokens fills the 90 s
//     budget exactly). This targets mode_F (too_slow).
// Otherwise keep the proven structure: chunked unconstrained outer
// generation that stops on `"<<"`, parser-aware ConfidenceGatedStep inside
// spans, and CloseConstrainedSpan when the parser reports completeness.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Unconstrained-chunk branch: insideConstrainedOut stays false unless the
//     chunk stopped on "<<", in which case EnterObservedConstrainedSpan sets
//     currentConstrainedOut := [], valid by parser.IsValidPrefix([]).
//   - Complete-prefix branch: CloseConstrainedSpan flips insideConstrainedOut
//     to false, making the implication vacuous.
//   - ConfidenceGatedStep branch: helper returns EOS or a parser-valid next
//     token; EOS breaks the loop, otherwise AppendConstrainedToken preserves
//     parser.IsValidPrefix(currentConstrainedOut + [next]).
// progress:
//   - Unconstrained chunk: steps += stepsUsed; chunk postcondition gives
//     |generatedNew| <= |generatedOld| + stepsUsed, preserving
//     |generated| <= |generatedPrefix| + steps.
//   - EnterObservedConstrainedSpan: no token, no step delta, bookkeeping only.
//   - CloseConstrainedSpan: steps += 1, ≤1 token (the ">>") appended.
//   - ConfidenceGatedStep + AppendConstrainedToken: steps += 1, ≤1 visible
//     token appended (EOS path adds none and breaks).
// effMax <= maxSteps, so cost = steps <= effMax <= maxSteps, and
// |generated| <= |generatedPrefix| + steps <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm,
  "You are solving a GSM-symbolic math word problem. The problem uses placeholder variables in curly braces (like {x}, {n}, {t}, {target}). Follow these rules exactly: (1) Identify and use ALL placeholder variables that appear in the problem - do not drop any variable. (2) Show step-by-step reasoning in short, plain English sentences. (3) Wrap every arithmetic step inside << >> using the form <<expression=result>>, for example <<2+3=5>> or <<a*b//c=12>>. (4) Use Python-style operators only: + - * for arithmetic, // for integer division (NEVER use a single / for division - always write // for whole-number division), ** for exponent. (5) Currency symbols, units, and label placeholders (such as {cur}, {unit}, {p}, {currency}) are NOT operands - keep them out of math expressions; only numeric quantity placeholders go inside << >>. (6) Use parentheses to make operator precedence explicit, e.g. <<(a+b)*c=...>>. (7) Your final <<...>> expression must contain the complete answer formula written with the original variable names. (8) After the final <<...>>, output a new line containing '#### ' followed by the final numeric answer. Be concise; do not repeat steps or restate the problem."
);

var effMax: nat := if maxSteps > 700 then 700 else maxSteps;
var steps: nat := 0;

while steps < effMax
  invariant 0 <= steps <= effMax
  invariant effMax <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases effMax - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := effMax - steps;
    var chunkedG, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedG;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      var openedGenerated, openedInside, openedCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
    } else {
      // chunk consumed budget without observing "<<" or EOS
      if steps >= effMax {
        break;
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next, wasConstrained := helpers.ConfidenceGatedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

