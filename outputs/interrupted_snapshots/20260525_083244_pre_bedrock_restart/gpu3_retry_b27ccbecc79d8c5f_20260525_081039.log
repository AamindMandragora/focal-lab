Strategy: // CSD_RATIONALE_BEGIN
// GSM symbolic math word problem strategy. We append task guidance once at the
// start to remind the model to wrap symbolic expressions in << >>. Outside a
// constrained span we generate freely with chunked unconstrained generation
// that breaks on the "<<" delimiter (matching the task contract). When "<<"
// is observed, we enter the constrained span via EnterObservedConstrainedSpan
// (no extra token cost since "<<" was already emitted). Inside the span, we
// use ConfidenceGatedStep so the LM gets to drive when it is already
// parser-compatible, with a hard parser fallback otherwise. As soon as the
// parser reports completeness, we close the span (emitting ">>").
// State tracked:
//   - steps: token-step budget consumed so far
//   - insideConstrainedOut/currentConstrainedOut: span state required by spec
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Unconstrained chunk branch: insideConstrainedOut stays false unless the
//     chunk stopped on "<<", in which case EnterObservedConstrainedSpan sets
//     currentConstrainedOut := [] which is valid by parser.IsValidPrefix([]).
//   - Complete-prefix branch: CloseConstrainedSpan flips insideConstrainedOut
//     to false and clears currentConstrainedOut, making the implication vacuous.
//   - ConfidenceGatedStep branch: the helper returns EOS or a parser-valid
//     next token; the EOS path breaks, and AppendConstrainedToken preserves
//     parser.IsValidPrefix(currentConstrainedOut + [next]).
// progress:
//   - Unconstrained chunk: steps += stepsUsed, |generated| grows by at most
//     stepsUsed (chunk postcondition), preserving |generated| <=
//     |generatedPrefix| + steps.
//   - EnterObservedConstrainedSpan: no token added, steps unchanged - vacuous.
//   - CloseConstrainedSpan: steps += 1, appends at most ">>" (one token).
//   - ConfidenceGatedStep + AppendConstrainedToken: steps += 1, appends at
//     most one token.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve the problem step by step. Wrap every intermediate arithmetic expression and the final numeric answer inside << >> delimiters, for example <<2+3=5>>. After the final boxed expression, write '#### ' followed by the final number.");

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedG, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedG;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      var openedGenerated, openedInside, openedCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
    } else {
      // budget exhausted without finding "<<" or EOS
      if steps >= maxSteps {
        break;
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next, wasConstrained := helpers.ConfidenceGatedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

