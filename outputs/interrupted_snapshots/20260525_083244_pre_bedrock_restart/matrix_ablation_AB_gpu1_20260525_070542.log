Strategy: // CSD_RATIONALE_BEGIN
// GSM-symbolic strategy: math word problems require wrapping intermediate
// symbolic expressions and final answers in << >> delimiters. We use chunked
// unconstrained generation outside spans for efficiency (the model naturally
// emits reasoning prose and "<<" when it reaches an arithmetic expression),
// then switch to parser-controlled constrained generation inside the span.
// Inside the span we use AdaptiveConstrainedStep with group boosting, which
// applies caller-supplied token group preferences when parser branching is
// narrow, while keeping parser validity as the hard authority. When the
// parser reports the span content is complete, we close it (which emits ">>").
// State tracked: insideConstrainedOut flag, currentConstrainedOut span content,
// and a running step counter for budget tracking.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Outside-span (chunk) branch: insideConstrainedOut becomes true only when
//     stoppedOpen holds, at which point we set currentConstrainedOut := [],
//     valid by the method precondition parser.IsValidPrefix([]).
//   - Complete-prefix branch: CloseConstrainedSpan flips insideConstrainedOut
//     to false and sets currentConstrainedOut := [], making the implication
//     vacuous (and consistent with the !inside ==> [] invariant).
//   - AdaptiveConstrainedStep branch: the helper returns either EOS or a
//     parser-valid next token; EOS breaks out, otherwise AppendConstrainedToken
//     preserves parser.IsValidPrefix on the extended currentConstrainedOut.
// progress: |generated| <= |generatedPrefix| + steps.
//   - Chunk branch: |generatedOut| <= |generated| + stepsUsed, and we set
//     steps := steps + stepsUsed, so the bound is preserved.
//   - Complete-prefix branch: CloseConstrainedSpan adds at most 1 token,
//     steps += 1.
//   - Adaptive constrained branch: 1 token-step consumed (including EOS),
//     at most 1 token appended via AppendConstrainedToken, steps += 1.
//   Visible-growth-per-step <= consumed-budget-per-step holds in every branch.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm,
  "Solve the math problem step by step. Wrap every intermediate arithmetic expression and the final answer in << >> delimiters, e.g. <<2+3=5>>. After the last << >> expression, write '#### <answer>'.");

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedG, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedG;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else {
      // Budget exhausted without EOS or open delimiter.
      break;
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

