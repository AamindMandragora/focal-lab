Strategy: // CSD_RATIONALE_BEGIN
// Reverts to the best-known structure (Attempt 1: 4% acc, 79.2% syntax) and
// improves only the task guidance. Attempt 2 regressed by adding penalties on
// in-span tokens (encouraging premature span exit / repetition flight) and a
// misleading worked example (leaked cars-in-parking-lot canonical text into
// reasoning, causing mode_C zero-span outputs). Structural choices:
//   - Outside-span: UnconstrainedChunk consumes free reasoning prose and
//     stops cleanly at "<<" or EOS, amortizing dispatch.
//   - Inside-span: AdaptiveConstrainedStep keeps parser validity as hard
//     authority while applying group boosts only when branching is narrow.
//   - Closing: CloseConstrainedSpan emits ">>" once the parser reports the
//     span content is complete.
// Prompt focuses model on:
//   - keeping {brace} variables literal (Python names, not numbers),
//   - producing a SINGLE final-answer expression wrapped in << >>,
//   - wrapping integer answers in int(...),
//   - emitting "#### <expr>" as the last line so evaluator extraction picks
//     the complete answer rather than an intermediate step.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Chunk branch: insideConstrainedOut becomes true only when stoppedOpen
//     is reported; we then set currentConstrainedOut := [], valid by the
//     method precondition parser.IsValidPrefix([]).
//   - Complete-prefix branch: CloseConstrainedSpan flips insideConstrainedOut
//     to false and clears currentConstrainedOut, making the implication
//     vacuous.
//   - AdaptiveConstrainedStep branch: returns either EOS (break) or a
//     parser-valid next token; AppendConstrainedToken extends
//     currentConstrainedOut while preserving parser.IsValidPrefix.
// progress: |generated| <= |generatedPrefix| + steps.
//   - Chunk branch: |chunkedG| <= |generated| + stepsUsed, and
//     steps := steps + stepsUsed, preserving the bound (EOS counts in
//     stepsUsed but doesn't append visibly).
//   - Close branch: appends at most 1 token; steps += 1.
//   - Constrained step branch: consumes 1 token-step (EOS included) and
//     appends at most 1 token; steps += 1.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm,
  "Solve the math word problem with concise step-by-step reasoning. Variables in {braces} are Python identifiers; keep them literal (do NOT replace them with numbers). After each arithmetic step, wrap that single expression in << >> and close >> immediately. The output MUST end with one final << >> span that contains the complete answer expression in terms of the original {brace} variables, followed by '#### <same expression>' on the last line. If the answer is an integer, wrap it as int(...). Example shape: 'Step X gives <<a+b>>. Step Y gives <<c*d>>. Final: <<int((a+b)*c*d)>>. #### int((a+b)*c*d)'.");

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedG, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedG;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else {
      // Budget exhausted without EOS or open delimiter.
      break;
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

