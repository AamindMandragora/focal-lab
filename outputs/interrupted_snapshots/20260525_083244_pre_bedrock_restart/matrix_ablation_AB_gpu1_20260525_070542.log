Strategy: // CSD_RATIONALE_BEGIN
// GSM-symbolic strategy. Variables appear as {placeholders}; the evaluator
// requires int(expression) for integer answers inside the final << >> span.
// Prior attempt achieved 79% syntax but only 4% accuracy because (a) the
// final expression usually lacked int(...), and (b) inside-span generation
// occasionally fell into repetition loops (e.g. !!!!!), exhausting budget
// before closing. This revision:
//   1) Strengthens task guidance: explicit placeholder semantics, int(...)
//      wrapper for integer answers, a one-line worked example, and the
//      '#### <answer>' trailer.
//   2) Inside spans, uses AdaptiveConstrainedStepWithPenalties so tokens
//      already present in the current span are penalised (breaks !!!!
//      loops), while caller-supplied valid groups still get boosted when
//      parser branching is narrow (<= 12 valid choices).
//   3) Outside spans, keeps UnconstrainedChunk so reasoning prose flows
//      until the model naturally emits "<<".
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Chunk branch: insideConstrainedOut flips to true only on stoppedOpen,
//     and we then set currentConstrainedOut := [], valid by parser.IsValidPrefix([]).
//   - Close branch: CloseConstrainedSpan exits constrained mode, making the
//     implication vacuous (currentConstrainedOut := []).
//   - Inside-span branch: AdaptiveConstrainedStepWithPenalties returns EOS
//     (break) or a parser-valid next token; AppendConstrainedToken then
//     preserves parser.IsValidPrefix on currentConstrainedOut + [next].
// progress: |generated| <= |generatedPrefix| + steps.
//   - Chunk branch: |chunkedG| <= |generated| + stepsUsed; steps += stepsUsed.
//   - Close branch: appends at most 1 token; steps += 1.
//   - Inside-span branch: appends at most 1 token; steps += 1; EOS still
//     consumes the step but appends nothing, which trivially preserves the
//     output-length bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm,
  "Solve the math word problem. Variables in {curly_braces} are Python variable names; keep them literal in your expressions (do not invent numeric values). Reason step by step in plain text. Wrap EVERY intermediate arithmetic computation AND the final answer in << >> delimiters, closing >> right after each short expression. For integer answers, the final expression must use int(...). Worked example: Q: 'A store has {n} packs of {k} pens each; how many pens total?' A: 'Total pens: <<int(n * k)>>. #### int(n * k)'. After the last << >> expression, write '#### <expression>' as the final line. Keep each expression concise and close >> immediately.");

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedG, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedG;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else {
      break;
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStepWithPenalties(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      validTokenGroups, 4.0,
      currentConstrainedOut, 3.0,
      12, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

