Strategy: // CSD_RATIONALE_BEGIN
// GSM-symbolic strategy. State tracked: insideConstrainedOut and
// currentConstrainedOut for span tracking, plus a step counter. Observations
// used: (a) appearance of "<<" in free generation triggers entry into a
// constrained span; (b) parser.IsCompletePrefix marks when a span can close;
// (c) ValidTokenCount selects between single-token ConstrainedStep (narrow
// state, e.g., near a closing ">>") and chunked ConstrainedSymbolInGenerated
// (wide state, e.g., emitting a multi-digit numeric expression). Task guidance
// is appended once to reinforce the contract of wrapping math expressions in
// << >>. Group-boosted soft preferences (from validTokenGroups) bias inside-
// span sampling toward task-appropriate arithmetic tokens while parser validity
// remains the hard authority.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Unconstrained branch: only sets insideConstrainedOut := true when
//     next == "<<", together with currentConstrainedOut := [] which is valid
//     by the method precondition parser.IsValidPrefix([]).
//   - Complete-prefix branch: CloseConstrainedSpan flips insideConstrainedOut
//     to false and currentConstrainedOut := [], making the implication vacuous
//     except for the trivially-true empty case.
//   - Narrow constrained branch: AdaptiveConstrainedStep returns EOS or a
//     parser-valid next token; AppendConstrainedToken extends a valid prefix
//     by a valid token, preserving validity.
//   - Wide constrained (symbol) branch: ConstrainedSymbolInGenerated
//     postcondition guarantees parser.IsValidPrefix(currentOut).
// progress:
//   - Unconstrained, close, and adaptive branches each consume +1 token-step
//     and append at most 1 visible token, so |generated| grows by ≤1 and steps
//     grows by 1.
//   - Symbol branch: stepsUsed counts every consumed token (including rejected
//     suffix or EOS), and visible growth is bounded by stepsUsed; we add
//     stepsUsed to both sides of the inequality.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm,
  "Solve the math problem step by step. Wrap every intermediate arithmetic expression and the final numeric answer inside << and >> delimiters, e.g. <<3*4=12>>. After the final <<...>> answer, conclude. Do not nest delimiters.");

var steps: nat := 0;
var narrowThreshold: nat := 6;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    if validCount <= narrowThreshold {
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    } else {
      var remaining: nat := maxSteps - steps;
      var symbolBudget: nat := if stepTokenBudget == 0 || stepTokenBudget > remaining then remaining else stepTokenBudget;
      if symbolBudget == 0 {
        symbolBudget := 1;
        if symbolBudget > remaining {
          break;
        }
      }
      var symbolGenerated, symbolOut, hitEos, stepsUsed := helpers.ConstrainedSymbolInGenerated(
        lm, parser, constrainedPrompt, generated, currentConstrainedOut, symbolBudget, eosToken
      );
      generated := symbolGenerated;
      currentConstrainedOut := symbolOut;
      steps := steps + stepsUsed;
      if hitEos {
        break;
      }
    }
  }
}

cost := steps;

