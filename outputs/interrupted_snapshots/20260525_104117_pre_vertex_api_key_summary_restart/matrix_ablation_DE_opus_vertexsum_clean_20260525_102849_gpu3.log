Strategy: // CSD_RATIONALE_BEGIN
// Revised GSM-symbolic strategy. Three changes from attempt 1:
// (1) Sharper, example-rich task guidance: instructs the model to use Python
//     floor division "//" for integer answers, use plain variable names (no
//     curly braces around them), and provides a concrete worked example
//     mirroring the dataset's expected formula style.
// (2) Inside constrained spans, use AdaptiveConstrainedStepWithPenalties which
//     boosts valid groups when the parser narrows AND actively penalizes the
//     problem tokens ("!", "{", "}", "?", "\\") that drove the mode_E runaway
//     ("{!!!!!...") and several malformed-span failures from attempt 1.
// (3) Drop the chunked ConstrainedSymbol path. With single-token stepping the
//     parser exerts hard control on every emitted token, so runaway sequences
//     cannot accumulate inside a single helper call.
// Parser validity is the hard authority via the masked step; soft preferences
// and penalties only re-rank already-legal tokens.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Unconstrained branch only flips insideConstrainedOut := true when
//     next == "<<", and sets currentConstrainedOut := [] which is valid by the
//     precondition parser.IsValidPrefix([]).
//   - Complete-prefix branch: CloseConstrainedSpan exits constrained mode,
//     making the inside-implication vacuous.
//   - Constrained step branch: AdaptiveConstrainedStepWithPenalties returns
//     EOS or a parser-valid next token; AppendConstrainedToken extends a valid
//     prefix by a valid token, preserving parser.IsValidPrefix.
// progress:
//   - Each branch consumes exactly +1 token-step and appends at most one
//     visible token, so |generated| <= |generatedPrefix| + steps is preserved
//     and the loop metric maxSteps - steps strictly decreases.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm,
  "Solve the math word problem. Reason briefly in plain prose. For every numeric step and the final answer, wrap a Python expression inside << and >>. Rules: (1) use floor division // (NOT /) whenever the answer must be a whole number such as a count of items, trips, people, or units; (2) write variable names as bare identifiers like m, n, x, t1 WITHOUT curly braces; (3) never put units, words, or '{' '}' inside <<...>>; (4) never nest << >>. Example: 'ratio m:n totaling x teaspoons of sugar+water' gives sugar = <<m*x//(m+n)>>.");

var steps: nat := 0;
var penaltyTokens: seq<Token> := ["!", "{", "}", "?", "\\", "\n\n"];

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStepWithPenalties(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      validTokenGroups, 4.0,
      penaltyTokens, 8.0,
      12, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

