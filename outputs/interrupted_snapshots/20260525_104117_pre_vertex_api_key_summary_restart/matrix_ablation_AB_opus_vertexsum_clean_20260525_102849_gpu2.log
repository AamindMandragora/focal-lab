Strategy: // CSD_RATIONALE_BEGIN
// GSM symbolic math CSD. The strategy tracks (a) whether we are inside a
// `<<...>>` constrained span and (b) the active constrained content. Outside
// spans, we use UnconstrainedChunk so the LM can produce natural-language
// reasoning rapidly and yield control as soon as it naturally emits "<<".
// Inside spans, we use AdaptiveConstrainedStep with caller-supplied token
// groups so that whenever the parser branching narrows, the strategy applies
// soft preference toward grammar-relevant tokens (operators, digits) while
// hard parser validity is always enforced. We prepend an evaluator guidance
// block reminding the model of the << >> delimiter contract before any LM
// call. EOS is honored as terminal in every branch, and complete constrained
// prefixes are closed immediately.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Outside-span chunk branch: insideConstrainedOut flips to true only on
//     stoppedOpen, and we then set currentConstrainedOut := [], which is valid
//     by parser.IsValidPrefix([]). Otherwise insideConstrainedOut stays false
//     and the implication is vacuous.
//   - Complete-prefix branch: CloseConstrainedSpan flips insideConstrainedOut
//     to false, making the implication vacuous.
//   - AdaptiveConstrainedStep branch: the helper returns either EOS (we break)
//     or a parser-valid next token; AppendConstrainedToken preserves validity.
// progress:
//   - Chunk branch: |generatedOut| <= |generated| + stepsUsed and steps grows
//     by stepsUsed, so |generated| <= |generatedPrefix| + steps remains.
//   - Close branch: appends at most 1 token, steps += 1.
//   - Constrained-step branch: appends at most 1 token, steps += 1; even when
//     EOS is sampled and we break, the bound holds because steps was
//     incremented before the break.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(
  lm,
  "Solve the problem step by step. Wrap every intermediate arithmetic expression and the final numeric answer inside << >> delimiters, exactly as in the examples."
);

var steps: nat := 0;
var narrowThreshold: nat := 16;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remaining: nat := maxSteps - steps;
    var chunkBudget: nat := if remaining < 16 then remaining else 16;
    var chunkedG, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedG;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else if stepsUsed == 0 {
      // Defensive: ensure the loop always makes measurable progress.
      break;
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

