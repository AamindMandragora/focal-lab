Strategy: // CSD_RATIONALE_BEGIN
// Revised GSM symbolic CSD. Two main changes from attempt 1:
// (1) Much stronger task-guidance prompt that explicitly directs the model
//     to conclude with one final << >> span containing a single complete
//     formula in the original problem's variables. The prior attempt's
//     guidance let the model emit intermediate steps as the final span,
//     causing the extracted answer to be only a partial computation
//     (the dominant 18/22 failure mode).
// (2) Smaller outside-span chunks (8 tokens) so the strategy yields control
//     more often, keeping wall-clock and step budgets under control, and
//     replacing AdaptiveConstrainedStep with plain ConstrainedStep inside
//     spans so caller-supplied (possibly irrelevant) token groups cannot
//     misdirect inside-span decoding. Plain ConstrainedStep was the
//     baseline pattern with the strongest verified properties for math
//     expression grammars.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Outside-span chunk branch: insideConstrainedOut flips to true only on
//     stoppedOpen, where we then set currentConstrainedOut := [], a valid
//     prefix by parser.IsValidPrefix([]) from the precondition. Otherwise
//     the implication remains vacuous.
//   - Complete-prefix branch: CloseConstrainedSpan flips insideConstrainedOut
//     to false, making the implication vacuous.
//   - ConstrainedStep branch: the helper returns EOS (we break) or a
//     parser-valid next token; AppendConstrainedToken then preserves
//     parser.IsValidPrefix(currentConstrainedOut).
// progress:
//   - Chunk branch: |generatedOut| <= |generated| + stepsUsed (helper
//     postcondition) and steps += stepsUsed, so
//     |generated| <= |generatedPrefix| + steps holds.
//   - Close branch: appends at most 1 visible token, steps += 1.
//   - ConstrainedStep branch: appends at most 1 token, steps += 1; even
//     when EOS is sampled and we break, steps was already incremented.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(
  lm,
  "Solve the math word problem step by step using the exact variable names from the question. After each arithmetic computation, wrap it in << >> delimiters (for example <<a+b>>). Conclude with one final sentence written in exactly this form: 'The answer is <<EXPR>>.' where EXPR is ONE single arithmetic expression composed only of the variables that already appear in the question and integer arithmetic operators (+, -, *, //, %). EXPR must by itself evaluate to the final numeric answer; do NOT use intermediate names like 'total' or 'remaining' inside EXPR. Keep the response concise."
);

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remaining: nat := maxSteps - steps;
    var chunkBudget: nat := if remaining < 8 then remaining else 8;
    var chunkedG, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedG;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else if stepsUsed == 0 {
      break;
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.ConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

