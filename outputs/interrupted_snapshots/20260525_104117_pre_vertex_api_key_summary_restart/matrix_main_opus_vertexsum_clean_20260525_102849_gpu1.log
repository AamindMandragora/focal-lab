Strategy: // CSD_RATIONALE_BEGIN
// GSM math word problems require free natural-language reasoning interleaved
// with arithmetic expressions wrapped in << >> delimiters. The strategy
// tracks (a) whether we are inside a constrained span, (b) the active
// constrained content, and (c) the number of consumed token steps.
//
// Outside a span we use UnconstrainedChunk to generate free reasoning text
// efficiently, breaking early on either EOS or natural emission of "<<".
// If the chunk stops on "<<" we use EnterObservedConstrainedSpan to flip
// state without spending an extra token-step on a forced delimiter.
//
// Inside a span the parser is the hard validity authority. We use a soft
// repetition penalty against tokens already in `generated` (so the model is
// nudged toward producing fresh arithmetic content rather than echoing
// earlier numbers), with parser hard-masking layered on top. When the
// parser reports the constrained content is complete, we close the span,
// returning to free generation for the next sentence/step.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Chunk branch: when stoppedOnOpenSpan we set currentConstrainedOut := [],
//     which is parser-valid by the method precondition parser.IsValidPrefix([]).
//     Otherwise insideConstrainedOut remains false and the implication is vacuous.
//   - Close branch: CloseConstrainedSpan flips insideConstrainedOut to false and
//     clears currentConstrainedOut, making the implication vacuous afterwards.
//   - Constrained-step branch: SafeRepetitionPenaltyStep returns either EOS
//     (we break) or a token preserving parser validity; AppendConstrainedToken
//     then carries that validity into currentConstrainedOut.
// progress:
//   - Chunk branch: postcondition gives |generatedOut| <= |generated| + stepsUsed
//     and we add stepsUsed to steps, preserving the bound.
//   - Close branch: appends at most one ">>" token and steps += 1.
//   - Constrained-step branch: appends at most one token and steps += 1.
//   All branches keep |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedG, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedG;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      var enteredGenerated, enteredInside, enteredCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
      generated := enteredGenerated;
      insideConstrainedOut := enteredInside;
      currentConstrainedOut := enteredCurrent;
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, generated, 1.5, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

