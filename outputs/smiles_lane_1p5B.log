Strategy: // CSD_RATIONALE_BEGIN
// The core problem: the model outputs only "O" inside the constrained span (1 token),
// which is "complete" according to the SMILES parser (a single atom is a valid SMILES),
// but "O" alone is not an isocyanate. The span is then closed immediately.
//
// Root cause: The SMILES parser accepts single-atom SMILES as complete, so
// CloseSpanIfComplete closes the span after just one token. We need to prevent
// premature closure and force the model to generate multi-token isocyanate SMILES.
//
// Fix strategy:
// 1. Use stronger task guidance that explicitly instructs the model to generate
//    O=C=N... pattern (isocyanate core) and avoid single-atom outputs.
// 2. Instead of CloseSpanIfComplete (which fires too early), use a minimum token
//    count before attempting to close. Track tokensInSpan counter.
//    - Don't try to close until at least 5 tokens are in the span.
//    - After 5+ tokens, use CloseSpanIfComplete.
// 3. Use AdaptiveConstrainedStep with strong boosts from validTokenGroups.
//
// The minimum token count approach: we count tokens appended to currentConstrainedOut.
// We skip the CloseSpanIfComplete call until tokensInSpan >= minSpanTokens.
// After minSpanTokens, we call CloseSpanIfComplete each step.
//
// Dafny note: The loop invariant for AppendConstrainedToken requires
// !parser.IsCompletePrefix(currentConstrainedOut). We handle this by checking
// parser.IsCompletePrefix before calling AppendConstrainedToken: if it's complete
// AND we've generated enough tokens, close; if it's complete but not enough tokens,
// we're stuck (can't append, can't ignore) — in this case close anyway.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan sets currentConstrainedOut := [] which satisfies
//      parser.IsValidPrefix([]) by the method precondition.
//   2. In each loop iteration with insideConstrainedOut == true:
//      a. If parser.IsCompletePrefix(currentConstrainedOut): we call
//         CloseConstrainedSpan, which sets insideConstrainedOut := false
//         (making the implication vacuous) and clears currentConstrainedOut := [].
//      b. If !parser.IsCompletePrefix(currentConstrainedOut): we call
//         AdaptiveConstrainedStep, which returns either eosToken or a token t
//         such that parser.IsValidPrefix(currentConstrainedOut + [t]).
//         AppendConstrainedToken extends currentConstrainedOut by [t],
//         preserving the invariant. The precondition !IsCompletePrefix is
//         satisfied because we are in the else branch.
//   3. The !insideConstrainedOut branch has a vacuous implication.
//
// progress:
//   - OpenConstrainedSpan: steps+1, generated grows by 1 ("<<"). Bound preserved.
//   - CloseConstrainedSpan: steps+1, generated grows by 1 (">>"). Bound preserved.
//   - AdaptiveConstrainedStep + AppendConstrainedToken: steps+1 (for the step),
//     generated grows by 1 (one token appended). Bound preserved.
//   - EOS break: steps already incremented by AdaptiveConstrainedStep, no append.
//     Bound trivially preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

if maxSteps == 0 {
  return;
}

// Strong guidance: explicitly tell the model to generate a multi-token isocyanate SMILES
// starting with the isocyanate core O=C=N
var guidance: string := "You must output a valid SMILES string for the isocyanates chemical class. Isocyanates have the functional group N=C=O (isocyanato group). A valid isocyanate SMILES starts with O=C=N followed by a carbon chain or aromatic ring. Examples of the pattern: O=C=NCCCC, O=C=NCc1ccccc1, O=C=NC(C)C. Output only the SMILES string, nothing else. Do not output a single atom. The SMILES must be at least 5 atoms long and contain the N=C=O group.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Open constrained span immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Track number of tokens appended to the constrained span
var tokensInSpan: nat := 0;
if insideConstrained {
  tokensInSpan := |currentConstrained|;
}

// Minimum tokens before we try to close (isocyanate needs at least O=C=N = 5 tokens)
var minSpanTokens: nat := 5;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && tokensInSpan >= minSpanTokens {
    // Span is complete and has enough tokens; close it
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && tokensInSpan < minSpanTokens {
    // Complete but too short - must close anyway (can't append to complete prefix)
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    // Not complete yet; generate next token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      // If we hit EOS but have a complete prefix, close cleanly
      if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
      tokensInSpan := tokensInSpan + 1;
    }
  }
}

cost := steps;

