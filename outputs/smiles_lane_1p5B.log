insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

helpers.AppendTaskGuidance(lm, "Task: output one complete valid SMILES string for a novel acrylate molecule (class: acrylates). The SMILES must contain the acrylate group C=CC(=O)O as a substructure. Examples of acrylate SMILES: C=CC(=O)OCC, C=CC(=O)OCCCC, C=CC(=O)OC(C)CC, C=CC(=O)OCCO, C=C(C)C(=O)OCC, C=CC(=O)OC. Generate ONLY the SMILES string, nothing else.");

