Strategy: // CSD_RATIONALE_BEGIN
// Root cause analysis: The model generates "O" immediately as the first constrained
// token (because "O" is valid per the SMILES parser at position 0), and the parser
// accepts "O" as a complete SMILES (single atom). CloseSpanIfComplete fires on the
// very first check, closing the span with just "O" — which is valid SMILES but not
// an isocyanate.
//
// Key insight from diagnostics:
// - "tiny_span_dominant: yes" — spans contain only 1 token on average
// - "entered_constrained_mode_too_early" — the model immediately opens a span
// - The parser accepts single atoms as complete SMILES, so CloseSpanIfComplete
//   prematurely closes after the first token
//
// Fix strategy:
// 1. Use ConstrainedGeneration which runs until parser completeness OR EOS OR budget,
//    giving the LM a chance to build a full isocyanate SMILES before we check completeness.
//    But ConstrainedGeneration starts from an empty constrained prefix (no open span yet).
//
// 2. Alternative: Don't call CloseSpanIfComplete until we have at least enough tokens
//    to form an isocyanate (minimum ~5 tokens: O=C=NC). Track token count and only
//    attempt close after a minimum length threshold.
//
// 3. Use AppendTaskGuidance to strongly prime the model toward O=C=N patterns.
//    The guidance must come BEFORE the model generates any tokens so the LM is
//    conditioned correctly.
//
// 4. Use AdaptiveConstrainedStep with strong group boosts for the isocyanate pattern.
//    The validTokenGroups from the caller may already contain SMILES-relevant groups.
//
// 5. Critically: add a minimum token count guard before CloseSpanIfComplete.
//    An isocyanate SMILES needs at minimum "O=C=N" + one substituent = 5+ tokens.
//    We enforce at least 6 constrained tokens before allowing close.
//
// 6. Use SafeRepetitionPenaltyStep to discourage the model from outputting just "O"
//    (which appears in prompt context).
//
// 7. For diversity: use AdaptiveConstrainedStep primarily, switching to
//    SafeRepetitionPenaltyStep periodically.
//
// The structure:
// - AppendTaskGuidance with strong isocyanate SMILES instructions  
// - OpenConstrainedSpan
// - Loop: generate tokens, but skip CloseSpanIfComplete until |currentConstrainedOut| >= 6
// - When >= 6 tokens AND parser complete: close span
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan sets currentConstrainedOut := [] which satisfies
//      parser.IsValidPrefix([]) by method precondition.
//   2. In the loop body, we only call CloseSpanIfComplete when
//      |currentConstrainedOut| >= minTokensBeforeClose. When closed == true,
//      insideConstrainedOut becomes false making the implication vacuously true;
//      when closed == false, state is unchanged and the invariant holds by induction.
//   3. AdaptiveConstrainedStep and SafeRepetitionPenaltyStep each guarantee the
//      returned token is either eosToken or parser-valid next. AppendConstrainedToken
//      extends currentConstrainedOut by exactly that token, preserving
//      parser.IsValidPrefix(currentConstrainedOut) by the helper's postcondition.
//
// progress:
//   - OpenConstrainedSpan: costs +1 step, appends 1 token ("<<") to generated.
//     |generated| = |generatedPrefix| + 1 <= |generatedPrefix| + steps. OK.
//   - CloseSpanIfComplete: costs +1 step; when closed appends ">>" (+1 token);
//     when no-op, +0 tokens. Either way |generated| grows by at most 1 per 1 step.
//   - AdaptiveConstrainedStep / SafeRepetitionPenaltyStep: each cost +1 step;
//     AppendConstrainedToken adds +1 to |generated| at +0 steps. So per constrained
//     generation iteration: steps += 1 (for the AdaptiveStep) + 1 (for CloseSpanIfComplete
//     call, which is either a no-op or a close). Total steps += up to 2, generated grows
//     by at most 2. The invariant |generated| <= |generatedPrefix| + steps is preserved.
//   - EOS: no append to generated, steps already incremented. Bound trivially preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Strong guidance to prime the LM for isocyanate SMILES generation
helpers.AppendTaskGuidance(lm, "Task: output exactly one valid SMILES string for a novel isocyanate molecule. Isocyanates have the functional group N=C=O or O=C=N. The SMILES string must contain this group. Example valid isocyanates: O=C=NCCCC (butyl isocyanate), O=C=NC(CC)CC (3-methylpentyl isocyanate), O=C=Nc1ccccc1 (phenyl isocyanate). Generate a new isocyanate SMILES not copied from these examples. Output ONLY the SMILES string.");

var steps: nat := 0;
var minTokensBeforeClose: nat := 5;

// Open the constrained span if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  }

  // Only attempt to close if we have enough tokens for a real isocyanate SMILES
  if |currentConstrainedOut| >= minTokensBeforeClose {
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      break;
    }
    // Not closed; continue generating if budget allows
    if steps >= maxSteps {
      break;
    }
  }

  // Generate next constrained token
  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];

  // Alternate between repetition penalty and adaptive step based on token count
  var next := eosToken;
  if |currentConstrainedOut| % 3 == 0 {
    next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken
    );
  } else {
    next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
    );
  }
  steps := steps + 1;

  if next == eosToken {
    // EOS: try to close if we have enough tokens and parse is complete
    if |currentConstrainedOut| >= minTokensBeforeClose && steps < maxSteps {
      var isComp := parser.IsCompletePrefix(currentConstrainedOut);
      if isComp {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
    }
    break;
  } else {
    var ag, ai, ac := helpers.AppendConstrainedToken(
      lm, parser, generated, currentConstrainedOut, next
    );
    generated := ag;
    insideConstrainedOut := ai;
    currentConstrainedOut := ac;
  }
}

// Final cleanup: if still inside constrained span and parse is complete, close it
if insideConstrainedOut && steps < maxSteps {
  var isComp := parser.IsCompletePrefix(currentConstrainedOut);
  if isComp {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  }
}

cost := steps;

