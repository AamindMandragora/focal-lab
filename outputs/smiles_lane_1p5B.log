Helper policy: helper mask warm-up (0/3 evaluated attempts for bandit)
Strategy: // CSD_RATIONALE_BEGIN
// SMILES chain-extender generation CSD.
// State tracked: generated (full visible output), insideConstrainedOut (whether
// inside a constrained span), currentConstrainedOut (active constrained prefix),
// steps (token budget used), cost (final budget).
//
// Strategy: This task requires generating a single valid SMILES string for a
// chain_extender molecule. We use a fully constrained hidden-chunk approach:
// immediately open a constrained span and use the parser to guide SMILES token
// generation. We use AdaptiveConstrainedStep with group boosting to prefer
// chemically meaningful tokens from validTokenGroups, using repetition penalties
// to avoid copying exemplars. When the parser signals completeness, we close
// the span and stop.
//
// The strategy starts directly in constrained mode (opening the span), runs
// the constrained loop until complete or budget exhausted, then closes the span.
// No free unconstrained prefix is needed since the task contract is a bare SMILES
// string with no surrounding text.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   OpenConstrainedSpan sets insideConstrainedOut := true and currentConstrainedOut := [],
//   which satisfies parser.IsValidPrefix([]) by the method precondition. In the
//   constrained loop body, AdaptiveConstrainedStep returns either EOS or a
//   parser-valid next token (by helper contract). AppendConstrainedToken preserves
//   IsValidPrefix by extending currentConstrainedOut with a valid next token.
//   CloseConstrainedSpan sets insideConstrainedOut := false, making the implication
//   vacuous and clearing currentConstrainedOut := []. SafeRepetitionPenaltyStep
//   similarly returns EOS or a parser-valid token. So every branch preserves the
//   invariant.
// progress:
//   OpenConstrainedSpan costs +1 step and appends one token ("<<") to generated,
//   so |generated| = |generatedPrefix| + 1 after that call, and steps = 1.
//   Each iteration of the constrained loop either: (a) closes the span via
//   CloseConstrainedSpan (+1 step, appends ">>" to generated, so at most +1 visible
//   token per step), or (b) calls AdaptiveConstrainedStep or SafeRepetitionPenaltyStep
//   (+1 step each) and AppendConstrainedToken (+0 steps, +1 visible token) or breaks
//   on EOS (+1 step, +0 visible tokens). In all cases, each iteration increments
//   steps by 1 and grows |generated| by at most 1. So |generated| <=
//   |generatedPrefix| + steps is maintained throughout.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

helpers.AppendTaskGuidance(lm, "Generate a single valid SMILES string for a chain_extender molecule. Output only the SMILES string. Do not copy any example from the prompt. Use functional groups typical of chain extenders such as diols, diamines, or diisocyanates.");

// Open the constrained span immediately since the entire output is the SMILES string.
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

var useRepPenalty: bool := true;
var narrowThreshold: nat := 15;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed; we are done.
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    // Close the constrained span.
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    // Inside constrained span, not yet complete.
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := eosToken;

    if useRepPenalty {
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
    } else {
      next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken);
    }

    steps := steps + 1;

    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
      // Alternate between repetition penalty and adaptive step to balance novelty and validity.
      useRepPenalty := !useRepPenalty;
    }
  }
}

// If we ran out of budget while still inside the span, try to close gracefully.
if insideConstrainedOut && steps < maxSteps {
  if parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    // Roll back to the last complete prefix and close.
    var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
    generated := rg;
    currentConstrainedOut := rc;
    if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
    }
  }
}

cost := steps;

