//    which satisfies `maxSteps == 0 || ...` (first disjunct is true).
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan resets currentConstrainedOut := [] satisfying
//      parser.IsValidPrefix([]) by precondition.
