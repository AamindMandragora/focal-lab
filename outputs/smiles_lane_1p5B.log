Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis: The failure is "entered_constrained_mode_too_early" - the strategy
// opens a constrained span IMMEDIATELY, before any free-text generation. This means
// the hidden parser starts from an empty prefix and the SMILES grammar parser is
// generating token-by-token SMILES. But each span only contains 1 token (tiny_span_rate=100%).
// The issue: CloseSpanIfComplete fires after every single token because the SMILES
// grammar accepts single atoms as complete SMILES. So "O" is valid SMILES and closes
// immediately, then another span opens, etc.
//
// The key insight: the SMILES grammar considers single atoms as complete SMILES.
// We need to prevent premature closure after very short spans. We should:
// 1. Generate a minimum number of tokens before allowing CloseSpanIfComplete.
// 2. Use a token counter to track how many tokens have been added to currentConstrainedOut.
// 3. Only call CloseSpanIfComplete after we have at least ~7 tokens in the constrained span
//    (isocyanates need at minimum ~5 heavy atoms, so ~5-7 SMILES tokens).
// 4. Use AdaptiveConstrainedStep with strong guidance toward N=C=O containing structures.
//
// The hidden parser is controlling SMILES generation. The strategy should:
// - Open one span
// - Generate at least 7 tokens inside before checking completion
// - Close when complete after minimum length
// - Use repetition penalty / adaptive step to diversify
//
// Important: "answer_source: none" in the failure means even when spans close, 
// the answer isn't being extracted. This could be because:
// - Each span is just "O", "C", etc. (single atoms), not full isocyanate SMILES
// - The span content doesn't contain N=C=O
//
// Root fix: enforce a minimum span length before allowing closure.
// We track |currentConstrainedOut| and only call CloseSpanIfComplete when >= minTokens.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - OpenConstrainedSpan sets currentConstrainedOut := [] and insideConstrainedOut := true.
//     parser.IsValidPrefix([]) holds by precondition. Invariant holds.
//   - When minTokens not yet reached: we call AdaptiveConstrainedStep which returns
//     a parser-valid token or eosToken. AppendConstrainedToken preserves
//     parser.IsValidPrefix(currentConstrainedOut). No close attempted.
//   - When minTokens reached: CloseSpanIfComplete either closes (insideConstrainedOut=false,
//     implication vacuous) or is a no-op (state unchanged, invariant preserved by induction).
//   - After close: insideConstrainedOut=false, we break. Invariant holds.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - OpenConstrainedSpan: appends "<<", steps += 1, |generated| += 1. Preserved.
//   - AdaptiveConstrainedStep: steps += 1, AppendConstrainedToken appends 1 token
//     to generated (when not EOS), so |generated| grows by at most 1. Preserved.
//   - CloseSpanIfComplete (closes): steps += 1, appends ">>" (1 token). Preserved.
//   - CloseSpanIfComplete (no-op): steps += 1, |generated| unchanged. Preserved.
//   - EOS: steps += 1 (already counted in the generation helper), no token appended. Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "You are generating a single SMILES string for the isocyanates class. Isocyanates contain the functional group N=C=O (or equivalently O=C=N). A valid isocyanate SMILES must contain N=C=O. Examples: CN=C=O, CCN=C=O, CCCN=C=O, O=C=NCCl, O=C=Nc1ccccc1, CC(C)N=C=O. Generate a novel isocyanate SMILES with N=C=O group and at least 5 heavy atoms. Do not copy the examples exactly.");

var steps: nat := 0;
var minTokensBeforeClose: nat := 6;

// Open constrained span immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span closed, done
    break;
  } else {
    // Only try to close if we've generated enough tokens for a meaningful SMILES
    if |currentConstrainedOut| >= minTokensBeforeClose {
      var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
      steps := steps + 1;
      if closed {
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        break;
      }
      // Not closed yet, continue generating
      if steps < maxSteps {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    } else {
      // Still building up minimum length - just generate constrained tokens
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Final close attempt if we're still inside and parser accepts
if insideConstrainedOut && steps < maxSteps {
  var isComp := parser.IsCompletePrefix(currentConstrainedOut);
  if isComp {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  }
}

cost := steps;

