// outer loop iteration, but two operations happened (CloseSpanIfComplete no-op + ConstrainedStep).
//
// Hmm, but the API says CloseSpanIfComplete costs +0 when span is open. So if we don't
// increment for it when not closing, and increment for ConstrainedStep, that's correct.
//
// But the verified example DOES increment for CloseSpanIfComplete unconditionally. Let me
// re-examine: in the verified example, after CloseSpanIfComplete, steps := steps + 1.
// Then if closed, break. Else, ConstrainedStep is called but steps is NOT incremented again.
// But ConstrainedStep costs +1. And |generated| may grow by 1 (via AppendConstrainedToken).
// So after the else branch: |generated| grew by 1 but steps only grew by 1 (from CloseSpanIfComplete).
// The invariant |generated| <= |generatedPrefix| + steps still holds since |generated|+1 <= |generatedPrefix| + steps+1.
// So the example works because each outer iteration grows both |generated| by at most 1 and steps by 1.
//
// Actually, to be precise: in the else branch of the verified example:
//   CloseSpanIfComplete (0 cost, no-op) -> steps += 1
//   ConstrainedStep (1 cost) -> returns token
//   If not EOS: AppendConstrainedToken -> |generated| += 1
// Per outer iteration: steps += 1, |generated| += at most 1. Invariant preserved.
// But this means we're "charging" the ConstrainedStep cost to the CloseSpanIfComplete step?
// The API says CloseSpanIfComplete costs 0 when not closing. So the example is slightly wrong
// in incrementing steps for CloseSpanIfComplete when it doesn't close. But it's sound because
// it overapproximates cost, and since Dafny sees the increment, it verifies.
//
// For our strategy: let's follow the exact same pattern as the verified example.
// One outer loop: check insideConstrained. If inside, try CloseSpanIfComplete (steps += 1).
// If not closed, do ConstrainedStep (no additional steps increment).
//
// This gives us a sound strategy. The ONLY change from the verified example is:
// - We open the span at the start (not via UnconstrainedStep detecting "<<")
// - The initial state is !insideConstrained, so we immediately open it
//
// For the progress postcondition: when maxSteps > 0, we need cost > 0 or something changed.
// If maxSteps > 0, the first loop iteration either:
//   - Opens span via OpenConstrainedSpan if !insideConstrained (steps += 1, generated changes)
//   - Or enters constrained branch (does CloseSpanIfComplete, steps += 1)
// So cost >= 1 > 0 when maxSteps > 0.
//
// Actually with the verified example pattern using UnconstrainedStep, if maxSteps > 0,
// it always takes at least 1 step. Same here.
//
// Let me use a cleaner structure:
// 1. If maxSteps == 0, return immediately (postcondition: maxSteps == 0 satisfied).
// 2. If !insideConstrainedOut: open span (1 step), then continue to constrained loop.
// 3. Constrained loop: CloseSpanIfComplete (steps += 1 if closed, 0 else),
//    then ConstrainedStep if not closed.
//
// Actually the cleanest is to just use the verified example pattern exactly, but
// where the first "unconstrained" step opens the span instead of using UnconstrainedStep.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   Branch 1 (not inside constrained): OpenConstrainedSpan sets currentConstrainedOut := []
//   and insideConstrainedOut := true. parser.IsValidPrefix([]) holds by precondition.
//   Branch 2 (inside constrained, CloseSpanIfComplete closes):
//   closed == true means insideConstrainedOut := false, implication vacuously true.
//   Branch 3 (inside constrained, not closed): ConstrainedStep returns next with
//   parser.IsValidPrefix(currentConstrainedOut + [next]) when next != eosToken.
//   We also check !parser.IsCompletePrefix(currentConstrainedOut) before AppendConstrainedToken.
//   AppendConstrainedToken preserves parser.IsValidPrefix(currentConstrainedOut) by postcondition.
//   If next == eosToken or isComplete, we break without changing state; invariant preserved.
//
// progress invariant: |generated| <= |generatedPrefix| + steps
//   Branch 1 (not inside): OpenConstrainedSpan appends "<<", so |generated| += 1 and steps += 1.
//   Bound preserved: (|generated|+1) <= (|generatedPrefix| + steps+1).
//   Branch 2 (inside, closed): CloseSpanIfComplete appends ">>" and steps += 1.
//   |generated| grows by at most 1 (the ">>" delimiter), steps grows by 1. Bound preserved.
//   Branch 3 (inside, not closed): steps += 1 for CloseSpanIfComplete (no-op, 0 cost but
//   we charge 1 step conservatively for the ConstrainedStep that follows).
//   AppendConstrainedToken grows |generated| by 1. So per iteration: steps += 1, |generated| += 1.
//   Bound preserved: (|generated|+1) <= (|generatedPrefix| + steps+1).
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate a SMILES string for the isocyanates class. Isocyanates contain the N=C=O group. Example valid isocyanate SMILES: CN=C=O, CCN=C=O, O=C=NCCl, O=C=Nc1ccccc1. Generate a novel isocyanate SMILES containing N=C=O. The molecule should have at least 5 heavy atoms.");

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
    generated := og;
    insideConstrainedOut := oi;
    currentConstrainedOut := oc;
    steps := steps + 1;
  } else {
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    if closed {
      steps := steps + 1;
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // CloseSpanIfComplete was a no-op (0 cost). Now do ConstrainedStep (1 cost).
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
        if isComplete {
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

// Final close attempt if still inside and parser is complete
if insideConstrainedOut && steps < maxSteps {
  var isComp := parser.IsCompletePrefix(currentConstrainedOut);
  if isComp {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  }
}

cost := steps;

