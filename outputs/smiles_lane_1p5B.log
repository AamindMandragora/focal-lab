Strategy: // CSD_RATIONALE_BEGIN
// SMILES acrylate generation CSD.
// State tracked: generated (full output), insideConstrainedOut (span open?),
// currentConstrainedOut (constrained prefix inside span), steps (budget used).
//
// Strategy:
// 1. Append task guidance to steer the model toward novel acrylate SMILES.
// 2. Immediately open a constrained span (no free unconstrained prefix needed,
//    since the output contract is just a single SMILES string).
// 3. Inside the span, use AdaptiveConstrainedStep with the caller-supplied
//    validTokenGroups to prefer chemically relevant tokens while the parser
//    hard-enforces SMILES grammar validity.
// 4. After each token, call CloseSpanIfComplete to eagerly close the span once
//    the SMILES string is a complete parse.
// 5. Once the span is closed, stop generation (we have our molecule).
//
// The hidden parser enforces SMILES grammar, so the constrained chunk will
// always be a syntactically valid SMILES string. The guidance and group boosts
// steer the model toward acrylate-class molecules (CH2=CH-C(=O)-O- scaffold).
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   OpenConstrainedSpan sets insideConstrainedOut := true and currentConstrainedOut := [],
//   which satisfies parser.IsValidPrefix([]) by precondition. In the constrained
//   branch, AdaptiveConstrainedStep returns either EOS or a parser-valid next token.
//   AppendConstrainedToken extends currentConstrainedOut by that token, preserving
//   parser.IsValidPrefix(currentConstrainedOut). CloseSpanIfComplete either:
//   (a) closes the span: sets insideConstrainedOut := false, making the implication
//       vacuously true; or
//   (b) is a no-op: leaves insideConstrainedOut and currentConstrainedOut unchanged,
//       so validity is preserved. Once insideConstrainedOut becomes false, we break,
//       so the closed state is never extended.
//
// progress:
//   OpenConstrainedSpan costs 1 step and appends 1 token ("<<") to generated.
//   Each iteration of the loop costs 1 step via AdaptiveConstrainedStep, and
//   appends at most 1 token to generated (either the constrained token, or nothing
//   on EOS). CloseSpanIfComplete costs 1 step when it closes (appending ">>" at most),
//   and 0 otherwise - but we pair it with the constrained step so the combined cost
//   per loop iteration is at most 2 steps for at most 2 visible tokens. To keep
//   the invariant tight we count each sub-operation's step cost explicitly.
//   Actually: CloseSpanIfComplete is called in the same branch as AdaptiveConstrainedStep,
//   so one loop iteration can cost 2 steps. We track this with steps += 1 per helper call.
//   The invariant |generated| <= |generatedPrefix| + steps holds because each step
//   adds at most 1 visible token.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Append task guidance to steer toward novel acrylate SMILES
helpers.AppendTaskGuidance(lm, "Generate one new valid SMILES string for an acrylate-class molecule. Acrylates contain CH2=CH-C(=O)-O- or similar vinyl ester/acid scaffold. Output only the SMILES string with no explanation.");

// Open the constrained span immediately (the answer is purely the SMILES string)
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed; we're done
    break;
  } else {
    // We are inside the constrained span
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];

    // Use adaptive constrained step with caller-supplied groups
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      validTokenGroups, 4.0, 20, eosToken
    );
    steps := steps + 1;

    if next == eosToken {
      break;
    } else {
      // Append the valid constrained token
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;

      // Try to close the span if it is now complete
      if steps < maxSteps {
        var cg, ci, cc, closed := helpers.CloseSpanIfComplete(
          lm, parser, generated, currentConstrainedOut
        );
        steps := steps + 1;
        if closed {
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
          // Span closed; exit loop
          break;
        }
        // else: span not yet complete, continue
      }
    }
  }
}

cost := steps;

