Strategy: // CSD_RATIONALE_BEGIN
// DIAGNOSIS: The model generates "O" as the first valid SMILES token, and the
// SMILES parser immediately accepts it as a complete prefix (single atom is valid
// SMILES). CloseSpanIfComplete then closes the span immediately, resulting in
// <<O>> every time. 
//
// ROOT CAUSE: The parser accepts single atoms as complete SMILES. We open the
// constrained span right away and the first AdaptiveConstrainedStep picks "O"
// (since isocyanates start with O=C=N), then CloseSpanIfComplete fires.
//
// FIX: Do NOT use CloseSpanIfComplete at all for small spans. Instead:
// 1. Generate tokens until EOS is returned by the step helper (which indicates
//    the parser + LM want to terminate) OR we hit maxSteps.
// 2. Only when EOS is returned (meaning the parser accepts the current
//    currentConstrainedOut as a complete and natural stopping point), call
//    CloseConstrainedSpan if IsCompletePrefix holds.
// 3. Use SafeRepetitionPenaltyStep throughout to avoid copying prompt tokens.
// 4. Enforce a minimum span length of 7 tokens before we allow closure:
//    track tokensInSpan and only break on EOS once tokensInSpan >= 7.
//    If tokensInSpan < 7 and EOS comes, keep generating (don't break).
//
// Wait - the problem is that EOS from ConstrainedStep when the parser is complete
// at a tiny prefix. We need to SUPPRESS EOS when the span is too short.
//
// Better approach: never check IsCompletePrefix inside the loop. Instead, just
// keep generating until:
// (a) EOS is returned AND tokensInSpan >= minTokens AND IsCompletePrefix, OR
// (b) steps budget is exhausted.
// At end of loop (or on budget exhaustion), if IsCompletePrefix, close the span.
//
// This way the model generates many tokens, building up a real isocyanate SMILES
// like O=C=NCCCC before we ever attempt closure.
//
// One more issue: AdaptiveConstrainedStep may return EOS when the parser is at
// a complete state. We need to ignore EOS when tokensInSpan < minTokens.
// After AppendConstrainedToken we must check IsCompletePrefix before trying to
// append more (AppendConstrainedToken precondition: !IsCompletePrefix).
// So the flow is:
//   loop:
//     if IsCompletePrefix AND tokensInSpan >= minTokens: close and break
//     if IsCompletePrefix AND tokensInSpan < minTokens: close anyway (stuck)
//     else: generate next token, if EOS and tokensInSpan < minTokens: skip EOS
//           and re-generate (but we can't re-generate without consuming budget)
//           Actually: just break on EOS regardless but close if complete.
// The real fix: use AdaptiveConstrainedStep which won't return EOS until the
// LM strongly wants to stop. With isocyanate guidance, the LM should generate
// the full O=C=NCCCC pattern before wanting to stop. The issue is the parser
// accepts partial states as complete.
//
// FINAL APPROACH: Use a large minSpanTokens (8). If the parser hits complete
// before minSpanTokens, we're stuck because AppendConstrainedToken requires
// !IsCompletePrefix. But wait - the SMILES parser should only complete at
// syntactically complete SMILES. After "O" the parser is complete. After "O="
// it's not. So if first token is "O", parser is complete at 1 token.
//
// We need to force the model to generate "O=C=N..." from the start.
// Use AppendTaskGuidance to force starting with "O=C=N" pattern.
// Better: manually force the first few tokens.
// Use IsTokenValidNext to check if "O" is valid, "=" is valid after "O", etc.
// Use AppendConstrainedToken to force known-good prefix tokens:
//   Force "O", "=", "C", "=", "N" if they're valid per parser.
// Then continue with AdaptiveConstrainedStep for the R-group.
//
// This is the correct approach: bootstrap the isocyanate core O=C=N by hand,
// then let the model generate the remainder freely under parser constraint.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan resets currentConstrainedOut := [] satisfying
//      parser.IsValidPrefix([]) by precondition.
//   2. Each forced-token step: we call IsTokenValidNext first; only if valid do
//      we call AppendConstrainedToken. AppendConstrainedToken requires
//      parser.IsValidPrefix(currentConstrainedOut) (held by invariant) and
//      !parser.IsCompletePrefix(currentConstrainedOut) (checked before each
//      forced append via the IsCompletePrefix guard). The result satisfies
//      parser.IsValidPrefix(currentConstrainedOut + [token]) which becomes
//      the new currentConstrainedOut.
//   3. In the generation loop: AdaptiveConstrainedStep returns a token t such
//      that parser.IsValidPrefix(currentConstrainedOut + [t]) when t != eosToken.
//      AppendConstrainedToken (called only when !IsCompletePrefix) preserves
//      the invariant. CloseConstrainedSpan when IsCompletePrefix sets
//      insideConstrainedOut := false making the implication vacuous.
//
// progress:
//   - OpenConstrainedSpan: +1 step, +1 to generated ("<<"). Bound preserved.
//   - Each forced IsTokenValidNext: +0 steps, +0 to generated. OK.
//   - Each forced AppendConstrainedToken: +0 steps (token already counted by
//     the OpenConstrainedSpan or previous budget expenditure? No — actually
//     forced tokens don't cost steps since AppendConstrainedToken is free.
//     We must count them: we don't call any generation helper for forced tokens,
//     so steps doesn't increment. But generated grows by 1 for each forced token.
//     This would break |generated| <= |generatedPrefix| + steps!
//   - FIX: For each forced token, increment steps by 1 manually (it represents
//     a logical "token slot" consumed even though we're forcing it).
//     Actually the invariant is |generated| <= |generatedPrefix| + steps.
//     OpenConstrainedSpan appended "<<" (1 token) and steps=1. After that,
//     each forced token appends 1 to generated without a helper call that
//     increments steps. We must increment steps alongside each append.
//   - Generation loop: AdaptiveConstrainedStep +1 step, AppendConstrainedToken
//     +1 to generated if not EOS. CloseConstrainedSpan +1 step, +1 to generated.
//     Bound preserved throughout.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

if maxSteps == 0 {
  return;
}

var guidance: string := "Task: output a single valid SMILES for an isocyanate molecule. Isocyanates contain the O=C=N group. Start the SMILES with O=C=N then add a carbon substituent (alkyl or aryl). Example valid outputs: O=C=NCCCC O=C=NC(C)C O=C=Nc1ccccc1. Output ONLY the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Open constrained span
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Force the isocyanate core tokens: O = C = N
// Each forced token: check IsTokenValidNext, check !IsCompletePrefix, then AppendConstrainedToken
// We increment steps for each forced append to maintain the progress invariant.

var forcedTokens: seq<Token> := ["O", "=", "C", "=", "N"];
var fi: nat := 0;

while fi < |forcedTokens| && steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases |forcedTokens| - fi
{
  var tok := forcedTokens[fi];
  var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
  if isComplete {
    // Can't append more; close span
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  }
  var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, tok);
  if valid {
    var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, tok);
    generated := ag;
    insideConstrainedOut := ai;
    currentConstrainedOut := ac;
    steps := steps + 1;
    fi := fi + 1;
  } else {
    // Forced token not valid - parser rejects this path; stop forcing
    fi := |forcedTokens|;
  }
}

// Now generate the R-group (substituent after N) with AdaptiveConstrainedStep
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Check if complete and we have enough content (at least 7 tokens = O=C=NC or more)
  var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
  var spanLen := |currentConstrainedOut|;

  if isComplete && spanLen >= 7 {
    // Good length and complete; close span
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else if isComplete && spanLen < 7 {
    // Complete but too short; must close (can't append to complete prefix)
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    // Not complete; generate next token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
    );
    steps := steps + 1;

    if next == eosToken {
      // EOS: close if complete, else just break
      if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

cost := steps;

