      if stillValid {
        // Force our desired token instead
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, desiredToken);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
        fi := fi + 1;
      } else {
        // Append what was returned
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
        fi := fi + 1;
      }
    }
  } else {
    // Desired token not valid; skip to main generation loop
    break;
  }
}

// Main generation loop: generate remaining tokens adaptively
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Reserve 2 steps for potential CloseSpanIfComplete + final close
  if steps + 2 >= maxSteps {
    break;
  }

  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  var penaltyTokens2: seq<Token> := [];
  var next := helpers.AdaptiveConstrainedStep(
    lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
  );
  steps := steps + 1;

  if next == eosToken {
    break;
  } else {
    var isComp := parser.IsCompletePrefix(currentConstrainedOut);
    if isComp {
      // Parser says we're complete but got non-EOS; close now
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }

