Strategy: // CSD_RATIONALE_BEGIN
// The previous attempt failed because:
// 1. The constrained span was opened immediately (before any free-text preamble),
//    resulting in "tiny span" outputs like "<<C>>" - just one token.
// 2. The SMILES grammar parser likely requires a full, valid SMILES structure,
//    but the model was cutting off after just one character.
// 3. The answer contract says "hidden parser-guided constrained chunk" - this
//    means we should use ConstrainedGeneration (fully constrained from empty
//    prefix) rather than visible << >> delimiters.
//
// Fix: Use ConstrainedGeneration directly, which runs the full constrained
// generation loop internally, rather than opening a visible span. The task says
// "hidden parser-guided constrained chunk" - so we use the hidden approach
// (no visible << >> delimiters in the output).
//
// Strategy:
// 1. Append task guidance for isocyanate SMILES.
// 2. Use ConstrainedGeneration with the full maxSteps budget to generate a
//    complete, valid SMILES string under parser control from the start.
// 3. ConstrainedGeneration returns a complete parser-accepted sequence.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   We never enter insideConstrained mode in the loop (we use ConstrainedGeneration
//   which handles the constrained prefix internally). The out-parameters
//   insideConstrainedOut and currentConstrainedOut remain at their initial values
//   (insideConstrained=false, currentConstrained=[]). So the invariant
//   !insideConstrainedOut ==> currentConstrainedOut == [] is trivially preserved
//   since we never flip insideConstrainedOut to true.
//
// progress:
//   ConstrainedGeneration costs at most maxSteps token-steps and appends at most
//   maxSteps tokens to generated. Since we call it once with budget (maxSteps - cost),
//   the total |generated| <= |generatedPrefix| + maxSteps is preserved.
//   cost is set to maxSteps (upper bound) satisfying cost <= maxSteps.
//   The progress/change condition is satisfied because generated != generatedPrefix
//   after ConstrainedGeneration (it appends at least one token for the SMILES).
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

if maxSteps == 0 {
  return;
}

var guidance: string := "Generate exactly one valid novel SMILES string for the isocyanates class. Isocyanates contain the N=C=O functional group. Example pattern: R-N=C=O where R is any organic group. Output only the SMILES string, nothing else.";
helpers.AppendTaskGuidance(lm, guidance);

// Use ConstrainedGeneration to produce a complete SMILES from scratch.
// This generates under full parser control without visible delimiters.
var constrainedOut, terminatedByEos := helpers.ConstrainedGeneration(
  lm, parser, prompt, maxSteps - 1, eosToken
);

// Append the constrained output to generated
generated := generatedPrefix + constrainedOut;
cost := maxSteps;

