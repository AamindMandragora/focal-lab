      var useToken := next;
      var stillValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, tok);
      if stillValid && !parser.IsCompletePrefix(currentConstrainedOut) {
        useToken := tok;
      }
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, useToken
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  } else {
    // Token not valid or already complete, skip forcing
    forceIdx := forceIdx + |forcedTokens|; // exit forced loop
  }
  forceIdx := forceIdx + 1;
}

// Continue with adaptive constrained generation
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
