Helper policy: helper mask warm-up (0/3 evaluated attempts for bandit)
Strategy: // CSD_RATIONALE_BEGIN
// SMILES isocyanate CSD strategy.
// State tracked: generated (full output), insideConstrainedOut (span flag),
// currentConstrainedOut (constrained prefix), steps (budget counter).
//
// The strategy works as follows:
// 1. Append task guidance to steer the model toward novel isocyanate SMILES.
// 2. Immediately open a constrained span (no free-text preamble needed since
//    the answer contract is a single SMILES string).
// 3. Inside the span, use AdaptiveConstrainedStep with the caller-supplied
//    validTokenGroups (which may contain SMILES-relevant token families) and
//    a repetition penalty to discourage copying prompt exemplars.
// 4. After each token, check CloseSpanIfComplete; when the parser accepts the
//    span as complete, close it and stop.
// 5. EOS handling: break immediately.
//
// The hidden parser enforces SMILES grammar throughout; the repetition penalty
// discourages re-use of tokens already in generated (which includes prompt
// exemplars for the model's context), and group boosts steer toward valid
// isocyanate scaffolds when the parser is in a narrow state.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - OpenConstrainedSpan resets currentConstrainedOut := [] which satisfies
//     parser.IsValidPrefix([]) by precondition. So the invariant holds after
//     entering the span.
//   - CloseSpanIfComplete: when closed == true, insideConstrainedOut becomes
//     false making the implication vacuous; when closed == false, state is
//     unchanged and the invariant is preserved by induction.
//   - AdaptiveConstrainedStep returns either eosToken or a parser-valid next
//     token. AppendConstrainedToken extends currentConstrainedOut by exactly
//     that token, preserving parser.IsValidPrefix(currentConstrainedOut).
//   - SafeRepetitionPenaltyStep similarly returns eosToken or a parser-valid
//     next token; AppendConstrainedToken preserves validity.
//
// progress:
//   - OpenConstrainedSpan costs 1 step and appends 1 token ("<<") to generated,
//     so |generated| <= |generatedPrefix| + steps is preserved.
//   - CloseSpanIfComplete costs 1 step; when it closes, it appends ">>" (1 token),
//     so |generated| grows by at most 1 and steps grows by 1. When it is a no-op,
//     |generated| is unchanged and steps grows by 1.
//   - AdaptiveConstrainedStep / SafeRepetitionPenaltyStep each cost 1 step;
//     AppendConstrainedToken appends 1 token. So |generated| grows by at most 1
//     per step, preserving the bound.
//   - EOS break: steps already incremented by the helper that produced eosToken,
//     no token appended, bound trivially preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate exactly one novel SMILES string for the isocyanates class (contains N=C=O group). Output only the SMILES string with no explanation, no Markdown, no exemplar copying.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var narrowThreshold: nat := 12;
var useRepPenalty: bool := true;

// Open the constrained span immediately (answer is just the SMILES string)
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed; we are done
    break;
  } else {
    // Try to close if the constrained prefix is already complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      // Span closed successfully; done
      break;
    } else {
      // Still inside span; generate next constrained token
      if steps < maxSteps {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
        var next := eosToken;

        if useRepPenalty {
          next := helpers.SafeRepetitionPenaltyStep(
            lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
          );
        } else {
          next := helpers.AdaptiveConstrainedStep(
            lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
          );
        }
        steps := steps + 1;

        if next == eosToken {
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
          // Alternate between repetition penalty and adaptive step for diversity
          useRepPenalty := !useRepPenalty;
        }
      }
    }
