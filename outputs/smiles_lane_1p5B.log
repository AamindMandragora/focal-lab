Strategy: // CSD_RATIONALE_BEGIN
// SMILES acrylate generation CSD - revised strategy.
//
// Problem diagnosis from prior attempt:
// - "entered_constrained_mode_too_early": the strategy opened a constrained span
//   immediately (via OpenConstrainedSpan) before any free-text generation, so
//   the model produced a single atom "C" inside the span and closed it.
// - The visible span token length was avg 1.00 (tiny_span_dominant: 100%).
// - The actual SMILES string needs to be a multi-token valid SMILES expression.
//
// Fix:
// 1. Use AppendTaskGuidance to steer toward acrylate SMILES.
// 2. Do NOT open the span immediately. Instead, let the model generate freely
//    for a small number of unconstrained tokens, using UnconstrainedChunk to
//    detect when "<<" appears naturally (or until we reach a budget threshold).
// 3. After the free-generation phase, if we haven't entered a span, force open
//    a constrained span and use SafeRepetitionPenaltyStep to generate a diverse
//    SMILES string with the parser keeping it valid.
// 4. Close the span as soon as the parser accepts a complete parse.
//
// The key insight: the model should be allowed to emit some context tokens
// before the constrained span, or alternatively, the span should be opened
// after the model has had a chance to "warm up" on the task context. We use
// a short unconstrained chunk (up to ~5 tokens) before forcing the span open.
//
// Since the task prompt is just "acrylates" and the expected output is a SMILES
// string, the model needs guidance. We use the hidden parser to ensure SMILES
// validity, and use SafeRepetitionPenaltyStep to encourage diversity.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. After UnconstrainedChunk: if stoppedOnOpenSpan is true, the chunk ended
//      with "<<" already in generatedOut. We call EnterObservedConstrainedSpan
//      which sets insideConstrainedOut := true and currentConstrainedOut := [].
//      [] is valid by precondition parser.IsValidPrefix([]).
//      If stoppedOnEos, we break. Otherwise generatedOut has no span open.
//   2. After OpenConstrainedSpan: same as EnterObservedConstrainedSpan,
//      insideConstrainedOut := true and currentConstrainedOut := [].
//   3. In the constrained loop: SafeRepetitionPenaltyStep returns EOS or a
//      parser-valid next token. AppendConstrainedToken extends both generated
//      and currentConstrainedOut while preserving IsValidPrefix.
//      CloseSpanIfComplete checks IsCompletePrefix internally; when closed,
//      insideConstrainedOut := false making the implication vacuous.
//
// progress:
//   UnconstrainedChunk costs stepsUsed <= maxChunkTokens steps and appends
//   stepsUsed tokens to generated (excluding EOS). OpenConstrainedSpan costs 1.
//   Each inner loop iteration: SafeRepetitionPenaltyStep costs 1 step and
//   AppendConstrainedToken appends 1 visible token; CloseSpanIfComplete costs
//   1 step when closing. Total per inner iteration: 2 steps, 1-2 visible tokens.
//   The invariant |generated| <= |generatedPrefix| + steps holds because each
//   step adds at most 1 visible token.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Steer the model toward novel acrylate SMILES structures.
// Acrylates: CH2=CH-C(=O)-O-R pattern. Give examples different from prompt exemplars.
helpers.AppendTaskGuidance(lm, "Output only a valid SMILES string for a novel acrylate-class molecule (contains C=CC(=O)O or C=CC(=O)[O-] scaffold or similar). Do not copy exemplars. Output nothing else.");

// Phase 1: Short unconstrained chunk to let the model warm up.
// Use a small budget of 8 tokens so the model can emit context before the SMILES.
// If it naturally emits "<<", we enter the span via EnterObservedConstrainedSpan.
var maxChunkTokens: nat := 8;
if steps + maxChunkTokens <= maxSteps && !insideConstrainedOut {
  var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, chunkSteps :=
    helpers.UnconstrainedChunk(lm, prompt, generated, maxChunkTokens, "<<", eosToken);
  steps := steps + chunkSteps;
  generated := chunkGenerated;
  if stoppedOnOpenSpan {
    // "<<" is already in generated; enter observed span
    var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := og;
    insideConstrainedOut := oi;
    currentConstrainedOut := oc;
  } else if stoppedOnEos {
    // EOS hit during free generation, exit early
    cost := steps;
  }
}

// Phase 2: If not yet inside a constrained span, force open one.
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 3: Constrained generation inside the span.
// Use SafeRepetitionPenaltyStep to encourage structural diversity.
// Use AdaptiveConstrainedStep with validTokenGroups for group guidance.
// After each token, try CloseSpanIfComplete to eagerly close when done.
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed, we're done
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    // Already complete, close the span
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
    );
    steps := steps + 1;

    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;

      // Eagerly close span if complete (costs 1 step when it closes)
      if steps < maxSteps {
        var cg2, ci2, cc2, closed := helpers.CloseSpanIfComplete(
          lm, parser, generated, currentConstrainedOut
        );
        steps := steps + 1;
        if closed {
          generated := cg2;
          insideConstrainedOut := ci2;
          currentConstrainedOut := cc2;
          break;
        }
      }
    }
  }
}

cost := steps;

