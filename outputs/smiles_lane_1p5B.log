Strategy: // CSD_RATIONALE_BEGIN
// The core failure is "entered_constrained_mode_too_early": the LM immediately
// outputs "C" inside the constrained span (a tiny/minimal SMILES) and the span
// closes right away. The generated SMILES is just "C" (methane), not an acrylate.
//
// The root cause: we open the constrained span immediately without any preamble,
// so the LM has no context. The parser accepts single atoms as valid complete
// SMILES, so IsCompletePrefix("C") = true, and the span closes immediately.
//
// Fix strategy:
// 1. Use UnconstrainedChunk to let the LM generate some preamble text first,
//    which stops when "<<" is naturally emitted or after a few tokens.
//    This gives context before the constrained span.
// 2. However, the task says "hidden parser-guided constrained chunk" - the answer
//    contract is a single SMILES string. Looking at feedback: "answer_source: none"
//    and "hidden_or_task_extractor 0/50" suggests the visible span IS being used
//    but incorrectly.
// 3. The key insight from diagnostics: "tiny_span_dominant: yes", avg span length = 1.
//    We need to prevent early closure of tiny spans.
// 4. Solution: use AdaptiveConstrainedStep but DON'T call CloseSpanIfComplete or
//    check IsCompletePrefix until we have at least N tokens in currentConstrainedOut.
//    Force the generation of at least ~8 tokens before allowing closure.
// 5. Use SafeRepetitionPenaltyStep to avoid degenerate token repetition.
//
// The task: generate a novel acrylate SMILES. Acrylates must have C=CC(=O)O core.
// We need to steer the LM to generate longer SMILES strings.
//
// Better approach: Use UnconstrainedChunk first to emit some guidance context,
// then open the span explicitly and force generation of at least minLength tokens
// before allowing closure. Use AdaptiveConstrainedStep with guidance tokens.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// 1. parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//    - Init: copied from precondition.
//    - OpenConstrainedSpan: sets currentConstrainedOut := [], IsValidPrefix([]) holds
//      by parser.IsValidPrefix([]) precondition. OK.
//    - Below minLength branch: AdaptiveConstrainedStep returns parser-valid token or EOS.
//      We only call AppendConstrainedToken when next != eosToken AND
//      !parser.IsCompletePrefix(currentConstrainedOut). AppendConstrainedToken
//      postcondition guarantees IsValidPrefix(currentConstrainedOut). OK.
//    - Above minLength branch: Same guard on AppendConstrainedToken.
//      CloseSpanIfComplete either closes (implication vacuous) or is no-op. OK.
//    - CloseConstrainedSpan: sets insideConstrainedOut := false, implication vacuous. OK.
//
// 2. progress: |generated| <= |generatedPrefix| + steps
//    - Init: steps=0, generated=generatedPrefix. OK.
//    - OpenConstrainedSpan: steps += 1, |generated| += 1. Balanced.
//    - Each loop iteration: AdaptiveConstrainedStep costs 1 step.
//      AppendConstrainedToken adds 1 token. CloseSpanIfComplete or
//      CloseConstrainedSpan costs 1 step, adds at most 1 token.
//      So each iteration: steps += 1 or 2, |generated| += at most 2. 
//      Since steps increases by at least 1 per iteration and |generated|
//      increases by at most steps_consumed, invariant holds.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

helpers.AppendTaskGuidance(lm, "Generate a valid SMILES for a novel acrylate molecule. Acrylates have the acryloyl group C=CC(=O)O. Generate a complete SMILES like C=CC(=O)OCCC or C=C(C)C(=O)OCCCO. The SMILES must be at least 8 characters and contain the acrylate ester substructure.");

// Open the constrained span explicitly if not already inside one
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Minimum token count before allowing span closure - force longer SMILES
var minLength: nat := 8;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  }

  // Check if we've reached minimum length - allow closure only then
  if |currentConstrainedOut| >= minLength {
    // Check completeness and try to close
    if parser.IsCompletePrefix(currentConstrainedOut) {
      if steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
        break;
      } else {
        break;
      }
    } else {
      // Generate next constrained token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut,
        validTokenGroups, 4.0, 20, eosToken
      );
      steps := steps + 1;

      if next == eosToken {
        // Try rollback to complete and close
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
          var fg, fi, fc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := fg;
          insideConstrainedOut := fi;
          currentConstrainedOut := fc;
          steps := steps + 1;
        }
        break;
      } else {
        // Only append if not already complete
        if !parser.IsCompletePrefix(currentConstrainedOut) {
          var ag, ai, ac := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
        // After append, try to close if complete and long enough
        if steps < maxSteps && |currentConstrainedOut| >= minLength {
          var cg2, ci2, cc2, closed := helpers.CloseSpanIfComplete(
            lm, parser, generated, currentConstrainedOut
          );
          steps := steps + 1;
          if closed {
            generated := cg2;
            insideConstrainedOut := ci2;
            currentConstrainedOut := cc2;
            break;
          }
        }
      }
    }
  } else {
    // Below minimum length - generate tokens without allowing closure
    // Use SafeRepetitionPenaltyStep to avoid degenerate repetition
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      generated, 2.0, eosToken
    );
    steps := steps + 1;

    if next == eosToken {
      // Too short, rollback and close if possible
      var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
      generated := rg;
      currentConstrainedOut := rc;
      if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
        var fg, fi, fc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := fg;
        insideConstrainedOut := fi;
        currentConstrainedOut := fc;
        steps := steps + 1;
      }
      break;
    } else {
      // Only append if parser is not already complete
      if !parser.IsCompletePrefix(currentConstrainedOut) {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      } else {
        // Complete but below minLength - we can't append more, just close
        if steps < maxSteps {
          var fg, fi, fc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := fg;
          insideConstrainedOut := fi;
          currentConstrainedOut := fc;
          steps := steps + 1;
        }
        break;
      }
    }
  }
}

// Final cleanup: if still inside, rollback and close
if insideConstrainedOut && steps < maxSteps {
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
  if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
    var fg, fi, fc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := fg;
    insideConstrainedOut := fi;
    currentConstrainedOut := fc;
    steps := steps + 1;
  }
}

cost := steps;

