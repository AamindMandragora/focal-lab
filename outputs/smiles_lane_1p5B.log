// we fall through to the adaptive loop.
var forcedTokens: seq<Token> := ["C", "=", "C", "C", "(", "=", "O", ")", "O"];
var forceIdx: nat := 0;

while forceIdx < |forcedTokens| && steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases |forcedTokens| - forceIdx, maxSteps - steps
{
  var tok := forcedTokens[forceIdx];
  var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, tok);
  if valid && !parser.IsCompletePrefix(currentConstrainedOut) {
    // Use AdaptiveConstrainedStep for the step cost, then check if forced token valid
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      validTokenGroups, 4.0, 20, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
