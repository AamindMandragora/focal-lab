Strategy: // CSD_RATIONALE_BEGIN
// SMILES CSD with visible << >> spans.
// The evaluator expects a visible constrained segment containing the SMILES string.
// Strategy:
//   1. Open a constrained span with OpenConstrainedSpan (appends "<<", costs 1 step).
//   2. Inside the span, use ConstrainedStep + AppendConstrainedToken to build
//      a parser-valid SMILES token by token until the parser is complete or EOS.
//   3. Once the parser reports IsCompletePrefix, call CloseConstrainedSpan to
//      emit ">>" and exit constrained mode.
// This ensures the output has the form << SMILES >> which the evaluator can extract.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   After OpenConstrainedSpan, insideConstrainedOut == true and
//   currentConstrainedOut == [], which is a valid prefix by parser.IsValidPrefix([])
//   (given by precondition). Each call to ConstrainedStep returns either EOS or a
//   parser-valid next token; AppendConstrainedToken extends currentConstrainedOut
//   by one valid token, preserving parser.IsValidPrefix(currentConstrainedOut) by
//   the definition of IsValidPrefix (valid extension). CloseConstrainedSpan sets
//   insideConstrainedOut := false, making the implication vacuously true.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan appends "<<" (one token) and we increment steps by 1.
//   Each ConstrainedStep + AppendConstrainedToken appends one token and increments
//   steps by 1. CloseConstrainedSpan appends ">>" (one token) and we increment
//   steps by 1. So in every branch exactly one token is appended per step consumed,
//   maintaining |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END

{
  generated := generatedPrefix;
  insideConstrainedOut := insideConstrained;
  currentConstrainedOut := currentConstrained;
  cost := 0;

  if maxSteps == 0 {
    // Nothing to do; postconditions satisfied vacuously.
  } else {
    var steps: nat := 0;

    // Phase 1: Open constrained span (costs 1 step, appends "<<")
    if steps < maxSteps && !insideConstrainedOut {
      var openGenerated, openInside, openCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openGenerated;
      insideConstrainedOut := openInside;
      currentConstrainedOut := openCurrent;
      steps := steps + 1;
    }

    // Phase 2: Generate SMILES tokens under parser control
    while steps < maxSteps && insideConstrainedOut && !parser.IsCompletePrefix(currentConstrainedOut)
      invariant 0 <= steps <= maxSteps
      invariant lm.ValidTokensIdsLogits()
      invariant !insideConstrainedOut ==> currentConstrainedOut == []
      invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
      invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
      invariant |generated| <= |generatedPrefix| + steps
      decreases maxSteps - steps
    {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }

    // Phase 3: Close constrained span if complete and still inside
    if steps < maxSteps && insideConstrainedOut && parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    }

