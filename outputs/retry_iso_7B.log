Strategy: // CSD_RATIONALE_BEGIN
// SMILES CSD: The task requires generating the SMILES string for a given chemical name.
// Diagnosis from prior attempts:
// 1. All attempts generated "<<O>>" - just a single "O" token - regardless of chemical name.
// 2. The model entered constrained mode immediately (0 tokens before "<<").
// 3. The tiny-span rate was 100%, meaning the constrained span was only 1 token.
// 4. The core issue: the SMILES parser accepts "O" as a complete prefix (water),
//    so ConstrainedStep returns EOS or minimal token, and the span closes immediately.
//
// Root cause: The model doesn't have context about WHAT SMILES to generate because
// we enter constrained mode before the model can "reason" about the molecule.
// Also, maxChunk was too small - with stepTokenBudget=1 and maxSteps=400, the
// UnconstrainedChunk was limited, but stepsUsed was being calculated correctly.
//
// The real problem: the model was generating "<<" as the FIRST token of UnconstrainedChunk
// because the prompt just says "isocyanates" and the guidance says "write << then SMILES >>".
// So the model immediately writes "<<" which triggers stoppedOnOpenSpan on first step,
// entering constrained mode with zero context.
//
// Fix: Use a guidance that tells the model to FIRST think/reason about the SMILES,
// THEN write it. More importantly, let the model generate MANY free tokens before "<<"
// by setting a large maxChunk but also checking if the model generates enough context.
// 
// Better fix: The SMILES should be generated by ConstrainedGeneration from a prompt
// that includes the task context. The issue with ConstrainedGeneration alone is that
// it starts from an empty prefix with no context about which SMILES to generate.
//
// Key insight: The evaluator uses "last_visible_span" to extract the answer.
// The SMILES parser needs to parse the full SMILES string (e.g., for isocyanates,
// it should be O=C=N or similar). The model generates "O" because ConstrainedGeneration
// with an empty current prefix finds "O" as the highest-probability valid token.
//
// Strategy: Use a LONG unconstrained chunk (most of the budget) to let the model 
// generate reasoning + the actual SMILES text. Then use AdaptiveConstrainedStep 
// inside the span with validTokenGroups to guide toward the right molecule.
// Use a two-phase approach:
// Phase 1: Large unconstrained chunk (reserve ~50 steps for constrained)
// Phase 2: Once inside span, use AdaptiveConstrainedStep with validTokenGroups
//
// Most importantly: make the guidance tell the model to spell out the full SMILES
// name BEFORE using delimiters, so the constrained generation is informed by context.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut starts as insideConstrained (false in the common case).
//   UnconstrainedChunk branch: if stoppedOnOpenSpan, EnterObservedConstrainedSpan sets
//   insideConstrainedOut := true and currentConstrainedOut := [], which satisfies
//   parser.IsValidPrefix([]) by precondition. If EOS, we break.
//   Inside constrained loop: AdaptiveConstrainedStep returns parser-valid next token;
//   AppendConstrainedToken preserves parser.IsValidPrefix(currentConstrainedOut).
//   CloseConstrainedSpan sets insideConstrainedOut := false (implication vacuously true).
//   OpenConstrainedSpan: sets currentConstrainedOut := [] which is valid by precondition.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   UnconstrainedChunk: adds stepsUsed to steps, and |genOut| - |generated| <= stepsUsed.
//   OpenConstrainedSpan: adds 1 to steps, appends 1 token ("<<") to generated.
//   AdaptiveConstrainedStep + AppendConstrainedToken: adds 1 to steps, appends 1 token.
//   CloseConstrainedSpan: adds 1 to steps, appends ">>" to generated.
//   In all branches, token-count growth <= step growth, so bound is maintained.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

if maxSteps == 0 {
  // Nothing to do; all postconditions hold trivially
} else {
  // Prime the model: tell it to write the full SMILES in a specific format,
  // but first reason about the molecule name.
  helpers.AppendTaskGuidance(lm, "You are a chemistry assistant. Think step by step about the molecular structure of the given chemical name, then write the canonical SMILES string between << and >>. First write your reasoning, then write <<SMILES_HERE>>. The SMILES must be the complete correct structure.");

  var steps: nat := 0;

  if !insideConstrainedOut {
    // Phase 1: Let the model reason freely until it naturally emits "<<"
    // Reserve enough steps for the constrained SMILES generation (SMILES can be long)
    var reservedForConstrained := 80;
    var maxChunk: nat;
    if maxSteps > reservedForConstrained + 2 {
      maxChunk := maxSteps - reservedForConstrained - 1;
    } else if maxSteps > 2 {
      maxChunk := maxSteps - 2;
    } else {
      maxChunk := 1;
    }

    var genOut, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, maxChunk, "<<", eosToken
    );
    steps := steps + stepsUsed;
    generated := genOut;

    if stoppedOnEos {
      cost := steps;
    } else {
      if stoppedOnOpenSpan {
        // "<<" was emitted by the LM; enter observed span state
        var enterGenerated, enterInside, enterCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := enterGenerated;
        insideConstrainedOut := enterInside;
        currentConstrainedOut := enterCurrent;
      } else {
        // Model ran out of free tokens without emitting "<<"; force open span
        if steps < maxSteps {
          var openGenerated, openInside, openCurrent := helpers.OpenConstrainedSpan(lm, generated);
          generated := openGenerated;
          insideConstrainedOut := openInside;
          currentConstrainedOut := openCurrent;
          steps := steps + 1;
        }
      }

      // Phase 2: Generate the SMILES constrained tokens
      while steps < maxSteps && insideConstrainedOut
        invariant 0 <= steps <= maxSteps
        invariant lm.ValidTokensIdsLogits()
        invariant !insideConstrainedOut ==> currentConstrainedOut == []
        invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
        invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
        invariant |generated| <= |generatedPrefix| + steps
        decreases maxSteps - steps
      {
        // Check if we can close the span
        var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
        steps := steps + 1;
        if closed {
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
        } else {
          // Need more tokens; use AdaptiveConstrainedStep with validTokenGroups
          if steps < maxSteps {
            var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
            var next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken);
            steps := steps + 1;
            if next == eosToken {
              // EOS inside constrained span; try to close if complete
              if parser.IsCompletePrefix(currentConstrainedOut) {
                if steps < maxSteps {
                  var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
                    lm, parser, generated, currentConstrainedOut
                  );
                  generated := closedGenerated;
                  insideConstrainedOut := closedInside;
                  currentConstrainedOut := closedCurrent;
                  steps := steps + 1;
                }
              }
              break;
            } else {
              var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
                lm, parser, generated, currentConstrainedOut, next
              );
              generated := appendedGenerated;
              insideConstrainedOut := appendedInside;
              currentConstrainedOut := appendedCurrent;
            }
          }
        }
      }

      cost := steps;
    }
  } else {
    // Already inside constrained span from prior call
    while steps < maxSteps && insideConstrainedOut
      invariant 0 <= steps <= maxSteps
      invariant lm.ValidTokensIdsLogits()
      invariant !insideConstrainedOut ==> currentConstrainedOut == []
      invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
      invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
      invariant |generated| <= |generatedPrefix| + steps
      decreases maxSteps - steps
    {
      var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
      steps := steps + 1;
      if closed {
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
      } else {
        if steps < maxSteps {
          var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
          var next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken);
          steps := steps + 1;
          if next == eosToken {
            break;
          } else {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
          }
        }
      }
    }
    cost := steps;
  }
}

