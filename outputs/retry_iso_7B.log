Strategy: // CSD_RATIONALE_BEGIN
// SMILES CSD: The task asks for a SMILES string given a chemical name.
// The previous attempt failed because:
// 1. It opened << immediately (before any free-text reasoning about the molecule)
// 2. The constrained span was tiny (1 token: just "O") - not the actual SMILES
// 3. The evaluator expects the SMILES of the named molecule, not a trivial default
//
// New strategy:
// 1. Use AppendTaskGuidance to prime the model with SMILES generation instructions.
// 2. Use UnconstrainedChunk to let the model generate freely until it emits "<<"
//    naturally (this gives the model a chance to "reason" about which SMILES to produce).
// 3. Once "<<" is observed, use EnterObservedConstrainedSpan (no extra delimiter).
// 4. Inside the span, use ConstrainedStep + AppendConstrainedToken to build
//    the parser-valid SMILES token sequence.
// 5. Once IsCompletePrefix holds, call CloseConstrainedSpan to emit ">>" and exit.
//
// The key insight: let the model see the chemical name prompt and generate
// some context before entering constrained mode, so it has context about
// WHAT SMILES to generate.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut starts false (or from insideConstrained).
//   UnconstrainedChunk branch: if stoppedOnOpenSpan, EnterObservedConstrainedSpan
//   sets insideConstrainedOut := true and currentConstrainedOut := [], which is
//   valid by parser.IsValidPrefix([]) (precondition). If EOS, we break.
//   Constrained branch: ConstrainedStep returns EOS or parser-valid next token;
//   AppendConstrainedToken preserves parser.IsValidPrefix(currentConstrainedOut).
//   CloseConstrainedSpan sets insideConstrainedOut := false (implication vacuous).
//
// progress (|generated| <= |generatedPrefix| + steps):
//   UnconstrainedChunk: stepsUsed >= 1, and |generatedOut| - |generated| <= stepsUsed,
//   so the bound is maintained. Each ConstrainedStep + AppendConstrainedToken
//   appends one token and costs 1 step. CloseConstrainedSpan appends ">>" and
//   costs 1 step. So the invariant holds throughout.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

if maxSteps == 0 {
  // Nothing to do
} else {
  // Prime the model with SMILES-specific guidance
  helpers.AppendTaskGuidance(lm, "Output the SMILES string for the given chemical name. Write << then the SMILES string then >>. Example: <<CCO>> for ethanol. Do not add explanation.");

  var steps: nat := 0;

  // If already inside a constrained span, skip the free-text phase
  if !insideConstrainedOut && steps < maxSteps {
    // Use UnconstrainedChunk to let model reason until it emits "<<"
    var maxChunk := maxSteps - 1; // reserve at least 1 step for constrained content
    if maxChunk == 0 { maxChunk := 1; }
    var genOut, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, maxChunk, "<<", eosToken
    );
    steps := steps + stepsUsed;
    if stoppedOnEos {
      generated := genOut;
      cost := steps;
    } else {
      generated := genOut;
      if stoppedOnOpenSpan {
        // "<<" was emitted by the LM; enter observed span without appending another delimiter
        var enterGenerated, enterInside, enterCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := enterGenerated;
        insideConstrainedOut := enterInside;
        currentConstrainedOut := enterCurrent;
      } else if steps < maxSteps {
        // Model didn't emit "<<" naturally; force open a constrained span
        var openGenerated, openInside, openCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openGenerated;
        insideConstrainedOut := openInside;
        currentConstrainedOut := openCurrent;
        steps := steps + 1;
      }

      // Now generate SMILES tokens inside the constrained span
      while steps < maxSteps && insideConstrainedOut && !parser.IsCompletePrefix(currentConstrainedOut)
        invariant 0 <= steps <= maxSteps
        invariant lm.ValidTokensIdsLogits()
        invariant !insideConstrainedOut ==> currentConstrainedOut == []
        invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
        invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
        invariant |generated| <= |generatedPrefix| + steps
        decreases maxSteps - steps
      {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }

      // Close the span if complete
      if steps < maxSteps && insideConstrainedOut && parser.IsCompletePrefix(currentConstrainedOut) {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
      }

      cost := steps;
    }
  } else if insideConstrainedOut {
    // Already inside a constrained span from a previous call
    while steps < maxSteps && insideConstrainedOut && !parser.IsCompletePrefix(currentConstrainedOut)
      invariant 0 <= steps <= maxSteps
      invariant lm.ValidTokensIdsLogits()
      invariant !insideConstrainedOut ==> currentConstrainedOut == []
      invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
      invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
      invariant |generated| <= |generatedPrefix| + steps
      decreases maxSteps - steps
    {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }

    if steps < maxSteps && insideConstrainedOut && parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    }

    cost := steps;
  } else {
    cost := 0;
  }
}

