Strategy: // CSD_RATIONALE_BEGIN
// SQL generation CSD for Spider dataset. The task requires exactly one output
// of the form "SQL: <<YOUR QUERY>>" where the content inside "<<...>>" is a
// valid SQL query constrained by the parser.
//
// Strategy:
// 1. Append task guidance to prime the model for SQL generation.
// 2. Generate freely until the model emits "SQL:" prefix tokens and then "<<"
//    to open the constrained span.
// 3. Inside the constrained span, use AdaptiveConstrainedStep with group boosts
//    from validTokenGroups (which contain SQL keywords, table/column names).
//    Apply SafeRepetitionPenalty to avoid repeating tokens unnecessarily.
// 4. Close the span as soon as the parser reports a complete SQL parse, then stop.
//
// State tracked: insideConstrainedOut, currentConstrainedOut, steps counter.
// The parser enforces SQL grammar validity at every token; group boosts steer
// toward schema-relevant identifiers; repetition penalty reduces verbosity.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   Outside-span branch: flips insideConstrainedOut to true only when next == "<<"
//     and sets currentConstrainedOut := [] which satisfies IsValidPrefix([]) by
//     precondition parser.IsValidPrefix([]). Implication is vacuous otherwise.
//   CloseConstrainedSpan branch: sets insideConstrainedOut := false, making the
//     implication vacuously true, and clears currentConstrainedOut := [].
//   Inside-span step branch: AdaptiveConstrainedStep returns EOS or a parser-valid
//     next token. AppendConstrainedToken extends currentConstrainedOut by one
//     parser-valid token, preserving IsValidPrefix by the helper's postcondition.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   Outside-span branch: steps increments by 1; generated grows by at most 1
//     (the non-EOS token appended), so the bound is preserved.
//   CloseConstrainedSpan branch: steps increments by 1; generated grows by at
//     most 1 (the ">>" delimiter), so the bound is preserved.
//   Inside-span step branch: steps increments by 1; AppendConstrainedToken
//     appends exactly 1 token to generated; EOS path appends nothing and breaks.
//     In both cases |generated| <= |generatedPrefix| + steps holds.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Output exactly one SQL query in the format: SQL: <<SELECT ...>>. Use only the tables and columns from the provided schema. No explanation, no markdown, no extra text.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var done: bool := false;

while steps < maxSteps && !done
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      done := true;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
    done := true;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 16, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      done := true;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

