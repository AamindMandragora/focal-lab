Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters.
// State tracked: generated (full output), insideConstrainedOut (in a span?),
// currentConstrainedOut (constrained tokens since last "<<").
// Strategy:
//   Phase 1 (outside span): generate free tokens until "<<" appears naturally
//   or EOS. When "<<" is observed, enter the constrained span.
//   Phase 2 (inside span): use AdaptiveConstrainedStep with group boosts to
//   generate valid math expressions or answer values. After each constrained
//   token, check if the parser accepts a complete prefix; if so, close with ">>"
//   via CloseSpanIfComplete (cost +1). This pattern correctly handles both
//   intermediate symbolic expressions and the final answer.
//   Repetition penalty is applied to avoid looping on the same tokens inside
//   the constrained span, which is common in arithmetic generation.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   Outside span branch: insideConstrainedOut is false so the implication is
//   vacuously true until next == "<<", at which point we set
//   currentConstrainedOut := [] which satisfies parser.IsValidPrefix([]) by
//   precondition.
//   CloseSpanIfComplete branch: when closed == true, it sets insideConstrainedOut
//   false making the implication vacuous and currentConstrainedOut := []; when
//   closed == false, state is unchanged, so validity is preserved from previous
//   iteration.
//   Constrained step branch: AdaptiveConstrainedStep returns EOS or a
//   parser-valid next token. AppendConstrainedToken extends currentConstrainedOut
//   by a valid next token, preserving parser.IsValidPrefix by the helper's
//   postcondition.
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   Outside span: steps grows by 1, generated grows by at most 1 (EOS not
//   appended, so visible growth is 0 or 1). Bound preserved.
//   CloseSpanIfComplete: steps grows by 1, generated grows by at most 1 (">>"
//   appended on close). Bound preserved.
//   Constrained step: steps grows by 1, AppendConstrainedToken appends exactly
//   1 token. Bound preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math problem step by step. Wrap each intermediate symbolic expression and the final numeric answer inside << >> delimiters. Show your reasoning outside the delimiters.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    // Try to close if we have a complete parse
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Generate next constrained token with adaptive group boosting and repetition penalty
      if steps < maxSteps {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.SafeRepetitionPenaltyStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

