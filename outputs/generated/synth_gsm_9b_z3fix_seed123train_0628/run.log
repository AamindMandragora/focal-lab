Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with reliable << >> span closure.
//
// Key observations from failure analysis:
// 1. Most outputs (43/49) DID emit valid << >> spans, but 24/49 were syntax-valid-wrong.
//    The LM produces correct reasoning outside spans but wrong final expressions inside.
// 2. 5/49 had no span emitted (pure free generation ran out of budget).
// 3. 5/49 had malformed span content (curly braces, ** operators not in grammar).
// 4. 6/49 left spans unclosed (budget exhausted inside span).
//
// Strategy redesign:
// - Use UnconstrainedChunk to generate free reasoning up to the first "<<".
//   This is more efficient than step-by-step unconstrained.
// - Once inside a span, use ConstrainedStep (hard parser control) for every token.
//   This prevents malformed content like {}, **, etc.
// - After EVERY constrained token, immediately try CloseSpanIfComplete.
//   This ensures we close the span as soon as the parser accepts it.
// - Reserve budget for closing: if we're inside a span and running low on budget,
//   use CloseSpanWithinBudget to force closure.
// - The key fix for accuracy: use AdaptiveConstrainedStep with group boosts
//   to prefer tokens that match the problem's variable names (from validTokenGroups).
// - For the "no span emitted" problem: use a tighter chunk size to stop sooner
//   and give more chances to emit "<<".
//
// The guidance steers toward a SINGLE final answer span rather than many intermediate spans,
// which matches the evaluation pattern (answer extracted from last visible span).
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   Outside span: insideConstrainedOut is false, so implication is vacuously true.
//   When UnconstrainedChunk returns stoppedOnOpenSpan=true, generated already ends
//   with "<<" and we call EnterObservedConstrainedSpan which sets currentConstrainedOut:=[]
//   (valid by precondition). When next=="<<" in single-step path, we similarly set [].
//   CloseSpanIfComplete: when closed, sets insideConstrainedOut=false (vacuous) and
//   currentConstrainedOut=[]; when not closed, leaves state unchanged.
//   CloseSpanWithinBudget: postcondition guarantees insideOut==>parser.IsValidPrefix(currentOut).
//   ConstrainedStep+AppendConstrainedToken: ConstrainedStep returns a parser-valid token,
//   AppendConstrainedToken extends currentConstrainedOut by that token, preserving validity.
//   AdaptiveConstrainedStep: same guarantee as ConstrainedStep.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   UnconstrainedChunk: steps grows by stepsUsed, generated grows by at most stepsUsed
//   tokens (the chunk is already appended). Bound preserved.
//   UnconstrainedStep (fallback): steps grows by 1, generated grows by at most 1. Bound preserved.
//   CloseSpanIfComplete: steps grows by 1, generated grows by at most 1 (">>"). Bound preserved.
//   CloseSpanWithinBudget with closeBudget=maxSteps-steps: |generated| <= old|generated|+closeBudget
//   <= |generatedPrefix| + steps + (maxSteps-steps) = |generatedPrefix| + maxSteps. We set
//   steps:=maxSteps, so bound preserved.
//   AdaptiveConstrainedStep+AppendConstrainedToken: steps grows by 1, generated grows by 1. Bound preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math problem step by step. At the end, write the final symbolic answer expression inside << >> delimiters. Use only variable names from the problem (no curly braces, no ** operator). Example: <<n * m / k>>";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Reserve enough budget for constrained generation + closure
    var reserveForSpan: nat := 30;
    if steps + reserveForSpan >= maxSteps {
      // Running low: just do single unconstrained steps
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    } else {
      // Use chunked generation to efficiently reach "<<"
      var chunkSize: nat := 20;
      if steps + chunkSize > maxSteps - reserveForSpan {
        chunkSize := maxSteps - reserveForSpan - steps;
      }
      if chunkSize == 0 {
        // Force a single step
        var next := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          generated := generated + [next];
          if next == "<<" {
            insideConstrainedOut := true;
            currentConstrainedOut := [];
          }
        }
      } else {
        var genOut, stoppedOnOpen, stoppedOnEos, stepsUsed :=
          helpers.UnconstrainedChunk(lm, prompt, generated, chunkSize, "<<", eosToken);
        steps := steps + stepsUsed;
        generated := genOut;
        if stoppedOnEos {
          break;
        } else if stoppedOnOpen {
          // "<<" is already in generated; enter span state without appending again
          generated, insideConstrainedOut, currentConstrainedOut :=
            helpers.EnterObservedConstrainedSpan(lm, generated);
