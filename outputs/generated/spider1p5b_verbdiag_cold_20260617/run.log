Strategy: // CSD_RATIONALE_BEGIN
// Strategy: Three-phase SQL generation for Spider dataset.
// Phase 1: Unconstrained prefix generation until "<<" observed or budget limit.
// Phase 2: Force open constrained span if not already inside one.
// Phase 3: Adaptive constrained SQL generation with group boosts, closing when complete.
// Phase 4: CloseSpanWithinBudget to finalize any still-open span.
// maxSteps=1200, stepTokenBudget=1 means we generate one token per step.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// Invariant 1: parser_validity
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Phase 1 (unconstrained): when next=="<<", we set currentConstrainedOut:=[] and
//     parser.IsValidPrefix([]) holds by precondition.
//   - OpenConstrainedSpan: sets insideConstrainedOut:=true and currentConstrainedOut:=[]
//     which satisfies parser.IsValidPrefix([]).
//   - AppendConstrainedToken: the helper contract ensures the appended token preserves
//     parser.IsValidPrefix(currentConstrainedOut).
//   - CloseConstrainedSpan / CloseSpanWithinBudget: sets insideConstrainedOut:=false,
//     so the implication is vacuously true.
//
// Invariant 2: progress |generated| <= |generatedPrefix| + steps
//   - Phase 1: each UnconstrainedStep increments steps by 1, and appending next
//     increments |generated| by at most 1, so the bound is maintained.
//   - OpenConstrainedSpan: appends one token ("<<") and steps increments by 1.
//   - Phase 3 loop: each AdaptiveConstrainedStep or CloseConstrainedSpan increments
//     steps by 1 and AppendConstrainedToken appends at most 1 visible token;
//     CloseConstrainedSpan appends ">>" (1 token) and steps increments by 1.
//   - CloseSpanWithinBudget: bounded by closeBudget = maxSteps - steps, so
//     |generated| grows by at most closeBudget, and steps is set to maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

if maxSteps == 0 {
  cost := 0;
} else {
  var steps: nat := 0;
  var maxPrefixSteps: nat := if maxSteps > 100 then 100 else maxSteps / 2;
  var prefixSteps: nat := 0;

  // Phase 1: Emit unconstrained tokens until we have enough context or see "<<"
  while steps < maxSteps && prefixSteps < maxPrefixSteps && !insideConstrainedOut
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant |generated| <= |generatedPrefix| + steps
    invariant prefixSteps <= maxPrefixSteps
    decreases maxSteps - steps
  {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    prefixSteps := prefixSteps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  }

  // Phase 2: Force open constrained span if not yet inside one
  if !insideConstrainedOut && steps < maxSteps {
    var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
    generated := og;
    insideConstrainedOut := oi;
    currentConstrainedOut := oc;
    steps := steps + 1;
  }

  // Phase 3: Constrained SQL generation
  var closeReserve: nat := 2;

  while steps < maxSteps && insideConstrainedOut
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant |generated| <= |generatedPrefix| + steps
    decreases maxSteps - steps
  {
    if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| > 0 {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else if maxSteps - steps <= closeReserve {
      break;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 16, eosToken
      );
      steps := steps + 1;

      if next == eosToken {
        if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| > 0 {
          var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
            lm, parser, generated, currentConstrainedOut
          );
          generated := closedGenerated;
          insideConstrainedOut := closedInside;
          currentConstrainedOut := closedCurrent;
          if steps < maxSteps {
            steps := steps + 1;
          }
        }
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }

  // Phase 4: Close any still-open span within remaining budget
  if insideConstrainedOut && steps < maxSteps {
    var closeBudget := maxSteps - steps;
    var cg, ci, cc := helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
    );
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := maxSteps;
  }

  cost := steps;
}

