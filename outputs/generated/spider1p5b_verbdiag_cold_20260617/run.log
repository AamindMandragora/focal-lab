Strategy: // CSD_RATIONALE_BEGIN
// SQL generation CSD for spider dataset - improved from best attempt (41.3% accuracy, 80% syntax).
//
// Key issues from prior attempts:
// 1. "unterminated_constrained_segment" (12/69): The span opens but never closes because
//    the model generates very long repetitive GROUP BY lists that exhaust the step budget.
//    Fix: Use CloseSpanWithinBudget with a reserved budget to guarantee closure. Reserve
//    a larger portion (200 steps) to ensure CloseSpanWithinBudget has enough budget to
//    find a completable state.
//
// 2. "too_slow" (3/69): Generation takes too long due to repetitive tokens.
//    Fix: Detect dead-end states early and use CloseSpanWithinBudget to force closure.
//    Also use CloseSpanIfComplete every step to catch early completion opportunities.
//
// 3. "malformed_constrained_content" (1/69): Span content fails syntax check.
//    Fix: Use AdaptiveConstrainedStep with parser control + CloseSpanIfComplete to
//    catch completion as soon as the parser accepts the content.
//
// Strategy:
//   Phase 0 (guidance): Emit guidance prompting compact, correct SQL.
//   Phase 1 (unconstrained): Generate "SQL: <<" freely, stopping when "<<" is observed
//            or emitting OpenConstrainedSpan to force "<<" if needed.
//   Phase 2 (constrained): Generate SQL tokens under parser control.
//            - After each token, try CloseSpanIfComplete to close as soon as valid.
//            - Monitor for dead-ends (very few valid tokens) to trigger early close.
//            - Reserve 200 steps for Phase 3.
//   Phase 3 (close): Use CloseSpanWithinBudget with the reserved budget to guarantee
//            the span closes cleanly.
//
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Phase 1 (unconstrained): The implication is vacuous while insideConstrainedOut is
//     false. When "<<" is observed via UnconstrainedStep, we set currentConstrainedOut := []
//     which satisfies parser.IsValidPrefix([]) by precondition. OpenConstrainedSpan also
//     sets currentConstrainedOut := [] when forced.
//   - Phase 2 (constrained loop): CloseSpanIfComplete either closes the span (sets
//     insideConstrainedOut := false, making the implication vacuous) or leaves state
//     unchanged. AdaptiveConstrainedStep returns a parser-valid token or EOS;
//     AppendConstrainedToken preserves parser.IsValidPrefix by contract.
//     EOS breaks the loop without modifying state.
//   - Phase 3 (CloseSpanWithinBudget): Its postcondition guarantees
//     insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut).
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Phase 1: Each iteration increments steps by 1 and appends at most 1 token
//     (EOS path breaks without appending). OpenConstrainedSpan appends "<<" (+1 token,
//     +1 step), maintaining the bound.
//   - Phase 2: CloseSpanIfComplete costs 1 step and appends at most 1 token (">>");
//     AdaptiveConstrainedStep + AppendConstrainedToken cost 1 step and append at most
//     1 token. Both preserve the bound.
//   - Phase 3: CloseSpanWithinBudget(budget) satisfies |generatedOut| <= |generated| +
//     budget; we set steps := maxSteps so the final length bound holds.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a concise, correct SQL query. Output format: SQL: <<YOUR QUERY>>. Use only tables and columns from the schema. Keep the query short and precise. No semicolons, no subquery unless necessary.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate unconstrained until "<<" opens the span.
while steps < maxSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  } else {
    generated := generated + [next];
    if next == "<<" {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  }
}

// Force open span if not yet open and budget remains
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Generate inside the constrained span.
// Reserve 200 steps for CloseSpanWithinBudget.
var closeReserve: nat := 200;
while steps + closeReserve < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
