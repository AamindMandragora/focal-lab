Strategy: // CSD_RATIONALE_BEGIN
// SQL generation CSD for spider dataset - revised strategy.
//
// Key diagnosis from prior attempt:
// 1. "entered_constrained_mode_too_early": The model emits "<<" as the very first
//    token after "SQL: " because it sees "<<" in the guidance and imitates it.
//    Fix: use a stronger unconstrained phase that forces the model to emit "SQL: "
//    prefix tokens before the span opens. We use UnconstrainedChunk with a small
//    budget (up to 8 free tokens) stopping when "<<" appears naturally, then
//    manually open the constrained span if needed.
//
// 2. "malformed_constrained_content": The parser rejects tokens like ";", "}", etc.
//    Fix: use RepetitionPenaltyStep to discourage recycled tokens, and
//    CloseSpanWithinBudget to ensure the span closes cleanly.
//
// 3. "missing_constrained_segment": The model never emits "<<" at all.
//    Fix: after the unconstrained chunk phase, if we have not entered the span,
//    force open the span with OpenConstrainedSpan.
//
// 4. "unterminated_constrained_segment": Span opens but never closes.
//    Fix: use CloseSpanWithinBudget at the end to guarantee closure.
//
// Strategy:
//   Phase 0: Emit up to 8 unconstrained tokens (for "SQL: " prefix), stopping if
//            "<<" appears naturally. Budget: min(8, remaining steps).
//   Phase 1: If not yet in constrained mode, force open the span.
//   Phase 2: Generate inside the constrained span using AdaptiveConstrainedStep
//            with group boosting. Apply SafeRepetitionPenaltyStep for variety.
//            Reserve enough budget for CloseSpanWithinBudget at the end.
//   Phase 3: CloseSpanWithinBudget to reliably close the span.
//
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Phase 0 (UnconstrainedChunk): if stoppedOnOpenSpan is true, generated ends
//     with "<<" and we call EnterObservedConstrainedSpan which sets
//     currentConstrainedOut := [] (valid by precondition). Otherwise insideConstrainedOut
//     stays false (implication vacuous).
//   - Phase 1 (OpenConstrainedSpan): sets currentConstrainedOut := [] which is valid.
//   - Phase 2 (constrained loop): AdaptiveConstrainedStep returns EOS or a
//     parser-valid token. AppendConstrainedToken preserves validity. EOS breaks.
//     CloseSpanIfComplete closes the span, making the implication vacuous.
//   - Phase 3 (CloseSpanWithinBudget): returns insideConstrainedOut and
//     currentConstrainedOut satisfying the invariant by its postcondition.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Phase 0: UnconstrainedChunk returns stepsUsed, we set steps += stepsUsed,
//     and |generatedOut| <= |generated| + stepsUsed by UnconstrainedChunk contract.
//   - Phase 1: OpenConstrainedSpan appends "<<" (+1 token, +1 step).
//   - Phase 2: each constrained loop iteration appends at most 1 token and
//     increments steps by 1. CloseSpanIfComplete appends ">>" and increments by 1.
//   - Phase 3: CloseSpanWithinBudget(budget) satisfies
//     |generatedOut| <= |generated| + budget; we set steps := maxSteps so
//     the final length bound holds.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Output exactly: SQL: <<YOUR SQL QUERY>>. The SQL query goes inside << and >>. Start with SQL: then immediately <<. Use only schema tables and columns. No semicolons inside the span.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 0: Generate a small unconstrained prefix ("SQL: ") stopping if "<<" appears.
// Reserve at least (maxSteps - min(8, maxSteps)) for the constrained phase.
if steps < maxSteps {
  var chunkBudget := maxSteps - steps;
  if chunkBudget > 8 {
    chunkBudget := 8;
  }
  var chunkGenerated, stoppedOnOpen, stoppedOnEos, stepsUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkBudget, "<<", eosToken);
  generated := chunkGenerated;
  steps := steps + stepsUsed;
  if stoppedOnEos {
    // EOS already; done
    cost := steps;
    return;
  }
  if stoppedOnOpen {
    // "<<" was observed and appended; enter constrained span state
    var eg, ei, ec := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := eg;
    insideConstrainedOut := ei;
    currentConstrainedOut := ec;
  }
}

// Phase 1: If not in constrained mode yet, force open the span.
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Generate inside the constrained span.
// Reserve 2 steps for CloseSpanWithinBudget (needs at least 1).
var closeReserve: nat := 2;
while steps + closeReserve < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Try to close if complete
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else {
    // Generate next constrained token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
    );
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Phase 3: If still inside constrained span, use CloseSpanWithinBudget to close cleanly.
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var fg, fi, fc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := fg;
  insideConstrainedOut := fi;
  currentConstrainedOut := fc;
  steps := maxSteps;
}

cost := steps;

