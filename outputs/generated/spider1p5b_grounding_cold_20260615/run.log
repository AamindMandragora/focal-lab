Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the spider dataset.
//
// The verification error is that |generated| <= |generatedPrefix| + maxSteps
// cannot be proved on the return path. The root cause is the non-loop code
// after the free phase: steps accumulates in a way Dafny cannot track as
// bounded by maxSteps.
//
// Fix: Use a single unified loop that handles all phases (free generation,
// open span, constrained generation, close span) in one while loop with
// clear invariants. This makes the length bound trivially verifiable.
//
// Strategy:
//   - Phase 0: Free generation until "<<" observed or budget limit reached.
//   - Phase 1: If not yet in constrained mode, force open "<<".
//   - Phase 2: Inside constrained span, use AdaptiveConstrainedStep.
//   - Phase 3: Close span when parser is complete.
//
// All transitions are handled inside a single while loop with invariant
//   |generated| <= |generatedPrefix| + steps <= |generatedPrefix| + maxSteps.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Free branch (!insideConstrainedOut): implication is vacuous. If model emits "<<",
//     we set currentConstrainedOut := [] which satisfies IsValidPrefix([]) by precondition.
//   - OpenConstrainedSpan: sets currentConstrainedOut := [], valid by precondition.
//   - Complete branch: CloseConstrainedSpan sets insideConstrainedOut := false, making
//     implication vacuous.
//   - Constrained step branch: AdaptiveConstrainedStep returns EOS or parser-valid token;
//     AppendConstrainedToken preserves IsValidPrefix by helper postcondition.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - Every branch increments steps by 1 and appends at most one token to generated
//     (EOS and close branches may append 0 or 1 visible tokens), maintaining the bound.
//   - OpenConstrainedSpan appends "<<" (1 token) and costs 1 step.
//   - CloseConstrainedSpan appends ">>" (1 token) and costs 1 step.
//   - AdaptiveConstrainedStep costs 1 step; AppendConstrainedToken costs 0 steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate a single valid SQL query. Output format: SQL: <<query>>. Use only tables and columns from the provided schema. No explanation.");

var steps: nat := 0;
// Track how many free steps we've taken before forcing open the span
var freeStepsTaken: nat := 0;
var spanOpened: bool := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Free phase: generate until "<<" is observed or we've done enough free steps
    if freeStepsTaken < 8 {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      freeStepsTaken := freeStepsTaken + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          var eg, ei, ec := helpers.EnterObservedConstrainedSpan(lm, generated);
          generated := eg;
          insideConstrainedOut := ei;
          currentConstrainedOut := ec;
          spanOpened := true;
        }
      }
    } else {
      // Force open constrained span
      if steps + 1 <= maxSteps {
        var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
        generated := og;
        insideConstrainedOut := oi;
        currentConstrainedOut := oc;
        steps := steps + 1;
        spanOpened := true;
      } else {
        break;
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    // Close the span
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    // Constrained generation inside the span
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

cost := steps;

