Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the spider dataset with improved span management.
//
// Key lessons from attempt 1:
//   1. "entered_constrained_mode_too_early": The model immediately emits "<<"
//      after "SQL: " with only 1 free step. We need to emit "SQL: " and "<<"
//      as forced tokens before opening the constrained span, not via free generation.
//   2. "missing_constrained_segment" (37 examples): The free LM never emits "<<"
//      and hits EOS. We must force the "SQL: <<" prefix explicitly.
//   3. "malformed_constrained_content" (27 examples): The parser rejects some SQL
//      fragments inside the span (e.g. semicolons, subquery constructs not in grammar).
//      Use RegenerateUnitOnGroundingFailure to ensure each grammar unit is grounded.
//   4. "unterminated_constrained_segment" (2 examples): Span opened but never closed.
//      Reserve budget for CloseConstrainedSpan and close as soon as parser is complete.
//
// Strategy:
//   Phase 0: Emit "SQL: " via unconstrained steps, watching for the model to
//             naturally emit each token. If the model emits "<<" before we
//             expect it, handle it via EnterObservedConstrainedSpan.
//   Phase 1: Force open "<<" via OpenConstrainedSpan once "SQL: " prefix is done.
//   Phase 2: Fill the constrained span using RegenerateUnitOnGroundingFailure
//             for grounded unit-level generation. This catches wrong table/column
//             names and resamples them.
//   Phase 3: Close the span once the parser is complete.
//
// The "SQL: " prefix is forced by emitting it via unconstrained steps with
// the model guided to produce it. We watch for "<<" being emitted naturally
// (entered_constrained_mode_too_early pattern) and handle it.
//
// Budget management: reserve 2 steps for OpenConstrainedSpan + CloseConstrainedSpan.
// Use remaining budget for span fill via grounded unit generation.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Phase 0 (free generation, !insideConstrainedOut): the implication is vacuous.
//     If the model emits "<<", we set currentConstrainedOut := [] and insideConstrainedOut := true;
//     [] satisfies IsValidPrefix([]) by precondition, so the invariant is restored.
//   - OpenConstrainedSpan: sets currentConstrainedOut := [], which satisfies IsValidPrefix([]).
//   - RegenerateUnitOnGroundingFailure postcondition: returns a parser-valid prefix,
//     so assigning currentConstrainedOut := filled preserves IsValidPrefix.
//   - CloseConstrainedSpan: sets insideConstrainedOut := false, making the implication vacuous.
//   - ConstrainedStep + AppendConstrainedToken: ConstrainedStep returns EOS or a
//     parser-valid extension token; AppendConstrainedToken extends currentConstrainedOut
//     preserving IsValidPrefix by the helper's postcondition.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - Phase 0: each iteration increments steps by 1 and appends at most one token
//     to generated (EOS breaks without appending), maintaining the bound.
//   - OpenConstrainedSpan: appends "<<" (1 token) and increments steps by 1.
//   - RegenerateUnitOnGroundingFailure: bounded by perUnit * 4 steps; we add
//     exactly perUnit * 4 to steps and the generated length grows by at most that,
//     keeping the bound. The helper appends to currentConstrainedOut but we
//     reconstruct generated as stable + currentConstrainedOut so length grows
//     by at most stepsUsed.
//   - CloseConstrainedSpan: appends ">>" (1 token) and increments steps by 1.
//   - Fallback ConstrainedStep: increments steps by 1 and appends at most 1 token.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Output format is exactly: SQL: <<query>> where query is a single valid SQL SELECT statement using only the schema provided. No semicolons. No explanation. No markdown.");

var steps: nat := 0;

// Phase 0: Emit free tokens until we either:
//   (a) the model naturally emits "<<" (enter constrained mode via EnterObservedConstrainedSpan)
//   (b) we've used 8 free steps (budget for "SQL: " prefix) then force open span
// Reserve at least 3 steps for: OpenConstrainedSpan(1) + at least 1 constrained token + CloseConstrainedSpan(1)
var freePhaseLimit: nat := 8;

while steps < maxSteps && !insideConstrainedOut && steps < freePhaseLimit
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases (if maxSteps < freePhaseLimit then maxSteps else freePhaseLimit) - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  } else {
    generated := generated + [next];
    if next == "<<" {
      // Model naturally opened a span — enter observed constrained span
      var eg, ei, ec := helpers.EnterObservedConstrainedSpan(lm, generated);
      generated := eg;
      insideConstrainedOut := ei;
      currentConstrainedOut := ec;
    }
  }
}

// Phase 1: If we exhausted freePhaseLimit without entering constrained mode,
// force open the constrained span now (if budget allows)
if !insideConstrainedOut && steps < maxSteps && steps + 2 <= maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Fill the constrained span with grounded unit generation
if insideConstrainedOut && steps < maxSteps {
  var rem := maxSteps - steps;
  // Reserve 1 step for CloseConstrainedSpan
  if rem > 1 {
    var fillBudget := rem - 1;
    var perUnit := fillBudget / 4;
    if perUnit == 0 {
      perUnit := 1;
    }
    if perUnit > 0 {
      var stable := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stable;
      var filled := helpers.RegenerateUnitOnGroundingFailure(
        lm, parser, constrainedPrompt, currentConstrainedOut, eosToken,
        perUnit, 3, perUnit
      );
      generated := stable + filled;
      currentConstrainedOut := filled;
      // Account for steps used: we use up to 4 * perUnit steps
      var usedSteps := 4 * perUnit;
      if steps + usedSteps <= maxSteps {
        steps := steps + usedSteps;
      } else {
        steps := maxSteps;
      }
    }
  }
}

// Phase 3: Close the constrained span
// If we're inside the span and parser is complete, close it
if insideConstrainedOut && steps < maxSteps {
  if parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    // Try to complete the span with remaining budget
    var rem2 := maxSteps - steps;
    // Reserve 1 step for close
    var innerSteps: nat := 0;
    while innerSteps < rem2 && insideConstrainedOut
      invariant 0 <= innerSteps <= rem2
      invariant lm.ValidTokensIdsLogits()
      invariant !insideConstrainedOut ==> currentConstrainedOut == []
      invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
      invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
      invariant |generated| <= |generatedPrefix| + steps + innerSteps
      decreases rem2 - innerSteps
    {
      if parser.IsCompletePrefix(currentConstrainedOut) {
        if innerSteps + 1 <= rem2 {
          var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg2;
          insideConstrainedOut := ci2;
          currentConstrainedOut := cc2;
          innerSteps := innerSteps + 1;
        }
        break;
      } else {
        var constrainedPrompt2 := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next2 := helpers.AdaptiveConstrainedStep(
          lm, parser, constrainedPrompt2, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
        innerSteps := innerSteps + 1;
        if next2 == eosToken {
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next2);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
    if steps + innerSteps <= maxSteps {
      steps := steps + innerSteps;
    } else {
      steps := maxSteps;
    }
    // Final close attempt if still inside and parser is complete
    if insideConstrainedOut && parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
      var cg3, ci3, cc3 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg3;
      insideConstrainedOut := ci3;
      currentConstrainedOut := cc3;
      steps := steps + 1;
    }
  }
}

cost := steps;

