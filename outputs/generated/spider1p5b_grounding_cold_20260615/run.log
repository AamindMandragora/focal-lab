insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Output exactly: SQL: <<your SQL query here>>. Write valid SQL using only tables and columns from the schema. Single query, no explanation.");

var steps: nat := 0;
var freeSteps: nat := 0;
var maxFreeSteps: nat := 5;
// Reserve steps for closing: need 2 (rollback + close)
var closeReserve: nat := 2;

