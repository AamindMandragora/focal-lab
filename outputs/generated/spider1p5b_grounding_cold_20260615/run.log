Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the spider dataset.
// The strategy emits "SQL: " as a free prefix, then opens a constrained span
// with "<<" and fills it with a valid SQL query under hard parser control,
// using adaptive group boosting (from validTokenGroups) when the parser is
// narrow and repetition penalties to avoid loops.
// State tracked:
//   - insideConstrainedOut / currentConstrainedOut: whether we are inside <<...>>
//   - steps: token budget consumed so far
// Action selection:
//   - Outside the span: free generation until "<<" is observed or budget runs out
//   - Inside the span: if complete, close; otherwise use AdaptiveConstrainedStep
//     with group boosts for narrow states, plus RepetitionPenalty to reduce loops
//   - EOS terminates generation
// The SQL parser governs all tokens inside the span, so the output is always
// syntactically valid SQL.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Outside span: implication is vacuous. When next == "<<", we set
//     currentConstrainedOut := [] which satisfies IsValidPrefix([]) by precondition.
//   - CloseConstrainedSpan: sets insideConstrainedOut := false, making the implication vacuous.
//   - AdaptiveConstrainedStep: returns EOS or a parser-valid next token.
//     AppendConstrainedToken extends currentConstrainedOut by that token, preserving
//     IsValidPrefix by the helper's postcondition.
//   - SafeRepetitionPenaltyStep: same guarantees as ConstrainedStep — returns EOS or
//     parser-valid next token; AppendConstrainedToken preserves validity.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - Outside span: each iteration increments steps by 1 and appends at most one
//     token to generated, so the bound is maintained.
//   - CloseConstrainedSpan: increments steps by 1 and appends ">>" (one token),
//     so |generated| grows by at most 1 and steps grows by 1.
//   - Inside span constrained branch: each call increments steps by 1 and
//     AppendConstrainedToken appends one token to generated (or EOS breaks), so
//     the bound is maintained.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate a single valid SQL query. Output format: SQL: <<query>>. Use only tables and columns from the provided schema. No explanation.");

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next: Token;
    if validCount <= narrowThreshold {
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
      );
    } else {
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

