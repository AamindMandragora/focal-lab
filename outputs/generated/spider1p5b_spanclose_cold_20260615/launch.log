Strategy: // CSD_RATIONALE_BEGIN
// Key diagnosis from failures:
// 1. The model generates overly complex SQL with ORDER BY ... LIMIT huge_number, causing
//    the span to never close (hits max steps budget).
// 2. The parser grammar allows this runaway generation.
// 3. Three examples timed out because the constrained span kept accepting tokens (the
//    huge LIMIT number digits) without ever reaching a complete state.
//
// Root cause: The constrained loop has no hard token-count limit on span length.
// The SQL grammar apparently treats "LIMIT <integer>" as valid continuation, and the
// model keeps appending digits for a huge number like 100000000...
//
// Fix strategy:
// - Add a hard cap on the number of tokens generated inside the constrained span.
//   Once we've generated ~80 tokens inside the span, force CloseSpanWithinBudget
//   to try to close what we have, rather than keep generating.
// - Use CloseSpanWithinBudget with a generous budget for the final close.
// - Keep the two-phase approach (UnconstrainedChunk to emit "SQL: <<", then
//   constrained generation) but limit span length aggressively.
// - The "entered_constrained_mode_too_early" failure mode is actually fine — the model
//   emits "SQL: <<" very quickly, which is what we want. The issue is span length.
//
// The "malformed_constrained_content" example had a subquery with { } which might be
// outside the grammar. The grammar check already handles this via the parser.
//
// Revised plan:
// Phase 1: Short UnconstrainedChunk (budget ~3) to emit "SQL: <<"
// Phase 2: Constrained generation loop with a hard span-length cap of 60 tokens
//          using AdaptiveConstrainedStep (better quality) with dead-end detection.
//          After each token, check CloseSpanIfComplete. If span length reaches 60,
//          break out and use CloseSpanWithinBudget.
// Phase 3: CloseSpanWithinBudget with remaining budget.
//
// This should prevent the runaway digit generation and ensure spans close.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1 (UnconstrainedChunk): if stoppedOnOpen, EnterObservedConstrainedSpan sets
//     currentConstrainedOut := [] which is valid. If not stopped on open, we may call
//     OpenConstrainedSpan which also sets currentConstrainedOut := [].
//   Phase 2 (main loop): CloseSpanIfComplete either closes (implication vacuous, cc=[])
//     or is a no-op (leaves valid prefix unchanged). AdaptiveConstrainedStep returns
//     EOS or a parser-valid next token; AppendConstrainedToken preserves validity.
//   Phase 3 (CloseSpanWithinBudget): postcondition guarantees
//     insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Initially steps=0, generated=generatedPrefix: holds trivially.
//   Phase 1: UnconstrainedChunk by contract gives |generatedOut| <= |generated| +
//     stepsUsed; steps increases by stepsUsed. OpenConstrainedSpan appends 1 token,
//     costs 1 step.
//   Main loop invariant: each iteration consumes exactly 1 step (CloseSpanIfComplete
//     costs 1; AdaptiveConstrainedStep costs 1 + AppendConstrainedToken costs 0),
//     and appends at most 1 token to generated.
//   Phase 3: CloseSpanWithinBudget costs at most closeBudget steps and appends at
//     most closeBudget tokens; we set steps := steps + closeBudget.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Output SQL: <<QUERY>> with a concise valid SQL query. Keep the query simple and correct. Do not use ORDER BY with LIMIT unless necessary.");

var steps: nat := 0;

// Phase 1: Generate unconstrained to emit "SQL: <<"
// The model tends to emit "SQL: <<" very quickly (avg 1 token before <<).
// Use a small budget to get there.
if !insideConstrainedOut && steps < maxSteps {
  var chunkBudget := 5;
  if chunkBudget > maxSteps - steps {
    chunkBudget := maxSteps - steps;
  }
  var chunkGen, stoppedOnOpen, stoppedOnEos, chunkSteps := helpers.UnconstrainedChunk(
    lm, prompt, generated, chunkBudget, "<<", eosToken
  );
  steps := steps + chunkSteps;
  generated := chunkGen;
  if stoppedOnEos {
    cost := steps;
    return;
  }
  if stoppedOnOpen {
    var eg, ei, ec := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := eg;
    insideConstrainedOut := ei;
    currentConstrainedOut := ec;
  }
}

// Phase 1b: If still not inside span, force open one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Main constrained generation loop with hard span-length cap
// Cap at 70 tokens inside the span to prevent runaway digit generation.
// Reserve enough budget for CloseSpanWithinBudget at the end.
var spanTokensGenerated: nat := 0;
var spanTokenCap: nat := 70;

while steps < maxSteps && insideConstrainedOut && spanTokensGenerated < spanTokenCap
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Reserve budget for closing (need at least 30 steps for CloseSpanWithinBudget)
  if steps + 30 >= maxSteps {
    break;
  }

  // Try to close if complete - costs 1 step
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    break;
  } else {
    // Generate next constrained token adaptively
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
    );
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
      spanTokensGenerated := spanTokensGenerated + 1;
    }
  }
}

// Phase 3: If still inside constrained span, use CloseSpanWithinBudget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  if closeBudget > 100 {
    closeBudget := 100;
  }
  var fg, fi, fc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := fg;
  insideConstrainedOut := fi;
  currentConstrainedOut := fc;
  steps := steps + closeBudget;
}

cost := steps;

