    var cg, ci, cc := helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
    );
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := maxSteps;
    break;
  }

  // Try to close if the span is already complete.
  var cg2, ci2, cc2, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  if closed {
    generated := cg2;
    insideConstrainedOut := ci2;
    currentConstrainedOut := cc2;
  } else {
    // Generate one constrained token.
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];

    // Alternate between repetition-penalty step and adaptive step to reduce loops.
    var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 5);
    var next: Token;
    if narrow {
      // Very narrow state: use group boosting to escape.
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 6.0, eosToken
      );
    } else {
      // Normal state: adaptive step with schema groups + repetition penalty.
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
    }
    steps := steps + 1;

    if next == eosToken {
      // EOS inside span: try to close what we have.
      var closeBudget2 := maxSteps - steps;
      if closeBudget2 > 0 {
        var cg3, ci3, cc3 := helpers.CloseSpanWithinBudget(
          lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget2
        );
        generated := cg3;
        insideConstrainedOut := ci3;
        currentConstrainedOut := cc3;
        steps := maxSteps;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

