Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the spider dataset (improved from best attempt).
//
// Key changes over the best attempt (accuracy 39.3%, syntax 79.7%):
// 1. The main failure mode was "no_span_emitted" (86 examples) and
//    "entered_constrained_mode_too_early" (144 examples). The model was either
//    generating SQL without the "<<" delimiter or entering the constrained span
//    before writing "SQL: ".
//
// 2. Root cause: the unconstrained phase was letting the model freely generate
//    "SQL: " plus more text, but "<<" was either never emitted or emitted
//    immediately (before "SQL: ").
//
// 3. Fix: Use UnconstrainedChunk with "<<" as the open-span token to let the
//    model naturally produce "SQL: <<" as a unit. This reduces the chance of
//    early entry or missing the delimiter. If after the chunk the span is open,
//    proceed with constrained generation. If the span wasn't opened within the
//    chunk, try a second bounded unconstrained phase.
//
// 4. Inside the span: use AdaptiveConstrainedStep with validTokenGroups for
//    schema grounding, plus SafeRepetitionPenaltyStep to avoid loops. After
//    every constrained token, check if we can close with CloseSpanIfComplete.
//
// 5. Use RegenerateUnitOnGroundingFailure to fix semantic errors (wrong table/
//    column names) – the "syntax_valid_semantic_mismatch" (128 examples) is the
//    largest remaining failure mode.
//
// 6. Budget: maxSteps=1200, stepTokenBudget=1. We reserve a close budget of 5
//    steps via CloseSpanWithinBudget if we run close to the end.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside-span branch (UnconstrainedChunk): if stoppedOnOpenSpan is true,
//     generatedOut already ends with "<<", and we call EnterObservedConstrainedSpan
//     which sets currentConstrainedOut := [] (valid by precondition). Otherwise
//     insideConstrainedOut remains false (implication vacuous).
//   CloseSpanIfComplete branch: either closes the span (insideConstrainedOut
//     becomes false, implication vacuous, currentConstrainedOut := []) or is a
//     no-op leaving the valid prefix unchanged.
//   RegenerateUnitOnGroundingFailure branch: returns a parser-valid
//     currentConstrainedOut by contract; AppendConstrainedToken not needed since
//     currentConstrainedOut is directly updated to the returned value (which
//     satisfies IsValidPrefix). We reconstruct generated from stable prefix + result.
//   AdaptiveConstrainedStep branch: returns EOS or a parser-valid extension;
//     AppendConstrainedToken preserves parser validity.
//   CloseSpanWithinBudget at end: postcondition guarantees insideOut ==>
//     parser.IsValidPrefix(currentOut).
//
// progress:
//   UnconstrainedChunk: costs stepsUsed <= maxChunkTokens steps, grows generated
//     by at most stepsUsed tokens. steps += stepsUsed.
//   CloseSpanIfComplete: costs 1 step, grows generated by at most 1 (the ">>").
//   RegenerateUnitOnGroundingFailure: costs bounded amount, we track via stepsUsed.
//   AdaptiveConstrainedStep + AppendConstrainedToken: costs 1 step, grows by 1.
//   CloseSpanWithinBudget: costs at most closeBudget steps by contract.
//   In all cases |generated| <= |generatedPrefix| + steps is preserved because
//   each step consumed corresponds to at most one appended token.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Output exactly one valid SQL query in the format: SQL: <<query>>. The query must use only tables and columns from the schema. No explanation, no markdown, no semicolons.");

var steps: nat := 0;

// Phase 1: Generate unconstrained until we see "<<" opening a span.
// Use UnconstrainedChunk to naturally emit "SQL: <<" as a unit.
if !insideConstrainedOut && steps < maxSteps {
  var chunkBudget := 40;
  if chunkBudget > maxSteps - steps {
    chunkBudget := maxSteps - steps;
  }
  var chunkGen, stoppedOnOpen, stoppedOnEos, chunkSteps := helpers.UnconstrainedChunk(
    lm, prompt, generated, chunkBudget, "<<", eosToken
  );
  steps := steps + chunkSteps;
  generated := chunkGen;
  if stoppedOnEos {
    cost := steps;
    return;
  }
  if stoppedOnOpen {
    // "<<" was naturally emitted; enter the constrained span state
    var eg, ei, ec := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := eg;
    insideConstrainedOut := ei;
    currentConstrainedOut := ec;
  }
}

// Phase 1b: If still not inside span, try one more unconstrained chunk
if !insideConstrainedOut && steps < maxSteps {
  var chunkBudget2 := 20;
  if chunkBudget2 > maxSteps - steps {
    chunkBudget2 := maxSteps - steps;
  }
  var chunkGen2, stoppedOnOpen2, stoppedOnEos2, chunkSteps2 := helpers.UnconstrainedChunk(
    lm, prompt, generated, chunkBudget2, "<<", eosToken
  );
  steps := steps + chunkSteps2;
  generated := chunkGen2;
  if stoppedOnEos2 {
    cost := steps;
    return;
  }
  if stoppedOnOpen2 {
    var eg2, ei2, ec2 := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := eg2;
    insideConstrainedOut := ei2;
    currentConstrainedOut := ec2;
  }
}

// Phase 1c: If still not in constrained span, force open one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Use RegenerateUnitOnGroundingFailure for semantic grounding
// This fixes the "syntax_valid_semantic_mismatch" failure mode
if insideConstrainedOut && steps < maxSteps {
  var groundBudget := maxSteps - steps;
  if groundBudget > 800 {
    groundBudget := 800;
  }
  // Reserve some budget for closing
  if groundBudget > maxSteps - steps - 5 {
    if maxSteps - steps >= 5 {
      groundBudget := maxSteps - steps - 5;
    } else {
      groundBudget := 0;
    }
  }
  if groundBudget > 0 {
    var resultConstrained := helpers.RegenerateUnitOnGroundingFailure(
      lm, parser, prompt, currentConstrainedOut, eosToken,
      20, 3, 10
    );
    // Reconstruct generated: stable prefix + new currentConstrained
    var stableLen := |generated| - |currentConstrainedOut|;
    var stablePrefix := generated[..stableLen];
    currentConstrainedOut := resultConstrained;
    generated := stablePrefix + currentConstrainedOut;
    // Charge a bounded cost for the grounding step
    var charged := |resultConstrained| - |currentConstrained|;
    if charged < 0 { charged := 0; }
    if charged > groundBudget { charged := groundBudget; }
    steps := steps + charged;
  }
}

// Phase 3: Main constrained generation loop with adaptive steps
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Reserve budget for closing
  if steps + 5 >= maxSteps {
    break;
  }

  // Try to close if complete
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    break;
  } else {
    // Generate next constrained token with adaptive group boosts and repetition penalty
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next := eosToken;
    if validCount <= 15 {
      // Narrow: use group boosts to prefer schema-relevant tokens
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, 15, eosToken
      );
    } else {
      // Wide: use repetition penalty to avoid loops
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
    }
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Phase 4: If still inside constrained span, use CloseSpanWithinBudget to
// bring span to completion and close it
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  if closeBudget > 50 {
    closeBudget := 50;
  }
  var fg, fi, fc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := fg;
  insideConstrainedOut := fi;
  currentConstrainedOut := fc;
  steps := steps + closeBudget;
}

cost := steps;

