Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the spider dataset.
// Strategy: emit the fixed prefix "SQL: " as unconstrained tokens, then open a
// constrained span "<<" and generate the SQL query body under full parser
// control. We use AdaptiveConstrainedStep with the caller-supplied token groups
// to softly prefer schema-grounded tokens while the hard parser mask guarantees
// grammar validity. RepetitionPenalty discourages token loops. Once the parser
// reaches a complete state we close the span with CloseSpanIfComplete and stop.
// State tracked: insideConstrainedOut / currentConstrainedOut track whether we
// are inside the SQL span; steps counts budget consumed.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside the span: the implication is vacuously true (insideConstrainedOut
//   is false). When next == "<<" we set currentConstrainedOut := [], which
//   parser.IsValidPrefix([]) holds by precondition. EnterObservedConstrainedSpan
//   preserves this.
//   Inside the span, CloseSpanIfComplete either closes the span (making
//   insideConstrainedOut false, so the implication is vacuous) or is a no-op.
//   AdaptiveConstrainedStep returns EOS or a parser-valid extension; AppendConstrainedToken
//   preserves parser validity by appending only a valid-next token.
//   SafeRepetitionPenaltyStep similarly returns EOS or a parser-valid token.
// progress:
//   Every branch increments steps by 1 and appends at most one token to
//   generated, so |generated| <= |generatedPrefix| + steps is maintained.
//   The CloseSpanIfComplete branch costs 1 step and appends at most one ">>"
//   token. The constrained branch costs 1 step and appends at most one token
//   via AppendConstrainedToken. EOS terminates the loop without appending.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Output exactly one valid SQL query. Format: SQL: <<query>>. Use only tables and columns from the schema. No explanation.");

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        var eg, ei, ec := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := eg;
        insideConstrainedOut := ei;
        currentConstrainedOut := ec;
      }
    }
  } else {
    // Try to close if complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      break;
    } else {
      // Generate next constrained token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

