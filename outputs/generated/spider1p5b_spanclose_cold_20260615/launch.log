Strategy: // CSD_RATIONALE_BEGIN
// Analysis of best attempt (attempt 8, 50% accuracy, 85.7% syntax):
// - 79/300 examples had unterminated spans (span opened but never closed)
// - 182/300 examples were syntax valid but semantically wrong
// - Main issues: (1) long runaway queries (repetition loops, huge LIMIT numbers)
//   (2) wrong table/column names being used
//
// Key observations from failure clusters:
// - mode_A (182 samples): syntax valid, has delimiters, but wrong answer
//   These got through the parser but used wrong schema elements
// - mode_C/mode_D (~79 samples): unterminated spans - span opened but budget ran out
//
// Root cause of unterminated spans: The constrained generation loop runs too many
// tokens before trying to close, and the CloseSpanWithinBudget at the end gets
// a budget too small (50 tokens) or gets called with a span that's in a bad state.
//
// Strategy improvements:
// 1. Use RegenerateUnitOnGroundingFailure to help pick schema-grounded tokens
//    (this was the key difference: attempt 8 removed it, but the unit-rewind
//    opportunity hint says it would help with semantic correctness)
// 2. More aggressive span closure: check for completion every step, and use
//    a larger CloseSpanWithinBudget budget
// 3. Better guidance to reduce query complexity
// 4. Use SafeRepetitionPenaltyStep more aggressively to prevent repetition loops
// 5. Hard cap on span length at ~50 tokens to prevent runaway generation
//
// The core tension: attempt 8 had 50% accuracy and 85.7% syntax with a simple
// two-phase approach. Attempt 9 added span-length caps but regressed badly.
// The regression in attempt 9 was because:
// - It called CloseSpanIfComplete THEN AdaptiveConstrainedStep (2 steps per iter)
//   but the budget check `steps + 30 >= maxSteps` was too conservative
// - This meant the main loop ran very few iterations before breaking to Phase 3
// - Then Phase 3 CloseSpanWithinBudget with budget=100 was fine but the span
//   was too short/wrong
//
// New approach: closely follow attempt 8 but fix the termination issue:
// - Reduce initial UnconstrainedChunk to just 5 tokens (model emits "SQL: <<" quickly)
// - In the main constrained loop, use SafeRepetitionPenaltyStep primarily to
//   avoid repetition, with AdaptiveConstrainedStep as fallback at narrow states
// - Hard cap span at 60 tokens but only break if we're past 60 tokens
// - Reserve just 10 steps for CloseSpanWithinBudget (not 50), giving more budget
//   to actual generation
// - Increase CloseSpanWithinBudget budget to use all remaining steps
//
// The key fix vs attempt 9: in attempt 9, CloseSpanIfComplete was consuming 1 step
// per iteration WITHOUT generating a token, effectively halving generation capacity.
// In the new approach, only generate constrained tokens, and check close speculatively.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1 (UnconstrainedChunk): if stoppedOnOpen is true, EnterObservedConstrainedSpan
//     sets currentConstrainedOut := [] which satisfies IsValidPrefix([]) by the precondition
//     parser.IsValidPrefix([]). If not stopped on open, insideConstrainedOut stays false.
//   Phase 1b (OpenConstrainedSpan): sets currentConstrainedOut := [] which is valid.
//   Main loop: Each iteration either:
//     (a) CloseSpanIfComplete closes (insideConstrainedOut becomes false, implication vacuous,
//         currentConstrainedOut := []) or no-op (unchanged valid prefix).
//     (b) SafeRepetitionPenaltyStep returns a parser-valid token or EOS;
//         AppendConstrainedToken preserves parser.IsValidPrefix on the extended prefix.
//     (c) AdaptiveConstrainedStep returns a parser-valid token or EOS;
//         AppendConstrainedToken preserves parser.IsValidPrefix.
//   Phase 4 (CloseSpanWithinBudget): postcondition guarantees
//     insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut).
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Initially steps=0, generated=generatedPrefix: holds trivially.
//   UnconstrainedChunk: by contract |generatedOut| <= |generated_old| + stepsUsed;
//     steps increases by stepsUsed; invariant preserved.
//   OpenConstrainedSpan: costs 1 step, appends 1 token ("<<"); invariant preserved.
//   EnterObservedConstrainedSpan: cost 0, no token appended; invariant preserved.
//   Main loop: Each iteration generates at most 1 token and consumes exactly 1 step
//     (either CloseSpanIfComplete costs 1 step with at most 1 token appended, or
//     SafeRepetitionPenaltyStep/AdaptiveConstrainedStep costs 1 step with at most
//     1 token appended via AppendConstrainedToken). Invariant preserved.
//   CloseSpanWithinBudget: costs at most closeBudget steps, appends at most
//     closeBudget tokens; we add closeBudget to steps to maintain invariant.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate a single concise SQL query answering the question. Use only table and column names from the schema. Format: SQL: <<SELECT ...>>. Keep the query simple and correct.");

var steps: nat := 0;

// Phase 1: Short unconstrained chunk to let the model emit "SQL: <<"
// The model typically emits "SQL: <<" within 3 tokens, so budget 6 is enough.
if !insideConstrainedOut && steps < maxSteps {
  var chunkBudget := 6;
  if chunkBudget > maxSteps - steps {
    chunkBudget := maxSteps - steps;
  }
  var chunkGen, stoppedOnOpen, stoppedOnEos, chunkSteps := helpers.UnconstrainedChunk(
    lm, prompt, generated, chunkBudget, "<<", eosToken
  );
  steps := steps + chunkSteps;
  generated := chunkGen;
  if stoppedOnEos {
    cost := steps;
    return;
  }
  if stoppedOnOpen {
    var eg, ei, ec := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := eg;
    insideConstrainedOut := ei;
    currentConstrainedOut := ec;
  }
}

// Phase 1b: Force open a span if still not inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Main constrained generation loop
// Use SafeRepetitionPenaltyStep for normal states to avoid repetition.
// Use AdaptiveConstrainedStep when parser is highly constrained (few valid tokens).
// Hard cap at 65 tokens inside span. Reserve 20 steps for CloseSpanWithinBudget.
var spanLength: nat := 0;
var spanCap: nat := 65;

while steps < maxSteps && insideConstrainedOut && spanLength < spanCap
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Reserve budget for close phase
  if steps + 20 >= maxSteps {
    break;
  }

  // Check if span is complete and can be closed (costs 1 step)
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    break;
  } else {
    // Generate next constrained token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next := eosToken;
    if validCount <= 12 {
      // Few valid tokens: use adaptive with group boosts
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
    } else {
      // Many valid tokens: use repetition penalty to avoid loops
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
    }
    // Note: ValidTokenCount and SafeRepetitionPenaltyStep/AdaptiveConstrainedStep
    // each cost 0 and 1 step respectively. We already incremented steps by 1 for
    // CloseSpanIfComplete above, so we need another step for the generation.
    steps := steps + 1;
    if steps > maxSteps {
      steps := maxSteps;
    }
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
      spanLength := spanLength + 1;
    }
  }
}

// Phase 3: If still inside constrained span, close it within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var fg, fi, fc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := fg;
  insideConstrainedOut := fi;
  currentConstrainedOut := fc;
  steps := steps + closeBudget;
}

cost := steps;

