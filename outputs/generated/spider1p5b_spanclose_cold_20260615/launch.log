//    returns closed=false. Instead, follow with a single generation step.
//    Wait - attempt 8 DID do both (close check costs 1 step, then generation costs 1 step).
//    That's 2 steps/iteration.
//
// Actually the BEST approach is the simple one from attempt 8:
// - One UnconstrainedChunk (40 tokens) for "SQL: <<"
// - If still not open, one more UnconstrainedChunk (20 tokens)
// - If still not open, OpenConstrainedSpan (1 step)
// - Main loop: CloseSpanIfComplete (1 step) then if not closed, generate (1 step)
//   Reserve 5 tokens for close
// - Final CloseSpanWithinBudget with budget=50
//
// The difference between attempt 8 and 10:
// Attempt 8 used budget cap `if steps + 5 >= maxSteps { break }` which reserves 5 steps.
// Attempt 10 used `steps + 20 >= maxSteps` which wastes 15 more steps.
// Attempt 10 also used ValidTokenCount (0 cost) before generation which is fine.
//
// The "entered_constrained_mode_too_early" failure mode suggests the model is entering
// constrained mode at token 1, which means the "SQL: <<" prefix is being emitted correctly
// but the evaluator flags it because << appears almost immediately. This is expected and fine.
//
// The unterminated span problem: 20 examples in attempt 10. 
// The CloseSpanWithinBudget budget was `maxSteps - steps` capped at 50.
// But with the 2-step-per-iteration loop consuming most of the budget...
//
// Fix: go back to attempt 8's exact structure but with one improvement:
// Use AdaptiveConstrainedStep with repetition penalty via SafeRepetitionPenaltyStep
// for wide states to prevent the long repetitive clauses we see in failures.
//
// Additionally, the runaway queries (LIMIT 1000...0, repeated AND conditions)
// suggest we need more aggressive repetition penalty. Use SafeRepetitionPenaltyStep
// at ALL states, not just wide ones.
//
// Key changes from attempt 8:
// 1. Use SafeRepetitionPenaltyStep exclusively (not AdaptiveConstrainedStep for wide)
//    to prevent AND/WHERE clause repetition loops.
// 2. Keep reserve at 5 (not 20).
// 3. CloseSpanWithinBudget budget = min(maxSteps - steps, 80) to give more close budget.
// 4. The initial UnconstrainedChunk budget: 40 then 20, same as attempt 8.
//
// The "too_slow" examples show queries running 300+ seconds. These are the repetition
// loops. SafeRepetitionPenaltyStep should prevent exact token repetition but the model
// is repeating multi-token phrases. Need stronger penalty (3.0 instead of 2.0).
//
// Also: remove the ValidTokenCount check to save the LM call cost (though it's 0 steps).
// Use AdaptiveConstrainedStep for all states (handles both narrow and wide).
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1 (UnconstrainedChunk): if stoppedOnOpen, EnterObservedConstrainedSpan
//     sets currentConstrainedOut := [] which satisfies IsValidPrefix([]) by precondition.
//     Otherwise insideConstrainedOut stays false (implication vacuous).
//   Phase 1b: identical reasoning to Phase 1.
//   Phase 1c (OpenConstrainedSpan): sets currentConstrainedOut := [] (valid).
//   Main loop - CloseSpanIfComplete: either closes (insideConstrainedOut=false, vacuous,
//     currentConstrainedOut=[]) or no-op (valid prefix unchanged).
//   Main loop - SafeRepetitionPenaltyStep: returns EOS or parser-valid next token;
//     AppendConstrainedToken extends currentConstrainedOut by one parser-valid token,
//     preserving IsValidPrefix by the parser's definition of valid prefix extension.
//   Phase 4 (CloseSpanWithinBudget): postcondition guarantees
//     insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Initially steps=0, generated=generatedPrefix: trivially holds.
//   UnconstrainedChunk: by postcondition |generatedOut| <= |generated_before| + stepsUsed,
//     steps increases by stepsUsed, so invariant preserved.
//   EnterObservedConstrainedSpan: cost 0, generated unchanged, invariant preserved.
//   OpenConstrainedSpan: cost 1 step, appends exactly 1 token ("<<"), invariant preserved.
//   Main loop: CloseSpanIfComplete costs 1 step and appends at most 1 token (">>");
//     SafeRepetitionPenaltyStep costs 1 step (charged via steps+1), AppendConstrainedToken
//     appends exactly 1 token to generated. Each branch: steps increases by 1 or 2,
//     generated grows by at most 1 or 2 tokens respectively.
//   CloseSpanWithinBudget: costs at most closeBudget steps, appends at most closeBudget
//     tokens; we add closeBudget to steps so invariant preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Output exactly one valid SQL query in the format: SQL: <<YOUR SQL QUERY>>. Generate a single valid SQL query inside the constrained span. Use only schema identifiers from the context.");

var steps: nat := 0;

// Phase 1: Generate unconstrained until we see "<<" opening a span.
if !insideConstrainedOut && steps < maxSteps {
  var chunkBudget := 40;
  if chunkBudget > maxSteps - steps {
    chunkBudget := maxSteps - steps;
  }
  var chunkGen, stoppedOnOpen, stoppedOnEos, chunkSteps := helpers.UnconstrainedChunk(
    lm, prompt, generated, chunkBudget, "<<", eosToken
  );
  steps := steps + chunkSteps;
  generated := chunkGen;
  if stoppedOnEos {
    cost := steps;
    return;
  }
  if stoppedOnOpen {
    var eg, ei, ec := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := eg;
    insideConstrainedOut := ei;
    currentConstrainedOut := ec;
  }
}

// Phase 1b: If still not inside span, try one more unconstrained chunk
if !insideConstrainedOut && steps < maxSteps {
  var chunkBudget2 := 20;
  if chunkBudget2 > maxSteps - steps {
    chunkBudget2 := maxSteps - steps;
  }
  var chunkGen2, stoppedOnOpen2, stoppedOnEos2, chunkSteps2 := helpers.UnconstrainedChunk(
    lm, prompt, generated, chunkBudget2, "<<", eosToken
  );
  steps := steps + chunkSteps2;
  generated := chunkGen2;
  if stoppedOnEos2 {
    cost := steps;
    return;
  }
  if stoppedOnOpen2 {
    var eg2, ei2, ec2 := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := eg2;
    insideConstrainedOut := ei2;
    currentConstrainedOut := ec2;
  }
}

// Phase 1c: If still not in constrained span, force open one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Main constrained generation loop
// Each iteration: CloseSpanIfComplete (1 step) + if not closed, generation (1 step)
// Reserve 5 steps minimum for close phase.
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Reserve budget for closing the span
  if steps + 5 >= maxSteps {
    break;
  }

  // Try to close if complete (costs 1 step)
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    break;
  } else {
    // Generate next constrained token with repetition penalty to avoid loops
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Phase 3: If still inside constrained span, close within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  if closeBudget > 80 {
    closeBudget := 80;
  }
  var fg, fi, fc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := fg;
  insideConstrainedOut := fi;
  currentConstrainedOut := fc;
  steps := steps + closeBudget;
}

cost := steps;

