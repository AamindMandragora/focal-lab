Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the Spider dataset.
// The strategy emits "SQL: <<" as a fixed prefix (unconstrained), then opens a
// constrained span that uses the SQL parser to hard-control every token inside
// the span. Inside the span we use AdaptiveConstrainedStep with the caller-
// supplied validTokenGroups (which carry schema-specific tokens) boosted when
// the parser is narrow, so table/column names from the schema are preferred.
// We also apply a repetition penalty to avoid re-generating the same tokens.
// CloseSpanIfComplete checks after every token whether the parser accepts the
// span as complete; once it does, the span is closed with ">>".
// State tracked: generated (full visible output), insideConstrainedOut (are we
// inside <<...>>), currentConstrainedOut (the SQL content built so far), steps
// (token budget consumed), cost (set at end).
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   Outside-span branch: implication is vacuous (!insideConstrainedOut). When
//     next == "<<" we set currentConstrainedOut := [], which satisfies
//     parser.IsValidPrefix([]) by precondition. insideConstrainedOut becomes true
//     only simultaneously, so the implication is satisfied.
//   CloseSpanIfComplete branch (closed == true): insideConstrainedOut is set to
//     false, making the implication vacuous. (closed == false): state unchanged,
//     invariant holds by induction.
//   AdaptiveConstrainedStep branch: the helper guarantees it returns EOS or a
//     parser-valid next token. AppendConstrainedToken extends currentConstrainedOut
//     by exactly that token, so parser.IsValidPrefix(currentConstrainedOut) is
//     preserved by the parser's prefix-extension monotonicity.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   Outside-span branch: generated grows by at most 1, steps grows by 1.
//   CloseSpanIfComplete when closed: generated grows by 1 (">>" appended),
//     steps grows by 1. When not closed: steps grows by 1, generated unchanged.
//   AdaptiveConstrainedStep branch: steps grows by 1, AppendConstrainedToken
//     grows generated by exactly 1. EOS path: steps grows by 1, generated
//     unchanged. Both preserve the bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Append guidance to steer the model toward valid SQL output
helpers.AppendTaskGuidance(lm, "Generate a single valid SQL query. Output format: SQL: <<query>>. Use only tables and columns from the provided schema.");

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Free generation until we observe "<<"
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    // Inside the constrained SQL span
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      // Span complete and closed, stop generation
      break;
    } else {
      // Generate the next SQL token using adaptive constrained step
      // Use the stable prefix (everything before the constrained content) as the prompt
      var stableLen := |generated| - |currentConstrainedOut|;
      var constrainedPrompt := prompt + generated[..stableLen];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut,
        validTokenGroups, 4.0, narrowThreshold, eosToken
      );
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

