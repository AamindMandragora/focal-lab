Strategy: // CSD_RATIONALE_BEGIN
// Strategy: Use AdaptiveConstrainedStep inside a constrained span loop.
// We generate SQL for the spider dataset using hard parser control with
// adaptive group boosts. The loop runs until maxSteps is exhausted or EOS.
// Each iteration calls AdaptiveConstrainedStep (+1 step) and AppendConstrainedToken (+0).
// We track steps carefully: each LM-consuming call increments steps by 1.
// CloseSpanIfComplete costs +1 when it closes, +0 otherwise.
// We use a simple flat loop: generate tokens constrained to parser validity.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// Invariant 1 (parser_validity):
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - AppendConstrainedToken preserves parser validity by contract: it only appends
//     tokens that were returned by AdaptiveConstrainedStep, which hard-masks to
//     parser-valid next tokens. So after each AppendConstrainedToken call,
//     currentConstrainedOut remains a valid parser prefix.
//   - CloseSpanIfComplete sets insideConstrainedOut=false and currentConstrainedOut=[]
//     when closed, so the implication holds trivially on that branch.
//   - When closed=false, state is unchanged, so invariant is preserved.
//
// Invariant 2 (progress):
//   |generated| <= |generatedPrefix| + steps
//   - AdaptiveConstrainedStep consumes +1 step (costs a token-step) but does NOT
//     append to generated. AppendConstrainedToken appends exactly 1 token to generated
//     but costs +0. Together they contribute +1 to steps and +1 to |generated|, preserving
//     the bound: |generated| + 1 <= |generatedPrefix| + (steps + 1).
//   - CloseSpanIfComplete when it closes costs +1 step and appends ">>" (+1 to generated),
//     so both sides increase by 1, preserving the bound.
//   - CloseSpanIfComplete when it does NOT close costs +0 and appends nothing,
//     so the bound is trivially preserved.
// CSD_PROOF_SKETCH_END

{
  generated := generatedPrefix;
  insideConstrainedOut := insideConstrained;
  currentConstrainedOut := currentConstrained;
  cost := 0;

  helpers.AppendTaskGuidance(lm, "Generate valid SQL for the spider dataset. Use hard parser-constrained decoding.");

  var steps := 0;

  while steps < maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant |generated| <= |generatedPrefix| + steps
    invariant steps <= maxSteps
    decreases maxSteps - steps
  {
    if insideConstrainedOut {
      // Try to close the span if complete
      var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
      if closed {
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
        cost := steps;
        break;
      }
      // Not yet complete: generate one more constrained token
      var next := helpers.AdaptiveConstrainedStep(lm, parser, prompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken);
      steps := steps + 1;
      if next == eosToken {
        cost := steps;
        break;
      }
      var ng, ni, nc := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ng;
      insideConstrainedOut := ni;
      currentConstrainedOut := nc;
    } else {
      // Outside constrained span: take one unconstrained step
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        cost := steps;
        break;
      }
      generated := generated + [next];
      // Check if we just emitted the open span delimiter
      if next == "<<" {
        var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := og;
        insideConstrainedOut := oi;
        currentConstrainedOut := oc;
      }
    }
    cost := steps;
  }

  cost := steps;
}

