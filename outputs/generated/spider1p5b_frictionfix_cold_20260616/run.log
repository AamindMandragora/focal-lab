Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for spider dataset — revised to fix unterminated spans.
//
// Root cause analysis from attempt 2:
//   - 6/9 examples: span opened but never closed (budget exhausted inside span)
//   - 3/9 examples: no span emitted at all
//   - The model generates very long repetitive SQL inside the span (hundreds of tokens)
//     before the parser can recognize it as complete, exhausting the budget.
//
// Key insight: The "repetition loop" failure (e.g., GROUP BY repeated 100+ times)
// is the primary cause of timeout and unterminated spans. The parser allows these
// repetitions because SQL GROUP BY with multiple columns is valid grammar.
// We need aggressive repetition penalty to prevent this.
//
// Strategy:
//   Phase 1: Generate unconstrained until "<<" is observed (up to 10 tokens).
//   If "<<" not observed, force open with OpenConstrainedSpan.
//   Phase 2: Inside span, use SafeRepetitionPenaltyStep to strongly discourage
//   repeating tokens already in the generated output. This prevents the
//   endless GROUP BY repetition loop. Check CloseSpanIfComplete each step.
//   Reserve budget: if steps > maxSteps - 5, use CloseSpanWithinBudget.
//
// The best attempt (26% accuracy, 57% syntax) used AdaptiveConstrainedStep
// without repetition penalty. Adding strong repetition penalty should
// prevent the looping behavior that causes timeouts and unterminated spans.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   Phase 1 (unconstrained loop): insideConstrainedOut is false until next == "<<"
//   at which point currentConstrainedOut := [] and parser.IsValidPrefix([]) holds
//   by precondition. OpenConstrainedSpan also sets currentConstrainedOut := [].
//   Phase 2 (constrained loop): CloseSpanIfComplete either closes (making
//   implication vacuous) or is a no-op (preserving prior validity).
//   SafeRepetitionPenaltyStep returns EOS or a parser-valid token; 
//   AppendConstrainedToken extends currentConstrainedOut by that valid token,
//   preserving parser.IsValidPrefix. CloseSpanWithinBudget postcondition
//   guarantees insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut).
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: each UnconstrainedStep increments steps by 1, appends at most 1 token.
//   OpenConstrainedSpan increments steps by 1, appends exactly 1 token ("<<").
//   Phase 2: CloseSpanIfComplete costs 1 step, appends at most 1 token (">>").
//   SafeRepetitionPenaltyStep costs 1 step; AppendConstrainedToken appends 1 token.
//   CloseSpanWithinBudget with budget = maxSteps - steps satisfies
//   |generatedOut| <= |generated| + budget = |generatedPrefix| + maxSteps,
//   and we set steps := maxSteps after the call.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a single concise SQL query. Output exactly: SQL: <<SELECT ...>> using only tables and columns from the schema. Keep the query simple and direct. Do not repeat clauses.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate unconstrained until "<<" is observed
var phase1Limit: nat := 10;
while steps < maxSteps && steps < phase1Limit && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    cost := steps;
    return;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// If still not inside span, force open one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Inside constrained span — use repetition penalty to prevent loops
// Reserve 5 steps at the end for CloseSpanWithinBudget
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // If budget is almost exhausted, use CloseSpanWithinBudget and exit
  if steps + 5 >= maxSteps {
    var remainBudget := maxSteps - steps;
    var cg, ci, cc := helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, remainBudget
    );
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := maxSteps;
  } else {
    // Try to close if complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Use repetition penalty to prevent the looping behavior
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken
      );
      if next == eosToken {
        // Budget remaining — try to close within budget instead of breaking
        var remainBudget2 := maxSteps - steps;
        if remainBudget2 > 0 {
          var cg2, ci2, cc2 := helpers.CloseSpanWithinBudget(
            lm, parser, prompt, generated, currentConstrainedOut, eosToken, remainBudget2
          );
          generated := cg2;
          insideConstrainedOut := ci2;
          currentConstrainedOut := cc2;
          steps := maxSteps;
        }
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

