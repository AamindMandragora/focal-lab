Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for spider dataset.
//
// Two verification errors from previous attempt:
// 1. Progress postcondition: when maxSteps > 0 and we return early (EOS in phase 1),
//    cost > 0 so the postcondition holds. But Dafny couldn't verify this because
//    the early return had cost := steps where steps could be 0 if phase1Limit == 0.
//    Fix: ensure we always make progress when maxSteps > 0 before any return.
// 2. Invariant |currentConstrainedOut| <= |generated| broken in phase 2:
//    After CloseSpanWithinBudget call with remainBudget = maxSteps - steps,
//    we set steps := maxSteps but the invariant requires the relationship holds.
//    CloseSpanWithinBudget guarantees |generatedOut| <= |generated| + budget,
//    but doesn't directly guarantee |currentConstrainedOut| <= |generated|.
//    However it does guarantee insideOut ==> parser.IsValidPrefix(currentOut),
//    and we need |currentOut| <= |generatedOut|. This is a library postcondition
//    we need to use carefully.
//
// Root fix for invariant: The invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
// needs to hold after CloseSpanWithinBudget. The library guarantees this as a postcondition.
// The issue was that in the nested "else" branch after SafeRepetitionPenaltyStep returns EOS,
// we call CloseSpanWithinBudget with remainBudget2 = maxSteps - steps but steps was already
// incremented for the CloseSpanIfComplete call. This could violate the invariant if
// remainBudget2 computed from already-incremented steps is inconsistent.
//
// Simplified strategy: Use CloseSpanWithinBudget as the primary driver for the constrained
// phase, avoiding complex nested branching that confuses the verifier.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   Phase 1: insideConstrainedOut is false until next == "<<", which sets
//   currentConstrainedOut := [] and parser.IsValidPrefix([]) by precondition.
//   OpenConstrainedSpan also sets currentConstrainedOut := [].
//   Phase 2: We immediately call CloseSpanWithinBudget which has postcondition
//   insideOut ==> parser.IsValidPrefix(currentOut). After the call, the invariant holds.
//   We then exit the loop because steps := maxSteps.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: each UnconstrainedStep increments steps by 1, appends at most 1 visible token.
//   OpenConstrainedSpan increments steps by 1, appends exactly "<<" (1 token).
//   Phase 2: CloseSpanWithinBudget with budget = maxSteps - steps satisfies
//   |generatedOut| <= |generated| + budget = |generated| + (maxSteps - steps).
//   After the call, generated is updated and steps := maxSteps, so
//   |generated| <= |generatedPrefix| + maxSteps = |generatedPrefix| + steps. QED.
//
// progress postcondition (maxSteps == 0 || cost > 0 || ...):
//   If maxSteps > 0: Phase 1 runs at least one UnconstrainedStep (steps becomes >= 1),
//   or we force open a span (steps becomes 1), so cost = steps >= 1 > 0. This satisfies
//   the disjunct cost > 0.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Output format must be exactly: SQL: <<SELECT ...>> — a single SQL query inside << and >>. Do not use markdown, backticks, or explanations. Write only: SQL: <<your SQL query here>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate unconstrained until "<<" is observed (up to 12 tokens)
var phase1Limit: nat := 12;
while steps < maxSteps && steps < phase1Limit && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    cost := steps;
    return;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// If still not inside span, force open one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Use CloseSpanWithinBudget to handle the constrained generation
// and closing in one shot. This avoids complex nested branching.
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

