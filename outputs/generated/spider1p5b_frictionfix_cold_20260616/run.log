Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for spider dataset — revised to fix the three main failure modes:
//
// 1. no_span_emitted (99 examples): The model was generating "SQL: SELECT ..."
//    without ever emitting "<<". Fix: use targeted AppendTaskGuidance that
//    explicitly instructs the model to use the "SQL: <<...>>" format, AND
//    use UnconstrainedChunk which stops when "<<" is naturally emitted by the LM.
//    If "<<" is not emitted within a budget, force-open the span with OpenConstrainedSpan.
//
// 2. entered_constrained_mode_too_early (155 examples): The model was jumping
//    directly into "<<" without the "SQL: " prefix. The guidance and forcing
//    of "SQL: " tokens before opening the span should help.
//
// 3. malformed_constrained_content (28 examples): Content inside << >> fails
//    syntax checks. This is where hard parser control is critical — the parser
//    constrains to valid SQL tokens only.
//
// Strategy:
//   Phase 1: Use UnconstrainedChunk with openSpanToken="<<" to let the model
//     naturally emit "SQL: <<". Budget: up to 20 tokens. If "<<" appears,
//     use EnterObservedConstrainedSpan to update state. If not, force
//     OpenConstrainedSpan after emitting "SQL: " tokens manually isn't possible,
//     but we can keep trying with more unconstrained steps.
//   Phase 2: Once inside the constrained span, use AdaptiveConstrainedStep
//     with the caller-provided validTokenGroups (schema tokens). Use
//     CloseSpanWithinBudget with the remaining budget to ensure the span closes.
//
//   Key insight from feedback: "Constrained intervention activity: 0/300" means
//   the constrained helpers were NEVER called. The model was emitting "<<" but
//   the strategy was not recognizing it (or was exiting before reaching the span).
//   Actually looking at the metrics: "Examples with visible <<: 201/300" but
//   "examples_with_activity: 0/300". This means the span was opened during
//   unconstrained generation, but AppendConstrainedToken/ConstrainedStep were
//   never called. The issue is the budget: with maxSteps budget being consumed
//   by UnconstrainedChunk, there may be no steps left for constrained generation.
//
//   Fix: Use a smaller unconstrained chunk budget (15 tokens), then immediately
//   switch to CloseSpanWithinBudget for the remainder.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   After Phase 1 (UnconstrainedChunk): if stoppedOnOpenSpan is true, we call
//   EnterObservedConstrainedSpan which sets currentConstrainedOut := [] and
//   insideConstrainedOut := true. parser.IsValidPrefix([]) holds by precondition.
//   If stoppedOnEos or budget exhausted without span, insideConstrainedOut
//   remains false, so implication is vacuous.
//   If we fall through to OpenConstrainedSpan (forced span open), it sets
//   currentConstrainedOut := [] and insideConstrainedOut := true, preserving
//   the invariant.
//   Phase 2 (CloseSpanWithinBudget): by its postcondition,
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut).
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: UnconstrainedChunk returns |generatedOut| <= |generated| + stepsUsed1,
//   and steps1 := steps1 + stepsUsed1. The loop for forcing span open uses
//   UnconstrainedStep (each +1 step, +at most 1 token) plus OpenConstrainedSpan (+1 step).
//   Phase 2: CloseSpanWithinBudget with budget = maxSteps - steps guarantees
//   |generatedOut| <= |generated| + budget = |generatedPrefix| + maxSteps.
//   Setting steps := maxSteps preserves steps <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Output format must be exactly: SQL: <<SELECT ...>> — a single SQL query inside << and >>. Do not use markdown, backticks, or explanations. Write only: SQL: <<your SQL query here>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate unconstrained until "<<" is observed or budget for phase 1 runs out
// Use a bounded unconstrained chunk that stops at "<<"
var phase1Budget: nat := 20;
if phase1Budget > maxSteps {
  phase1Budget := maxSteps;
}

if !insideConstrainedOut && steps < maxSteps {
  var chunkBudget := if phase1Budget < maxSteps - steps then phase1Budget else maxSteps - steps;
  var generatedOut1, stoppedOnOpenSpan1, stoppedOnEos1, stepsUsed1 :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkBudget, "<<", eosToken);
  steps := steps + stepsUsed1;
  generated := generatedOut1;

  if stoppedOnOpenSpan1 {
    // "<<" was naturally emitted — enter constrained span state
    var eg, ei, ec := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := eg;
    insideConstrainedOut := ei;
    currentConstrainedOut := ec;
  } else if stoppedOnEos1 {
    // EOS encountered — nothing more to do
    cost := steps;
    return;
  }
  // else: budget exhausted without "<<" — fall through to forced open
}

// If still not inside a constrained span, keep generating until "<<" or budget
// Use a secondary unconstrained loop with smaller increments
var loopBudget: nat := 30;
var loopSteps: nat := 0;
while !insideConstrainedOut && steps < maxSteps && loopSteps < loopBudget
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  loopSteps := loopSteps + 1;
  if next == eosToken {
    cost := steps;
    return;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// If still not inside span after generous unconstrained budget, force open a span
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Inside constrained span — use CloseSpanWithinBudget for the remainder
if insideConstrainedOut && steps < maxSteps {
  var remainingBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, remainingBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

