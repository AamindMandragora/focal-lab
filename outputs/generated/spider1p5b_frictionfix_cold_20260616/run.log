Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the spider dataset.
// The task requires emitting exactly: SQL: <<YOUR QUERY>>
// Strategy:
//   1. AppendTaskGuidance to steer the model toward SQL output.
//   2. Phase 1 (unconstrained): generate freely until "<<" is observed,
//      building up the "SQL: " prefix naturally via LM continuation.
//   3. Phase 2 (constrained): once inside the span, use AdaptiveConstrainedStep
//      with the caller-supplied validTokenGroups (which may contain SQL keywords,
//      table/column names from the schema) to generate a valid SQL query.
//      Use RepetitionPenalty to avoid token repetition in SQL.
//      Check CloseSpanIfComplete each step to emit ">>" as soon as the parser
//      accepts the span as complete.
// State tracked: generated (full output), insideConstrainedOut (span state),
//   currentConstrainedOut (constrained span content), steps (budget tracking).
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   Phase 1 (unconstrained): The implication is vacuously true when
//   insideConstrainedOut is false. When next == "<<", we set
//   currentConstrainedOut := [], and parser.IsValidPrefix([]) holds by
//   precondition. So the invariant is preserved.
//   Phase 2 (constrained): CloseSpanIfComplete either closes the span
//   (setting insideConstrainedOut := false, making the implication vacuous, and
//   currentConstrainedOut := []) or is a no-op (leaving state unchanged, so
//   validity is preserved from the previous iteration). When not closed,
//   AdaptiveConstrainedStep returns either EOS or a parser-valid next token.
//   AppendConstrainedToken extends currentConstrainedOut by that valid token,
//   preserving parser.IsValidPrefix(currentConstrainedOut).
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: Each UnconstrainedStep increments steps by 1 and appends at most
//   one token to generated (EOS is not appended), so the bound holds.
//   Phase 2: CloseSpanIfComplete costs 1 step and appends at most one token
//   (the ">>" delimiter). AdaptiveConstrainedStep costs 1 step; if it returns
//   a non-EOS token, AppendConstrainedToken appends exactly one token. EOS
//   causes a break without appending. Both sub-cases preserve the invariant.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a single valid SQL query for the given database schema. Output format: SQL: <<YOUR QUERY>> where YOUR QUERY is a complete SQL SELECT statement using only tables and columns from the provided schema.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
      );
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

