Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with step-by-step reasoning and constrained symbolic expressions.
//
// State tracked:
//   - generated: full visible output including "<<" and ">>" delimiters
//   - insideConstrainedOut: whether we are currently inside a constrained span
//   - currentConstrainedOut: the parser-valid prefix of the active constrained span
//   - steps/cost: token budget consumed
//
// Strategy:
//   Phase 1 (outside span): Generate freely until the LM naturally emits "<<"
//     or until we detect that a constrained expression should be opened.
//     We use UnconstrainedStep and watch for "<<".
//   Phase 2 (inside span): Use AdaptiveConstrainedStep with group boosts for
//     mathematical token groups. When the parser reports the span is complete,
//     call CloseConstrainedSpan to emit ">>". We alternate between boosted and
//     adaptive steps depending on how narrow the parser state is.
//   EOS: If EOS is returned at any point, we stop.
//
// The "<<" / ">>" delimiters wrap intermediate symbolic expressions and the
// final numeric answer, as required by the gsm_symbolic task contract.
//
// Guidance steers the model to write step-by-step math reasoning with
// expressions and answers wrapped in << >> delimiters.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   !insideConstrainedOut ==> currentConstrainedOut == []
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//
//   Outside-span branch: UnconstrainedStep returns next. If next == "<<" we set
//     insideConstrainedOut := true and currentConstrainedOut := []. Since
//     parser.IsValidPrefix([]) holds by precondition, the invariant is preserved.
//     If next != "<<" we stay outside, implication is vacuous, invariant holds.
//
//   CloseConstrainedSpan branch: Requires IsCompletePrefix, which we check.
//     CloseConstrainedSpan returns insideConstrainedOut := false and
//     currentConstrainedOut := [], so !insideConstrainedOut ==>
//     currentConstrainedOut == [] is satisfied.
//
//   AdaptiveConstrainedStep branch: Returns EOS or a parser-valid next token.
//     If EOS, we break (no append). Otherwise AppendConstrainedToken appends
//     the token to both generated and currentConstrainedOut, preserving
//     parser.IsValidPrefix(currentConstrainedOut) by the helper's contract.
//
//   GroupBoostedConstrainedStep branch (narrow): Same as AdaptiveConstrainedStep
//     branch—returns EOS or parser-valid token, AppendConstrainedToken preserves
//     validity.
//
// progress invariant: |generated| <= |generatedPrefix| + steps
//   Every branch increments steps by exactly 1 and appends at most one visible
//   token to generated (or zero on EOS/close). CloseConstrainedSpan appends ">>"
//   (one token) and steps += 1. All constrained steps append at most one token
//   and steps += 1. UnconstrainedStep appends at most one token and steps += 1.
//   So |generated| - |generatedPrefix| <= steps throughout.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math word problem step by step. Show your work. Wrap each intermediate symbolic expression and the final answer inside << >> delimiters. For example: The total is <<3+4=7>> 7 dollars. Final answer: <<42>>.";
helpers.AppendTaskGuidance(lm, guidance);

var narrowThreshold: nat := 15;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next := eosToken;
    if validCount <= narrowThreshold {
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, eosToken
      );
    } else {
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

