Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD for gsm_symbolic task.
//
// The task requires wrapping intermediate symbolic expressions and the final
// answer inside << >> delimiters. The previous attempt scored 0% because 0
// examples were evaluated - this suggests a runtime issue, possibly the model
// never emitted "<<" naturally or the strategy was too slow.
//
// Revised strategy:
//   1. Use GenerateWithPrefixAndManagedSpan which handles the full loop with
//      built-in delimiter detection, constrained span management, and budget
//      control. This is a high-level helper that discharges proof obligations
//      internally and is less likely to time out.
//   2. Set a small prefixBudget (100 steps) to force entry into constrained
//      mode quickly if the model hasn't naturally opened a span.
//   3. Use a boost amount of 4.0 and narrow threshold of 12.
//   4. Append guidance to steer the model toward << >> formatted output.
//
// This approach is robust: if the LM doesn't emit "<<" in the first 100 tokens,
// GenerateWithPrefixAndManagedSpan forces a constrained span open and uses the
// remaining budget for parser-controlled content and closing ">>".
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   GenerateWithPrefixAndManagedSpan internally maintains the parser_validity
//   invariant. On return, insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   holds by the helper's postcondition.
//
// progress:
//   GenerateWithPrefixAndManagedSpan costs at most +maxSteps by its contract,
//   so cost <= maxSteps. If maxSteps > 0, the helper makes at least one step
//   of progress (either generating tokens or changing span state), satisfying
//   the progress postcondition.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math word problem step by step. For each calculation, wrap the expression and result inside << >> delimiters, like <<3+5=8>>. The final numeric answer must also be wrapped in << >> delimiters.";
helpers.AppendTaskGuidance(lm, guidance);

var prefixBudget: nat := 100;
if prefixBudget > maxSteps {
  prefixBudget := maxSteps;
}

var gOut, iOut, cOut := helpers.GenerateWithPrefixAndManagedSpan(
  lm, parser, prompt, generated, insideConstrainedOut, currentConstrainedOut,
  maxSteps, prefixBudget, validTokenGroups, 4.0, 12, eosToken
);
generated := gOut;
insideConstrainedOut := iOut;
currentConstrainedOut := cOut;
cost := maxSteps;

