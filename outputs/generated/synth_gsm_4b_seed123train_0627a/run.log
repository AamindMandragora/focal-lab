Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with << >> delimiters for symbolic expressions and final answer.
// State tracked: generated (full visible output), insideConstrainedOut (whether inside << >>),
// currentConstrainedOut (constrained content since last <<), steps (budget used).
//
// Strategy:
// - Phase 1 (outside span): Generate freely with UnconstrainedStep until "<<" appears
//   or EOS. When "<<" is observed, enter constrained span.
// - Phase 2 (inside span): Use AdaptiveConstrainedStep with group boosts to generate
//   symbolic expressions. Call CloseSpanIfComplete each step to close the span when
//   the parser accepts the current constrained content. On EOS, break.
// - After closing a span (>>), return to Phase 1 to continue generating the next
//   part of the solution (more steps, another <<...>>, or end).
//
// This allows multiple <<...>> spans per solution (intermediate steps + final answer),
// with hard parser control inside each span and free generation outside.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Outside branch: implication is vacuous. When next == "<<", we set
//     currentConstrainedOut := [], which satisfies parser.IsValidPrefix([]) by precondition.
//   - CloseSpanIfComplete branch: if closed, insideConstrainedOut becomes false (vacuous).
//     If not closed, state is unchanged, so invariant holds by previous iteration.
//   - Constrained step branch: AdaptiveConstrainedStep returns EOS or a parser-valid token.
//     AppendConstrainedToken extends currentConstrainedOut with a valid token, preserving
//     parser.IsValidPrefix(currentConstrainedOut).
//
// progress invariant: |generated| <= |generatedPrefix| + steps
//   - Outside branch: steps += 1, generated grows by at most 1 token (EOS not appended).
//     So |generated| <= |generatedPrefix| + steps holds.
//   - CloseSpanIfComplete branch: steps += 1. When closed, generated grows by 1 (">>" appended).
//     When not closed, generated unchanged. Either way |generated| <= |generatedPrefix| + steps.
//   - Constrained step branch: steps += 1. On EOS, generated unchanged. Otherwise,
//     AppendConstrainedToken appends 1 token, so |generated| grows by 1 <= 1 step consumed.
//     Thus |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve step by step. Wrap each symbolic expression and the final answer inside << >> delimiters. Example: The total is <<3 + 4 = 7>>. So the answer is <<42>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    // Try to close the span if it is already complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Generate the next constrained token using adaptive step with group boosts
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

