// Cap the free chunk at maxSteps - 100 = 800 steps (with maxSteps=900).
//
// IMPORTANT: Keep the loop structure to handle multiple << >> spans (for multi-step problems).
// Use a per-span cap to allow multiple spans.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//
// 1. !insideConstrainedOut branch:
//    a. UnconstrainedChunk, stoppedOnOpenSpan=true: EnterObservedConstrainedSpan sets
//       insideConstrainedOut := true and currentConstrainedOut := [].
//       parser.IsValidPrefix([]) holds by method precondition. Invariant preserved.
//    b. stoppedOnEos=true: break. insideConstrainedOut remains false. Invariant vacuous.
//    c. Budget exhausted without <<, rem2 >= 1: OpenConstrainedSpan sets
//       insideConstrainedOut := true and currentConstrainedOut := [].
//       parser.IsValidPrefix([]) holds. Invariant preserved.
//    d. rem2 == 0: break. Invariant vacuous.
//
// 2. insideConstrainedOut branch (CloseSpanWithinBudget):
//    CloseSpanWithinBudget postcondition guarantees:
//    !insideConstrainedOut ==> currentConstrainedOut == [] (implication vacuous for outside)
//    insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//    Both cases preserve parser_validity invariant.
//
// progress: |generated| <= |generatedPrefix| + steps
//
// 1. !insideConstrainedOut (UnconstrainedChunk):
//    UnconstrainedChunk cost stepsUsed; |generatedOut| <= |generated| + stepsUsed.
//    steps += stepsUsed. Invariant preserved.
//    EnterObservedConstrainedSpan: cost 0, generated unchanged. No effect.
//    OpenConstrainedSpan: appends "<<" (+1 token), steps += 1. Preserved.
//
// 2. insideConstrainedOut (CloseSpanWithinBudget):
//    closeBudget <= remaining = maxSteps - steps.
//    CloseSpanWithinBudget: |generatedOut| <= |generated| + closeBudget.
//    steps := steps + closeBudget. So |generated| <= |generatedPrefix| + steps. Preserved.
//
// Progress (last ensures):
//   If maxSteps > 0 and not insideConstrained: UnconstrainedChunk uses stepsUsed >= 1 (chunkBudget >= 1).
//   If maxSteps > 0 and insideConstrained: CloseSpanWithinBudget uses closeBudget >= 1.
//   In both cases cost >= 1. Progress condition satisfied.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve math problems step by step. For each intermediate calculation and the FINAL ANSWER, write a symbolic expression inside << >>. Inside << >> use ONLY: variable names (no curly braces), numbers, +, -, *, /, //, %, (, ), spaces. Example: <<n * price + 5>>. Always close << with >>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remaining: nat := maxSteps - steps;
    // Reserve budget for constrained span (at least 50 steps for expression)
    var reserve: nat := 50;
    var chunkBudget: nat := if remaining > reserve then remaining - reserve else 1;
    if chunkBudget == 0 { chunkBudget := 1; }
    // Cap the free chunk to avoid spending all budget on reasoning
    // Allow up to 600 steps of free reasoning
    var maxChunk: nat := 600;
    if chunkBudget > maxChunk { chunkBudget := maxChunk; }

    var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed :=
      helpers.UnconstrainedChunk(lm, prompt, generated, chunkBudget, "<<", eosToken);
    steps := steps + stepsUsed;
    generated := chunkGenerated;

    if stoppedOnOpenSpan {
      // "<<" was already appended; enter constrained mode (free, no LM call)
      generated, insideConstrainedOut, currentConstrainedOut :=
        helpers.EnterObservedConstrainedSpan(lm, generated);
    } else if stoppedOnEos {
      // EOS - done generating
      break;
    } else {
      // Chunk budget exhausted without "<<" - force open a constrained span
      var rem2: nat := maxSteps - steps;
      if rem2 >= 1 {
        // Force "<<" directly (no LM call needed)
        generated, insideConstrainedOut, currentConstrainedOut :=
          helpers.OpenConstrainedSpan(lm, generated);
        steps := steps + 1;
      } else {
        break;
      }
    }
  } else {
    // Inside a constrained span: close it with parser-valid content
    var remaining: nat := maxSteps - steps;
    if remaining == 0 {
      break;
    }
    // Use a per-span cap to allow multiple spans
    // Reserve some steps after this span for potential additional spans
    var spanCap: nat := 200;
    var closeBudget: nat := if remaining > spanCap then spanCap else remaining;
    var cg, ci, cc := helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
    );
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + closeBudget;
  }
}

cost := steps;

