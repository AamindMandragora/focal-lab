Strategy: // CSD_RATIONALE_BEGIN
// Analysis of failures:
// - syntax 55.1% (goal 93%) - primary gap
// - 9 final_span_unclosed: << emitted at end, no content or >> produced
// - 8 final_span_invalid: << >> present but content has {}, **, etc.
// - 5 no_span_emitted: model never opens <<
// - Constrained intervention activity: only 7/49 examples used constrained steps
//
// Best result (attempt 2, 63.3% acc, 71.4% syntax) used CloseSpanWithinBudget
// for the entire inside-span phase. That's better than attempt 3's ConstrainedStep
// approach, but still 21.6pp below syntax goal.
//
// Key problems remaining:
// 1. CloseSpanWithinBudget alone still produces invalid content because it
//    uses free generation internally for the span content.
// 2. The model generates {var} template syntax inside << >> spans.
// 3. Some spans never close (budget exhaustion).
//
// New strategy - hybrid approach:
// 1. Generate freely outside spans (model handles reasoning well)
// 2. When "<<" appears, enter constrained mode
// 3. Inside span: use ConstrainedStep (hard parser mask) for each token
// 4. After each token, check CloseSpanIfComplete
// 5. If EOS appears inside span or remaining budget <= close_reserve,
//    use CloseSpanWithinBudget with remaining budget to force closure
// 6. This ensures: (a) every span token is parser-valid, (b) every span closes
//
// Key insight: The best approach combines hard constrained steps inside spans
// WITH a fallback CloseSpanWithinBudget when near budget exhaustion.
// ConstrainedStep ensures parser-valid tokens; CloseSpanWithinBudget ensures closure.
//
// The close_reserve threshold: use 10 steps as reserve trigger so we have
// enough budget to close the span. This prevents the 9 final_span_unclosed failures.
//
// For the 5 no_span_emitted cases: the model generates reasoning that doesn't
// naturally include <<. This is a model behavior issue we can't easily fix with
// CSD alone (the model needs to emit << first in unconstrained mode). Better
// guidance may help here.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   Outside branch: implication is vacuous (!insideConstrainedOut). When next == "<<",
//   we set currentConstrainedOut := [] which satisfies parser.IsValidPrefix([]) by
//   precondition. Invariant holds on first entry.
//
//   CloseSpanWithinBudget branch (emergency close): its postcondition guarantees either
//   !insideConstrainedOut (implication vacuous, currentConstrainedOut == []) or
//   parser.IsValidPrefix(currentConstrainedOut). Invariant preserved.
//
//   CloseSpanIfComplete branch (closed == true): sets insideConstrainedOut := false,
//   currentConstrainedOut := []. Implication vacuous. Invariant preserved.
//
//   CloseSpanIfComplete branch (closed == false): leaves state unchanged. Invariant preserved.
//
//   ConstrainedStep + AppendConstrainedToken branch: ConstrainedStep returns either EOS
//   (no append) or a parser-valid token next. AppendConstrainedToken appends next to
//   currentConstrainedOut only if IsTokenValidNext holds, so
//   parser.IsValidPrefix(currentConstrainedOut + [next]) is maintained.
//
// progress: |generated| <= |generatedPrefix| + steps
//   Outside branch: steps += 1, generated grows by at most 1 (EOS not appended).
//   |generated| <= |generatedPrefix| + steps preserved.
//
//   Emergency close (CloseSpanWithinBudget): spends at most remaining = maxSteps - steps
//   token-steps. |generated| grows by at most remaining. We set steps := maxSteps.
//   |generated| <= |generatedPrefix| + maxSteps = |generatedPrefix| + steps. Preserved.
//
//   CloseSpanIfComplete (closed == true): costs 1 step (steps += 1), generated grows by
//   at most 1 (the ">>" token). |generated| <= |generatedPrefix| + steps. Preserved.
//
//   CloseSpanIfComplete (closed == false) + ConstrainedStep: total steps += 1 from
//   CloseSpanIfComplete (no-op still costs 0 when not closed per API). Wait - per API,
//   CloseSpanIfComplete costs +1 when it closes, +0 when it leaves span open. So on
//   closed == false, CloseSpanIfComplete costs 0. Then ConstrainedStep costs +1 (steps += 1),
//   generated grows by at most 1. Preserved.
//
//   EOS inside span + CloseSpanWithinBudget: ConstrainedStep returns EOS (steps += 1
//   for the EOS token). Then CloseSpanWithinBudget spends at most remaining2 steps.
//   steps := maxSteps. |generated| grows by at most (1 + remaining2) but since
//   steps goes to maxSteps which accounts for all, preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve step by step. For each intermediate calculation and the FINAL ANSWER, wrap ONLY the bare symbolic expression in << >>. Inside << >> use only: variable names (no braces), numbers, +, -, *, /, //, %, (, ), spaces. NO curly braces, NO **, NO int(), NO text inside << >>. Example: <<n * price + extra>>. Always close << with >>. Final answer MUST be <<expression>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var closeReserve: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Outside a span: generate freely, watching for "<<" or EOS
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    // Inside a constrained span
    var remaining: nat := maxSteps - steps;

    // If remaining budget is low, use CloseSpanWithinBudget to force closure
    if remaining <= closeReserve {
      if remaining > 0 {
        var cg, ci, cc := helpers.CloseSpanWithinBudget(
          lm, parser, prompt, generated, currentConstrainedOut, eosToken, remaining
        );
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := maxSteps;
      }
      break;
    }

    // First check if we can close (parser is in a complete state)
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    if closed {
      steps := steps + 1;
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Use hard constrained step to get a parser-valid token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        // EOS inside span: force close with remaining budget
        var remaining2: nat := maxSteps - steps;
        if remaining2 > 0 {
          var eg, ei, ec := helpers.CloseSpanWithinBudget(
            lm, parser, prompt, generated, currentConstrainedOut, eosToken, remaining2
          );
          generated := eg;
          insideConstrainedOut := ei;
          currentConstrainedOut := ec;
          steps := maxSteps;
        }
        break;
      } else {
        var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
        if valid {
          var ag, ai, ac := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

cost := steps;

