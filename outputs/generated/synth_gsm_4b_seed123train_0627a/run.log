Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis from attempt 2:
// - 5 examples: no << >> emitted (model generates reasoning without opening a span)
// - 8 examples: span content failed syntax (curly braces {}, **, int() inside << >>)
// - 1 example: span opened but never closed (hit budget)
// - CloseSpanWithinBudget was used for the entire inside-span phase, but it still
//   produced malformed content because the LM was free to generate invalid tokens.
//
// Root cause: The model generates reasoning text with template variables like {var}
// inside << >> spans. The parser rejects these. We need HARD parser control inside spans.
//
// Strategy:
// 1. Generate freely outside spans (model handles reasoning well)
// 2. When "<<" is observed, enter constrained mode
// 3. Inside the span: use ONLY SafeRepetitionPenaltyStep (hard parser control)
//    to ensure only valid tokens are selected
// 4. After each constrained token, check CloseSpanIfComplete to emit ">>"
// 5. Reserve a close budget: if we're near the end of steps and still inside,
//    force closure with CloseSpanWithinBudget
// 6. Use strong task guidance to steer the model toward emitting << >> naturally
//
// The key fix: use ConstrainedStep (hard parser mask) inside spans rather than
// CloseSpanWithinBudget alone, ensuring every token is parser-valid.
// Also add better guidance to help the model emit << >> in the first place.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Phase 1 (outside span): The implication is vacuous (!insideConstrainedOut).
//     When next == "<<", we set currentConstrainedOut := [] which satisfies
//     parser.IsValidPrefix([]) by precondition. So invariant holds on entry to inside.
//   - Phase 2 (inside span, CloseSpanIfComplete): CloseSpanIfComplete either sets
//     insideConstrainedOut := false (implication vacuous, currentConstrainedOut := [])
//     or leaves state unchanged. No-op path preserves validity.
//   - Phase 2 (inside span, ConstrainedStep + AppendConstrainedToken): ConstrainedStep
//     returns a parser-valid token (or EOS). AppendConstrainedToken preserves validity
//     since only parser-valid tokens are appended.
//   - CloseSpanWithinBudget: its postcondition guarantees either !insideConstrainedOut
//     (vacuous) or parser.IsValidPrefix(currentConstrainedOut). Invariant holds.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Phase 1: steps += 1, generated grows by at most 1 token (EOS not appended).
//     |generated| <= |generatedPrefix| + steps preserved.
//   - Phase 2 (CloseSpanIfComplete path): steps += 1 (the close action costs 1).
//     generated grows by at most 1 (the ">>" token). So |generated| <= |generatedPrefix| + steps.
//   - Phase 2 (ConstrainedStep path): steps += 1, generated grows by at most 1 token
//     (EOS not appended). |generated| <= |generatedPrefix| + steps preserved.
//   - CloseSpanWithinBudget emergency branch: spends closeBudget steps,
//     |generated| grows by at most closeBudget. We set steps := maxSteps.
//     |generated| <= |generatedPrefix| + maxSteps = |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Strong guidance: tell the model to emit clean << >> spans with valid expressions
var guidance: string := "Solve the math problem step by step. For each intermediate calculation and the final answer, wrap the symbolic expression in << >>. Inside << >> use only: variable names, numbers, +, -, *, //, /, %, (, ), and spaces. No curly braces, no **, no int(), no text. Example: <<n * price + extra>>. Always close every << with >>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Outside a span: generate freely, watching for "<<" or EOS
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    // Inside a constrained span: use hard parser control
    // First check if we can close (parser complete)
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Check if we're running low on budget - reserve 3 steps for closure
      var remaining: nat := maxSteps - steps;
      if remaining <= 3 {
        // Emergency closure: use CloseSpanWithinBudget with remaining budget
        if remaining > 0 {
          var eg, ei, ec := helpers.CloseSpanWithinBudget(
            lm, parser, prompt, generated, currentConstrainedOut, eosToken, remaining
          );
          generated := eg;
          insideConstrainedOut := ei;
          currentConstrainedOut := ec;
          steps := maxSteps;
        }
      } else {
        // Normal inside-span: use hard-masked constrained step
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.SafeRepetitionPenaltyStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
        );
        if next == eosToken {
          // EOS inside span: force close with remaining budget
          var remaining2: nat := maxSteps - steps;
          if remaining2 > 0 {
            var eg, ei, ec := helpers.CloseSpanWithinBudget(
              lm, parser, prompt, generated, currentConstrainedOut, eosToken, remaining2
            );
            generated := eg;
            insideConstrainedOut := ei;
            currentConstrainedOut := ec;
            steps := maxSteps;
          }
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

