Strategy: // CSD_RATIONALE_BEGIN
// Revised CSD for math word problems with << >> delimiters.
//
// Key insight from failure analysis:
// 1. syntax=69.4% is the main gap (goal: 93%). Primary causes:
//    - 6 examples: no << >> emitted (model generates reasoning without ever opening a span)
//    - 8 examples: span content failed syntax (curly braces, **, etc. inside << >>)
//    - 1 example: span opened but never closed
//
// 2. "Constrained intervention activity" shows only 5/49 examples used constrained steps.
//    This means the model almost always opens spans via UnconstrainedStep, but the span
//    content is then generated freely (unconstrained) — leading to syntax failures.
//
// Strategy:
// - Keep free generation outside spans (model handles reasoning text well)
// - Once inside a span (after <<), use ONLY constrained steps with hard parser control
// - Use CloseSpanWithinBudget to reliably close spans even when parser isn't complete yet
// - Add guidance to produce clean symbolic expressions only inside << >>
// - Use SafeRepetitionPenaltyStep inside spans to avoid repeating tokens like {, }
// - Reserve budget for span closure to avoid unclosed spans
//
// The core fix: ensure every << gets a >> by using CloseSpanWithinBudget
// with a reserved budget portion once we're inside a span.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Outside branch: implication vacuous. On next == "<<", currentConstrainedOut := [] which
//     satisfies parser.IsValidPrefix([]) by precondition.
//   - CloseSpanWithinBudget branch: its postcondition guarantees either !insideConstrainedOut
//     (vacuous) or parser.IsValidPrefix(currentOut). So invariant holds.
//   - SafeRepetitionPenaltyStep branch: returns EOS or a parser-valid token.
//     AppendConstrainedToken preserves parser validity.
//
// progress invariant: |generated| <= |generatedPrefix| + steps
//   - Outside branch: steps += 1, generated grows by at most 1 token (EOS not appended).
//   - CloseSpanWithinBudget branch: spends at most closeBudget steps and |generated| grows
//     by at most closeBudget. We then set steps := steps + closeBudget, so
//     |generated| <= |generatedPrefix| + steps is preserved.
//   - SafeRepetitionPenaltyStep branch: steps += 1, generated grows by at most 1 token.
//     Thus |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve step by step. For each computation and the final answer, write exactly one symbolic expression inside << >> with no curly braces, no ** operator, use // for integer division, use * for multiplication. Only place the bare expression inside << >>. Example: <<n * price + extra>>. Final answer: <<total_expr>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Outside a span: generate freely, watching for "<<" or EOS
    // Reserve at least 8 steps for span closure if we open one
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    // Inside a constrained span: use CloseSpanWithinBudget to ensure closure
    // Reserve enough budget to make forward progress and close
    var remaining: nat := maxSteps - steps;
    if remaining == 0 {
      break;
    }
    // Use CloseSpanWithinBudget with all remaining steps to ensure we close
    var cg, ci, cc := helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, remaining
    );
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + remaining;
  }
}

cost := steps;

