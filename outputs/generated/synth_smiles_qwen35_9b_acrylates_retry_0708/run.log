Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis: The model generates valid SMILES syntax (100%) but low diversity (only 7 unique
// molecules out of 50). The main issue is that the model strongly prefers certain patterns
// and the "unique_valid_rate_rdkit" metric requires non-exemplar molecules.
//
// The failing example shows: "CCCC(=O)OCC" - this is butyl acetate, NOT an acrylate!
// It lacks the C=C double bond that defines the acrylate class. This is a class membership failure.
//
// Key insight: The guidance must make the model understand that:
// 1. The C=C double bond is MANDATORY - it's the defining feature of acrylates
// 2. The output MUST start with C=C or C=C(C) for acrylate/methacrylate
// 3. Need stronger diversity pushing
//
// Strategy revision:
// 1. Much stronger guidance emphasizing C=C is required at the start
// 2. Use RepetitionPenaltyStep to avoid repeating patterns from the session
// 3. Use SafeSoftConstrainedStep throughout with high boost to stay grammar-valid
//    but with LM diversity
// 4. Pre-populate with a forced start: penalize non-acrylate starts
// 5. The key: use MaskTokensInPrefix at strategic moments to prevent repetition
// 6. Also ensure minLength >= 8 (reasonable) but not too high
//
// The core fix: The guidance needs to be extremely explicit that EVERY output
// MUST start with "C=C" (the vinyl group of acrylate). The model generating
// "CCCC(=O)OCC" suggests it's ignoring the acrylate requirement entirely.
//
// Additional fix: Use SafeSoftConstrainedStep with very high boost (12.0) to
// strongly prefer grammatically valid tokens while maintaining diversity via
// the soft sampling mechanism.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Init: holds by preconditions.
//   - OpenConstrainedSpan: sets currentConstrainedOut := [], which satisfies parser.IsValidPrefix([]).
//   - CloseConstrainedSpan branch: sets insideConstrainedOut := false, implication vacuously true.
//   - RepetitionPenaltyStep/SafeSoftConstrainedStep return EOS or parser-valid next token t;
//     AppendConstrainedToken preserves parser.IsValidPrefix(currentConstrainedOut + [t]).
//   - EOS path: no state change; if insideConstrainedOut was true with valid prefix, it stays.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: steps += 1, |generated| += 1 (for "<<"); bound preserved.
//   - CloseConstrainedSpan: steps += 1, |generated| += 1 (for ">>"); bound preserved.
//   - Each constrained step: steps += 1; on non-EOS path AppendConstrainedToken adds 1 token.
//     So |generated| grows by at most 1 per step. Bound: |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "CRITICAL: Generate a VALID ACRYLATE SMILES. ACRYLATES MUST contain the C=C double bond (vinyl group) connected to C(=O)O. MANDATORY: The SMILES MUST start with 'C=C'. Examples of valid acrylates: C=CC(=O)OC, C=CC(=O)OCC, C=CC(=O)OCCC, C=CC(=O)OCCCC, C=CC(=O)OCCCCC, C=CC(=O)OCCCCCC, C=CC(=O)OCCO, C=C(C)C(=O)OCC, C=C(C)C(=O)OCCO, C=CC(=O)OCC(C)C, C=CC(=O)OC(C)(C)C, C=CC(=O)OCCCCCCC, C=CC(=O)OCCCCCCCC, C=CC(=O)OC1CCCCC1, C=C(C)C(=O)OCCCC, C=CC(=O)OCC(O)C, C=CC(=O)OCCO, C=CC(=O)OCCCO, C=CC(=O)OCCCCO, C=C(C)C(=O)OC, C=C(C)C(=O)OCCC, C=C(C)C(=O)OC(C)(C)C, C=CC(=O)OCC(CC)CCCC, C=CC(=O)OCC(C)CC. DO NOT generate esters without C=C. Output ONLY the SMILES.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var minLength: nat := 8;

// Open a constrained span immediately if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
