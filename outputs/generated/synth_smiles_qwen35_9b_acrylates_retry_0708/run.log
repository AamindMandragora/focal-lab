Strategy: // CSD_RATIONALE_BEGIN
// The core problem: accuracy is only 2% because we're generating only 1 unique
// valid molecule out of 50 attempts. The model is collapsing to the same SMILES
// every time (likely "C=CC(=O)OCC" or similar minimal acrylate). We need diversity.
//
// Key insight from diagnostics:
// - Syntax: 100% (parser is working correctly)
// - Membership: 100% (generated molecules ARE acrylates)
// - Unique valid: 1/50 (massive degeneracy - same molecule every time)
// - "Samples to 100 unique valid (cap 1000): 1000" - confirms extreme degeneracy
//
// Root cause: The model with temperature=1.2 still collapses to the same output
// because the constrained decoding + guidance is so strong that it always picks
// the same highest-probability acrylate SMILES. The minimum-length guard (8 tokens)
// forces it past "C" but doesn't help with diversity.
//
// Fix strategy:
// 1. Use SafeRepetitionPenaltyStep to penalize tokens already in the current span,
//    which forces the model to build structurally different molecules each time.
// 2. Use a higher temperature (1.5-1.8) to encourage exploration.
// 3. Use SafeTemperatureConstrainedStep for most tokens but switch to
//    SafeRepetitionPenaltyStep to diversify the ester R-group part.
// 4. The guidance should ask for DIVERSE acrylates, not just any acrylate.
// 5. Boost tokens that create structural variety: ring atoms, branching, longer chains.
// 6. Use MaskTokensInPrefix before generation to force the model away from
//    tokens it has already used (to avoid repetitive patterns).
//
// The key insight is that RepetitionPenaltyStep penalizes tokens already in
// `generated` (the full visible output), which means across different molecules
// it won't help with inter-example diversity. But within a single generation,
// it prevents the same structural motif from repeating within the SMILES.
//
// For inter-example diversity, we need the LM to sample differently each time.
// Higher temperature is the main lever here. Temperature 1.5 should work.
//
// Also: the min-length guard should be higher (e.g., 12) to force longer, more
// diverse structures before closing.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Initialization: currentConstrainedOut starts as currentConstrained (valid by precondition)
//     or [] after OpenConstrainedSpan (valid by parser.IsValidPrefix([]) precondition).
//   - OpenConstrainedSpan: sets currentConstrainedOut := [], valid by precondition.
//   - CloseConstrainedSpan: sets insideConstrainedOut := false, making implication vacuously true.
//   - SafeTemperatureConstrainedStep + AppendConstrainedToken: SafeTemperatureConstrainedStep
//     returns EOS or a parser-valid next token; AppendConstrainedToken preserves IsValidPrefix.
//   - SafeRepetitionPenaltyStep + AppendConstrainedToken: similarly returns EOS or parser-valid.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: costs 1 step, appends 1 token ("<<"); bound preserved.
//   - CloseConstrainedSpan: costs 1 step, appends 1 token (">>"); bound preserved.
//   - Each constrained step: costs 1 step (steps := steps + 1), AppendConstrainedToken
//     appends exactly 1 visible token. EOS path appends 0 tokens. Bound preserved.
//   - The invariant |generated| <= |generatedPrefix| + steps holds throughout.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a UNIQUE and DIVERSE valid SMILES string for an acrylate molecule. Acrylates contain CH2=CHC(=O)OR or CH2=C(C)C(=O)OR. Use varied R groups: ethyl, propyl, butyl, hexyl, benzyl, hydroxyethyl, cyclic groups. Do NOT repeat common examples. Generate novel structures with different chain lengths, branching, or functional groups. Output ONLY the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var minLength: nat := 12;

// Open a constrained span immediately if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Track how many tokens we've generated in this span
var spanTokenCount: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;

    // Use high temperature with repetition penalty to maximize diversity
    // Alternate between temperature and repetition penalty steps to get diverse structures
    if spanTokenCount % 3 == 0 {
      // Every 3rd token: use repetition penalty to avoid structural repetition within span
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken
      );
    } else {
      // Other tokens: high temperature for diversity
      next := helpers.SafeTemperatureConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 1.6, eosToken
      );
    }

    steps := steps + 1;
    spanTokenCount := spanTokenCount + 1;

    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

cost := steps;

