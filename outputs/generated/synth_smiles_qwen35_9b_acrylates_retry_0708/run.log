Strategy: // CSD_RATIONALE_BEGIN
// Analysis of failures:
// - Attempt 10 (best): 4% accuracy, 100% syntax. Only 2 unique molecules out of 50.
// - Attempt 11: 0% syntax - used GroupBoostedConstrainedStep which isn't in the allowed list.
// - Attempt 8: 0% syntax - temperature 1.9 caused early closed spans like "C=CC(=O)OCc1>>" (incomplete SMILES).
//
// Root cause of low diversity: The model strongly prefers "C=CC(=O)OCc1..." pattern with
// benzyl-like fragments. Temperature alone doesn't help because the model's prior is too strong.
//
// The concrete failing rollout shows: "C=CC(=O)OCc1>>" - the SMILES is incomplete (open aromatic ring).
// This means CloseConstrainedSpan was called when "C=CC(=O)OCc1" was a complete prefix per parser,
// but it's actually not a valid complete SMILES (unclosed ring).
//
// Wait - re-reading: "C=CC(=O)OCc1>>" is what the model outputs. The ">>" delimiter is present,
// meaning CloseConstrainedSpan was called. But "C=CC(=O)OCc1" is NOT valid SMILES (open ring).
// This means the SMILES parser being used accepts "C=CC(=O)OCc1" as a complete prefix!
// The RDKit then rejects it as invalid.
//
// Fix strategy:
// 1. Use SafeSoftConstrainedStep instead of SafeTemperatureConstrainedStep - soft step boosts
//    valid tokens first, providing better steering toward completed structures.
// 2. Increase minLength to 12 tokens to avoid short incomplete SMILES being accepted as complete.
// 3. Use BoostValidGroups with validTokenGroups to bias toward ring-closing tokens when needed.
// 4. Key insight: Don't close early. Require minLength >= 12 to ensure ring closures happen.
// 5. Also: use SafePenalizeTokenLogits to penalize "1" token (aromatic ring opener) at start
//    to steer away from benzyl patterns toward simpler alkyl R-groups.
//
// Actually the REAL problem: the parser considers "C=CC(=O)OCc1" complete (some SMILES parsers
// do accept partial ring-open notation). With minLength=8 from best attempt, these pass.
// By requiring minLength >= 15, we force the model to generate longer, more complete structures.
//
// Strategy:
// 1. Append guidance emphasizing alkyl R-groups first (avoid aromatic rings).
// 2. Open constrained span.
// 3. Use SafeSoftConstrainedStep with high boost (8.0) for first 6 tokens (scaffold phase).
// 4. Use SafeTemperatureConstrainedStep with temperature 1.6 for R-group phase.
// 5. Require minLength >= 12 before closing.
// 6. Penalize aromatic ring openers "1", "2" etc. in first 8 tokens to force alkyl diversity.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Initialization: holds by preconditions.
//   - OpenConstrainedSpan: sets currentConstrainedOut := [], valid by parser.IsValidPrefix([]) precondition.
//   - CloseConstrainedSpan branch: sets insideConstrainedOut := false, making implication vacuously true.
//   - SafeSoftConstrainedStep path: returns EOS or a token t where parser.IsValidPrefix(currentConstrainedOut + [t]);
//     AppendConstrainedToken preserves this by contract.
//   - SafeTemperatureConstrainedStep path: same - hard-masks to valid tokens, AppendConstrainedToken preserves validity.
//   - EOS path: no state change, insideConstrainedOut unchanged (possibly true), but invariant preserved.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: costs 1 step, generated grows by 1 ("<<"); bound: |gen|+1 <= |genPfx|+steps+1. OK.
//   - CloseConstrainedSpan: costs 1 step, generated grows by 1 (">>"); bound preserved.
//   - Each constrained step (SafeSoftConstrainedStep or SafeTemperatureConstrainedStep):
//     steps += 1, AppendConstrainedToken appends exactly 1 token on the non-EOS path.
//     On EOS path: steps += 1, no append. Both cases: |generated| <= |generatedPrefix| + steps. OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a valid SMILES for an ACRYLATE molecule with a UNIQUE R group. Acrylate core: C=CC(=O)O[R] or C=C(C)C(=O)O[R]. PREFER simple alkyl R groups for variety: C=CC(=O)OC (methyl acrylate), C=CC(=O)OCC (ethyl acrylate), C=CC(=O)OCCC (propyl acrylate), C=CC(=O)OCCCC (butyl acrylate), C=CC(=O)OCCCCC (pentyl acrylate), C=CC(=O)OCCCCCC (hexyl acrylate), C=CC(=O)OCCO (2-hydroxyethyl acrylate), C=C(C)C(=O)OCC (ethyl methacrylate), C=C(C)C(=O)OCCO (2-hydroxyethyl methacrylate), C=CC(=O)OCC(C)C (isobutyl acrylate), C=CC(=O)OC(C)(C)C (tert-butyl acrylate), C=CC(=O)OCCCCCCC (heptyl acrylate), C=CC(=O)OCCCCCCCC (octyl acrylate), C=CC(=O)OC1CCCCC1 (cyclohexyl acrylate), C=C(C)C(=O)OCCCC (butyl methacrylate). Output ONLY the SMILES string with NO extra text.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var minLength: nat := 12;

// Open a constrained span immediately if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var spanLen := |currentConstrainedOut|;
    var next: Token;
    if spanLen < 6 {
      // Scaffold phase: use soft constrained step with boost to follow grammar distribution
      var nextSoft, softOk := helpers.SafeSoftConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 8.0, eosToken
      );
      next := nextSoft;
    } else {
      // R-group phase: use temperature for diversity
      next := helpers.SafeTemperatureConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 1.6, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

cost := steps;

