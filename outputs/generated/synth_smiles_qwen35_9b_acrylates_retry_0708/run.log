Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis: The best result (attempt 2) achieved syntax 100% but accuracy 2%
// because it always generates the same molecule "C=CC(=O)OC1CCC(O)". The model
// collapses to a single high-probability acrylate SMILES under hard constrained
// decoding even with temperature 1.2.
//
// Key observations:
// 1. Syntax is 100% in best attempt - parser is working correctly
// 2. Only 1 unique valid molecule out of 50 - extreme degeneracy
// 3. The model needs to be pushed toward diverse R-groups after the acrylate core
// 4. The failing attempt 3 (temperature 1.6 + RepetitionPenaltyStep) got syntax 2%
//    suggesting SafeRepetitionPenaltyStep was the cause of syntax failures
//    (it's not in the allowed helper list - only RepetitionPenaltyStep is allowed,
//    but that requires tokens to be in lm.Tokens which can't be guaranteed)
//
// Fix strategy:
// 1. Keep the OpenConstrainedSpan approach that worked for syntax
// 2. Use higher temperature (1.5) via SafeTemperatureConstrainedStep throughout
// 3. After generating the acrylate core (about 7 tokens: C=CC(=O)O), 
//    boost tokens that create R-group diversity using SafeBoostTokenLogits
//    before each step - specifically boost branch/chain tokens
// 4. Use AdaptiveConstrainedStep with validTokenGroups for the R-group portion
//    to encourage exploration of the caller-supplied vocabulary
// 5. Track position within the SMILES to know when we're likely past the core
//    and in the R-group region (after ~7 tokens)
// 6. minLength = 10 to force at least a short R-group
// 7. Use stronger guidance asking for varied R-groups
//
// The core insight: temperature diversity alone at 1.2 wasn't enough.
// We need 1.5 AND to boost diversity-promoting tokens in the R-group region.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Initialization: currentConstrainedOut starts as currentConstrained (valid by precondition
//     when insideConstrained) or is reset to [] by OpenConstrainedSpan (valid by 
//     parser.IsValidPrefix([]) precondition).
//   - OpenConstrainedSpan: sets currentConstrainedOut := [], which satisfies IsValidPrefix([]).
//   - CloseConstrainedSpan: sets insideConstrainedOut := false, making implication vacuously true.
//   - SafeTemperatureConstrainedStep + AppendConstrainedToken: SafeTemperatureConstrainedStep
//     returns EOS or a parser-valid next token; AppendConstrainedToken preserves IsValidPrefix
//     by its postcondition (extends a valid prefix by a valid next token).
//   - AdaptiveConstrainedStep + AppendConstrainedToken: AdaptiveConstrainedStep returns EOS
//     or a parser-valid next token (hard mask guarantee); AppendConstrainedToken preserves validity.
//   - SafeBoostTokenLogits before sampling does not change parser state; costs 0.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: costs 1 step (steps := steps + 1), appends 1 token ("<<");
//     |generated| increases by 1, steps increases by 1. Bound preserved.
//   - CloseConstrainedSpan: costs 1 step, appends 1 token (">>"); bound preserved.
//   - Each constrained step: costs 1 step (steps := steps + 1), AppendConstrainedToken
//     appends exactly 1 visible token. EOS path appends 0 tokens, steps still +1. Bound preserved.
//   - SafeBoostTokenLogits: costs 0, no tokens appended.
//   - Overall: after k loop iterations, |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a DIVERSE valid SMILES for an acrylate. Acrylates have core C=CC(=O)O or C=C(C)C(=O)O. Use VARIED R groups after the O: methyl, ethyl, propyl, butyl, pentyl, hexyl, 2-ethylhexyl, cyclohexyl, benzyl, 2-hydroxyethyl, glycidyl, isobornyl. Pick a DIFFERENT R group each time. Examples: C=CC(=O)OC, C=CC(=O)OCCC, C=CC(=O)OCCCCCC, C=C(C)C(=O)OCC, C=CC(=O)OCC(CC)CCCC. Output ONLY the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var minLength: nat := 10;

// Open a constrained span immediately if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    var spanLen := |currentConstrainedOut|;
    
    if spanLen < 8 {
      // Core acrylate region: use high temperature to vary the scaffold
      // (methacrylate vs acrylate, different initial atoms)
      next := helpers.SafeTemperatureConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 1.5, eosToken
      );
    } else {
      // R-group region: use AdaptiveConstrainedStep with validTokenGroups
      // to encourage diverse chain/ring tokens
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, 15, eosToken
      );
    }
    
    steps := steps + 1;
    
    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

cost := steps;

