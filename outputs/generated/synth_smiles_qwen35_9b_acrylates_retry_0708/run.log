// The compilation failure caused 0% output validity.
//
// The best result (2% accuracy, 100% syntax) used SafeTemperatureConstrainedStep
// at temperature 1.2 with minLength=8. The accuracy is low (2%) because 50
// examples produce nearly identical SMILES (only ~1 unique molecule).
//
// Strategy to increase uniqueness/diversity:
// 1. Keep the working base structure (OpenConstrainedSpan + SafeTemperatureConstrainedStep).
// 2. Increase temperature to 1.5 (higher than best but still safe per API docs).
// 3. Use RepetitionPenaltyStep after the first 6 tokens to penalize already-used
//    tokens in the generated prefix — this forces structural diversity.
// 4. Use a longer minLength (12) to avoid trivially short SMILES like "C=CC(=O)OC".
// 5. Add guidance listing many different R-group possibilities explicitly.
// 6. After scaffold tokens (first 8), switch to GroupBoostedConstrainedStep
//    with the R-group token groups to steer toward diverse R-groups.
//
// The key insight is that with 50 parallel example runs, we need each run to
// pick a *different* R-group. RepetitionPenaltyStep uses `generated` to penalize
// tokens that already appear in the current example's output — this helps break
// the model's natural mode toward repeating the same scaffold tokens.
//
// Only allowed helpers are used: SafeTemperatureConstrainedStep, RepetitionPenaltyStep,
// GroupBoostedConstrainedStep, AppendConstrainedToken, OpenConstrainedSpan,
// CloseConstrainedSpan, AppendTaskGuidance.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Initialization: from preconditions, holds at entry.
//   - OpenConstrainedSpan: sets currentConstrainedOut := [], and parser.IsValidPrefix([])
//     holds by method precondition.
//   - CloseConstrainedSpan branch (only when IsCompletePrefix && |...| >= minLength):
//     sets insideConstrainedOut := false, making implication vacuous.
//   - SafeTemperatureConstrainedStep + AppendConstrainedToken: step helper returns
//     EOS or parser-valid next token; AppendConstrainedToken preserves IsValidPrefix.
//   - RepetitionPenaltyStep + AppendConstrainedToken: same argument; RepetitionPenaltyStep
//     is a variant of ConstrainedStep with penalization but same validity postcondition.
//   - GroupBoostedConstrainedStep + AppendConstrainedToken: same argument.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: costs 1 step, appends 1 token ("<<"); bound preserved.
//   - CloseConstrainedSpan: costs 1 step, appends 1 token (">>"); bound preserved.
//   - Each constrained step: costs 1 step; AppendConstrainedToken appends exactly 1
//     token on non-EOS path, 0 on EOS path. Both cases maintain |generated| <= |generatedPrefix| + steps.
//   - steps increments by exactly 1 per iteration; loop bound preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a valid SMILES for an ACRYLATE molecule. The acrylate core is C=CC(=O)O- or C=C(C)C(=O)O-. Choose a UNIQUE and DIFFERENT R group each time. R-group options: methyl=C, ethyl=CC, butyl=CCCC, hexyl=CCCCCC, octyl=CCCCCCCC, 2-hydroxyethyl=CCO, benzyl=Cc1ccccc1, cyclohexyl=C1CCCCC1, isobutyl=CC(C)C, 2-ethylhexyl=CCCCC(CC)C, allyl=CC=C, phenyl=c1ccccc1, furfuryl=Cc1ccco1, glycidyl=CC1CO1. Examples: C=CC(=O)OCC, C=CC(=O)OCCO, C=CC(=O)OCc1ccccc1, C=C(C)C(=O)OCC, C=CC(=O)OCCCC, C=CC(=O)OC1CCCCC1. Output ONLY the SMILES.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var minLength: nat := 8;

// Token groups for different R-group families to boost diversity
var rGroupTokens: seq<Token> := ["C", "c", "1", "2", "3", "O", "N", "S", "F", "Cl", "Br", "(", ")", "[", "]"];
var rGroups: seq<seq<Token>> := [rGroupTokens];

// Open a constrained span immediately if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var spanLen := |currentConstrainedOut|;
    var next: Token;
    if spanLen < 8 {
      // Early scaffold region: use moderate temperature to build C=CC(=O)O scaffold
      next := helpers.SafeTemperatureConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 1.5, eosToken
      );
    } else {
      // R-group region: use repetition penalty + group boost for diversity
      next := helpers.RepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

