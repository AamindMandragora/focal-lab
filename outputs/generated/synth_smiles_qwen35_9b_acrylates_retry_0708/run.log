// Estimated: 10/50 unique valid (20%) with ~95% syntax.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Initialization: holds by preconditions (insideConstrained ==> parser.IsValidPrefix(currentConstrained)).
//   - OpenConstrainedSpan branch (entered when !insideConstrainedOut): sets insideConstrainedOut := true,
//     currentConstrainedOut := []. Since parser.IsValidPrefix([]) holds by precondition, invariant preserved.
//   - CloseConstrainedSpan branch (entered when insideConstrainedOut && IsCompletePrefix && length >= minLength):
//     sets insideConstrainedOut := false, making implication vacuously true. Invariant preserved.
//   - SafeSoftConstrainedStep path (spanLen < 8): returns next where next == eosToken OR
//     parser.IsValidPrefix(currentConstrainedOut + [next]) holds by SafeSoftConstrainedStep postcondition.
//     AppendConstrainedToken extends currentConstrainedOut by [next], which is valid by the postcondition.
//   - SafeTemperatureConstrainedStep path (spanLen >= 8): hard-masks to valid next tokens + EOS,
//     so next is EOS or valid. AppendConstrainedToken preserves parser validity by contract.
//   - EOS break path: insideConstrainedOut unchanged, currentConstrainedOut unchanged. Invariant preserved.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: steps += 1, generated grows by exactly 1 token ("<<").
//     Before invariant: |gen| <= |genPfx| + s. After: |gen|+1 <= |genPfx| + (s+1). Preserved.
//   - CloseConstrainedSpan: steps += 1, generated grows by exactly 1 token (">>"). Same analysis. Preserved.
//   - SafeSoftConstrainedStep step: steps += 1. Non-EOS path: AppendConstrainedToken appends 1 token,
//     so |generated| grows by 1, steps grows by 1. Preserved. EOS path: no append, steps grows by 1. Preserved.
//   - SafeTemperatureConstrainedStep step: same analysis as SafeSoftConstrainedStep. Preserved.
//   - The while loop invariant |generated| <= |generatedPrefix| + steps holds throughout all branches.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate ONE valid SMILES for an ACRYLATE molecule. Acrylate SMILES pattern: C=CC(=O)O[R] where [R] is a diverse organic group. Examples of valid acrylates: C=CC(=O)OC, C=CC(=O)OCC, C=CC(=O)OCCC, C=CC(=O)OCCCC, C=CC(=O)OCCCCC, C=CC(=O)OCCCCCC, C=CC(=O)OCCCCCCC, C=CC(=O)OCCCCCCCC, C=CC(=O)OCCO, C=CC(=O)OCCCO, C=CC(=O)OCCCCO, C=CC(=O)OCC(C)C, C=CC(=O)OC(C)C, C=CC(=O)OC(C)(C)C, C=C(C)C(=O)OC, C=C(C)C(=O)OCC, C=C(C)C(=O)OCCC, C=C(C)C(=O)OCCCC, C=C(C)C(=O)OCCO. Output ONLY the SMILES.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var minLength: nat := 12;

// Open a constrained span immediately if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength {
    if steps + 1 <= maxSteps {
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
    }
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var spanLen := |currentConstrainedOut|;
    var next: Token;
    if spanLen < 8 {
      // Scaffold phase: soft constrained with high boost to reliably generate acrylate core
      var nextSoft, softOk := helpers.SafeSoftConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 8.0, eosToken
      );
      next := nextSoft;
    } else if spanLen < 20 {
      // R-group diversity phase: higher temperature for variety
      next := helpers.SafeTemperatureConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 1.7, eosToken
      );
    } else {
      // Completion phase: moderate temperature to stabilize toward valid closure
      next := helpers.SafeTemperatureConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 1.3, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Final close attempt if still inside and complete
if insideConstrainedOut && parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength && steps < maxSteps {
  var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := steps + 1;
}

cost := steps;

