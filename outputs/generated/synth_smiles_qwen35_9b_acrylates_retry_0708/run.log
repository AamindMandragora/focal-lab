Strategy: // CSD_RATIONALE_BEGIN
// Analysis of failures:
// - Attempt 4 got 0% syntax because it called helpers.AdaptiveConstrainedStep which is NOT
//   in the allowed helper list. The allowed list has AdaptiveConstrainedStepWithPenalties.
// - Best attempt (Attempt 2) got syntax 100% but accuracy only 2% due to extreme degeneracy:
//   all 50 examples generated "C=CC(=O)OC1CCC(O)" or similar single molecule.
// - The output shows "C=CC(=O)OC1CCCC>>" in the rollout, which is RDKit-invalid (unclosed ring).
//   Wait - syntax 0% in attempt 4 means the SMILES parser is rejecting the output entirely.
//
// Root cause of attempt 4's 0% syntax: AdaptiveConstrainedStep is not in the allowed list,
// so it caused a compilation/runtime error. The evaluation shows syntax 0%.
//
// Root cause of degeneracy in attempt 2: SafeTemperatureConstrainedStep at 1.2 is not diverse
// enough. The model always collapses to the same molecule.
//
// Strategy for this attempt:
// 1. Use ONLY allowed helpers (no AdaptiveConstrainedStep - use AdaptiveConstrainedStepWithPenalties)
// 2. Keep the working OpenConstrainedSpan + span structure from attempt 2
// 3. Address degeneracy by:
//    a. Using higher temperature (1.5) via SafeTemperatureConstrainedStep
//    b. Penalizing tokens that appear in the currently-generated span using 
//       AdaptiveConstrainedStepWithPenalties with penaltyTokens derived from the 
//       current prefix - this creates repetition penalty
//    c. After the core acrylate scaffold (~8 tokens), switch to 
//       GroupBoostedConstrainedStep to encourage R-group diversity
// 4. Use minLength = 12 to force a meaningful R-group
// 5. Guidance emphasizing a different R-group each call
//
// The key insight from the rollouts: "C=CC(=O)OC1CCCC>>" - the model generates
// cyclohexyl derivative consistently. We need to push it away from this.
// Using AdaptiveConstrainedStepWithPenalties: penalize the tokens in the current 
// constrained prefix to discourage repeating the same scaffold pattern.
// Actually, the penalty tokens must be a valid seq<Token> - we can pass 
// currentConstrainedOut as penalty tokens to avoid repeating the same sequence.
// But AdaptiveConstrainedStepWithPenalties takes penaltyTokens: seq<Token>.
//
// Most importantly: use GroupBoostedConstrainedStep for the R-group region
// with validTokenGroups to leverage caller-supplied vocabulary for diversity.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Initialization: currentConstrainedOut starts as currentConstrained (valid by precondition
//     when insideConstrained) or [] after OpenConstrainedSpan (valid by parser.IsValidPrefix([])).
//   - OpenConstrainedSpan: sets currentConstrainedOut := [], which satisfies IsValidPrefix([]).
//   - CloseConstrainedSpan branch: sets insideConstrainedOut := false, making implication vacuous.
//   - SafeTemperatureConstrainedStep + AppendConstrainedToken: the step helper returns EOS or
//     a parser-valid next token; AppendConstrainedToken extends currentConstrainedOut while
//     preserving parser.IsValidPrefix by its postcondition.
//   - GroupBoostedConstrainedStep + AppendConstrainedToken: similarly returns EOS or parser-valid
//     next token; AppendConstrainedToken preserves validity.
//   - AdaptiveConstrainedStepWithPenalties + AppendConstrainedToken: hard mask guarantees EOS or
//     parser-valid; AppendConstrainedToken preserves validity.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: costs 1 step (steps := steps + 1), appends 1 token ("<<");
//     |generated| increases by 1, steps increases by 1. Bound preserved.
//   - CloseConstrainedSpan: costs 1 step, appends 1 token (">>"); bound preserved.
//   - Each constrained step + AppendConstrainedToken: costs 1 step (steps := steps + 1),
//     AppendConstrainedToken appends exactly 1 visible token. EOS path appends 0 tokens,
//     steps still +1. Bound preserved.
//   - Overall: after k loop iterations, |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate ONE valid SMILES string for an acrylate molecule. An acrylate has the core C=CC(=O)O-R or C=C(C)C(=O)O-R. Choose a UNIQUE and VARIED R group: try alkyl chains (C, CC, CCC, CCCC, CCCCC, CCCCCC), branched (CC(C)C, CCC(C)CC), cyclic (C1CCCCC1, C1CCCC1, C1CCC1), aromatic (Cc1ccccc1), heteroatom (CCO, CCOC, CCN). Output ONLY the SMILES, nothing else.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var minLength: nat := 10;

// Open a constrained span immediately if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    var spanLen := |currentConstrainedOut|;

    if spanLen < 9 {
      // Core scaffold region: use high temperature to vary between acrylate/methacrylate
      // and different initial atoms
      next := helpers.SafeTemperatureConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 1.5, eosToken
      );
    } else {
      // R-group region: use group boosting + penalty on current prefix tokens
      // to encourage diversity in the substituent
      next := helpers.AdaptiveConstrainedStepWithPenalties(
        lm, parser, constrainedPrompt, currentConstrainedOut,
        validTokenGroups, 4.0,
        currentConstrainedOut, 2.0,
        12, eosToken
      );
    }

    steps := steps + 1;

    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

cost := steps;

