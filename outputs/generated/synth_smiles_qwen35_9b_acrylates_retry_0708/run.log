Strategy: // CSD_RATIONALE_BEGIN
// Fully-constrained SMILES CSD for acrylates class.
// State tracked: generated (full token sequence), insideConstrainedOut (span flag),
// currentConstrainedOut (constrained prefix within active span), steps/cost.
//
// Strategy: The task requires a single SMILES string with no delimiters or extra text.
// Since the output contract is a bare SMILES string, we treat the entire generation
// as one constrained span. We open a constrained span immediately (no free preamble),
// then use AdaptiveConstrainedStep with repetition penalty to generate a valid SMILES
// string token by token. We close the span as soon as the parser accepts a complete
// parse. Repetition penalty discourages reusing atoms/bonds already in the prefix,
// nudging the model toward novel acrylate structures (e.g., CH2=CH-C(=O)-O-R patterns).
// The guidance block reminds the model to generate a valid acrylate SMILES.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Initialization: currentConstrainedOut := [] which satisfies IsValidPrefix([]) by precondition.
//   - OpenConstrainedSpan branch: sets currentConstrainedOut := [] (valid by precondition).
//   - CloseConstrainedSpan branch: sets insideConstrainedOut := false, making implication vacuous.
//   - AdaptiveConstrainedStep branch: returns EOS or a parser-valid next token;
//     AppendConstrainedToken extends currentConstrainedOut by one valid token, preserving
//     parser.IsValidPrefix(currentConstrainedOut) by the helper's postcondition.
//   - SafeRepetitionPenaltyStep branch (if used): same guarantee as AdaptiveConstrainedStep.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: costs 1 step, appends 1 token ("<<") to generated; bound preserved.
//   - CloseConstrainedSpan: costs 1 step, appends 1 token (">>"); bound preserved.
//   - AdaptiveConstrainedStep + AppendConstrainedToken: costs 1 step, appends at most 1
//     visible token; EOS path appends 0 tokens. Bound preserved in both cases.
//   - steps increments by 1 each iteration; generated grows by at most 1 per step.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate exactly one valid SMILES string for a molecule in the acrylates class (contains CH2=CH-C(=O)-O- or similar acrylate/methacrylate core). Output only the SMILES string, nothing else.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// If not already inside a constrained span, open one immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed; we are done
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    // Close the span
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    // Constrained generation inside the span
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    // Use repetition penalty to encourage novelty in the SMILES string
    var next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, generated, 1.5, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

cost := steps;

