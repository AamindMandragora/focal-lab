Strategy: // CSD_RATIONALE_BEGIN
// Analysis of current situation:
// - Best attempt (12): 14% accuracy, 100% syntax. The failing rollouts show "C=CC(=O)OC1CCCC>>"
//   which is an incomplete SMILES with an unclosed ring (ring-open "1" but no ring-close "1").
//   The parser accepts "C=CC(=O)OC1CCCC" as complete, but RDKit rejects it.
// - Attempt 15 (last): 0% syntax - the temperature=1.9 caused the output format to break.
//   The issue is that with delimiter-based output ("<<" ... ">>"), the model outputs the
//   delimiters around the SMILES, but something went wrong with the span detection.
//
// Key diagnostic insight:
// - "Delimiter churn ratio: 0.019" in the last attempt means the delimiters ARE being output.
// - "other_observed_failure: 50" means the SMILES inside the delimiters is invalid.
// - The specific failure: "C=CC(=O)OC1CCCC>>" - unclosed ring.
//
// Root cause: The SMILES grammar parser accepts ring-number-opened strings as "complete"
// because it thinks "1" can start and close in one position. But RDKit rejects these.
//
// Solution approach:
// 1. PENALIZE ring-opening tokens ("1", "2", "3", etc.) to force the model to use
//    straight-chain alkyl groups instead of cyclic ones.
//    Use SafePenalizeTokenLogits to penalize these tokens before each step.
//    Actually use SafePenalizedConstrainedStep to penalize ring-number tokens.
//
// 2. Keep the best approach (minLength=12, SafeSoftConstrainedStep + SafeTemperatureConstrainedStep)
//    but add ring-opener penalties to steer away from cyclic patterns.
//
// 3. Also penalize "c" (aromatic carbon) to avoid aromatic rings entirely.
//
// By avoiding ring systems, we force linear/branched acrylates which are always
// valid SMILES when the parser says they're complete.
//
// Why attempt 15 had 0% syntax: temperature=1.9 is too high and the hard mask sometimes
// fails to produce valid output when the grammar has very few valid tokens.
// The "C=CC(=O)OC1CCCC" pattern shows the model still uses ring openers even at high temp.
//
// Refined strategy:
// 1. Guidance: show many diverse NON-CYCLIC acrylates.
// 2. At each step, use SafePenalizedConstrainedStep to penalize ring opener tokens
//    ["1", "2", "3", "4", "5", "6", "c"] with penalty 6.0.
// 3. Use minLength=8 (not 12, which was too conservative - best attempt used 12 and got 14%
//    with valid syntax, but the issue was ring-openness, not length).
// 4. Use SafeSoftConstrainedStep for scaffold (first 8 tokens) and
//    SafeTemperatureConstrainedStep(1.4) for R-group phase.
//
// Actually the best attempt DID use minLength=12 and got 14% with 100% syntax.
// But the failing rollouts show "C=CC(=O)OC1CCCC" which has 16 characters but
// only ~10 tokens (tokenization dependent). With minLength=12 tokens, this was
// accepted. The ring problem is separate from length.
//
// The real fix: PREVENT ring openers from being used at all via penalization.
// Use SafePenalizedConstrainedStep throughout with strong penalty on ring tokens.
//
// Tokens to penalize: "1", "2", "3", "4", "5", "6", "c", "n", "o", "s", "p"
// (ring opener digits and aromatic atoms). With high penalty (8.0), the model
// will strongly prefer linear chains.
//
// This should give us diverse but valid linear acrylates.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Initialization: holds by preconditions.
//   - OpenConstrainedSpan: sets currentConstrainedOut := [] which satisfies parser.IsValidPrefix([])
//     by the method's requires clause.
//   - CloseConstrainedSpan: sets insideConstrainedOut := false, making the implication vacuously true.
//   - SafePenalizedConstrainedStep path: the helper hard-masks to parser-valid next tokens + EOS,
//     so the returned token t satisfies parser.IsValidPrefix(currentConstrainedOut + [t]);
//     AppendConstrainedToken preserves this by its contract.
//   - SafeSoftConstrainedStep path: similar - soft step with hard fallback ensures parser validity.
//   - EOS path: no change to insideConstrainedOut or currentConstrainedOut, invariant preserved.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: steps += 1, |generated| += 1 ("<<" appended). Bound preserved.
//   - CloseConstrainedSpan: steps += 1, |generated| += 1 (">>"). Bound preserved.
//   - SafePenalizedConstrainedStep: steps += 1 (cost +1). Non-EOS: AppendConstrainedToken
//     appends exactly 1 token, so |generated|+1 <= |generatedPrefix|+(steps+1). EOS: no append.
//   - SafeSoftConstrainedStep: same analysis, steps += 1, at most 1 token appended.
//   Both cases maintain |generated| <= |generatedPrefix| + steps after increment.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a valid SMILES for an ACRYLATE molecule. Acrylate = acryloyl group C=CC(=O)O or methacryloyl C=C(C)C(=O)O connected to an alkyl or hydroxyalkyl R group. Examples of valid acrylates: C=CC(=O)OC (methyl), C=CC(=O)OCC (ethyl), C=CC(=O)OCCC (propyl), C=CC(=O)OCCCC (butyl), C=CC(=O)OCCCCC (pentyl), C=CC(=O)OCCCCCC (hexyl), C=CC(=O)OCCCCCCC (heptyl), C=CC(=O)OCCCCCCCC (octyl), C=CC(=O)OCCO (2-hydroxyethyl), C=CC(=O)OCCCO (3-hydroxypropyl), C=CC(=O)OCCCCO (4-hydroxybutyl), C=C(C)C(=O)OC (methyl methacrylate), C=C(C)C(=O)OCC (ethyl methacrylate), C=C(C)C(=O)OCCC (propyl methacrylate), C=C(C)C(=O)OCCCC (butyl methacrylate), C=C(C)C(=O)OCCCCC (pentyl methacrylate), C=C(C)C(=O)OCCO (2-hydroxyethyl methacrylate), C=CC(=O)OCC(C)C (isobutyl), C=CC(=O)OC(C)(C)C (tert-butyl), C=CC(=O)OCCC(C)C (3-methylbutyl), C=CC(=O)OCC(CC)CC (2-ethylbutyl), C=CC(=O)OCCOCCO (diethylene glycol), C=CC(=O)OCC(O)CO (glyceryl), C=CC(=O)OCCN (2-aminoethyl), C=CC(=O)OCCCCCCCCCC (decyl). Output ONLY the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var minLength: nat := 8;

// Ring-opener and aromatic tokens to penalize
var ringTokens: seq<Token> := ["1", "2", "3", "4", "5", "6", "c", "n", "o", "s"];

// Open a constrained span immediately if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var spanLen := |currentConstrainedOut|;
    var next: Token;
    if spanLen < 8 {
      // Scaffold phase: penalize ring openers strongly, use soft constrained step
      next := helpers.SafePenalizedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, ringTokens, 8.0, eosToken
      );
    } else {
      // R-group diversity phase: penalize ring openers, use temperature for diversity
      helpers.SafePenalizeTokenLogits(lm, ringTokens, 8.0);
      next := helpers.SafeTemperatureConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 1.4, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

cost := steps;

