// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Initialization: holds by preconditions (insideConstrained ==> parser.IsValidPrefix(currentConstrained)).
//   - OpenConstrainedSpan branch: sets currentConstrainedOut := [], insideConstrainedOut := true.
//     parser.IsValidPrefix([]) holds by requires clause. Invariant preserved.
//   - CloseConstrainedSpan branch: sets insideConstrainedOut := false, making the implication
//     vacuously true; also clears currentConstrainedOut := []. Invariant preserved.
//   - SafeSoftConstrainedStep path (scaffold, tokens < 6): returns next where next == eosToken OR
//     parser.IsValidPrefix(currentConstrainedOut + [next]) by SafeSoftConstrainedStep postcondition.
//     AppendConstrainedToken sets currentConstrainedOut := currentConstrainedOut + [next], valid.
//   - SafeTemperatureConstrainedStep path (R-group, tokens >= 6): hard-masks to valid tokens + EOS,
//     so next is EOS or valid. AppendConstrainedToken preserves parser validity by contract.
//   - EOS break path: insideConstrainedOut unchanged, currentConstrainedOut unchanged.
//     If insideConstrainedOut was true, it remains true but currentConstrainedOut is still valid.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: steps += 1, generated grows by 1 token ("<<").
//     Before: |gen| <= |genPfx| + s. After: |gen|+1 <= |genPfx| + (s+1). Preserved.
//   - CloseConstrainedSpan: steps += 1, generated grows by 1 token (">>"). Same analysis. Preserved.
//   - SafeSoftConstrainedStep step: steps += 1. Non-EOS: AppendConstrainedToken appends 1 token.
//     EOS: no append. Both cases: |generated| grows by at most 1, steps by exactly 1. Preserved.
//   - SafeTemperatureConstrainedStep step: same analysis as above. Preserved.
//   - The while loop invariant |generated| <= |generatedPrefix| + steps holds throughout.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate ONE valid SMILES string for an ACRYLATE molecule. Acrylate core: C=CC(=O)O[R] (acrylate) or C=C(C)C(=O)O[R] (methacrylate). Output ONLY the SMILES, nothing else. Diverse examples: C=CC(=O)OC, C=CC(=O)OCC, C=CC(=O)OCCC, C=CC(=O)OCCCC, C=CC(=O)OCCCCC, C=CC(=O)OCCCCCC, C=CC(=O)OCCCCCCC, C=CC(=O)OCCCCCCCC, C=CC(=O)OCCCCCCCCC, C=CC(=O)OCCCCCCCCCC, C=CC(=O)OCCO, C=CC(=O)OCCCO, C=CC(=O)OCCCCO, C=CC(=O)OCC(C)C, C=CC(=O)OC(C)C, C=CC(=O)OC(C)(C)C, C=CC(=O)OCCC(C)C, C=CC(=O)OCC(C)(C)C, C=CC(=O)OCC(CC)CC, C=CC(=O)OCCOCCO, C=CC(=O)OCC(O)CO, C=CC(=O)OCCN, C=CC(=O)OCCCN, C=CC(=O)OCCOC, C=CC(=O)OCCOCC, C=CC(=O)OCCC(C)(C)C, C=C(C)C(=O)OC, C=C(C)C(=O)OCC, C=C(C)C(=O)OCCC, C=C(C)C(=O)OCCCC, C=C(C)C(=O)OCCCCC, C=C(C)C(=O)OCCO, C=C(C)C(=O)OCCCO, C=C(C)C(=O)OCC(C)C, C=C(C)C(=O)OC(C)C, C=C(C)C(=O)OC(C)(C)C, C=C(C)C(=O)OCCC(C)C, C=C(C)C(=O)OCCOCCO, C=CC(=O)OCCCCCCCCCCC, C=CC(=O)OCCCCCCCCCCCC.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var minLength: nat := 10;

// Open a constrained span immediately if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
