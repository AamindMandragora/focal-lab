Strategy: // CSD_RATIONALE_BEGIN
// Analysis of failures:
// - Attempt 5 got 0% syntax because it called AdaptiveConstrainedStepWithPenalties which is NOT
//   in the allowed helper list.
// - Best attempt (Attempt 2) got syntax 100% but accuracy only 2% due to extreme degeneracy:
//   all 50 examples generated "C=CC(=O)OC1CCC(O)" or similar single molecule.
// - The rollout shows "C=CC(=O)OC1CCCC>>" - the model always generates cyclohexyl derivative.
//
// Root cause of degeneracy: SafeTemperatureConstrainedStep at 1.2 is insufficient for diversity.
// The model collapses to the same tokens because the guidance + model prior strongly favors
// the cyclohexyl group.
//
// Strategy for this attempt (building from Attempt 2 which got syntax 100%):
// 1. Keep the proven OpenConstrainedSpan + SafeTemperatureConstrainedStep structure.
// 2. Increase temperature to 1.8 to force more diversity.
// 3. After generating the core scaffold (~7-8 tokens: "C=CC(=O)O"), switch to
//    RepetitionPenaltyStep to penalize tokens already in currentConstrainedOut.
//    This prevents the model from repeating the same ring structure.
// 4. Use minLength = 8 to prevent tiny SMILES.
// 5. CRITICAL: After 7+ tokens, use RepetitionPenaltyStep which penalizes tokens
//    already seen in generated, encouraging novel R-group choices.
// 6. Use the MaskTokensInPrefix approach to prevent exact repetition of previously
//    seen tokens in the constrained span.
//
// The key insight: RepetitionPenaltyStep takes `generated` as the bag of tokens to penalize,
// which will discourage repeating the same ring-closure tokens like "1", "C", "C", "C" etc.
// This should cause the model to pick more diverse alkyl chains.
//
// Additionally: boost tokens like "C", "N", "O", "c", "n" that form diverse R-groups,
// while the hard parser mask ensures validity.
//
// Temperature 1.8 should be enough to sample different branches.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Initialization: currentConstrainedOut starts as currentConstrained (valid by precondition
//     when insideConstrained, with !insideConstrained ==> currentConstrained == []).
//   - OpenConstrainedSpan: sets currentConstrainedOut := [], which satisfies IsValidPrefix([])
//     by the precondition parser.IsValidPrefix([]).
//   - CloseConstrainedSpan branch: sets insideConstrainedOut := false, making implication vacuous,
//     and sets currentConstrainedOut := [].
//   - SafeTemperatureConstrainedStep + AppendConstrainedToken: SafeTemperatureConstrainedStep
//     returns EOS or a parser-valid next token; AppendConstrainedToken extends currentConstrainedOut
//     while preserving parser.IsValidPrefix by its postcondition.
//   - RepetitionPenaltyStep + AppendConstrainedToken: RepetitionPenaltyStep hard-masks to
//     parser-valid next tokens plus EOS, so returns EOS or parser-valid; AppendConstrainedToken
//     preserves validity.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: costs 1 step (steps := steps + 1), appends 1 token ("<<");
//     |generated| increases by 1, steps increases by 1. Bound preserved.
//   - CloseConstrainedSpan: costs 1 step, appends 1 token (">>"); bound preserved.
//   - Each constrained step + AppendConstrainedToken: costs 1 step (steps := steps + 1),
//     AppendConstrainedToken appends exactly 1 visible token. EOS path appends 0 tokens,
//     steps still +1. Bound preserved.
//   - Overall: after k loop iterations, |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a valid SMILES string for an acrylate molecule. Acrylates contain the core CH2=CHC(=O)O or CH2=C(C)C(=O)O (methacrylate). Choose varied R groups such as: ethyl (CC), butyl (CCCC), hexyl (CCCCCC), 2-ethylhexyl (CCCCC(CC)C), benzyl (Cc1ccccc1), hydroxyethyl (CCO), methoxyethyl (CCOC). Output ONLY the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var minLength: nat := 8;

// Open a constrained span immediately if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    var spanLen := |currentConstrainedOut|;

    if spanLen < 7 {
      // Core scaffold region: use high temperature to vary between acrylate/methacrylate forms
      next := helpers.SafeTemperatureConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 1.8, eosToken
      );
    } else {
      // R-group region: use repetition penalty on already-generated tokens to avoid
      // repeating the same ring/chain pattern
      next := helpers.RepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken
      );
    }

    steps := steps + 1;

    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

cost := steps;

