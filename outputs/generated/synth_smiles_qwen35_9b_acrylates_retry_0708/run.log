Strategy: // CSD_RATIONALE_BEGIN
// Problem analysis: Accuracy is only 4% (2/50 unique valid molecules) despite 100% syntax and 100% membership.
// The issue is severe lack of diversity - only 2 unique molecules out of 50 attempts.
// "Samples to 100 unique valid (cap 1000): 1000" confirms near-zero diversity.
// 
// Root cause: Temperature-based diversity alone isn't sufficient. The model collapses to
// the same few acrylate structures repeatedly. We need to:
// 1. Use RepetitionPenaltyStep to penalize tokens already in the generated span.
// 2. Use MaskTokensInPrefix to suppress previously-seen tokens.
// 3. Better guidance that emphasizes generating VARIED structures.
//
// Key insight: The acrylate class requires: C=CC(=O)O[R] or C=C(C)C(=O)O[R]
// The diversity comes from the R group. The model keeps picking the same R group.
//
// Strategy:
// 1. Provide guidance with many diverse R-group options and explicit variety instruction.
// 2. Open constrained span immediately.
// 3. Use SafeTemperatureConstrainedStep with VERY high temperature (1.9) during
//    the R-group phase to maximize diversity.
// 4. Apply SafePenalizeTokenLogits on the most common/repetitive tokens before stepping.
// 5. Use GroupBoostedConstrainedStep with diverse token groups to steer toward
//    different R-group structures.
// 6. Close when complete and >= 10 tokens long for non-trivial structures.
//
// The key change: Use GroupBoostedConstrainedStep with validTokenGroups for diversity,
// combined with SafePenalizeTokenLogits to penalize overused tokens like simple "C" chains.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - Initialization: holds by preconditions.
//   - OpenConstrainedSpan branch: sets currentConstrainedOut := [], valid by parser.IsValidPrefix([]) precondition.
//   - CloseConstrainedSpan branch: sets insideConstrainedOut := false, making implication vacuously true; currentConstrainedOut := [].
//   - SafeTemperatureConstrainedStep + AppendConstrainedToken path: SafeTemperatureConstrainedStep returns
//     either eosToken or a parser-valid next token (hard-masked); AppendConstrainedToken preserves
//     parser.IsValidPrefix by contract. So currentConstrainedOut remains valid.
//   - GroupBoostedConstrainedStep + AppendConstrainedToken path: same argument - GroupBoostedConstrainedStep
//     hard-masks to parser-valid tokens, AppendConstrainedToken preserves validity.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: steps += 1, generated gets one token ("<<"); bound holds.
//   - CloseConstrainedSpan: steps += 1, generated gets ">>" (at most one token); bound holds.
//   - SafeTemperatureConstrainedStep path: steps += 1, AppendConstrainedToken adds at most 1 token; bound holds.
//   - GroupBoostedConstrainedStep path: steps += 1, AppendConstrainedToken adds at most 1 token; bound holds.
//   - EOS break: steps already incremented, no token appended; bound holds.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "IMPORTANT: Generate ONE valid SMILES for a UNIQUE acrylate molecule. Acrylates have structure C=CC(=O)O[R] or C=C(C)C(=O)O[R]. You MUST choose a DIFFERENT R group every time to maximize diversity. Available R groups (vary these!): methyl (C), ethyl (CC), propyl (CCC), butyl (CCCC), pentyl (CCCCC), hexyl (CCCCCC), heptyl (CCCCCCC), octyl (CCCCCCCC), decyl (CCCCCCCCCC), 2-hydroxyethyl (CCO), 2-hydroxypropyl (CC(O)C), glycol (OCCO), methoxyethyl (CCOC), ethoxyethyl (CCOCC), benzyl (Cc1ccccc1), phenyl (c1ccccc1), tolyl (Cc1ccccc1C), 4-methoxybenzyl (Cc1ccc(OC)cc1), cyclohexyl (C1CCCCC1), cyclopentyl (C1CCCC1), tert-butyl (CC(C)(C)), isopropyl (CC(C)), isobutyl (CC(C)C), neopentyl (CC(C)(C)C), 2-ethylhexyl (CCCCC(CC)C), allyl (CC=C), propargyl (CC#C), furfuryl (Cc1ccco1), tetrahydrofurfuryl (CC1CCCO1), glycidyl (CC1CO1), dimethylaminoethyl (CCN(C)C), diethylaminoethyl (CCN(CC)CC). Do NOT repeat molecules. Output ONLY the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var minLength: nat := 10;

// Open a constrained span immediately if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var spanLen := |currentConstrainedOut|;
    var next: Token;
    if spanLen < 8 {
      // Scaffold phase: use validTokenGroups boosting to steer toward diverse cores
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 3.0, eosToken
      );
    } else {
      // R-group phase: high temperature for diversity
      next := helpers.SafeTemperatureConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 1.9, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

cost := steps;

