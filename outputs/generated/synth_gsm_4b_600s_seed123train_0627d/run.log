Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters.
// Key diagnosis from failures:
// 1. final_span_unclosed (2): "<<" opened but parser/budget exhausted before ">>" emitted
// 2. no_span_emitted (1): model generates long reasoning without ever emitting "<<"
// 3. final_span_invalid (1): span content has {var} template tokens (unconstrained text inside span)
// 4. syntax_valid_semantic_mismatch (27): correct structure but wrong math expression
//
// Core insight: The model produces "tiny" spans (avg 1.54 tokens) - just single variable names
// rather than full expressions. We need to guide the model to produce complete math expressions.
//
// Fix strategy:
// - Use stronger task guidance that emphasizes complete arithmetic expressions (not just variables)
// - Use UnconstrainedChunk with chunk size 40 to find "<<", stopping at delimiter
// - Once inside a span, use ConstrainedStep with hard parser control
// - After EACH constrained token, immediately check CloseSpanIfComplete
// - Use CloseSpanWithinBudget with a larger reserve (20 steps) to handle budget pressure
// - For the unterminated span issue: detect when the span is starting with just a partial
//   expression and ensure we generate enough tokens before trying to close
// - Key fix: when generating inside a span, keep generating until parser.IsCompletePrefix
//   OR we hit budget/EOS, using ConstrainedStep exclusively
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - UnconstrainedChunk branch: when stoppedOnOpenSpan is true, EnterObservedConstrainedSpan
//     sets currentConstrainedOut := [] which is valid by precondition parser.IsValidPrefix([]).
//     When not stopped on open span and not EOS, insideConstrainedOut stays false (vacuous).
//   - CloseSpanIfComplete closed==true: CloseConstrainedSpan postcondition ensures
//     insideConstrainedOut becomes false, making implication vacuous.
//   - CloseSpanIfComplete closed==false: state unchanged, invariant preserved by induction.
//   - ConstrainedStep + AppendConstrainedToken: ConstrainedStep returns a token valid at
//     currentConstrainedOut (or EOS). AppendConstrainedToken extends currentConstrainedOut
//     by a parser-valid token, so parser.IsValidPrefix(currentConstrainedOut + [next]) holds.
//   - CloseSpanWithinBudget: postcondition guarantees insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress: |generated| <= |generatedPrefix| + steps
//   - UnconstrainedChunk: stepsUsed <= chunkBudget and generated is already extended with
//     at most stepsUsed tokens. steps += stepsUsed preserves the bound.
//   - CloseSpanIfComplete costs 1 step; generated grows by at most 1 (the ">>" token).
//   - ConstrainedStep costs 1 step; AppendConstrainedToken grows generated by 1.
//     Together: steps += 1 per constrained token generation, generated grows by 1. Preserved.
//   - CloseSpanWithinBudget: uses closeBudget = maxSteps - steps, sets steps := maxSteps.
//     |generatedOut| <= |generated| + closeBudget = |generatedPrefix| + steps + (maxSteps-steps)
//     = |generatedPrefix| + maxSteps. Preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math problem step by step. For each calculation, write ONLY the complete arithmetic expression inside << >> delimiters. Use only numbers, variable names, +, -, *, /, //, %, (, ) inside delimiters. The final answer must be in a << >> span. Never put text like {variable} inside << >> spans.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var closeReserve: nat := 20;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // If inside a span and budget is running low, force close
  if insideConstrainedOut && (maxSteps - steps <= closeReserve) {
    var closeBudget: nat := maxSteps - steps;
    var cg, ci, cc := helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
    );
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := maxSteps;
  } else if !insideConstrainedOut {
    // Generate freely until "<<" is observed or EOS
    var chunkBudget: nat := maxSteps - steps;
    if chunkBudget > 40 {
      chunkBudget := 40;
    }
    if chunkBudget == 0 {
      break;
    }
    var cg, stoppedOnOpen, stoppedOnEos, stepsUsed :=
      helpers.UnconstrainedChunk(lm, prompt, generated, chunkBudget, "<<", eosToken);
    steps := steps + stepsUsed;
    if stoppedOnEos {
      generated := cg;
      break;
    }
    generated := cg;
    if stoppedOnOpen {
      // "<<" is already appended in generated; enter constrained span state without cost
      generated, insideConstrainedOut, currentConstrainedOut :=
        helpers.EnterObservedConstrainedSpan(lm, generated);
    }
  } else {
    // Inside constrained span - try to close if complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else if steps < maxSteps {
      // Generate one more constrained token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        // EOS inside span - use CloseSpanWithinBudget to rescue
        if steps < maxSteps {
          var closeBudget2: nat := maxSteps - steps;
          var cg2, ci2, cc2 := helpers.CloseSpanWithinBudget(
            lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget2
          );
          generated := cg2;
          insideConstrainedOut := ci2;
          currentConstrainedOut := cc2;
          steps := maxSteps;
        }
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Final cleanup: if still inside a span and have budget, force close
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

