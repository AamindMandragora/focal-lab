Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters.
// Key diagnosis from failures:
// 1. final_span_unclosed (2): "<<" opened but never closed - EOS or budget exhaustion
// 2. no_span_emitted (3): model generates long reasoning without ever emitting "<<"
// 3. final_span_invalid (6): span content contains {}, ** or other invalid chars
//
// Fix strategy:
// - Use UnconstrainedChunk to generate reasoning text freely until "<<" is observed,
//   stopping at the delimiter. This avoids the "no_span_emitted" issue by using
//   a chunk helper that stops naturally at "<<".
// - Once inside a span, use ConstrainedStep (hard parser control) to fill content.
//   This avoids malformed content like {var} or ** appearing inside spans.
// - After each constrained token, call CloseSpanIfComplete to close as soon as parser accepts.
// - If budget is running low while inside a span, use CloseSpanWithinBudget to force closure.
// - Reserve budget for span closure: keep at least 10 steps for CloseSpanWithinBudget.
// - This avoids unterminated spans by ensuring we always have budget to close.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - UnconstrainedChunk branch: when stoppedOnOpenSpan, EnterObservedConstrainedSpan sets
//     currentConstrainedOut := [] which satisfies IsValidPrefix([]) by precondition.
//     When not stoppedOnOpenSpan and not EOS, insideConstrainedOut stays false, implication vacuous.
//   - CloseSpanIfComplete closed==true: insideConstrainedOut becomes false, implication vacuous.
//   - CloseSpanIfComplete closed==false: state unchanged, invariant preserved.
//   - ConstrainedStep + AppendConstrainedToken: ConstrainedStep returns parser-valid token or EOS.
//     AppendConstrainedToken extends currentConstrainedOut by a valid next token, preserving
//     parser.IsValidPrefix by the parser's monotone extension property.
//   - CloseSpanWithinBudget: postcondition guarantees insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress: |generated| <= |generatedPrefix| + steps
//   - UnconstrainedChunk branch: stepsUsed <= maxChunkTokens <= maxSteps - steps (budget-capped),
//     and generatedOut is already extended. steps += stepsUsed preserves bound.
//   - CloseSpanIfComplete + ConstrainedStep path: steps += 2 (one for close check, one for step),
//     generated grows by at most 1 token. But we guard with steps+2 <= maxSteps before entering.
//   - CloseSpanWithinBudget: uses closeBudget = maxSteps - steps, sets steps := maxSteps.
//     |generatedOut| <= |generated| + closeBudget = |generated| + (maxSteps - steps) <=
//     |generatedPrefix| + steps + (maxSteps - steps) = |generatedPrefix| + maxSteps. Preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math problem step by step. For each intermediate calculation and the final answer, open a << delimiter, write only the symbolic expression (using variables, numbers, +, -, *, /, //, %, and parentheses only - no braces, no LaTeX, no markdown), then close with >>. Keep reasoning text outside the delimiters.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var closeReserve: nat := 15;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // If inside a span and budget is getting low, force close
  if insideConstrainedOut && (maxSteps - steps <= closeReserve) {
    var closeBudget: nat := maxSteps - steps;
    var cg, ci, cc := helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
    );
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := maxSteps;
  } else if !insideConstrainedOut {
    // Generate freely until "<<" is observed or EOS, using chunk helper
    var chunkBudget: nat := maxSteps - steps;
    if chunkBudget > 50 {
      chunkBudget := 50;
    }
    if chunkBudget == 0 {
      break;
    }
    var cg, stoppedOnOpen, stoppedOnEos, stepsUsed :=
      helpers.UnconstrainedChunk(lm, prompt, generated, chunkBudget, "<<", eosToken);
    steps := steps + stepsUsed;
    if stoppedOnEos {
      generated := cg;
      break;
    }
    generated := cg;
    if stoppedOnOpen {
      // "<<" is already in generated; enter constrained span state
      generated, insideConstrainedOut, currentConstrainedOut :=
        helpers.EnterObservedConstrainedSpan(lm, generated);
    }
    // If neither stopped on open nor EOS, chunk ended due to budget; continue loop
  } else {
    // Inside constrained span - first try to close if complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Need more tokens - generate one constrained token if budget allows
      if steps < maxSteps {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          // EOS inside span - try to close what we have
          if steps < maxSteps {
            var closeBudget2: nat := maxSteps - steps;
            var cg2, ci2, cc2 := helpers.CloseSpanWithinBudget(
              lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget2
            );
            generated := cg2;
            insideConstrainedOut := ci2;
            currentConstrainedOut := cc2;
            steps := maxSteps;
          }
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

// Final cleanup: if still inside a span and have budget, force close
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

