Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters for symbolic expressions.
// State tracked: generated (full output), insideConstrainedOut (inside << >> span),
// currentConstrainedOut (constrained span contents for parser), steps (budget used).
//
// Strategy:
// - Phase 1 (outside span): Generate freely until "<<" appears naturally or EOS.
//   This lets the model emit reasoning steps like "Step 1: ..." before expressions.
// - Phase 2 (inside span): Use AdaptiveConstrainedStep with validTokenGroups to
//   guide symbolic math expressions (numbers, operators, variables). The adaptive
//   threshold prevents over-constraining when the parser has many valid choices.
//   CloseSpanIfComplete is checked each step to emit ">>" as soon as the parser
//   accepts the span as complete.
// - Budget management: Reserve half the budget for constrained generation inside
//   spans, allowing multiple << >> pairs for intermediate steps and final answer.
//
// The parser governs what tokens are valid inside each << >> span, ensuring
// expressions are syntactically correct. validTokenGroups provides soft preferences
// for math tokens (digits, operators, parentheses) to guide the LM toward
// producing well-formed symbolic expressions.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Outside branch: When next == "<<", we set currentConstrainedOut := [].
//     parser.IsValidPrefix([]) holds by precondition parser.IsValidPrefix([]).
//     When next != "<<", insideConstrainedOut stays false, implication vacuous.
//   - CloseSpanIfComplete branch (closed == true): Sets insideConstrainedOut := false,
//     making the implication vacuous. currentConstrainedOut := [] satisfies the
//     !insideConstrainedOut ==> [] condition.
//   - CloseSpanIfComplete branch (closed == false): State unchanged, invariant preserved.
//   - Constrained step branch: AdaptiveConstrainedStep returns EOS or a parser-valid
//     next token. AppendConstrainedToken extends currentConstrainedOut with a valid
//     token, so parser.IsValidPrefix(currentConstrainedOut + [next]) holds.
//
// progress invariant: |generated| <= |generatedPrefix| + steps
//   - Outside branch: steps += 1, generated grows by at most 1 (the next token or
//     nothing on EOS). So |generated| <= |generatedPrefix| + steps is preserved.
//   - CloseSpanIfComplete branch: steps += 1. CloseSpanIfComplete appends at most
//     one token (">>") to generated, so |generated| grows by at most 1 while steps
//     grows by 1. Bound preserved.
//   - Constrained step branch: steps += 1. AppendConstrainedToken appends exactly
//     one token to generated, steps grows by 1. Bound preserved.
//     On EOS: steps += 1, generated unchanged, bound trivially preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math problem step by step. Wrap each intermediate symbolic expression and the final numeric answer in << >> delimiters. For example: The total is <<3 + 4>> = <<7>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    // Try to close if complete first (costs 1 step)
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Generate next constrained token using adaptive step with group preferences
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut,
        validTokenGroups, 4.0, narrowThreshold, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

