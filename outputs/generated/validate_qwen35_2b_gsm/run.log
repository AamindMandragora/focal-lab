Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with << >> delimiters for symbolic expressions and answers.
// State tracked: generated (full output), insideConstrainedOut (inside << >> span),
// currentConstrainedOut (content inside current span), steps (budget consumed).
//
// Strategy:
// - Phase 1 (outside span): Generate freely with UnconstrainedStep until "<<" appears
//   or EOS. When "<<" is observed in output, enter constrained mode.
// - Phase 2 (inside span): Use AdaptiveConstrainedStep with caller-supplied token
//   groups to generate parser-valid symbolic expressions. The adaptive helper applies
//   group boosts when the parser is narrow (few valid continuations), giving the LM
//   guidance toward valid math symbols. When the parser accepts a complete prefix,
//   close the span with CloseConstrainedSpan which emits ">>".
// - After closing, return to Phase 1 for more free generation (chain of thought
//   can have multiple << >> spans for intermediate steps and final answer).
//
// The narrowThreshold of 12 matches the AdaptiveConstrainedStep default, and
// boost amount of 4.0 provides strong but not overwhelming guidance toward
// valid math tokens. RepetitionPenalty is applied in constrained spans to
// discourage repeating the same expression fragments.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   Outside-span branch: If next != "<<", insideConstrainedOut stays false, invariant vacuous.
//     If next == "<<", we set currentConstrainedOut := [], and parser.IsValidPrefix([]) holds
//     by the precondition parser.IsValidPrefix([]).
//   Complete-span branch: CloseConstrainedSpan sets insideConstrainedOut := false,
//     making the implication vacuously true, and sets currentConstrainedOut := [].
//   Inside-span branch: AdaptiveConstrainedStep returns EOS or a parser-valid next token.
//     AppendConstrainedToken extends currentConstrainedOut by one valid token, preserving
//     parser.IsValidPrefix(currentConstrainedOut). EOS path breaks without modifying state.
//   SafeRepetitionPenaltyStep similarly returns EOS or parser-valid next token.
//
// progress invariant: |generated| <= |generatedPrefix| + steps
//   Outside-span branch: steps increments by 1, and generated grows by at most 1 token
//     (the next token, or nothing on EOS). So |generated| <= |generatedPrefix| + steps.
//   Complete-span branch: CloseConstrainedSpan appends ">>" (1 token) and steps increments
//     by 1. So |generated| grows by at most 1 and steps grows by 1, preserving the bound.
//   Inside-span branches: steps increments by 1, and AppendConstrainedToken appends at most
//     1 token. EOS path increments steps but does not grow generated. Bound preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math word problem step by step. Wrap each intermediate symbolic expression and the final numeric answer inside << >> delimiters. Show your work clearly.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next := eosToken;
    if validCount <= narrowThreshold {
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut,
        validTokenGroups, 4.0, narrowThreshold, eosToken
      );
    } else {
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut,
        generated, 2.0, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

