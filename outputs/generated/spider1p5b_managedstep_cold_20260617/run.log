Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the spider dataset.
// The strategy emits "SQL: " as unconstrained tokens, then opens a constrained
// span with "<<" and generates a valid SQL query inside it, guided by the parser
// and boosted by caller-supplied token groups (schema identifiers, SQL keywords).
// State tracked: generated (full output), insideConstrainedOut (span open flag),
// currentConstrainedOut (parser-tracked constrained content), steps (budget).
// Observations: if insideConstrained on entry, skip the preamble phase. Inside
// the span, use AdaptiveConstrainedStep with group boosts to prefer schema-relevant
// tokens. CloseSpanIfComplete closes the span when the SQL is complete.
// The repetition penalty discourages redundant token choices in long queries.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Outside-span branch: insideConstrainedOut is false, so the implication
//      is vacuously true. When next == "<<", we set currentConstrainedOut := [],
//      which satisfies parser.IsValidPrefix([]) by precondition.
//   2. CloseSpanIfComplete branch: when closed == true, insideConstrainedOut
//      becomes false (vacuous). When closed == false, state is unchanged and
//      the invariant holds by induction.
//   3. Constrained-step branch: AdaptiveConstrainedStep returns EOS or a token t
//      such that parser.IsValidPrefix(currentConstrainedOut + [t]).
//      AppendConstrainedToken sets currentConstrainedOut := currentConstrainedOut + [t],
//      which is valid by the above. SafeRepetitionPenaltyStep has the same guarantee.
// progress:
//   Every branch increments steps by 1 and appends at most one token to generated,
//   so |generated| <= |generatedPrefix| + steps is preserved. CloseSpanIfComplete
//   may append ">>" (one token, one step). The constrained branches each produce
//   at most one visible token per step.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a single valid SQL query answering the question. Output format: SQL: <<YOUR QUERY>>. Use only the tables and columns from the schema provided. No explanation, no markdown, just the SQL statement inside the constrained span.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next;
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= 12 {
        next := helpers.GroupBoostedConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, eosToken
        );
      } else {
        next := helpers.SafeRepetitionPenaltyStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
        );
      }
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

