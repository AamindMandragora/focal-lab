Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the Spider dataset.
//
// The key verification issue is the progress postcondition:
//   maxSteps == 0 || cost > 0 || generated != generatedPrefix ||
//   insideConstrainedOut != insideConstrained || currentConstrainedOut != currentConstrained
//
// When maxSteps > 0, we must ensure at least one of: cost > 0, generated changed,
// or span state changed. The fix is to ensure that when maxSteps > 0, we always
// take at least one step (either in the prefix loop, the forced OpenConstrainedSpan,
// or the main loop), so cost > 0.
//
// The previous approach had a subtle path: if maxSteps > 0 but prefixBudget == 0
// and we're already inside a span with OpenConstrainedSpan costing one step...
// Actually the problem is simpler: if maxSteps > 0, we try to take steps.
// The verifier can't prove cost > 0 because the path through OpenConstrainedSpan
// at steps < maxSteps uses steps + 1, but when insideConstrained is already true
// on entry (insideConstrained == true) AND maxSteps > 0, we skip Phase 1 and
// go straight to Phase 2 main loop which will take a step.
//
// Strategy: Make a single unified loop. If maxSteps > 0, the first iteration
// always takes a step (either unconstrained or constrained). This guarantees cost > 0.
//
// Phase 1: Use unconstrained steps to emit "SQL: " prefix (up to prefixBudget).
// Phase 2: Once inside span, use SafeRepetitionPenaltyStep + CloseSpanIfComplete.
// Phase 3: Cleanup with CloseSpanWithinBudget if needed.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Initialization preserves preconditions.
//   2. In the unconstrained branch, when next == "<<", currentConstrainedOut := []
//      which is valid by parser.IsValidPrefix([]) precondition.
//   3. OpenConstrainedSpan sets currentConstrainedOut := [] (valid).
//   4. CloseSpanIfComplete: closed==true makes implication vacuous; not-closed leaves state.
//   5. SafeRepetitionPenaltyStep returns EOS or parser-valid token; AppendConstrainedToken preserves validity.
//   6. CloseSpanWithinBudget guarantees insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - Each loop iteration increments steps by exactly 1 and appends at most one token.
//   - OpenConstrainedSpan appends "<<" (one token), steps incremented by 1.
//   - CloseSpanWithinBudget: closeBudget = maxSteps - steps, cost grows by at most closeBudget,
//     steps set to maxSteps. So |generated| <= |generatedPrefix| + maxSteps.
//
// progress postcondition (maxSteps == 0 || cost > 0 || ...):
//   - When maxSteps > 0, the main loop condition steps < maxSteps is true initially
//     (steps == 0 < maxSteps), so the loop body executes at least once, incrementing steps.
//     After the loop, cost := steps >= 1 > 0. QED.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a single valid SQL query answering the question. Output format: SQL: <<YOUR QUERY>>. Use only the tables and columns from the schema provided. No explanation, no markdown, just the SQL statement inside the constrained span.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var prefixBudget: nat := 8;

// Unified main loop
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if steps < prefixBudget {
      // Generate unconstrained to emit "SQL: " prefix
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    } else {
      // Force open a constrained span
      var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
      generated := og;
      insideConstrainedOut := oi;
      currentConstrainedOut := oc;
      steps := steps + 1;
    }
  } else {
    // Inside constrained span
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      break;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Cleanup: If still inside span, close within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

