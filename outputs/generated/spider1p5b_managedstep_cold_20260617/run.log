Strategy: // CSD_RATIONALE_BEGIN
// Improved SQL-generation CSD for the Spider dataset.
//
// Key problems from attempt 1:
// 1. entered_constrained_mode_too_early: The model entered << immediately after
//    "SQL: " without generating proper prefix context. The model needs to see
//    the "SQL: <<" preamble as a fixed forced sequence.
// 2. malformed_constrained_content: 28 examples had invalid spans (trailing semicolons,
//    newlines, curly braces etc). The SQL parser rejects these. We need repetition
//    penalties and grounding to prevent runaway repetition.
// 3. missing_constrained_segment: 18 examples had no << >>. The unconstrained phase
//    kept going past the << token.
// 4. unterminated_constrained_segment: 5 examples opened << but never closed.
//    CloseSpanWithinBudget can help here.
//
// Strategy:
// - Force "SQL: " as unconstrained preamble tokens, then force "<<" via OpenConstrainedSpan.
//   This avoids the model never emitting "<<" naturally.
// - Inside the span, use RegenerateUnitOnGroundingFailure with a tight budget to ensure
//   schema-grounded content at each grammar unit.
// - Use CloseSpanWithinBudget at the end to ensure the span closes.
// - Use AppendTaskGuidance with instructions that strongly discourage semicolons and
//   markdown inside the SQL span.
//
// The preamble "SQL: " is forced by repeatedly calling UnconstrainedStep until we
// have enough tokens OR we've spent too many steps. Then we force-open the span.
// Inside the span, use AdaptiveConstrainedStep with validTokenGroups boost and
// SafeRepetitionPenaltyStep to avoid runaway repetition.
// Reserve budget at the end for CloseSpanWithinBudget.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Preamble phase (outside span): insideConstrainedOut stays false throughout,
//      so the implication is vacuously true. OpenConstrainedSpan sets
//      currentConstrainedOut := [] which is valid by precondition parser.IsValidPrefix([]).
//   2. Inside-span phase: Each AdaptiveConstrainedStep / SafeRepetitionPenaltyStep
//      returns EOS or a parser-valid token. AppendConstrainedToken sets
//      currentConstrainedOut := currentConstrainedOut + [next], preserving validity.
//      CloseSpanWithinBudget returns (insideOut, currentOut) such that
//      (!insideOut ==> currentOut == []) and (insideOut ==> parser.IsValidPrefix(currentOut)).
//   3. CloseSpanIfComplete: when closed==true, insideConstrainedOut becomes false
//      (vacuous). When not closed, state is unchanged.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - Preamble: each UnconstrainedStep grows generated by at most 1 and steps by 1.
//   - OpenConstrainedSpan: grows generated by 1 (the "<<" token) and steps by 1.
//   - Inside-span: each constrained step grows steps by 1 and generated by at most 1
//     via AppendConstrainedToken.
//   - CloseSpanWithinBudget uses closeBudget = maxSteps - steps tokens, so
//     |generated| grows by at most closeBudget = maxSteps - steps, keeping total
//     |generated| <= |generatedPrefix| + maxSteps.
//   - cost := steps is set from the total steps used, satisfying cost <= maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Output exactly: SQL: <<query>> where query is a single valid SQL statement with no semicolons, no markdown, no newlines, no curly braces. Use only table and column names from the schema. The << opens the SQL span and >> closes it immediately after the last SQL token.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: If not already inside a span, generate preamble tokens until we see "<<"
// or exhaust a preamble budget, then force-open the span.
// We reserve at least 50 steps for the SQL content + closing.
var preambleBudget: nat := 8;
var spanBudget: nat := if maxSteps > 12 then maxSteps - 8 else maxSteps;

if !insideConstrainedOut && steps < maxSteps {
  // Generate preamble (free) up to preambleBudget steps or until << is seen
  var preambleSteps: nat := 0;
  while preambleSteps < preambleBudget && steps < maxSteps && !insideConstrainedOut
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant |generated| <= |generatedPrefix| + steps
    decreases preambleBudget - preambleSteps
  {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    preambleSteps := preambleSteps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  }

  // If we still haven't entered a span and have budget, force-open one
  if !insideConstrainedOut && steps < maxSteps {
    var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
    generated := og;
    insideConstrainedOut := oi;
    currentConstrainedOut := oc;
    steps := steps + 1;
  }
}

// Phase 2: Inside-span constrained generation
// Reserve some budget for closing the span
var closeReserve: nat := 6;
var innerBudget: nat := if maxSteps > steps + closeReserve then maxSteps - steps - closeReserve else 0;
var innerSteps: nat := 0;

while insideConstrainedOut && innerSteps < innerBudget && steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases innerBudget - innerSteps
{
  // Try to close if complete
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  innerSteps := innerSteps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else {
    // Generate next constrained token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next;
    if validCount <= 15 {
      // Narrow branch: use group boost
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, eosToken
      );
    } else {
      // Wide branch: use repetition penalty to avoid runaway repetition
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.5, eosToken
      );
    }
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Phase 3: If still inside span and have budget left, use CloseSpanWithinBudget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

