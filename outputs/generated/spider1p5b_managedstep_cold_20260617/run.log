Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for Spider dataset.
// The verification failure is that |generated| <= |generatedPrefix| + maxSteps
// cannot be proved. The issue is in Phase 2 where we set steps := steps + groundingBudget
// but groundingBudget may not correctly bound the growth of generated.
//
// Fix: Instead of using RegenerateUnitOnGroundingFailure (which has complex cost
// accounting), use a simple loop with AdaptiveConstrainedStep inside the span.
// This gives us precise step-by-step control and makes the invariant easy to prove.
//
// Strategy:
// 1. AppendTaskGuidance with SQL-specific guidance.
// 2. Phase 1: UnconstrainedStep (not chunk) until "<<" is seen or budget exhausted.
//    This gives per-step control for the invariant.
// 3. Phase 2: Inside span, use AdaptiveConstrainedStep + AppendConstrainedToken
//    with CloseSpanIfComplete check each step.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Outside the span: insideConstrainedOut is false, implication vacuously true.
//      When next == "<<", we set insideConstrainedOut := true and currentConstrainedOut := [],
//      and IsValidPrefix([]) holds by precondition.
//   2. Inside the span: CloseSpanIfComplete either closes (making implication vacuous,
//      currentConstrainedOut := []) or is a no-op (preserving validity).
//      AdaptiveConstrainedStep returns EOS or parser-valid token.
//      AppendConstrainedToken preserves parser validity.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - Every branch in the loop increments steps by exactly 1.
//   - Every branch appends at most 1 token to generated (or none on EOS/break).
//   - So |generated| <= |generatedPrefix| + steps is preserved throughout.
//   - When maxSteps > 0: the loop body runs at least once (cost > 0).
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a single valid SQL query answering the question. Output format: SQL: <<YOUR QUERY>>. Use only the tables and columns from the schema provided. No explanation, no markdown, just the SQL statement inside the constrained span.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

