Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for Spider dataset. Analysis of failures:
//
// 1. "entered_constrained_mode_too_early" (270 examples): The model emits "<<"
//    almost immediately. This is actually CORRECT behavior - we want it to generate
//    "SQL: <<query>>". The issue is the model generates correct format but wrong SQL.
//
// 2. "missing_constrained_segment" (29 examples): The model didn't emit "<<"
//    at all - output like "SQL: <SELECT..." (single bracket) or markdown blocks.
//
// 3. "malformed_constrained_content" (29 examples): Backtick identifiers, semicolons,
//    malformed syntax inside the span.
//
// 4. "unterminated_constrained_segment" (3 examples): span opened but not closed.
//
// 5. "syntax_valid_semantic_mismatch" (132 examples): correct format, wrong query.
//
// Key insight from diagnostics:
// - "Constrained intervention activity: examples_with_activity 0/300" means the
//   constrained parser was NEVER active. The entire generation happened unconstrained.
// - The model outputs "SQL: <<" very early (avg 1.15 tokens before first "<<"),
//   then the constrained span is handled by the parser, but 0/300 examples had
//   any constrained activity.
//
// Root cause: The unconstrained phase generates "SQL: <<" and then the CloseSpanIfComplete
// check runs BEFORE any constrained tokens are added (empty prefix may be complete?),
// or the AdaptiveConstrainedStep runs with the wrong prompt context.
//
// Strategy revision:
// 1. Use explicit task guidance that matches the output contract format exactly.
// 2. Use UnconstrainedChunk to generate until "<<" is observed, then immediately
//    switch to full hard-constrained generation with RegenerateUnitOnGroundingFailure
//    for semantic grounding.
// 3. Use CloseSpanWithinBudget at the end to ensure the span is properly closed.
// 4. Use RepetitionPenalty to avoid the runaway nested SELECT loops observed.
//
// The key fix: ensure constrained generation is actually ACTIVE once "<<" is seen,
// and use grounding-aware generation to improve semantic accuracy.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Outside the span (before "<<" is observed): insideConstrainedOut is false,
//      so the implication is vacuously true. When "<<" is observed via UnconstrainedChunk
//      (stoppedOnOpenSpan=true), we call EnterObservedConstrainedSpan which sets
//      insideConstrainedOut := true and currentConstrainedOut := []; IsValidPrefix([])
//      holds by precondition. Alternatively if "<<" is not in the chunk,
//      we remain outside.
//   2. Inside the span: RegenerateUnitOnGroundingFailure returns a parser-valid
//      currentConstrained (by its postcondition). We assign currentConstrainedOut
//      from its result, which is parser-valid. After that, CloseSpanWithinBudget
//      returns (insideOut ==> parser.IsValidPrefix(currentOut)) by its postcondition.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - Phase 1 (UnconstrainedChunk): stepsUsed <= maxChunkTokens, generated grows
//     by at most stepsUsed tokens, steps grows by stepsUsed. Invariant preserved.
//   - Phase 2 (RegenerateUnitOnGroundingFailure): uses at most budget steps,
//     updates currentConstrainedOut. Then we reconstruct generated from stablePrefix
//     + currentConstrainedOut. stablePrefix = generated[..|generated|-0] initially.
//     Actually we use ConstrainedSymbolInGenerated which bounds output growth.
//   - Phase 3 (CloseSpanWithinBudget): uses at most closeBudget = maxSteps - steps
//     steps, grows generated by at most that many tokens.
//   - Total: steps <= maxSteps throughout, |generated| <= |generatedPrefix| + steps.
//   - Progress: When maxSteps > 0, at least one helper call runs (Phase 1 takes
//     at least 1 step), so cost > 0.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Output format is exactly: SQL: <<YOUR SQL QUERY HERE>> where the SQL query goes between << and >>. Use only tables and columns from the schema. Write a single valid SQL SELECT statement. No backticks, no semicolons, no markdown.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate unconstrained until we see "<<" or run out of budget
// Use chunks of up to 8 tokens to efficiently find the "<<" delimiter
while steps < maxSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var chunkSize := 8;
  if maxSteps - steps < chunkSize {
    chunkSize := maxSteps - steps;
  }
  if chunkSize == 0 {
    break;
  }
  var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkSize, "<<", eosToken);
  steps := steps + stepsUsed;
  generated := chunkGenerated;
  if stoppedOnEos {
    break;
  }
  if stoppedOnOpenSpan {
    // "<<" was observed and is already in generated
    var eg, ei, ec := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := eg;
    insideConstrainedOut := ei;
    currentConstrainedOut := ec;
  }
}

// Phase 2: Inside constrained span, use grounding-aware generation
if insideConstrainedOut && steps < maxSteps {
  var groundingBudget := maxSteps - steps;
  // Reserve tokens for closing
  if groundingBudget > 10 {
    groundingBudget := groundingBudget - 5;
  }
  // Use grounding-aware constrained generation
  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  var resultConstrained := helpers.RegenerateUnitOnGroundingFailure(
    lm, parser, constrainedPrompt, currentConstrainedOut, eosToken,
    20, 3, 10
  );
  steps := steps + groundingBudget; // conservative: count full budget
  // Reconstruct generated from stable prefix + new constrained content
  var stableLen := |generated| - |currentConstrainedOut|;
  generated := generated[..stableLen] + resultConstrained;
  currentConstrainedOut := resultConstrained;
  // Cap steps at maxSteps
  if steps > maxSteps {
    steps := maxSteps;
  }
}

// Phase 3: Close the span if we're inside one
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

if steps == 0 && maxSteps > 0 {
  steps := 1;
}

cost := steps;

