Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the Spider dataset.
//
// Diagnosis from failure data:
// 1. "entered_constrained_mode_too_early": The model immediately outputs "SQL: <<"
//    but then the constrained generation gets confused because it sees "<<" in the
//    prefix and generates another "<<" (double-open), or runs long repetitions.
// 2. "unterminated_constrained_segment": The span opens but never closes within budget.
// 3. "too_slow": 3 examples timed out — SafeRepetitionPenaltyStep is slow (0.75s/token).
//    With 1200 steps and 0.75s/token, that's 900s per example — way over the 300s budget.
//    We need to reduce the number of LM calls. Use CloseSpanWithinBudget to handle
//    the bulk of constrained generation efficiently.
//
// Root cause of timeout: At 0.75s per token, we can only afford ~400 tokens per
// 300s budget. The previous strategy called CloseSpanIfComplete every constrained
// step (costing 1 step), then AdaptiveConstrainedStep (another step), effectively
// 2 LM calls per token. That halves throughput.
//
// Fix strategy:
// 1. Use a small unconstrained prefix budget (just enough to emit "SQL: <<").
//    The model tends to emit "SQL: <<" very quickly (avg 2 tokens before "<<").
// 2. Once inside the span (or forced open), use CloseSpanWithinBudget with the
//    ENTIRE remaining budget. This helper tracks completeness internally and uses
//    efficient forward generation. It avoids double-calling CloseSpanIfComplete.
// 3. Use a small unconstrained prefix budget (e.g., 15 steps) to let the model
//    naturally output "SQL: <<". If it doesn't open a span in 15 steps, force
//    open one with OpenConstrainedSpan.
// 4. The total step budget is 1200. With 0.75s/token and 300s limit, we can
//    handle ~400 tokens. So set prefix budget to 15, span budget to remaining.
//
// The key insight: CloseSpanWithinBudget is the RIGHT tool here because:
// - It handles the completion tracking internally (no per-token CloseSpanIfComplete)
// - It uses the full remaining budget efficiently
// - It guarantees the span closes if completable within budget
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1 (unconstrained loop): insideConstrainedOut is false, so implication
//   is vacuous. When next == "<<", we set currentConstrainedOut := [], valid by
//   parser.IsValidPrefix([]).
//   Phase 2 (OpenConstrainedSpan): sets currentConstrainedOut := [], valid by
//   parser.IsValidPrefix([]).
//   Phase 3 (CloseSpanWithinBudget): postcondition guarantees
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut).
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: each iteration increments steps by 1 and appends at most 1 token.
//   Phase 2: OpenConstrainedSpan appends "<<" (1 token), steps incremented by 1.
//   Phase 3: CloseSpanWithinBudget uses closeBudget = maxSteps - steps,
//   |generated| grows by at most closeBudget, steps := maxSteps.
//   Total: |generated| <= |generatedPrefix| + maxSteps.
//
//   progress postcondition (maxSteps > 0 => cost > 0 or state changed):
//   When maxSteps > 0: if insideConstrained was true on entry, we skip Phase 1
//   and go directly to Phase 3 which sets steps := maxSteps >= 1, so cost >= 1 > 0.
//   If insideConstrained was false, Phase 1 runs at least once (steps becomes 1 > 0)
//   OR we reach the OpenConstrainedSpan (steps becomes 1 > 0) OR we enter Phase 3.
//   Either way, cost := steps > 0.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a valid SQL query. Format: SQL: <<query here>>. Use only schema tables/columns. Output only the format shown.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
// Small prefix budget: let model naturally output "SQL: <<"
// At avg 2 tokens before "<<", 20 steps is generous
var prefixBudget: nat := 20;

// Phase 1: Generate unconstrained until "<<" is observed or prefix budget exhausted
while steps < maxSteps && steps < prefixBudget && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    // EOS in prefix phase - just stop
    cost := steps;
    return;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// Phase 2: If we haven't entered a span yet, force one open
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 3: Use CloseSpanWithinBudget to complete and close the span
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

