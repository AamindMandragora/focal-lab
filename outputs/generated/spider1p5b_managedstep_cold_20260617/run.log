Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the Spider dataset.
//
// Key insight from failure analysis:
// 1. "entered_constrained_mode_too_early" (275 examples): The model opens "<<" on the
//    very first unconstrained step, then the constrained parser generates a poor SQL query.
//    Fix: Force generation of the prefix "SQL: " before allowing the span to open.
//    We generate unconstrained tokens for a few steps to emit "SQL: " before entering span.
//
// 2. "missing_constrained_segment" (24 examples): The model never emits "<<".
//    Fix: After a budget of unconstrained steps, if still outside span, force open a span.
//
// 3. "malformed_constrained_content" (36 examples): The constrained parser generates
//    bad SQL (backticks, subqueries, etc.). Fix: Use SafeRepetitionPenaltyStep inside
//    the span to avoid repetitive subquery patterns. Also use CloseSpanWithinBudget
//    to ensure the span is properly closed.
//
// 4. "unterminated_constrained_segment" (4 examples): Span opened but never closed.
//    Fix: Use CloseSpanWithinBudget after the main loop.
//
// Strategy:
// Phase 1 (outside span): Run UnconstrainedStep for up to "prefixBudget" steps.
//   This allows "SQL: " to be emitted. If "<<" is observed, enter span.
//   If budget exhausted without span, force open a span.
// Phase 2 (inside span): Use SafeRepetitionPenaltyStep to generate SQL content
//   with repetition penalties. Check CloseSpanIfComplete each step.
// Phase 3 (cleanup): If still inside span at end of main loop, use CloseSpanWithinBudget.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Outside span: insideConstrainedOut is false so implication is vacuous.
//      When next == "<<", we set currentConstrainedOut := [] which is valid by
//      parser.IsValidPrefix([]) precondition.
//   2. OpenConstrainedSpan: sets insideConstrainedOut := true, currentConstrainedOut := [],
//      valid by precondition.
//   3. Inside span, CloseSpanIfComplete: when closed==true, insideConstrainedOut becomes
//      false (implication vacuous). When not closed, state unchanged.
//   4. SafeRepetitionPenaltyStep returns EOS or a parser-valid token.
//      AppendConstrainedToken preserves validity.
//   5. CloseSpanWithinBudget postcondition guarantees
//      (insideOut ==> parser.IsValidPrefix(currentOut)).
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - Each loop iteration increments steps by 1 and appends at most one token.
//   - OpenConstrainedSpan appends one token ("<<") and we increment steps by 1.
//   - CloseSpanWithinBudget uses closeBudget = maxSteps - steps, growing generated
//     by at most closeBudget, and we set steps := maxSteps.
//   - Total: |generated| <= |generatedPrefix| + maxSteps throughout.
//   - When maxSteps > 0, loop runs at least once so cost > 0.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "You are a SQL generator. Your output must be exactly: SQL: <<your_sql_query_here>> with the SQL query inside the << >> delimiters. No explanation, no markdown. Example: SQL: <<SELECT col FROM tbl WHERE cond>>. Write one valid SQL query using only the provided schema.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
// Allow up to this many unconstrained steps to emit "SQL: " prefix before forcing span open
var prefixBudget: nat := 8;

// Phase 1: Generate outside span until "<<" is seen or prefix budget exhausted
while steps < maxSteps && steps < prefixBudget && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  } else {
    generated := generated + [next];
    if next == "<<" {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  }
}

// If still outside span after prefix budget, force open a span
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Main loop - generate inside or outside span
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // We exited span - we're done
    break;
  } else {
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      break;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Phase 3: If still inside span, close it within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

