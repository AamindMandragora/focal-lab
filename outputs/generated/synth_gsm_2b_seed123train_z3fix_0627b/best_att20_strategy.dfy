// CSD_RATIONALE_BEGIN
// Root cause analysis from all attempts:
// 1. TINY SPANS (dominant failure, 83% of wrong answers): The model closes the
//    constrained span after 1-2 tokens because IsCompletePrefix becomes true
//    after a single variable name. The grammar allows single identifiers as
//    complete expressions.
//
// 2. The model generates the correct answer in plain text reasoning but the
//    constrained span captures only the first token (e.g., "n1" instead of
//    "n1 * p1 + n2 * p2 + n3 * p3").
//
// 3. UNTERMINATED spans (4 examples): The model opens << near budget end and
//    there's no budget left for content + close.
//
// KEY INSIGHT from best attempt (4.1%):
// - minSpanTokens=8 helped but the guard `!parser.IsCompletePrefix` before
//   AppendConstrainedToken caused tokens to be DROPPED (not appended) when
//   IsCompletePrefix was true but |current| < minSpanTokens. This meant the
//   model was generating tokens that were thrown away, wasting budget.
//
// CRITICAL FIX:
// When IsCompletePrefix is true but |current| < minSpanTokens, we need to
// EXTEND the expression. The proper way to do this:
// 1. Call ConstrainedStep to get the next token (even at complete state)
// 2. If next != eosToken, call AppendConstrainedToken ONLY IF !IsCompletePrefix(current)
//    OR if the grammar allows extension (IsTokenValidNext returns true).
//
// The precondition of AppendConstrainedToken requires that the token is valid next.
// ConstrainedStep already ensures this. The issue is the guard was dropping tokens.
//
// NEW APPROACH: Use RolloutConstrainedWithPenalties or ConstrainedSymbolInGenerated
// to generate the entire expression at once, with a budget of 60 tokens.
// This helper loops internally until completion, EOS, or budget.
//
// RolloutConstrainedWithPenalties(lm, parser, prompt, startPrefix, totalBudget,
//   penalties, penaltyAmount, eosToken) → (generatedOut, stepsUsed, hitEos)
// It extends from startPrefix token-by-token until completion/EOS/budget.
// This is EXACTLY what we need: generate until IsCompletePrefix, then stop.
// But it still closes at first complete prefix!
//
// ALTERNATIVE: Use ConstrainedSymbolInGenerated with budget 60, which generates
// up to budget tokens and accepts the longest parser-valid prefix.
//
// BETTER ALTERNATIVE: Use CloseSpanWithinBudget from the START of the constrained
// span, but give it a hint by first generating some minimum context with
// AdaptiveConstrainedStep calls that do NOT check IsCompletePrefix, then
// use CloseSpanWithinBudget.
//
// ACTUAL FIX: The problem with CloseSpanWithinBudget is it closes at the FIRST
// complete prefix it sees. If we want to generate past complete prefixes, we
// need to run our own loop but NOT break on IsCompletePrefix until we have
// enough tokens.
//
// The key fix is: remove the !IsCompletePrefix guard from AppendConstrainedToken.
// But AppendConstrainedToken has that as a precondition...
//
// WORKAROUND: Use ConstrainedSymbolInGenerated with a budget of 60.
// It generates up to 60 tokens and accepts the LONGEST valid prefix.
// If the grammar allows extension past the first complete point, it will
// extend further. This naturally handles the "extend past first complete" issue.
//
// After ConstrainedSymbolInGenerated returns, we use CloseSpanWithinBudget
// to close cleanly.
//
// FINAL STRATEGY:
// 1. AppendTaskGuidance with clear expression guidance
// 2. UnconstrainedChunk for reasoning (up to 300 tokens)
// 3. Force open "<<" if not already open
// 4. ConstrainedSymbolInGenerated with budget 80 to generate the full expression
// 5. CloseSpanWithinBudget as safety net
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Phase 1 (unconstrained loop): UnconstrainedChunk does not change constrained
//     state unless stoppedOnOpenSpan; EnterObservedConstrainedSpan sets
//     currentConstrainedOut := [] which is valid by precondition. OpenConstrainedSpan
//     similarly sets currentConstrainedOut := [] (valid).
//   - Phase 2 (ConstrainedSymbolInGenerated): This helper's postcondition guarantees
//     currentOut is parser-valid. After the call, insideConstrainedOut remains true
//     and currentConstrainedOut := currentOut which is parser-valid.
//   - Phase 3 (CloseSpanWithinBudget): Its postcondition guarantees that if
//     insideOut is true, currentOut is parser-valid. If insideOut is false,
//     currentOut == [] making the implication vacuous.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Phase 1: UnconstrainedChunk grows generated by stepsUsed, steps += stepsUsed.
//     OpenConstrainedSpan: generated grows by 1, steps += 1.
//   - Phase 2: ConstrainedSymbolInGenerated: |generatedOut| <= |generated| + stepsUsed,
//     steps += stepsUsed (bounded by exprBudget).
//   - Phase 3: CloseSpanWithinBudget: |generatedOut| <= |generated| + closeBudget,
//     steps := maxSteps ensures |generated| <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

helpers.AppendTaskGuidance(lm, "Solve step by step using template variable names (no curly braces). At the very end, write the COMPLETE arithmetic expression inside << >>. The expression must include ALL relevant variables and operators (e.g., <<n1 * p1 + n2 * p2 + n3 * p3>> or <<total - n1 - mult * n1>>). Write the FULL expression, not just one variable name.");

// Phase 1: Generate unconstrained reasoning until "<<" appears, cap at 300 tokens.
var phase1Cap: nat := 300;
if phase1Cap > maxSteps {
  phase1Cap := maxSteps;
}

while steps < phase1Cap && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases phase1Cap - steps
{
  var remaining: nat := phase1Cap - steps;
  var chunkSize: nat := remaining;
  if chunkSize > 60 {
    chunkSize := 60;
  }
  if chunkSize == 0 {
    break;
  }
  var genOut, stoppedOnOpen, stoppedOnEos, stepsUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkSize, "<<", eosToken);
  generated := genOut;
  steps := steps + stepsUsed;
  if stoppedOnEos {
    break;
  } else if stoppedOnOpen {
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  }
}

// If still not inside a constrained span, force open one (if budget allows)
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 2: Inside constrained span - generate the full expression.
// Use ConstrainedSymbolInGenerated which generates tokens and accepts the
// longest parser-valid prefix, naturally extending past early complete states.
if insideConstrainedOut && steps < maxSteps {
  var stableLen: nat := |generated| - |currentConstrainedOut|;
  var constrainedPrompt := prompt + generated[..stableLen];

  // Budget for expression: use up to 80 tokens, reserve 20 for closing
  var phase2Budget: nat := maxSteps - steps;
  var reserveForClose: nat := 20;
  var exprBudget: nat := 0;
  if phase2Budget > reserveForClose {
    exprBudget := phase2Budget - reserveForClose;
  } else {
    exprBudget := phase2Budget;
  }
  if exprBudget > 80 {
    exprBudget := 80;
  }

  if exprBudget >= 1 {
    var genOut2, curOut2, hitEos2, stepsUsed2 :=
      helpers.ConstrainedSymbolInGenerated(
        lm, parser, constrainedPrompt, generated, currentConstrainedOut, exprBudget, eosToken
      );
    generated := genOut2;
    currentConstrainedOut := curOut2;
    steps := steps + stepsUsed2;
  }

  // Now try to close if complete
  if insideConstrainedOut && parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  }

  // Safety net: CloseSpanWithinBudget to handle any remaining open span
  if insideConstrainedOut && steps < maxSteps {
    var closeBudget: nat := maxSteps - steps;
    var cg2, ci2, cc2 := helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
    );
    generated := cg2;
    insideConstrainedOut := ci2;
    currentConstrainedOut := cc2;
    steps := maxSteps;
  }
}

cost := steps;