Strategy: // CSD_RATIONALE_BEGIN
// The previous best attempt (38.8% accuracy, 91.8% syntax) timed out on 3 examples
// because Phase 1 spent too long in free generation before forcing "<<".
// The key diagnosis: with stepTokenBudget=1 and maxSteps=900, we have 900 token steps.
// The model (Qwen3.5-4B) may never emit "<<" on its own in free generation.
//
// Root cause of timeout: UnconstrainedChunk with chunks of 15 and cap at 400 steps
// is too slow - each chunk call invokes the LM multiple times, and with a 90s budget
// and slow inference, 400 free steps exhausts the time budget before even opening a span.
//
// Fix: Dramatically reduce Phase 1 free generation. Use at most 200 steps for free text,
// then FORCE open "<<" immediately. Use small chunks (10 tokens max) to stay responsive.
//
// Additionally: reduce Phase 2 constrained step cap from 60 to 40 to avoid spending
// too long inside the span. The expression should be short (< 20 tokens typically).
//
// Secondary fix: use ConstrainedStep instead of SafeRepetitionPenaltyStep inside
// the span - it's simpler and faster, avoiding the overhead of penalty computation
// on every step.
//
// Strategy:
// - Phase 1: UnconstrainedChunk with chunks of 10, hard cap at 200 steps.
//   Force "<<" if model hasn't emitted it by then.
// - Phase 2: Inside span, use CloseSpanIfComplete each step then ConstrainedStep.
//   Hard cap at 40 constrained steps.
// - Phase 3: CloseSpanWithinBudget with all remaining budget as backstop.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1: insideConstrainedOut flips true only when stoppedOnOpenSpan, at which point
//   EnterObservedConstrainedSpan sets currentConstrainedOut := [] (valid by precondition).
//   OpenConstrainedSpan similarly sets currentConstrainedOut := [] and insideConstrainedOut := true.
//   Phase 2: CloseSpanIfComplete returns either closed (insideOut=false, currentOut=[], vacuous)
//   or unchanged valid state. ConstrainedStep returns EOS or parser-valid next token;
//   AppendConstrainedToken preserves parser.IsValidPrefix by contract.
//   Phase 3: CloseSpanWithinBudget postcondition: either closed (current=[]) or open valid prefix.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: UnconstrainedChunk grows generated by at most chunkUsed tokens and steps
//   increments by chunkUsed. OpenConstrainedSpan appends 1 token and steps += 1.
//   So |generated| <= |generatedPrefix| + steps throughout Phase 1.
//   Phase 2: each iteration: CloseSpanIfComplete costs 1 step and appends at most 1 token (">>");
//   ConstrainedStep costs 1 step and AppendConstrainedToken appends at most 1 token.
//   So per outer iteration, steps increases by at most 2 and |generated| grows by at most 1
//   (the close case) or at most 1 (the token case). Both cases preserve |generated| <= |generatedPrefix| + steps.
//   Wait - two steps per iteration but only one token appended. steps += 1 per CloseSpanIfComplete
//   and if not closed, steps += 1 again for ConstrainedStep, so steps += 2 for one token.
//   |generated| grows by at most 1 per iteration, steps grows by at most 2. Bound preserved.
//   Phase 3: CloseSpanWithinBudget: |generatedOut| <= |generated| + closeBudget, steps := maxSteps.
//   So |generated| <= |generatedPrefix| + maxSteps. cost := steps <= maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve this math problem step by step, then write ONLY the final symbolic answer expression inside << >> at the very end. Use only variable names, numbers, +, -, *, /, //, %, (, ) inside << >>. Example: <<n * price + extra>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate freely until "<<" is observed, hard cap at 200 steps
var freeCapSteps: nat := 200;

while steps < maxSteps && steps < freeCapSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var remaining := maxSteps - steps;
  var freeRemaining := freeCapSteps - steps;
  var chunkSize: nat := 10;
  if remaining < chunkSize {
    chunkSize := remaining;
  }
  if freeRemaining < chunkSize {
    chunkSize := freeRemaining;
  }
  if chunkSize == 0 {
    break;
  }

  var generatedOut, stoppedOnOpenSpan, stoppedOnEos, chunkUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkSize, "<<", eosToken);

  generated := generatedOut;
  steps := steps + chunkUsed;

  if stoppedOnOpenSpan {
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  } else if stoppedOnEos {
    break;
  }
}

// Force open a constrained span if we never entered one and have budget
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 2: Inside the span, generate constrained tokens, close when complete
// Cap at 40 constrained steps (expression should be short)
var constrainedStepCap: nat := 40;
var constrainedStepsTaken: nat := 0;

while insideConstrainedOut && steps < maxSteps && constrainedStepsTaken < constrainedStepCap
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Try to close the span first (free if not complete)
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  constrainedStepsTaken := constrainedStepsTaken + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else if steps < maxSteps {
    // Generate next constrained token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
    steps := steps + 1;
    constrainedStepsTaken := constrainedStepsTaken + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

// Phase 3: If span still open, use CloseSpanWithinBudget to force closure
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

