Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis: 25/49 examples produce syntax-valid but semantically wrong answers.
// The main issue is that the constrained span closes too early (on the first
// "complete" parse, which may be just one token like "2") before the model
// has generated the full expression. The "tiny_span_dominant" metric confirms
// this: 34/49 examples have only tiny valid visible spans.
//
// The 4 unterminated spans are caused by the model emitting "<<" mid-sentence
// in unconstrained text (attached to prose like "we<<int()") and then the
// constrained parser can't complete. Fix: use OpenConstrainedSpan to FORCE
// the span open at the right moment, not observe it mid-prose.
//
// Key insight from the failing rollouts:
// 1. "<<2>>" instead of "<<2*n - m>>" - span closes on first complete parse (the "2")
// 2. "<<(total // n1)>>" instead of "<<total // n1 + (total // n2) * t>>" - premature close
// 3. Unterminated because model emits "<<" as part of prose token "we<<int("
//
// Root fixes:
// A) Don't use CloseSpanIfComplete in Phase 2 - it closes at first complete parse.
//    Instead, run a fixed minimum number of constrained steps before allowing close.
//    Use ConstrainedStep to build the expression, then CloseSpanWithinBudget to close.
// B) Don't use UnconstrainedChunk to detect "<<" - model embeds it in prose.
//    Instead use UnconstrainedStep token by token to detect "<<" as a standalone token.
//    Then force OpenConstrainedSpan explicitly.
// C) After generating some constrained tokens, use CloseSpanWithinBudget which
//    tracks the longest complete prefix - this naturally picks a longer expression.
//
// Strategy:
// - Phase 1: Generate free tokens one at a time up to 300 steps. If standalone "<<"
//   is emitted, enter via EnterObservedConstrainedSpan. If not, force OpenConstrainedSpan.
// - Phase 2: Generate constrained tokens with minimum 8 steps before allowing close.
//   Use SafeTemperatureConstrainedStep to encourage longer more varied expressions.
// - Phase 3: CloseSpanWithinBudget to find and emit the best complete expression.
//
// The minimum-step guard prevents premature closure on trivially complete parses.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1: insideConstrainedOut flips true only on next == "<<" (EnterObservedConstrainedSpan
//   sets currentConstrainedOut := []) or via OpenConstrainedSpan (also sets currentConstrainedOut := []).
//   Both set a valid [] prefix. The invariant is maintained throughout Phase 1.
//   Phase 2: ConstrainedStep returns EOS or a parser-valid next token.
//   AppendConstrainedToken preserves parser.IsValidPrefix by contract.
//   Phase 3: CloseSpanWithinBudget postcondition guarantees either a closed span
//   (insideOut=false, currentOut=[]) or an open valid prefix. Both preserve the invariant.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: Each iteration of the while loop calls UnconstrainedStep (+1 step, +1 token
//   if not EOS). OpenConstrainedSpan adds 1 token and steps += 1.
//   So |generated| <= |generatedPrefix| + steps throughout.
//   Phase 2: Each iteration calls ConstrainedStep (+1 step) and AppendConstrainedToken
//   (+0 cost, +1 token or 0 on EOS). So |generated| grows by at most 1 per step.
//   Phase 3: CloseSpanWithinBudget uses closeBudget steps; steps := maxSteps after.
//   |generatedOut| <= |generated| + closeBudget <= |generatedPrefix| + maxSteps.
//   cost := steps <= maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Think step by step through the problem using the variable names given. At the very end, write the final symbolic answer inside << >>. The answer should be a complete expression using the problem's variable names and arithmetic operators (+, -, *, /, //, %). Example: <<(n * price) + extra>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate free tokens one at a time, watch for standalone "<<" token
// Hard cap at 300 steps for free generation
var freeCapSteps: nat := 300;

while steps < maxSteps && steps < freeCapSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  } else {
    generated := generated + [next];
    if next == "<<" {
      generated, insideConstrainedOut, currentConstrainedOut :=
        helpers.EnterObservedConstrainedSpan(lm, generated);
    }
  }
}

// Force open a constrained span if we never entered one and have budget
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 2: Generate constrained tokens with a minimum run before closing
// Run at least minConstrainedSteps to build the expression before allowing close
// Use a hard cap to reserve budget for Phase 3
var minConstrainedSteps: nat := 10;
var maxConstrainedSteps: nat := 50;
var constrainedStepsTaken: nat := 0;

while insideConstrainedOut && steps < maxSteps && constrainedStepsTaken < maxConstrainedSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Only try to close after minimum steps AND when parser says complete
  if constrainedStepsTaken >= minConstrainedSteps && parser.IsCompletePrefix(currentConstrainedOut) {
    // We have a complete expression after minimum steps - stop generating
    // and let Phase 3 handle closure
    break;
  }

  // Generate next constrained token
  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
  steps := steps + 1;
  constrainedStepsTaken := constrainedStepsTaken + 1;
  if next == eosToken {
    break;
  } else {
    var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
      lm, parser, generated, currentConstrainedOut, next
    );
    generated := appendedGenerated;
    insideConstrainedOut := appendedInside;
    currentConstrainedOut := appendedCurrent;
  }
}

// Phase 3: Use CloseSpanWithinBudget to find a complete state and emit ">>"
// This finds the longest completable prefix within the budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

