Strategy: // CSD_RATIONALE_BEGIN
// All recent attempts (18-22) timed out because Phase 1 free generation is too slow.
// The best result (attempt 16, 40.8% accuracy) used freeCapSteps=200, chunkSize=10.
// But attempts 22 (exact replica) still timed out - something changed.
//
// Key insight from the feedback: "Constrained intervention activity: examples_with_activity 0/3"
// This means NO constrained tokens were generated - the timeout happens BEFORE we even
// reach Phase 2. The LM is taking too long just in Phase 1 free generation.
//
// The root cause: UnconstrainedChunk with chunkSize=10 makes multiple LM calls per loop
// iteration. With slow inference (90s budget, 3 examples already timing out), even 200
// free steps with chunks of 10 = 20 loop iterations with 10 LM calls each = 200 LM calls
// is too many.
//
// Fix: DRASTICALLY reduce Phase 1 to almost nothing. The model will never emit "<<"
// on its own (0/3 examples had visible <<). So instead of waiting for it, we should:
// 1. Skip Phase 1 entirely (0 free steps)
// 2. IMMEDIATELY force "<<" via OpenConstrainedSpan
// 3. Use constrained generation for the answer expression
//
// This is the fastest possible approach: no free generation, just force the span open
// and generate the answer directly. This matches "FORCE the opening delimiter at span entry"
// from the feedback.
//
// But wait - if we skip free generation, the model has no reasoning context before <<>>.
// The evaluator extracts the answer from <<>>. Without reasoning steps, the constrained
// expression must encode the full symbolic answer.
//
// The parser validates the constrained content. With just a symbolic math expression,
// the parser should accept: numbers, variable names, operators (+, -, *, /, //, %, etc.)
//
// Strategy:
// - Phase 1: MINIMAL free generation (at most 50 steps with chunks of 5) to let model
//   establish reasoning context before the answer span.
// - Phase 2: Force open "<<" immediately if not already inside.
// - Phase 3: Constrained generation (up to 60 steps) for the expression.
// - Phase 4: CloseSpanWithinBudget backstop.
//
// To avoid timeout: keep free steps VERY small (≤50) with tiny chunks (≤5).
// 50 steps with chunks of 5 = 10 loop iterations = 10 chunk calls. Minimal overhead.
//
// Actually, given 3 examples ALL timed out with freeCapSteps=200, chunkSize=10:
// Let's use freeCapSteps=30, chunkSize=5. That's 6 loop iterations max.
// Then immediately force open "<<" and generate the answer.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1 (outside span): The implication !insideConstrainedOut ==> currentConstrainedOut == []
//   holds trivially when insideConstrainedOut=false. When stoppedOnOpenSpan=true,
//   EnterObservedConstrainedSpan sets currentConstrainedOut := [] which satisfies
//   parser.IsValidPrefix([]) by precondition. OpenConstrainedSpan similarly sets
//   currentConstrainedOut := [] which is a valid prefix.
//   Phase 2 (inside span): CloseSpanIfComplete either closes the span (insideOut=false,
//   currentOut=[], making the implication vacuous) or is a no-op (leaving valid state).
//   ConstrainedStep returns EOS or a parser-valid next token; AppendConstrainedToken
//   preserves parser.IsValidPrefix by its contract.
//   Phase 3: CloseSpanWithinBudget guarantees either closed (insideOut=false, currentOut=[])
//   or open with parser.IsValidPrefix(currentOut). Both satisfy the invariant.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: UnconstrainedChunk appends at most chunkUsed tokens to generated and steps
//   increases by exactly chunkUsed. OpenConstrainedSpan appends 1 token ("<<") and steps += 1.
//   So |generated| <= |generatedPrefix| + steps is preserved throughout Phase 1.
//   Phase 2: Each iteration: CloseSpanIfComplete costs 1 step and appends at most 1 token (">>").
//   If not closed: ConstrainedStep costs 1 step, AppendConstrainedToken appends at most 1 token.
//   Per iteration steps grows by at most 2 and |generated| grows by at most 1, preserving bound.
//   Phase 3: CloseSpanWithinBudget: |generatedOut| <= |generated| + closeBudget; setting
//   steps := maxSteps gives |generated| <= |generatedPrefix| + maxSteps. cost := steps <= maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve step by step. Write ONLY the final symbolic expression inside << >> (e.g., <<n * price + extra>>).";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Very minimal free generation (30 steps max, chunks of 5)
// Only to let model write a brief reasoning prefix before the answer span
var freeCapSteps: nat := 30;

while steps < maxSteps && steps < freeCapSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var remaining := maxSteps - steps;
  var freeRemaining := freeCapSteps - steps;
  var chunkSize: nat := 5;
  if remaining < chunkSize {
    chunkSize := remaining;
  }
  if freeRemaining < chunkSize {
    chunkSize := freeRemaining;
  }
  if chunkSize == 0 {
    break;
  }

  var generatedOut, stoppedOnOpenSpan, stoppedOnEos, chunkUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkSize, "<<", eosToken);

  generated := generatedOut;
  steps := steps + chunkUsed;

  if stoppedOnOpenSpan {
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  } else if stoppedOnEos {
    break;
  }
}

// Phase 2: Force open a constrained span if we never entered one
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 3: Inside the span, generate constrained tokens, close when complete
// Cap at 60 constrained steps (expression should be short: < 30 tokens)
var constrainedStepCap: nat := 60;
var constrainedStepsTaken: nat := 0;

while insideConstrainedOut && steps < maxSteps && constrainedStepsTaken < constrainedStepCap
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Try to close the span first (costs 1 step, no-op if not complete)
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  constrainedStepsTaken := constrainedStepsTaken + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else if steps < maxSteps {
    // Generate next constrained token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
    steps := steps + 1;
    constrainedStepsTaken := constrainedStepsTaken + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

// Phase 4: If span still open, use CloseSpanWithinBudget to force closure
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

