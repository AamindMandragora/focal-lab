Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters around ONLY the final answer.
//
// Key observations from failure analysis:
// 1. "tiny_span_dominant" in 14+4 examples: the constrained span closes after only
//    1-2 tokens (e.g., "2", "7", "daily"). The model is completing the span too early.
//    Root cause: CloseSpanIfComplete is called before enough expression tokens are
//    generated, and the parser considers a single number or identifier a "complete prefix".
//    Fix: require at least a minimum number of constrained tokens before attempting to close.
// 2. 4 unterminated spans: "<<" is opened but the span never closes. The generation
//    enters dead-end states (e.g., trying to generate "int(initial_amount)" which
//    apparently the parser rejects partway).
//    Fix: Use SafeRepetitionPenaltyStep with strong penalty + CloseSpanWithinBudget backstop.
// 3. 28 syntax-valid but semantically wrong answers: the model generates correct structure
//    but wrong content. Use RegenerateUnitOnGroundingFailure to ground units against prompt.
// 4. Free-text budget: 350 steps for free text left ~110 steps for the span. This is
//    adequate but the constrained cap of 60 was too short in some cases.
//
// Strategy:
// - Phase 1: UnconstrainedChunk until "<<" detected, hard cap 380 steps.
// - Force-open "<<" if needed with remaining budget.
// - Phase 2: Minimum 15 constrained tokens BEFORE attempting CloseSpanIfComplete.
//   Use RegenerateUnitOnGroundingFailure to ground content against prompt context.
// - Phase 3: Continue with CloseSpanIfComplete + SafeRepetitionPenaltyStep, cap 80 steps.
// - Phase 4: CloseSpanWithinBudget with all remaining budget as backstop.
//
// The minimum-token requirement before closing ensures "tiny_span" failures are reduced.
// RegenerateUnitOnGroundingFailure addresses semantic errors by checking each grammar unit
// against the prompt context and resampling on mismatch.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1 (UnconstrainedChunk loop): insideConstrainedOut flips true only when
//   stoppedOnOpenSpan, at which point EnterObservedConstrainedSpan sets
//   currentConstrainedOut := [] (valid by precondition parser.IsValidPrefix([])).
//   Force-open via OpenConstrainedSpan similarly sets currentConstrainedOut := [].
//
//   Phase 2 (RegenerateUnitOnGroundingFailure): returns a parser-valid prefix by
//   postcondition; we assign it to currentConstrainedOut directly. The invariant holds.
//
//   Phase 3 (CloseSpanIfComplete + SafeRepetitionPenaltyStep loop):
//   CloseSpanIfComplete returns either closed state (insideOut=false, currentOut=[],
//   invariant vacuously true) or unchanged valid state. SafeRepetitionPenaltyStep
//   returns EOS or parser-valid token. AppendConstrainedToken preserves validity.
//
//   Phase 4 (CloseSpanWithinBudget): postcondition guarantees either a closed span
//   (insideOut=false, currentOut=[]) or an open valid prefix.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: UnconstrainedChunk appends at most chunkSize visible tokens and increments
//   steps by chunkUsed; generated grows by at most chunkUsed per call. Bound preserved.
//   OpenConstrainedSpan appends 1 token ("<<") and steps += 1. Bound preserved.
//
//   Phase 2: RegenerateUnitOnGroundingFailure generates at most fillBudget tokens total.
//   We set generated := stable + filled where |filled| <= |currentConstrainedOut| + fillBudget.
//   Since stable = generated[..|generated| - |currentConstrainedOut|], we have
//   |stable| + |filled| <= |stable| + |currentConstrainedOut| + fillBudget = |generated| + fillBudget.
//   steps += fillBudget. So |new generated| <= |generatedPrefix| + steps. Bound preserved.
//
//   Phase 3: each iteration increments steps by 1 (CloseSpanIfComplete) + at most 1
//   (SafeRepetitionPenaltyStep) = at most 2. AppendConstrainedToken appends 1 token
//   and costs 0. So |generated| grows by at most 1 per iteration while steps grows by
//   at least 1. Bound preserved.
//
//   Phase 4: CloseSpanWithinBudget postcondition: |generatedOut| <= |generated| + closeBudget.
//   steps := maxSteps. So |generated| <= |generatedPrefix| + maxSteps. cost := steps <= maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve this math problem step by step. At the very end, write ONLY the final symbolic expression inside << >>. The expression must use variable names from the problem, numbers, and operators +, -, *, /, //, %, (, ) only. No LaTeX, no words, no single-token answer. Write a complete multi-term expression like <<n * price - discount>> or <<(total - used) * rate>>. Do NOT write just one number or one variable.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate freely until "<<" is observed, hard cap at 380 steps
var freeCapSteps: nat := 380;

while steps < maxSteps && steps < freeCapSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var remaining := maxSteps - steps;
  var chunkSize: nat := 15;
  if remaining < chunkSize {
    chunkSize := remaining;
  }
  if chunkSize == 0 {
    break;
  }

  var generatedOut, stoppedOnOpenSpan, stoppedOnEos, chunkUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkSize, "<<", eosToken);

  generated := generatedOut;
  steps := steps + chunkUsed;

  if stoppedOnOpenSpan {
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  } else if stoppedOnEos {
    break;
  }
}

// Force open a constrained span if we never entered one and have budget
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 2: Generate constrained content grounded against prompt using
// RegenerateUnitOnGroundingFailure, but only if we have enough budget.
// This addresses semantic errors by checking each completed grammar unit
// against the prompt context.
if insideConstrainedOut && steps < maxSteps {
  var rem: nat := maxSteps - steps;
  // Reserve 100 steps for Phase 3+4 closure
  var fillBudget: nat := if rem > 100 then rem - 100 else 0;
  if fillBudget >= 5 {
    assert |currentConstrainedOut| <= |generated|;
    var stable := generated[..|generated| - |currentConstrainedOut|];
    var filled := helpers.RegenerateUnitOnGroundingFailure(
      lm, parser, prompt + stable, currentConstrainedOut, eosToken,
      20, 3, 10);
    generated := stable + filled;
    currentConstrainedOut := filled;
    steps := steps + fillBudget;
  }
}

// Phase 3: Continue with close-span attempts + repetition penalty,
// but enforce minimum 15 constrained tokens before closing (anti-tiny-span).
// After minimum met, try CloseSpanIfComplete each step.
var constrainedStepCap: nat := 80;
var constrainedStepsTaken: nat := 0;
var minConstrained: nat := 15;

while insideConstrainedOut && steps < maxSteps && constrainedStepsTaken < constrainedStepCap
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Only attempt to close if we've accumulated enough constrained content
  var shouldTryClose: bool := |currentConstrainedOut| >= minConstrained;

  if shouldTryClose {
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    constrainedStepsTaken := constrainedStepsTaken + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else if steps < maxSteps {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 4.0, eosToken
      );
      steps := steps + 1;
      constrainedStepsTaken := constrainedStepsTaken + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  } else {
    // Below minimum: just generate without closing
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, generated, 4.0, eosToken
    );
    steps := steps + 1;
    constrainedStepsTaken := constrainedStepsTaken + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

// Phase 4: If span still open, use CloseSpanWithinBudget to force closure
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

