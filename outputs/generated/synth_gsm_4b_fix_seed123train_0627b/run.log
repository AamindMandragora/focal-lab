// parser_validity:
//   Phase 1: insideConstrainedOut flips true only on next == "<<" via
//   EnterObservedConstrainedSpan which sets currentConstrainedOut := [] (valid),
//   or via OpenConstrainedSpan which also sets currentConstrainedOut := [].
//   Phase 2: We only call AppendConstrainedToken when !parser.IsCompletePrefix
//   (guarded) and IsTokenValidNext holds (from ConstrainedStep postcondition).
//   AppendConstrainedToken preserves parser.IsValidPrefix by contract.
//   Phase 3: CloseSpanWithinBudget postcondition guarantees either closed span
//   or valid open prefix.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: Each iteration calls UnconstrainedStep (+1 step, +1 token if not EOS).
//   OpenConstrainedSpan adds 1 token and steps += 1.
//   Phase 2: Each iteration calls ConstrainedStep (+1 step) and AppendConstrainedToken
//   (+0 cost, +1 token or 0 on EOS/break). So |generated| grows by at most 1 per step.
//   Phase 3: CloseSpanWithinBudget uses closeBudget steps; steps := maxSteps after.
//   |generatedOut| <= |generated| + closeBudget <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Think step by step. At the very end, write the final symbolic answer inside << >>. Example: <<(n * price) + extra>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate free tokens one at a time, watch for standalone "<<" token
var freeCapSteps: nat := 300;

while steps < maxSteps && steps < freeCapSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  } else {
    generated := generated + [next];
    if next == "<<" {
      generated, insideConstrainedOut, currentConstrainedOut :=
        helpers.EnterObservedConstrainedSpan(lm, generated);
    }
  }
}

// Force open a constrained span if we never entered one and have budget
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 2: Generate constrained tokens with a minimum run before closing
var minConstrainedSteps: nat := 10;
var maxConstrainedSteps: nat := 50;
var constrainedStepsTaken: nat := 0;

while insideConstrainedOut && steps < maxSteps && constrainedStepsTaken < maxConstrainedSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Only try to close after minimum steps AND when parser says complete
  if constrainedStepsTaken >= minConstrainedSteps && parser.IsCompletePrefix(currentConstrainedOut) {
    // We have a complete expression after minimum steps - stop generating
    // and let Phase 3 handle closure
    break;
  }

  // Generate next constrained token
  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
  steps := steps + 1;
  constrainedStepsTaken := constrainedStepsTaken + 1;
  if next == eosToken {
    break;
  } else {
    // Guard: only call AppendConstrainedToken if parser is not yet complete
    // (AppendConstrainedToken requires !parser.IsCompletePrefix(currentConstrained))
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if !isComplete {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    } else {
      // Parser is complete, break and let Phase 3 close
      break;
    }
  }
}

// Phase 3: Use CloseSpanWithinBudget to find a complete state and emit ">>"
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

