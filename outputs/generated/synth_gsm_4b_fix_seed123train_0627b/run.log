Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters around ONLY the final answer.
// Key insight from failure analysis:
// 1. Syntax failures (63.3%) are the primary blocker - {var} template tokens inside
//    spans fail parser validation, and spans are left unclosed.
// 2. The model should generate its reasoning freely (unconstrained), then emit
//    EXACTLY ONE << >> span at the end containing the final symbolic answer.
// 3. Strategy: generate freely until "<<" appears (model is guided to emit it),
//    then use CloseSpanWithinBudget to reliably complete and close the span.
//    This ensures the span always closes within budget.
// 4. To avoid malformed content ({var} syntax), we rely on hard parser control
//    inside the span - the parser rejects template tokens like {name}, {cur}, etc.
// 5. UnconstrainedChunk is used to advance toward "<<" efficiently, stopping
//    naturally when the model emits the opening delimiter.
// 6. We reserve significant budget for closing the span reliably.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1 (UnconstrainedChunk loop): insideConstrainedOut flips to true only when
//   stoppedOnOpenSpan is true, at which point EnterObservedConstrainedSpan sets
//   currentConstrainedOut := [] which satisfies parser.IsValidPrefix([]) by precondition.
//   Phase 2 (CloseSpanWithinBudget): by postcondition, when it returns
//   insideConstrainedOut is false (currentConstrainedOut == []) or
//   insideConstrainedOut is true with parser.IsValidPrefix(currentConstrainedOut).
//   Either way the invariant holds.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: each UnconstrainedChunk call adds at most chunkSize tokens and
//   increments steps by chunkUsed (which equals the number of tokens added or
//   one for EOS). So after phase 1, |generated| <= |generatedPrefix| + steps.
//   Phase 2: CloseSpanWithinBudget postcondition guarantees
//   |generatedOut| <= |generated| + closeBudget, and we set steps := maxSteps,
//   so |generated| <= |generatedPrefix| + maxSteps = |generatedPrefix| + steps.
//   cost := steps <= maxSteps by construction.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve this math word problem step by step. Show your reasoning, then write the final symbolic answer inside << >> delimiters. The answer inside << >> must be a valid arithmetic expression using only numbers, variable names, +, -, *, /, //, %, (, ) and no curly braces or LaTeX. Example: <<n * price + extra>>. End with exactly one << >> span containing only the final answer expression.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate freely until "<<" is observed or budget is nearly exhausted
// Reserve budget for constrained span closure
var reserveBudget: nat := 80;

while steps < maxSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var remaining := maxSteps - steps;
  if remaining <= reserveBudget {
    // We are too close to budget limit to keep generating free text;
    // force open a constrained span now to get at least some answer
    break;
  }

  // Use a chunk size that allows natural "<<" detection
  var chunkSize: nat := 20;
  if remaining < chunkSize + reserveBudget {
    chunkSize := 1;
  }

  var generatedOut, stoppedOnOpenSpan, stoppedOnEos, chunkUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkSize, "<<", eosToken);

  generated := generatedOut;
  steps := steps + chunkUsed;

  if stoppedOnOpenSpan {
    // "<<" was already appended to generated by UnconstrainedChunk
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  } else if stoppedOnEos {
    break;
  }
}

// If we never entered a constrained span but have budget remaining, force one open
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 2: Use CloseSpanWithinBudget to reliably advance span to completable state and close it
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

