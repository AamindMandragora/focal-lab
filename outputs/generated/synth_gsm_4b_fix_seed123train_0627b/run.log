Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters around ONLY the final answer.
// Key diagnoses from failure analysis:
// 1. Too slow / too many tokens: unconstrained generation runs too long before
//    emitting "<<". We must limit free-text budget and force "<<" earlier.
// 2. Span content loops (c3 - c3 + c3...): the model gets stuck in repetition
//    inside the constrained span. We must use repetition penalty aggressively.
// 3. Span never closes: we need CloseSpanWithinBudget as a hard backstop.
// 4. No span emitted: some examples never reach "<<". We force-open one if needed.
//
// Strategy:
// - Give concise guidance asking for a SINGLE final << >> span with the expression.
// - Phase 1: Use UnconstrainedChunk with small chunks (max 15 tokens) to advance
//   toward "<<", stopping naturally when detected. Hard cap at 400 steps to leave
//   budget for the span.
// - If no "<<" found by step 400, force-open one.
// - Phase 2: Inside the span, use SafeRepetitionPenaltyStep (strong penalty=4.0)
//   to avoid repetition loops. Check CloseSpanIfComplete each step. Hard cap on
//   constrained tokens at 60 to avoid runaway spans.
// - Phase 3: If span still open after 60 constrained tokens, use CloseSpanWithinBudget
//   with remaining budget to force closure.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1 (UnconstrainedChunk loop): insideConstrainedOut flips to true only when
//   stoppedOnOpenSpan is true, at which point EnterObservedConstrainedSpan sets
//   currentConstrainedOut := [] which satisfies parser.IsValidPrefix([]) by precondition.
//   If we force-open via OpenConstrainedSpan, it sets currentConstrainedOut := [] and
//   insideConstrainedOut := true. Both preserve the invariant.
//   Phase 2 (CloseSpanIfComplete / SafeRepetitionPenaltyStep loop):
//   CloseSpanIfComplete returns valid state (either closed with [] or unchanged valid prefix).
//   SafeRepetitionPenaltyStep returns EOS or a parser-valid next token; AppendConstrainedToken
//   preserves parser.IsValidPrefix by contract.
//   Phase 3 (CloseSpanWithinBudget): postcondition guarantees either a closed span
//   (insideOut false, currentOut []) or a still-open valid prefix.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: each UnconstrainedChunk call adds at most chunkSize visible tokens and
//   increments steps by chunkUsed; |generated| grows by at most chunkUsed per call.
//   So |generated| <= |generatedPrefix| + steps throughout.
//   Phase 2: each iteration increments steps by 1 and appends at most 1 token (or
//   ">>" for close), preserving the bound.
//   Phase 3: CloseSpanWithinBudget postcondition guarantees |generatedOut| <= |generated| + closeBudget,
//   and we set steps := maxSteps, so |generated| <= |generatedPrefix| + maxSteps.
//   cost := steps <= maxSteps by construction.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve this math problem step by step, then write ONLY the final answer expression inside << >> at the very end. The expression inside << >> must use only variable names, numbers, +, -, *, /, //, %, (, ) - no LaTeX, no curly braces, no text. Example: <<n * price + extra>>. Keep the expression concise and correct.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate freely until "<<" is observed, hard cap at 400 steps
var freeCapSteps: nat := 400;

while steps < maxSteps && steps < freeCapSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var remaining := maxSteps - steps;
  // Keep chunk small to detect "<<" quickly and not overshoot
  var chunkSize: nat := 15;
  if remaining < chunkSize {
    chunkSize := remaining;
  }
  if chunkSize == 0 {
    break;
  }

  var generatedOut, stoppedOnOpenSpan, stoppedOnEos, chunkUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkSize, "<<", eosToken);

  generated := generatedOut;
  steps := steps + chunkUsed;

  if stoppedOnOpenSpan {
    // "<<" was already appended to generated by UnconstrainedChunk
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  } else if stoppedOnEos {
    break;
  }
}

// Force open a constrained span if we never entered one and have budget
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 2: Inside the span, generate with repetition penalty and close when complete
// Hard cap on constrained tokens to avoid runaway loops (at most 60 inner steps)
var constrainedStepCap: nat := 60;
var constrainedStepsTaken: nat := 0;

while insideConstrainedOut && steps < maxSteps && constrainedStepsTaken < constrainedStepCap
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Try to close the span first
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  constrainedStepsTaken := constrainedStepsTaken + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else {
    // Generate next constrained token with repetition penalty to avoid loops
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, generated, 4.0, eosToken
    );
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

// Phase 3: If span still open, use CloseSpanWithinBudget to force closure
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

