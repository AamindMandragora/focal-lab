Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD: visible << >> delimiters around the final answer expression.
//
// Failure analysis from attempt 3:
// 1. "tiny_span_dominant" (32/49 examples): The model emits a truncated or trivially
//    short expression like <<n0>> or <<(n1*p1)>> instead of the full expression.
//    Root cause: The constrained span opens but the parser accepts the first complete
//    subexpression and CloseSpanIfComplete fires immediately. We need to let the model
//    generate more expression content before checking for closure. Better: use
//    RollbackAndContinue or a longer constrained generation loop without premature close.
//    Also: the model tends to cut off mid-expression (unterminated_constrained_segment).
//
// 2. Unterminated spans (3/49): Model emits "<<" near EOS and runs out of budget.
//    The CloseSpanWithinBudget backstop should handle this but might not be getting
//    enough budget. Need to ensure we always have at least 30 steps reserved.
//
// 3. Malformed content (1/49): Model emits "{" or "}" inside the span. The parser
//    should block this but somehow int >> passed. Need stricter guidance.
//
// Key changes:
// - Guidance: explicitly tell the model the expression uses variable names EXACTLY
//   as they appear in the problem (no $, no {}, no LaTeX), and give a multi-variable example.
// - Phase 1: Generate freely until "<<" with chunks of 20 tokens, hard cap at 350 steps.
//   This leaves 550 steps for the constrained span.
// - Phase 2: Inside the span, do NOT use CloseSpanIfComplete speculatively every step.
//   Instead, use RolloutConstrainedWithPenalties with a generous budget (up to 80 steps)
//   to let the full expression develop, penalizing repetition. Then close.
// - Use CloseSpanWithinBudget with at least 50 steps reserved as a hard backstop.
// - For the 3 unterminated cases: ensure closeBudget >= 50.
//
// The key insight: CloseSpanIfComplete was firing too early (after the first valid subexpression),
// producing tiny spans. Using RolloutConstrainedWithPenalties lets the expression grow to
// a natural complete state, and the parser's completeness check at the end of rollout
// ensures correctness.
//
// We use AdaptiveConstrainedStepWithPenalties inside the span loop to balance
// exploration vs. repetition avoidance.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1 (UnconstrainedChunk loop): insideConstrainedOut flips to true only when
//   stoppedOnOpenSpan is true; EnterObservedConstrainedSpan sets currentConstrainedOut := []
//   which satisfies parser.IsValidPrefix([]) by precondition. Force-open via OpenConstrainedSpan
//   also sets currentConstrainedOut := []. Both paths preserve the invariant.
//
//   Phase 2 (RolloutConstrainedWithPenalties):
//   RolloutConstrainedWithPenalties returns rolloutGen which is valid; we set currentConstrainedOut
//   to the returned valid prefix. The helper's postcondition guarantees parser.IsValidPrefix.
//   After the rollout, CloseSpanWithinBudget's postcondition guarantees either a closed span
//   (insideConstrainedOut false, currentConstrainedOut []) or a still-open valid prefix.
//
//   Phase 3 (CloseSpanWithinBudget backstop): postcondition guarantees
//   !insideOut ==> currentOut == [] and insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: each UnconstrainedChunk call adds at most chunkUsed visible tokens and
//   increments steps by chunkUsed; by contract |generatedOut| <= |generated| + chunkUsed.
//   OpenConstrainedSpan adds 1 token and costs 1 step, preserving the bound.
//
//   Phase 2: RolloutConstrainedWithPenalties costs stepsUsed steps and appends at most
//   stepsUsed tokens (to rolloutGen). We reconstruct generated = stable + rolloutGen where
//   |rolloutGen| <= |currentConstrainedOut| + stepsUsed. Since |stable| + |currentConstrainedOut|
//   <= |generated|_before, we get |generated|_after <= |generated|_before + stepsUsed <= |generatedPrefix| + steps.
//   CloseSpanWithinBudget with closeBudget = maxSteps - steps satisfies
//   |generatedOut| <= |generated| + closeBudget, and we set steps := maxSteps, so
//   |generated| <= |generatedPrefix| + maxSteps. cost := steps <= maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve this math problem step by step. At the very end, write EXACTLY ONE final answer expression inside << >>. Inside << >> use ONLY: variable names (no $, no {}, no LaTeX), numbers, +, -, *, /, //, %, (, ). Example: <<n1 * p1 + n2 * p2 + n3 * p3>>. Do NOT put reasoning text inside << >>. Keep the full expression with all terms.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate freely until "<<" is observed, hard cap to leave budget for span
var freeCapSteps: nat := 350;

while steps < maxSteps && steps < freeCapSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var remaining := maxSteps - steps;
  var chunkSize: nat := 20;
  if remaining < chunkSize {
    chunkSize := remaining;
  }
  if chunkSize == 0 {
    break;
  }

  var generatedOut, stoppedOnOpenSpan, stoppedOnEos, chunkUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkSize, "<<", eosToken);

  generated := generatedOut;
  steps := steps + chunkUsed;

  if stoppedOnOpenSpan {
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  } else if stoppedOnEos {
    break;
  }
}

// Force open a constrained span if we never entered one and have budget
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 2: Inside the span, use RolloutConstrainedWithPenalties to generate
// a full expression without premature closure (avoid tiny spans).
// Reserve at least 50 steps for CloseSpanWithinBudget backstop.
var closeReserve: nat := 50;

if insideConstrainedOut && steps < maxSteps {
  var available := maxSteps - steps;
  var rolloutBudget: nat := 0;
  if available > closeReserve {
    rolloutBudget := available - closeReserve;
  }
  // Cap rollout at 80 tokens to avoid runaway generation
  if rolloutBudget > 80 {
    rolloutBudget := 80;
  }

  if rolloutBudget >= 1 {
    var stable := generated[..|generated| - |currentConstrainedOut|];
    var constrainedPrompt := prompt + stable;
    var penalties: seq<Token> := [];
    var rolloutGen, rolloutSteps, rolloutEos :=
      helpers.RolloutConstrainedWithPenalties(
        lm, parser, constrainedPrompt, currentConstrainedOut,
        rolloutBudget, penalties, 0.0, eosToken
      );
    // rolloutGen is the new currentConstrainedOut
    generated := stable + rolloutGen;
    currentConstrainedOut := rolloutGen;
    steps := steps + rolloutSteps;

    if rolloutEos {
      // EOS hit inside span - try to close what we have
      // CloseSpanWithinBudget will handle it below
      insideConstrainedOut := true; // stay open for backstop
    }
  }
}

// Phase 3: Backstop - use CloseSpanWithinBudget to force closure
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
} else if insideConstrainedOut && steps >= maxSteps {
  // No budget left - try immediate close if complete
  if parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    }
  }
}

cost := steps;

