Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters around symbolic expressions
// and the final answer. The strategy generates freely until "<<" is observed,
// then uses adaptive constrained decoding inside the span with group boosting
// for narrow parser states and repetition-penalty steps for wider states.
// After each constrained step, CloseSpanIfComplete attempts to close the span
// once the parser accepts a complete expression. This supports math problems
// where intermediate expressions need to be valid symbolic forms.
// State tracked:
//   - insideConstrainedOut / currentConstrainedOut: whether we are inside a << >> span
//   - steps: token budget consumed so far
//   - generated: full visible output including delimiters
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. In the unconstrained branch, insideConstrainedOut flips to true only when
//      next == "<<", at which point currentConstrainedOut := [] which satisfies
//      parser.IsValidPrefix([]) by precondition.
//   2. In the CloseSpanIfComplete branch, when closed==true the span exits
//      (insideConstrainedOut false, currentConstrainedOut []) making the implication
//      vacuous; when closed==false the state is unchanged and remains valid.
//   3. In the AdaptiveConstrainedStep branch, the helper returns EOS or a
//      parser-valid next token; AppendConstrainedToken then appends that token,
//      which preserves parser.IsValidPrefix(currentConstrainedOut) by the helper
//      contract.
//   4. In the SafeRepetitionPenaltyStep branch, similarly returns EOS or a
//      parser-valid token and AppendConstrainedToken preserves validity.
//
// progress:
//   Every branch of the loop increments steps by exactly 1 and appends at most
//   one visible token to generated, so |generated| <= |generatedPrefix| + steps
//   is maintained throughout. EOS breaks out of the loop. The CloseSpanIfComplete
//   branch may append ">>" (one token) and costs 1 step, consistent with the bound.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve math word problems step by step. Wrap each intermediate symbolic expression and the final answer inside << >> delimiters. Show your work clearly.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var narrowThreshold: nat := 15;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    // Try to close the span if the parser considers the current prefix complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Generate the next constrained token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var next := eosToken;
      if validCount <= narrowThreshold {
        // Narrow parser state: use group boosting for better guidance
        next := helpers.AdaptiveConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, narrowThreshold, eosToken
        );
      } else {
        // Wider parser state: use repetition penalty to avoid loops
        next := helpers.SafeRepetitionPenaltyStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
        );
      }
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

