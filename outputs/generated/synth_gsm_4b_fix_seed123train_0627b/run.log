Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD: visible << >> delimiters around ONLY the final answer.
//
// Key lessons from failure analysis:
// 1. Repetition loops inside constrained span: SafeRepetitionPenaltyStep alone is
//    not enough. We need to aggressively penalize tokens that are already in
//    currentConstrainedOut to break repetition cycles.
// 2. Too slow / timed out: The free-text phase is spending too many tokens on
//    reasoning. We cap it more aggressively at 300 steps and use smaller chunks.
// 3. Span never closes: Some spans get stuck. We use CloseSpanWithinBudget as
//    a backstop. We also reduce the constrained step cap to 40 to leave more
//    budget for CloseSpanWithinBudget.
// 4. Unconstrained generation loop for some timed-out examples: The model is
//    generating very long unconstrained text before emitting "<<". We force-open
//    earlier (at 300 steps instead of 400).
// 5. No span emitted: force-open one at 300 steps if not already open.
//
// Strategy:
// - Guidance: concise, ask for SINGLE final << >> span with just the expression.
// - Phase 1: UnconstrainedChunk loop with chunks of 10 tokens, cap at 300 steps.
// - Force-open span if not open after 300 steps.
// - Phase 2: Inside span, use AdaptiveConstrainedStepWithPenalties to penalize
//   tokens already in currentConstrainedOut (strong repetition avoidance).
//   Use CloseSpanIfComplete each step. Hard cap at 40 inner steps.
// - Phase 3: CloseSpanWithinBudget on remaining budget.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1 (UnconstrainedChunk loop): insideConstrainedOut flips to true only when
//   stoppedOnOpenSpan is true, at which point EnterObservedConstrainedSpan sets
//   currentConstrainedOut := [] which satisfies parser.IsValidPrefix([]).
//   Force-open via OpenConstrainedSpan sets currentConstrainedOut := [] too.
//   Phase 2 (CloseSpanIfComplete / AdaptiveConstrainedStepWithPenalties loop):
//   CloseSpanIfComplete returns valid state. AdaptiveConstrainedStepWithPenalties
//   returns EOS or a parser-valid next token; AppendConstrainedToken preserves
//   parser.IsValidPrefix by contract.
//   Phase 3 (CloseSpanWithinBudget): postcondition guarantees either closed span
//   (insideOut false, currentOut []) or valid open prefix.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: each UnconstrainedChunk call increments steps by chunkUsed and
//   generated grows by at most chunkUsed. Bound preserved.
//   Phase 2: each iteration increments steps by 1 (for CloseSpanIfComplete or
//   for AdaptiveConstrainedStepWithPenalties) and appends at most 1 token.
//   Phase 3: CloseSpanWithinBudget guarantees |generatedOut| <= |generated| + closeBudget;
//   we set steps := maxSteps so |generated| <= |generatedPrefix| + maxSteps.
//   cost := steps <= maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve this math problem step by step, then write ONLY the final answer expression inside << >> at the very end. The expression inside << >> must use only variable names, numbers, +, -, *, /, //, %, (, ) - no LaTeX, no curly braces. Example: <<n * price + extra>>. Keep it concise.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate freely until "<<" is observed, hard cap at 300 steps
var freeCapSteps: nat := 300;

while steps < maxSteps && steps < freeCapSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var remaining := maxSteps - steps;
  var chunkSize: nat := 10;
  if remaining < chunkSize {
    chunkSize := remaining;
  }
  if chunkSize == 0 {
    break;
  }

  var generatedOut, stoppedOnOpenSpan, stoppedOnEos, chunkUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkSize, "<<", eosToken);

  generated := generatedOut;
  steps := steps + chunkUsed;

  if stoppedOnOpenSpan {
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  } else if stoppedOnEos {
    break;
  }
}

// Force open a constrained span if we never entered one and have budget
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 2: Inside the span, generate with adaptive penalties and close when complete
// Hard cap on constrained tokens to avoid runaway loops (at most 40 inner steps)
var constrainedStepCap: nat := 40;
var constrainedStepsTaken: nat := 0;

while insideConstrainedOut && steps < maxSteps && constrainedStepsTaken < constrainedStepCap
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Try to close the span first
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  constrainedStepsTaken := constrainedStepsTaken + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else {
    // Generate next constrained token with penalties on tokens already in the span
    // to avoid repetition loops
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var penaltyTokens := currentConstrainedOut;
    var next := helpers.AdaptiveConstrainedStepWithPenalties(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      validTokenGroups, 2.0, penaltyTokens, 5.0, 12, eosToken
    );
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

// Phase 3: If span still open, use CloseSpanWithinBudget to force closure
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

