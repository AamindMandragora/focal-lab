Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters around ONLY the final answer.
//
// Key insights from failure analysis:
// 1. Most failures (27/31) are mode_J: syntax-valid but semantically wrong. The
//    constrained span content is too short (tiny_span_dominant: 78%), meaning the
//    model often emits just a single token like "total", "x", "3" instead of the
//    full expression like "total - (n1 + n2)".
// 2. 3 failures are unterminated spans (mode_L): the span opens right when the
//    model is mid-expression, so it cuts off.
// 3. The fix: force the model to complete its reasoning BEFORE opening "<<".
//    Use UnconstrainedChunk until "<<" is observed naturally (or force-open late).
//    Inside the span, use RegenerateUnitOnGroundingFailure to ensure the expression
//    uses tokens grounded in the prompt context (variable names etc.), then
//    CloseSpanWithinBudget for reliable closure.
// 4. The span content being tiny suggests the constrained grammar completes too
//    quickly on a single token. We should use SafeTemperatureConstrainedStep with
//    lower temperature to make the model more committed to longer expressions, and
//    we should NOT call CloseSpanIfComplete eagerly each step - instead let it build.
// 5. To address the "tiny span" problem more directly: use RegenerateUnitOnGroundingFailure
//    which forces the expression to use prompt-grounded tokens (actual variable names),
//    making it more likely to produce a full expression rather than a bare literal.
// 6. Delay CloseSpanIfComplete until at least a few tokens have been generated in the span.
//
// Strategy:
// - Guidance: ask for complete symbolic expression using variable names from the problem.
// - Phase 1: UnconstrainedChunk loop, detect "<<", cap at 500 steps.
// - Force open span if not opened by step 500.
// - Phase 2a: Use RegenerateUnitOnGroundingFailure on half the remaining budget to
//   fill the span with prompt-grounded content.
// - Phase 2b: Then CloseSpanWithinBudget on remaining budget.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1 (UnconstrainedChunk loop): insideConstrainedOut flips to true only when
//   stoppedOnOpenSpan is true, at which point EnterObservedConstrainedSpan sets
//   currentConstrainedOut := [] which satisfies parser.IsValidPrefix([]).
//   If we force-open via OpenConstrainedSpan, it also sets currentConstrainedOut := [].
//   Phase 2a (RegenerateUnitOnGroundingFailure): by its postcondition, always returns
//   a parser-valid prefix.
//   Phase 2b (CloseSpanWithinBudget): postcondition guarantees either closed span
//   (insideOut false, currentOut []) or still-open valid prefix.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: each UnconstrainedChunk increments steps by chunkUsed and generated
//   grows by at most chunkUsed. Bound preserved.
//   Phase 2a: RegenerateUnitOnGroundingFailure uses fillBudget steps; generated
//   becomes stable + filled where |filled| <= |currentConstrainedOut| + fillBudget.
//   Since stable = generated[..|generated| - |currentConstrainedOut|], we have
//   |stable + filled| <= |generated| + fillBudget <= |generatedPrefix| + steps + fillBudget.
//   We set steps := steps + fillBudget so bound is preserved.
//   Phase 2b: CloseSpanWithinBudget guarantees |generatedOut| <= |generated| + closeBudget;
//   we set steps := maxSteps, so |generated| <= |generatedPrefix| + maxSteps. cost <= maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve this math problem step by step. At the end, write the final answer as a complete symbolic expression using the variable names from the problem, inside << >>. The expression should be complete - use all relevant variables. Example: <<n1 + (n1 * p / 100) + n2>>. Do NOT use a single word or number alone.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate freely until "<<" is observed, hard cap at 500 steps
var freeCapSteps: nat := 500;

while steps < maxSteps && steps < freeCapSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var remaining := maxSteps - steps;
  var chunkSize: nat := 20;
  if remaining < chunkSize {
    chunkSize := remaining;
  }
  if chunkSize == 0 {
    break;
  }

  var generatedOut, stoppedOnOpenSpan, stoppedOnEos, chunkUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkSize, "<<", eosToken);

  generated := generatedOut;
  steps := steps + chunkUsed;

  if stoppedOnOpenSpan {
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  } else if stoppedOnEos {
    break;
  }
}

// Force open a constrained span if we never entered one and have budget
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 2a: Use RegenerateUnitOnGroundingFailure to fill span with grounded content
// Use half the remaining budget for this, reserve rest for closing
if insideConstrainedOut && steps < maxSteps {
  var rem: nat := maxSteps - steps;
  // Reserve at least 30 steps for CloseSpanWithinBudget
  var reserveForClose: nat := 30;
  var fillBudget: nat := 0;
  if rem > reserveForClose {
    fillBudget := rem - reserveForClose;
  }
  if fillBudget >= 1 {
    assert |currentConstrainedOut| <= |generated|;
    var stable := generated[..|generated| - |currentConstrainedOut|];
    var filled := helpers.RegenerateUnitOnGroundingFailure(
      lm, parser, prompt + stable, currentConstrainedOut, eosToken,
      fillBudget, 3, fillBudget);
    generated := stable + filled;
    currentConstrainedOut := filled;
    steps := steps + fillBudget;
  }
}

// Phase 2b: Close the span within the remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

