Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters around ONLY the final answer.
//
// Key diagnoses from failure analysis:
// 1. "tiny_span_dominant": 32/49 examples have only tiny valid visible spans (1-2 tokens).
//    This means the model is closing the span too early (after just 1 token like "n1").
//    We must DISABLE CloseSpanIfComplete for a minimum number of constrained steps.
// 2. "unterminated_constrained_segment": 5 examples open "<<" but never close.
//    CloseSpanWithinBudget handles this as backstop.
// 3. "other_observed_failure": 25 wrong answers - the model generates the right structure
//    but picks wrong variables. RegenerateUnitOnGroundingFailure can help.
// 4. Repetition loops: use SafeRepetitionPenaltyStep inside span.
//
// Strategy:
// - Concise guidance asking for full expression in << >>.
// - Phase 1: UnconstrainedChunk with small chunks up to 400 steps.
// - Force "<<" if not opened.
// - Phase 2a: Minimum 15 constrained tokens WITHOUT CloseSpanIfComplete to avoid
//   premature closure. Use SafeRepetitionPenaltyStep.
// - Phase 2b: Continue with CloseSpanIfComplete until span closes or budget runs out.
// - Phase 3: CloseSpanWithinBudget as hard backstop.
//
// The critical fix vs attempt 10 (which had minConstrainedSteps=8, still got tiny spans):
// Increase minConstrainedSteps to 15, and guard AppendConstrainedToken more carefully.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1: insideConstrainedOut flips true only via EnterObservedConstrainedSpan
//   (sets currentConstrainedOut := [], valid by precondition) or OpenConstrainedSpan
//   (same). Both preserve the invariant.
//   Phase 2a: SafeRepetitionPenaltyStep returns EOS or parser-valid next token.
//   We guard with !parser.IsCompletePrefix before AppendConstrainedToken, which
//   preserves parser.IsValidPrefix by contract.
//   Phase 2b: CloseSpanIfComplete returns valid state (either closed with [] or
//   unchanged valid prefix). When closed=false, we guard AppendConstrainedToken
//   with !parser.IsCompletePrefix(currentConstrainedOut).
//   Phase 3: CloseSpanWithinBudget postcondition guarantees valid state.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: each UnconstrainedChunk call increments steps by chunkUsed and adds
//   at most chunkUsed tokens, so |generated| <= |generatedPrefix| + steps always.
//   Phase 2a/2b: each iteration steps += 1, at most 1 token appended.
//   Phase 3: CloseSpanWithinBudget postcondition: |generatedOut| <= |generated| + closeBudget;
//   we set steps := maxSteps, giving |generated| <= |generatedPrefix| + maxSteps.
//   cost := steps <= maxSteps by construction.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve this math problem step by step. At the very end, write ONLY the final symbolic answer expression inside << >> delimiters. The expression must be the COMPLETE formula using ALL relevant variable names and numbers with +, -, *, /, //, %, (, ) only. No LaTeX, no curly braces, no text inside << >>. Write a complete multi-term expression, not just one variable. Example: <<n * price + extra>> or <<n0 * (r + 1) // d>> or <<total - n1 + n2>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate freely until "<<" is observed, hard cap at 400 steps
var freeCapSteps: nat := 400;

while steps < maxSteps && steps < freeCapSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var remaining := maxSteps - steps;
  var chunkSize: nat := 15;
  if remaining < chunkSize {
    chunkSize := remaining;
  }
  if chunkSize == 0 {
    break;
  }

  var generatedOut, stoppedOnOpenSpan, stoppedOnEos, chunkUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkSize, "<<", eosToken);

  generated := generatedOut;
  steps := steps + chunkUsed;

  if stoppedOnOpenSpan {
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  } else if stoppedOnEos {
    break;
  }
}

// Force open a constrained span if we never entered one and have budget
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 2a: Generate minimum constrained tokens WITHOUT attempting to close early.
// This prevents "tiny span" failure (closing after just 1 token like "n1").
var minConstrainedSteps: nat := 15;
var constrainedStepsTaken: nat := 0;

while insideConstrainedOut && steps < maxSteps && constrainedStepsTaken < minConstrainedSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
