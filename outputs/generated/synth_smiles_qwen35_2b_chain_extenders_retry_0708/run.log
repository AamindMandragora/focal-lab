// Key insight: The SMILES grammar accepts "O", "N", "C" etc. as complete prefixes.
// The model converges to the same short diol. We need aggressive diversity forcing.
//
// New strategy:
// 1. Use MaskTokensInPrefix to hard-block previously generated tokens from being
//    the FIRST token of the span, forcing diversity from the start.
// 2. Use SafeRepetitionPenaltyStep with a HIGH penalty (5.0) for the full generation.
// 3. Generate multiple candidates and pick the best one - but since we can't branch,
//    instead use a seed-like approach: vary the generation by injecting different
//    starting tokens based on the example index (approximated by prompt length).
// 4. Force minimum span length of 6 tokens before allowing close.
// 5. Use AppendTaskGuidance with diversity-emphasizing language that lists
//    structurally DIFFERENT chain extenders to provide variety in the LM context.
//
// The fundamental problem: the model generates the SAME molecule every time.
// Solution: Before starting constrained generation, penalize all tokens that
// appear in a "common" short chain extender set to diversify away from defaults.
// Use SafePenalizeTokenLogits on the first token to steer away from "O" as start.
// Also boost ring-containing starts like "C", branched chains, etc.
//
// We also increase minSpanLength to 6 to force at least a 3-carbon backbone.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   OpenConstrainedSpan sets insideConstrainedOut := true, currentConstrainedOut := [],
//   which satisfies parser.IsValidPrefix([]) by precondition.
//   In the generation loop:
//   - SafeRepetitionPenaltyStep returns EOS or a parser-valid next token (hard-mask).
//   - AdaptiveConstrainedStep returns EOS or a parser-valid next token (hard-mask).
//   - AppendConstrainedToken preserves parser.IsValidPrefix by contract.
//   - CloseConstrainedSpan exits constrained mode (insideConstrainedOut := false,
//     currentConstrainedOut := []), making the implication vacuous.
//   - CloseSpanWithinBudget postcondition: insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan appends one token ("<<") and costs 1 step, preserving bound.
//   Each SafeRepetitionPenaltyStep / AdaptiveConstrainedStep consumes 1 step and
//   AppendConstrainedToken appends at most 1 visible token, preserving bound.
//   CloseConstrainedSpan appends ">>" and costs 1 step, preserving bound.
//   CloseSpanWithinBudget uses budget = maxSteps - steps, so total stays <= maxSteps.
//   EOS breaks without appending.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Guidance emphasizes structural variety among chain extender classes
helpers.AppendTaskGuidance(lm, "Generate ONE valid SMILES string for a chain_extender molecule. Chain extenders are bifunctional molecules for step-growth polymerization. Examples of distinct structural classes: diols (OCCO, OCCCCO, OCC(C)CO, OC(C)C(C)O, OCCCCCCO), diamines (NCCN, NCCCN, NCCCCN, NCC(C)N), amino alcohols (NCCO, NCCCO, NCC(C)O), cyclic diols (OC1CCCC1O, OC1CCCCC1O). Generate a structurally unique molecule NOT identical to these examples. Output ONLY the SMILES string, no explanation.");

var steps: nat := 0;
var narrowThreshold: nat := 15;
var minSpanLength: nat := 6;

// Open constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Generation loop
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    // Use high repetition penalty throughout to maximize diversity
    // Alternate strategies to vary the decoding path
    if |currentConstrainedOut| % 3 == 0 {
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 5.0, eosToken);
    } else if |currentConstrainedOut| % 3 == 1 {
      next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken);
    } else {
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
    }
    steps := steps + 1;
    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// If still inside span and budget remains, close within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

