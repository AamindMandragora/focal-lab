Strategy: // CSD_RATIONALE_BEGIN
// Analysis of failure modes:
// 1. "Unique valid molecules: 9/50" - still too low diversity (need ~21/50)
// 2. "tiny_span_dominant: yes" in wrong clusters - some spans are too short
// 3. "SM" and "CCC(O)CC" failures - non-chain-extender or single-OH molecule
// 4. Best attempt (14) got 26% with ScaleAllLogits(0.4) + SafeSoftConstrainedStep
//
// The core issue: the LM is nearly deterministic. With 50 independent runs
// and the same prompt, it generates the same molecule repeatedly.
//
// Key insight from diagnostics: "Samples to 100 unique valid (cap 1000): 1000"
// means even 1000 samples didn't reach 100 unique. The LM has extremely strong
// priors toward a handful of molecules.
//
// What to change:
// 1. Use very aggressive logit flattening: ScaleAllLogits(0.1) - much flatter
//    than 0.4, making sampling nearly uniform over valid tokens.
// 2. Apply RepetitionPenaltyStep (not Safe variant) which may be stronger.
// 3. Use minSpanLength = 3 (keep it low to not force garbage).
// 4. CRITICAL FIX for "SM" / tiny_span failures: these happen when the first
//    constrained token produces a 1-2 char "complete" molecule. We need
//    minSpanLength = 4 to prevent this.
// 5. The guidance text should include VERY unusual molecules not in the exemplar
//    set - things the model wouldn't normally generate.
//
// New approach: Instead of varying per step, use a consistent strategy:
// - ScaleAllLogits(0.1) before EVERY step (maximum flattening)
// - Use AdaptiveConstrainedStep with large boost (15.0) and narrow threshold
// - minSpanLength = 5 to ensure meaningful chain extenders
// - Use SafeRepetitionPenaltyStep with strong penalty (5.0) to discourage
//   the same atoms appearing
//
// The "CCC(O)CC" failure is interesting - it's a secondary alcohol, not a
// chain extender (which needs TWO functional groups). The parser might accept
// it as valid SMILES but it fails membership check.
// This suggests the parser is just a SMILES parser, not a chain_extender parser.
// Membership is checked separately. We need the LM to generate bifunctional
// molecules.
//
// Guidance should emphasize TWO functional groups and provide many diverse examples.
//
// Critical: with ScaleAllLogits(0.1), even a 10.0 boost in AdaptiveConstrainedStep
// will dominate over the flat distribution. The combination creates "soft guided
// random walk" in SMILES grammar space.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   Branch "open span": OpenConstrainedSpan sets currentConstrainedOut := []
//   which is valid by parser.IsValidPrefix([]) precondition.
//   Branch "close": CloseConstrainedSpan requires parser.IsCompletePrefix (which
//   implies IsValidPrefix), and sets insideConstrainedOut := false making the
//   implication vacuous.
//   Branch "constrained step": AdaptiveConstrainedStep and SafeRepetitionPenaltyStep
//   return a token that is EOS or valid-next. AppendConstrainedToken preserves
//   IsValidPrefix by appending a valid-next token.
//   Fallback CloseSpanWithinBudget: postcondition guarantees
//   insideConstrainedOut ==> IsValidPrefix(currentConstrainedOut).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan: steps += 1, |generated| += 1 (the "<<" token).
//   CloseConstrainedSpan: steps += 1, |generated| += 1 (the ">>" token).
//   Constrained step: steps += 1, AppendConstrainedToken adds at most 1 to
//   |generated|, so |generated| <= |generatedPrefix| + steps still holds.
//   ScaleAllLogits and other logit edits: +0 tokens, +0 steps.
//   CloseSpanWithinBudget fallback: steps set to maxSteps and its length
//   postcondition bounds |generated| <= prior |generated| + closeBudget
//   <= |generatedPrefix| + maxSteps. All paths maintain the bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate ONE valid SMILES for a chain_extender. Chain extenders MUST have exactly two functional groups (two OH, two NH2, or one OH + one NH2). Do NOT generate molecules with only one functional group. Examples of valid chain extenders: NCCO, NCCCO, NCCCCN, NCCCCCN, OCC(C)CO, OCCO, OCCCO, OCCCCO, OCCOCCO, OCC(CO)CO, NCCNCC, NC1CCCCC1N, NCCCC(N)CC, OCC(CC)CO, OCCCC(O)CC, NC(CC)CN, OCCC(O)CCC, NC(C)(C)CN. Output ONLY the SMILES string, nothing else.");

var steps: nat := 0;
var minSpanLength: nat := 4;

// Open constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Main constrained generation loop
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength {
    // Close the span - molecule is complete
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];

    // Very aggressive logit flattening for maximum diversity
    helpers.ScaleAllLogits(lm, 0.1);

    var next: Token;
    var spanLen := |currentConstrainedOut|;

    if spanLen == 0 {
      // First token: use soft constrained with very high boost
      var ns, ok := helpers.SafeSoftConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, 12.0, eosToken);
      next := ns;
    } else if spanLen < 3 {
      // Early tokens: adaptive with high boost and tight threshold
      next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 10.0, 20, eosToken);
    } else if spanLen < 8 {
      // Middle tokens: alternate strategies
      if spanLen % 3 == 0 {
        next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 5.0, eosToken);
      } else if spanLen % 3 == 1 {
        next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 8.0, 16, eosToken);
      } else {
        var ns, ok := helpers.SafeSoftConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, 10.0, eosToken);
        next := ns;
      }
    } else {
      // Longer spans: repetition penalty to close toward completion
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 4.0, eosToken);
    }
    steps := steps + 1;

    if next == eosToken {
      // EOS received - close if complete and long enough
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Fallback: close within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

