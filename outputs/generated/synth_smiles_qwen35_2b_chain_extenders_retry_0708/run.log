Strategy: // CSD_RATIONALE_BEGIN
// Chain-extender SMILES diversity CSD - Attempt 7.
//
// Root cause analysis:
// - All prior attempts: 1 unique valid molecule out of 50 (2% accuracy)
// - The model always generates the same SMILES string despite repetition penalties
// - The core problem: the LM has a very strong prior toward one molecule (e.g., "OCCO")
//   and repetition penalty only penalizes tokens already in the generated prefix,
//   which doesn't help when the model hasn't generated anything yet.
//
// New strategy: Use ConstrainedGeneration (which loops ConstrainedStep until
// parser completeness or EOS) rather than manual token-by-token generation.
// The key difference: ConstrainedGeneration uses a fresh prompt context each time
// and may produce different results based on how the LM samples.
//
// More importantly: use AppendTaskGuidance with a DIFFERENT molecule example
// each time by varying the guidance based on the prompt length (as a proxy for
// "which example we're on"). This gives different soft biases per example.
//
// Since we can't vary guidance deterministically based on example index,
// instead we use a two-phase approach:
// Phase 1: Use TopValidCandidates to see what the LM wants to generate first.
// Phase 2: Pick a token that is NOT the top candidate (boost the 2nd or 3rd choice)
//          to force structural diversity from the very first token.
//
// Actually the cleanest approach: use SafePenalizedConstrainedStep to heavily
// penalize "O" as the first token (since most chain extenders the model picks start
// with O), forcing it to start with C or N instead for variety. Then use
// AdaptiveConstrainedStep for the rest.
//
// Better yet: Use TopValidCandidates to identify the greedy first token, then
// use SafePenalizedConstrainedStep to penalize that specific token, forcing a
// different starting point. This should reliably break the degeneracy.
//
// The key insight: if we can make the FIRST token diverse, the rest follows
// naturally from the parser-constrained generation.
//
// Approach:
// 1. Open constrained span
// 2. Get top candidates for first token
// 3. Penalize the top candidate heavily to force a different start
// 4. Continue with SafeRepetitionPenaltyStep for diversity throughout
// 5. Enforce minimum length of 4 tokens before allowing close
// 6. Close when complete
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   OpenConstrainedSpan sets insideConstrainedOut := true and currentConstrainedOut := [],
//   which satisfies parser.IsValidPrefix([]) by precondition.
//   TopValidCandidates costs 1 step and does not change generated state.
//   SafePenalizedConstrainedStep returns EOS or a parser-valid next token (hard-mask).
//   SafeRepetitionPenaltyStep returns EOS or a parser-valid next token (hard-mask).
//   AdaptiveConstrainedStep returns EOS or a parser-valid next token (hard-mask).
//   AppendConstrainedToken preserves parser.IsValidPrefix by contract.
//   CloseConstrainedSpan sets insideConstrainedOut := false (making implication vacuous)
//   and clears currentConstrainedOut := [].
//   CloseSpanWithinBudget postcondition: insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan appends "<<" and costs 1 step, preserving bound.
//   TopValidCandidates costs 1 step, no visible token appended, bound preserved.
//   Each SafePenalizedConstrainedStep / SafeRepetitionPenaltyStep / AdaptiveConstrainedStep
//   consumes 1 step; AppendConstrainedToken appends at most 1 visible token,
//   so bound is preserved per iteration.
//   CloseConstrainedSpan appends ">>" and costs 1 step, preserving bound.
//   CloseSpanWithinBudget uses closeBudget = maxSteps - steps, so total <= maxSteps.
//   EOS breaks without appending.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Provide diverse structural guidance covering many chain extender classes
helpers.AppendTaskGuidance(lm, "Generate ONE valid SMILES for a chain_extender molecule. Chain extenders are bifunctional: diols like OCC(CC)CO or OCCCO or OC(CCO)CO, diamines like NCCCCN or NC(C)CN or NCCCCCN, amino alcohols like NCCCO or NC(C)CO, or cyclic variants like OC1CCCCC1O or NC1CCCC1N. The molecule must be chemically valid and structurally distinct. Output ONLY the SMILES, no explanation, no punctuation.");

var steps: nat := 0;
var narrowThreshold: nat := 15;
var minSpanLength: nat := 4;

// Phase 0: Open constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 1: Get top candidates and penalize the most likely first token to force diversity
// This is the key diversity mechanism: if the model always wants to start with "O",
// penalizing "O" forces it to start with "C", "N", or something else.
var penalizeFirst: seq<Token> := [];
if insideConstrainedOut && steps < maxSteps {
  var topCands := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 3, eosToken);
  steps := steps + 1;
  // Penalize the top candidate(s) to force diversity away from the greedy choice
  if |topCands| >= 1 {
    penalizeFirst := topCands[..1];
  }
}

// Phase 2: Generate the first token with penalties applied to force diversity
if insideConstrainedOut && steps < maxSteps {
  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  var next: Token;
  if |penalizeFirst| > 0 {
    next := helpers.SafePenalizedConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, penalizeFirst, 8.0, eosToken);
  } else {
    next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken);
  }
  steps := steps + 1;
  if next != eosToken {
    var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
    generated := ag;
    insideConstrainedOut := ai;
    currentConstrainedOut := ac;
  }
}

// Phase 3: Continue generation with repetition penalty + adaptive steps
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    // Alternate between repetition penalty and adaptive constrained step
    if |currentConstrainedOut| % 2 == 0 {
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
    } else {
      next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken);
    }
    steps := steps + 1;
    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// If still inside span and budget remains, close within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

