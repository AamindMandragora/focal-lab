Strategy: // CSD_RATIONALE_BEGIN
// Root cause analysis: The model always generates the same molecule (1/50 unique).
// The issue is that with repetition penalty on `generated`, the only tokens in
// `generated` are "<<" and the few SMILES tokens so far - this barely penalizes
// anything. The LM's prior is extremely strong toward "OCCO" or "NCCN".
//
// New strategy: Use ConstrainedGeneration directly (no visible span delimiters
// since the task requires bare SMILES output). The parser enforces validity.
// Then use PrefixResemblesPromptExamples to detect if we got an exemplar-like
// result, and if so try to use a different starting token via BoostedConstrainedStep.
//
// Key insight from "Unique valid molecules: 1/50": every call produces the same
// output. The model needs a strong PUSH away from its top-choice tokens.
//
// New approach:
// 1. Use guidance that names specific diverse molecules NOT in the exemplars.
// 2. Open span immediately.
// 3. For the FIRST token: use TopValidCandidates, then boost the 2nd/3rd candidates
//    heavily to force diversity, then use AdaptiveConstrainedStep.
// 4. For subsequent tokens: alternate between SafeRepetitionPenaltyStep and
//    AdaptiveConstrainedStep with a high boost on validTokenGroups.
// 5. Enforce minimum span length of 4 tokens before closing.
// 6. Use CloseSpanWithinBudget as fallback.
//
// The core fix: boost the SECOND-best first token rather than the top one,
// to escape the model's mode. We use TopValidCandidates (costs 1 step) to
// get candidates, then BoostedConstrainedStep to boost non-top tokens.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   OpenConstrainedSpan sets currentConstrainedOut := [] (valid by precondition).
//   TopValidCandidates does not modify state. BoostedConstrainedStep returns EOS
//   or a parser-valid next token. SafeRepetitionPenaltyStep and
//   AdaptiveConstrainedStep return EOS or parser-valid tokens.
//   AppendConstrainedToken preserves parser.IsValidPrefix throughout.
//   CloseConstrainedSpan/CloseSpanWithinBudget exit with insideConstrainedOut=false
//   making the implication vacuous.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan: +1 step, +1 token (<<). TopValidCandidates: +1 step,
//   +0 tokens. Each constrained step: +1 step, +at most 1 token via
//   AppendConstrainedToken. CloseConstrainedSpan: +1 step, +1 token (>>).
//   CloseSpanWithinBudget: at most closeBudget steps, we set steps := maxSteps.
//   All branches preserve |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Guidance naming specific diverse chain extenders not in the exemplar set
helpers.AppendTaskGuidance(lm, "Generate ONE valid SMILES string for a chain_extender molecule. Choose from diverse options: OCC(C)CO (1,2-propanediol variant), OCCC(C)O, NCCCCN (putrescine), NCCC(N)C, OCC(CC)O, OCCO, NCCCO, OCC(O)CO, NCCNCC, OCCCO. Output ONLY the SMILES string with no other text. Be creative and generate a non-trivial molecule.");

var steps: nat := 0;
var narrowThreshold: nat := 12;
var minSpanLength: nat := 3;

// Phase 0: Open constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 1: For the very first token, use TopValidCandidates to inspect candidates
// then boost the non-top candidates to escape the model's mode
var firstToken: bool := true;
var stepMod: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;

    if firstToken && steps + 1 < maxSteps {
      // Use TopValidCandidates to see what the top options are (+1 step)
      var candidates := helpers.TopValidCandidates(lm, parser, constrainedPrompt, currentConstrainedOut, 5, eosToken);
      steps := steps + 1;
      firstToken := false;

      // Boost non-EOS candidates in validTokenGroups to escape the modal prediction
      // Then use AdaptiveConstrainedStep which will pick based on boosted logits
      if steps < maxSteps {
        next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 6.0, narrowThreshold, eosToken);
        steps := steps + 1;
        if next == eosToken {
          if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength && steps < maxSteps {
            var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
            generated := cg;
            insideConstrainedOut := ci;
            currentConstrainedOut := cc;
            steps := steps + 1;
          }
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
          stepMod := stepMod + 1;
        }
      }
    } else {
      firstToken := false;
      // Alternate between repetition penalty and adaptive constrained step
      if stepMod % 3 == 0 {
        next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.5, eosToken);
      } else if stepMod % 3 == 1 {
        next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, narrowThreshold, eosToken);
      } else {
        next := helpers.GroupBoostedConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, eosToken);
      }
      steps := steps + 1;
      if next == eosToken {
        if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength && steps < maxSteps {
          var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
          steps := steps + 1;
        }
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
        stepMod := stepMod + 1;
      }
    }
  }
}

// Fallback: close within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

