Strategy: // CSD_RATIONALE_BEGIN
// Chain-extender SMILES diversity CSD - Attempt 4.
//
// Root cause diagnosis: All previous attempts generate syntactically valid SMILES
// with 100% membership but only 1 unique molecule out of 50. The "Samples to 100
// unique valid" metric shows 1000 (the cap), meaning the model is stuck on the
// exact same SMILES string every time.
//
// The fundamental issue: The model's top-1 greedy output (most probable SMILES
// given the constrained grammar) is always the same token sequence. The guidance
// names exemplar molecules (OCCO, OCC(C)O, NCCN, NCCO) which directly causes the
// model to reproduce them. Even with high temperature in prior attempts, if we
// always use the SAME temperature and the model has a highly peaked distribution
// at each step, we still get the same output.
//
// Key insight from diagnostics:
// - Tiny-span rate: 100.0% - The SMILES is very short (tiny span)
// - Delimiter churn ratio: 0.143 - The model opens/closes spans correctly
// - 1/50 unique valid molecules - Extreme convergence
//
// Fix strategy:
// 1. NO exemplar SMILES in guidance. Describe the class functionally/structurally.
// 2. Use TemperatureConstrainedStep with temperature 2.0 to flatten the distribution
//    very aggressively. This is the key change - much higher temperature than before.
// 3. After generating a few tokens, use SafeRepetitionPenaltyStep on currentConstrained
//    to avoid repeating the same sub-patterns, penalizing tokens already in the span.
// 4. Use MaskTokensInPrefix before sampling to avoid tokens from the current span.
//    Actually, this interferes with SMILES grammar. Use SafeRepetitionPenaltyStep instead.
// 5. Do NOT open a constrained span with "<<" prefix - the task output contract
//    says "single SMILES string and nothing else", so we should generate directly.
//    Wait - looking at the diagnostic: "tiny-span rate: 100%" and "delimiter churn
//    ratio: 0.143" - the spans ARE being used. The evaluator extracts content between
//    << >> delimiters. So we must keep the constrained span approach.
// 6. The key change: use TemperatureConstrainedStep with temperature=2.0 to maximize
//    diversity. This is higher than the 1.5 used in attempt 3.
// 7. Additionally, use SafeRepetitionPenaltyStep with penalty=3.0 on currentConstrainedOut
//    to further diversify within the span.
// 8. No exemplar names in guidance - describe class by chemistry only.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   OpenConstrainedSpan sets insideConstrainedOut := true, currentConstrainedOut := [],
//   and parser.IsValidPrefix([]) holds by precondition. In the generation loop,
//   TemperatureConstrainedStep returns either EOS or a parser-valid next token
//   (hard-mask postcondition), and SafeRepetitionPenaltyStep similarly returns
//   EOS or a parser-valid next token. AppendConstrainedToken preserves
//   parser.IsValidPrefix by only appending a parser-valid token.
//   CloseConstrainedSpan exits constrained mode (insideConstrainedOut := false,
//   making the implication vacuous). CloseSpanWithinBudget postcondition guarantees
//   insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan appends one token ("<<") and costs 1 step. Each
//   TemperatureConstrainedStep or SafeRepetitionPenaltyStep consumes 1 step;
//   AppendConstrainedToken appends at most 1 visible token. CloseConstrainedSpan
//   appends ">>" and costs 1 step. EOS breaks without appending.
//   CloseSpanWithinBudget uses closeBudget = maxSteps - steps, so total
//   |generated| <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Guidance: functional description only, NO exemplar SMILES strings named
helpers.AppendTaskGuidance(lm, "Generate a single valid SMILES string representing a novel chain_extender molecule. Chain extenders are small bifunctional organic compounds used in step-growth polymerization reactions. They typically contain exactly two reactive end groups such as hydroxyl (-OH) or amine (-NH2) groups. The backbone is a short carbon chain or ring system with 2 to 8 carbons. Generate a chemically valid SMILES with variation in backbone length, branching, or functional group type. Output the SMILES string only, with no additional text.");

var steps: nat := 0;

// Open constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Generate constrained SMILES tokens with high temperature for diversity
// Alternate between TemperatureConstrainedStep (high temp) and SafeRepetitionPenaltyStep
var useTemp: bool := true;
var tokenCount: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    // Use high temperature with repetition penalty for diversity
    if useTemp {
      next := helpers.TemperatureConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, 2.0, eosToken);
    } else {
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
    }
    useTemp := !useTemp;
    steps := steps + 1;
    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
      tokenCount := tokenCount + 1;
    }
  }
}

// Close within remaining budget if still open
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

