// - "tiny_span_dominant: yes" in mode_A failures = molecules like "OCCO" (4 chars, complete, closes early)
// - "Samples to 100 unique valid (cap 1000): 1000" = LM is extremely non-diverse
//
// Root cause analysis:
// 1. ScaleAllLogits(0.1) made things WORSE not better - it reduced diversity from 9 to 5 unique
//    Hypothesis: very flat distributions cause the model to cycle among a few valid tokens
//    in the grammar, not produce more diverse molecules.
// 2. The tiny_span problem: minSpanLength=4 still gets "OCCO" (4 chars). Need minSpanLength=5.
// 3. The best attempt (14) used ScaleAllLogits(0.3) + SafeSoftConstrainedStep + minSpanLength=3
//    but still only 26%. 
//
// New diagnostic insight: The "tiny_span_dominant" problem means the span is closing too early
// because the parser marks short molecules as complete. The evaluator sees "OCCO" and it's 
// valid but non-exemplar... wait, "OCCO" IS in the exemplar set (diethylene glycol fragment).
// "CCC(O)CC" is a single-OH molecule - NOT a chain extender.
//
// The 6 wrong examples in attempt 17 all have tiny spans. The issue is minSpanLength=4 
// is too small - "OCCO" is exactly 4 chars (4 tokens: O, C, C, O).
//
// Key insight: We need minSpanLength=6 minimum to push past the simplest chain extenders
// that are in the exemplar set. Actually the bigger problem is generating valid CHAIN EXTENDERS
// (bifunctional) not just valid SMILES.
//
// NEW STRATEGY:
// The attempt ledger shows accuracy DECREASING as we flatten more. The sweet spot is
// moderate flattening (0.3-0.4). The real lever is MINIMUM SPAN LENGTH.
//
// Key: "OCCO" = 4 tokens, "OCCCO" = 5 tokens, "NCCN" = 4 tokens, "NCCCN" = 5 tokens
// These are exemplars. We need spans of at LEAST 6 tokens to avoid known exemplars.
// Better: use minSpanLength=7 to force more complex molecules.
//
// Also: The guidance should steer toward LONGER chains and uncommon functional group arrangements.
// Rather than listing OCCO (exemplar), we should list longer less-common examples.
//
// The "CCC(O)CC" issue: single OH group, not bifunctional. The LM sometimes generates
// this because "CC" chains are common in SMILES. 
//
// APPROACH FOR THIS ATTEMPT:
// 1. Keep ScaleAllLogits(0.3) which worked best in attempt 14
// 2. Increase minSpanLength to 8 (force longer molecules, avoid short exemplars)
// 3. Use SafeSoftConstrainedStep for the ENTIRE generation (not just first tokens)
//    because attempt 14 got best results - stay consistent
// 4. Boost amount = 8.0 (higher than attempt 14's 8.0 - actually same)
// 5. Use RepetitionPenaltyStep more aggressively to prevent cycling on O/C/C
// 6. Provide guidance with VERY specific, longer chain extender examples
//    that are NOT in the exemplar set
//
// Wait - checking attempt 14 (best): it used ScaleAllLogits(0.3), SafeSoftConstrainedStep
// with 8.0 boost for first <2 tokens, AdaptiveConstrainedStep for even positions,
// SafeRepetitionPenaltyStep for odd positions, minSpanLength=3.
//
// The tiny_span_dominant issue in attempts 16-17 with minSpanLength=4-5 suggests 
// the span IS closing at exactly that length. With minSpanLength=8, the model would
// be forced to generate at least 8 constrained tokens before close.
//
// CRITICAL CHANGE: Use minSpanLength=8 throughout, use ScaleAllLogits(0.3),
// use primarily SafeSoftConstrainedStep (which gave best results in attempt 14).
// Add specific guidance steering toward novel bifunctional molecules.
//
// BONUS: Use AdaptiveConstrainedStepWithPenalties with a penalty on single-atom
// tokens (O, N, C) when the span is short, to force more complex substructures.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   OpenConstrainedSpan sets currentConstrainedOut := [] which satisfies
//   parser.IsValidPrefix([]) by precondition. SafeSoftConstrainedStep,
//   AdaptiveConstrainedStep, SafeRepetitionPenaltyStep all return EOS or a
//   parser-valid next token by their postconditions. AppendConstrainedToken
//   extends currentConstrainedOut with a valid-next token, preserving 
//   IsValidPrefix by the parser's append-valid postcondition. CloseConstrainedSpan
//   sets insideConstrainedOut := false, making the implication vacuously true.
//   CloseSpanWithinBudget postcondition: insideConstrainedOut ==> IsValidPrefix(currentOut).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan: steps += 1, |generated| += 1 (the "<<" token), bound preserved.
//   CloseConstrainedSpan: steps += 1, |generated| += 1 (the ">>" token), bound preserved.
//   Each constrained step: steps += 1; AppendConstrainedToken adds at most 1 token
//   (or 0 on EOS path). So |generated| - |generatedPrefix| <= steps holds.
//   ScaleAllLogits: +0 cost, +0 tokens; does not affect invariant.
//   CloseSpanWithinBudget: at most closeBudget = maxSteps - steps steps consumed;
//   we set steps := maxSteps after, so |generated| <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate ONE novel SMILES for a chain_extender. Chain extenders are BIFUNCTIONAL molecules with exactly two OH or NH2 groups. Generate molecules with 5+ heavy atoms. Examples of VALID novel chain extenders (NOT in training set): OCCCCCCO, NCCCCCCN, OCC(C)(C)CO, NC(C)CCN, OCCC(CC)CO, OCCCC(O)CCC, NCC(CC)CN, OC(CCC)CCO, NC(CCN)CC, OCCNCC(O)CO, OCCC(N)CCN, NC(CO)CN, NCC(C)(C)CN, OCCCC(CCO)CO, NC(CCC)CN. Output ONLY the SMILES, no other text.");

var steps: nat := 0;
var minSpanLength: nat := 8;

// Open constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Main constrained generation loop
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength {
    // Close the span - molecule is complete with sufficient length
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];

    // Scale logits for moderate diversity (0.3 was best in attempt 14)
    helpers.ScaleAllLogits(lm, 0.3);

    var next: Token;
    var spanLen := |currentConstrainedOut|;

    if spanLen < 4 {
      // First few tokens: use SafeSoftConstrainedStep with high boost
      // to steer toward diverse starting patterns
      var ns, ok := helpers.SafeSoftConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, 8.0, eosToken);
      next := ns;
    } else if spanLen < 8 {
      // Middle tokens: alternate between strategies for more diversity
      if spanLen % 2 == 0 {
        next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, 16, eosToken);
      } else {
        next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
      }
    } else {
      // Longer spans: use repetition penalty to encourage completing the molecule
      // with varied structure rather than cycling on the same atoms
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
    }
    steps := steps + 1;

    if next == eosToken {
      // EOS received - only close if complete and meets minimum length
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Fallback: close within remaining budget if span is still open
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

