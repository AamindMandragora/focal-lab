Strategy: // CSD_RATIONALE_BEGIN
// SMILES chain-extender generation CSD.
// The strategy generates a valid SMILES string for a chain_extender molecule
// directly inside a constrained span. Chain extenders are typically small
// bifunctional molecules (diols, diamines, etc.) used in polyurethane synthesis.
// The parser enforces SMILES grammar validity throughout.
//
// State tracked:
//   - insideConstrainedOut / currentConstrainedOut: whether we are inside a
//     constrained SMILES span and what has been generated so far.
//   - steps: token budget consumed so far.
//
// Strategy:
//   Phase 0: Open a constrained span immediately (no free preamble needed,
//            since the task asks for a bare SMILES string).
//   Phase 1: Generate SMILES tokens using AdaptiveConstrainedStep with
//            SafeRepetitionPenaltyStep to avoid repetitive ring/chain patterns.
//            Use narrowThreshold=20 to boost valid groups when branching is narrow.
//   Phase 2: Once parser.IsCompletePrefix, close the span.
//
// The guidance string steers the LM toward chain_extender SMILES patterns.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   OpenConstrainedSpan sets insideConstrainedOut := true and currentConstrainedOut := [],
//   which is a valid prefix by parser.IsValidPrefix([]) (precondition). In the
//   constrained-generation branch, AdaptiveConstrainedStep and SafeRepetitionPenaltyStep
//   both return either EOS or a parser-valid next token; AppendConstrainedToken then
//   extends currentConstrainedOut by that token, preserving parser.IsValidPrefix.
//   CloseConstrainedSpan sets insideConstrainedOut := false, making the implication
//   vacuous, and clears currentConstrainedOut to [].
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan appends one token ("<<") and costs 1 step, so the bound
//   is preserved. In the constrained branch, each AdaptiveConstrainedStep or
//   SafeRepetitionPenaltyStep consumes 1 step and AppendConstrainedToken appends
//   at most 1 token, preserving the bound. CloseConstrainedSpan appends ">>" and
//   costs 1 step, preserving the bound. EOS breaks the loop without appending.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Steer the model toward chain_extender SMILES patterns
helpers.AppendTaskGuidance(lm, "Generate a single valid SMILES string for a chain_extender molecule. Chain extenders are small bifunctional molecules such as diols (e.g., OCCO, OCC(C)O), diamines (e.g., NCCN), or amino alcohols (e.g., NCCO). Output only the SMILES string, nothing else.");

var steps: nat := 0;
var narrowThreshold: nat := 20;
var useRepPenalty: bool := true;

// Phase 0: Open constrained span immediately (task requires bare SMILES output)
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 1+2: Generate constrained SMILES tokens, then close when complete
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed; we are done
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    // Close the span
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    // Generate next constrained SMILES token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    if useRepPenalty {
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
    } else {
      next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken);
    }
    steps := steps + 1;
    if next == eosToken {
      // Check if we can close; if not, try to close within remaining budget
      if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
      // Alternate between repetition penalty and adaptive for variety
      useRepPenalty := !useRepPenalty;
    }
  }
}

// If still inside span and budget remains, try to close within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

