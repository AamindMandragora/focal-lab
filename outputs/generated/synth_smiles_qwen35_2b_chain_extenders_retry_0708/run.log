Strategy: // CSD_RATIONALE_BEGIN
// Strategy: For SMILES generation on a small model (Qwen3.5-2B), we use
// GenerateWithPrefixAndManagedSpan which handles the full decode loop with:
// - Free preamble (prefixBudget=0 forces immediate constrained entry)
// - Parser-controlled constrained span generation
// - Completeness-gated span closing
// - Proof obligations discharged inside the helper
// This is appropriate for SMILES as a fully-structured output requiring
// strict grammar validity throughout generation.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// Invariant 1 (parser_validity):
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Base case: initialized from precondition (insideConstrained ==>
//     parser.IsValidPrefix(currentConstrained)).
//   - GenerateWithPrefixAndManagedSpan guarantees its output satisfies
//     insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//     by its postcondition, so the invariant is preserved on the single call.
//
// Invariant 2 (progress):
//   |generated| <= |generatedPrefix| + steps
//   - Base case: generated == generatedPrefix, steps == 0.
//   - GenerateWithPrefixAndManagedSpan has postcondition
//     |generated| <= |generatedPrefix| + maxSteps, and cost := maxSteps,
//     so the bound holds. When maxSteps == 0, cost := 0 and generated is
//     unchanged, so the progress postcondition is trivially satisfied.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

if maxSteps == 0 {
  // Nothing to do; all postconditions hold trivially.
} else {
  var g, ic, cc := helpers.GenerateWithPrefixAndManagedSpan(
    lm, parser, prompt, generated, insideConstrainedOut, currentConstrainedOut,
    maxSteps, 0, validTokenGroups, 6.0, 12, eosToken
  );
  generated := g;
  insideConstrainedOut := ic;
  currentConstrainedOut := cc;
  cost := maxSteps;
}

