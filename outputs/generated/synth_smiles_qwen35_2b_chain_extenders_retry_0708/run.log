// sometimes generates non-SMILES text before the constrained span content
// gets committed - likely because the OpenConstrainedSpan appends "<<" and
// the LM then generates garbage.
//
// Key observations:
// 1. Diversity is very low - most outputs are the same 1-11 molecules.
// 2. The model IS generating valid SMILES (96% syntax) and chain extenders (98% membership).
// 3. The "NG"/"SM" failures are cases where CloseSpanWithinBudget failed and
//    leftover tokens were emitted.
// 4. Accuracy = unique_valid_rate = distinct valid non-exemplar molecules / N.
//    To hit 42%, we need ~21 unique molecules in 50 runs.
//
// Root issue: The LM always picks the same molecule. ScaleAllLogits(0.4) and
// SafeSoftConstrainedStep didn't create enough diversity.
//
// New strategy:
// 1. Use ConstrainedGeneration helper - it does the full inner loop cleanly.
//    It starts from empty currentConstrained and generates until complete.
//    We then extract the result and wrap it with the span bookkeeping.
// 2. Before calling it, aggressively flatten logits with ScaleAllLogits(0.1).
//    This should make sampling near-uniform across valid tokens.
// 3. Also penalize the single most common output tokens ("O", "N", "C") to
//    force diversity. But wait - chain extenders NEED O or N.
//
// Better approach: Use ConstrainedGeneration directly. It handles the
// minSpanLength issue differently - it only stops at parser.IsCompletePrefix.
// The problem is diversity, not correctness.
//
// CRITICAL INSIGHT: The 50 examples get the same prompt context each time.
// The LM with identical context generates identically unless we:
// (a) Vary logit manipulation differently per step, OR
// (b) Force the first token to vary using TopValidCandidates + BoostedConstrainedStep
//     (attempts 12/13 showed this got 2% - too aggressive).
//
// What DOES work is ScaleAllLogits(0.3) + SafeSoftConstrainedStep (best: 26%).
// What makes it fail: min span length too high blocks valid short molecules.
//
// SMILES parser accepts "O" as complete (water). We don't want that.
// But "OCCO" = ethylene glycol and is a valid chain extender.
// minSpanLength = 2 is too short. Need at least 4 atoms.
//
// The issue with minSpanLength >= 6: small but valid chain extenders like
// "OCCO" (4 tokens) get blocked and the model drifts to garbage.
//
// NEW PLAN:
// 1. ScaleAllLogits(0.2) for maximum diversity - very flat distribution.
// 2. Use AdaptiveConstrainedStep with HIGH boost (10.0) and narrow threshold (8).
// 3. minSpanLength = 4 (OCCO is 4 tokens and valid).
// 4. Use SafeRepetitionPenaltyStep at every step to penalize already-generated atoms.
// 5. Use a very specific guidance string that lists unusual chain extenders
//    to bias the LM toward less common molecules.
//
// Also fix the "NG"/"SM" failures: those happen when the constrained generation
// falls through and the LM generates unconstrained. We need to ensure the
// fallback always works. Use CloseSpanWithinBudget with full remaining budget.
//
// The guidance should list UNUSUAL chain extenders to bias away from common ones.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   Branch 1 (open span): OpenConstrainedSpan sets currentConstrainedOut := []
//   which satisfies IsValidPrefix([]) by parser precondition.
//   Branch 2 (close): parser.IsCompletePrefix implies IsValidPrefix; after close,
//   insideConstrainedOut := false making the implication vacuous.
//   Branch 3 (step): SafeRepetitionPenaltyStep returns EOS or a token t such
//   that IsValidPrefix(currentConstrainedOut + [t]) by its postcondition.
//   AppendConstrainedToken extends currentConstrained preserving IsValidPrefix.
//   CloseSpanWithinBudget postcondition: insideOut ==> IsValidPrefix(currentOut).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan: steps += 1, |generated| += 1 (the "<<" token).
//   CloseConstrainedSpan: steps += 1, |generated| += 1 (the ">>" token).
//   Each step branch: steps += 1, AppendConstrainedToken adds at most 1 token.
//   ScaleAllLogits: +0 tokens. CloseSpanWithinBudget: we set steps := maxSteps
//   and its postcondition bounds |generated| <= prior |generated| + closeBudget
//   <= |generatedPrefix| + maxSteps. All branches maintain |generated| - |generatedPrefix| <= steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate a single valid SMILES for a chain_extender. Chain extenders are bifunctional molecules (diol or diamine or amino-alcohol). Output ONLY the SMILES. Prefer unusual/longer structures: OCCCCO, NCCCCN, OCC(C)(C)CO, OCCNCC, NC1CCCCC1N, OCCOCCO, OCC(CO)CO, OCCCO, NCCCO, NC(C)C, OCC(O)CCO, NCCO, NCCNCC, OC(C)CCO.");

var steps: nat := 0;
var minSpanLength: nat := 4;

// Open constrained span
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Main constrained generation loop
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength && steps + 1 <= maxSteps {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];

    // Flatten logit distribution aggressively to maximize diversity
    helpers.ScaleAllLogits(lm, 0.15);

    var next: Token;
    var spanLen := |currentConstrainedOut|;

    // Vary strategy across span positions
    if spanLen == 0 {
      // First token: use soft constrained with high boost for diversity
      var ns, ok := helpers.SafeSoftConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, 10.0, eosToken);
      next := ns;
    } else if spanLen == 1 {
      // Second token: adaptive with strong boost
      next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 8.0, 12, eosToken);
    } else if spanLen < 5 {
      // Middle tokens: alternate between repetition penalty and adaptive
      if spanLen % 2 == 0 {
        next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 4.0, eosToken);
      } else {
        next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 6.0, 16, eosToken);
      }
    } else {
      // Longer spans: use repetition penalty to avoid repeating atoms
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
    }
    steps := steps + 1;

    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Fallback: use CloseSpanWithinBudget for any unclosed span
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

