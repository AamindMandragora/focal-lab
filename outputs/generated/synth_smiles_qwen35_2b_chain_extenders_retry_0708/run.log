Strategy: // CSD_RATIONALE_BEGIN
// Chain-extender SMILES CSD - Attempt 8.
//
// Diagnosis from prior attempts:
// - Attempts 1-6: syntax 100%, accuracy 2% → model always generates the same SMILES (likely "OCCO")
// - Attempt 7: tried penalizing top candidate → syntax dropped to 6%, accuracy 4%
//   The SafePenalizedConstrainedStep call broke things (wrong helper name; should be PenalizedConstrainedStep)
//   The TopValidCandidates call consumed a step, and penalizing the top token caused invalid SMILES.
//
// Root cause: The model collapses to one molecule. We need diversity without breaking validity.
//
// New approach:
// 1. Use AppendTaskGuidance with a rich, specific guidance that names many valid chain extenders
//    and asks the model to vary the structure.
// 2. Open constrained span immediately (no free preamble).
// 3. Use SafeRepetitionPenaltyStep throughout (the best prior result did this), but with
//    a higher penalty (3.0 instead of 2.0) to force more structural diversity.
// 4. Alternate between SafeRepetitionPenaltyStep and AdaptiveConstrainedStep.
// 5. Close when complete.
//
// The key insight from attempt 7 rollout: "OC1CCCCC>>" - the span was closed early
// because OC1CCCCC is not a complete SMILES (open ring). The issue is our CloseConstrainedSpan
// was being called when IsCompletePrefix returns true for partial SMILES.
//
// Wait - attempt 7 had syntax=6% meaning the SMILES were invalid. The "OC1CCCCC>>" output
// suggests the span closed prematurely. Looking more carefully: TopValidCandidates costs 1
// step, so the model had fewer steps for actual generation.
//
// Best prior result (attempts 1-6): syntax=100%, accuracy=2% → model always says "OCCO"
// Strategy: keep the 100% syntax approach but add more diversity pressure.
//
// Key change: Use guidance that explicitly lists diverse structures AND use a stronger
// repetition penalty (3.0) to prevent the model from always starting with "O".
// Also penalize "O" as first token using SafeBoostTokenLogits to boost "C" and "N"
// before the first constrained step, without consuming extra budget.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   OpenConstrainedSpan sets insideConstrainedOut := true and currentConstrainedOut := [],
//   satisfying parser.IsValidPrefix([]) by precondition.
//   SafeBoostTokenLogits / SafePenalizeTokenLogits do not change generated state.
//   SafeRepetitionPenaltyStep returns EOS or a parser-valid next token (hard mask postcondition).
//   AdaptiveConstrainedStep returns EOS or a parser-valid next token (hard mask postcondition).
//   AppendConstrainedToken preserves parser.IsValidPrefix(currentConstrainedOut) by contract.
//   CloseConstrainedSpan requires IsCompletePrefix, sets insideConstrainedOut := false
//   (making implication vacuous), clears currentConstrainedOut := [].
//   CloseSpanWithinBudget postcondition: insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan appends "<<" (1 token) and costs 1 step: bound preserved.
//   SafeBoostTokenLogits / SafePenalizeTokenLogits cost 0 and append nothing.
//   Each SafeRepetitionPenaltyStep or AdaptiveConstrainedStep consumes 1 step;
//   AppendConstrainedToken appends at most 1 visible token: bound preserved per iteration.
//   CloseConstrainedSpan appends ">>" (1 token) and costs 1 step: bound preserved.
//   CloseSpanWithinBudget uses closeBudget = maxSteps - steps and adds at most
//   closeBudget to both |generated| and steps, keeping total <= |generatedPrefix| + maxSteps.
//   EOS breaks without appending.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Rich guidance listing many diverse chain extender SMILES structures
helpers.AppendTaskGuidance(lm, "Task: output exactly one valid SMILES string for a chain_extender molecule. Chain extenders are small bifunctional molecules used in polymer synthesis. Examples of valid chain extenders: NCCN (ethylenediamine), NCCCN (1,3-propanediamine), NCCCCN (1,4-butanediamine), NCCCCCN (1,5-pentanediamine), NCCCCCCN (hexamethylenediamine), OCCO (ethylene glycol), OCCCО (1,3-propanediol), OCCCO (trimethylene glycol), OCCCCO (1,4-butanediol), OCCCCCO (1,5-pentanediol), OCCCCCCO (1,6-hexanediol), NCCO (ethanolamine), NCCCO (3-amino-1-propanol), OCC(O)CO (glycerol partial), CC(O)CCO (1,3-butanediol), CC(N)CCN (2-methyl-1,3-propanediamine), OC(C)C(C)O (2,3-butanediol), OC1CCCCC1O (cyclohexanediol), NC1CCCCC1N (cyclohexanediamine). Output ONLY the SMILES string with no explanation.");

var steps: nat := 0;
var narrowThreshold: nat := 20;
var useRepPenalty: bool := true;

// Phase 0: Open constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Soft-boost tokens that are common valid chain extender starts: "N", "C" 
// to diversify away from always starting with "O"
// These are logit edits only (cost 0), applied before first generation step
if insideConstrainedOut {
  helpers.SafePenalizeTokenLogits(lm, ["O"], 2.0);
  helpers.SafeBoostTokenLogits(lm, ["N", "C"], 3.0);
}

// Phase 1+2: Generate constrained SMILES tokens, then close when complete
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    if useRepPenalty {
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
    } else {
      next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken);
    }
    steps := steps + 1;
    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
      useRepPenalty := !useRepPenalty;
    }
  }
}

// If still inside span and budget remains, close within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

