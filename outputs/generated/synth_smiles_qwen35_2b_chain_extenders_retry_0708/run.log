Strategy: // CSD_RATIONALE_BEGIN
// Chain-extender SMILES generation CSD.
//
// Key diagnosis: The previous attempt scored 2% accuracy with 100% syntax,
// meaning syntactically valid SMILES were generated but almost always the same
// molecule (Unique valid: 1/50, "Tiny-span rate: 100%"). The model is converging
// to a single repeated SMILES (likely "OCCO" or similar exemplar), not generating
// diverse non-exemplar chain extender molecules.
//
// Root cause: The guidance was too specific (listed exemplar molecules like OCCO,
// OCC(C)O, NCCN, NCCO), steering the model to regenerate exactly those exemplars.
// Also, SafeRepetitionPenaltyStep penalizes tokens in `generated` which includes
// the delimiter "<<" and other non-SMILES content, not the core issue.
//
// Fix strategy:
// 1. Change guidance to be general about chain extenders without listing specific
//    exemplar SMILES strings, encouraging diverse bifunctional molecules.
// 2. Use SafeRepetitionPenaltyStep against currentConstrainedOut (the actual
//    SMILES content) instead of the full generated sequence, to avoid penalizing
//    structural SMILES tokens that should repeat (like "C", "O", "N").
// 3. Use temperature scaling (SafeTemperatureConstrainedStep) to introduce more
//    diversity in token selection, alternating with repetition-penalized steps.
// 4. Mask tokens from the prompt/generated prefix that might be exemplar molecules
//    to avoid copying them verbatim.
// 5. Use AdaptiveConstrainedStep as the primary driver with a reasonable narrowThreshold.
// 6. No visible delimiters: since the task asks for bare SMILES, we should NOT
//    open a "<<" span at all. The task output contract is a bare SMILES string.
//    Looking at "Delimiter churn ratio: 0.111" and "Tiny-span rate: 100%", 
//    it seems the span mechanism works but produces tiny identical outputs.
//
// Actually re-reading the contract: the task says "bare SMILES string" and 
// "answer contract is a single SMILES string". The evaluator extracts the SMILES
// from inside <<...>>. So we DO need visible delimiters.
//
// The diversity problem: we need to use temperature to diversify. The model
// at low temperature always picks the same tokens. Use SafeTemperatureConstrainedStep
// with temperature > 1.0 to flatten the distribution, but be careful not to go too high.
// Also: use SafeBoostTokenLogits to boost less-common atoms/groups.
// 
// Better approach: Use ConstrainedGeneration directly which loops internally,
// combined with good guidance that avoids naming exemplars. Also penalize tokens
// that appear to be exemplar-like patterns.
//
// Final strategy: 
// - Guidance: general chain extender description without naming specific molecules
// - Open constrained span
// - Use SafeTemperatureConstrainedStep (temperature ~1.2) for diversity
// - Fall back to AdaptiveConstrainedStep with group boosts
// - Close span when complete
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   OpenConstrainedSpan sets insideConstrainedOut := true and currentConstrainedOut := [],
//   which satisfies parser.IsValidPrefix([]) by precondition. In the constrained
//   generation loop, SafeTemperatureConstrainedStep returns either EOS or a
//   parser-valid next token (hard mask postcondition). AppendConstrainedToken
//   extends currentConstrainedOut by that token, preserving parser.IsValidPrefix.
//   CloseConstrainedSpan sets insideConstrainedOut := false (implication vacuous)
//   and clears currentConstrainedOut to [].
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan appends "<<" and costs 1 step; bound preserved.
//   Each constrained step (SafeTemperatureConstrainedStep or AdaptiveConstrainedStep)
//   consumes 1 step. AppendConstrainedToken appends at most 1 token. CloseConstrainedSpan
//   appends ">>" and costs 1 step. EOS breaks without appending.
//   CloseSpanWithinBudget: uses closeBudget = maxSteps - steps steps,
//   |generated| grows by at most closeBudget, total <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Guidance: describe chain extenders generally without naming specific exemplar SMILES
helpers.AppendTaskGuidance(lm, "Generate a novel, valid SMILES string for a chain_extender compound. Chain extenders are small bifunctional organic molecules used in polymer synthesis, containing two reactive end groups (hydroxyl, amine, or carboxyl). Generate a diverse, non-trivial example that is chemically valid. Output only the SMILES string.");

var steps: nat := 0;
var narrowThreshold: nat := 15;

// Open constrained span immediately (task requires SMILES output in constrained span)
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Generate constrained SMILES tokens
var useTemp: bool := true;
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    // Alternate between temperature sampling (for diversity) and adaptive step
    if useTemp {
      // Use higher temperature for diversity
      next := helpers.SafeTemperatureConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, 1.3, eosToken);
    } else {
      next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken);
    }
    steps := steps + 1;
    if next == eosToken {
      // Try to close if complete
      if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
      useTemp := !useTemp;
    }
  }
}

// If still inside span with remaining budget, close within budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

