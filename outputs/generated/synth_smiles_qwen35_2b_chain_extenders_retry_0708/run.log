Strategy: // CSD_RATIONALE_BEGIN
// SMILES chain-extender generation CSD - revised strategy.
//
// Diagnosis from failure:
//   - "Tiny span rate: 100%" means the constrained span closes immediately (e.g. "O>>")
//     because the parser sees "O" as a complete SMILES and we eagerly close.
//   - We need to force the LM to generate a *longer*, more complex SMILES before closing.
//   - Chain extenders are bifunctional: diols, diamines, amino alcohols. They need at
//     least 2-3 heavy atoms and 2 functional groups (e.g., OCCO, NCCN, NCCo, OCC(C)O).
//
// Revised approach:
//   1. Use stronger task guidance that explicitly asks for bifunctional molecules with
//      multiple heteroatoms, discouraging single-atom outputs.
//   2. Open constrained span immediately.
//   3. During constrained generation, if the span is complete but very short
//      (e.g., < 4 tokens in currentConstrainedOut), continue generating rather than
//      closing immediately - use ValidTokenCount to check if we can expand.
//   4. Once the constrained prefix is "long enough" (>=4 tokens) AND complete, close.
//   5. Use SafeRepetitionPenaltyStep alternating with AdaptiveConstrainedStep to
//      generate diverse chain extender SMILES.
//   6. If still open near budget exhaustion, use CloseSpanWithinBudget.
//
// Minimum-length threshold: require at least 4 constrained tokens before closing,
// which prevents "O" or "N" from being emitted as the complete SMILES.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   OpenConstrainedSpan sets insideConstrainedOut := true and currentConstrainedOut := [],
//   which is valid by parser.IsValidPrefix([]) (precondition). In the constrained branch,
//   AdaptiveConstrainedStep and SafeRepetitionPenaltyStep return either EOS or a
//   parser-valid next token; AppendConstrainedToken preserves parser.IsValidPrefix.
//   CloseConstrainedSpan sets insideConstrainedOut := false (implication vacuous) and
//   clears currentConstrainedOut := []. CloseSpanWithinBudget postcondition guarantees
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan appends "<<" and costs 1 step. Each constrained-generation
//   step consumes 1 step and AppendConstrainedToken appends at most 1 token.
//   CloseConstrainedSpan appends ">>" and costs 1 step. CloseSpanWithinBudget uses
//   at most closeBudget = maxSteps - steps steps, and we then set steps := maxSteps,
//   so |generated| <= |generatedPrefix| + maxSteps holds. EOS breaks without appending.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Strong guidance to force bifunctional chain-extender SMILES (diols, diamines, amino alcohols)
// Explicitly discourage single-atom or trivially short outputs.
helpers.AppendTaskGuidance(lm, "Generate a single valid SMILES string for a chain_extender molecule. Chain extenders are small bifunctional molecules used in polyurethane/polyester synthesis. They must have at least 2 functional groups (OH, NH2) and at least 2-4 carbons in the chain. Examples: OCCO (ethylene glycol), OCC(C)O (propylene glycol), NCCN (ethylenediamine), NCCO (ethanolamine), OCC(CO)CO (trimethylolpropane), OCCCCO (1,4-butanediol), NCCCCN (putrescine). Do NOT output a single atom like O or N. Output ONLY the SMILES string.");

var steps: nat := 0;
var narrowThreshold: nat := 20;
// Minimum constrained-token length before we allow closing the span.
// This prevents trivially short outputs like "O" or "N".
var minSpanLength: nat := 4;
var useRepPenalty: bool := false;

// Phase 0: Open constrained span immediately (task requires bare SMILES output)
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 1+2: Generate constrained SMILES tokens, close when complete AND long enough
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed; we are done
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength {
    // The span is complete and long enough - close it
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    // Generate next constrained SMILES token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    if useRepPenalty {
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.5, eosToken);
    } else {
      next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken);
    }
    steps := steps + 1;
    if next == eosToken {
      // EOS hit: if complete and long enough, close; otherwise try CloseSpanWithinBudget
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
      // Alternate between repetition penalty and adaptive for variety
      useRepPenalty := !useRepPenalty;
    }
  }
}

// If still inside span and budget remains, close within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

