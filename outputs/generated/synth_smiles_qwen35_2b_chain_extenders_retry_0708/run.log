Strategy: // CSD_RATIONALE_BEGIN
// Chain-extender SMILES diversity CSD - Attempt 5.
//
// Root cause analysis from prior attempts:
// - Membership: 0.0% across all attempts despite 100% RDKit validity
// - The extracted SMILES is always "O" (just a single oxygen atom)
// - "Tiny-span rate: 100%" confirms the model generates only 1-2 token SMILES
// - The model is collapsing to "O" (water) which is valid SMILES but not a chain extender
//
// The problem: parser.IsCompletePrefix([]) or parser.IsCompletePrefix(["O"]) returns
// true immediately, causing CloseConstrainedSpan to fire after just "O" or even empty.
// The SMILES grammar parser likely accepts any valid SMILES as complete at any point
// (since even "O" is a complete SMILES string).
//
// Fix strategy:
// 1. Use SafeRepetitionPenaltyStep with high penalty to avoid "O" alone
// 2. Force a minimum length by NOT checking IsCompletePrefix until we've generated
//    at least 4 tokens in the constrained span (diol/diamine SMILES are >= 4 tokens)
// 3. Use CloseSpanWithinBudget after reaching minimum length rather than closing immediately
// 4. Guidance that does NOT name exemplars but describes the minimum structural requirements
// 5. Penalize short atoms like standalone "O", "N", "C" at the start
// 6. Key insight: The minimum chain extender has pattern X-C-C-X where X is O or N,
//    which requires at least 4 SMILES tokens. We enforce minimum span length of 4.
//
// Implementation:
// - Open span, generate tokens with repetition penalty
// - Only attempt to close when |currentConstrainedOut| >= 4
// - Use AdaptiveConstrainedStep with group boosts for variety
// - After minimum length reached, CloseSpanWithinBudget for clean termination
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   OpenConstrainedSpan sets insideConstrainedOut := true, currentConstrainedOut := [],
//   which satisfies parser.IsValidPrefix([]) by precondition.
//   In the generation loop:
//   - SafeRepetitionPenaltyStep returns EOS or a parser-valid next token (hard-mask postcondition).
//   - AdaptiveConstrainedStep returns EOS or a parser-valid next token.
//   - AppendConstrainedToken preserves parser.IsValidPrefix by appending only a valid token.
//   - CloseSpanWithinBudget postcondition guarantees insideOut ==> parser.IsValidPrefix(currentOut).
//   - CloseConstrainedSpan exits constrained mode (insideConstrainedOut := false, making
//     the implication vacuous, currentConstrainedOut := []).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan appends one token ("<<") and costs 1 step.
//   Each SafeRepetitionPenaltyStep or AdaptiveConstrainedStep consumes 1 step;
//   AppendConstrainedToken appends at most 1 visible token.
//   The minimum-length guard only delays closing, it does not add extra tokens beyond
//   the normal per-step bound.
//   CloseSpanWithinBudget uses closeBudget = maxSteps - steps, so
//   |generated| <= |generatedPrefix| + maxSteps total.
//   CloseConstrainedSpan appends ">>" and costs 1 step.
//   EOS breaks without appending.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Guidance: describe class structurally, NO exemplar SMILES named
helpers.AppendTaskGuidance(lm, "Generate a valid SMILES string for a chain_extender compound. Chain extenders are bifunctional small molecules used in step-growth polymerization. They must have exactly two reactive functional groups (hydroxyl -OH or primary amine -NH2) at the chain termini, separated by a carbon backbone of 2-8 carbons. The molecule must contain at least two heteroatoms (O or N) as terminal groups connected through a carbon chain. Minimum structure: two functional groups separated by at least 2 carbons. Generate a diverse, novel SMILES with backbone variation. Output only the SMILES string.");

var steps: nat := 0;
var narrowThreshold: nat := 15;
var minSpanLength: nat := 4;

// Open constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Generation loop: produce SMILES tokens with diversity enforcement
// Only close the span after reaching minimum length
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength {
    // Span is complete and long enough - close it
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    // Generate next constrained token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    // Alternate between repetition penalty and adaptive for diversity
    if |currentConstrainedOut| % 2 == 0 {
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
    } else {
      next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken);
    }
    steps := steps + 1;
    if next == eosToken {
      // EOS encountered - if span is complete and long enough, close; otherwise try CloseSpanWithinBudget
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// If still inside span and budget remains, close within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

