Strategy: // CSD_RATIONALE_BEGIN
// Analysis of failures:
// - "tiny_span_dominant: yes" means the constrained span is closing too early with very short SMILES.
// - "other_observed_failure" examples show "SM", "OCCO", "OCCCCO" - only 2-5 token molecules.
// - The model generates valid SMILES but they're too simple/common (not novel enough).
// - We need LONGER, MORE COMPLEX chain extenders with 6-12+ heavy atoms.
// - The minimum length gate of 3 is too short. We need minSpanLength >= 6.
// - Also the model is hitting completion too fast - parser accepts tiny molecules.
//
// Key insight from diagnostics:
// - "Unique valid molecules: 13/50" - diversity is low, many duplicates.
// - "Samples to 100 unique valid (cap 1000): 1000" - can't even reach 100 unique in 1000 tries.
// - Need to generate LONGER and more DIVERSE molecules.
//
// Strategy revision:
// 1. Enforce minimum span length of 8 tokens before allowing close.
// 2. Use AdaptiveConstrainedStep with strong group boosting throughout.
// 3. Use RepetitionPenaltyStep to discourage repeating atoms already in span.
// 4. Use ScaleAllLogits with 0.5 (slightly flatten) to help diversity.
// 5. Key change: Only close when BOTH parser says complete AND length >= 8.
// 6. Add task guidance specifically requesting longer/complex chain extenders.
// 7. Alternate between different stepping strategies based on position in span.
//
// The "tiny_span" failure means IsCompletePrefix returns true too early.
// We MUST ignore early completions and keep generating until length >= 8.
//
// For true diversity: use ScaleAllLogits(0.5) before each step to flatten
// the logit distribution, forcing the LM to explore more token options.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   OpenConstrainedSpan sets currentConstrainedOut := [] (valid by precondition).
//   Every constrained step (AdaptiveConstrainedStep, SafeRepetitionPenaltyStep,
//   SafeSoftConstrainedStep) returns a parser-valid token or EOS by postcondition.
//   AppendConstrainedToken extends currentConstrainedOut with a valid-next token,
//   preserving IsValidPrefix. CloseConstrainedSpan requires IsCompletePrefix
//   (which implies IsValidPrefix) and sets insideConstrainedOut := false,
//   making the implication vacuous. CloseSpanWithinBudget guarantees
//   insideOut ==> IsValidPrefix(currentOut) by its postcondition.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan: steps += 1, generated gets +1 token ("<<"). 
//   Each constrained step body: steps += 1, AppendConstrainedToken adds
//   at most 1 token. ScaleAllLogits costs 0 tokens.
//   CloseConstrainedSpan: steps += 1, generated gets +1 token (">>").
//   CloseSpanWithinBudget: steps := maxSteps (we set this), and by its
//   postcondition |generatedOut| <= |generated| + closeBudget <= |generatedPrefix| + maxSteps.
//   All branches: |generated| - |generatedPrefix| <= steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate ONE valid SMILES string for a chain_extender molecule. Chain extenders are small bifunctional molecules (diols or diamines) used in polyurethane synthesis. They must have 2 functional groups. Generate a LONGER, MORE COMPLEX molecule (at least 6-10 heavy atoms). Examples of valid chain extenders with longer chains: OCCCCCCO (1,6-hexanediol), NCCCCCCN (1,6-hexanediamine), OCCCO (1,3-propanediol), OCC(CO)CO (trimethylolpropane), OCCO (ethylene glycol), NCCN (ethylenediamine), OCC(C)(C)CO (neopentyl glycol), NC1CCCCC1N (1,2-diaminocyclohexane), OCCNCC (N-methyldiethanolamine), NC(CO)CO (serinol). Prefer generating molecules with 5-10 carbons and ether/amine linkages. Output ONLY the SMILES string with no other text.");

var steps: nat := 0;
// Minimum span length to prevent tiny trivial SMILES
var minSpanLength: nat := 6;

// Open constrained span
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Main constrained generation loop
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength && steps + 1 <= maxSteps {
    // Close span when we have a complete parse and sufficient length
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;

    // Flatten logit distribution to encourage diversity
    helpers.ScaleAllLogits(lm, 0.5);

    // Rotate through different stepping strategies for diversity
    var spanLen := |currentConstrainedOut|;
    if spanLen == 0 {
      // First token: use soft constrained step to get diverse starts
      var ns, ok := helpers.SafeSoftConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, 6.0, eosToken);
      next := ns;
    } else if spanLen < 3 {
      // Early tokens: use adaptive with group boosts
      next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 20, eosToken);
    } else if spanLen % 3 == 0 {
      // Every 3rd token: use repetition penalty to avoid loops
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.5, eosToken);
    } else {
      // Default: adaptive constrained step
      next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 16, eosToken);
    }
    steps := steps + 1;

    if next == eosToken {
      // If we hit EOS but have a complete, long-enough parse, close the span
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Fallback: use CloseSpanWithinBudget to close any open span
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

