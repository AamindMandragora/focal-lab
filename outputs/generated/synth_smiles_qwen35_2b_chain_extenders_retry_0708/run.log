Strategy: // CSD_RATIONALE_BEGIN
// Root cause: All 50 runs produce the same molecule. "Unique valid: 1/50" means
// the LM is completely stuck on its modal output (likely "OCCO" or "NCCN").
// Neither repetition penalty on `generated` nor AdaptiveConstrainedStep with
// moderate boost is enough to escape the model's strong prior.
//
// Key insight: The model is generating SMILES inside a constrained span. The
// constrained span uses "<<" and ">>" delimiters but the task expects BARE SMILES.
// The evaluator extracts content BETWEEN "<<" and ">>" for evaluation.
// The issue is that the model always picks the same first token (e.g., "O" or "N")
// because it always gets the same prompt context.
//
// New strategy to force diversity:
// 1. Use ConstrainedGeneration helper directly - it runs a full constrained loop
//    from an empty prefix. This is the cleanest approach.
// 2. Vary the guidance text to push toward different structural motifs each time.
//    The model's guidance is the main lever for diversity since the LM weights are fixed.
// 3. Use aggressive penalization of the most common SMILES starters before generation.
//
// Actually the real issue: `OpenConstrainedSpan` appends "<<" and ">>" are
// VISIBLE in the generated output. The evaluator sees "<<OCCO>>" and extracts
// "OCCO". The 50 examples all get the same molecule because the LM generates
// deterministically (or near-deterministically) with the same context.
//
// The BEST lever we haven't fully used: ConstrainedGeneration starts from an
// empty prefix with NO span delimiters and returns bare constrained text.
// Then we use the result as our generated output directly.
//
// BUT: The invariants require we manage generated/insideConstrainedOut etc.
//
// Alternative: Use GenerateWithManagedSpan which handles all span management.
// It uses AdaptiveConstrainedStep internally. The key question is: can we
// make it produce DIFFERENT outputs across 50 runs?
//
// With a deterministic LM the answer is NO without logit manipulation.
// The key: use PenalizeTokenLogits to penalize the most common SMILES tokens
// BEFORE calling generation helpers, forcing the model to explore alternatives.
//
// NEW APPROACH:
// 1. Compute a "run ID" proxy by examining which tokens have been generated
//    (they're all the same across runs so this won't work).
// 2. Instead: use the fact that the evaluator runs 50 independent examples.
//    Each example should get different output. The only lever is logit manipulation.
// 3. Penalize "O" and "N" heavily so the model must pick different first tokens.
//    Then penalize single-char atoms so we get longer, more complex molecules.
// 4. Use ConstrainedGeneration with maxSteps=200 to get a full molecule.
//
// Wait - if we penalize O and N the parser may still complete on C atoms.
// Chain extenders need O or N (they're diols/diamines). We can't penalize them
// completely or we'll get non-chain-extender molecules.
//
// REAL FIX: Use ScaleAllLogits to flatten the distribution before generation,
// then use SafeSoftConstrainedStep which boosts valid tokens softly.
// A flatter distribution means more diverse sampling.
//
// PLAN:
// 1. ScaleAllLogits with a small scalar (< 1.0) to flatten the distribution.
// 2. Open span, then use SafeSoftConstrainedStep for the first few tokens.
// 3. Then use AdaptiveConstrainedStep for the rest.
// 4. Enforce minimum length of 4 constrained tokens before close.
// 5. Use CloseSpanWithinBudget as fallback.
//
// ScaleAllLogits by 0.3 before each generation step will make sampling much
// more uniform, forcing different outputs across runs.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   OpenConstrainedSpan sets currentConstrainedOut := [] (valid prefix by precondition).
//   SafeSoftConstrainedStep and AdaptiveConstrainedStep both return EOS or a
//   parser-valid next token (by their postconditions). AppendConstrainedToken
//   extends currentConstrainedOut preserving IsValidPrefix. CloseConstrainedSpan
//   sets insideConstrainedOut := false making the implication vacuous.
//   CloseSpanWithinBudget guarantees insideConstrainedOut ==> IsValidPrefix(currentOut).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan: +1 step, +1 token. Each constrained step: +1 step,
//   AppendConstrainedToken adds at most 1 token. CloseConstrainedSpan: +1 step,
//   +1 token. ScaleAllLogits costs 0. CloseSpanWithinBudget: at most
//   closeBudget steps, we set steps := maxSteps after. All branches maintain
//   |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate a single valid SMILES string for a chain_extender molecule. Chain extenders are bifunctional molecules used in polyurethane synthesis. Valid examples include: NCCO (ethanolamine), NCCCO (3-aminopropanol), NCCCCN (putrescine/1,4-diaminobutane), OCC(C)CO (1,2-propanediol), OCCC(C)O, OCCCO (1,3-propanediol), OCCOCCO (diethylene glycol), NCCNCC, NC(C)CN, OCCN, NCCN (ethylenediamine). Output ONLY the SMILES string.");

var steps: nat := 0;
var minSpanLength: nat := 3;

// Open constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Main constrained generation loop
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;

    // Scale logits to flatten distribution for diversity before each step
    helpers.ScaleAllLogits(lm, 0.4);

    // Use SafeSoftConstrainedStep for first few tokens, then adaptive
    if |currentConstrainedOut| < 2 {
      var ns, ok := helpers.SafeSoftConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, 8.0, eosToken);
      next := ns;
    } else if |currentConstrainedOut| % 2 == 0 {
      next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, 16, eosToken);
    } else {
      next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
    }
    steps := steps + 1;

    if next == eosToken {
      if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minSpanLength && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Fallback: close within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

