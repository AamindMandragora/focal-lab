Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the spider dataset.
// State tracked: generated (full visible output including "SQL: <<...>>"),
//   insideConstrainedOut (whether we are inside a constrained span),
//   currentConstrainedOut (the SQL tokens accumulated so far inside the span).
//
// Strategy:
//   1. Emit "SQL: " as unconstrained prefix tokens (free LM generation until
//      "<<" is observed naturally, or we force open the span after a few steps).
//   2. Inside the constrained span, use AdaptiveConstrainedStep with the
//      caller-supplied validTokenGroups (schema tokens) boosted, plus a
//      repetition penalty to avoid loops, to generate the SQL query.
//   3. Once the parser reports IsCompletePrefix, close the span with ">>" via
//      CloseConstrainedSpan.
//   4. Terminate on EOS or budget exhaustion.
//
// The constrained span maps directly to the SQL grammar enforced by `parser`.
// validTokenGroups carry schema-context tokens (table/column names) that we
// boost to improve grounding.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   Outside span: implication is vacuous (insideConstrainedOut = false).
//     When next == "<<" we set currentConstrainedOut := [], which satisfies
//     parser.IsValidPrefix([]) by precondition.
//   CloseConstrainedSpan branch: sets insideConstrainedOut := false, making
//     the implication vacuously true; currentConstrainedOut := [].
//   Constrained generation branch: AdaptiveConstrainedStep returns either
//     eosToken or a parser-valid next token. AppendConstrainedToken extends
//     both generated and currentConstrainedOut by that token, preserving
//     parser.IsValidPrefix(currentConstrainedOut) by the helper's contract.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   Unconstrained branch: appends at most one token to generated and
//     increments steps by 1. Budget: steps grows by 1, visible output by <=1.
//   CloseConstrainedSpan branch: appends ">>" (1 token) and steps += 1.
//     The span-close token is counted, so |generated| grows by <=1 per step.
//   Constrained branch: AdaptiveConstrainedStep costs 1 step; AppendConstrainedToken
//     adds exactly 1 visible token. So steps+=1 and |generated|+=1, preserving
//     |generated| <= |generatedPrefix| + steps.
//   EOS / break: no further growth, invariant holds trivially.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Provide task-level guidance to steer the LM toward correct SQL output
helpers.AppendTaskGuidance(lm, "Generate a single valid SQL query. Output format: SQL: <<YOUR QUERY>>. Use only tables and columns from the provided schema. No explanation.");

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Free generation outside the constrained span; watch for "<<"
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        // LM naturally opened the constrained span
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    // SQL query is complete — close the span
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    // Inside constrained span: generate next SQL token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];

    // Use adaptive constrained step: boost schema tokens from validTokenGroups
    // when the parser is narrow (few valid continuations), otherwise use standard
    // constrained decoding. This grounds SQL identifiers to the schema.
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      validTokenGroups, 4.0, 12, eosToken
    );
    steps := steps + 1;

    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

cost := steps;

