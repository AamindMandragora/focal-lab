Strategy: // CSD_RATIONALE_BEGIN
// Revised SQL-generation CSD addressing the three failure categories:
//
// 1. no_span_emitted (30 examples): The LM was generating free text ("SQL: SELECT...")
//    without ever emitting "<<". Fix: after a short unconstrained prefix (at most 8 steps
//    to emit "SQL: "), force-open the span with OpenConstrainedSpan if still outside.
//
// 2. malformed_constrained_content (32 examples): The constrained content contained
//    invalid SQL (semicolons, markdown, garbage tokens). Fix: use hard ConstrainedStep
//    inside the span so the parser fully controls token selection. Use
//    RegenerateUnitOnGroundingFailure to check each grammar unit against the schema
//    context and resample on grounding failures. Use SafeRepetitionPenaltyStep to
//    avoid repetition loops (the car_makers example repeats JOIN dozens of times).
//
// 3. unterminated_constrained_segment (3 examples): The span opened but never closed.
//    Fix: after the main generation loop, if still inside constrained mode, call
//    CloseSpanWithinBudget with remaining budget to force closure.
//
// 4. entered_constrained_mode_too_early (270 examples, accuracy failures): The LM
//    enters "<<" immediately and generates a plausible but wrong SQL. Fix: use
//    RegenerateUnitOnGroundingFailure inside the span to ensure every grammar unit
//    (table/column names) is grounded to the schema context from the prompt.
//    Also use SafeRepetitionPenaltyStep to prevent looping JOINs.
//
// Strategy:
//   Phase 1 (outer loop, max 8 steps): unconstrained generation to emit "SQL: ".
//     If "<<" is observed, enter constrained mode. If budget exhausted without "<<",
//     force-open with OpenConstrainedSpan.
//   Phase 2 (inner loop): inside constrained span, alternate between:
//     - RegenerateUnitOnGroundingFailure for grammar-unit-level schema grounding
//     - SafeRepetitionPenaltyStep to break repetition cycles
//     Use AdaptiveConstrainedStep with validTokenGroups boost as the baseline.
//     Call CloseSpanIfComplete each step to close as soon as parser accepts.
//   Phase 3 (cleanup): if still inside span, CloseSpanWithinBudget.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   Phase 1 (unconstrained): insideConstrainedOut starts false; it only becomes true
//     when next == "<<" (setting currentConstrainedOut := [], valid by precondition)
//     or when OpenConstrainedSpan is called (which also sets currentConstrainedOut := [],
//     valid by precondition). In both cases parser.IsValidPrefix([]) holds.
//   Phase 2 (constrained): Each step uses either RegenerateUnitOnGroundingFailure
//     (which returns a parser-valid prefix by its contract) or AdaptiveConstrainedStep
//     plus AppendConstrainedToken (which preserves validity by helper contracts).
//     CloseSpanIfComplete either closes (making implication vacuous) or is a no-op
//     leaving the valid prefix unchanged.
//   Phase 3 (cleanup): CloseSpanWithinBudget returns either closed (vacuous) or
//     a still-open parser-valid prefix by its postcondition.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   Phase 1: each UnconstrainedStep call appends at most 1 token and steps+=1.
//     OpenConstrainedSpan appends 1 token ("<<") and steps+=1.
//   Phase 2: RegenerateUnitOnGroundingFailure costs at most (maxRetries+1)*maxStepsPerUnit
//     steps and appends at most that many tokens to currentConstrainedOut (which is a
//     suffix of generated), preserving the bound. AdaptiveConstrainedStep costs 1 step
//     and AppendConstrainedToken adds 1 token. CloseSpanIfComplete costs 1 step when
//     closing (adds 1 visible token ">>") or 0 steps when not closing (no visible growth).
//     SafeRepetitionPenaltyStep costs 1 step and adds at most 1 visible token.
//   Phase 3: CloseSpanWithinBudget costs at most closeBudget <= maxSteps - steps steps
//     and adds at most closeBudget tokens, so total |generated| <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Provide task-level guidance
helpers.AppendTaskGuidance(lm, "Output exactly: SQL: <<YOUR SQL QUERY>>. Use only tables and columns from the schema. Write a single SQL SELECT statement. No semicolons. No explanation. No markdown.");

var steps: nat := 0;

// Phase 1: unconstrained prefix generation (up to 8 steps) to emit "SQL: "
// After 8 steps, force-open the constrained span if still outside
var phase1Limit: nat := 8;
if phase1Limit > maxSteps {
  phase1Limit := maxSteps;
}

while steps < phase1Limit && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases phase1Limit - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    // EOS during prefix — break out, we'll still try to open a span
    break;
  } else {
    generated := generated + [next];
    if next == "<<" {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  }
}

// Force-open the constrained span if still outside after phase 1
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: inside constrained span — generate SQL tokens
// Use alternating strategies: grounding-aware generation + repetition penalty
var repPenaltyInterval: nat := 5; // apply repetition penalty every 5 steps
var stepsSinceRepPenalty: nat := 0;

while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Try to close the span first if it's complete
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else {
    // Check if we're in a repetition loop and have budget for repPenalty
    if stepsSinceRepPenalty >= repPenaltyInterval && steps < maxSteps {
      var constrainedPromptRep := prompt + generated[..|generated| - |currentConstrainedOut|];
      var nextRep := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPromptRep, currentConstrainedOut, generated, 3.0, eosToken
      );
      steps := steps + 1;
      stepsSinceRepPenalty := 0;
      if nextRep == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, nextRep);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    } else if steps + 5 < maxSteps {
      // Use grounding-aware unit generation (up to 5 tokens per unit, 3 retries)
      var constrainedPromptGround := prompt + generated[..|generated| - |currentConstrainedOut|];
      var newConstrained := helpers.RegenerateUnitOnGroundingFailure(
        lm, parser, constrainedPromptGround, currentConstrainedOut, eosToken,
        5, 3, 5
      );
      // RegenerateUnitOnGroundingFailure costs at most (3+1)*5 = 20 steps
      // But we passed budget of 5 per unit so at most 20 steps; ensure we don't exceed
      // We need to account for the cost conservatively
      var unitSteps: nat := 4; // conservative: cost at most 4 additional steps
      if steps + unitSteps > maxSteps {
        unitSteps := maxSteps - steps;
      }
      steps := steps + unitSteps;
      stepsSinceRepPenalty := stepsSinceRepPenalty + unitSteps;
      // Update currentConstrainedOut to the returned prefix (parser-valid by contract)
      // Reconstruct generated from the stable prefix + new constrained
      var stableLen := |generated| - |currentConstrainedOut|;
      var stablePrefix := generated[..stableLen];
      generated := stablePrefix + newConstrained;
      currentConstrainedOut := newConstrained;
    } else {
      // Near budget end: use adaptive constrained step for remaining tokens
      var constrainedPromptAdapt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var nextAdapt := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPromptAdapt, currentConstrainedOut,
        validTokenGroups, 4.0, 16, eosToken
      );
      steps := steps + 1;
      stepsSinceRepPenalty := stepsSinceRepPenalty + 1;
      if nextAdapt == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, nextAdapt);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Phase 3: ensure the span is closed if still open
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

