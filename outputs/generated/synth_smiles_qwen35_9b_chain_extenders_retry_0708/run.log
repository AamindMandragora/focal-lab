Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis: The previous attempt scored 2% accuracy with 100% syntax and
// "unique valid molecules: 1/50". The problem is degeneracy - the model keeps
// generating the same molecule (likely ethylene glycol or a simple exemplar).
// The "tiny-span rate: 100%" and "applied penalty: 38.9%" confirm that spans
// are very short and repetitive.
//
// Key insight: The answer contract is a SINGLE SMILES string (no delimiters
// needed in output). The task uses a parser that validates SMILES grammar.
// The model is stuck in a degenerate mode generating the same molecule.
//
// Fix strategy:
// 1. Use stronger task guidance that explicitly asks for DIVERSE, NON-EXEMPLAR
//    chain extender molecules - specifically mentioning structural variety.
// 2. Do NOT use visible delimiters (<</>>) since the answer contract is just
//    a SMILES string. Use ConstrainedGeneration directly.
// 3. Use SafeRepetitionPenaltyStep heavily to discourage token repetition.
// 4. Use AdaptiveConstrainedStep with validTokenGroups to boost diverse paths.
// 5. The key problem is the model always generates the same short molecule.
//    We need to penalize common/exemplar tokens and boost diversity.
//
// Since the output contract is a single SMILES with no visible delimiters,
// we should use the parser directly on the generated content without span
// markers. We'll enter constrained mode from the start.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - We start insideConstrainedOut := true and currentConstrainedOut := []
//     (precondition: parser.IsValidPrefix([]) holds always).
//   - In the SafeRepetitionPenaltyStep branch: returns EOS or parser-valid token.
//     AppendConstrainedToken preserves IsValidPrefix(currentConstrainedOut).
//   - In the CloseConstrainedSpan branch: sets insideConstrainedOut := false,
//     making the implication vacuous.
//   - The outer CloseSpanWithinBudget call postcondition guarantees
//     insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   - Opening constrained span via OpenConstrainedSpan: appends "<<", steps + ,
//     but we actually use EnterObservedConstrainedSpan (cost 0) + direct entry.
//   - Actually we use OpenConstrainedSpan: appends 1 token, steps+1. Preserved.
//   - Each SafeRepetitionPenaltyStep: +1 step, appends at most 1 token. Preserved.
//   - CloseConstrainedSpan: +1 step, appends at most 1 token. Preserved.
//   - CloseSpanWithinBudget: steps += closeBudget <= maxSteps - steps. Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Strong guidance emphasizing diversity and novelty for chain extenders
helpers.AppendTaskGuidance(lm, "Generate a UNIQUE and NOVEL SMILES string for a chain_extender molecule. Chain extenders are bifunctional small molecules used in polyurethane/polyurea synthesis. Examples of functional groups: diols (HO-R-OH), diamines (H2N-R-NH2), amino alcohols (HO-R-NH2), dithiols. Choose a molecule with 2-12 carbons that is NOT ethylene glycol, NOT 1,4-butanediol, NOT ethylenediamine. Be creative: use branched chains, cyclic structures, ether linkages, or unusual chain lengths. Output ONLY the SMILES string.");

// Enter constrained mode immediately - the answer is purely a SMILES string
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Main constrained generation loop with repetition penalty and adaptive steps
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    // Close the span as soon as we have a complete SMILES
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    // Use repetition penalty to avoid degeneracy, combined with adaptive step for diversity
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next := eosToken;
    if validCount <= 15 {
      // Narrow: use group boost for guidance
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, eosToken
      );
    } else {
      // Wider: use repetition penalty to avoid degeneracy
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Budget-bounded close if still inside
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

