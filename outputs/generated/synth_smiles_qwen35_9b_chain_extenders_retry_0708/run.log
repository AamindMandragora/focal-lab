Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis: Accuracy is stuck at 4% (2 unique valid molecules out of 50).
// The "Samples to 100 unique valid (cap 1000): 1000" and "Unique valid molecules: 2/50"
// confirm that despite 100% syntax and 100% membership, the model generates essentially
// the same 2 molecules repeatedly.
//
// Root cause analysis:
// 1. The model is extremely confident about generating one or two specific molecules
//    (likely OCCO / ethylene glycol and one other common chain extender).
// 2. The "Applied penalty: 1.0%" in the last attempt means the repetition penalty
//    is barely doing anything - the model keeps choosing non-penalized tokens anyway.
// 3. The diversity metric is 0.59 (decent) but only between 2 unique molecules.
// 4. "Max-steps hit rate: 0.0%" means molecules complete well within budget.
// 5. The span approach (<<>>) extracts the constrained content between delimiters.
//    The extracted content IS the SMILES.
//
// The key problem: The constrained generation with repetition penalty isn't working
// because the penalty only applies to tokens already in `generated`, but `generated`
// includes the `<<` token, not the SMILES tokens themselves. Each run the model
// freshly picks the most probable SMILES tokens with no memory of past runs.
//
// Solution approach - RADICALLY different strategy:
// 1. Use UNCONSTRAINED generation first (no << >> delimiters) since the output
//    contract is "a single SMILES string and nothing else."
// 2. BUT actually - looking at the problem: the evaluator extracts between << and >>
//    (based on "Delimiter churn ratio: 0.028"). Wait - "delimiter churn ratio" means
//    the evaluator IS using delimiters. Let me reconsider.
// 3. Looking at "visible_span_without_activity 0/50" and "examples_with_activity 50/50":
//    the constrained spans are being used and recognized.
//
// The real fix: The diversity must be FORCED through the generation process itself.
// We need to:
// (a) Use ScaleAllLogits to flatten the distribution before each step (increase temperature)
// (b) Strongly penalize the most likely first tokens of common molecules
// (c) Use SafePenalizeTokenLogits to discourage "O" as first token (most exemplars start with O)
// (d) Boost heteroatoms N and S at the start to steer away from pure diols
// (e) Most importantly: scale logits DOWN (temperature ~0.3x scale = temperature ~3x)
//     so the distribution is FLAT and diverse choices get selected
//
// Key insight: ScaleAllLogits with a value < 1.0 FLATTENS the distribution,
// effectively increasing temperature. This is the key tool for diversity.
// We should call ScaleAllLogits(lm, 0.2) before each constrained step to get
// high-diversity, uniform-ish sampling over valid tokens.
//
// Actually wait - ScaleAllLogits scales by scalar, so 0.2 means logits become 0.2*logit.
// If logits are positive, this brings them closer to 0 (flatter = higher temperature).
// But if logits are negative, this makes them more negative (also flatter distribution if softmax).
// The effect is: lower scale = flatter softmax = more diversity.
//
// Plan:
// 1. AppendTaskGuidance with diverse templates
// 2. OpenConstrainedSpan
// 3. In the loop: ScaleAllLogits(0.15) before each step + SafeRepetitionPenaltyStep
//    The flattened distribution will cause different tokens to be selected each run
//    because even small random variations in the model output will dominate
// 4. Penalize "O" at position 0 to avoid all molecules starting with O
// 5. Boost "N", "S", "c", "[NH2]", etc. at early positions
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - Start: currentConstrainedOut := currentConstrained; precondition guarantees
//     insideConstrained ==> parser.IsValidPrefix(currentConstrained).
//   - OpenConstrainedSpan: sets insideConstrainedOut := true, currentConstrainedOut := [];
//     parser.IsValidPrefix([]) holds by precondition.
//   - ScaleAllLogits: +0 cost, no state change, validity preserved.
//   - SafePenalizeTokenLogits: +0 cost, no state change, validity preserved.
//   - SafeBoostTokenLogits: +0 cost, no state change, validity preserved.
//   - SafeRepetitionPenaltyStep: returns EOS or parser-valid next token;
//     AppendConstrainedToken extends currentConstrainedOut preserving IsValidPrefix.
//   - ConstrainedStep: returns EOS or parser-valid next token; same as above.
//   - CloseConstrainedSpan: sets insideConstrainedOut := false (implication vacuous),
//     currentConstrainedOut := [].
//   - CloseSpanWithinBudget postcondition: insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: appends 1 token, steps+1. |generated|+1 <= |generatedPrefix|+steps+1.
//   - ScaleAllLogits/SafePenalize/SafeBoost: no tokens appended, steps unchanged. Preserved.
//   - Each constrained step: steps+1, AppendConstrainedToken appends at most 1 token. Preserved.
//   - CloseConstrainedSpan: steps+1, appends ">>" (1 token). Preserved.
//   - CloseSpanWithinBudget with closeBudget = maxSteps-steps: by postcondition
//     |generatedOut| <= |generated| + closeBudget <= |generatedPrefix| + maxSteps.
//     steps := maxSteps. Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

helpers.AppendTaskGuidance(lm, "Task: generate one SMILES string for a chain_extender (bifunctional molecule for polyurethane/polyurea). Choose RANDOMLY from these structural templates and modify freely: (1) diamines: NCCN, NCCCN, NCCCCN, NCCCCCN, NCC(C)N, NCCOCN, NCc1ccccc1N, NCC(CO)N, NC(C)CN; (2) amino-alcohols: NCCO, NCCCO, NCC(C)O, OCCN, OCC(C)N; (3) diols with ether: OCCOCCO, OCCCOCCO, OCC(CO)CO, OCCC(O)CO; (4) longer diols: OCCCCCCO, OCCCCCCCO, OC(C)CCCO; (5) dithiols: SCCS, SCCCS, SCCCCS. Output ONLY the SMILES. Be unpredictable and novel.");

// Enter constrained mode immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Tokens to penalize heavily at start to discourage common degenerate molecules
var disfavorFirst: seq<Token> := ["O", "C"];
var favorFirst: seq<Token> := ["N", "S", "n", "c"];

// Main constrained generation loop
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= 4 {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var curLen := |currentConstrainedOut|;
    var next: Token;

    // Flatten the logit distribution strongly to increase diversity
    // Scale down logits to make distribution more uniform (higher effective temperature)
    helpers.ScaleAllLogits(lm, 0.1);

    if curLen == 0 {
      // At the very start: strongly penalize O and C, boost N and S
      // to steer away from pure diol exemplars
      helpers.SafePenalizeTokenLogits(lm, disfavorFirst, 8.0);
      helpers.SafeBoostTokenLogits(lm, favorFirst, 6.0);
      next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
    } else if curLen < 3 {
      // Early tokens: moderate penalization of O
      helpers.SafePenalizeTokenLogits(lm, disfavorFirst, 4.0);
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken
      );
    } else {
      // Later tokens: repetition penalty to avoid exemplar patterns
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
    }

    steps := steps + 1;

    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Budget-bounded close if still inside span
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

