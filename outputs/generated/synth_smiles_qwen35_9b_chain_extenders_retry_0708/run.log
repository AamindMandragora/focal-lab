Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis: The model has 100% syntax, 100% membership, but only 2 unique valid molecules
// out of 50 examples. The accuracy metric is "unique_valid_rate_rdkit" = distinct valid
// in-class non-exemplar molecules / N. With only 2 unique molecules, accuracy = 2/50 = 4%.
//
// The core problem: The model keeps generating the SAME molecule repeatedly despite
// repetition penalties. The "applied penalty: 1.6%" in the last attempt shows very
// few examples were penalized at all - the model is just consistently choosing the
// same tokens every time.
//
// The visible delimiter approach (<<>>) is hurting us: the output extracted between
// << and >> is the constrained content, but the model is stubbornly converging to
// the same molecule. The guidance isn't diverse enough.
//
// Key insight: The model needs STRONG STRUCTURAL DIVERSITY. We should:
// 1. Use the AdaptiveConstrainedStepWithPenalties helper at each step with strong
//    penalties on the first tokens (to break degeneracy at the start)
// 2. Boost tokens that represent diverse structural elements: branches, heteroatoms
// 3. Use a temperature-scaled approach for the first few tokens (most crucial for diversity)
// 4. Keep minimum token count at ~6+ to prevent trivially short molecules
// 5. The guidance should list MANY different possible structures to give the model
//    diverse starting points
//
// Anti-degeneracy plan:
// - Penalize "O" as first token (ethylene glycol starts with O)  
// - Boost "N", "C", branching tokens at start
// - Use SafeRepetitionPenaltyStep with high penalty (5.0) throughout
// - Use TemperatureConstrainedStep with high temperature (1.5) for first ~5 tokens
// - Require minimum 8 tokens before closure
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - Start: insideConstrainedOut := insideConstrained, currentConstrainedOut := currentConstrained.
//     Precondition guarantees insideConstrained ==> parser.IsValidPrefix(currentConstrained).
//   - OpenConstrainedSpan: sets insideConstrainedOut := true, currentConstrainedOut := [],
//     and [] is valid by precondition parser.IsValidPrefix([]).
//   - TemperatureConstrainedStep / AdaptiveConstrainedStepWithPenalties / SafeRepetitionPenaltyStep:
//     each returns EOS or a parser-valid next token. AppendConstrainedToken extends
//     currentConstrainedOut by one valid token, preserving IsValidPrefix.
//   - CloseConstrainedSpan: sets insideConstrainedOut := false (implication vacuous),
//     currentConstrainedOut := [].
//   - CloseSpanWithinBudget postcondition: insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: appends 1 token ("<<"), steps := steps + 1. Preserved.
//   - Each constrained step: steps + 1, AppendConstrainedToken appends at most 1 token.
//     So |generated| grows by at most 1 while steps grows by exactly 1. Preserved.
//   - CloseConstrainedSpan: steps + 1, appends ">>" (1 token). Preserved.
//   - CloseSpanWithinBudget with closeBudget = maxSteps - steps: by postcondition
//     |generatedOut| <= |generated| + closeBudget <= |generatedPrefix| + steps +
//     (maxSteps - steps) = |generatedPrefix| + maxSteps. steps := maxSteps. Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Very diverse guidance listing many different structural classes
helpers.AppendTaskGuidance(lm, "Generate a NOVEL, UNIQUE SMILES for a chain_extender molecule (bifunctional: diol, diamine, amino-alcohol, or dithiol for polyurethane/polyurea synthesis). Required: output ONLY the SMILES. The molecule MUST be different each time - vary chain length, branching, heteroatoms, and functional groups. Possible templates: OCCO, OCCCO, OCCCCO, OCCO, OCC(C)CO, OCC(CO)CO, OCCOCCO, OCC(N)CO, NCCN, NCCCN, NCCCCN, NCC(C)N, NCCOCN, NCc1ccccc1N, NCCO, NCCCO, NCCCCCO, SCC(S)S, OCCS, OCCCS. Pick a structure that is NOT the most common exemplars. Add side chains, ether oxygens, or extra carbons for novelty.");

// Enter constrained mode immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Token-based anti-degeneracy tokens to penalize at each step
var penaltyTokens: seq<Token> := ["O", "C"];

// Minimum token count before allowing closure
var minLen: nat := 6;

// Main constrained generation loop
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  }

  // Allow closure only after minimum token count
  if |currentConstrainedOut| >= minLen && parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  }

  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  var next := eosToken;

  var curLen := |currentConstrainedOut|;

  if curLen < 4 {
    // First few tokens: use temperature to break degeneracy
    next := helpers.TemperatureConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, 1.8, eosToken
    );
  } else if curLen < 8 {
    // Middle tokens: adaptive with penalties on common degenerate tokens
    next := helpers.AdaptiveConstrainedStepWithPenalties(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      validTokenGroups, 3.0, penaltyTokens, 3.0, 10, eosToken
    );
  } else {
    // Later tokens: repetition penalty to avoid copying exemplars
    next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, generated, 4.0, eosToken
    );
  }

  steps := steps + 1;

  if next == eosToken {
    break;
  } else {
    var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
    generated := ag;
    insideConstrainedOut := ai;
    currentConstrainedOut := ac;
  }
}

// Budget-bounded close if still inside span
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

