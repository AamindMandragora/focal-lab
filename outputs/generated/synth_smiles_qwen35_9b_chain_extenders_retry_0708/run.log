//   |generated| = |generatedPrefix| + 1 = |generatedPrefix| + steps. Preserved.
//
// SafeSoftConstrainedStep + AppendConstrainedToken (non-EOS):
//   |generated| grows by exactly 1, steps grows by 1. Preserved.
//
// SafeRepetitionPenaltyStep + AppendConstrainedToken (non-EOS):
//   |generated| grows by exactly 1, steps grows by 1. Preserved.
//
// EOS branch: steps += 1, |generated| unchanged. |generated| <= |generatedPrefix| + steps. Preserved.
//
// CloseConstrainedSpan: appends ">>" (1 token), steps += 1.
//   |generated| grows by 1, steps grows by 1. Preserved.
//
// RollbackConstrainedToComplete: |generatedOut| <= |generated| (rollback only shrinks).
//   steps unchanged at that point. Preserved.
//
// CloseConstrainedSpan after rollback: steps < maxSteps guard ensures steps + 1 <= maxSteps.
//   |generated| grows by 1, steps grows by 1. Preserved.
//
// Loop termination: steps strictly increases by 1 each iteration (every branch).
//   Bounded by maxSteps. Loop terminates.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Strong guidance emphasizing bifunctionality and minimum chain length
helpers.AppendTaskGuidance(lm, "Generate one valid SMILES for a chain_extender. Chain extenders MUST be bifunctional with exactly two functional groups. Examples: OCCCCO (1,4-butanediol), OCCCCCO (1,5-pentanediol), OCCCCCCO (1,6-hexanediol), NCCCCN (1,4-butanediamine), NCCCCCN (1,5-pentanediamine), OCC(CO)CO (trimethylolpropane-like), NCC(N)C (branched diamine), OCC(C)(CO)CC (neopentyl glycol type), OCCN (ethanolamine), OCCCN (3-aminopropanol). Choose a DIVERSE structure with 4-8 carbons in the chain. Output ONLY the SMILES string.");

// Enter constrained span
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Main generation loop with diversity-focused strategy
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= 6 {
    // Close once we have a complete and sufficiently long SMILES (>= 6 tokens ensures bifunctionality)
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var curLen := |currentConstrainedOut|;
    var next: Token;
    if curLen < 12 {
      // Soft constrained step for stochastic diversity in early/mid tokens
      var nextSoft, softOk := helpers.SafeSoftConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 8.0, eosToken
      );
      next := nextSoft;
    } else {
      // Repetition penalty for diversity in later tokens
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 4.0, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// If still inside span, rollback to complete and close (avoids tiny-span issue from CloseSpanWithinBudget)
if insideConstrainedOut && steps < maxSteps {
  // Rollback to the last complete parse point
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
  // Only close if we have a complete parse AND sufficient length
  if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= 6 && steps < maxSteps {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else if insideConstrainedOut && steps < maxSteps {
    // Last resort: use CloseSpanWithinBudget with remaining budget
    var closeBudget := maxSteps - steps;
    var cg, ci, cc := helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
    );
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := maxSteps;
  }
}

cost := steps;

