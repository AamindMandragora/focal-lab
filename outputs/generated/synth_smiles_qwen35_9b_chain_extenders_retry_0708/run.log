Strategy: // CSD_RATIONALE_BEGIN
// SMILES-constrained CSD for chain_extenders class.
// State tracked: generated (full visible output), insideConstrainedOut (whether
// inside a constrained span), currentConstrainedOut (SMILES tokens accumulated
// so far in the span), steps/cost.
//
// Strategy:
// 1. Append task guidance to steer the LM toward valid chain_extender SMILES.
// 2. Open a constrained span immediately (no free preamble needed - the answer
//    contract is a single SMILES string).
// 3. Inside the span, use AdaptiveConstrainedStep with repetition penalty to
//    generate a valid SMILES molecule. The adaptive step uses group boosts when
//    the parser branching is narrow, helping guide through SMILES grammar.
// 4. Once the parser reports a complete prefix, close the span.
// 5. Stop on EOS or budget exhaustion.
//
// Chain extenders are typically small bifunctional molecules (diols, diamines,
// amino alcohols) used in polyurethane synthesis. We use SafeRepetitionPenaltyStep
// to encourage structural diversity and avoid repeating the same tokens.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - In the span-open branch: We call OpenConstrainedSpan which sets
//     insideConstrainedOut := true and currentConstrainedOut := []. The empty
//     prefix is always valid (precondition parser.IsValidPrefix([])), so the
//     invariant is preserved.
//   - In the CloseConstrainedSpan branch: CloseConstrainedSpan sets
//     insideConstrainedOut := false, making the implication vacuous. Preserved.
//   - In the constrained-step branch: SafeRepetitionPenaltyStep returns either
//     EOS (we break without appending) or a parser-valid next token.
//     AppendConstrainedToken then extends currentConstrainedOut with that token,
//     which by the helper's postcondition preserves parser.IsValidPrefix.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan appends exactly one token ("<<") and increments steps
//     by 1, so the bound is preserved.
//   - CloseConstrainedSpan appends exactly one token (">>") and increments steps
//     by 1, so the bound is preserved.
//   - SafeRepetitionPenaltyStep costs +1 step. On EOS we break without appending.
//     On a valid token, AppendConstrainedToken appends exactly one token to
//     generated, so |generated| grows by 1 and steps grows by 1. Bound preserved.
//   - All other branches (cost-0 helpers) do not change generated or steps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

helpers.AppendTaskGuidance(lm, "Generate a single valid SMILES string for a chain_extender molecule. Chain extenders are small bifunctional molecules such as diols (e.g., ethylene glycol), diamines, or amino alcohols used in polyurethane synthesis. Output only the SMILES string with no explanation, no brackets around the answer, no Markdown.");

// Phase 1: Open constrained span if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Generate constrained SMILES tokens
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed; we are done
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    // Close the span
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    // Generate next constrained token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// If still inside and budget remains, attempt to close
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

