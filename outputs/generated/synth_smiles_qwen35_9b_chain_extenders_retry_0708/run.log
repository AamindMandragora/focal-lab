Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis: All attempts score 2-4% accuracy with 100% syntax. The core problem
// is "unique valid molecules: 1-2/50" - extreme degeneracy. The model always generates
// the same short molecule (like "O" = water or "OCCO" = ethylene glycol).
//
// Key observations:
// 1. "Tiny-span rate: 100%" = the constrained spans are very short (1-3 tokens)
// 2. "Unique valid molecules: 1/50" = the model collapses to a single molecule
// 3. The model generates "O" (water/methanol) as seen in failing rollouts
// 4. The answer contract is a BARE SMILES string - no delimiters
// 5. The evaluator extracts the content between << and >> (hidden delimiters)
//
// Root cause of degeneracy: The parser accepts "O" as a complete SMILES
// (it IS valid - it's water). So the model immediately closes the span with "O".
//
// Fix strategy:
// 1. Use CraneGeneration which handles free text + constrained spans natively
//    and tends to generate longer, more complex outputs
// 2. Use extremely strong guidance that explicitly lists EXEMPLARS TO AVOID
//    and demands minimum length/complexity
// 3. Use GenerateWithPrefixAndManagedSpan to force the model into constrained
//    mode quickly with a short preamble budget
// 4. The key insight: we need the model to NOT immediately close with "O".
//    We should penalize the EOS token and "O" token early in generation.
// 5. Use SafeRepetitionPenaltyStep consistently throughout.
//
// The fundamental issue: when the parser sees "O" it is IsCompletePrefix==true,
// so any strategy that checks IsCompletePrefix immediately closes. We need to
// NOT close immediately and instead generate a longer molecule.
//
// New approach: Use OpenConstrainedSpan to enter constrained mode, but instead
// of checking IsCompletePrefix at each step, we generate a MINIMUM number of
// tokens before allowing closure. This prevents "O" from being accepted.
// After a minimum token count (e.g., 4-6 tokens), we then allow closure.
//
// We use SafeRepetitionPenaltyStep to prevent the same token from appearing
// twice, and we boost tokens from validTokenGroups to encourage diversity.
//
// The guidance will explicitly say "minimum 5 heavy atoms" and list exemplars
// to avoid (O, OCCO, NCCN, NCCO, etc.)
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - We enter constrained mode via OpenConstrainedSpan which sets
//     currentConstrainedOut := [] (valid by parser.IsValidPrefix([]) precondition).
//   - In the main loop before minTokens reached: we call AdaptiveConstrainedStep
//     which returns EOS or a parser-valid next token. AppendConstrainedToken
//     preserves parser.IsValidPrefix(currentConstrainedOut).
//   - In the main loop after minTokens reached: same helpers preserve validity.
//   - CloseConstrainedSpan: sets insideConstrainedOut := false, making the
//     implication vacuous, and sets currentConstrainedOut := [].
//   - CloseSpanWithinBudget postcondition guarantees
//     insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: appends 1 token ("<<"), steps+1. Preserved.
//   - Each AdaptiveConstrainedStep/SafeRepetitionPenaltyStep: +1 step,
//     AppendConstrainedToken appends 1 token. Net: steps+1, |generated|+1. Preserved.
//   - CloseConstrainedSpan: +1 step, appends ">>" (1 token). Preserved.
//   - CloseSpanWithinBudget with closeBudget = maxSteps - steps: by postcondition
//     |generatedOut| <= |generated| + closeBudget <= |generatedPrefix| + maxSteps.
//     steps := maxSteps. Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Guidance: explicitly enumerate exemplars to avoid, demand structural complexity
helpers.AppendTaskGuidance(lm, "Generate a NOVEL chain extender SMILES string. Chain extenders are bifunctional molecules (diols, diamines, or amino-alcohols) for polyurethane synthesis. STRICT RULES: (1) Must have AT LEAST 4 heavy atoms. (2) Must have exactly 2 functional end groups (OH, NH2, or SH). (3) DO NOT output: O, N, OCCO, NCCN, NCCO, OCC(O), OCCCCO, NCCCCN. (4) Use diverse structures: consider branched diols OCC(C)CO, aromatic OCc1ccccc1CO, ether diols OCCOCCO, cyclic NC1CCCCC1N, propylene glycol OCC(C)O, longer chains OCCCCCCO, fluorinated OCCF, or siloxane-linked. (5) Output ONLY the SMILES string, nothing else.");

// Enter constrained mode immediately (no free preamble - model should just output SMILES)
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Minimum tokens before allowing closure - prevents degenerate single-atom outputs
var minTokens: nat := 4;
var tokenCount: nat := 0;

// Main constrained generation loop
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  }

  // Only allow closure after minimum token count
  if tokenCount >= minTokens && parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  }

  // Generate next constrained token
  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  var next := eosToken;

  if tokenCount < minTokens {
    // Force longer generation - use adaptive step with group boost
    // Do NOT check for EOS completion; drive the model forward
    next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, 20, eosToken
    );
  } else {
    // After minimum tokens: use repetition penalty to avoid degeneracy
    next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.5, eosToken
    );
  }

  steps := steps + 1;

  if next == eosToken {
    break;
  } else {
    var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
    generated := ag;
    insideConstrainedOut := ai;
    currentConstrainedOut := ac;
    tokenCount := tokenCount + 1;
  }
}

// Budget-bounded close if still inside span
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

