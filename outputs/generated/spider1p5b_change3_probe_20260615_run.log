// SQL-generation CSD for Spider dataset.
// Strategy: use unconstrained generation until "<<" is observed, then use
// CloseSpanWithinBudget to fill in the constrained SQL and close the span.
// The key fix from the previous attempt is ensuring that the length postcondition
// |generated| <= |generatedPrefix| + maxSteps is maintained throughout.
// We avoid the problematic approach of manually updating steps after
// RegenerateUnitOnGroundingFailure (which had an unprovable length bound).
// Instead we use CloseSpanWithinBudget which has a verified length contract.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1 (unconstrained loop): insideConstrainedOut starts false, so
//   the implication is vacuous. When next == "<<", we set
//   currentConstrainedOut := [] which satisfies parser.IsValidPrefix([])
//   by the method precondition. Invariant maintained.
//   Phase 2 (CloseSpanWithinBudget): by its contract, returns
//   insideOut ==> parser.IsValidPrefix(currentOut). Invariant maintained.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: each UnconstrainedStep increments steps by 1 and appends at most
//   one token to generated (or breaks on EOS without appending). So
//   |generated| - |generatedPrefix| <= steps is maintained as a loop invariant.
//   Phase 2: CloseSpanWithinBudget uses closeBudget = maxSteps - steps steps,
//   and by its contract |generatedOut| <= |generated| + closeBudget. Since
//   |generated| <= |generatedPrefix| + steps, we get
//   |generatedOut| <= |generatedPrefix| + steps + (maxSteps - steps)
//                   = |generatedPrefix| + maxSteps.
//   We set steps := maxSteps after, so invariant holds at method exit.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a single valid SQL query. Output format: SQL: <<your SQL query here>>. Use only tables and columns from the provided schema. Do not include explanation or markdown.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Unconstrained generation until "<<" is observed
while steps < maxSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// Phase 2: Close the constrained span within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

