Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the Spider dataset.
// The strategy emits "SQL: " as free unconstrained tokens, then opens a
// constrained span "<<" and generates a valid SQL query under parser control.
// Inside the span, AdaptiveConstrainedStep is used with caller-provided
// validTokenGroups to boost schema-relevant tokens (table/column names) while
// maintaining hard parser validity. RepetitionPenalty is applied to discourage
// repeating already-generated tokens. CloseSpanIfComplete is checked each step
// to emit ">>" as soon as the parser accepts the span as complete.
// State tracked: generated (full output), insideConstrainedOut (span mode),
// currentConstrainedOut (active constrained prefix), steps (budget counter).
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside the span: implication is vacuous. When next == "<<",
//   currentConstrainedOut := [] which satisfies IsValidPrefix([]) by precondition.
//   CloseSpanIfComplete (closed path): sets insideConstrainedOut := false,
//   making the implication vacuous, and currentConstrainedOut := [].
//   CloseSpanIfComplete (open/no-op path): leaves state unchanged, invariant holds.
//   AdaptiveConstrainedStep returns EOS or a parser-valid extension token.
//   AppendConstrainedToken preserves parser validity by the helper's contract.
//   SafeRepetitionPenaltyStep also returns EOS or a parser-valid extension token.
//
// progress:
//   Every branch increments steps by exactly 1 and appends at most one visible
//   token to generated (or zero on EOS/close). Therefore
//   |generated| <= |generatedPrefix| + steps is preserved throughout.
//   CloseSpanIfComplete costs +1 step and appends at most one token (">>" or
//   nothing if already present). AdaptiveConstrainedStep / SafeRepetitionPenaltyStep
//   each cost +1 step and their output is at most one token appended.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a single valid SQL query. Output format: SQL: <<your SQL query here>>. Use only tables and columns from the provided schema. Do not include explanation or markdown.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    // First check if we can close the span
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Generate next constrained token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var next := eosToken;
      if validCount <= narrowThreshold {
        // Narrow state: use group boosting to prefer schema-relevant tokens
        next := helpers.GroupBoostedConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, eosToken
        );
      } else {
        // Wider state: use adaptive step with repetition penalty to avoid loops
        next := helpers.SafeRepetitionPenaltyStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
        );
      }
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

