Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis from failure rollouts:
//   1. The model generates table aliases (c.column, AS alias) even with guidance.
//   2. The model generates overly complex queries with repeated JOINs.
//   3. "Span usefulness: valid_nonfinal_spans_only 50/50" - the span is being generated
//      but the evaluator is using text_fallback, not the span content. This means the
//      constrained SQL is being hidden (no visible << >>) but the evaluator sees the
//      unconstrained free text that precedes it.
//   4. "Examples with visible <<: 0/50" - OpenConstrainedSpan is NOT producing visible
//      delimiters, or the generated text before << is being used instead.
//   5. Key insight: "answer_source=text_fallback" for ALL wrong answers - the evaluator
//      is extracting from free text, not from the constrained span!
//
// Root cause: The evaluator uses "SQL: <<QUERY>>" format. The LM generates the SQL
// BEFORE we open the constrained span, and that unconstrained SQL text IS the answer.
// The constrained span content is ignored because the evaluator sees the "SQL:" prefix
// in free text and extracts that answer.
//
// Fix: We must NOT let the model generate free text first. We should use
// UnconstrainedChunk to generate just "SQL: " prefix, then OpenConstrainedSpan,
// then constrained SQL. OR better: generate "SQL: " and then immediately enter
// the constrained span.
//
// Wait - looking again at the metrics: "Examples with visible <<: 0/50" means
// the << token is not appearing in the output at all! OpenConstrainedSpan appends
// "<<" but something is wrong.
//
// Actually re-reading: "valid_nonfinal_spans_only 50/50" means there ARE valid spans
// but they are not the final answer span. The constrained content IS being generated
// but the evaluator is not using it as the final answer.
//
// The evaluator contract says: "SQL: <<YOUR QUERY>>" - so << >> must be present.
// "Contains << >>: required" and "contains_delimiters=yes" in clusters but
// "visible_delimiters=no". 
//
// This means << >> are being emitted but as HIDDEN delimiters (the evaluator
// finds them internally but they're not "visible" in the normal sense).
//
// Strategy: Use a two-phase approach:
//   Phase 1: UnconstrainedChunk to generate "SQL: " (stop when << is emitted)
//   Phase 2: If << was emitted, EnterObservedConstrainedSpan; else OpenConstrainedSpan
//   Phase 3: RegenerateUnitOnGroundingFailure for SQL body
//   Phase 4: CloseSpanWithinBudget
//
// The key change: let the model generate "SQL: " freely, watch for <<,
// then enter constrained mode. This allows the "SQL: <<" prefix to appear naturally.
//
// Also improving guidance to be more specific about column names from schema.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Initialization preserves precondition invariants directly.
//   2. UnconstrainedChunk phase: if stoppedOnOpenSpan, generated ends with "<<"
//      and we call EnterObservedConstrainedSpan which sets insideConstrainedOut=true,
//      currentConstrainedOut=[] which satisfies parser.IsValidPrefix([]).
//      If not stopped on open span, insideConstrainedOut remains false, invariant vacuous.
//   3. If insideConstrainedOut still false after chunk, OpenConstrainedSpan sets
//      insideConstrainedOut=true, currentConstrainedOut=[], valid by precondition.
//   4. RegenerateUnitOnGroundingFailure: contract guarantees returned filled is
//      parser.IsValidPrefix(filled). We set currentConstrainedOut := filled. Holds.
//   5. CloseSpanWithinBudget: postcondition ensures
//      insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut) and
//      !insideConstrainedOut ==> currentConstrainedOut == []. Invariant preserved.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   UnconstrainedChunk: |generatedOut| <= |generated| + chunkBudget, steps += chunkBudget.
//   EnterObservedConstrainedSpan: +0 to generated, +0 to steps. Bound preserved.
//   OpenConstrainedSpan: appends "<<" (+1 token), steps += 1. Bound preserved.
//   RegenerateUnitOnGroundingFailure: generated = stable + filled where
//     |stable| = |generated| - |currentConstrainedOut|. Cost <= fillBudget.
//     |filled| bounded by |currentConstrainedOut| + fillBudget (helper contract).
//     steps += fillBudget (conservative), so |generated| <= |generatedPrefix| + steps. ✓
//   CloseSpanWithinBudget: |generatedOut| <= |generated| + closeBudget.
//     steps := maxSteps, closeBudget = maxSteps - steps_before.
//     |generated| <= |generatedPrefix| + maxSteps. cost := steps <= maxSteps. ✓
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Guidance: emphasize simple SQL without aliases, using exact schema names.
helpers.AppendTaskGuidance(lm,
  "Output format: SQL: <<query>>. Write the simplest correct SQL query. Do NOT use table aliases. Do NOT use AS aliases for columns. Use exact column names from the schema. For max/min use ORDER BY col DESC LIMIT 1. Use direct WHERE clauses, not subqueries when possible.");

var steps: nat := 0;

// Phase 1: Generate free text prefix "SQL: " and watch for "<<".
// Use a small chunk budget so the model can naturally emit "SQL: <<".
if !insideConstrainedOut && steps < maxSteps {
  var chunkBudget: nat := 8;
  if chunkBudget > maxSteps - steps {
    chunkBudget := maxSteps - steps;
  }
  if chunkBudget >= 1 {
    var cg, stoppedOnOpen, stoppedOnEos, stepsUsed :=
      helpers.UnconstrainedChunk(lm, prompt, generated, chunkBudget, "<<", eosToken);
    generated := cg;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      cost := steps;
      return;
    }
    if stoppedOnOpen {
      // "<<" is already in generated, enter span state without appending another "<<"
      generated, insideConstrainedOut, currentConstrainedOut :=
        helpers.EnterObservedConstrainedSpan(lm, generated);
    }
  }
}

// Phase 2: If not yet inside constrained span, open one explicitly.
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 3: Grounded constrained SQL generation on most of remaining budget.
if insideConstrainedOut && steps < maxSteps {
  var rem: nat := maxSteps - steps;
  // Reserve ~25% for closing (min 20, max 50 steps).
  var closeReserve: nat := rem / 4;
  if closeReserve < 20 && rem >= 25 {
    closeReserve := 20;
  }
  if closeReserve > 50 {
    closeReserve := 50;
  }
  if closeReserve >= rem {
    closeReserve := if rem > 1 then rem - 1 else 0;
  }
  var fillBudget: nat := rem - closeReserve;

  if fillBudget >= 1 {
    var stable := generated[..|generated| - |currentConstrainedOut|];
    var filled := helpers.RegenerateUnitOnGroundingFailure(
      lm, parser, prompt + stable, currentConstrainedOut, eosToken,
      fillBudget, 4, fillBudget);
    generated := stable + filled;
    currentConstrainedOut := filled;
    steps := steps + fillBudget;
  }
}

// Phase 4: Advance to completable state and emit ">>".
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

