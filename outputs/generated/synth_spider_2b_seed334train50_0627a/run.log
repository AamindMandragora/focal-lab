Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis: Despite "<<" being forced via OpenConstrainedSpan, the evaluation shows
// 0/50 examples have visible "<<" tokens. The strategy is using hidden spans (the
// constrained activity shows up as "valid_nonfinal_spans_only" 50/50). The problem
// is that the evaluator is seeing the SQL output BUT not the "<<" delimiters. This
// means the constrained span IS being used (48/50 without activity is wrong - 
// actually activity=2, without=48 is wrong). Actually the diagnostic says
// "Examples with visible <<: 0/50" which means the OpenConstrainedSpan call is NOT
// being reached or the "<<" token is not in the vocabulary/output.
//
// Root cause: The unconstrained phase generates the entire SQL before we ever call
// OpenConstrainedSpan. The while loop runs up to prefixBudget=10 steps and by then
// the model has already generated the full SQL. The OpenConstrainedSpan is only called
// if !insideConstrainedOut && steps < maxSteps AFTER the while loop, but by then
// the SQL is already emitted in `generated`.
//
// The grounding phase then runs with RegenerateUnitOnGroundingFailure but the
// constrained content is appended AFTER the already-generated SQL, so the visible
// output has the SQL twice or in the wrong position.
//
// Fix strategy:
//   1. Use AppendTaskGuidance with very direct SQL: << >> format instruction.
//   2. Emit "SQL: " tokens via unconstrained steps (just a few tokens).
//   3. Immediately call OpenConstrainedSpan to force "<<" emission.
//   4. Use RegenerateUnitOnGroundingFailure with most of the remaining budget.
//   5. Use CloseSpanWithinBudget on the reserved budget.
//
// Key insight from failures: the SQL is semantically wrong (wrong tables, wrong
// conditions). The grounding failure is that the LM doesn't use the correct schema.
// We should use RegenerateUnitOnGroundingFailure which checks that identifiers
// come from the prompt context. We should also use a large fillBudget to allow
// complex queries.
//
// The "visible_delimiters=no" in all clusters is the smoking gun - the << >> are
// being generated but not visible to the evaluator. This may be because the
// OpenConstrainedSpan is called but the "<<" token is not being emitted into
// `generated` properly since the SQL was already there.
//
// Revised approach: Emit NOTHING unconstrained first. Just force "SQL: " text
// via AppendTaskGuidance, then IMMEDIATELY open the constrained span at step 0.
// This ensures "<<" is the first thing added, and the SQL fills the span.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Initialization: insideConstrainedOut := insideConstrained,
//      currentConstrainedOut := currentConstrained. Preconditions ensure validity.
//   2. Phase 0 (free prefix for "SQL: "): While !insideConstrainedOut,
//      implication is vacuous. We exit when we hit prefixBudget or EOS.
//      We do NOT open a span in this phase.
//   3. Phase 1 (OpenConstrainedSpan): Sets insideConstrainedOut := true,
//      currentConstrainedOut := [], which is a valid prefix. Costs 1 step.
//   4. Phase 2 (grounding): RegenerateUnitOnGroundingFailure returns a
//      parser-valid prefix by postcondition. insideConstrainedOut stays true,
//      currentConstrainedOut is parser-valid.
//   5. Phase 3 (close): CloseSpanWithinBudget returns either
//      insideConstrainedOut=false (vacuous, currentConstrainedOut=[]) or
//      a valid open prefix. Both invariants preserved.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 0: Each iteration: steps += 1, |generated| += 1. Invariant preserved.
//   Phase 1: OpenConstrainedSpan appends "<<" (+1 token), steps += 1.
//     |generated| <= |generatedPrefix| + steps preserved.
//   Phase 2: fillBudget computed, RegenerateUnitOnGroundingFailure cost <= fillBudget.
//     steps += fillBudget, |generated| = |stable| + |filled|.
//     |stable| = |generated_before| - |currentConstrainedOut_before|.
//     After grounding: |generated| = |stable| + |filled_budget| <=
//     |generatedPrefix| + steps (by cost contract).
//   Phase 3: CloseSpanWithinBudget: |generatedOut| <= |generated| + closeBudget.
//     steps := maxSteps. So |generated| <= |generatedPrefix| + maxSteps.
//   cost := steps <= maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Strong guidance to emit SQL in the exact required format.
helpers.AppendTaskGuidance(lm,
  "You must output your answer as exactly: SQL: <<query>> where query is a valid SQL SELECT statement using only the tables and columns mentioned in the schema. Do not output anything else. The << and >> delimiters are required.");

var steps: nat := 0;

// Phase 0: Emit a very short unconstrained prefix (e.g., "SQL: ").
// We use at most 5 unconstrained steps for "SQL", ":", " " tokens.
// Stop early if we accidentally generate "<<" (model follows instructions).
var prefixBudget: nat := 5;

while steps < prefixBudget && !insideConstrainedOut && steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases prefixBudget - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// Phase 1: If not yet inside constrained span, force-open it.
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Grounded constrained generation — use most of the remaining budget.
if insideConstrainedOut && steps < maxSteps {
  var rem: nat := maxSteps - steps;
  // Reserve at least 10 steps for closing; use up to 85% for grounding.
  var closeReserve: nat := 10;
  if closeReserve > rem {
    closeReserve := rem;
  }
  var fillBudget: nat := rem - closeReserve;
  if fillBudget == 0 && rem > 0 {
    fillBudget := 1;
    closeReserve := if rem > 1 then rem - 1 else 0;
  }

  if fillBudget >= 1 {
    var stable := generated[..|generated| - |currentConstrainedOut|];
    var filled := helpers.RegenerateUnitOnGroundingFailure(
      lm, parser, prompt + stable, currentConstrainedOut, eosToken,
      fillBudget, 3, fillBudget);
    generated := stable + filled;
    currentConstrainedOut := filled;
    steps := steps + fillBudget;
  }
}

// Phase 3: Close the span using remaining budget.
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

