  var closeReserve: nat := rem / 5;
  if closeReserve < 15 && rem >= 18 {
    closeReserve := 15;
  }
  if closeReserve > 40 {
    closeReserve := 40;
  }
  if closeReserve >= rem {
    closeReserve := if rem > 1 then rem - 1 else 0;
  }
  var fillBudget: nat := rem - closeReserve;

  if fillBudget >= 1 {
