Strategy: // CSD_RATIONALE_BEGIN
// SQL constrained CSD with task guidance and grounding.
// Strategy:
//   State tracked: steps (budget), insideConstrainedOut (span open/closed),
//   currentConstrainedOut (parser-valid constrained prefix), generated (full output).
//
// The evaluator expects "SQL: <<YOUR QUERY>>" format. We:
//   1. Prepend task guidance to steer the LM toward SQL output.
//   2. Generate freely (unconstrained) until "<<" is observed, which opens
//      the constrained span for the SQL query itself.
//   3. Inside the constrained span, use RegenerateUnitOnGroundingFailure on
//      half the remaining budget so schema identifiers stay grounded in the
//      prompt context.
//   4. Use CloseSpanWithinBudget on the remaining budget to push the span to
//      a complete parse and emit ">>".
//   5. After ">>" is emitted, continue generating freely until EOS or budget.
//
// The parser enforces SQL grammar validity at every token inside the span.
// Grounding ensures column/table names come from the schema in the prompt.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Outside span: implication is vacuously true. When next == "<<",
//      currentConstrainedOut := [] is valid (parser.IsValidPrefix([])).
//   2. EnterObservedConstrainedSpan sets currentConstrainedOut := [], valid.
//   3. RegenerateUnitOnGroundingFailure returns a parser-valid prefix by contract.
//   4. CloseSpanWithinBudget returns either insideConstrainedOut=false (vacuous)
//      or a valid open prefix (insideConstrainedOut=true, currentConstrainedOut valid).
//   5. After closing, unconstrained steps leave insideConstrainedOut=false.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1 (free): each iteration increments steps by 1 and generated by at
//     most 1 token. So |generated| <= |generatedPrefix| + steps.
//   Phase 2 (grounding): fillBudget = (maxSteps - steps) / 2. After
//     RegenerateUnitOnGroundingFailure, generated = stable + filled where
//     |filled| <= |currentConstrainedOut| + fillBudget. Since stable is the
//     prefix of the old generated, |generated| <= old |generated| + fillBudget
//     <= |generatedPrefix| + steps + fillBudget = |generatedPrefix| + newSteps.
//   Phase 3 (close): CloseSpanWithinBudget guarantees
//     |generatedOut| <= |generated| + closeBudget; we set steps := maxSteps,
//     so |generated| <= |generatedPrefix| + maxSteps.
//   Phase 4 (free tail): each step increments steps by 1 and generated by at
//     most 1 token; steps <= maxSteps is maintained by loop guard.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Provide task guidance once, before any generation.
helpers.AppendTaskGuidance(lm,
  "Generate a single valid SQL query using only the schema provided. Output format: SQL: <<your SQL query here>>. No explanation, no markdown fences, no extra text.");

var steps: nat := 0;

// Phase 1: Generate freely until "<<" opens the constrained SQL span.
while steps < maxSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// If we opened a span, proceed with grounded constrained generation.
if insideConstrainedOut && steps < maxSteps {
  assert parser.IsValidPrefix(currentConstrainedOut);
  assert |currentConstrainedOut| <= |generated|;
  assert |generated| <= |generatedPrefix| + steps;

  // Phase 2: Ground constrained content unit-by-unit on half the remaining budget.
  var rem: nat := maxSteps - steps;
  var fillBudget: nat := rem / 2;
  if fillBudget >= 1 {
    var stable := generated[..|generated| - |currentConstrainedOut|];
    var filled := helpers.RegenerateUnitOnGroundingFailure(
      lm, parser, prompt + stable, currentConstrainedOut, eosToken,
      fillBudget, 3, fillBudget);
    generated := stable + filled;
    currentConstrainedOut := filled;
    steps := steps + fillBudget;
  }

  assert insideConstrainedOut;
  assert parser.IsValidPrefix(currentConstrainedOut);
  assert |currentConstrainedOut| <= |generated|;
  assert |generated| <= |generatedPrefix| + steps;
  assert steps <= maxSteps;

  // Phase 3: Advance to completable state and close the span.
  if steps < maxSteps {
    var closeBudget: nat := maxSteps - steps;
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.CloseSpanWithinBudget(
        lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
    steps := maxSteps;
  }
}

assert |generated| <= |generatedPrefix| + steps;
assert steps <= maxSteps;

// Phase 4: Free tail generation after span closes (for any trailing tokens).
while steps < maxSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

cost := steps;

