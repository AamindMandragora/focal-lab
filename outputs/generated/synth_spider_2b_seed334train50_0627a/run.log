//      insideConstrained ==> parser.IsValidPrefix(currentConstrained) (invariant holds).
//   2. OpenConstrainedSpan (when !insideConstrainedOut): by contract returns
//      insideConstrainedOut=true, currentConstrainedOut=[]. Since parser.IsValidPrefix([])
//      holds by precondition, the invariant is preserved. steps incremented by 1.
//   3. RegenerateUnitOnGroundingFailure: by its postcondition, the returned `filled`
//      satisfies parser.IsValidPrefix(filled). insideConstrainedOut remains true.
//      Setting currentConstrainedOut := filled preserves the parser_validity invariant.
//   4. CloseSpanWithinBudget: postcondition ensures
//      (!insideConstrainedOut ==> currentConstrainedOut == []) AND
//      (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)).
//      Both branches preserve the parser_validity invariant.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan: appends "<<" (+1 token), steps := steps + 1.
//     |generated| = |generatedPrefix| + 1 = |generatedPrefix| + steps. ✓
//   RegenerateUnitOnGroundingFailure: generated = stable + filled where
//     stable = generated[..|generated|-|currentConstrainedOut|].
//     |stable| = old |generated| - |currentConstrainedOut| (unchanged by helper).
//     Helper bound: |filled| <= |currentConstrainedOut| + fillBudget (cost <= fillBudget).
//     steps := steps + fillBudget, so |generated| = |stable| + |filled|
//       <= (|generatedPrefix|_before_fill - |currentConstrainedOut|) + |currentConstrainedOut| + fillBudget
//       = |generatedPrefix|_before_fill + fillBudget = |generatedPrefix| + steps. ✓
//   CloseSpanWithinBudget: |generatedOut| <= |generated| + closeBudget.
//     steps := maxSteps, closeBudget = maxSteps - steps_before_close.
//     |generated| <= |generatedPrefix| + steps_before_close + closeBudget = |generatedPrefix| + maxSteps. ✓
//   cost := steps <= maxSteps. ✓
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Revised guidance: allow table.column notation and JOINs, but disallow short aliases.
// This matches the correct answer format observed in the evaluation examples.
helpers.AppendTaskGuidance(lm,
