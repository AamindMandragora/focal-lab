Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis: The previous attempt never emitted a visible "<<" token (0/50 examples),
// meaning the unconstrained phase never produced "<<" naturally. The LM was generating
// SQL directly without the delimiter. The constrained span was never opened, so the
// SQL was never parser-constrained, leading to semantically wrong but syntactically
// valid SQL.
//
// Fix strategy:
//   1. Use AppendTaskGuidance to strongly steer toward "SQL: <<query>>" format.
//   2. Generate a SHORT unconstrained prefix (just "SQL: ") with a tight budget.
//   3. Force-open the constrained span with OpenConstrainedSpan (emits "<<" explicitly).
//   4. Use RegenerateUnitOnGroundingFailure on the bulk of the budget to generate
//      a grounded SQL query inside the span.
//   5. Use CloseSpanWithinBudget on the remaining budget to close the span.
//
// This ensures "<<" and ">>" are always emitted, the SQL is parser-constrained,
// and schema identifiers are grounded in the prompt context.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Phase 1 (free prefix): While !insideConstrainedOut, the implication is vacuously
//      true. We exit when insideConstrainedOut flips to true (via OpenConstrainedSpan)
//      which sets currentConstrainedOut := [] — a valid prefix.
//   2. Phase 2 (grounding): RegenerateUnitOnGroundingFailure returns a parser-valid
//      prefix by contract. insideConstrainedOut remains true, currentConstrainedOut
//      is parser-valid.
//   3. Phase 3 (close): CloseSpanWithinBudget returns either insideConstrainedOut=false
//      (implication vacuous, currentConstrainedOut=[]) or a valid open prefix
//      (insideConstrainedOut=true, currentConstrainedOut valid). Either way invariant holds.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   Phase 1: Each iteration increments steps by 1 and generated by at most 1 token
//     (UnconstrainedStep) or 1 token (OpenConstrainedSpan). So |generated| <= |generatedPrefix| + steps.
//   Phase 2: fillBudget = (maxSteps - steps) * 3 / 4. After RegenerateUnitOnGroundingFailure,
//     generated = stable + filled where |filled| is bounded by RegenerateUnitOnGroundingFailure's
//     cost contract. steps := steps + fillBudget ensures |generated| <= |generatedPrefix| + steps.
//   Phase 3: CloseSpanWithinBudget guarantees |generatedOut| <= |generated| + closeBudget;
//     we set steps := maxSteps, so |generated| <= |generatedPrefix| + maxSteps.
//   cost := steps <= maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Provide task guidance to strongly steer toward SQL: <<query>> format.
helpers.AppendTaskGuidance(lm,
  "Output exactly: SQL: <<your SQL query here>> where the query uses only tables and columns from the schema. No explanation, no markdown, no extra text. The SQL query must be placed between << and >>.");

var steps: nat := 0;

// Phase 1: Generate a short unconstrained prefix ("SQL: "), then force-open the span.
// We use a tight budget of up to 10 tokens for the prefix, then force "<<".
var prefixBudget: nat := 10;
if prefixBudget > maxSteps {
  prefixBudget := maxSteps;
}

while steps < prefixBudget && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases prefixBudget - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// If not yet inside a constrained span, force-open one with OpenConstrainedSpan.
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Grounded constrained generation on 3/4 of remaining budget.
if insideConstrainedOut && steps < maxSteps {
  assert parser.IsValidPrefix(currentConstrainedOut);
  assert |currentConstrainedOut| <= |generated|;

  var rem: nat := maxSteps - steps;
  var fillBudget: nat := (rem * 3) / 4;
  if fillBudget == 0 && rem > 0 {
    fillBudget := 1;
  }

  if fillBudget >= 1 {
    var stable := generated[..|generated| - |currentConstrainedOut|];
    var filled := helpers.RegenerateUnitOnGroundingFailure(
      lm, parser, prompt + stable, currentConstrainedOut, eosToken,
      fillBudget, 3, fillBudget);
    generated := stable + filled;
    currentConstrainedOut := filled;
    steps := steps + fillBudget;
  }
}

// Phase 3: Advance to completable state and close the span.
if insideConstrainedOut && steps < maxSteps {
  assert parser.IsValidPrefix(currentConstrainedOut);
  assert |currentConstrainedOut| <= |generated|;
  assert |generated| <= |generatedPrefix| + steps;

  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

