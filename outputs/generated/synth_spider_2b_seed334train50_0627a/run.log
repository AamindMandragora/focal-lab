// check (lm.SpanGrounded) may not catch the right semantic errors, or the model
// generates SQL that is valid but overcomplicated.
//
// New strategy:
// 1. Keep OpenConstrainedSpan immediately (best approach from attempt 4)
// 2. Use AdaptiveConstrainedStepWithPenalties in a loop instead of grounding helper:
//    - boosts validTokenGroups (schema vocab) 
//    - penalizes tokens already heavily used (repetition avoidance)
//    - CloseSpanIfComplete each step to exit as soon as valid
// 3. Strong close reserve (50 steps) to ensure >> is emitted
// 4. Task guidance that explicitly tells the model to write simple SQL
//
// The key insight from rollout 3: the model generates "SELECT c.id, c.mpg, c.cylinders..."
// instead of "SELECT MIN(weight)...". This is a semantic selection problem, not syntax.
// The AdaptiveConstrainedStepWithPenalties with validTokenGroups might help steer
// toward schema-relevant tokens more effectively.
//
// Also: Use SafeRepetitionPenaltyStep to avoid the repetition loop seen in rollout 4.
// Actually, use the main loop with AdaptiveConstrainedStepWithPenalties which includes
// both boost (validTokenGroups) and penalty (previously-generated tokens).
//
// Budget: maxSteps=200, stepTokenBudget=1
//   - 1 step: OpenConstrainedSpan
//   - up to 149 steps: AdaptiveConstrainedStepWithPenalties loop  
//   - 50 steps: CloseSpanWithinBudget
//
// The closeReserve=50 ensures we always have budget to close the span.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Initialization: insideConstrainedOut := insideConstrained,
//      currentConstrainedOut := currentConstrained. Preconditions ensure validity.
//   2. OpenConstrainedSpan (if !insideConstrainedOut): returns insideConstrainedOut=true,
//      currentConstrainedOut=[] which satisfies parser.IsValidPrefix([]) by precondition.
//   3. Main generation loop: CloseSpanIfComplete either closes the span
//      (insideConstrainedOut=false, currentConstrainedOut=[], vacuous) or is a no-op.
//      AdaptiveConstrainedStepWithPenalties returns EOS or a parser-valid next token.
//      AppendConstrainedToken preserves parser.IsValidPrefix(currentConstrainedOut).
//      So after each iteration, insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut).
//   4. CloseSpanWithinBudget postcondition: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//      and !insideConstrainedOut ==> currentConstrainedOut == [].
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan: appends "<<" (+1 token), steps := steps + 1.
//     |generated| = |generatedPrefix| + 1 = |generatedPrefix| + steps. ✓
//   - Main loop: Each iteration increments steps by 1 (CloseSpanIfComplete costs 1,
//     and AdaptiveConstrainedStepWithPenalties costs 1 within that same branch check).
//     Wait — CloseSpanIfComplete costs 1. If closed, we don't call AdaptiveConstrainedStep.
//     If not closed, we call AdaptiveConstrainedStepWithPenalties (costs 1 more).
//     But we increment steps only once per outer while-iteration.
//     Fix: increment steps by 1 for CloseSpanIfComplete; if not closed, increment by 1
//     for AdaptiveConstrainedStepWithPenalties. Each loop iteration costs at most 2 steps.
//     But the loop guard is steps < maxSteps - closeReserve, so we need careful accounting.
//     Better: use separate step increments and check budget before each helper call.
//   - CloseSpanWithinBudget: |generatedOut| <= |generated| + closeBudget;
//     steps := maxSteps, so |generated| <= |generatedPrefix| + maxSteps. ✓
//   cost := steps <= maxSteps. ✓
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm,
  "Write a single simple SQL SELECT query. Use only the exact table and column names from the schema. Prefer MIN(), MAX(), COUNT(*), and simple WHERE clauses over complex JOINs. Do not repeat column names or aliases.");

var steps: nat := 0;

// Phase 1: Immediately open the constrained span (emit "<<").
if !insideConstrainedOut {
  if steps < maxSteps {
    var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
    generated := og;
    insideConstrainedOut := oi;
    currentConstrainedOut := oc;
    steps := steps + 1;
  }
}

// closeReserve: tokens reserved for CloseSpanWithinBudget
var closeReserve: nat := 50;
if maxSteps <= 50 {
  closeReserve := if maxSteps > 1 then maxSteps / 2 else 0;
}

// Phase 2: Generate SQL with AdaptiveConstrainedStepWithPenalties.
// Each iteration: try to close if complete (1 step), then if not closed generate next token (1 step).
// We check budget before each helper call.
while insideConstrainedOut && steps + 1 < maxSteps - closeReserve
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - closeReserve - steps
{
  // Try to close the span if complete (costs 1 step).
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else {
    // Generate next constrained token with group boosting and repetition penalty.
    // Check budget again before second helper call.
    if steps < maxSteps - closeReserve {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      // Use penaltyTokens = generated tokens to discourage repetition.
      var next := helpers.AdaptiveConstrainedStepWithPenalties(
        lm, parser, constrainedPrompt, currentConstrainedOut,
        validTokenGroups, 5.0, generated, 2.0, 20, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Phase 3: Advance to a completable state and emit ">>".
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

