Strategy: // CSD_RATIONALE_BEGIN
// Analysis of current state:
//   - Best attempt (40%, attempt 9): OpenConstrainedSpan + RegenerateUnitOnGroundingFailure(retries=5)
//     + CloseSpanWithinBudget. 
//   - Current attempt (38%): Same structure with retries=6 and 25% close reserve.
//   - Both have syntax ~88-94% and accuracy ~38-40%.
//
// Key observations from failure rollouts:
//   1. "SELECT MAX(age) AS age FROM dogs" - wrong due to alias "AS age", should be "SELECT MAX(age) FROM dogs"
//   2. "SELECT DISTINCT f.flightno FROM flights f JOIN airports a..." - uses table aliases, wrong schema access
//   3. "SELECT COUNT(*) AS count_18_49_rating_share..." - repetition loop generating nonsensical queries
//   4. Repetition loops in SELECT lists and IN clauses
//
// Root cause analysis:
//   - The model is generating SQL with aliases and table prefixes even with grounding
//   - RegenerateUnitOnGroundingFailure doesn't catch "AS alias" constructs because the alias
//     identifier might be in the schema (or the grounding doesn't check column aliases)
//   - Repetition loops come from the model getting stuck after grammar-valid prefixes
//
// Key insight: The problem is not just the retries count but the guidance clarity.
//   - The model generates "AS age" which is a valid SQL alias but produces wrong normalized form
//   - The model uses table aliases "f.flightno" which are grounded (flightno IS in schema) but wrong
//
// New approach: Use SafeRepetitionPenaltyStep inside the loop to prevent repetition,
// combined with better guidance. However, this requires a manual loop rather than
// RegenerateUnitOnGroundingFailure.
//
// Alternative: Keep RegenerateUnitOnGroundingFailure but:
//   1. Adjust guidance to be more direct about the SPECIFIC failure patterns seen
//   2. Reduce close reserve to allow more generation budget
//   3. Use retries=5 (same as best attempt 9) not 6
//   4. Add specific guidance about "AS" keyword being forbidden
//   5. Add guidance about LIKE operator for substring searches
//
// The key insight from the "North" example: model generates "city IN ('North'...)" 
// instead of "state LIKE '%North%'". This is a major pattern failure.
// The model doesn't know to use LIKE for substring matching.
//
// Guidance improvements:
//   - Explicitly mention LIKE for substring matching
//   - Explicitly say NO "AS" aliases  
//   - Explicitly say NO table prefix notation (t.column)
//   - Keep query as simple as the question implies
//
// Budget: maxSteps=200, stepTokenBudget=1
//   - 1 step: OpenConstrainedSpan
//   - ~159 steps: RegenerateUnitOnGroundingFailure (retries=5, maxRollbackBudget=fillBudget)
//   - ~40 steps: CloseSpanWithinBudget
//
// This matches exactly the best attempt 9 structure, with only guidance improvement.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Initialization: insideConstrainedOut := insideConstrained,
//      currentConstrainedOut := currentConstrained. Preconditions ensure:
//      !insideConstrained ==> currentConstrained == [] (valid vacuously),
//      insideConstrained ==> parser.IsValidPrefix(currentConstrained) (valid).
//   2. OpenConstrainedSpan (if !insideConstrainedOut): by contract returns
//      insideConstrainedOut=true, currentConstrainedOut=[] which satisfies
//      parser.IsValidPrefix([]) by precondition. Steps incremented by 1.
//   3. RegenerateUnitOnGroundingFailure: by contract the returned `filled` satisfies
//      parser.IsValidPrefix(filled). insideConstrainedOut remains true.
//      We set currentConstrainedOut := filled, so the invariant holds.
//   4. CloseSpanWithinBudget: postcondition ensures
//      insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut) and
//      !insideConstrainedOut ==> currentConstrainedOut == []. Both preserve invariant.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan: appends "<<" (+1 token to generated), steps := steps + 1.
//     |generated| = |generatedPrefix| + 1 = |generatedPrefix| + steps. ✓
//   RegenerateUnitOnGroundingFailure phase: after the call,
//     generated = stable + filled where stable = generated[..|generated|-|currentConstrainedOut|].
//     |stable| = |generated| - |currentConstrainedOut| (unchanged by call).
//     Helper contract: cost <= fillBudget steps total, and |filled| <= |currentConstrainedOut| + fillBudget.
//     We set steps := steps + fillBudget (conservative),
//     so |generated| = |stable| + |filled| <= (|generatedPrefix| + steps_before_fill - |currentConstrainedOut|)
//     + |currentConstrainedOut| + fillBudget = |generatedPrefix| + steps. ✓
//   CloseSpanWithinBudget: |generatedOut| <= |generated| + closeBudget.
//     We set steps := maxSteps, and closeBudget = maxSteps - steps_before_close.
//     So |generated| <= |generatedPrefix| + steps_before_close + closeBudget = |generatedPrefix| + maxSteps. ✓
//   cost := steps <= maxSteps. ✓
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Improved guidance: address specific failure patterns observed in rollouts.
// Key failures: AS aliases, table prefix notation (t.col), IN lists instead of LIKE,
// repetition loops, overly complex JOINs.
helpers.AppendTaskGuidance(lm,
  "Write SQL. Critical rules: (1) NEVER use AS to rename columns or tables - no aliases of any kind. (2) NEVER use table.column notation - write column names directly without table prefixes. (3) For substring matching use LIKE '%word%' not IN lists. (4) For max/min of a single column use SELECT MAX(col) FROM table or SELECT MIN(col) FROM table directly. (5) For counting use SELECT COUNT(*) FROM table. (6) Use ORDER BY col DESC LIMIT 1 for top-1 ranking. (7) For set operations use INTERSECT or UNION. (8) Write the shortest correct SQL that answers the question.");

var steps: nat := 0;

// Phase 1: Immediately open the constrained span (emit "<<").
if !insideConstrainedOut {
  if steps < maxSteps {
    var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
    generated := og;
    insideConstrainedOut := oi;
    currentConstrainedOut := oc;
    steps := steps + 1;
  }
}

// Phase 2: Grounded constrained SQL generation on ~80% of remaining budget.
// Using maxRetries=5 (same as best attempt 9).
if insideConstrainedOut && steps < maxSteps {
  var rem: nat := maxSteps - steps;
  // Reserve 20% for closing (minimum 15 steps, maximum 40 steps) - same as best attempt 9.
  var closeReserve: nat := rem / 5;
  if closeReserve < 15 && rem >= 18 {
    closeReserve := 15;
  }
  if closeReserve > 40 {
    closeReserve := 40;
  }
  if closeReserve >= rem {
    closeReserve := if rem > 1 then rem - 1 else 0;
  }
  var fillBudget: nat := rem - closeReserve;

  if fillBudget >= 1 {
    var stable := generated[..|generated| - |currentConstrainedOut|];
    var filled := helpers.RegenerateUnitOnGroundingFailure(
      lm, parser, prompt + stable, currentConstrainedOut, eosToken,
      fillBudget, 5, fillBudget);
    generated := stable + filled;
    currentConstrainedOut := filled;
    steps := steps + fillBudget;
  }
}

// Phase 3: Advance to a completable state and emit ">>".
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

