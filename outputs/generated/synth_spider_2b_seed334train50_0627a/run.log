Strategy: // CSD_RATIONALE_BEGIN
// Analysis of failure modes:
//   - Best result (40%, attempt 9): OpenConstrainedSpan + RegenerateUnitOnGroundingFailure(retries=5)
//     + CloseSpanWithinBudget. Main failures are semantic mismatches (wrong SQL content).
//   - Attempt 10 (32%): Used UnconstrainedChunk (not in allowed helpers!) which caused fallback.
//     This was invalid. Back to the best approach.
//   - Key failure examples:
//     1. "SELECT AVG(money_rank)" instead of "SELECT AVG(earnings)" - wrong column name
//     2. "SELECT DISTINCT p1.first_name..." with aliases instead of "SELECT COUNT(DISTINCT loser_name)"
//     3. Massively over-complex repeated aliases
//
// The best approach (attempt 9) achieved 40% with 5 retries and 20% close reserve.
// To push beyond 40% accuracy and 94% syntax:
//
// Key insight from failure examples:
//   - The model picks wrong column names even with grounding. This suggests the grounding
//     test (lm.SpanGrounded) isn't catching semantic errors - it checks identifiers in the
//     PROMPT context but the model might pick wrong identifiers that ARE in the context
//     (e.g., "money_rank" is in schema, but "earnings" is the right column).
//   - The guidance needs to tell the model to use simpler queries and avoid aliases.
//   - We need to avoid table aliases explicitly.
//
// New strategy adjustments vs best (attempt 9):
//   1. Keep the same structure: OpenConstrainedSpan + RegenerateUnitOnGroundingFailure + CloseSpanWithinBudget
//   2. Improve guidance to be more direct about the task context
//   3. Increase grounding retries from 5 to 6 for harder examples
//   4. Use a slightly larger close reserve (25% instead of 20%) to reduce syntax failures
//   5. Add a hint about using COUNT, AVG, SUM, MIN, MAX directly with column names from schema
//
// The core issue is that 34 examples have "no-complete-span wrong answers" meaning the
// constrained span IS generating valid SQL but the content is wrong. The RegenerateUnitOnGroundingFailure
// approach is the right tool but needs better guidance and more retries.
//
// Budget: maxSteps=200, stepTokenBudget=1
//   - 1 step: OpenConstrainedSpan
//   - ~149 steps: RegenerateUnitOnGroundingFailure (with 6 retries)
//   - ~50 steps: CloseSpanWithinBudget
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Initialization: insideConstrainedOut := insideConstrained,
//      currentConstrainedOut := currentConstrained. Preconditions ensure:
//      !insideConstrained ==> currentConstrained == [] (vacuously valid),
//      insideConstrained ==> parser.IsValidPrefix(currentConstrained).
//   2. OpenConstrainedSpan: returns insideConstrainedOut=true, currentConstrainedOut=[].
//      parser.IsValidPrefix([]) holds by parser precondition. Steps += 1. Invariant preserved.
//   3. RegenerateUnitOnGroundingFailure: by contract returns filled with
//      parser.IsValidPrefix(filled). We set currentConstrainedOut := filled.
//      insideConstrainedOut remains true. Invariant preserved.
//   4. CloseSpanWithinBudget: postcondition guarantees
//      !insideConstrainedOut ==> currentConstrainedOut == [] and
//      insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut). Invariant preserved.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan: appends "<<" (1 token), steps := steps + 1.
//     |generated| = |generatedPrefix| + 1 = |generatedPrefix| + steps. ✓
//   RegenerateUnitOnGroundingFailure: generated = stable + filled.
//     |stable| = |generated_before| - |currentConstrainedOut_before|.
//     Helper cost <= fillBudget; |filled| <= |currentConstrainedOut_before| + fillBudget.
//     steps := steps + fillBudget (conservative upper bound).
//     |generated| = |stable| + |filled| <= (|generatedPrefix| + steps_before - |cc_before|)
//       + |cc_before| + fillBudget = |generatedPrefix| + steps. ✓
//   CloseSpanWithinBudget: |generatedOut| <= |generated| + closeBudget.
//     steps := maxSteps, closeBudget = maxSteps - steps_before_close.
//     |generated| <= |generatedPrefix| + maxSteps = |generatedPrefix| + steps. ✓
//   cost := steps <= maxSteps. ✓
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Guidance: direct and clear SQL style instructions to reduce semantic mismatches.
helpers.AppendTaskGuidance(lm,
  "Generate SQL: <<query>>. Rules: (1) Use exact column names from the schema - do not rename or alias columns. (2) Never use table aliases (no 't.column' or 'table AS t'). (3) For aggregate queries use SELECT COUNT(*), SELECT AVG(col), SELECT SUM(col), SELECT MIN(col), SELECT MAX(col) with the exact column name from the schema. (4) Use simple WHERE clauses. (5) For ranking queries use ORDER BY col DESC LIMIT 1. (6) Keep the query minimal.");

var steps: nat := 0;

// Phase 1: Open the constrained span immediately (emit "<<").
// We do NOT generate unconstrained tokens first - this prevents the model from
// outputting the full SQL in free text before the constrained span begins.
if !insideConstrainedOut {
  if steps < maxSteps {
    var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
    generated := og;
    insideConstrainedOut := oi;
    currentConstrainedOut := oc;
    steps := steps + 1;
  }
}

// Phase 2: Grounded constrained SQL generation.
// RegenerateUnitOnGroundingFailure generates parser-valid SQL token-by-token,
// rolling back and resampling any grammar unit whose identifiers are not
// grounded in the prompt context (schema names, values, etc.).
// Using maxRetries=6 for stronger semantic grounding vs best (5).
if insideConstrainedOut && steps < maxSteps {
  var rem: nat := maxSteps - steps;
  // Reserve 25% for closing (minimum 20 steps, maximum 50 steps).
  var closeReserve: nat := rem / 4;
  if closeReserve < 20 && rem >= 25 {
    closeReserve := 20;
  }
  if closeReserve > 50 {
    closeReserve := 50;
  }
  if closeReserve >= rem {
    closeReserve := if rem > 1 then rem - 1 else 0;
  }
  var fillBudget: nat := rem - closeReserve;

  if fillBudget >= 1 {
    var stable := generated[..|generated| - |currentConstrainedOut|];
    var filled := helpers.RegenerateUnitOnGroundingFailure(
      lm, parser, prompt + stable, currentConstrainedOut, eosToken,
      fillBudget, 6, fillBudget);
    generated := stable + filled;
    currentConstrainedOut := filled;
    steps := steps + fillBudget;
  }
}

// Phase 3: Advance to a completable state and emit ">>".
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

