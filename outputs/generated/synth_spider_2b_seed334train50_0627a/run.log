Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis from best attempt (28% acc, 90% syntax):
//   - "visible_delimiters=no" in ALL clusters → << >> tokens are emitted but not 
//     recognized as visible by evaluator. The span is "valid_nonfinal_spans_only" 50/50.
//   - "final_answer_span=0/50" → the constrained span is NOT being used as the answer.
//   - "answer_source=text_fallback" in all clusters → the evaluator falls back to 
//     extracting text outside any span.
//   - "examples_with_activity=4/50" → constrained generation barely fires (46/50 use 
//     the unconstrained SQL directly).
//   - The unconstrained prefix phase generates the FULL SQL in ~10 tokens, so by 
//     the time OpenConstrainedSpan fires, the answer is already done.
//
// Root cause: The LM generates "SQL: SELECT ..." in the first unconstrained steps.
// The prefixBudget=10 is enough for the LM to emit the entire short SQL. By the 
// time OpenConstrainedSpan runs, the full query is already in `generated`, and the 
// constrained span content is empty/trailing. The evaluator sees the answer in the 
// unconstrained prefix, not inside << >>.
//
// Fix: Eliminate unconstrained generation almost entirely. Emit ZERO free tokens.
// Just use AppendTaskGuidance then IMMEDIATELY open the constrained span (step 1).
// The constrained span will contain the ENTIRE SQL query. This ensures:
//   1. "<<" is always emitted first (visible delimiter present).
//   2. ALL SQL tokens are parser-constrained.
//   3. The evaluator sees the answer inside << >>.
//   4. Grounding keeps identifiers schema-consistent.
//
// Budget allocation: 1 step for OpenConstrainedSpan, then bulk for grounding,
// then close reserve. With maxSteps=200 and stepTokenBudget=1:
//   - 1 step: OpenConstrainedSpan (emit "<<")
//   - ~140 steps: RegenerateUnitOnGroundingFailure (grounded SQL generation)
//   - ~59 steps: CloseSpanWithinBudget (advance to complete and emit ">>")
//
// The "SQL: " prefix will be part of the task prompt via AppendTaskGuidance.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Initialization: insideConstrainedOut := insideConstrained,
//      currentConstrainedOut := currentConstrained. Preconditions ensure:
//      !insideConstrained ==> currentConstrained == [] (valid vacuously),
//      insideConstrained ==> parser.IsValidPrefix(currentConstrained) (valid).
//   2. If not already inside: OpenConstrainedSpan returns insideConstrainedOut=true,
//      currentConstrainedOut=[] which satisfies parser.IsValidPrefix([]) by precondition.
//   3. Grounding phase: RegenerateUnitOnGroundingFailure returns a parser-valid prefix
//      by contract. insideConstrainedOut stays true, currentConstrainedOut is valid.
//   4. Close phase: CloseSpanWithinBudget postcondition ensures
//      insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut) and
//      !insideConstrainedOut ==> currentConstrainedOut == []. Both preserve invariant.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan: appends "<<" (+1 token), steps := steps + 1.
//     |generated| = |generatedPrefix| + 1 = |generatedPrefix| + steps. ✓
//   Grounding phase: fillBudget computed from remaining budget. After
//     RegenerateUnitOnGroundingFailure, generated = stable + filled where
//     stable = generated[..|generated|-|currentConstrainedOut|].
//     By helper contract, cost <= fillBudget, so |filled| <= |currentConstrainedOut| + fillBudget.
//     We set steps := steps + fillBudget, so |generated| <= |generatedPrefix| + steps. ✓
//   Close phase: CloseSpanWithinBudget guarantees |generatedOut| <= |generated| + closeBudget.
//     We set steps := maxSteps, so |generated| <= |generatedPrefix| + maxSteps. ✓
//   cost := steps <= maxSteps. ✓
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Strong guidance: the ENTIRE answer (SQL query) goes inside << >>.
// The "SQL: " prefix is baked into the task prompt by the evaluator; we add 
// guidance to reinforce the exact format and schema grounding.
helpers.AppendTaskGuidance(lm,
  "Generate exactly one SQL SELECT statement between << and >>. Use only table and column names from the schema provided. Output nothing outside the << >> delimiters. Example format: SQL: <<SELECT col FROM table WHERE condition>>");

var steps: nat := 0;

// Phase 1: Immediately open the constrained span.
// Do NOT generate any unconstrained tokens — the LM would emit the full SQL answer
// in the free phase, leaving the constrained span empty and the << >> invisible.
if !insideConstrainedOut {
  if steps < maxSteps {
    var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
    generated := og;
    insideConstrainedOut := oi;
    currentConstrainedOut := oc;
    steps := steps + 1;
  }
}

// Phase 2: Grounded constrained SQL generation on ~70% of remaining budget.
// RegenerateUnitOnGroundingFailure generates token-by-token, rewinding any
// completed grammar unit whose identifiers are not grounded in the prompt context.
// This ensures SELECT, FROM, WHERE clauses use schema-correct identifiers.
if insideConstrainedOut && steps < maxSteps {
  var rem: nat := maxSteps - steps;
  // Reserve 30% for closing (minimum 10 steps, maximum 60 steps).
  var closeReserve: nat := rem / 3;
  if closeReserve < 10 && rem >= 10 {
    closeReserve := 10;
  }
  if closeReserve > 60 {
    closeReserve := 60;
  }
  if closeReserve >= rem {
    closeReserve := if rem > 1 then rem - 1 else 0;
  }
  var fillBudget: nat := rem - closeReserve;

  if fillBudget >= 1 {
    var stable := generated[..|generated| - |currentConstrainedOut|];
    var filled := helpers.RegenerateUnitOnGroundingFailure(
      lm, parser, prompt + stable, currentConstrainedOut, eosToken,
      fillBudget, 3, fillBudget);
    generated := stable + filled;
    currentConstrainedOut := filled;
    steps := steps + fillBudget;
  }
}

// Phase 3: Advance to a completable state and emit ">>".
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

