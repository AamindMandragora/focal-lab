Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis from attempt 4 (38% acc, 98% syntax):
//   - "visible_delimiters: no (100%)" → << >> are NOT visible in output.
//   - "examples_with_activity: 1/50" → constrained generation barely fires.
//   - "answer_source: text_fallback" → evaluator extracts SQL from free text.
//   - "visible `<<`: 0/50" → OpenConstrainedSpan IS being called but << is not
//     recognized as visible. The << token is being emitted but the evaluator
//     sees it as a "hidden" span, not a "visible" span.
//   - The helper call log shows: GenerateLogits=3816, MaskValidNextAndEos=3816
//     but only CloseConstrainedSpan=1 → the grounding loop IS running but the
//     visible span delimiter is not recognized.
//
// Key insight: The evaluator counts << as "visible" only when it appears in
// the raw token output BEFORE the constrained content. OpenConstrainedSpan
// appends "<<" to `generated`, but the failing examples show it's not visible.
// The issue is that with maxSteps=200 and stepTokenBudget=1, the entire 200-token
// budget is consumed by RegenerateUnitOnGroundingFailure which fills up the SQL
// but the << never propagates to the final output string visible to the evaluator.
//
// Wait — re-reading: "Examples with visible `<<`: 0/50" but "contains_delimiters: yes".
// This means the evaluator sees << in the output string but not as a "visible open span".
// The >> is present (unmatched close: 1/50) but no << pairs.
//
// The actual problem: OpenConstrainedSpan IS appending "<<" but then 
// RegenerateUnitOnGroundingFailure takes fillBudget steps. With fillBudget=~133,
// it generates the SQL content. CloseSpanWithinBudget then adds ">>". But the
// evaluator reports zero visible <<. This suggests the << token is there but
// the evaluator doesn't count it as starting a span.
//
// Alternative diagnosis: The SQL being generated is WRONG (wrong columns, wrong
// joins). The rollout examples show:
//   - "money_rank" instead of "earnings"  
//   - "countrycode" instead of "lifeexpectancy"
//   - Overcomplicated joins instead of simple MAX(age)
//
// The grounding helper checks lm.SpanGrounded() which validates identifiers
// against prompt context. But the CORRECT column names ARE in the schema
// (earnings, lifeexpectancy, age) — the model just picks wrong ones.
//
// Fix strategy: Use RegenerateUnitOnCheckFailure with allowedUnits extracted
// from the prompt. The prompt contains the schema, so column names like
// "earnings", "lifeexpectancy", "age" should be extractable.
// Also: Use AdaptiveConstrainedStep with validTokenGroups (which contains
// schema vocabulary) to steer toward correct column names.
//
// Additionally: Try a simpler approach — just use ConstrainedGeneration which
// runs a pure hard-constrained loop. The rollouts show the model CAN generate
// valid SQL; the issue is WHICH identifiers it picks. 
//
// New strategy:
// 1. AppendTaskGuidance with stronger schema-grounding message
// 2. OpenConstrainedSpan (1 step, emits <<)
// 3. Use AdaptiveConstrainedStep with validTokenGroups boosted strongly
//    for the entire generation (not just narrow states)
// 4. CloseSpanWithinBudget for the remainder
//
// The key change: instead of RegenerateUnitOnGroundingFailure (which apparently
// generates wrong identifiers anyway), use GroupBoostedConstrainedStep with
// validTokenGroups that presumably contains schema-relevant tokens. This should
// push the model toward schema-correct column/table names.
//
// Also: try to shorten the SQL — the rollouts show overcomplicated queries.
// Penalize tokens that cause over-elaboration.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Initialization: insideConstrainedOut := insideConstrained,
//      currentConstrainedOut := currentConstrained. Preconditions ensure validity.
//   2. OpenConstrainedSpan: returns insideConstrainedOut=true, currentConstrainedOut=[]
//      which satisfies parser.IsValidPrefix([]) by precondition.
//   3. Main generation loop: GroupBoostedConstrainedStep returns EOS or a parser-valid
//      next token. AppendConstrainedToken preserves parser.IsValidPrefix(currentConstrainedOut).
//      CloseSpanIfComplete either closes span (vacuous) or leaves state valid.
//   4. CloseSpanWithinBudget postcondition: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//      and !insideConstrainedOut ==> currentConstrainedOut == [].
//
// progress (|generated| <= |generatedPrefix| + steps):
//   OpenConstrainedSpan: appends "<<" (+1 token), steps := steps + 1. ✓
//   Each loop iteration: one token appended to generated, steps incremented by 1.
//     |generated| <= |generatedPrefix| + steps after each iteration. ✓
//   CloseSpanWithinBudget: |generatedOut| <= |generated| + closeBudget,
//     steps := maxSteps. |generated| <= |generatedPrefix| + maxSteps. ✓
//   cost := steps <= maxSteps. ✓
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm,
  "Output only a SQL SELECT query. Use exact column and table names from the schema. Keep the query simple and direct. Do not add unnecessary JOINs or subqueries.");

var steps: nat := 0;

// Phase 1: Open the constrained span immediately (emits "<<").
if !insideConstrainedOut {
  if steps < maxSteps {
    var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
    generated := og;
    insideConstrainedOut := oi;
    currentConstrainedOut := oc;
    steps := steps + 1;
  }
}

// Phase 2: Generate constrained SQL using group-boosted constrained steps.
// Reserve the last 30 steps for CloseSpanWithinBudget.
var closeReserve: nat := 30;
if maxSteps <= 30 {
  closeReserve := if maxSteps > 1 then maxSteps - 1 else 0;
}

while insideConstrainedOut && steps < maxSteps - closeReserve
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - closeReserve - steps
{
  // Check if the span is complete and can be closed.
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else {
    // Use adaptive constrained step with group boosting to prefer schema-correct tokens.
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 6.0, 50, eosToken
    );
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Phase 3: Use CloseSpanWithinBudget to advance to completable state and emit ">>".
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

