//   raw text, not from a constrained span.
// - "Examples with unmatched visible close: 124/128" — ">>" appears without "<<"
//
// Root cause: The evaluator extracts the answer from a VISIBLE span "<<...>>". But our
// strategy produces hidden constrained spans (no visible "<<" in the output). The
// constrained content is parser-valid but extracted via text_fallback.
//
// The best approach (Attempt 15) achieved 26% accuracy and 97.3% syntax.
// The failures are: syntax_valid_semantic_mismatch=214 — semantically wrong but syntactically valid.
//
// To improve accuracy from 26% to 38%, we need better semantic grounding.
// The primary failure mode is "other_observed_failure" (98 examples) where the SQL is
// syntactically valid but semantically wrong (wrong tables/columns/joins/conditions).
//
// Key insight from rollouts:
// 1. "SELECT DISTINCT s.country FROM singer s JOIN singer_in_concert ... WHERE s.age > 20"
//    vs correct "SELECT DISTINCT country FROM singer WHERE age > 20"
//    The model adds unnecessary JOINs.
// 2. "SELECT d.document_id FROM documents d JOIN templates t ..." 
//    vs correct "SELECT document_id FROM paragraphs GROUP BY document_id HAVING COUNT(*) BETWEEN 1 AND 2"
//    The model ignores the HAVING clause requirement.
// 3. Repetition loops appear in some examples.
//
// The current strategy uses RegenerateUnitOnGroundingFailure which should help with
// schema grounding. But the main issue is that the model generates overly complex SQL
// with unnecessary JOINs and aliases.
//
// Strategy improvements:
// 1. Keep the best structure (Attempt 15): Phase 0 unconstrained + Phase 1 grounded + Phase 2 close
// 2. Add RepetitionPenaltyStep inside Phase 1 to address repetition loops
//    BUT: RegenerateUnitOnGroundingFailure already handles the generation internally
// 3. Use stronger guidance that discourages unnecessary JOINs
// 4. Key change: Use RegenerateUnitOnCheckFailure instead of RegenerateUnitOnGroundingFailure
//    to check each completed unit against schema-extracted allowed names
//    (more targeted than SpanGrounded)
// 5. Keep Phase 0 limit at 25 steps (was working for syntax)
// 6. Keep budget split at 3/4 for Phase 1, 1/4 for Phase 2
//
// Actually, the core problem may be that we're generating too long/complex queries.
// The guidance should strongly encourage simple direct SQL.
//
// Looking at the best attempt: it uses RegenerateUnitOnGroundingFailure and achieves
// 26% accuracy. The semantic mismatch comes from complex JOINs when simple queries suffice.
//
// New approach: use RegenerateUnitOnCheckFailure with allowed names extracted from prompt.
// This gives explicit unit-level checking against the schema context.
// The prompt contains table names, column names, etc. that we can extract.
//
// Budget: 200 steps total, stepTokenBudget = 1
// Phase 0: up to 20 steps (unconstrained prefix)
// Phase 1: remaining * 3/4 for grounded generation 
// Phase 2: remaining * 1/4 for close
//
// Additional improvement: use stronger repetition penalty within Phase 1 by
// using the combined approach. But RegenerateUnitOnGroundingFailure already
// embeds dead-end avoidance.
//
// Let's try: keep Attempt 15's structure but add better guidance emphasizing
// simplicity, and bump up the grounding fraction slightly.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   Phase 0 (unconstrained loop): insideConstrainedOut becomes true only when
//     next == "<<", setting currentConstrainedOut := [] which is valid by
//     parser.IsValidPrefix([]) precondition. Vacuous when insideConstrainedOut is false.
//     OpenConstrainedSpan (if called) sets currentConstrainedOut := [] (valid).
//   Phase 1 (RegenerateUnitOnGroundingFailure): postcondition guarantees
//     resultConstrained is always parser-valid. We assign currentConstrainedOut := filled,
//     and generated := stablePrefix + filled, so parser_validity is maintained.
//   Phase 2 (CloseSpanWithinBudget): postcondition guarantees
//     insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut).
//     When it closes the span, insideConstrainedOut := false making the implication vacuous.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   Phase 0: each iteration increments steps by 1, appends at most one token (EOS skips).
//     OpenConstrainedSpan increments steps by 1 and appends "<<" to generated. Bound held.
//   Phase 1: fillBudget = (maxSteps - steps) * 3 / 4. RegenerateUnitOnGroundingFailure
//     cost is bounded by (maxRetries+1)*maxStepsPerUnit. We pass fillBudget as both
//     maxStepsPerUnit and maxRollbackBudget. We charge steps += fillBudget conservatively.
//     |generated| = |stablePrefix| + |filled|. Since |stablePrefix| = |generated_old| - 
//     |currentConstrainedOut_old| and |filled| <= |currentConstrainedOut_old| + fillBudget,
//     |generated_new| <= |generated_old| + fillBudget <= |generatedPrefix| + steps_new.
//   Phase 2: closeBudget = maxSteps - steps. CloseSpanWithinBudget postcondition:
//     |generatedOut| <= |generated| + closeBudget. Setting steps := maxSteps gives
//     |generated| <= |generatedPrefix| + maxSteps = |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Task guidance: instruct the model to produce simple, direct SQL using only schema names
helpers.AppendTaskGuidance(lm, "Output exactly: SQL: <<SELECT columns FROM table WHERE condition>> using only the provided schema table and column names. Write the simplest correct SQL query. Do not use aliases or unnecessary JOINs. Do not add any text after >>.");

// Phase 0: generate unconstrained tokens until we observe "<<"
// Limit Phase 0 to at most 25 steps so we preserve budget for constrained generation
var phase0Limit: nat := if maxSteps > 25 then 25 else maxSteps;
while steps < phase0Limit && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases phase0Limit - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// If Phase 0 ended without opening a span and budget remains, force open one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 1: grounded constrained generation using RegenerateUnitOnGroundingFailure
// Allocate 3/4 of remaining budget to grounded generation
if insideConstrainedOut && steps < maxSteps {
  var rem: nat := maxSteps - steps;
  var fillBudget: nat := rem * 3 / 4;
  if fillBudget >= 1 {
    var stable := generated[..|generated| - |currentConstrainedOut|];
    var filled := helpers.RegenerateUnitOnGroundingFailure(
      lm, parser, prompt + stable, currentConstrainedOut, eosToken,
      fillBudget, 3, fillBudget
    );
    generated := stable + filled;
    currentConstrainedOut := filled;
    steps := steps + fillBudget;
  }
}

// Phase 2: close the span within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  var cg2, ci2, cc2 := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg2;
  insideConstrainedOut := ci2;
  currentConstrainedOut := cc2;
  steps := maxSteps;
}

cost := steps;


