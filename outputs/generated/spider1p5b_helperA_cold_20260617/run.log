Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for Spider dataset.
//
// The verification error is that the progress postcondition cannot be proved:
//   maxSteps == 0 || cost > 0 || generated != generatedPrefix ||
//   insideConstrainedOut != insideConstrained || currentConstrainedOut != currentConstrained
//
// When maxSteps > 0, we must show cost > 0 OR some state changed.
// The fix: ensure cost > 0 whenever maxSteps > 0, by always taking at least one step
// when maxSteps > 0. We guarantee this by the structure: if maxSteps > 0, we
// enter the loop at least once (since steps=0 < maxSteps), and each loop iteration
// increments steps, so cost = steps >= 1 after the loop.
//
// Strategy:
// 1. AppendTaskGuidance with SQL instruction
// 2. Combined loop: unconstrained until "<<", then constrained with repetition penalty
//    and CloseSpanIfComplete checks
// 3. CloseSpanWithinBudget to force closure at end if still open
//
// The key insight for the progress postcondition: a single loop that always takes
// at least one step when maxSteps > 0 trivially satisfies cost > 0.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside-span branch: implication is vacuous. When next == "<<", we set
//     currentConstrainedOut := [], which is valid by precondition parser.IsValidPrefix([]).
//   CloseSpanIfComplete branch: when closed==true, sets insideConstrainedOut := false
//     (vacuous) and currentConstrainedOut := []. When closed==false, state unchanged.
//   SafeRepetitionPenaltyStep branch: returns EOS or a parser-valid next token.
//     AppendConstrainedToken preserves parser.IsValidPrefix(currentConstrainedOut).
//   CloseSpanWithinBudget: returns either closed span or still-open valid prefix.
//
// progress:
//   Main loop: each iteration increments steps by 1 and appends at most one visible
//     token, so |generated| <= |generatedPrefix| + steps throughout. When maxSteps > 0,
//     the loop body executes at least once, so cost = steps >= 1 after exit, satisfying
//     the progress postcondition (cost > 0 branch).
//   CloseSpanWithinBudget: uses at most closeBudget <= maxSteps - steps steps and
//     guarantees |generated| grows by at most closeBudget, so total is bounded by maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate exactly one SQL query. Output format: SQL: <<your SQL query here>>. Use only schema tables and columns. No markdown, no explanation.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Main generation loop: handles both unconstrained and constrained phases
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    // Check if we should close the span
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Use repetition penalty to avoid repetitive SQL token loops
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken
      );
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Force closure if still inside span using CloseSpanWithinBudget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg2, ci2, cc2 := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg2;
  insideConstrainedOut := ci2;
  currentConstrainedOut := cc2;
  steps := maxSteps;
}

cost := steps;

