Strategy: // CSD_RATIONALE_BEGIN
// SQL generation CSD for Spider dataset. Key lessons from prior attempts:
// 1. The model enters "<<" too early (1 unconstrained token then immediately "<<").
//    We need more unconstrained prefix tokens ("SQL: ") before opening the span.
// 2. Many spans are syntactically invalid (unclosed strings, bad tokens like {}).
//    We must use RegenerateUnitOnGroundingFailure inside the span to catch bad units.
// 3. Some spans are unterminated. Use CloseSpanWithinBudget to guarantee closure.
// 4. Semantic accuracy is the main gap (148 syntax-valid but wrong answers).
//    Use RegenerateUnitOnGroundingFailure to ground identifiers in schema context.
//
// Strategy:
//   Phase 0: Free unconstrained generation. We force at least a few unconstrained 
//     steps before allowing the span to open, so the model can emit "SQL: " prefix.
//     We monitor if the model naturally emits "<<" and enter the span then.
//     If after several steps no "<<" has appeared, we manually open the span.
//   Phase 1: Inside constrained span, use RegenerateUnitOnGroundingFailure to
//     generate grammar-valid, schema-grounded SQL units. After generating enough
//     content, use CloseSpanWithinBudget to guarantee closure.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 0 (unconstrained): insideConstrainedOut is false, implication vacuous.
//     When next == "<<" we set currentConstrainedOut := [] which is parser-valid
//     by precondition. When we call OpenConstrainedSpan, it sets currentConstrainedOut := []
//     which is also parser-valid.
//   Phase 1 (constrained via RegenerateUnitOnGroundingFailure): this helper
//     returns a parser-valid prefix by contract. After the helper, we set
//     currentConstrainedOut := resultConstrained which is parser-valid.
//   CloseSpanWithinBudget: returns insideConstrainedOut false with currentConstrainedOut == []
//     (implication vacuous) or a still-open valid prefix, both satisfying the invariant.
//
// progress:
//   Phase 0: each unconstrained step increments steps by 1 and appends at most 1 token.
//   Phase 1 (RegenerateUnitOnGroundingFailure): bounded by (maxRetries+1)*maxStepsPerUnit;
//     we track stepsUsed and add to steps. The generated output grows by at most stepsUsed
//     tokens (visible growth <= token budget consumed). We update generated and
//     currentConstrainedOut from the returned constrained prefix.
//   CloseSpanWithinBudget: costs at most closeBudget steps, and we set steps := maxSteps
//     afterward to prevent further loop iterations, satisfying |generated| <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate exactly one SQL query. Output: SQL: <<your SQL query here>>. Use only schema tables and columns. No markdown, no explanation.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
// How many unconstrained steps to allow before forcing span open
var minUnconstrainedSteps: nat := 8;
var unconstrainedCount: nat := 0;

// Phase 0: unconstrained generation until "<<" is observed or budget used
while steps < maxSteps && !insideConstrainedOut && unconstrainedCount < minUnconstrainedSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  unconstrainedCount := unconstrainedCount + 1;
  if next == eosToken {
    break;
  } else {
    generated := generated + [next];
    if next == "<<" {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  }
}

// If no span opened yet after the unconstrained prefix, continue unconstrained
// until the model naturally emits "<<" or budget runs out
while steps < maxSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  } else {
    generated := generated + [next];
    if next == "<<" {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  }
}

// Phase 1: Inside constrained span - use grounding-based regeneration
// Reserve budget for closing the span
if insideConstrainedOut && steps < maxSteps {
  // Reserve steps for closing
  var reserveForClose: nat := 30;
  var innerBudget: nat := if maxSteps - steps > reserveForClose then maxSteps - steps - reserveForClose else 0;

  if innerBudget > 0 {
    // Use RegenerateUnitOnGroundingFailure to generate schema-grounded SQL
    var maxStepsPerUnit: nat := 20;
    var maxRetries: nat := 3;
    var maxRollbackBudget: nat := 10;
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    
    // Each call costs at most (maxRetries+1)*maxStepsPerUnit steps
    // We call it in a loop limited by innerBudget
    var innerStepsUsed: nat := 0;
    var maxInnerCalls: nat := innerBudget / (if (maxRetries + 1) * maxStepsPerUnit > 0 then (maxRetries + 1) * maxStepsPerUnit else 1);
    if maxInnerCalls < 1 { maxInnerCalls := 1; }
    
    var callsDone: nat := 0;
    while callsDone < maxInnerCalls && steps + innerStepsUsed < maxSteps - reserveForClose && insideConstrainedOut
      invariant lm.ValidTokensIdsLogits()
      invariant !insideConstrainedOut ==> currentConstrainedOut == []
      invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
      invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
      invariant |generated| <= |generatedPrefix| + steps + innerStepsUsed
      invariant steps + innerStepsUsed <= maxSteps
      decreases maxInnerCalls - callsDone
    {
      var stepsBeforeCall := cost;
      var resultConstrained := helpers.RegenerateUnitOnGroundingFailure(
        lm, parser, constrainedPrompt, currentConstrainedOut, eosToken,
        maxStepsPerUnit, maxRetries, maxRollbackBudget
      );
      var stepsAfterCall := cost;
      var usedThisCall: nat := if stepsAfterCall > stepsBeforeCall then stepsAfterCall - stepsBeforeCall else 0;
      
      if resultConstrained == currentConstrainedOut {
        // No progress - stop to avoid infinite loop
        callsDone := maxInnerCalls;
      } else {
        // Update state: reconstruct generated from stable prefix + new constrained
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        if |stablePrefix| + |resultConstrained| <= |generated| + usedThisCall {
          generated := stablePrefix + resultConstrained;
          currentConstrainedOut := resultConstrained;
        }
        innerStepsUsed := innerStepsUsed + usedThisCall;
        callsDone := callsDone + 1;
        
        // If parser is complete, stop inner loop
        if parser.IsCompletePrefix(currentConstrainedOut) {
          callsDone := maxInnerCalls;
        }
      }
    }
    steps := steps + innerStepsUsed;
  }

  // Close the span using CloseSpanWithinBudget
  if insideConstrainedOut && steps < maxSteps {
    var closeBudget := maxSteps - steps;
    var cg, ci, cc := helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
    );
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := maxSteps;
  }
}

cost := steps;

