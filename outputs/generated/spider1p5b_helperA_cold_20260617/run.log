Strategy: // CSD_RATIONALE_BEGIN
// SQL generation CSD for the spider dataset.
// The strategy emits "SQL: " as free unconstrained tokens, then opens a
// visible constrained span "<<" and generates a valid SQL query inside it
// using adaptive constrained decoding with group boosts and repetition
// penalties to steer the model toward schema-grounded identifiers.
// State tracked:
//   - insideConstrainedOut / currentConstrainedOut: span open/content
//   - steps: token budget consumed
//   - phase: 0=unconstrained prefix, 1=inside constrained SQL span
// The parser enforces SQL grammar validity throughout the constrained span.
// Adaptive decoding uses validTokenGroups (schema tokens) as soft boosts
// and repetition penalties to avoid degenerate loops.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 0 (unconstrained): insideConstrainedOut starts false; we only set
//   it true when next == "<<" and simultaneously set currentConstrainedOut := []
//   which satisfies parser.IsValidPrefix([]) by precondition.
//   Phase 1 (constrained): AdaptiveConstrainedStep returns EOS or a parser-valid
//   next token; AppendConstrainedToken preserves parser.IsValidPrefix.
//   CloseConstrainedSpan is called only when parser.IsCompletePrefix holds, and
//   it sets insideConstrainedOut := false, making the implication vacuous.
//   SafeRepetitionPenaltyStep also returns EOS or parser-valid token.
// progress:
//   Every branch increments steps by exactly 1. The unconstrained branch appends
//   at most one token to generated. The constrained branch appends at most one
//   token via AppendConstrainedToken or nothing (EOS path). CloseConstrainedSpan
//   appends ">>" (one token) and costs one step. Therefore
//   |generated| <= |generatedPrefix| + steps holds throughout.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a single valid SQL query answering the question. Output format: SQL: <<YOUR QUERY>>. Use only tables and columns from the provided schema. No explanation.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next := eosToken;
    if validCount <= 12 {
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, eosToken
      );
    } else {
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

