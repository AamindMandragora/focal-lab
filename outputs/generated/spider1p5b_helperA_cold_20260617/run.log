Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for Spider dataset (attempt 2).
//
// Key observations from attempt 1:
// 1. "entered_constrained_mode_too_early": The model enters "<<" almost immediately
//    (avg 1 token before first open), meaning the unconstrained preamble is just
//    the delimiter itself. This is actually fine — the model naturally outputs
//    "SQL: <<..." — but we need to ensure the constrained span content is correct.
//
// 2. "malformed_constrained_content" (27 examples): The constrained span was opened
//    and closed but the SQL inside was syntactically invalid (e.g. unbalanced parens,
//    trailing semicolons, etc.). This means the parser is not enforcing hard SQL
//    grammar strictly enough, or we're not waiting for a complete parse before closing.
//
// 3. "missing_constrained_segment" (18 examples): No "<<" appeared. We need stronger
//    guidance to force the model to emit the delimiter pattern.
//
// 4. "unterminated_constrained_segment" (2 examples): Span opened but not closed.
//    This suggests EOS fired before the parser reached IsCompletePrefix.
//    Fix: use CloseSpanWithinBudget to force closure within remaining budget.
//
// 5. Semantic accuracy (137 syntax-valid but wrong): The model is generating plausible
//    but incorrect SQL. Use RegenerateUnitOnGroundingFailure to keep SQL tokens
//    grounded in the prompt schema context.
//
// Strategy:
// Phase 0: Unconstrained generation until "<<" is observed (expect ~1-2 tokens).
//          Use AppendTaskGuidance to strongly reinforce the "SQL: <<...>>" format.
// Phase 1: Inside the constrained span, use RegenerateUnitOnGroundingFailure to
//          generate parser-valid, schema-grounded SQL tokens.
//          After RegenerateUnitOnGroundingFailure, the result is in currentConstrainedOut.
// Phase 2: Close the span reliably using CloseSpanWithinBudget.
//
// This addresses all 4 failure modes:
// - missing_constrained_segment: stronger guidance + forced "SQL: <<"
// - malformed_constrained_content: hard parser control via RegenerateUnitOnGroundingFailure
// - unterminated: CloseSpanWithinBudget ensures closure
// - semantic errors: grounding check via RegenerateUnitOnGroundingFailure
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   Phase 0 (unconstrained): insideConstrainedOut is false, implication vacuous.
//     When next == "<<", we set currentConstrainedOut := [] and parser.IsValidPrefix([])
//     holds by method precondition.
//   Phase 1 (RegenerateUnitOnGroundingFailure): This helper returns resultConstrained
//     which is always parser-valid by its postcondition. We assign currentConstrainedOut
//     := resultConstrained, preserving the invariant.
//   Phase 2 (CloseSpanWithinBudget): Returns (cg, ci, cc) where
//     !ci ==> cc == [] and ci ==> parser.IsValidPrefix(cc), so the invariant holds
//     in both the closed and open-but-valid cases.
//
// progress invariant: |generated| <= |generatedPrefix| + steps
//   Phase 0: Each UnconstrainedStep increments steps by 1 and appends at most 1 token.
//     So |generated| increases by at most 1 per iteration, matching steps increase.
//   Phase 1: RegenerateUnitOnGroundingFailure returns resultConstrained with
//     |resultConstrained| <= |currentConstrainedOut| + budget where budget <=
//     maxSteps - steps. We reconstruct generated as stablePrefix + resultConstrained.
//     Since |generated| = |stablePrefix| + |resultConstrained| <= |stablePrefix| +
//     |currentConstrainedOut| + budget = (prior |generated|) + budget, and we set
//     steps := steps + budget, the invariant |generated| <= |generatedPrefix| + steps holds.
//   Phase 2: CloseSpanWithinBudget postcondition gives |cg| <= |generated| + closeBudget
//     where closeBudget = maxSteps - steps. Setting steps := maxSteps gives
//     |generated| <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Strong guidance to force "SQL: <<query>>" format
var guidance: string := "Output exactly: SQL: <<YOUR SQL QUERY HERE>> with no explanation, no markdown, no semicolons. The SQL query must go between << and >>. Use only tables and columns from the schema provided.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 0: Unconstrained generation until we see "<<" or EOS
while steps < maxSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// Phase 1: Inside constrained span - use grounding to generate valid SQL
if insideConstrainedOut && steps < maxSteps {
  // Reserve budget for the constrained generation and span closure
  // Leave at least 1 step for CloseSpanWithinBudget
  var groundingBudget: nat := if maxSteps - steps > 1 then maxSteps - steps - 1 else 0;
  
  if groundingBudget > 0 {
    // Use RegenerateUnitOnGroundingFailure for schema-grounded SQL generation
    var resultConstrained := helpers.RegenerateUnitOnGroundingFailure(
      lm, parser, prompt, currentConstrainedOut, eosToken,
      20, 3, 10
    );
    
    // Reconstruct generated from stable prefix + new constrained content
    var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
    
    // Update state: resultConstrained is always parser-valid
    currentConstrainedOut := resultConstrained;
    generated := stablePrefix + resultConstrained;
    
    // Account for budget used - we used at most groundingBudget steps
    // We must be conservative: add groundingBudget to steps
    steps := steps + groundingBudget;
  }
}

// Phase 2: Close the span reliably within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

