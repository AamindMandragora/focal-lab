Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for Spider dataset.
//
// Key diagnosis from failure analysis:
// 1. "entered_constrained_mode_too_early" (274/300): The model outputs "SQL: <<"
//    as its very first token(s), but we need to let it emit "SQL: " freely first,
//    then ONLY enter constrained mode when "<<" actually appears. This is already
//    happening, but the model tends to emit "<<" immediately after "SQL: ".
//    The real issue is that the constrained span content is being generated with
//    just AdaptiveConstrainedStep but the SQL queries are syntactically malformed
//    (semicolons, braces, markdown, etc.).
//
// 2. "malformed_constrained_content" (22/300): SQL inside << >> contains
//    semicolons, braces, markdown, or other characters. We need harder parser
//    control with CloseSpanWithinBudget to ensure the span closes cleanly.
//
// 3. "unterminated_constrained_segment" (8/300): Span opened but never closed.
//    CloseSpanWithinBudget at the end of the loop fixes this.
//
// 4. "no_span_emitted" (25/300): Model never emits "<<". Better task guidance
//    and a forced OpenConstrainedSpan after seeing "SQL: " may help.
//
// Strategy changes from best attempt:
// - Use SafeRepetitionPenaltyStep instead of AdaptiveConstrainedStep to reduce
//   repetitive loops in SQL generation (seen in many wrong examples).
// - After the main loop, if still inside constrained span, use CloseSpanWithinBudget
//   to force closure with remaining budget.
// - Better task guidance that emphasizes the << >> format requirement.
// - If model never opens a span (no "<<" emitted), after a reasonable number of
//   unconstrained steps we force-open a constrained span with OpenConstrainedSpan.
//
// The key insight: use SafeRepetitionPenaltyStep for constrained content to avoid
// the repetitive token traps that are causing syntactically invalid SQL.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside-span branch: implication is vacuous. When next == "<<", we set
//     currentConstrainedOut := [] which satisfies parser.IsValidPrefix([]) by
//     precondition. OpenConstrainedSpan also resets currentConstrainedOut := [].
//   CloseConstrainedSpan branch: sets insideConstrainedOut := false (vacuous).
//   SafeRepetitionPenaltyStep branch: returns EOS or parser-valid token.
//     AppendConstrainedToken extends currentConstrainedOut by one valid token,
//     preserving parser.IsValidPrefix(currentConstrainedOut).
//   CloseSpanWithinBudget: its postcondition guarantees either closed span
//     (insideConstrainedOut false) or still-open valid prefix (IsValidPrefix holds).
//
// progress:
//   Every loop iteration increments steps by exactly 1 and appends at most one
//   visible token. Therefore |generated| <= |generatedPrefix| + steps.
//   OpenConstrainedSpan costs 1 step and appends "<<" (one token), maintaining bound.
//   CloseSpanWithinBudget uses at most closeBudget = maxSteps - steps steps and
//   appends at most closeBudget tokens, so total stays within maxSteps.
//   When maxSteps > 0, the loop body executes at least once (steps starts at 0),
//   so cost = steps >= 1 after exit (cost > 0 branch of progress postcondition).
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate exactly one SQL query. Output MUST use format: SQL: <<query>>. Put only the SQL between << and >>. No semicolons, no markdown, no explanation. Use only schema tables and columns.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
// Track how many unconstrained steps taken without opening a span
var unconstrainedSteps: nat := 0;
// Force-open threshold: if we've taken this many unconstrained steps without
// entering a span, force open one
var forceOpenThreshold: nat := 8;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Check if we should force-open a span
    if unconstrainedSteps >= forceOpenThreshold {
      // Force open a constrained span
      var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
      generated := og;
      insideConstrainedOut := oi;
      currentConstrainedOut := oc;
      steps := steps + 1;
      unconstrainedSteps := 0;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      unconstrainedSteps := unconstrainedSteps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
          unconstrainedSteps := 0;
        }
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    // After closing the span, we're done - break to avoid generating more
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.5, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// If still inside span after main loop, force close with remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg2, ci2, cc2 := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg2;
  insideConstrainedOut := ci2;
  currentConstrainedOut := cc2;
  steps := maxSteps;
}

cost := steps;

