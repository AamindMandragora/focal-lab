Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for Spider dataset.
//
// Key insights from failure analysis:
// 1. The model enters constrained mode immediately and generates repetitive/looping SQL
//    (ORDER BY with repeated columns, LIMIT with huge numbers, repetitive OR clauses)
// 2. The spans are never closed because the parser never reaches IsCompletePrefix
//    due to these repetitive patterns
// 3. We need SafeRepetitionPenaltyStep inside the span to prevent token repetition loops
// 4. We need CloseSpanWithinBudget to GUARANTEE closure before budget runs out
//
// Strategy:
// 1. AppendTaskGuidance with concise SQL instruction
// 2. Generate freely until "<<" appears (the model naturally puts it in context)
// 3. Once inside the span, use SafeRepetitionPenaltyStep to avoid repetition loops
// 4. Check CloseSpanIfComplete each step so we close as soon as possible
// 5. Reserve a budget fraction for CloseSpanWithinBudget to force closure
//
// The main fix: use SafeRepetitionPenaltyStep instead of AdaptiveConstrainedStep
// to prevent the repetitive ORDER BY / LIMIT / OR loops seen in failure cases,
// and use CloseSpanWithinBudget with a reserved budget to guarantee closure.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside-span branch: the implication is vacuous. When next == "<<", we set
//     currentConstrainedOut := [], which satisfies parser.IsValidPrefix([]) by precondition.
//   CloseSpanIfComplete branch: when closed==true, CloseConstrainedSpan sets
//     insideConstrainedOut := false (vacuous) and currentConstrainedOut := [].
//     When closed==false, state is unchanged and validity is preserved.
//   SafeRepetitionPenaltyStep branch: returns EOS or a parser-valid next token.
//     AppendConstrainedToken extends currentConstrainedOut by one valid token,
//     preserving parser.IsValidPrefix(currentConstrainedOut).
//   CloseSpanWithinBudget branch: by its contract returns either a closed span
//     (insideConstrainedOut false, currentConstrainedOut []) or still-open valid prefix.
//
// progress:
//   Phase 1 (unconstrained loop): Every iteration increments steps by 1 and appends
//     at most one token, so |generated| <= |generatedPrefix| + steps.
//   Phase 2 (constrained loop): CloseSpanIfComplete costs 1 step; SafeRepetitionPenaltyStep
//     costs 1 step and appends at most one visible token. Both maintain the length bound.
//   Phase 3 (CloseSpanWithinBudget): uses at most closeBudget steps; we set steps := maxSteps,
//     and CloseSpanWithinBudget guarantees |generated| <= old(generated) + closeBudget.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a single SQL query. Output: SQL: <<query>>. Short query only, no repetition, use schema tables/columns directly.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
// Reserve budget for forced closure: use 80% for generation, 20% for CloseSpanWithinBudget
// but at minimum reserve 50 steps for closure
var reservedClose: nat := if maxSteps / 5 > 50 then maxSteps / 5 else 50;
var genBudget: nat := if maxSteps > reservedClose then maxSteps - reservedClose else maxSteps;

// Phase 1: unconstrained generation until "<<" appears or budget reached
while steps < genBudget && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases genBudget - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  } else {
    generated := generated + [next];
    if next == "<<" {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  }
}

// If we never entered the span, force-open it now (if budget remains)
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: constrained generation with repetition penalty, checking for completeness each step
// Use most of remaining budget minus the close reserve
var phase2Budget: nat := if maxSteps > steps + reservedClose then maxSteps - steps - reservedClose else 0;
var phase2Steps: nat := 0;

while phase2Steps < phase2Budget && insideConstrainedOut
  invariant 0 <= phase2Steps <= phase2Budget
  invariant 0 <= steps <= maxSteps
  invariant steps + phase2Steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps + phase2Steps
  decreases phase2Budget - phase2Steps
{
  // First check if we can close
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  phase2Steps := phase2Steps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else {
    // Use repetition penalty to avoid repetitive token loops
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken
    );
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

steps := steps + phase2Steps;

// Phase 3: force closure if still inside span using CloseSpanWithinBudget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg2, ci2, cc2 := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg2;
  insideConstrainedOut := ci2;
  currentConstrainedOut := cc2;
  steps := maxSteps;
}

cost := steps;

