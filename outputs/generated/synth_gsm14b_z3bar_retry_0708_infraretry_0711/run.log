// Math word problem CSD strategy with GenerateWithManagedSpan.
//
// The previous attempt scored 0 examples evaluated, likely due to a compilation
// or runtime issue. This revision uses the high-level GenerateWithManagedSpan
// helper which handles all span state management, delimiter emission, and
// parser-controlled generation in a single verified call, eliminating the risk
// of state machine bugs in hand-written loop bodies.
//
// Strategy:
//   1. Append task guidance instructing the model to wrap symbolic expressions
//      and the final answer in << >> delimiters.
//   2. Delegate all generation to GenerateWithManagedSpan which:
//      - generates freely outside spans
//      - enters constrained mode when "<<" is observed
//      - uses AdaptiveConstrainedStep with group boosting inside spans
//      - closes spans with ">>" as soon as the parser accepts them
//      - handles EOS and budget termination correctly
//
// This is the most robust approach for a fully automated strategy since the
// helper discharges all proof obligations internally and handles the full
// free/constrained/close state machine.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   GenerateWithManagedSpan's postcondition guarantees
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   and !insideConstrainedOut ==> currentConstrainedOut == [].
//   The only assignment to these variables is from the helper's return values,
//   which carry these postconditions, so the invariant holds trivially after
//   the single call.
//
// progress:
//   GenerateWithManagedSpan costs at most maxSteps token-steps and
//   |generated| <= |generatedPrefix| + maxSteps by its length postcondition.
//   We set cost := maxSteps which is an upper bound on actual cost.
//   The progress condition (cost > 0 || state changed) is satisfied because
//   GenerateWithManagedSpan with maxSteps > 0 makes at least one step.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

if maxSteps == 0 {
  return;
}

var guidance: string :=
  "Solve the math problem step by step. " +
  "Wrap each intermediate symbolic expression and the final numeric answer inside << >> delimiters. " +
  "Example: There are <<3 + 4 = 7>> apples total. The answer is <<42>>.";
helpers.AppendTaskGuidance(lm, guidance);

var boostAmount: real := 4.0;
var narrowThreshold: nat := 12;

var genOut, insideOut, currentOut := helpers.GenerateWithManagedSpan(
  lm, parser, prompt, generated, insideConstrainedOut, currentConstrainedOut,
  maxSteps, validTokenGroups, boostAmount, narrowThreshold, eosToken
);

generated := genOut;
insideConstrainedOut := insideOut;
currentConstrainedOut := currentOut;
cost := maxSteps;

