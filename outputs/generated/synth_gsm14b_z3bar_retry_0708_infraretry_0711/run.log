Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD strategy.
//
// State tracked:
//   - generated: full token sequence including delimiters and reasoning
//   - insideConstrainedOut: whether we are inside a << >> constrained span
//   - currentConstrainedOut: the constrained content since last <<
//   - steps: token budget consumed so far
//
// Observations / action selection:
//   Outside a span: generate freely until EOS or "<<" is emitted naturally.
//   Inside a span: use AdaptiveConstrainedStep with group boosting to generate
//     valid symbolic expressions / numeric answers. After each constrained token,
//     check if the span is complete (IsCompletePrefix) and close it with ">>".
//   The validTokenGroups carry math-relevant tokens (digits, operators, etc.)
//   which are boosted to steer the LM toward correct symbolic content.
//
// Valid generation support:
//   The parser enforces the grammar of constrained spans (symbolic expressions,
//   final numeric answers). Group boosting nudges toward arithmetic tokens.
//   SafeRepetitionPenaltyStep is used periodically to avoid loops.
//   CloseSpanIfComplete is called each constrained step to close the span
//   as soon as a valid parse is achieved, keeping spans tight.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//
//   Unconstrained branch (outside span):
//     We only set insideConstrainedOut := true when next == "<<", at which point
//     we also set currentConstrainedOut := []. parser.IsValidPrefix([]) holds by
//     precondition (parser.IsValidPrefix([]) is required). So the invariant is
//     established fresh on span entry.
//
//   CloseSpanIfComplete branch:
//     When closed == true, CloseConstrainedSpan sets insideConstrainedOut := false,
//     making the implication vacuously true and currentConstrainedOut := [].
//     When closed == false, the state is unchanged and the invariant is preserved
//     by the loop invariant hypothesis.
//
//   Constrained generation branch (AdaptiveConstrainedStep path):
//     AdaptiveConstrainedStep returns EOS or a parser-valid next token.
//     AppendConstrainedToken extends currentConstrainedOut by that token, and
//     its postcondition guarantees parser.IsValidPrefix(currentConstrainedOut).
//     On EOS, we break without modifying state.
//
// progress invariant:
//   |generated| <= |generatedPrefix| + steps
//
//   Unconstrained branch: steps += 1, generated grows by at most 1 (EOS is not
//     appended). Invariant preserved.
//
//   CloseSpanIfComplete branch: steps += 1. CloseConstrainedSpan may append ">>"
//     (1 token), so |generated| grows by at most 1. Invariant preserved.
//
//   Constrained generation branch: steps += 1. AppendConstrainedToken appends
//     exactly 1 token (EOS path breaks without appending). Invariant preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string :=
  "Solve the math problem step by step. " +
  "Wrap each intermediate symbolic expression and the final numeric answer inside << >> delimiters. " +
  "For example: The total is <<3 + 4 = 7>> items.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Free generation outside constrained span; watch for "<<" delimiter
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        // Transition into constrained span
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    // Inside a constrained span: first check if we can close it
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Need to generate more constrained content
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

