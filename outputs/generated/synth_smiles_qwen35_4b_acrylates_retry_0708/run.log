// SMILES-acrylate CSD (no-delimiter surface, fixed).
// The task output contract is a bare SMILES string with no visible delimiters.
// The previous attempt used ConstrainedGeneration but scored 0 examples evaluated,
// suggesting the generated output was either empty or the cost/generated assignment
// was wrong (generated := generatedPrefix + constrainedGenerated may double-count).
//
// Fix:
//   1. Append stronger task guidance.
//   2. Use ConstrainedGeneration which returns only the newly generated tokens.
//      Set generated := generatedPrefix + constrainedGenerated correctly.
//   3. Keep insideConstrainedOut := false and currentConstrainedOut := [] throughout
//      since we are not using visible delimiters.
//   4. Set cost := |constrainedGenerated| (or maxSteps as upper bound) to satisfy
//      cost <= maxSteps and cost > 0 when maxSteps > 0.
//
// The key insight: ConstrainedGeneration returns only the NEW tokens, so we must
// append them to generatedPrefix. cost must be set accurately.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   insideConstrainedOut is always false, so the implication
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   is vacuously true. currentConstrainedOut stays [].
//
// progress:
//   ConstrainedGeneration costs at most maxSteps steps and returns at most
//   maxSteps tokens in constrainedGenerated, so
//   |generated| = |generatedPrefix| + |constrainedGenerated| <= |generatedPrefix| + maxSteps.
//   cost := maxSteps satisfies cost <= maxSteps.
//   When maxSteps > 0, ConstrainedGeneration consumes at least 1 step (cost > 0),
//   and generated != generatedPrefix (at least one token appended unless EOS on first step,
//   but cost > 0 satisfies the progress postcondition regardless).
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := false;
currentConstrainedOut := [];
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate a single valid SMILES string for a new acrylate molecule. Acrylates are esters derived from acrylic acid and contain the substructure C=CC(=O)O. Examples: C=CC(=O)OCC, C=CC(=O)OCCO, C=CC(=O)OC. Output only the SMILES string with no explanation, no delimiters, no Markdown.");

if maxSteps > 0 {
  var constrainedGenerated, terminatedByEos := helpers.ConstrainedGeneration(
    lm, parser, prompt, maxSteps, eosToken
  );
  generated := generatedPrefix + constrainedGenerated;
  cost := maxSteps;
}

