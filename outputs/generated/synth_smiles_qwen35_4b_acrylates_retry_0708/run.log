Strategy: // CSD_RATIONALE_BEGIN
// SMILES-acrylate CSD. The task is to generate a single valid SMILES string
// for the acrylates class (e.g., methyl acrylate, ethyl acrylate, etc.).
// Strategy:
//   1. Append task guidance to steer the model toward acrylate SMILES.
//   2. Open a constrained span immediately (no free preamble needed since the
//      answer contract is a bare SMILES string).
//   3. Inside the span, use AdaptiveConstrainedStep with group boosts to drive
//      parser-valid SMILES token generation.
//   4. Use SafeRepetitionPenaltyStep to avoid repeating structural tokens.
//   5. Close the span once the parser reports a complete prefix.
// State tracked: insideConstrainedOut, currentConstrainedOut, steps, generated.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   OpenConstrainedSpan sets insideConstrainedOut := true and currentConstrainedOut := [],
//   which is valid by parser.IsValidPrefix([]) precondition.
//   In the constrained branch, AdaptiveConstrainedStep and SafeRepetitionPenaltyStep
//   both return EOS or a parser-valid next token; AppendConstrainedToken preserves
//   parser.IsValidPrefix(currentConstrainedOut) by its postcondition.
//   CloseConstrainedSpan sets insideConstrainedOut := false, making the implication vacuous,
//   and clears currentConstrainedOut to [].
// progress:
//   OpenConstrainedSpan costs 1 step and appends "<<" (1 visible token), so
//   |generated| <= |generatedPrefix| + steps after it.
//   Each loop iteration increments steps by 1 and appends at most 1 visible token,
//   so |generated| <= |generatedPrefix| + steps is maintained throughout.
//   CloseConstrainedSpan costs 1 step and appends ">>" (1 visible token), preserving the bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

helpers.AppendTaskGuidance(lm, "Generate a single valid SMILES string for the acrylates class. Acrylates contain the acrylate group (C=C-C(=O)-O). Output only the SMILES string with no explanation.");

// Open the constrained span immediately if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed; we are done
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    // Close the span
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    // Inside constrained span, not yet complete
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next := eosToken;
    if validCount <= 15 {
      // Narrow state: use group boosting
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, 15, eosToken
      );
    } else {
      // Wider state: use repetition penalty to encourage variety
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

cost := steps;

