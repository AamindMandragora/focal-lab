Strategy: // CSD_RATIONALE_BEGIN
// SMILES-acrylate CSD (no-delimiter surface).
// The task output contract is a bare SMILES string with no visible delimiters.
// The parser controls the entire generation from an empty constrained prefix.
// Strategy:
//   1. Append task guidance steering the model toward acrylate SMILES.
//   2. Do NOT open a "<<" span — the evaluator expects a raw SMILES string,
//      not a delimited one. Use ConstrainedGeneration directly.
//   3. ConstrainedGeneration loops ConstrainedStep until parser completeness,
//      EOS, or budget exhaustion.
//   4. The returned generated sequence is the bare SMILES content.
// This avoids the delimiter-injection failure that caused syntax 0%.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   We never set insideConstrainedOut := true, so the implication
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   is vacuously true throughout. currentConstrainedOut stays [].
// progress:
//   ConstrainedGeneration costs at most maxSteps steps and appends at most
//   maxSteps tokens to generated, so |generated| <= |generatedPrefix| + maxSteps.
//   cost := maxSteps satisfies cost <= maxSteps. When maxSteps > 0, at least
//   one step is consumed (cost > 0), satisfying the progress postcondition.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := false;
currentConstrainedOut := [];
cost := 0;

helpers.AppendTaskGuidance(lm, "Output a single valid SMILES string for a molecule in the acrylates class. Acrylates contain the ester of acrylic acid: C=CC(=O)O fragment. Output only the SMILES string, nothing else.");

if maxSteps > 0 {
  var constrainedGenerated, terminatedByEos := helpers.ConstrainedGeneration(
    lm, parser, prompt, maxSteps, eosToken
  );
  generated := generatedPrefix + constrainedGenerated;
  cost := maxSteps;
}

