Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters.
// State tracked: generated (full visible output), insideConstrainedOut (whether
// inside a constrained span), currentConstrainedOut (content of active span),
// steps (token budget consumed).
//
// Strategy:
// - Phase 1: Generate freely until "<<" is observed (unconstrained reasoning steps).
// - Phase 2: Inside a constrained span, use AdaptiveConstrainedStep with
//   group boosts for narrow parser states, and SafeRepetitionPenaltyStep to
//   discourage loops. When the parser accepts a complete parse, call
//   CloseSpanIfComplete to emit ">>" and exit the span.
// - Phase 3: After closing a span, continue free generation (more reasoning
//   steps or final answer). The loop repeats for multiple << >> spans.
//
// This supports multi-step math problems where intermediate expressions and
// the final answer each get their own constrained span, with free reasoning
// text between spans.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - In the unconstrained branch: we only set insideConstrainedOut := true when
//     next == "<<", and we set currentConstrainedOut := [] which satisfies
//     parser.IsValidPrefix([]) by precondition. The implication is vacuous when
//     insideConstrainedOut is false.
//   - In the constrained branch with CloseSpanIfComplete: when closed == true,
//     insideConstrainedOut becomes false, making the implication vacuous, and
//     currentConstrainedOut is set to []. When closed == false, state is
//     unchanged (still valid).
//   - In the constrained step branch: AdaptiveConstrainedStep and
//     SafeRepetitionPenaltyStep both return EOS or a parser-valid next token.
//     AppendConstrainedToken preserves parser.IsValidPrefix(currentConstrainedOut).
//
// progress invariant:
//   - Every loop iteration increments steps by exactly 1.
//   - Every branch appends at most one token to generated (or closes a span
//     which may add ">>" but that is within the +1 token budget for that step).
//   - CloseSpanIfComplete costs +1 whether or not it closes.
//   - So |generated| <= |generatedPrefix| + steps holds throughout.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve math word problems step by step. Show intermediate calculations and the final answer inside << >> delimiters. For example: The cost is <<3 * 4 = 12>> dollars, so the answer is <<12>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Free generation outside constrained spans
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    // Inside a constrained span
    // First, check if we can close the span
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Generate next constrained token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var next;
      if validCount <= 12 {
        // Narrow parser state: use group boosting
        next := helpers.AdaptiveConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut,
          validTokenGroups, 4.0, 12, eosToken
        );
      } else {
        // Wider parser state: use repetition penalty to avoid loops
        next := helpers.SafeRepetitionPenaltyStep(
          lm, parser, constrainedPrompt, currentConstrainedOut,
          generated, 2.0, eosToken
        );
      }
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

