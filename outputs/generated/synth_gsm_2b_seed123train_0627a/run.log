Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters.
//
// Diagnosis from attempt 2 failures:
// 1. 10/49 examples: "final_span_unclosed" - span opened but model loops inside
//    generating repetitive content (e.g., "c3 * c1 + c3 * c2 + ...") and never
//    reaches a complete parse state before budget runs out.
// 2. 18/49 examples: syntax valid but wrong answer (semantic errors).
// 3. 2/49 examples: repetition loops inside constrained span.
//
// Root causes of unclosed spans:
// - CloseSpanWithinBudget is given too small a budget (only 50 tokens).
// - The model gets into repetition loops inside the constrained span.
// - The constrained span generates too many tokens before completing.
//
// Revised strategy:
// Phase 1: Short unconstrained chunk to let model write reasoning, cap at
//   a tighter budget (600 tokens), stopping naturally on "<<".
// Phase 2: If "<<" never appeared, force open a span.
// Phase 3: Inside the span, use SafeRepetitionPenaltyStep to avoid repetition
//   loops. Use CloseSpanWithinBudget with a generous budget (remaining steps).
//   Key change: use SafeRepetitionPenaltyStep for constrained generation to
//   break repetition cycles that cause unterminated spans.
//
// The primary fix for unterminated spans: use SafeRepetitionPenaltyStep instead
// of raw ConstrainedStep inside the span to prevent repetition loops, and give
// CloseSpanWithinBudget the full remaining budget.
//
// For semantic accuracy: use AppendTaskGuidance to strongly encourage the model
// to write the correct symbolic formula (not simplified/wrong forms).
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - Phase 1 (UnconstrainedChunk): When stoppedOnOpenSpan is true, generated
//     already ends with "<<" and we call EnterObservedConstrainedSpan which sets
//     insideConstrainedOut := true, currentConstrainedOut := [] (valid). When
//     stoppedOnEos, we return. Otherwise insideConstrainedOut remains false.
//   - Force-open branch (OpenConstrainedSpan): sets insideConstrainedOut := true,
//     currentConstrainedOut := [] (valid by precondition parser.IsValidPrefix([])).
//   - Inner constrained loop: SafeRepetitionPenaltyStep returns a parser-valid
//     next token or EOS. AppendConstrainedToken preserves parser validity.
//     CloseSpanIfComplete either closes the span (making implication vacuous) or
//     leaves state unchanged (still valid). The loop terminates when closed,
//     EOS, or budget exhausted.
//   - Final CloseSpanWithinBudget: postcondition guarantees either
//     (!insideConstrainedOut && currentConstrainedOut == []) or
//     (insideConstrainedOut && parser.IsValidPrefix(currentConstrainedOut)).
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   - Phase 1: UnconstrainedChunk costs stepsUsed and grows generated by at most
//     stepsUsed tokens. steps := steps + stepsUsed maintains the bound.
//   - Force-open: OpenConstrainedSpan costs 1 step, appends "<<" (1 token).
//     steps := steps + 1 maintains the bound.
//   - Inner loop: Each iteration increments steps by 1 (for CloseSpanIfComplete
//     or for SafeRepetitionPenaltyStep), and appends at most 1 token.
//     |generated| <= |generatedPrefix| + steps is preserved.
//   - Final CloseSpanWithinBudget with budget = maxSteps - steps guarantees
//     |generatedOut| <= |generated| + budget <= |generatedPrefix| + maxSteps.
//     Setting steps := maxSteps preserves cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math word problem step by step. After the reasoning, write ONLY the final symbolic arithmetic expression inside << >> delimiters. Use only variable names from the problem with +, -, *, /, (, ) operators. No LaTeX, no braces, no explanation inside << >>. Keep the expression short and correct. Example: <<n1 * c1 + n2 * c2>>";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate unconstrained text until "<<" is observed or budget used.
// Reserve at least 100 steps for the constrained span.
var freeChunkBudget: nat := if maxSteps > 100 then maxSteps - 100 else maxSteps / 2;

if !insideConstrainedOut && steps < freeChunkBudget {
  var chunkBudget: nat := freeChunkBudget - steps;
  var cg, stoppedOnOpenSpan, stoppedOnEos, stepsUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkBudget, "<<", eosToken);
  generated := cg;
  steps := steps + stepsUsed;
  if stoppedOnEos {
    cost := steps;
    return;
  }
  if stoppedOnOpenSpan {
    // "<<" was naturally emitted; enter constrained span state
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  }
}

// Phase 2: If still outside a constrained span (model never emitted "<<"),
// force open one explicitly.
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 3: Inside the constrained span, generate with repetition penalty to
// avoid loops, then close within budget.
// First do a bounded inner loop with repetition penalty to make progress,
// then use CloseSpanWithinBudget for the remainder.
var innerBudget: nat := if maxSteps > steps + 20 then 20 else (if maxSteps > steps then maxSteps - steps else 0);
var innerSteps: nat := 0;

while insideConstrainedOut && innerSteps < innerBudget && steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant 0 <= innerSteps <= innerBudget
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps, innerBudget - innerSteps
{
  // Try to close if complete
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  innerSteps := innerSteps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else {
    // Use repetition penalty to avoid loops
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
    );
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

// Phase 4: Use CloseSpanWithinBudget to guarantee closure on the remaining budget.
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

