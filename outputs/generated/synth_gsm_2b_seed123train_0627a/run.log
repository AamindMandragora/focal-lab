// This avoids relying on CloseSpanWithinBudget's internal budget tracking,
// which has shown to fail in practice. Instead, we check CloseSpanIfComplete
// at every step and close the moment the parser accepts the span.
while insideConstrainedOut && steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Check if we can close the span right now (completeness check first).
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else {
    // Not yet complete; generate the next constrained token.
    if steps < maxSteps {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent :=
          helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

// Phase 4: If span is still open and we have budget, use CloseSpanWithinBudget
// as a fallback to ensure the span closes (handles case where constrained loop
// exhausted budget without finding a complete state).
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

