Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters.
//
// Diagnosis from attempt 3 failures:
// - 19/49 examples: "final_span_unclosed" - the span opened (via "<<") but the
//   closing ">>" was never emitted before budget ran out.
// - The output tail shows patterns like "<<n1 * c" or "<<total - n1 * flavor"
//   which means the model started generating inside the span but ran out of
//   budget before the parser reached a completable state.
// - Best result (attempt 2) got 42.9% accuracy, 79.6% syntax.
//
// Root cause of unclosed spans:
// - The SafeRepetitionPenaltyStep approach in attempt 3 was consuming too many
//   steps in the inner loop (20 steps) leaving CloseSpanWithinBudget insufficient.
// - The unconstrained chunk budget was too large (maxSteps - 100 = 800 tokens),
//   leaving only 100 for the constrained span.
// - The model sometimes generates very long reasoning (avg 151 tokens before "<<"),
//   consuming most of the budget.
//
// Revised strategy (building on best attempt 2):
// Phase 1: Short unconstrained chunk to let model write reasoning.
//   Cap at maxSteps - 80 (leave 80 tokens for constrained phase).
//   Stop on "<<" naturally.
// Phase 2: If "<<" never appeared, force open a span.
// Phase 3: Use CloseSpanWithinBudget with ALL remaining budget.
//   This is the key fix: give the close phase the maximum possible budget.
//
// Additional improvements:
// - Better task guidance: explicitly instruct the model to emit "<<" early
//   and keep the expression simple.
// - Use a tighter free chunk budget (reserve 80 tokens, not just 50).
// - Do NOT use an inner loop before CloseSpanWithinBudget; let it handle everything.
//
// This directly mirrors attempt 2 but with a larger reserved budget for closing
// (80 instead of 50) to address the 19 unclosed span failures.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - Phase 1 (UnconstrainedChunk): When stoppedOnOpenSpan is true, generated
//     already ends with "<<" and EnterObservedConstrainedSpan sets
//     insideConstrainedOut := true, currentConstrainedOut := [] (valid).
//     When stoppedOnEos, we return early. Otherwise insideConstrainedOut remains false.
//   - Force-open branch (OpenConstrainedSpan): sets insideConstrainedOut := true,
//     currentConstrainedOut := [] (valid by precondition parser.IsValidPrefix([])).
//   - Phase 3 (CloseSpanWithinBudget): postcondition guarantees either
//     (!insideConstrainedOut && currentConstrainedOut == []) or
//     (insideConstrainedOut && parser.IsValidPrefix(currentConstrainedOut)).
//     Both branches preserve the invariant.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   - Phase 1: UnconstrainedChunk costs stepsUsed and grows generated by at most
//     stepsUsed tokens (each step appends at most 1 visible token or EOS which
//     is not appended). steps := steps + stepsUsed maintains the bound.
//   - Force-open: OpenConstrainedSpan costs 1 step, appends "<<" (1 token).
//     steps := steps + 1 maintains the bound.
//   - Phase 3: CloseSpanWithinBudget with budget = maxSteps - steps guarantees
//     |generatedOut| <= |generated| + (maxSteps - steps) <= |generatedPrefix| + maxSteps.
//     Setting steps := maxSteps preserves cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math word problem step by step. After your reasoning, write ONLY the final symbolic expression inside << >> delimiters. Use variable names from the problem with +, -, *, / operators only. No LaTeX, no braces, no text inside << >>. Keep it concise. Write << immediately when done reasoning. Example: <<n * price - discount>>";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate unconstrained text until "<<" is observed.
// Reserve 80 steps for the constrained span + closing to ensure closure.
var freeChunkBudget: nat := if maxSteps > 80 then maxSteps - 80 else maxSteps / 2;

if !insideConstrainedOut && steps < freeChunkBudget {
  var chunkBudget: nat := freeChunkBudget - steps;
  var cg, stoppedOnOpenSpan, stoppedOnEos, stepsUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkBudget, "<<", eosToken);
  generated := cg;
  steps := steps + stepsUsed;
  if stoppedOnEos {
    cost := steps;
    return;
  }
  if stoppedOnOpenSpan {
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  }
}

// Phase 2: If still outside a constrained span, force open one.
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 3: Close the constrained span within ALL remaining budget.
// Give CloseSpanWithinBudget the maximum possible budget to ensure closure.
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

