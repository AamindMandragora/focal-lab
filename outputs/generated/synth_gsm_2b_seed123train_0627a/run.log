generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math word problem step by step. At the end, write the final symbolic answer inside << >> delimiters. Keep the expression inside << >> concise and correct, using only variable names and +, -, *, / operators. Example: <<n * price + fee>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate unconstrained reasoning text, stopping on "<<" or EOS.
// Reserve 60 tokens for the constrained span closure.
var freeChunkBudget: nat := if maxSteps > 60 then maxSteps - 60 else maxSteps;

if !insideConstrainedOut && steps < freeChunkBudget {
  var chunkBudget: nat := freeChunkBudget - steps;
  var cg, stoppedOnOpenSpan, stoppedOnEos, stepsUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkBudget, "<<", eosToken);
  generated := cg;
  steps := steps + stepsUsed;
  if stoppedOnEos {
    cost := steps;
    return;
  }
  if stoppedOnOpenSpan {
    generated, insideConstrainedOut, currentConstrainedOut :=
