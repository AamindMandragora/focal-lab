//     parser.IsValidPrefix([]) by precondition. When stoppedOnEos, we return 
//     immediately with the current (unchanged) validity. Otherwise 
//     insideConstrainedOut stays false (invariant vacuously satisfied).
//   Force-open branch (OpenConstrainedSpan): sets insideConstrainedOut := true,
//     currentConstrainedOut := [] (valid by parser.IsValidPrefix([]) precondition).
//   Phase 3 (CloseSpanWithinBudget): postcondition guarantees either
//     (!insideConstrainedOut && currentConstrainedOut == []) or
//     (insideConstrainedOut && parser.IsValidPrefix(currentConstrainedOut)).
//     Both branches preserve the invariant.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   Phase 1: UnconstrainedChunk costs stepsUsed <= chunkBudget. steps += stepsUsed.
//     generated grows by at most stepsUsed tokens (EOS not appended). Preserved.
//   Force-open: OpenConstrainedSpan costs 1 step, appends "<<" (1 token).
//     steps += 1. |generated| grows by 1. Preserved.
//   Phase 3: CloseSpanWithinBudget with closeBudget = actual remaining (capped)
//     guarantees |generatedOut| <= |generated| + closeBudget.
//     steps += closeBudget (or we set steps := steps + closeBudget).
//     Final steps <= maxSteps since closeBudget = maxSteps - steps at call time.
//   Progress: maxSteps > 0 implies Phase 1 runs with chunkBudget >= 1 and
//     consumes >= 1 step. So cost > 0 whenever maxSteps > 0.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve step by step. Then write ONLY the final arithmetic expression as <<expr>> using variable names, +, -, *, /. Keep the expression SHORT (under 8 tokens). Do NOT write reasoning inside << >>. Example: <<n * price + tax>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate unconstrained reasoning, stopping at "<<" or EOS.
// Hard cap at 200 tokens to prevent repetition loops (model loops without "<<").
// Reserve at least 30 tokens for the constrained expression closure.
var hardFreeCap: nat := 200;
var minCloseReserve: nat := 30;
var freeChunkBudget: nat;
if maxSteps > minCloseReserve {
  var available: nat := maxSteps - minCloseReserve;
  freeChunkBudget := if available < hardFreeCap then available else hardFreeCap;
} else {
  freeChunkBudget := 0;
}

if !insideConstrainedOut && steps < freeChunkBudget {
  var chunkBudget: nat := freeChunkBudget - steps;
  var cg, stoppedOnOpenSpan, stoppedOnEos, stepsUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkBudget, "<<", eosToken);
  generated := cg;
  steps := steps + stepsUsed;
  if stoppedOnEos {
