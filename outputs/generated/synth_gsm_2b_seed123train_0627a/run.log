// This means the "<<" was emitted by UnconstrainedChunk and then CloseSpanWithinBudget
// generated "n * p1 * p2 * frac / 100000000..." as the constrained content.
// The model generates "n * p1 * p2 * frac / " and then "100" as a valid number.
// But then it keeps generating "000000..." - this is a valid continuation of the
// number literal! And "100000..." is a complete expression (it's just a long number).
// CloseSpanWithinBudget should have closed after the first complete state (e.g., "n").
//
// CRITICAL BUG: CloseSpanWithinBudget says:
// "generates forward inside the span (dead-end-aware), tracking the longest prefix 
// that parses as complete; reserves one step and emits ">>" at that longest complete point"
//
// "LONGEST complete prefix" - it's tracking the LONGEST complete state, not the 
// first complete state! So if the model keeps extending "n * p1 * p2 * frac / 100",
// and each step expands the "100000..." to a longer number that's STILL complete,
// it tracks the longest one. But it needs to EMIT ">>" at the END of the budget,
// not during the generation. So it uses ALL budget tokens, then closes.
//
// With budget = 600, it generates 600 tokens of "1000000..." and then emits ">>".
// That explains the long output. And sometimes it EXHAUSTS the budget without
// reaching a closing point if the budget calculation is off by 1.
//
// ACTUAL FIX: The model needs CONCISE expressions. Use better task guidance to
// discourage long numbers, and also use a MUCH SMALLER close budget.
// If the model typically writes 5-20 token expressions, we only need ~30 steps
// for CloseSpanWithinBudget (20 content + 1 close + some slack).
//
// NEW PLAN:
// Phase 1: UnconstrainedChunk, budget = maxSteps - 50  (very small close reserve)
//   - Let model write as much reasoning as it wants, stopping at "<<".
//   - Reserve only 50 tokens for the expression itself.
// Phase 2: Force open if needed
// Phase 3: CloseSpanWithinBudget with budget = min(remaining, 50)
//   - Only 50 tokens for the expression ensures it stays concise.
//   - The parser tracks longest complete state, so it will close at a valid point.
//
// This works because:
// - The model already wrote the CORRECT expression in its reasoning (before "<<").
// - It will try to generate the same expression inside "<<>>".
// - A 50-token budget is enough for any reasonable arithmetic expression.
// - The "100000..." issue is resolved because after 50 tokens, CloseSpanWithinBudget
//   CLOSES at the last complete state (which might be "n * p1 * p2 * frac" - valid).
//
// Risk: If the expression needs more than 50 tokens, it gets truncated.
// But from the metrics: "Visible span token length: avg 6.75, median 7.00"
// Expressions are typically 7 tokens! So 50 is WAY more than enough.
//
// FINAL STRATEGY:
// freeChunkBudget = maxSteps - 50
// closeBudget = min(50, maxSteps - steps)
//
// This should:
// 1. Allow full reasoning text before "<<"
// 2. Keep expressions short (50 tokens max)
// 3. Always close within budget
// 4. Eliminate timeouts (fewer constrained steps = faster)
//
// The guidance should also instruct the model to write SHORT expressions.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   Phase 1 (UnconstrainedChunk): When stoppedOnOpenSpan is true, generated
//     already ends with "<<" and EnterObservedConstrainedSpan sets
//     insideConstrainedOut := true, currentConstrainedOut := [] which satisfies
//     parser.IsValidPrefix([]) by precondition. When stoppedOnEos, we return 
//     immediately. Otherwise insideConstrainedOut stays false (vacuously true).
//   Force-open (OpenConstrainedSpan): sets insideConstrainedOut := true,
//     currentConstrainedOut := [] (valid by parser.IsValidPrefix([]) precondition).
//   Phase 3 (CloseSpanWithinBudget): postcondition guarantees either
//     (!insideConstrainedOut && currentConstrainedOut == []) or
//     (insideConstrainedOut && parser.IsValidPrefix(currentConstrainedOut)).
//     Both preserve the invariant.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   Phase 1: UnconstrainedChunk costs stepsUsed <= chunkBudget. steps += stepsUsed.
//     generated grows by at most stepsUsed tokens (EOS not appended). Preserved.
//   Force-open: OpenConstrainedSpan costs 1 step, appends "<<" (1 token).
//     steps += 1. |generated| grows by 1. Preserved.
//   Phase 3: CloseSpanWithinBudget with closeBudget = maxSteps - steps guarantees
//     |generatedOut| <= |generated| + closeBudget <= |generatedPrefix| + maxSteps.
//     Setting steps := maxSteps: cost = steps <= maxSteps. Preserved.
//   Progress guarantee: maxSteps > 0 => Phase 1 consumes >= 1 step (chunkBudget >= 1
//     when maxSteps >= 1), so cost > 0. If maxSteps = 0 the condition is vacuous.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve step by step. Write the final answer as <<expr>> with a short arithmetic expression using variable names and +, -, *, /. Keep it concise (under 10 tokens). Example: <<n * price + tax>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate unconstrained reasoning until "<<" appears or EOS.
// Reserve only 50 tokens for the constrained expression itself.
var closeReserve: nat := 50;
var freeChunkBudget: nat := if maxSteps > closeReserve then maxSteps - closeReserve else (if maxSteps > 1 then maxSteps / 2 else maxSteps);

if !insideConstrainedOut && steps < freeChunkBudget {
  var chunkBudget: nat := freeChunkBudget - steps;
  var cg, stoppedOnOpenSpan, stoppedOnEos, stepsUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkBudget, "<<", eosToken);
  generated := cg;
  steps := steps + stepsUsed;
  if stoppedOnEos {
    cost := steps;
    return;
  }
  if stoppedOnOpenSpan {
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  }
}

// Phase 2: Force open a constrained span if the model never emitted "<<".
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 3: Close the constrained span within a tight budget.
// Using only 50 tokens ensures short expressions and prevents timeouts.
// CloseSpanWithinBudget tracks the longest complete parse state and closes there.
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  // Cap the close budget to prevent runaway expression generation
  if closeBudget > closeReserve {
    closeBudget := closeReserve;
  }
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := steps + closeBudget;
}

cost := steps;

