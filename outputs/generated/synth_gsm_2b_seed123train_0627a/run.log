  steps := steps + 1;
}

// Phase 3: Close the constrained span with a TIGHT budget to prevent runaway expressions.
// Cap at 25 tokens: sufficient for typical 7-8 token expressions, prevents
// division chains and repetition like "/ 1 * 1 / 1 * 1 ...".
