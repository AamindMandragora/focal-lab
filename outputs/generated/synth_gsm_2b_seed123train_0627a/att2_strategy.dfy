// CSD_RATIONALE_BEGIN
// Math word problem CSD with visible << >> delimiters.
//
// Key insight from failures:
// 1. 21/49 examples never emitted "<<" at all - the model just runs unconstrained
//    and hits the step budget.
// 2. 19/49 opened "<<" but never closed ">>" before budget ran out.
// 3. 8/49 had malformed span content (variables like {n1}, LaTeX, etc.)
//
// Root causes:
// - The model generates very long unconstrained reasoning (avg 152 tokens before "<<")
//   consuming most of the 900-token budget.
// - Once inside a span, the parser needs to be kept tight and quickly closed.
//
// Revised strategy:
// Phase 1: Short unconstrained chunk to let model write reasoning, but cap it
//   at a fixed budget (e.g. 700 tokens), stopping on "<<".
// Phase 2: If "<<" never appeared, FORCE open a span with OpenConstrainedSpan.
// Phase 3: Inside the span, use hard ConstrainedStep to generate valid tokens.
//   Use CloseSpanWithinBudget with the remaining budget to guarantee closure.
//
// The key change: reserve enough budget for the constrained span, and use
// CloseSpanWithinBudget to guarantee the span closes. If no "<<" appears in
// the free text, force one open. This directly addresses the top two failure modes.
//
// Additional: use strong task guidance to encourage the model to emit "<<"
// naturally and keep span content simple (just a number expression).
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - Phase 1 (UnconstrainedChunk): When stoppedOnOpenSpan is true, generated
//     already ends with "<<" and we call EnterObservedConstrainedSpan which sets
//     insideConstrainedOut := true, currentConstrainedOut := [] (valid). When
//     stoppedOnEos, we exit. Otherwise insideConstrainedOut remains false.
//   - Force-open branch (OpenConstrainedSpan): sets insideConstrainedOut := true,
//     currentConstrainedOut := [] (valid by precondition parser.IsValidPrefix([])).
//   - Phase 3 (CloseSpanWithinBudget): postcondition guarantees either
//     (!insideConstrainedOut && currentConstrainedOut == []) or
//     (insideConstrainedOut && parser.IsValidPrefix(currentConstrainedOut)).
//     Both preserve the invariant.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   - Phase 1: UnconstrainedChunk costs stepsUsed and grows generated by at most
//     stepsUsed tokens. steps := steps + stepsUsed maintains the bound.
//   - Force-open: OpenConstrainedSpan costs 1 step, appends "<<" (1 token).
//     steps := steps + 1 maintains the bound.
//   - Phase 3: CloseSpanWithinBudget with budget = maxSteps - steps guarantees
//     |generatedOut| <= |generated| + budget <= |generatedPrefix| + maxSteps.
//     Setting steps := maxSteps preserves cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math word problem. Write step by step reasoning, then write the final numeric answer inside << >> delimiters. The content inside << >> must be a simple arithmetic expression like <<42>> or <<3*4>> with no variables, braces, or LaTeX. End with the answer in << >>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Generate unconstrained text until "<<" is observed, capping at
// a conservative budget to leave room for the constrained span.
// Reserve at least 50 steps for the constrained span + closing.
var freeChunkBudget: nat := if maxSteps > 50 then maxSteps - 50 else maxSteps;

if !insideConstrainedOut && steps < freeChunkBudget {
  var chunkBudget: nat := freeChunkBudget - steps;
  var cg, stoppedOnOpenSpan, stoppedOnEos, stepsUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, chunkBudget, "<<", eosToken);
  generated := cg;
  steps := steps + stepsUsed;
  if stoppedOnEos {
    cost := steps;
    return;
  }
  if stoppedOnOpenSpan {
    // "<<" was naturally emitted; enter constrained span state
    generated, insideConstrainedOut, currentConstrainedOut :=
      helpers.EnterObservedConstrainedSpan(lm, generated);
  }
}

// Phase 2: If still outside a constrained span (model never emitted "<<"),
// force open one explicitly.
if !insideConstrainedOut && steps < maxSteps {
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
}

// Phase 3: Close the constrained span within the remaining budget.
// CloseSpanWithinBudget will generate valid constrained tokens and close the span.
if insideConstrainedOut && steps < maxSteps {
  var closeBudget: nat := maxSteps - steps;
  generated, insideConstrainedOut, currentConstrainedOut :=
    helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  steps := maxSteps;
}

cost := steps;

