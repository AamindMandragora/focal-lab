// The output contract requires exactly: SQL: <<YOUR QUERY>>
//
// Strategy:
// 1. Use AppendTaskGuidance to instruct the model to output "SQL: <<" first.
// 2. In the unconstrained preamble, generate tokens until "<<" is observed.
//    To avoid spending too many steps in the preamble, cap preamble at
//    min(maxSteps/4, 20) steps, then force OpenConstrainedSpan if not yet inside.
// 3. Once inside the constrained span, use AdaptiveConstrainedStep with group
//    boosts (narrow threshold = 20) to generate the SQL query body.
// 4. As soon as IsCompletePrefix returns true, immediately close with
//    CloseConstrainedSpan (which appends ">>") and break.
// 5. Use RepetitionPenalty to discourage token repetition inside the span.
//
// This ensures the output contains "SQL: <<...>>" with a valid SQL query.
// The preamble cap prevents wasting the entire budget on free generation.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   Preamble branch (!insideConstrainedOut):
//     UnconstrainedStep returns a token; if it is "<<" we set
//     currentConstrainedOut := [] and insideConstrainedOut := true. [] is a
//     valid prefix by the precondition parser.IsValidPrefix([]). If we call
//     OpenConstrainedSpan (forced entry), it also resets currentConstrainedOut
//     to [] and sets insideConstrainedOut := true. In all other sub-cases
//     insideConstrainedOut stays false, making the implication vacuous.
//   Close branch (IsCompletePrefix): CloseConstrainedSpan sets
//     insideConstrainedOut := false and currentConstrainedOut := [], making
//     the implication vacuous after that step.
//   Generation branch (inside, not complete): AdaptiveConstrainedStep and
//     SafeRepetitionPenaltyStep both guarantee the returned token is either
//     eosToken or a parser-valid extension of currentConstrainedOut.
//     AppendConstrainedToken extends currentConstrainedOut by that token,
//     preserving IsValidPrefix. On eosToken we break without appending.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   Preamble branch: steps += 1, generated grows by at most 1 token on
//     non-EOS paths. OpenConstrainedSpan costs +1 step and appends "<<" (+1
//     token), so the bound is maintained.
//   Close branch: CloseConstrainedSpan costs +1 step and appends ">>" (+1
//     token); bound maintained.
//   Generation branch: each helper costs +1 step; AppendConstrainedToken
//     appends at most 1 token; bound maintained.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Output exactly one SQL query in this format: SQL: <<SELECT ...>>. Use only tables and columns from the schema. No explanation, no markdown, no extra text. Start your response with SQL: <<";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
// Cap unconstrained preamble to avoid wasting budget
var maxPreambleSteps: nat := 30;
if maxSteps < 30 {
  maxPreambleSteps := maxSteps;
}

// Phase 1: unconstrained preamble until "<<" is observed or preamble cap hit
while steps < maxSteps && !insideConstrainedOut && steps < maxPreambleSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  } else {
    generated := generated + [next];
    if next == "<<" {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  }
}

// Force open a constrained span if we haven't entered one yet and still have budget
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: constrained SQL generation inside the span
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 20, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
