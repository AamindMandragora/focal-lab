Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the spider dataset.
// The strategy emits "SQL: " as free text, then opens a constrained span with
// "<<" to hold the SQL query body, generates the query under hard parser
// control using AdaptiveConstrainedStep (with group boosts when the branch
// factor is narrow), and closes the span with ">>" once the parser accepts
// the query as complete.
//
// State tracked:
//   - insideConstrainedOut / currentConstrainedOut: whether we are inside the
//     SQL constrained span and what SQL tokens have been emitted so far.
//   - steps: token-step budget consumed so far.
//   - phase: 0 = preamble (emit "SQL: " unconstrained), 1 = inside SQL span.
//
// Observations used:
//   - parser.IsCompletePrefix: trigger span close.
//   - ValidTokenCount: choose between group-boosted and adaptive constrained step.
//   - next == eosToken: terminate early.
//   - next == "<<": enter constrained mode if the model emits the delimiter.
//
// The approach ensures the output matches "SQL: <<...>>" with a valid SQL query
// between the delimiters, as required by the task contract.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   Preamble branch (phase==0): We call UnconstrainedStep. If next == "<<" we
//     set currentConstrainedOut := [] and insideConstrainedOut := true. [] is
//     always a valid prefix by parser.IsValidPrefix([]) (precondition). Otherwise
//     insideConstrainedOut stays false, making the implication vacuous.
//   Constrained close branch: CloseConstrainedSpan sets insideConstrainedOut :=
//     false and currentConstrainedOut := [], making the implication vacuous.
//   Constrained generation branch: AdaptiveConstrainedStep and
//     GroupBoostedConstrainedStep both guarantee that their return value is
//     either eosToken or a parser-valid next token. AppendConstrainedToken
//     extends currentConstrainedOut by that token, which by the parser API
//     preserves IsValidPrefix. On eosToken we break without appending.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   Preamble branch: steps increments by 1 and generated grows by at most 1
//     token (only on non-EOS, non-"<<" paths; "<<" is appended implicitly by
//     OpenConstrainedSpan which costs 1 step already counted). Actually we call
//     UnconstrainedStep (+1 step) and if next != eosToken we append next to
//     generated (+1 token), keeping |generated| <= |generatedPrefix| + steps.
//   Close branch: CloseConstrainedSpan appends ">>" (+1 token) and costs +1
//     step, so the bound is maintained.
//   Generation branch: AdaptiveConstrainedStep / GroupBoostedConstrainedStep
//     cost +1 step. AppendConstrainedToken appends 1 token to generated.
//     1 token <= 1 step, so |generated| <= |generatedPrefix| + steps holds.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Output exactly one SQL query in the form: SQL: <<YOUR QUERY>>. Use only tables and columns from the provided schema. No explanation, no markdown, no extra text.";
helpers.AppendTaskGuidance(lm, guidance);

var narrowThreshold: nat := 16;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
    // After closing the span, the SQL query is complete; stop generation.
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next := eosToken;
    if validCount <= narrowThreshold {
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, eosToken
      );
    } else {
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

