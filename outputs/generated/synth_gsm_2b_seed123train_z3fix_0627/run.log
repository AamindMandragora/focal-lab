Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with << >> delimiters for symbolic expressions and final answer.
// State: generated (full visible output), insideConstrainedOut (whether inside a << >> span),
// currentConstrainedOut (content of active constrained span), steps (budget used).
//
// Strategy:
// 1. Append task guidance to steer the model toward step-by-step reasoning with << >> spans.
// 2. Generate freely outside spans using UnconstrainedStep.
// 3. When "<<" is observed in free generation, enter constrained mode.
// 4. Inside constrained spans, use AdaptiveConstrainedStep with group boosting for narrower
//    parser states, and SafeRepetitionPenaltyStep to avoid repeated expressions.
// 5. Use CloseSpanIfComplete to close spans as soon as the parser accepts them.
// 6. If near budget exhaustion while inside a span, use CloseSpanWithinBudget to force closure.
// 7. Continue until EOS, budget exhausted, or maxSteps reached.
//
// This supports math problems where intermediate computations like "3 + 4" and final
// answers like "7" need to be wrapped in << >> delimiters per the task contract.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)):
//   - In the unconstrained branch: insideConstrainedOut flips to true only when next == "<<",
//     and we set currentConstrainedOut := [] which satisfies parser.IsValidPrefix([]) by
//     the method precondition. So the implication is established fresh.
//   - CloseSpanIfComplete branch (closed == true): insideConstrainedOut becomes false,
//     making the implication vacuous. When closed == false, generated/inside/current are
//     unchanged, so validity is preserved from the invariant.
//   - AdaptiveConstrainedStep branch: returns EOS or a parser-valid next token.
//     AppendConstrainedToken extends currentConstrainedOut by exactly that valid token,
//     so parser.IsValidPrefix(currentConstrainedOut) holds by the helper's postcondition.
//   - CloseSpanWithinBudget: its postcondition guarantees insideOut ==> parser.IsValidPrefix(currentOut).
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - Unconstrained branch: steps += 1, generated grows by at most 1 (either EOS breaks
//     or one token appended), so |generated| <= |generatedPrefix| + steps.
//   - CloseSpanIfComplete (closed): steps += 1, CloseConstrainedSpan appends ">>" (1 token),
//     so |generated| grows by at most 1 per step consumed.
//   - CloseSpanIfComplete (not closed): steps += 1 (TopValidCandidates cost), then
//     AdaptiveConstrainedStep steps += 1, AppendConstrainedToken grows generated by 1.
//     Total: 2 steps, at most 2 tokens appended. Bound preserved.
//   - Emergency close: CloseSpanWithinBudget uses closeBudget = maxSteps - steps tokens,
//     and its postcondition gives |generatedOut| <= |generated| + closeBudget.
//     After steps := maxSteps, we have |generated| <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve step by step. Wrap every intermediate symbolic expression and the final numeric answer inside << >> delimiters. Example: The total is <<3 + 4>> = <<7>>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Emergency close: if near budget end and inside a span, force close
  if insideConstrainedOut && maxSteps - steps <= 3 {
    var closeBudget := maxSteps - steps;
    var cg, ci, cc := helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
    );
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := maxSteps;
  } else if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    // Try to close if complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Need more tokens; check budget before generating
      if steps < maxSteps {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
        var next;
        if validCount <= 12 {
          // Narrow state: use group boosting to prefer tokens from valid groups
          next := helpers.GroupBoostedConstrainedStep(
            lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, eosToken
          );
        } else {
          // Wider state: use repetition penalty to avoid repeated sub-expressions
          next := helpers.SafeRepetitionPenaltyStep(
            lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
          );
        }
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

cost := steps;

