Strategy: // CSD_RATIONALE_BEGIN
// SMILES chain-extender generation CSD.
// State tracked: generated (full output), insideConstrainedOut (span open flag),
// currentConstrainedOut (tokens inside the active constrained span), steps/cost.
//
// Strategy:
// 1. Append task guidance to steer the model toward valid SMILES for chain extenders.
// 2. Open a constrained span immediately (no unconstrained preamble needed since
//    the output contract is a single SMILES string with no free text wrapper).
// 3. Inside the span, use AdaptiveConstrainedStep with the caller-supplied
//    validTokenGroups for soft group boosting when the parser is narrow, and
//    SafeRepetitionPenaltyStep to discourage repeated tokens, alternating
//    between them to balance novelty and validity.
// 4. At each step, check IsCompletePrefix and call CloseSpanIfComplete to
//    cleanly exit when the SMILES grammar accepts the current prefix.
// 5. On EOS, break and close any open span.
//
// This approach ensures the output is a parser-valid SMILES string from the
// first token, matching the task's "single SMILES string and nothing else" contract.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - After OpenConstrainedSpan, currentConstrainedOut == [] and parser.IsValidPrefix([])
//     holds by precondition, so the invariant holds.
//   - CloseSpanIfComplete: when closed == true, insideConstrainedOut becomes false
//     making the implication vacuous; when closed == false, state is unchanged and
//     the invariant is preserved by the inductive hypothesis.
//   - AdaptiveConstrainedStep returns EOS or a parser-valid next token; AppendConstrainedToken
//     extends currentConstrainedOut by that token, preserving parser.IsValidPrefix.
//   - SafeRepetitionPenaltyStep likewise returns EOS or a parser-valid token; same argument.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - OpenConstrainedSpan appends "<<" (1 token) and costs 1 step: after it,
//     |generated| = |generatedPrefix| + 1 = |generatedPrefix| + steps (steps becomes 1).
//   - CloseSpanIfComplete costs 1 step and appends at most 1 visible token (">>"),
//     so the bound is preserved.
//   - AdaptiveConstrainedStep costs 1 step; AppendConstrainedToken appends exactly 1 token,
//     so |generated| grows by 1 while steps grows by 1.
//   - SafeRepetitionPenaltyStep costs 1 step; same argument as adaptive step.
//   - EOS break does not append to generated, so the bound holds trivially.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate exactly one valid SMILES string for a chain extender molecule. Output only the SMILES string with no explanation, no Markdown, no delimiters. Chain extenders are typically small difunctional molecules (diols, diamines, or amino alcohols) used in polyurethane or polyester synthesis, such as 1,4-butanediol, ethylene glycol, or putrescine.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Open the constrained span immediately — the output is purely the SMILES string
if !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

var useRepetition: bool := false;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed; generation is complete
    break;
  } else {
    // Try to close if complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      break;
    } else {
      // Still inside span, generate next token
      if steps < maxSteps {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := eosToken;
        if useRepetition {
          next := helpers.SafeRepetitionPenaltyStep(
            lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
          );
        } else {
          next := helpers.AdaptiveConstrainedStep(
            lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
          );
        }
        useRepetition := !useRepetition;
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

// If we exited with span still open, attempt to close within remaining budget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

