//   - Each loop iteration increments steps by 1 and appends at most 1 token
//     to generated (EOS path appends 0, token path appends 1).
//   - So after k iterations: |generated| <= |generatedPrefix| + k == |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate exactly one valid SMILES string for a chain extender molecule. Output only the SMILES string. Chain extenders are small difunctional molecules such as diols (OCCO, OCCCCO), diamines (NCCN, NCCCCN), or amino alcohols (NCCO). Generate a novel chain extender not already shown as an example.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var useRepetition: bool := false;

// Use the constrained generation approach directly without span delimiters.
// currentConstrainedOut tracks the SMILES being built; generated also accumulates it.
// We treat the entire output as one constrained segment.

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if insideConstrainedOut && parser.IsCompletePrefix(currentConstrainedOut) {
    // Parser accepts the current constrained prefix as complete; close span
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      break;
    }
    // If not closed (shouldn't happen since IsCompletePrefix was true), continue
  } else if insideConstrainedOut {
    // Inside constrained span, generate next token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := eosToken;
    if useRepetition {
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
    } else {
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
      );
    }
    useRepetition := !useRepetition;
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  } else {
    // Not inside constrained span - open one to start generating SMILES
    if steps < maxSteps {
      var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
      generated := og;
      insideConstrainedOut := oi;
      currentConstrainedOut := oc;
      steps := steps + 1;
    } else {
      break;
    }
  }
}

// If span is still open and we have budget, try to close it
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

