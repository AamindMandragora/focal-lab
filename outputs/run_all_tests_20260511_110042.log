    } else {
      var nextIn := eosToken;
      if |currentConstrainedOut| == 0 {
        nextIn := helpers.AdaptiveConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
      } else if |currentConstrainedOut| < 2 {
        nextIn := helpers.SafePenalizedConstrainedStep(
