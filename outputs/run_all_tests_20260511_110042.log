Strategy: // CSD_RATIONALE_BEGIN
// This strategy tracks the visible output (`generated`), whether decoding is
// currently inside a computation span, and the active constrained span content
// (`currentConstrainedOut`). Outside spans it generates mostly freely, but it
// watches recent local context for arithmetic cues such as "=" or operator
// tokens and can proactively open a visible `<<` span so arithmetic work is
// written inside delimiters as required by the task.
// Inside spans, the parser is the hard authority. The strategy chooses among a
// few constrained-decoding modes based on parser narrowness and simple local
// context: short or narrow states use one-token constrained steps, while wider
// states may use a bounded symbol step. Soft boosts from `validTokenGroups` and
// small penalties for repeated visible tokens bias the LM toward coherent math
// continuations without sacrificing parser validity.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span branch, the implication is vacuous until
//   we either observe `<<` from unconstrained generation or explicitly call
//   OpenConstrainedSpan; both transitions set `currentConstrainedOut := []`,
//   which is a valid parser prefix by the method precondition. In the
//   complete-prefix branch, CloseConstrainedSpan exits constrained mode, so the
//   implication becomes vacuous. In the active constrained branches,
//   ConstrainedStep / AdaptiveConstrainedStep / SafePenalizedConstrainedStep /
//   SafeRepetitionPenaltyStep / ConfidenceGatedStep return EOS or a token that
//   preserves parser validity, and AppendConstrainedToken commits only such a
//   token. ConstrainedSymbolInGenerated directly returns a parser-valid updated
//   constrained prefix, so validity is preserved there as well.
// progress: UnconstrainedStep, OpenConstrainedSpan, CloseConstrainedSpan, and
//   each one-token constrained helper consume exactly one token-step, and each
//   appends at most one visible token (or none on EOS), so
//   |generated| <= |generatedPrefix| + steps is preserved. The
//   ConstrainedSymbolInGenerated branch consumes `stepsUsed` token-steps and
//   may accept only a visible valid prefix of that work; therefore visible
//   growth is at most `stepsUsed`, so the same bound still holds after
//   `steps := steps + stepsUsed`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var arithmeticArmed: bool := false;
var rollbackLimit: nat := 48;
var narrowThreshold: nat := 8;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if arithmeticArmed {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      arithmeticArmed := false;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          var enteredGenerated, enteredInside, enteredCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
          generated := enteredGenerated;
          insideConstrainedOut := enteredInside;
          currentConstrainedOut := enteredCurrent;
          arithmeticArmed := false;
        } else {
          if next == "=" || next == "+" || next == "-" || next == "*" || next == "/" {
            arithmeticArmed := true;
          } else if next == "." || next == "," || next == ">>" {
            arithmeticArmed := false;
          }
        }
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    arithmeticArmed := false;
    steps := steps + 1;
  } else if |currentConstrainedOut| >= rollbackLimit {
    var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSuffix(
      parser, generated, currentConstrainedOut
    );
    generated := rolledGenerated;
    insideConstrainedOut := true;
    currentConstrainedOut := rolledCurrent;
    steps := steps + 1;
  } else {
    var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
    var constrainedPrompt := prompt + stablePrefix;
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var deadEndNear := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);

    if stepTokenBudget > 1 && validCount > narrowThreshold && !deadEndNear {
      var remaining: nat := maxSteps - steps;
      var symbolBudget: nat := if stepTokenBudget > remaining then remaining else stepTokenBudget;
