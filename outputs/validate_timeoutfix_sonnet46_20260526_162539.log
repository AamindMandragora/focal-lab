        // Actually we can't do that directly - use a constrained step to advance.
        var constrainedPrompt2 := prompt + generated[..|generated| - |currentConstrainedOut|];
        var nextFallback := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt2, currentConstrainedOut, generated, 3.0, eosToken);
        steps := steps + 1;
        if nextFallback == eosToken {
