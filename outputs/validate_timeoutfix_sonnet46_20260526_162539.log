Strategy: // CSD_RATIONALE_BEGIN
// The primary failure modes from attempt 1 are:
// 1. Syntax failures (53.3% syntax rate) - the constrained parser is not being
//    engaged enough. mode_B shows "used_constrained: no" with zero valid spans,
//    meaning the model never emits "<<" in free generation, so the constrained
//    parser never activates.
// 2. malformed_constrained_content - when spans ARE opened, the content inside
//    fails syntax checks.
//
// Root cause analysis:
// - The free text generation is NOT producing "<<" tokens reliably because the
//   model treats {variable} template syntax as natural text, not math expressions.
// - When constrained generation does trigger, the AdaptiveConstrainedStep works
//   but the expressions are complex and the parser may reject them partially.
//
// Strategy revision:
// - Use UnconstrainedChunk to detect when "<<" is naturally emitted, which is
//   more reliable than step-by-step token checking.
// - Use stronger guidance to ensure << >> delimiters are emitted.
// - Use SafeRepetitionPenaltyStep inside spans to avoid the model repeating
//   template variables verbatim.
// - Use ConstrainedStep (simpler, more reliable) inside spans rather than
//   AdaptiveConstrainedStep to reduce malformed content.
// - Keep the overall structure: free outside, constrained inside << >>.
// - Importantly: force a "<<" open span after significant free text to ensure
//   at least one constrained span is produced.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut))
//   - UnconstrainedChunk branch (outside span): if stoppedOnOpenSpan, we call
//     EnterObservedConstrainedSpan which sets currentConstrainedOut := [] (valid
//     by precondition). If not stoppedOnOpenSpan, insideConstrainedOut remains
//     false and the implication is vacuous.
//   - CloseConstrainedSpan branch: sets insideConstrainedOut := false, making
//     the implication vacuous.
//   - OpenConstrainedSpan forced branch: sets currentConstrainedOut := [] (valid
//     by precondition). insideConstrainedOut := true.
//   - Inside-span (active) branch: ConstrainedStep returns either EOS or a
//     parser-valid next token. AppendConstrainedToken preserves validity.
//
// progress: (|generated| <= |generatedPrefix| + steps)
//   - UnconstrainedChunk: steps += stepsUsed, generated grows by at most stepsUsed
//     tokens (the helper appends non-EOS tokens). Invariant maintained.
//   - CloseConstrainedSpan: steps += 1, appends ">>" (1 token). Invariant maintained.
//   - OpenConstrainedSpan (forced): steps += 1, appends "<<" (1 token). Invariant maintained.
//   - Inside-span branch: steps += 1, AppendConstrainedToken appends exactly 1
//     token (or 0 on EOS). Invariant maintained.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve the math word problem step by step. For EVERY intermediate calculation, write it inside << >> like this: <<expr = value>>. The final answer MUST be inside << >> delimiters. Always use << and >> around any arithmetic expression or numeric result. Example: There are <<3 * 4 = 12>> apples, so the answer is <<12>>.");

var steps: nat := 0;
var chunkSize: nat := 8;
// Track how many free tokens we've generated without seeing a span open
var freeTokensSinceLastSpan: nat := 0;
var forceOpenThreshold: nat := 60;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Check if we should force open a span (model hasn't opened one in a while)
    // We use freeTokensSinceLastSpan as a heuristic
    if freeTokensSinceLastSpan >= forceOpenThreshold && steps + 1 <= maxSteps {
      // Force open a constrained span
      var newGenerated, newInside, newCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := newGenerated;
      insideConstrainedOut := newInside;
      currentConstrainedOut := newCurrent;
      steps := steps + 1;
      freeTokensSinceLastSpan := 0;
    } else if steps + chunkSize <= maxSteps {
