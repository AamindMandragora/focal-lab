Strategy: // CSD_RATIONALE_BEGIN
// Analysis of failures:
// 1. "entered_constrained_mode_too_early" (34 examples): The model correctly emits "SQL: <<"
//    then generates the SQL query. The extracted answer is syntactically correct but
//    semantically wrong (14 cases). The issue is not the format but the query content.
// 2. The model generates the correct format SQL: <<QUERY>> but the query content doesn't
//    match the ground truth closely enough.
//
// Root cause: The free unconstrained generation before "<<" works well (the model
// naturally produces "SQL: <<"). The constrained SQL generation inside is correct syntactically
// but semantically weak - the model is generating plausible but wrong SQL.
//
// Key insight from failures:
// - "SELECT title FROM cartoon WHERE directed_by IN (...)" vs "WHERE directed_by = ... OR directed_by = ..."
//   The model uses IN instead of OR - both valid SQL but different canonical forms
// - The model generates correct SQL structure but with wrong table joins or conditions
//
// New strategy:
// 1. Use stronger task guidance that emphasizes following the natural language closely
//    and using the exact schema provided
// 2. Inside the constrained span, use AdaptiveConstrainedStep with the valid token groups
//    from the caller (which likely contain schema-specific tokens like table/column names)
// 3. Boost SQL structure keywords and schema tokens heavily
// 4. Use repetition penalty to avoid redundant subqueries when simpler joins work
// 5. The key improvement: use a wider SQL keyword set and boost schema-specific tokens
//    from validTokenGroups more aggressively
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - Outside span (insideConstrainedOut == false): implication is vacuously true.
//     When next == "<<", we set currentConstrainedOut := [] which satisfies
//     parser.IsValidPrefix([]) by precondition.
//   - CloseConstrainedSpan branch: sets insideConstrainedOut := false,
//     making the implication vacuously true.
//   - Inside constrained branch: AdaptiveConstrainedStep guarantees the returned
//     token is parser-valid or EOS. AppendConstrainedToken extends by one
//     parser-valid token, preserving IsValidPrefix.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   - Outside span: steps += 1, generated grows by at most 1. Bound preserved.
//   - CloseConstrainedSpan: steps += 1, generated grows by at most 1 (">>"). Preserved.
//   - Inside constrained: steps += 1, generated grows by at most 1. Preserved.
//   - EOS branch: steps += 1, generated unchanged. Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm,
  "Generate exactly one SQL query matching the natural language question. " +
  "Format: SQL: <<YOUR QUERY HERE>>. " +
  "Use the exact table and column names from the schema. " +
  "Prefer simple JOINs over subqueries. " +
  "Use OR instead of IN when the question says 'or'. " +
  "Do not add LIMIT unless asked. " +
  "No markdown, no explanation.");

var sqlKeywordGroups: seq<seq<Token>> := [
  ["SELECT", "select"],
  ["DISTINCT", "distinct"],
  ["FROM", "from"],
  ["WHERE", "where"],
  ["AND", "and"],
  ["OR", "or"],
  ["JOIN", "join"],
  ["LEFT", "left"],
  ["INNER", "inner"],
  ["RIGHT", "right"],
  ["ON", "on"],
  ["GROUP", "group"],
  ["BY", "by"],
  ["HAVING", "having"],
  ["ORDER", "order"],
  ["ASC", "asc"],
  ["DESC", "desc"],
  ["LIMIT", "limit"],
  ["COUNT", "count"],
  ["SUM", "sum"],
  ["AVG", "avg"],
  ["MAX", "max"],
  ["MIN", "min"],
  ["AS", "as"],
  ["IN", "in"],
  ["NOT", "not"],
  ["LIKE", "like"],
  ["BETWEEN", "between"],
  ["EXCEPT", "except"],
  ["UNION", "union"],
  ["INTERSECT", "intersect"],
  ["=", "!=", "<", ">", "<=", ">="],
  ["(", ")"],
  ["*"],
  [","],
  ["'"],
  ["\""]
];

var allGroups: seq<seq<Token>> := sqlKeywordGroups + validTokenGroups;
var narrowThreshold: nat := 20;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, allGroups, 5.0, narrowThreshold, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

