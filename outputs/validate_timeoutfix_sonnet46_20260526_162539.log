          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      } else {
        // After rollback, do a normal constrained step with repetition penalty
        var constrainedPrompt3 := prompt + generated[..|generated| - |currentConstrainedOut|];
        var nextRep := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt3, currentConstrainedOut, generated, 2.0, eosToken);
        steps := steps + 1;
        if nextRep == eosToken {
