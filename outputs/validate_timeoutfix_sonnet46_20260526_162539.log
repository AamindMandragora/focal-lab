Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with << >> delimiters for symbolic expressions and answers.
// State tracked:
//   - insideConstrainedOut / currentConstrainedOut: active constrained span state
//   - steps: token budget consumed
//   - seenOpenSpan: counts how many << have been opened to help decide when to
//     force closing or continue free text
// Conditions / observations:
//   - Outside a span: generate freely with UnconstrainedStep; when "<<" is
//     detected, enter constrained mode via EnterObservedConstrainedSpan.
//   - Inside a span: use AdaptiveConstrainedStep with validTokenGroups boosts
//     for math expressions; when parser signals completeness, close with
//     CloseConstrainedSpan.
//   - EOS terminates generation in both modes.
// How state supports valid generation:
//   - Free text carries narrative/step-by-step reasoning.
//   - Each << ... >> span is constrained by the parser to ensure valid symbolic
//     expressions. The adaptive step uses group boosts to prefer math tokens
//     when the parser state is narrow.
//   - The final answer should appear inside a << >> span as required by task.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: (insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut))
//   - Outside-span branch: next != "<<" path leaves insideConstrainedOut false,
//     implication vacuous. When next == "<<", we call EnterObservedConstrainedSpan
//     which sets currentConstrainedOut := [] and [] is a valid prefix by
//     parser.IsValidPrefix([]) precondition.
//   - CloseConstrainedSpan branch: sets insideConstrainedOut := false, making
//     the implication vacuous.
//   - Inside-span (active) branch: AdaptiveConstrainedStep returns either EOS
//     or a token t such that parser.IsValidPrefix(currentConstrainedOut + [t]).
//     AppendConstrainedToken then sets currentConstrainedOut := currentConstrainedOut + [t],
//     which remains a valid prefix by the step postcondition.
//
// progress: (|generated| <= |generatedPrefix| + steps)
//   - Outside-span branch: steps += 1, and at most one token (next) is appended
//     to generated (or nothing on EOS). So |generated| grows by at most 1 while
//     steps grows by 1.
//   - CloseConstrainedSpan branch: steps += 1, CloseConstrainedSpan appends ">>"
//     (1 token) to generated, so |generated| grows by 1 while steps grows by 1.
//   - Inside-span (active) branch: steps += 1, AppendConstrainedToken appends
//     exactly 1 token (or nothing on EOS). So |generated| grows by at most 1
//     while steps grows by 1. Invariant maintained.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve the math word problem step by step. Show each intermediate symbolic calculation inside << >> delimiters. Put the final numeric answer inside << >> delimiters at the end. Example: The total is <<3 + 4 = 7>>, so the answer is <<7>>.");

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        var newGenerated, newInside, newCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := newGenerated;
        insideConstrainedOut := newInside;
        currentConstrainedOut := newCurrent;
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

