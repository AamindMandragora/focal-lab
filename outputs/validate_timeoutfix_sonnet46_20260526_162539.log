          generated := ag2;
          insideConstrainedOut := ai2;
          currentConstrainedOut := ac2;
        }
      }
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      // Use adaptive constrained step with penalties on noise tokens
      var next := helpers.AdaptiveConstrainedStepWithPenalties(
