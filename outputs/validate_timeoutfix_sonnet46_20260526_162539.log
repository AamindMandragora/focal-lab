helpers.AppendTaskGuidance(lm, "Solve the math word problem step by step. Show each intermediate symbolic calculation inside << >> delimiters. Put the final numeric answer inside << >> delimiters at the end. Example: The total is <<3 + 4 = 7>>, so the answer is <<7>>.");

var steps: nat := 0;
var narrowThreshold: nat := 20;
// Tokens to penalize inside constrained spans to prevent garbage output
