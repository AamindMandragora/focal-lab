Strategy: // CSD_RATIONALE_BEGIN
// SQL-generation CSD for the Spider dataset.
// State tracked:
//   - insideConstrainedOut / currentConstrainedOut: whether we are inside a <<...>> span
//   - seenSQL: whether we have emitted "SQL:" prefix (to ensure the format SQL: <<QUERY>>)
//   - steps: token budget consumed
// Strategy:
//   1. Append task guidance to steer toward "SQL: <<YOUR QUERY>>" format.
//   2. Outside constrained span: use UnconstrainedStep to emit free tokens.
//      When "<<" is observed, transition into constrained mode.
//   3. Inside constrained span: use AdaptiveConstrainedStep with SQL keyword
//      groups boosted, and repetition penalty to avoid redundant tokens.
//      When parser says IsCompletePrefix, close the span with ">>".
//   4. After closing, stop (EOS or natural end of one-query generation).
// This ensures the output matches "SQL: <<VALID SQL QUERY>>" with parser-valid SQL.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - Outside span branch: implication is vacuous (insideConstrainedOut == false).
//     When next == "<<", we set currentConstrainedOut := [] which satisfies
//     parser.IsValidPrefix([]) by precondition.
//   - CloseConstrainedSpan branch: sets insideConstrainedOut := false,
//     making the implication vacuous thereafter.
//   - Inside constrained branch: AdaptiveConstrainedStep and SafeRepetitionPenaltyStep
//     both guarantee the returned token is parser-valid or EOS.
//     AppendConstrainedToken extends by one parser-valid token, preserving IsValidPrefix.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   - Outside span: steps += 1, generated grows by at most 1 (the appended token).
//   - CloseConstrainedSpan: steps += 1, generated grows by at most 1 (">>").
//   - Inside constrained: steps += 1, generated grows by at most 1 (AppendConstrainedToken).
//   - EOS branch: steps += 1, generated unchanged. Bound preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm,
  "Output exactly one SQL query in this format: SQL: <<SELECT ... FROM ...>>. " +
  "Use only the tables and columns from the provided schema. " +
  "No explanation, no markdown, no extra text. " +
  "The query must be syntactically valid SQL.");

var sqlKeywordGroups: seq<seq<Token>> := [
  ["SELECT", "select"],
  ["DISTINCT", "distinct"],
  ["FROM", "from"],
  ["WHERE", "where"],
  ["AND", "and", "OR", "or"],
  ["JOIN", "join", "LEFT", "left", "INNER", "inner", "RIGHT", "right"],
  ["ON", "on"],
  ["GROUP", "group", "BY", "by"],
  ["HAVING", "having"],
  ["ORDER", "order"],
  ["LIMIT", "limit"],
  ["COUNT", "count", "SUM", "sum", "AVG", "avg", "MAX", "max", "MIN", "min"],
  ["AS", "as"],
  ["IN", "in", "NOT", "not", "LIKE", "like", "BETWEEN", "between"],
  ["=", "!=", "<", ">", "<=", ">="]
];

var allGroups: seq<seq<Token>> := sqlKeywordGroups + validTokenGroups;
var narrowThreshold: nat := 15;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
    // After closing the SQL span, we're done with the query
    break;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next := eosToken;
    if validCount <= narrowThreshold {
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, allGroups, 5.0, eosToken
      );
    } else {
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 1.5, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

