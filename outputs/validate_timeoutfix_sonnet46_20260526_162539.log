        var newGenerated, newInside, newCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := newGenerated;
        insideConstrainedOut := newInside;
        currentConstrainedOut := newCurrent;
        freeTokensSinceLastSpan := 0;
      }
    } else {
      // Budget too small for a full chunk, do single unconstrained step
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      freeTokensSinceLastSpan := freeTokensSinceLastSpan + 1;
      if next == eosToken {
