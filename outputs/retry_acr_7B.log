//   ConstrainedGeneration costs at most +maxSteps token-steps. We set cost := maxSteps
//   (an upper bound). The generated output grows by |constrainedResult| which is at
//   most maxSteps tokens. So |generated| <= |generatedPrefix| + maxSteps = 
//   |generatedPrefix| + cost. The bound |generated| <= |generatedPrefix| + maxSteps
//   is satisfied.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "You are generating SMILES strings for acrylate molecules. An acrylate MUST contain the acryloyl ester group. Generate complete SMILES like: C=CC(=O)OCC, C=CC(=O)OCCC, C=CC(=O)OC, C=C(C)C(=O)OCC, C=CC(=O)OCCCC, C=CC(=O)OC(C)C. The SMILES must be chemically valid and contain the C=CC(=O)O substructure (vinyl acrylate group). Do not generate single atoms.";
helpers.AppendTaskGuidance(lm, guidance);

// If we're already inside a constrained span, close it cleanly first
if insideConstrainedOut {
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
  var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
  if isComplete && cost < maxSteps {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    cost := cost + 1;
  } else if !isComplete {
    insideConstrainedOut := false;
    currentConstrainedOut := [];
  }
}

// Use ConstrainedGeneration to produce a complete SMILES string
// Budget: leave room for the generation
var genBudget: nat := if maxSteps > cost then maxSteps - cost else 0;

if genBudget > 0 {
  var constrainedResult, terminatedByEos := helpers.ConstrainedGeneration(
    lm, parser, prompt, genBudget, eosToken
  );
  // constrainedResult is a complete (or partial) constrained prefix
  // Append to generated
  generated := generatedPrefix + constrainedResult;
  insideConstrainedOut := false;
  currentConstrainedOut := [];
  cost := cost + genBudget;
}

