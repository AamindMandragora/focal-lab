Strategy: // CSD_RATIONALE_BEGIN
// Key insight from feedback: 45/49 examples show "<<" appearing in output but the
// constrained branch never fires. The model emits "<<" freely during reasoning,
// but the strategy waits for a reactive "<<" trigger that rarely matches because
// the model's reasoning tokens contain variable-name content like "{n1}+{n2}".
//
// The fix: FORCE span entry. Instead of waiting for the model to emit "<<",
// we let the model reason freely until it seems to be wrapping up, then we
// FORCE the opening "<<" via OpenConstrainedSpan, then drive the content through
// the constrained branch until the parser accepts it, then close with ">>".
//
// Strategy:
// 1. Generate reasoning freely for most of the budget (up to ~150 tokens or until
//    EOS, or until the model naturally emits "<<").
// 2. If we see "<<" naturally, enter constrained mode via EnterObservedConstrainedSpan.
// 3. If we reach the reasoning budget without naturally opening a span, FORCE open
//    a constrained span via OpenConstrainedSpan.
// 4. Inside the constrained span, use AdaptiveConstrainedStep with valid groups.
// 5. Check completion after each token. Close the span as soon as complete.
// 6. Hard cap of 40 tokens per constrained span to prevent infinite loops.
// 7. If span budget exhausted, rollback to last complete state and close.
//
// The key difference from previous attempts:
// - We FORCE span entry after reasoning phase (step budget ~150), not just wait.
// - This ensures the constrained decoder actually shapes the final answer.
// - The guidance explicitly says "your final answer expression goes in << >>".
//
// Correctness improvement ideas:
// - The model outputs variable names instead of actual arithmetic.
//   We cannot fix this without the model understanding the task correctly.
//   The guidance says "use actual numbers" but the model doesn't have them.
//   Actually looking at examples: the prompts have {name} placeholders, so
//   the actual values ARE substituted before the model sees them.
//   The model IS outputting expressions with variable names because the task
//   uses symbolic math (gsm_symbolic). The evaluator accepts symbolic expressions.
//   So "n + b" IS a valid answer if it matches the correct formula.
//   We need to ensure the constrained span captures one clean expression.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Free reasoning branch (next != "<<"): insideConstrainedOut stays false, implication vacuous.
//   - Free reasoning branch (next == "<<"): EnterObservedConstrainedSpan sets
//     currentConstrainedOut := [], which satisfies IsValidPrefix([]) by precondition.
//   - Force-open branch: OpenConstrainedSpan sets insideConstrainedOut=true and
//     currentConstrainedOut=[], which satisfies IsValidPrefix([]) by precondition.
//   - Inside span, IsCompletePrefix true: CloseConstrainedSpan sets insideConstrainedOut=false,
//     making the implication vacuous, and resets currentConstrainedOut := [].
//   - Inside span, span budget exceeded: RollbackConstrainedToComplete returns a prefix
//     satisfying IsCompletePrefix (or []), and then CloseConstrainedSpan exits the span.
//     If we abandon the span (insideConstrainedOut := false), the implication is vacuous.
//   - Inside span, AdaptiveConstrainedStep non-EOS: AppendConstrainedToken preserves
//     IsValidPrefix by its postcondition (only appends parser-valid tokens).
//   - Inside span, EOS: we break and cost := steps, insideConstrainedOut stays in
//     whatever state it was, but that state satisfies the invariant.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Free branch: steps += 1, generated grows by at most 1 token (non-EOS). OK.
//   - OpenConstrainedSpan: steps += 1 (forced delimiter), generated grows by 1 ("<<"). OK.
//   - EnterObservedConstrainedSpan: +0 cost, generated unchanged (already counted). OK.
//   - CloseConstrainedSpan: steps += 1, generated grows by at most 1 (">>"). OK.
//   - RollbackConstrainedToComplete: +0 cost, generated can only shrink or stay same. OK.
//   - AdaptiveConstrainedStep + AppendConstrainedToken: steps += 1, generated grows by 1. OK.
//   - spanSteps tracks per-span token budget; total steps still bounded by maxSteps. OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math problem step by step. Show your reasoning with the actual numbers given. At the very end, write the final numeric answer as a single arithmetic expression inside << >> delimiters. Use only numbers and operators +,-,*,/,(,) inside the << >>. Do not use variable names inside << >>. Example format: <<(15+3)*2>>");

var steps: nat := 0;
// How many free reasoning tokens to allow before forcing span open
// Use roughly 80% of budget for reasoning, reserve 20% for constrained answer
var reasoningBudget: nat := if maxSteps > 50 then maxSteps - 40 else (if maxSteps > 10 then maxSteps - 8 else maxSteps / 2);
var spanSteps: nat := 0;
var maxSpanSteps: nat := 35;
var forcedOpen: bool := false;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Check if we should force open a constrained span for the final answer
    if steps >= reasoningBudget && steps + 5 <= maxSteps {
      // Force open the constrained span for the answer
      var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
      generated := og;
      insideConstrainedOut := oi;
      currentConstrainedOut := oc;
      steps := steps + 1;
      spanSteps := 0;
      forcedOpen := true;
    } else {
      // Free reasoning step
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        // EOS during reasoning - force open span if we have budget
        if steps + 5 <= maxSteps {
          var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
          generated := og;
          insideConstrainedOut := oi;
          currentConstrainedOut := oc;
          steps := steps + 1;
          spanSteps := 0;
          forcedOpen := true;
        } else {
          break;
        }
      } else {
        generated := generated + [next];
        if next == "<<" {
          // Model naturally emitted "<<" - enter constrained mode
          var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
          generated := og;
          insideConstrainedOut := oi;
          currentConstrainedOut := oc;
          spanSteps := 0;
          forcedOpen := false;
        }
      }
    }
  } else {
    // Inside constrained span
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      // Close the span cleanly
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
      spanSteps := 0;
      // After closing, break if this was a forced span (we got our answer)
      if forcedOpen {
        break;
      }
    } else if spanSteps >= maxSpanSteps || steps + 2 > maxSteps {
      // Per-span budget exceeded or overall budget nearly exhausted
      // Rollback to last complete state
      var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
      generated := rg;
      currentConstrainedOut := rc;
      var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
      if isNowComplete && steps + 1 <= maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      } else {
        // Abandon span
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        steps := steps + 1;
      }
      spanSteps := 0;
      break;
    } else {
      // Generate next constrained token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 15, eosToken
      );
      steps := steps + 1;
      spanSteps := spanSteps + 1;
      if next == eosToken {
        // EOS inside span - try to close if complete
        var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
        if isNowComplete && steps <= maxSteps {
          if steps < maxSteps {
            var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
            generated := cg;
            insideConstrainedOut := ci;
            currentConstrainedOut := cc;
            steps := steps + 1;
          }
        } else {
          // Rollback to complete
          var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
          generated := rg;
          currentConstrainedOut := rc;
          var isRbComplete := parser.IsCompletePrefix(currentConstrainedOut);
          if isRbComplete && steps < maxSteps {
            var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
            generated := cg;
            insideConstrainedOut := ci;
            currentConstrainedOut := cc;
            steps := steps + 1;
          } else {
            insideConstrainedOut := false;
            currentConstrainedOut := [];
          }
        }
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

