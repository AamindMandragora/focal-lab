Strategy: // CSD_RATIONALE_BEGIN
// The core problem: the model naturally emits "<<" mid-reasoning before the CSD can intercept it.
// The fix is to FORCE span entry: generate free tokens until we're "close" to the answer, then
// explicitly force a "<<" delimiter via OpenConstrainedSpan, drive the span content entirely under
// hard parser control, then close with ">>".
//
// Strategy:
// 1. Generate freely (UnconstrainedStep) until EOS or until we detect we should start the answer.
//    We detect answer readiness by looking at the generated text for "answer is" or similar signals,
//    OR we simply let the model generate up to a budget, then force-open a constrained span.
// 2. The key insight from the feedback: we must FORCE the span open with OpenConstrainedSpan
//    (which appends "<<") rather than waiting for the model to emit "<<" naturally.
// 3. Once inside the forced constrained span, use hard ConstrainedStep to ensure only valid tokens.
// 4. Close the span as soon as the parser is complete.
//
// To avoid the model's naturally-emitted "<<" corrupting the strategy, we generate freely
// and if the model emits "<<" naturally, we use EnterObservedConstrainedSpan to take over.
// If the model hasn't opened a span after a free-generation budget, we force one open.
//
// Budget allocation: reserve ~15 steps for the constrained answer span (enough for a numeric expr),
// use the rest for free reasoning. If we detect "<<" during free generation, enter constrained mode.
// If we exhaust the free budget without a span, force OpenConstrainedSpan and generate constrained.
//
// This directly addresses the feedback: "FORCE span entry" via OpenConstrainedSpan.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Free-gen branch, next != "<<": insideConstrainedOut stays false, implication vacuous.
//   - Free-gen branch, next == "<<": EnterObservedConstrainedSpan sets currentConstrainedOut := [],
//     valid by precondition parser.IsValidPrefix([]).
//   - Force-open branch (OpenConstrainedSpan): sets currentConstrainedOut := [], valid by precondition.
//   - Inside span, CloseConstrainedSpan: sets insideConstrainedOut := false, implication vacuous.
//   - Inside span, ConstrainedStep + AppendConstrainedToken: ConstrainedStep returns a parser-valid
//     next token; AppendConstrainedToken preserves IsValidPrefix by its postcondition.
//   - Inside span, EOS from ConstrainedStep: we set insideConstrainedOut := false,
//     currentConstrainedOut := [], making the implication vacuous.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Free-gen branch: steps += 1, generated grows by at most 1 token (the non-EOS next). OK.
//   - OpenConstrainedSpan: steps += 1, generated grows by exactly 1 ("<<"). OK.
//   - EnterObservedConstrainedSpan: +0 cost, +0 growth (already counted above). OK.
//   - CloseConstrainedSpan: steps += 1, generated grows by at most 1 (">>"). OK.
//   - ConstrainedStep + AppendConstrainedToken: steps += 1, generated grows by exactly 1. OK.
//   - EOS/break paths: steps += 1 (already counted), generated unchanged after break. OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve the math problem step by step. At the very end, wrap your final numeric answer as a simple arithmetic expression using ONLY digits and operators (+,-,*,/,(,)) inside << >>. Example: <<(3+4)*2>>. No variable names inside << >>.");

var steps: nat := 0;

// Reserve budget: we need at least ~20 steps for the constrained answer span + closing
// Use free generation for reasoning, then force-open a constrained span for the answer
var freeGenBudget: nat := if maxSteps > 25 then maxSteps - 20 else (if maxSteps > 5 then maxSteps - 5 else maxSteps);
var constrainedAnswerOpened: bool := false;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  invariant maxSteps == 0 || steps > 0 || (generated == generatedPrefix && insideConstrainedOut == insideConstrained && currentConstrainedOut == currentConstrained)
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Check if we should force-open the constrained span for the answer
    if steps >= freeGenBudget && !constrainedAnswerOpened {
      // Force open the constrained span for the final answer
      var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
      generated := og;
      insideConstrainedOut := oi;
      currentConstrainedOut := oc;
      constrainedAnswerOpened := true;
      steps := steps + 1;
    } else {
      // Free generation for reasoning
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        // Model wants to stop - force open constrained span for the answer if not yet done
        if !constrainedAnswerOpened && steps < maxSteps {
          var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
          generated := og;
          insideConstrainedOut := oi;
          currentConstrainedOut := oc;
          constrainedAnswerOpened := true;
          steps := steps + 1;
        } else {
          break;
        }
      } else {
        generated := generated + [next];
        if next == "<<" {
          // Model naturally emitted "<<" - take over with constrained decoding
          var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
          generated := og;
          insideConstrainedOut := oi;
          currentConstrainedOut := oc;
          constrainedAnswerOpened := true;
        }
      }
    }
  } else {
    // Inside constrained span - use hard parser control
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
      // After closing the constrained span, we're done generating the answer
      // Continue free generation only if there's budget and we haven't finalized
      break;
    } else {
      // Check for dead end
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount == 0 {
        // Dead end - roll back and try to recover
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
        if isNowComplete {
          var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
          steps := steps + 1;
          break;
        } else {
          // Can't recover - exit span
          insideConstrainedOut := false;
          currentConstrainedOut := [];
          steps := steps + 1;
          break;
        }
      } else {
        // Use SafeRepetitionPenaltyStep to discourage variable names (tokens in prompt)
        // and generate a valid token for the arithmetic expression
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
        steps := steps + 1;
        if next == eosToken {
          // EOS inside span - close if complete, else exit
          var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
          if isNowComplete && steps < maxSteps {
            var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
            generated := cg;
            insideConstrainedOut := ci;
            currentConstrainedOut := cc;
            steps := steps + 1;
          } else {
            insideConstrainedOut := false;
            currentConstrainedOut := [];
          }
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

cost := steps;

