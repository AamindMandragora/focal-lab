// - The key issue: "partial_valid_spans" - spans open but contain variable-name expressions
//   that the arithmetic parser accepts partially but not completely
// - mode_G (11 samples): partial_valid_spans=yes, syntax_valid=no → constrained content
//   starts valid but goes wrong partway through
// - mode_C (10 samples): zero_valid_spans=yes → no valid spans at all
//
// Root cause of mode_C (10 samples with zero valid spans):
// When the model emits "<<" with variable names inside, the parser rejects those tokens
// entirely, leaving zero valid spans. These variable names like {n}, {n_1}, etc. are
// not valid arithmetic tokens, so the parser immediately dead-ends.
//
// Strategy for improvement:
// 1. Keep the "detect << and enter constrained mode" approach from the best attempt.
// 2. Key fix: When we enter constrained mode and IMMEDIATELY hit a dead end (validCount==0),
//    the expression was already emitted freely by the model. We need to CLOSE the bad span
//    and let the model continue to the FINAL << >> which should have the numeric answer.
// 3. The model typically emits multiple << >> spans during reasoning; the LAST one is the answer.
//    We should not abandon generation after the first bad span - continue freely until the
//    model emits the final numeric expression.
// 4. Use a more aggressive dead-end detection: if the first token in a new span is invalid
//    (validCount==0 immediately on entry), this is a variable-name span - abandon immediately
//    without consuming any constrained budget, just switch back to free mode.
// 5. For the final forced span (if budget running low), use OpenConstrainedSpan to inject
//    a clean "<<" and then constrain the expression properly.
// 6. The guidance should tell the model to put the FINAL numeric answer in << >>.
// 7. Track how many constrained spans we've opened - if we're opening many spans (reasoning
//    spans), be very aggressive about abandoning them quickly so we preserve budget for the
//    final answer span.
//
// Key insight from rollouts: The model IS outputting the right answer eventually in its
// FINAL << >> span. We need to preserve budget for that span and ensure the constrained
// decoder fires on it, not on intermediate reasoning spans.
//
// Plan:
// - Free generation with immediate dead-end detection on span entry
// - If immediate dead end (validCount==0 on first constrained step): abandon span, continue free
// - If partial progress (some valid tokens): use constrained generation with 25-token cap
// - Near end of budget (last 30 tokens): if not in span, force open one via OpenConstrainedSpan
// - Use ConstrainedStep (not AdaptiveConstrainedStep) for cleaner expression generation
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Free branch, next != "<<": insideConstrainedOut stays false, implication vacuous.
//   - Free branch, next == "<<": EnterObservedConstrainedSpan sets currentConstrainedOut := [],
//     which satisfies parser.IsValidPrefix([]) by precondition.
//   - Force-open branch: OpenConstrainedSpan sets currentConstrainedOut := [], valid by precondition.
//   - Inside span, isComplete true: CloseConstrainedSpan sets insideConstrainedOut=false (vacuous).
//   - Inside span, validCount==0 (immediate dead end): We set insideConstrainedOut:=false,
//     currentConstrainedOut:=[], making the implication vacuous.
//   - Inside span, spanSteps >= maxSpanSteps: RollbackConstrainedToComplete returns a complete
//     prefix or []; IsCompletePrefix implies IsValidPrefix. Then CloseConstrainedSpan exits,
//     or we set insideConstrainedOut:=false (vacuous).
//   - Inside span, ConstrainedStep non-EOS: AppendConstrainedToken preserves IsValidPrefix
//     by its postcondition (only appends parser-valid tokens).
//   - Inside span, EOS: insideConstrainedOut set false after close attempt (vacuous).
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Free branch: steps += 1, generated grows by at most 1 token. OK.
//   - EnterObservedConstrainedSpan: +0 cost, generated unchanged (already counted). OK.
//   - OpenConstrainedSpan: steps += 1, generated grows by 1 ("<<"). OK.
//   - CloseConstrainedSpan: steps += 1, generated grows by at most 1 (">>"). OK.
//   - RollbackConstrainedToComplete: +0 cost, generated shrinks or stays. OK.
//   - Immediate dead end: insideConstrainedOut:=false, steps unchanged, generated unchanged. OK.
//   - ConstrainedStep + AppendConstrainedToken: steps += 1, generated grows by 1. OK.
//   - EOS paths: steps += at most 1, break. OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem. Show your work step by step. At the very end, write the final numeric answer as a single arithmetic expression inside << >> with ONLY digits and operators +,-,*,/,(,). No variable names or letters inside << >>. Final line must be: <<number_expression>>");

var steps: nat := 0;
var spanSteps: nat := 0;
var maxSpanSteps: nat := 25;
// Force-open threshold: if we're this close to end and still outside, force open a span
var forceOpenThreshold: nat := if maxSteps > 35 then maxSteps - 30 else maxSteps / 2;
var forcedSpanOpen: bool := false;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Check if we should force-open a constrained span for the final answer
    if steps >= forceOpenThreshold && steps + 5 <= maxSteps && !forcedSpanOpen {
      // Force open constrained span for the answer
      var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
      generated := og;
      insideConstrainedOut := oi;
      currentConstrainedOut := oc;
      steps := steps + 1;
      spanSteps := 0;
      forcedSpanOpen := true;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        // EOS during free generation - if we haven't opened a final span yet and have budget, force one
        if steps + 5 <= maxSteps && !forcedSpanOpen {
          var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
          generated := og;
          insideConstrainedOut := oi;
          currentConstrainedOut := oc;
          steps := steps + 1;
          spanSteps := 0;
          forcedSpanOpen := true;
        } else {
          break;
        }
      } else {
        generated := generated + [next];
        if next == "<<" {
          // Model naturally emitted "<<" - enter constrained mode
          var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
          generated := og;
          insideConstrainedOut := oi;
          currentConstrainedOut := oc;
          spanSteps := 0;
          // Don't set forcedSpanOpen here - this is a natural span
        }
      }
    }
  } else {
    // Inside a constrained span
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      // Close the span cleanly
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
      spanSteps := 0;
      // If this was the forced span, we're done
      if forcedSpanOpen {
        break;
      }
    } else {
      // Check valid token count BEFORE spending a step
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount == 0 {
        // Immediate dead end - this span has variable names or invalid content
        // Abandon immediately without consuming a step
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        spanSteps := 0;
        // forcedSpanOpen stays as-is; if we forced it and got dead end, we used 1 step on "<<"
        // so we can try again next iteration if budget allows (but don't set forcedSpanOpen again)
      } else if spanSteps >= maxSpanSteps {
        // Per-span budget exceeded - rollback to last complete state and close
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
        if isNowComplete && steps < maxSteps {
          var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
          steps := steps + 1;
        } else {
          // Abandon span
          insideConstrainedOut := false;
          currentConstrainedOut := [];
          steps := steps + 1;
        }
        spanSteps := 0;
        if forcedSpanOpen {
          break;
        }
      } else {
        // Generate next constrained token
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        spanSteps := spanSteps + 1;
        if next == eosToken {
          // EOS inside span - try to close if complete
          var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
          if isNowComplete && steps < maxSteps {
            var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
            generated := cg;
            insideConstrainedOut := ci;
            currentConstrainedOut := cc;
            steps := steps + 1;
          } else {
            // Rollback to complete
            var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
            generated := rg;
            currentConstrainedOut := rc;
            var isRbComplete := parser.IsCompletePrefix(currentConstrainedOut);
            if isRbComplete && steps < maxSteps {
              var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
              generated := cg;
              insideConstrainedOut := ci;
              currentConstrainedOut := cc;
              steps := steps + 1;
            } else {
              insideConstrainedOut := false;
              currentConstrainedOut := [];
            }
          }
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

cost := steps;

