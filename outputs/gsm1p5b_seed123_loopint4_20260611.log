Strategy: // CSD_RATIONALE_BEGIN
// Deep analysis of all 8 attempts:
//
// THE CORE PROBLEM (from feedback):
// "2/49 of the outputs that show << >> actually ran the strategy's constrained branch"
// "Fix: FORCE span entry — append the opening << directly via a forced-delimiter helper"
//
// The reactive "wait for next == '<<'" approach NEVER works because:
// 1. The model already generates many << tokens in its reasoning
// 2. Our validCount checks then block constrained mode entry
// 3. Result: 47/49 examples have no constrained activity
//
// THE FIX: Force the structure. Don't wait for the model to emit "<<".
// Instead:
// 1. Let the model reason freely for a while (most of the budget)
// 2. FORCE emit "<<" via OpenConstrainedSpan when we're ready for the answer
// 3. Drive the answer content with hard parser control
// 4. Force close with CloseConstrainedSpan
//
// BUT: The model already emits "<<" tokens naturally. If we force one more "<<" at the end,
// we get an extra span. That's fine - the evaluator uses "last_visible_span" (49/49 examples
// used last_visible_span for extraction). So the LAST span is what matters!
//
// Strategy:
// 1. Generate freely until ~80% of budget used (let model reason and emit its own intermediate spans)
// 2. At ~80% mark: force the final answer span via OpenConstrainedSpan (appends "<<")
// 3. Inside the forced span: use hard constrained decoding to generate the arithmetic answer
// 4. Close immediately when IsCompletePrefix
// 5. Use a per-span budget cap to avoid infinite loops
//
// Key design decisions:
// - Use budget_threshold = maxSteps * 7 / 10 for free generation (leave 30% for constrained answer)
// - After free phase ends, force "<<" via OpenConstrainedSpan (costs 1 step)
// - Use ConstrainedStep (hard parser control) inside the forced span
// - Max span budget = 30 tokens (enough for any arithmetic expression)
// - Immediately close when IsCompletePrefix after each constrained token
//
// This guarantees:
// - The LAST visible span is our forced span (correct structure)
// - The content inside is parser-controlled (correct syntax)
// - The span always closes (no unterminated spans)
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//
// Phase 1 (free generation, !insideConstrainedOut):
//   insideConstrainedOut stays false throughout. Implication vacuously true.
//   We never set insideConstrainedOut=true in phase 1.
//
// Phase 2 (forced span entry):
//   OpenConstrainedSpan sets insideConstrainedOut:=true, currentConstrainedOut:=[].
//   parser.IsValidPrefix([]) holds by method precondition. Invariant preserved.
//
// Phase 3 (inside forced span, normal constrained step):
//   ConstrainedStep returns EOS or a parser-valid next token.
//   AppendConstrainedToken postcondition: if token is parser-valid at currentConstrained,
//   then parser.IsValidPrefix(currentConstrained + [token]). Invariant preserved.
//
// Phase 3 (inside forced span, IsCompletePrefix true):
//   CloseConstrainedSpan requires IsCompletePrefix (satisfied), sets insideConstrainedOut:=false.
//   Implication becomes vacuous. Invariant preserved.
//
// Phase 3 (budget cap or dead end):
//   RollbackConstrainedToComplete returns rc such that IsCompletePrefix(rc) or rc=[].
//   Both satisfy IsValidPrefix by parser contract. Then either CloseConstrainedSpan
//   (makes implication vacuous) or insideConstrainedOut:=false (vacuous). Preserved.
//
// Phase 3 (EOS inside span):
//   We rollback to complete then close, or set insideConstrainedOut:=false. Preserved.
//
// progress: |generated| <= |generatedPrefix| + steps
//   Phase 1, free step: steps += 1, generated grows by at most 1. Preserved.
//   Phase 2, OpenConstrainedSpan: steps += 1, generated grows by exactly 1 ("<<"). Preserved.
//   Phase 3, ConstrainedStep + AppendConstrainedToken: steps += 1, generated grows by 1. Preserved.
//   Phase 3, CloseConstrainedSpan: steps += 1, generated grows by at most 1 (">>"). Preserved.
//   Phase 3, RollbackConstrainedToComplete: +0 cost, generated shrinks (OK). Preserved.
//   Phase 3, budget cap abandonment: steps += 1, generated unchanged or shrinks. Preserved.
//   EOS break: steps already incremented, loop exits. Preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem step by step. Show your work using the variable names given. At the end, you MUST write your final numeric answer inside << >> using ONLY digits and operators +,-,*,/,(,). No letters or variable names inside << >>.");

var steps: nat := 0;
// Phase: 0 = free generation, 1 = forced constrained span, 2 = done
var phase: nat := 0;
var spanSteps: nat := 0;
var maxSpanSteps: nat := 30;

// Reserve enough steps for the forced constrained answer span:
// 1 (open) + 30 (content) + 1 (close) = 32 steps minimum
// Free generation gets the rest
var freePhaseLimit: nat := if maxSteps > 40 then maxSteps - 35 else (if maxSteps > 5 then maxSteps - 5 else 0);

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  invariant phase <= 2
  decreases maxSteps - steps
{
  if phase == 0 {
    // Free generation phase - let model reason
    if steps >= freePhaseLimit {
      // Transition to forced constrained span phase
      phase := 1;
      spanSteps := 0;
      // Force open the constrained answer span
      var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
      generated := og;
      insideConstrainedOut := oi;
      currentConstrainedOut := oc;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        // Model wants to stop - force the answer span anyway if we have budget
        if steps + 3 <= maxSteps {
          phase := 1;
          spanSteps := 0;
          var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
          generated := og;
          insideConstrainedOut := oi;
          currentConstrainedOut := oc;
          steps := steps + 1;
        } else {
          phase := 2;
          break;
        }
      } else {
        generated := generated + [next];
        // Don't react to "<<" in free phase - let them be natural
        // We'll force our own "<<" at the end
      }
    }
  } else if phase == 1 {
    // Inside the forced constrained span - hard parser control
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      // Close the span
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
      spanSteps := 0;
      phase := 2;
    } else if spanSteps >= maxSpanSteps {
      // Budget cap - rollback to complete and close
      var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
      generated := rg;
      currentConstrainedOut := rc;
      var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
      if isNowComplete && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      } else {
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        steps := steps + 1;
      }
      spanSteps := 0;
      phase := 2;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount == 0 {
