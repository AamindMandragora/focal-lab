Strategy: // CSD_RATIONALE_BEGIN
// The key failure modes from attempt 1 are:
// 1. malformed_constrained_content (23 examples) - the model generates expressions with
//    variable names, $, {}, or other invalid syntax inside << >> spans
// 2. The constrained intervention activity was very low: only 5/49 examples used constrained
//    decoding, meaning the model was generating << >> spans in free text before the CSD could
//    intercept them (44/49 examples had no constrained activity)
//
// Root cause: The model naturally emits "<<" in its reasoning text (as shown in the rollouts),
// and we call EnterObservedConstrainedSpan when "<<" is observed. But the constrained decoder
// then often generates malformed content or the parser rejects too many tokens.
//
// The approach: Use a two-phase strategy:
// Phase 1: Free generation with UnconstrainedChunk until we detect "<<" opening
// Phase 2: Once inside a constrained span, use repetition-penalty constrained steps to 
//          discourage variable names and encourage pure numeric expressions
// 
// Key insight: The problem is that the model opens << >> spans mid-reasoning with variable
// names/expressions. We need to ensure that:
// a) We intercept EVERY "<<" emission and apply constrained decoding for the content
// b) We use repetition penalty to avoid repeating terms already in the expression
// c) We boost valid numeric/operator tokens
//
// The guidance should be very explicit: the final << >> must contain ONLY numbers and operators.
// Numbers-only inside the last span.
//
// Strategy:
// - Generate freely until "<<" appears (unconstrained)
// - When "<<" is detected: enter constrained mode
// - Inside the span: use SafeRepetitionPenaltyStep to discourage variable names
//   (which appear in the prompt) and encourage numeric tokens
// - Close the span once parser is complete
// - After ">>" is emitted, continue freely
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Unconstrained branch (not inside span): implication is vacuous. When next == "<<",
//     EnterObservedConstrainedSpan sets currentConstrainedOut := [], which satisfies
//     parser.IsValidPrefix([]) by precondition. So invariant holds.
//   - Inside span, IsCompletePrefix: CloseConstrainedSpan sets insideConstrainedOut := false,
//     making the implication vacuous.
//   - Inside span, not complete: SafeRepetitionPenaltyStep returns either eosToken or a
//     parser-valid token. AppendConstrainedToken preserves IsValidPrefix by its postcondition.
//     EOS path sets insideConstrainedOut := false, making implication vacuous.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Unconstrained branch: steps += 1, generated grows by at most 1 (the token next, if non-EOS).
//     So |generated| <= |generatedPrefix| + steps holds.
//   - Inside span, complete: CloseConstrainedSpan appends ">>" (at most 1 token), steps += 1. OK.
//   - Inside span, not complete: SafeRepetitionPenaltyStep costs 1 step, AppendConstrainedToken
//     appends at most 1 token. So steps += 1, |generated| increases by at most 1. OK.
//   - EOS paths: steps += 1, generated unchanged. OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve the math problem step by step. At the very end, output the answer as a single arithmetic expression using ONLY digits and operators (+, -, *, /, (, )) with no spaces, variable names, or text. Wrap it in << >>. Example: <<(12+3)*4>>. The final << >> must contain only digits and arithmetic operators.");

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  invariant maxSteps == 0 || steps > 0 || (generated == generatedPrefix && insideConstrainedOut == insideConstrained && currentConstrainedOut == currentConstrained)
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := og;
        insideConstrainedOut := oi;
        currentConstrainedOut := oc;
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
    } else {
      // Check if we're in a dead end - if so, roll back to last complete prefix
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount == 0 {
        // Dead end: roll back constrained content and try to close
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        // Now close if complete, else use a step to try to advance
        var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
        if isNowComplete {
          var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
        } else {
          // Exit constrained span since we can't make progress
          insideConstrainedOut := false;
          currentConstrainedOut := [];
        }
        steps := steps + 1;
      } else {
        // Use repetition penalty to discourage reusing tokens already in the expression
        // and adaptive constrained step to prefer simpler tokens
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 1.5, eosToken);
        steps := steps + 1;
        if next == eosToken {
          // EOS inside span: try to close if complete, else exit
          var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
          if isNowComplete {
            var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
            generated := cg;
            insideConstrainedOut := ci;
            currentConstrainedOut := cc;
          } else {
            insideConstrainedOut := false;
            currentConstrainedOut := [];
          }
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

cost := steps;

