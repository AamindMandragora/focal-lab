Strategy: // CSD_RATIONALE_BEGIN
// Key diagnosis from failures:
// 1. Syntax rate is only 42.9% - the main problem is that constrained spans are malformed.
// 2. The model emits "<<" naturally during reasoning (variable names like {w1}+{w2}), and when
//    the constrained span opens on these, the parser rejects them.
// 3. The "too_slow" example shows the model getting stuck in an infinite repetition loop inside
//    a constrained span - this happens when the constrained span opens on a partial/bad expression.
// 4. Many examples show "unterminated visible spans" (43/49) - the span opens but never closes cleanly.
//
// Root cause: The model emits "<<" mid-reasoning with variable-name content, then the constrained
// parser tries to parse those variable names as arithmetic, fails, and leaves the span open/malformed.
//
// Fix strategy:
// 1. Generate freely until we detect "<<" or reach near the end of budget.
// 2. When "<<" is detected, enter constrained mode BUT with a strict budget cap on the span.
//    If the span doesn't complete within budget, rollback and try again.
// 3. Use RollbackConstrainedToComplete + CloseConstrainedSpan to ensure spans always close cleanly.
// 4. If we're near end of budget and inside an unclosed span, force rollback to last complete state
//    and close, OR abandon the bad span and let the model continue to try again.
// 5. Key improvement: After each constrained step, check if we're in a dead end. If dead end,
//    immediately rollback to the last complete prefix and close.
// 6. Limit each constrained span to at most 30 tokens (arithmetic expressions are short).
// 7. Use SafeRepetitionPenaltyStep to discourage the model from repeating variable names.
//
// The critical fix for "too_slow": cap the per-span constrained budget so we never loop forever.
// The critical fix for malformed content: rollback to complete + close as soon as parser is done.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Free branch, next != "<<": insideConstrainedOut stays false, implication vacuous.
//   - Free branch, next == "<<": EnterObservedConstrainedSpan sets currentConstrainedOut := [],
//     which satisfies parser.IsValidPrefix([]) by precondition.
//   - Inside span, IsCompletePrefix true: CloseConstrainedSpan sets insideConstrainedOut=false,
//     making the implication vacuous, and clears currentConstrainedOut := [].
//   - Inside span, dead end detected: RollbackConstrainedToComplete returns a complete prefix
//     (or empty []), both of which satisfy IsValidPrefix. Then CloseConstrainedSpan makes
//     insideConstrainedOut=false (vacuous) or we set insideConstrainedOut:=false directly.
//   - Inside span, ConstrainedStep non-EOS: AppendConstrainedToken preserves IsValidPrefix
//     by its postcondition (it only appends parser-valid tokens).
//   - Inside span, EOS: we set insideConstrainedOut:=false, currentConstrainedOut:=[], vacuous.
//   - Budget cap hit inside span: RollbackConstrainedToComplete returns valid prefix, then
//     CloseConstrainedSpan makes implication vacuous.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Free branch: steps += 1, generated grows by at most 1 token. OK.
//   - EnterObservedConstrainedSpan: +0 cost, +0 growth (already counted in free branch). OK.
//   - CloseConstrainedSpan: steps += 1, generated grows by at most 1 (">>"). OK.
//   - RollbackConstrainedToComplete: +0 cost, generated can only shrink or stay same. OK.
//   - ConstrainedStep + AppendConstrainedToken: steps += 1, generated grows by exactly 1. OK.
//   - EOS paths: steps += 1, generated unchanged after break. OK.
//   - spanSteps tracks per-span consumption; total steps bounded by maxSteps. OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem step by step using actual numbers from the problem. At the very end, write the final answer as an arithmetic expression with ONLY digits and operators inside << >>. Example: <<(15+3)*2>>. Only numbers and +,-,*,/,(,) inside << >>, absolutely no variable names or letters.");

var steps: nat := 0;
// Per-span token budget to prevent infinite loops in malformed spans
var spanSteps: nat := 0;
var maxSpanSteps: nat := 25; // Arithmetic expressions are short

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  invariant maxSteps == 0 || steps > 0 || (generated == generatedPrefix && insideConstrainedOut == insideConstrained && currentConstrainedOut == currentConstrained)
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := og;
        insideConstrainedOut := oi;
        currentConstrainedOut := oc;
        spanSteps := 0;
      }
    }
  } else {
    // Inside a constrained span
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      // Close the span cleanly
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
      spanSteps := 0;
    } else if spanSteps >= maxSpanSteps {
      // Per-span budget exceeded - rollback to last complete state and close
      var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
      generated := rg;
      currentConstrainedOut := rc;
      var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
      if isNowComplete && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      } else {
        // Can't close cleanly, abandon span
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        steps := steps + 1;
      }
      spanSteps := 0;
    } else {
      // Check for dead end
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount == 0 {
        // Dead end - rollback to last complete state
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
        if isNowComplete && steps < maxSteps {
          var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
          steps := steps + 1;
        } else {
          insideConstrainedOut := false;
          currentConstrainedOut := [];
          steps := steps + 1;
        }
        spanSteps := 0;
      } else {
        // Generate next constrained token using repetition penalty to avoid variable names
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
        steps := steps + 1;
        spanSteps := spanSteps + 1;
        if next == eosToken {
          // EOS inside span - try to close if complete
          var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
          if isNowComplete && steps < maxSteps {
            var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
            generated := cg;
            insideConstrainedOut := ci;
            currentConstrainedOut := cc;
            steps := steps + 1;
          } else {
            // Rollback to complete
            var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
            generated := rg;
            currentConstrainedOut := rc;
            var isRbComplete := parser.IsCompletePrefix(currentConstrainedOut);
            if isRbComplete && steps < maxSteps {
              var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
              generated := cg;
              insideConstrainedOut := ci;
              currentConstrainedOut := cc;
              steps := steps + 1;
            } else {
              insideConstrainedOut := false;
              currentConstrainedOut := [];
            }
          }
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

cost := steps;

