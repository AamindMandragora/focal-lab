Strategy: // CSD_RATIONALE_BEGIN
// Deep diagnosis from all 7 attempts:
//
// KEY INSIGHT from attempt 7 feedback:
// - "Constrained intervention activity: examples_with_activity 4/49, examples_without_activity 45/49"
// - "visible_span_without_activity 44/49"
// This is the smoking gun: 44/49 examples have visible spans but NO constrained activity!
// The model is generating << >> spans entirely in free (unconstrained) mode.
// Our validCount >= 2 check from attempt 7 was TOO restrictive - it prevented constrained mode
// from activating on 44/45 examples. Only 4 examples triggered constrained mode at all.
//
// The best attempt (4, 38.8%) used EnterObservedConstrainedSpan on EVERY "<<" token,
// giving constrained activity on many more examples. But it had 24 malformed spans.
//
// New diagnosis: The problem is that:
// 1. Model generates intermediate "<<" tokens in reasoning (with variable names) - these produce
//    malformed spans when we try to constrain them
// 2. The FINAL "<<" token contains the actual numeric answer - this one should be constrained
// 3. We need to distinguish intermediate reasoning spans from the final answer span
//
// Strategy: Track span count. The model typically emits multiple "<<" tokens in reasoning.
// Only the LAST span matters for the answer. Key observation: the answer span appears AFTER
// the model has finished reasoning - it's typically a short pure-number span.
//
// New approach: "skip early spans, constrain the final span"
// - Generate freely for the whole budget
// - BUT: when we detect "<<" and the model is near the end of reasoning, enter constrained mode
// - "Near end of reasoning" heuristic: use span counter - after N spans have opened/closed freely,
//   the next one is likely the answer
// - Better heuristic: once we've seen at least 2-3 complete spans in free mode, constrain the next
//
// Actually simpler fix based on the data:
// - avg 3.94 complete visible spans per example
// - The FINAL span is what the evaluator extracts
// - If we constrain ALL spans (attempt 4 approach), 24/49 malformed due to variable names
// - If we constrain NONE (attempt 7 with threshold), 45/49 have no constrained activity
//
// The solution: enter constrained mode on EVERY "<<" token (like attempt 4), BUT:
// 1. Check validCount immediately after entering
// 2. If validCount == 0 (dead end right away), immediately exit constrained mode
//    and continue free generation (the "<<" token stays visible but unconstrained)
// 3. If we get even 1 valid token, try to constrain
// 4. Use a very short budget (15 tokens) per span
// 5. Use immediate close-on-complete
//
// The key difference from attempt 7: we check validCount AFTER entering (not before),
// and we don't gate entry on validCount >= 2. This gives more constrained activity
// while still handling dead-end variable-name spans gracefully.
//
// Additional fix: use ConstrainedStep (pure hard control) not SafeTemperatureConstrainedStep,
// to avoid the temperature scaling interfering with token selection.
//
// Also: reduce per-span budget to 15 to avoid spending too long on bad spans.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//
// Branch 1: !insideConstrainedOut, free step, next != "<<"
//   insideConstrainedOut stays false. Implication vacuous. Preserved.
//
// Branch 2: !insideConstrainedOut, free step, next == "<<"
//   EnterObservedConstrainedSpan sets currentConstrainedOut := [].
//   parser.IsValidPrefix([]) holds by precondition. insideConstrainedOut := true.
//   Then we immediately check validCount: if validCount == 0, we set
//   insideConstrainedOut := false, currentConstrainedOut := [] (vacuous). Preserved.
//   If validCount > 0: insideConstrainedOut = true, currentConstrainedOut = [].
//   IsValidPrefix([]) holds. Preserved.
//
// Branch 3: insideConstrainedOut, IsCompletePrefix true
//   CloseConstrainedSpan sets insideConstrainedOut := false. Implication vacuous. Preserved.
//
// Branch 4: insideConstrainedOut, spanSteps >= maxSpanSteps (budget cap)
//   RollbackConstrainedToComplete returns IsCompletePrefix or [] - both are IsValidPrefix.
//   If isNowComplete: CloseConstrainedSpan → insideConstrainedOut=false, vacuous. Preserved.
//   Else: insideConstrainedOut:=false, currentConstrainedOut:=[] → vacuous. Preserved.
//
// Branch 5: insideConstrainedOut, validCount == 0 (dead end mid-span)
//   RollbackConstrainedToComplete returns IsCompletePrefix or [] → IsValidPrefix.
//   Close or abandon → insideConstrainedOut=false or currentConstrainedOut=[]. Preserved.
//
// Branch 6: insideConstrainedOut, normal constrained step
//   ConstrainedStep returns EOS or parser-valid token.
//   If non-EOS: AppendConstrainedToken preserves IsValidPrefix. Preserved.
//   If EOS: rollback/close/abandon paths, all preserve invariant as above. Preserved.
//
// progress: |generated| <= |generatedPrefix| + steps
//   Free step: steps += 1, generated grows by at most 1. OK.
//   EnterObservedConstrainedSpan: +0, generated unchanged (already counted). OK.
//   CloseConstrainedSpan: steps += 1, generated grows by at most 1 (">>"). OK.
//   RollbackConstrainedToComplete: +0, generated can only shrink. OK.
//   ConstrainedStep + AppendConstrainedToken: steps += 1, generated grows by 1. OK.
//   Abandon/exit steps: steps += 1 in some paths, generated unchanged. OK.
//   spanSteps tracks per-span; total bounded by steps <= maxSteps. OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem step by step using actual numbers. At the end, write the final numeric answer inside << >>. The content inside << >> must be ONLY digits and arithmetic operators +,-,*,/,(,) with NO variable names, NO letters, NO spaces. Example: <<(15+3)*2>>.");

var steps: nat := 0;
var spanSteps: nat := 0;
var maxSpanSteps: nat := 18;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        // Enter constrained span observation
        var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := og;
        insideConstrainedOut := oi;
        currentConstrainedOut := oc;
        spanSteps := 0;
        // Immediately check if parser has valid continuations
        // If dead-end right away (variable name context), abort constrained mode
        var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
        if validCount == 0 {
          // Parser immediately dead-ends - this is a variable-name "<<", stay free
          insideConstrainedOut := false;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    // Inside a constrained span
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      // Close the span immediately
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
      spanSteps := 0;
    } else if spanSteps >= maxSpanSteps {
      // Per-span budget exceeded
      var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
      generated := rg;
      currentConstrainedOut := rc;
      var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
      if isNowComplete && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      } else {
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        steps := steps + 1;
      }
      spanSteps := 0;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount == 0 {
        // Dead end mid-span
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
        if isNowComplete && steps < maxSteps {
          var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
          steps := steps + 1;
        } else {
          insideConstrainedOut := false;
          currentConstrainedOut := [];
          steps := steps + 1;
        }
        spanSteps := 0;
      } else {
        // Normal constrained step - use pure hard parser control
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        spanSteps := spanSteps + 1;
        if next == eosToken {
          // EOS inside span
          var isNowComplete := parser.IsCompletePrefix(currentConstrainedOut);
          if isNowComplete && steps < maxSteps {
            var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
            generated := cg;
            insideConstrainedOut := ci;
            currentConstrainedOut := cc;
            steps := steps + 1;
          } else {
            var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
            generated := rg;
            currentConstrainedOut := rc;
            var isRbComplete := parser.IsCompletePrefix(currentConstrainedOut);
            if isRbComplete && steps < maxSteps {
              var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
              generated := cg;
              insideConstrainedOut := ci;
              currentConstrainedOut := cc;
              steps := steps + 1;
            } else {
              insideConstrainedOut := false;
              currentConstrainedOut := [];
            }
          }
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
          // Immediately close if now complete
          var nowComplete := parser.IsCompletePrefix(currentConstrainedOut);
          if nowComplete && steps < maxSteps {
            var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
            generated := cg;
            insideConstrainedOut := ci;
            currentConstrainedOut := cc;
            steps := steps + 1;
            spanSteps := 0;
          }
        }
      }
    }
  }
}

