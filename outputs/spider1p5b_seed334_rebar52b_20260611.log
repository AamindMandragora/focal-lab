Strategy: // CSD_RATIONALE_BEGIN
// Analysis of 57% accuracy (attempt 1):
// - 40 examples: syntax_valid_semantic_mismatch (correct SQL syntax, wrong semantics)
// - 3 examples: unterminated spans (parser never reached IsCompletePrefix)
//
// The primary issue is semantic mismatch: the model generates valid SQL but wrong queries.
// Examples show the model:
// 1. Missing WHERE clauses (year = 2014 or year = 2015)
// 2. Using wrong columns (destairport vs airportcode)
// 3. Over-engineering with unnecessary JOINs
//
// The 3 unterminated spans suggest the parser got stuck with "!" or ">" tokens
// that don't terminate the SQL grammar properly.
//
// Key insight from failing examples:
// - "SELECT count(*) FROM concert" - missing WHERE clause
// - "SELECT destairport FROM flights..." - wrong column name
// - Over-complex queries with unnecessary JOINs
//
// The model is generating SQL too quickly without considering the question carefully.
// The ConfidenceGatedStep allows the model to freely choose tokens when valid,
// which means it follows its own SQL generation biases.
//
// Strategy to improve to 60%+:
// 1. Use AdaptiveConstrainedStep with group boosting to steer toward correct patterns
// 2. The validTokenGroups may contain question-relevant tokens (table/column names)
//    that should be boosted when the parser allows them
// 3. Use a stronger guidance that emphasizes reading the question carefully
// 4. Keep ConfidenceGatedStep as fallback but try GroupBoostedConstrainedStep first
//    since the validTokenGroups likely encode task-relevant vocabulary
//
// Key change: Use GroupBoostedConstrainedStep instead of ConfidenceGatedStep.
// This boosts tokens from validTokenGroups (which likely include schema-relevant
// tokens from the question) when they are parser-valid, steering the model
// toward more relevant SQL content.
//
// The boost of 4.0 should be enough to nudge the model toward relevant tokens
// without completely overriding its SQL structure generation.
//
// For the 3 unterminated spans: these are likely caused by the parser getting
// into a state where it accepts "!" as valid but then can't reach completion.
// Using pure constrained generation (GroupBoostedConstrainedStep with hard mask)
// should reduce this since the mask enforces only truly valid tokens.
//
// Guidance improvement: emphasize using exact column/table names from schema
// and answering the specific question asked.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan sets insideConstrainedOut := true and currentConstrainedOut := [].
//      parser.IsValidPrefix([]) holds by precondition. Invariant established.
//   2. In the constrained loop, GroupBoostedConstrainedStep returns next such that either
//      next == eosToken or parser.IsValidPrefix(currentConstrainedOut + [next]).
//      AppendConstrainedToken appends next to both generated and currentConstrainedOut,
//      preserving parser.IsValidPrefix(currentConstrainedOut).
//   3. CloseConstrainedSpan requires IsCompletePrefix, sets insideConstrainedOut := false,
//      making the implication vacuous.
//   4. On EOS break: state unchanged, invariant holds by induction.
//
// progress:
//   OpenConstrainedSpan: steps += 1, |generated| grows by 1 ("<<" token).
//     |generated| = |generatedPrefix| + 1 <= |generatedPrefix| + steps. Preserved.
//   GroupBoostedConstrainedStep + AppendConstrainedToken: steps += 1, |generated| grows by 1.
//     |generated| <= |generatedPrefix| + steps. Preserved.
//   GroupBoostedConstrainedStep returning EOS: steps += 1, |generated| unchanged.
//     |generated| <= |generatedPrefix| + steps. Preserved.
//   CloseConstrainedSpan: steps += 1, |generated| grows by 1 (">>").
//     |generated| <= |generatedPrefix| + steps. Preserved.
//   All branches preserve: |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Guidance emphasizing schema-accurate SQL generation
helpers.AppendTaskGuidance(lm, "Answer the question with a precise SQL query using exactly the table and column names from the schema. Include all necessary WHERE, JOIN, GROUP BY, and ORDER BY clauses required by the question.");

// Phase 1: Force open the constrained span immediately (costs 1 step)
if steps < maxSteps && !insideConstrainedOut {
  var openGenerated, openInside, openCurrent := helpers.OpenConstrainedSpan(lm, generated);
  generated := openGenerated;
  insideConstrainedOut := openInside;
  currentConstrainedOut := openCurrent;
  steps := steps + 1;
}

// Phase 2: Generate constrained SQL inside the span
// Use GroupBoostedConstrainedStep to boost schema-relevant tokens from validTokenGroups
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.GroupBoostedConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

