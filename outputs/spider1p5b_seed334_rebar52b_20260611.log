Strategy: // CSD_RATIONALE_BEGIN
// Analysis of best result (57%): ConfidenceGatedStep with immediate OpenConstrainedSpan.
// Primary failure mode: syntax_valid_semantic_mismatch (40 examples wrong but valid SQL).
// The model generates syntactically correct SQL but wrong semantics.
//
// The failed attempt 3 (44.4%) used SafeRepetitionPenaltyStep but caused:
// - entered_constrained_mode_too_early: 8/9 (this is just our strategy, not a real issue)
// - too_slow: 1/9 (repetition penalty not strong enough or wrong penalty)
//
// Key insight from the evaluator feedback on attempt 3:
// - 4/9 correct, 4/9 syntax-valid-wrong, 1/9 timeout
// - Generated tokens avg 22.33, median 21.00 - MUCH shorter than expected SQL
// - The SQL queries are too short! avg 13 tokens inside span
// - The model is stopping too early (maybe confused by repetition penalty)
//
// The best attempt (57%) had longer, more complete SQL generations.
// SafeRepetitionPenaltyStep penalized too aggressively, causing the model to
// stop generating before completing the query.
//
// Root cause of semantic mismatch in best attempt (57%):
// - The model generates overly complex SQL with wrong JOINs
// - Example: "SELECT DISTINCT T1.country FROM singer AS T1 JOIN concert_singer..."
//   when correct is "SELECT DISTINCT country FROM singer WHERE age > 20"
// - The model uses aliases and JOINs when simple queries would work
//
// Strategy to push from 57% to 60%+:
// 1. Keep ConfidenceGatedStep (best accuracy driver)
// 2. Add guidance that more strongly discourages unnecessary JOINs and aliases
// 3. Use GroupBoostedConstrainedStep with validTokenGroups as a soft preference
//    to steer toward schema-relevant tokens
// 4. The key: use AdaptiveConstrainedStep which applies group boosts only at
//    narrow parser states (when few valid continuations exist). This should
//    help at decision points where the model might go wrong.
//
// Actually, looking at the failure examples more carefully:
// - "SELECT count(*) FROM concert WHERE year IN (2014, 2015)" vs 
//   "select count ( * ) from concert where year = 2014 or year = 2015"
//   These are semantically equivalent! The evaluator might be doing string matching.
// - "SELECT stadium.location, stadium.name FROM stadium WHERE stadium.capacity BETWEEN 5000 AND 10000"
//   vs "select location , name from stadium where capacity between 5000 and 10000"
//   Again, semantically equivalent but different formatting.
// - "SELECT DISTINCT T1.country FROM singer AS T1 JOIN concert_singer..." is WRONG
//   (unnecessary JOIN)
//
// The real issue: the model generates qualified column names (T1.country) when
// unqualified (country) is expected, and uses unnecessary JOINs.
//
// Fix: Use guidance that explicitly says "Use simple queries without aliases or JOINs
// unless absolutely necessary." This might push the model toward simpler SQL.
//
// Also: the evaluator is likely using execution-based evaluation (SQL results match),
// not string matching. So "SELECT count(*) FROM concert WHERE year IN (2014, 2015)"
// would be CORRECT against the expected answer. The 40 semantic mismatches must be
// cases where the model truly generates wrong results.
//
// Best approach: stick with ConfidenceGatedStep + stronger guidance.
// The guidance "Output the query directly without extra conditions" worked well.
// Try adding "Prefer simple queries. Do not use table aliases or unnecessary JOINs."
//
// One more idea: use AdaptiveConstrainedStep instead of ConfidenceGatedStep.
// AdaptiveConstrainedStep applies group boosts when parser state is narrow (few choices).
// This might help at critical decision points (e.g., choosing correct table/column names).
// At narrow states, boost validTokenGroups tokens (schema-relevant).
// This should improve semantic accuracy.
//
// The too_slow issue: the previous timeout was caused by a specific query that
// generates very long SQL. The fix is the same as before: CloseConstrainedSpan
// runs as soon as IsCompletePrefix, which we already do.
//
// Final strategy:
// - Best guidance (attempt 12's guidance)
// - OpenConstrainedSpan immediately
// - Use AdaptiveConstrainedStep with narrow threshold 12 and validTokenGroups
//   This is the most targeted fix for semantic mismatch
// - Fall back pattern unchanged from best attempt
//
// Why AdaptiveConstrainedStep over ConfidenceGatedStep:
// - ConfidenceGatedStep: free when LM is confident, hard mask otherwise
// - AdaptiveConstrainedStep: hard mask always, but at narrow states boosts validTokenGroups
// - validTokenGroups contains schema-relevant tokens (table/column names)
// - At narrow parser states (choosing table/column names), boost schema tokens
// - This should reduce wrong table/column selections
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan sets insideConstrainedOut := true, currentConstrainedOut := [].
//      parser.IsValidPrefix([]) holds by precondition. Invariant established.
//   2. AdaptiveConstrainedStep returns next such that next == eosToken OR
//      parser.IsValidPrefix(currentConstrainedOut + [next]).
//      AppendConstrainedToken appends next to both generated and currentConstrainedOut,
//      preserving parser.IsValidPrefix(currentConstrainedOut). Invariant maintained.
//   3. CloseConstrainedSpan requires IsCompletePrefix(currentConstrainedOut),
//      sets insideConstrainedOut := false (implication vacuous), clears currentConstrainedOut.
//   4. On EOS break: state unchanged, invariant holds.
//
// progress:
//   OpenConstrainedSpan: steps += 1, |generated| grows by 1 ("<<"). Preserved.
//   AdaptiveConstrainedStep + AppendConstrainedToken: steps += 1, |generated| grows by 1.
//     |generated| <= |generatedPrefix| + steps. Preserved.
//   AdaptiveConstrainedStep returning EOS: steps += 1, |generated| unchanged.
//     |generated| <= |generatedPrefix| + (steps-1) <= |generatedPrefix| + steps. Preserved.
//   CloseConstrainedSpan: steps += 1, |generated| grows by 1 (">>").
//     |generated| <= |generatedPrefix| + steps. Preserved.
//   Every branch: consumes exactly 1 step, grows |generated| by at most 1 token.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Best guidance from attempt 12 that achieved 57% accuracy
helpers.AppendTaskGuidance(lm, "Write a concise, correct SQL query. Use only the tables and columns from the schema. Output the query directly without extra conditions.");

// Phase 1: Force open the constrained span immediately (costs 1 step)
if steps < maxSteps && !insideConstrainedOut {
  var openGenerated, openInside, openCurrent := helpers.OpenConstrainedSpan(lm, generated);
  generated := openGenerated;
  insideConstrainedOut := openInside;
  currentConstrainedOut := openCurrent;
  steps := steps + 1;
}

// Phase 2: Generate constrained SQL using AdaptiveConstrainedStep
// Hard-masks to parser-valid tokens always, but boosts validTokenGroups
// (schema-relevant tokens) at narrow parser states where schema choice matters.
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

