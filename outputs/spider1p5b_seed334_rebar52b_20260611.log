Strategy: // CSD_RATIONALE_BEGIN
// Analysis of failures:
// - 57% accuracy, 97% syntax. 40 examples are syntax-valid but semantically wrong.
// - 3 examples have unterminated spans (parser didn't reach IsCompletePrefix before budget ran out).
// - The model generates SQL immediately (entered_constrained_mode_too_early = 100%).
//   This is expected behavior - we open << immediately and constrain generation.
//
// Key failure: "syntax_valid_semantic_mismatch" - the model generates valid SQL but wrong answers.
// Examples show: missing WHERE clauses, wrong JOINs, over-engineered queries.
//
// The model with ConfidenceGatedStep tends to follow its own (wrong) preferences.
// ConfidenceGatedStep only intervenes when the model would violate the parser,
// but the model can still generate valid-but-wrong SQL freely.
//
// Strategy change: Use AdaptiveConstrainedStep with validTokenGroups boosts.
// This gives the model more guidance toward the correct vocabulary (table/column names
// from the schema) while still using hard parser control.
//
// Additionally: the guidance text matters. "Write a concise, correct SQL query"
// got 57%. We need to push the model toward simpler, more correct queries.
//
// Key insight from failures:
// 1. "How many concerts in 2014 or 2015?" -> model outputs "SELECT count(*) FROM concert"
//    Missing WHERE clause. The model skips the WHERE condition.
// 2. "Airport code with most flights?" -> model generates wrong JOIN structure
// 3. "Template type code used by most documents?" -> model generates over-complex query
//
// These are high-level semantic errors, not token-level errors.
// The fix: better guidance AND use AdaptiveConstrainedStep with group boosts
// to favor condition-related tokens when the parser allows them.
//
// The 3 unterminated spans: these happen when the SQL being generated is very long
// and the parser doesn't reach IsCompletePrefix. We need to handle this better.
// Post-loop: rollback to complete prefix and close.
//
// New guidance: emphasize WHERE clauses and simple queries matching the question.
// Use AdaptiveConstrainedStep to gently steer toward schema-relevant tokens.
//
// The key fix for unterminated spans: ensure we always attempt rollback+close
// when budget is available. The previous attempt did this but 3 still failed.
// Those 3 might have had no IsCompletePrefix point to roll back to.
// Fix: use RollbackAndContinue which tries to regenerate from a complete point,
// then we can close. Actually, since budget is tight (avg 26 tokens), we need
// to be careful not to waste steps.
//
// Let's try: AdaptiveConstrainedStep with narrowThreshold=20, keep the good
// guidance, and ensure post-loop cleanup works.
//
// Actually, the best result so far is 57% with ConfidenceGatedStep.
// Let me try AdaptiveConstrainedStep as it was used in other attempts
// but didn't regress badly.
//
// The main change: switch from ConfidenceGatedStep to AdaptiveConstrainedStep
// with validTokenGroups. The group boosts should help when the parser state
// is narrow (many tokens pruned), steering toward schema-relevant choices.
//
// Also: improve guidance to emphasize WHERE clauses and correct joins.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// 1. parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//
//    Init: precondition ensures this holds at entry.
//
//    OpenConstrainedSpan branch: sets currentConstrainedOut := [] and insideConstrainedOut := true.
//    parser.IsValidPrefix([]) holds by precondition. Invariant maintained.
//
//    Loop - IsCompletePrefix branch: CloseConstrainedSpan sets insideConstrainedOut := false.
//    Implication vacuously true. Invariant maintained.
//
//    Loop - AdaptiveConstrainedStep branch (non-EOS): AdaptiveConstrainedStep guarantees
//    parser.IsValidPrefix(currentConstrainedOut + [next]) for non-EOS returns.
//    AppendConstrainedToken extends currentConstrainedOut with next, preserving validity.
//
//    Loop - EOS break: state unchanged, invariant holds.
//
//    Post-loop RollbackConstrainedToComplete: rolls currentConstrainedOut to last
//    IsCompletePrefix or empty. IsCompletePrefix implies IsValidPrefix; [] satisfies
//    IsValidPrefix by precondition. Invariant maintained.
//    CloseConstrainedSpan sets insideConstrainedOut := false. Implication vacuous.
//
// 2. progress: |generated| <= |generatedPrefix| + steps
//
//    Init: steps=0, |generated|=|generatedPrefix|. Holds by equality.
//
//    OpenConstrainedSpan: steps+=1, |generated| grows by 1 ("<<"). Preserved.
//
//    Loop - CloseConstrainedSpan: steps+=1, |generated| grows by at most 1 (">>"). Preserved.
//
//    Loop - AdaptiveConstrainedStep + AppendConstrainedToken: steps+=1, |generated|+=1. Preserved.
//
//    Loop - EOS: steps+=1, |generated| unchanged (EOS not appended). Preserved.
//
//    Post-loop RollbackConstrainedToComplete: no step cost, |generated| may only shrink. Preserved.
//    Post-loop CloseConstrainedSpan: steps+=1 (guard ensures steps < maxSteps), |generated|+=1. Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

helpers.AppendTaskGuidance(lm, "Write a simple, direct SQL query that answers the question. Include WHERE clauses for all filtering conditions. Use only tables and columns mentioned in the schema. Do not add unnecessary JOINs or conditions.");

// Phase 1: Open constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var openGenerated, openInside, openCurrent := helpers.OpenConstrainedSpan(lm, generated);
  generated := openGenerated;
  insideConstrainedOut := openInside;
  currentConstrainedOut := openCurrent;
  steps := steps + 1;
}

// Phase 2: Generate constrained SQL using AdaptiveConstrainedStep with group boosts
// AdaptiveConstrainedStep uses hard parser control always, with group boosts
// applied when the parser state is narrow (few valid tokens).
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 20, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

// Post-loop cleanup: if still inside constrained span and budget remains,
// rollback to last complete parse and close.
if insideConstrainedOut && steps < maxSteps {
  var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedToComplete(
    parser, generated, currentConstrainedOut
  );
  if parser.IsCompletePrefix(rolledCurrent) {
    generated := rolledGenerated;
    currentConstrainedOut := rolledCurrent;
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  }
}

cost := steps;

