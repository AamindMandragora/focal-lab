Strategy: // CSD_RATIONALE_BEGIN
// Analysis of failures from last attempt (57% accuracy, 97% syntax):
// 1. Primary failure: syntax_valid_semantic_mismatch (wrong SQL but syntactically valid)
// 2. Secondary: unterminated spans (2/10 in latest attempt) - the span budget runs out
//    because the model generates very long SQL (e.g., massive GROUP BY lists)
// 3. The "entered_constrained_mode_too_early" diagnostic is just our strategy's style
//    (immediate span open) - this is correct behavior for our approach
//
// Key insight from failure examples:
// - "GROUP BY stadium_id, name, location, ..." repeating all schema columns endlessly
//   This is the main cause of timeouts and unterminated spans
// - The model generates overly complex JOINs and GROUP BY clauses
//
// The best strategy (57%) uses ConfidenceGatedStep which gives model freedom.
// The repetition problem occurs when the model enters a loop generating column names.
//
// Fix strategy:
// 1. Use SafeRepetitionPenaltyStep instead of ConfidenceGatedStep to penalize
//    already-generated tokens - this directly addresses the repetition loops
// 2. Reserve the last few steps (e.g., 20) for span closure via RollbackAndContinue
//    if the parser hasn't reached complete state
// 3. Use a token budget limit: if currentConstrainedOut grows too long (e.g., > 80 tokens),
//    attempt rollback to complete state and force close
//
// Actually, the BEST approach based on all evidence:
// - SafeRepetitionPenaltyStep (attempt 3) got 44.4% with 88.9% syntax - worse than ConfidenceGatedStep
// - The repetition is the main issue for the GROUP BY case
// - We need to BOTH use ConfidenceGatedStep (for accuracy) AND prevent repetition
//
// Better plan: Use ConfidenceGatedStep but add a length guard:
// - If |currentConstrainedOut| exceeds a threshold (e.g., 60 tokens), use
//   RollbackConstrainedToComplete to get to a complete state and close
// - This prevents the endless GROUP BY loops while preserving accuracy for normal queries
//
// The threshold 60 tokens: typical SQL queries are 10-40 tokens, so 60 gives ample room
// while preventing the 1200-token runaway cases
//
// Also reserve 3 steps at the end for rollback + close operations
//
// Strategy:
// 1. Open span immediately
// 2. Use ConfidenceGatedStep in main loop
// 3. If length exceeds threshold, rollback to complete and close
// 4. Close as soon as IsCompletePrefix is true
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan sets insideConstrainedOut := true and currentConstrainedOut := [].
//      parser.IsValidPrefix([]) holds by precondition. Invariant established.
//   2. In the constrained loop, ConfidenceGatedStep returns next such that either
//      next == eosToken or IsValidPrefix(currentConstrainedOut + [next]).
//      AppendConstrainedToken preserves IsValidPrefix(currentConstrainedOut).
//   3. RollbackConstrainedToComplete sets currentConstrainedOut to a complete prefix
//      (or empty), both of which are valid prefixes. IsCompletePrefix implies IsValidPrefix.
//   4. CloseConstrainedSpan sets insideConstrainedOut := false, making the implication vacuous.
//
// progress:
//   OpenConstrainedSpan: steps += 1, |generated| grows by 1 (the "<<" token).
//   ConfidenceGatedStep + AppendConstrainedToken: steps += 1, |generated| grows by 1.
//   ConfidenceGatedStep returning EOS: steps += 1, |generated| unchanged.
//   RollbackConstrainedToComplete: steps unchanged, |generated| can only shrink (rollback).
//   CloseConstrainedSpan: steps += 1, |generated| grows by at most 1 (">>").
//   All branches: |generated| - |generatedPrefix| <= steps throughout.
//   When maxSteps > 0: loop runs at least once (steps becomes >= 1), so cost >= 1 > 0.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

helpers.AppendTaskGuidance(lm, "Write a concise, correct SQL query. Use only the tables and columns from the schema. Output the query directly without extra conditions.");

// Phase 1: Force open the constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var openGenerated, openInside, openCurrent := helpers.OpenConstrainedSpan(lm, generated);
  generated := openGenerated;
  insideConstrainedOut := openInside;
  currentConstrainedOut := openCurrent;
  steps := steps + 1;
}

// Phase 2: Generate constrained SQL inside the span
// Reserve 3 steps for potential rollback + close at end
var lengthThreshold: nat := 60;

while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if parser.IsCompletePrefix(currentConstrainedOut) {
    // Close the span as soon as parser says it's complete
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else if |currentConstrainedOut| >= lengthThreshold && steps + 2 <= maxSteps {
    // Query is getting too long - rollback to a complete prefix and close
    var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedToComplete(
      parser, generated, currentConstrainedOut
    );
    // After rollback, check if we have a complete prefix to close
    if parser.IsCompletePrefix(rolledCurrent) {
      generated := rolledGenerated;
      currentConstrainedOut := rolledCurrent;
      // Now close the span
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      // Rollback returned empty or non-complete - just generate one more step
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next, wasConstrained := helpers.ConfidenceGatedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  } else {
    // Normal generation: use ConfidenceGatedStep
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next, wasConstrained := helpers.ConfidenceGatedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

// If we're still inside a constrained span when budget is nearly exhausted,
// try to rollback to complete and close
if insideConstrainedOut && steps < maxSteps {
  var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedToComplete(
    parser, generated, currentConstrainedOut
  );
  if parser.IsCompletePrefix(rolledCurrent) && steps + 1 <= maxSteps {
    generated := rolledGenerated;
    currentConstrainedOut := rolledCurrent;
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  }
}

cost := steps;

