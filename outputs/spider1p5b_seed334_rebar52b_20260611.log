// CSD_PROOF_SKETCH_BEGIN
// 1. parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//
//    Initialization: insideConstrainedOut := insideConstrained, currentConstrainedOut := currentConstrained.
//    By precondition (insideConstrained ==> parser.IsValidPrefix(currentConstrained)), invariant holds.
//
//    OpenConstrainedSpan branch: sets insideConstrainedOut := true, currentConstrainedOut := [].
//    parser.IsValidPrefix([]) holds by method precondition. Invariant holds.
//
//    Loop - IsCompletePrefix branch: CloseConstrainedSpan sets insideConstrainedOut := false.
//    Implication is vacuously true. Invariant preserved.
//
//    Loop - ConfidenceGatedStep branch (non-EOS): ConfidenceGatedStep guarantees
//    parser.IsValidPrefix(currentConstrainedOut + [next]) when next != eosToken.
//    AppendConstrainedToken updates currentConstrainedOut to include next, preserving validity.
//    Invariant preserved.
//
//    Loop - ConfidenceGatedStep branch (EOS): state unchanged, break. Invariant trivially preserved.
//
//    Post-loop RollbackConstrainedToComplete: when insideConstrainedOut, rolls back to complete prefix.
//    IsCompletePrefix implies IsValidPrefix. If rolledCurrent is empty, IsValidPrefix([]) holds.
//    CloseConstrainedSpan then sets insideConstrainedOut := false. Invariant preserved.
//
// 2. progress: |generated| <= |generatedPrefix| + steps
//
//    Init: steps = 0, |generated| = |generatedPrefix|. Equality holds.
//
//    OpenConstrainedSpan: steps += 1, |generated| grows by exactly 1 ("<<"). Preserved.
//
//    Loop - CloseConstrainedSpan: steps += 1, |generated| grows by exactly 1 (">>"). Preserved.
//
//    Loop - ConfidenceGatedStep non-EOS + AppendConstrainedToken: steps += 1, |generated| += 1.
//    |generated| <= |generatedPrefix| + steps preserved.
//
//    Loop - ConfidenceGatedStep EOS: steps += 1, |generated| unchanged.
//    |generated| <= |generatedPrefix| + (steps - 1) < |generatedPrefix| + steps. Preserved.
//
//    Post-loop: RollbackConstrainedToComplete may shrink generated (no step cost).
//    CloseConstrainedSpan: steps += 1 (still <= maxSteps by guard), |generated| += 1.
//    Since we guarded steps < maxSteps, after += 1 we have steps <= maxSteps. Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Use the exact guidance that achieved 57% in attempt 14
helpers.AppendTaskGuidance(lm, "Write a concise, correct SQL query. Use only the tables and columns from the schema. Output the query directly without extra conditions.");

// Phase 1: Force open the constrained span immediately (costs 1 step)
if steps < maxSteps && !insideConstrainedOut {
  var openGenerated, openInside, openCurrent := helpers.OpenConstrainedSpan(lm, generated);
  generated := openGenerated;
  insideConstrainedOut := openInside;
  currentConstrainedOut := openCurrent;
  steps := steps + 1;
}

