// The repetition issue is the main problem: the model generates valid SQL at first,
// then enters a repetition loop in GROUP BY or ORDER BY clauses.
//
// Root cause of repetition: ConfidenceGatedStep allows the model to freely generate
// tokens it's confident about. When the model enters a repetitive pattern in the
// GROUP BY clause (e.g., "has_pet.stuid, has_pet.petid, pets.petid, ..."), it
// keeps generating because:
// - The parser accepts all these as valid continuations
// - The model is "confident" about the repetitive token
// - IsCompletePrefix is never reached because the model keeps extending
//
// Key fix: Use SafeRepetitionPenaltyStep instead of ConfidenceGatedStep.
// This penalizes tokens that already appear in the generated output, breaking
// repetition loops by making already-seen tokens less likely.
//
// The repetition penalty directly addresses:
// - "has_pet.stuid, has_pet.petid" repeated hundreds of times
// - "stadium.capacity DESC, stadium.average DESC" repeated hundreds of times
//
// By penalizing already-seen tokens, the model will be pushed toward completion
// tokens (like semicolons or end-of-query tokens) rather than repeating columns.
//
// Expected improvement:
// - Eliminate the 3 timeout examples -> recover ~3pp
// - Eliminate the unterminated spans -> recover ~6pp  
// - Maintain accuracy on correct examples
// - Total: 57% + ~9pp = ~66% (optimistic)
//
// Conservative estimate: 57% -> 60%+ by fixing the repetition problem
//
// The guidance from attempt 12 worked best: keep it.
// Strategy: immediate OpenConstrainedSpan + SafeRepetitionPenaltyStep
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan sets insideConstrainedOut := true, currentConstrainedOut := [].
//      parser.IsValidPrefix([]) holds by precondition. Invariant established.
//   2. SafeRepetitionPenaltyStep returns next such that either next == eosToken or
//      parser.IsValidPrefix(currentConstrainedOut + [next]).
//      AppendConstrainedToken appends next to both generated and currentConstrainedOut,
//      preserving parser.IsValidPrefix(currentConstrainedOut). Invariant maintained.
//   3. CloseConstrainedSpan requires IsCompletePrefix, sets insideConstrainedOut := false,
//      making the implication vacuous. currentConstrainedOut := []. Invariant maintained.
//   4. On EOS break: state unchanged from last AppendConstrainedToken call. Invariant holds.
//
// progress:
//   OpenConstrainedSpan: steps += 1, |generated| grows by 1 (the "<<" token).
//     |generated| = |generatedPrefix| + 1 <= |generatedPrefix| + steps. Preserved.
//   SafeRepetitionPenaltyStep + AppendConstrainedToken: steps += 1, |generated| grows by 1.
//     |generated| <= |generatedPrefix| + steps. Preserved.
//   SafeRepetitionPenaltyStep returning EOS: steps += 1, |generated| unchanged.
//     |generated| <= |generatedPrefix| + (steps-1) < |generatedPrefix| + steps. Preserved.
//   CloseConstrainedSpan: steps += 1, |generated| grows by 1 (">>").
//     |generated| <= |generatedPrefix| + steps. Preserved.
//   All branches consume exactly one step and grow |generated| by at most one token.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Best guidance from attempt 12 that achieved 57% accuracy
helpers.AppendTaskGuidance(lm, "Write a concise, correct SQL query. Use only the tables and columns from the schema. Output the query directly without extra conditions.");

// Phase 1: Force open the constrained span immediately (costs 1 step)
if steps < maxSteps && !insideConstrainedOut {
  var openGenerated, openInside, openCurrent := helpers.OpenConstrainedSpan(lm, generated);
  generated := openGenerated;
  insideConstrainedOut := openInside;
  currentConstrainedOut := openCurrent;
  steps := steps + 1;
}

// Phase 2: Generate constrained SQL using SafeRepetitionPenaltyStep
// This penalizes already-seen tokens, breaking repetition loops that cause
// timeouts and unterminated spans in the previous attempt.
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

