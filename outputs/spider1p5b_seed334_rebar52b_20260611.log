Strategy: // CSD_RATIONALE_BEGIN
// Analysis of failure modes:
// - 40/100 wrong answers are syntax_valid_semantic_mismatch: model generates syntactically
//   correct SQL but wrong answer (wrong tables, missing WHERE, wrong JOINs)
// - 3/100 unterminated constrained segments (parser never reaches IsCompletePrefix)
// - The strategy generates 0 tokens before "<<" (enters span immediately)
//
// Root cause of semantic mismatch:
// The model generates queries that are syntactically valid but semantically wrong.
// ConfidenceGatedStep only constrains when the model would produce an invalid token,
// but the model's preferred tokens are often semantically wrong even when syntactically valid.
//
// Root cause of unterminated segments:
// 3 examples where the parser never accepts IsCompletePrefix.
// Looking at the examples: "SELECT ... GROUP BY maker!" - the "!" token causes issues.
// The parser may not reach completion if the model generates a dead-end suffix.
//
// Key insight from the failure examples:
// 1. "SELECT count(*) FROM concert" - missing WHERE clause (incomplete semantics)
// 2. "SELECT destairport FROM flights..." - wrong table/column used
// 3. Complex query with unnecessary JOINs instead of simple subquery
//
// The issue is ConfidenceGatedStep lets the model be too free. The model has learned
// to generate plausible-looking SQL but with wrong semantics.
//
// Strategy improvements to try:
// 1. Instead of ConfidenceGatedStep, use AdaptiveConstrainedStep which uses
//    validTokenGroups boosts. The spider dataset's validTokenGroups should contain
//    schema-specific tokens (table/column names). Using these boosts should steer
//    the model toward correct schema references.
//
// 2. Keep rollback mechanism for unterminated spans.
//
// 3. The guidance should remain the same as the best attempt.
//
// Key change: use AdaptiveConstrainedStep instead of ConfidenceGatedStep.
// AdaptiveConstrainedStep hard-masks to parser-valid tokens AND boosts validTokenGroups
// when the parser state is narrow (few valid choices). This is more restrictive than
// ConfidenceGatedStep but gives schema hints through validTokenGroups.
//
// For the spider dataset, validTokenGroups likely contains:
// - SQL keywords (SELECT, FROM, WHERE, JOIN, GROUP BY, ORDER BY, etc.)
// - Table names from the schema
// - Column names from the schema
//
// Boosting these at narrow parser states (where column/table names must appear)
// should improve accuracy.
//
// The narrowThreshold=20 means: when parser has <=20 valid choices, boost schema tokens.
// This is a "narrow" state where specific tables/columns must be chosen.
//
// However, AdaptiveConstrainedStep uses 12 as its hardcoded narrowThreshold.
// We use the AdaptiveConstrainedStep with 12 threshold which should help.
//
// For unterminated segments: add rollback at a reasonable length (80 tokens)
// to force completion when queries get too long.
//
// Additional improvement: use SafeRepetitionPenaltyStep to avoid repetitive patterns.
// This should help with the "INNER JOIN ... INNER JOIN ..." repetition loops.
//
// Actually, looking at helper costs: both ConfidenceGatedStep and AdaptiveConstrainedStep
// cost +1 per step. The real difference is that AdaptiveConstrainedStep provides
// harder parser control (always hard-masks, not confidence-gated) plus optional boosts.
//
// Let me reconsider: ConfidenceGatedStep achieved 57% while harder-constrained methods
// (like pure ConstrainedStep from earlier attempts) got lower. The model's freedom
// helps. But AdaptiveConstrainedStep with narrow boosts is a middle ground.
//
// Decision: Keep ConfidenceGatedStep but add GroupBoostedConstrainedStep only at
// very narrow states (<=5 valid tokens). At these extreme-narrow states, schema token
// boosts are crucial for picking the right column/table name.
// At wider states (>5), use ConfidenceGatedStep for model freedom.
//
// This is a conservative change from the best-performing attempt.
//
// Also add rollback-based repair for the 3 unterminated cases.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Branch 1 (OpenConstrainedSpan): sets insideConstrainedOut := true,
//     currentConstrainedOut := []. parser.IsValidPrefix([]) holds by precondition.
//   Branch 2 (IsCompletePrefix + CloseConstrainedSpan): CloseConstrainedSpan sets
//     insideConstrainedOut := false, making the implication vacuous. currentConstrainedOut
//     is cleared to [].
//   Branch 3 (GroupBoostedConstrainedStep at narrow state): hard-masks to parser-valid
//     tokens plus EOS. Non-EOS return satisfies IsTokenValidNext, so AppendConstrainedToken
//     produces a new currentConstrainedOut with IsValidPrefix. Invariant preserved.
//   Branch 4 (ConfidenceGatedStep at wide state): returns EOS or a parser-valid next
//     token. AppendConstrainedToken preserves IsValidPrefix. Invariant preserved.
//   Branch 5 (RollbackConstrainedToComplete): shortens currentConstrainedOut to a
//     complete prefix (which IsValidPrefix holds for) or empty (also valid by precondition).
//     Invariant preserved.
//
// progress:
//   OpenConstrainedSpan: steps += 1, |generated| grows by exactly 1 ("<<").
//     |generated| <= |generatedPrefix| + 1 = |generatedPrefix| + steps.
//   GroupBoostedConstrainedStep + AppendConstrainedToken: steps += 1, |generated| grows
//     by 1. Each iteration: delta(|generated|) <= 1 = delta(steps). Bound preserved.
//   ConfidenceGatedStep + AppendConstrainedToken: steps += 1, |generated| grows by 1.
//     Same argument. Bound preserved.
//   ConfidenceGatedStep returning EOS: steps += 1, |generated| unchanged.
//     delta(|generated|) = 0 < 1 = delta(steps). Bound preserved.
//   CloseConstrainedSpan: steps += 1, |generated| grows by at most 1 (">>").
//     Bound preserved.
//   RollbackConstrainedToComplete: steps unchanged (cost +0), |generated| shrinks
//     or stays same. Bound trivially preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Guidance that worked best - keep exactly the same
helpers.AppendTaskGuidance(lm, "Write a concise, correct SQL query. Use only the tables and columns from the schema. Output the query directly without extra conditions.");

// Phase 1: Force open the constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var openGenerated, openInside, openCurrent := helpers.OpenConstrainedSpan(lm, generated);
  generated := openGenerated;
  insideConstrainedOut := openInside;
  currentConstrainedOut := openCurrent;
  steps := steps + 1;
}

// Very narrow threshold: only boost schema tokens when very few valid choices exist
var veryNarrowThreshold: nat := 5;
// Length guard to prevent runaway generation
var lengthGuard: nat := 80;

// Phase 2: Generate constrained SQL
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if parser.IsCompletePrefix(currentConstrainedOut) {
    // Close immediately when parser accepts the span
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else if |currentConstrainedOut| >= lengthGuard && steps + 2 <= maxSteps {
    // Query getting long - try rollback to complete prefix
    var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedToComplete(
      parser, generated, currentConstrainedOut
    );
    if parser.IsCompletePrefix(rolledCurrent) {
      generated := rolledGenerated;
      currentConstrainedOut := rolledCurrent;
      // Close the span
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      // No complete prefix - continue with constrained step
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next, wasConstrained := helpers.ConfidenceGatedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next: Token;
    if validCount <= veryNarrowThreshold && |validTokenGroups| > 0 {
      // Very narrow state: boost schema tokens to pick correct table/column names
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 6.0, eosToken
      );
    } else {
      // Wide state: use ConfidenceGatedStep for model freedom
      var wasConstrained: bool;
      next, wasConstrained := helpers.ConfidenceGatedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

// Final attempt to close if still inside and budget remains
if insideConstrainedOut && steps < maxSteps {
  var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedToComplete(
    parser, generated, currentConstrainedOut
  );
  if parser.IsCompletePrefix(rolledCurrent) && steps + 1 <= maxSteps {
    generated := rolledGenerated;
    currentConstrainedOut := rolledCurrent;
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  }
}

cost := steps;

