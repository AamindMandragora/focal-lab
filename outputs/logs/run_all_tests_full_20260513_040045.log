Strategy: // CSD_RATIONALE_BEGIN
// This strategy tracks the visible output `generated`, whether generation is
// currently inside an arithmetic-computation span, and the active constrained
// contents `currentConstrainedOut`. Outside spans it generates freely, but it
// opportunistically opens a new visible `<< >>` span after arithmetic cue
// tokens such as "=", "+", "-", "*", "/", or after words like "total". This
// encourages step-by-step math work to appear inside delimiters.
// 
// Inside a span, parser validity is the hard authority. The strategy chooses
// between a narrow adaptive constrained token step and a small constrained
// symbol step, using parser branching information to decide. It also applies a
// light repetition penalty and group preferences from `validTokenGroups` when
// useful. As soon as the parser reports the constrained prefix is complete, the
// strategy closes the span with `>>` and resumes free generation.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, `insideConstrainedOut`
//   stays false unless the chunk already emitted "<<", in which case
//   EnterObservedConstrainedSpan sets `currentConstrainedOut := []`, a valid
//   prefix. In the explicit-open branch, OpenConstrainedSpan also sets the
//   constrained prefix to `[]`, preserving validity. In the close branch,
//   CloseConstrainedSpan sets `insideConstrainedOut` to false, so the
//   implication is vacuous. In the constrained token branch,
//   AdaptiveConstrainedStepWithPenalties returns either EOS or a parser-valid
//   next token, and AppendConstrainedToken preserves validity. In the symbol
//   branch, ConstrainedSymbolInGenerated returns a parser-valid `symbolOut`.
//   In the rollback branch, RollbackConstrainedSuffix repairs to a valid
//   constrained prefix.
// progress: In the unconstrained chunk branch, steps increases by `stepsUsed`
//   and visible output grows by at most that many tokens; if the chunk ends on
//   EOS, EOS consumes budget without being appended, so the bound still holds.
//   In the explicit-open and close branches, each helper consumes one token-step
//   and appends at most one visible delimiter, so `|generated| <=
//   |generatedPrefix| + steps` is preserved. In the constrained token branch,
//   the adaptive step consumes one token-step and AppendConstrainedToken adds at
//   most one visible token. In the symbol branch, steps increases by the
//   helper-reported `stepsUsed`, while visible growth is at most the accepted
//   parser-valid prefix, which cannot exceed consumed budget; rejected suffix
//   tokens or EOS only make the inequality easier. In the rollback branch,
//   generated shrinks or stays the same while steps increases by 1, so the
//   bound is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var arithmeticArmed: bool := false;
var cueTokens: seq<Token> := ["=", "+", "-", "*", "/", "total", "sum", "difference", "product", "quotient", "compute", "calculate"];

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if arithmeticArmed {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      arithmeticArmed := false;
      steps := steps + 1;
    } else {
      var remainingOutside: nat := maxSteps - steps;
      var chunkBudget: nat := if remainingOutside > 3 then 3 else remainingOutside;
      var chunkedG, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
        lm, prompt, generated, chunkBudget, "<<", eosToken
      );
      generated := chunkedG;
      steps := steps + stepsUsed;

      if stoppedEos {
        break;
      } else if stoppedOpen {
        var enteredGenerated, enteredInside, enteredCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := enteredGenerated;
        insideConstrainedOut := enteredInside;
        currentConstrainedOut := enteredCurrent;
        arithmeticArmed := false;
      } else {
        var prevEq, foundEq := helpers.LastTokenBefore(generated, "=");
        if foundEq && prevEq != "<<" && prevEq != ">>" {
