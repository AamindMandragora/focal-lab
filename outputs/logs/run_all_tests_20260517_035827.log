Helper policy: helper mask warm-up (0/4 evaluated attempts)
Strategy: // CSD_RATIONALE_BEGIN
// Step-by-step arithmetic CSD with visible computation spans. The strategy
// tracks the visible output `generated`, whether decoding is currently inside a
// `<< >>` constrained arithmetic span, and the active constrained contents
// `currentConstrainedOut`. Outside spans it generates freely, but it also
// watches the recent output for arithmetic cue tokens such as "=", "+", "-",
// "*", "/", and ":"; once such a cue is seen, it opens a constrained span on
// the next outside-span action so arithmetic computations are steered into
// visible delimiters.
// 
// Inside a span, parser validity is the hard authority. If the constrained
// prefix is complete, the strategy closes the span. Otherwise it uses an
// adaptive constrained step with caller-supplied token groups and a small
// penalty list that discourages prematurely emitting visible delimiters inside
// the arithmetic content. This tracked state supports the task by making
// arithmetic snippets likely to appear inside `<< >>` while preserving parser-
// valid constrained content whenever `insideConstrainedOut` is true.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: Outside-span free generation preserves the invariant
// vacuously because `insideConstrainedOut` stays false unless we either observe
// `"<<“` directly or call `OpenConstrainedSpan`; both entry branches reset
// `currentConstrainedOut := []`, and the precondition gives
// `parser.IsValidPrefix([])`. In the complete-prefix branch,
// `CloseConstrainedSpan` exits constrained mode, so the implication becomes
// vacuous.
// 
// parser_validity: In the active constrained branch,
// `AdaptiveConstrainedStepWithPenalties` returns either EOS or a token that is
// parser-valid next under the hard mask. On EOS we break without changing the
// constrained state; otherwise `AppendConstrainedToken` updates
// `currentConstrainedOut` to that valid extension, preserving
// `insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)`.
// 
// progress: In the unconstrained-step branch, `UnconstrainedStep` consumes one
// token-step, we increment `steps` by 1, and visible output grows by at most
// one token (EOS appends nothing). In the forced-open branch,
// `OpenConstrainedSpan` consumes one token-step and appends exactly the visible
// delimiter token, so `|generated| <= |generatedPrefix| + steps` is preserved.
// 
// progress: In the close branch, `CloseConstrainedSpan` consumes one token-step
// and appends at most the closing delimiter, so increasing `steps` by 1
// preserves the bound. In the active constrained branch,
// `AdaptiveConstrainedStepWithPenalties` consumes one token-step; if it returns
// EOS, visible output does not grow, and if it returns a token then
// `AppendConstrainedToken` appends exactly that one already-paid-for token, so
// visible growth is at most the consumed token budget.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve step by step. Put each arithmetic computation inside visible << >> delimiters.");

var steps: nat := 0;
var openArmed: bool := false;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if openArmed {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      openArmed := false;
      steps := steps + 1;
    } else {
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          var enteredGenerated, enteredInside, enteredCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
          generated := enteredGenerated;
          insideConstrainedOut := enteredInside;
          currentConstrainedOut := enteredCurrent;
          openArmed := false;
        } else if next == "=" || next == "+" || next == "-" || next == "*" || next == "/" || next == ":" {
          openArmed := true;
        }
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    openArmed := false;
    steps := steps + 1;
  } else {
    var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
    var constrainedPrompt := prompt + stablePrefix;
    var penaltyTokens: seq<Token> := ["<<", ">>"];
    var next := helpers.AdaptiveConstrainedStepWithPenalties(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, penaltyTokens, 4.0, 12, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

