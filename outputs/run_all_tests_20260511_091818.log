//   emitted; then `EnterObservedConstrainedSpan` sets `currentConstrainedOut := []`,
//   which is a valid parser prefix by the method precondition. In the
//   complete-prefix branch, `CloseConstrainedSpan` exits constrained mode, so
//   the implication becomes vacuous. In the active constrained branches,
//   `AdaptiveConstrainedStep` and `SafeRepetitionPenaltyStep` each return either
//   EOS or a token that preserves parser validity; on non-EOS we commit it with
//   `AppendConstrainedToken`, so `currentConstrainedOut` remains parser-valid.
// progress: In the outside-span branch, `UnconstrainedChunk` consumes
//   `stepsUsed` token-steps and appends at most that many visible tokens; the
//   follow-up `EnterObservedConstrainedSpan` is bookkeeping only and costs 0, so
//   `|generated| <= |generatedPrefix| + steps` is preserved after
//   `steps := steps + stepsUsed`. In the close branch, `CloseConstrainedSpan`
//   consumes 1 step and appends at most one visible delimiter. In each
//   constrained-token branch, the chosen helper consumes exactly 1 step; EOS may
//   consume a step without appending, and non-EOS appends exactly one token via
//   `AppendConstrainedToken`, so visible growth is at most consumed budget.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
