Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD for gsm_symbolic dataset.
// Strategy: Generate free reasoning text outside constrained spans, then use
// constrained decoding inside << >> delimiters for symbolic expressions and
// the final answer. The parser validates the constrained content.
//
// State tracked:
//   - insideConstrainedOut / currentConstrainedOut: whether we are inside a << >> span
//   - generated: full output including reasoning, delimiters, and constrained content
//   - steps: token budget consumed
//
// Conditions / observations:
//   - Outside spans: use UnconstrainedStep for free reasoning; if << is emitted,
//     enter constrained mode.
//   - Inside spans: use AdaptiveConstrainedStep with group boosts for math tokens;
//     when the parser reports completion, close the span with CloseSpanIfComplete.
//   - EOS terminates immediately.
//
// This supports valid generation because math expressions inside << >> are
// validated by the parser token-by-token. Outside spans, the model reasons
// freely. The adaptive helper applies group boosts when the parser is narrow,
// improving coverage of math vocabulary while maintaining hard validity.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside-span branch: insideConstrainedOut is false so the implication is
//     vacuously true unless next == "<<", in which case we set
//     currentConstrainedOut := [] which satisfies IsValidPrefix([]) by
//     precondition parser.IsValidPrefix([]).
//   CloseSpanIfComplete branch: when closed==true, insideConstrainedOut becomes
//     false making the implication vacuous. When closed==false, state is
//     unchanged and the invariant is preserved trivially.
//   Constrained step branch: AdaptiveConstrainedStep returns EOS or a token t
//     such that parser.IsValidPrefix(currentConstrainedOut + [t]). Then
//     AppendConstrainedToken sets currentConstrainedOut := currentConstrainedOut + [t],
//     which preserves IsValidPrefix.
//
// progress:
//   Outside-span branch: steps increments by 1; generated grows by at most 1
//     (one token appended when next != eosToken). So |generated| <= |generatedPrefix| + steps.
//   CloseSpanIfComplete branch: steps increments by 1; generated grows by at
//     most 1 (">>" appended). Bound preserved.
//   Constrained step branch: steps increments by 1; generated grows by at most 1
//     (one token appended via AppendConstrainedToken when next != eosToken).
//     Bound preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math word problem step by step. Show intermediate calculations inside << >> delimiters. Put the final numeric answer inside << >> as well. Reason carefully before each << >> span.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
      );
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

