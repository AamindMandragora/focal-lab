Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD for gsm_symbolic dataset.
// 
// Key insight from failure analysis:
// - 8 examples have malformed constrained content (syntax invalid)
// - The main issue: the model generates equation-like expressions with "=" inside
//   spans, which the parser doesn't accept. Also repetition of "!" characters
//   suggests the model gets stuck in a loop inside constrained spans.
// - 11 mode_A failures are syntax-valid but wrong answers (reasoning errors)
// - 4 mode_B failures have partial valid spans (malformed)
// - 2 examples hit max steps (budget exhausted)
//
// Revised strategy:
// 1. Better task guidance: explicitly instruct to put ONLY final numeric 
//    expressions (not equations) inside << >>, keep spans short.
// 2. Use SafeRepetitionPenaltyStep inside constrained spans to prevent
//    repetition loops (the "!!!" pattern).
// 3. Use a tighter token budget per span: if a span exceeds a reasonable
//    token count without completing, roll back to a valid complete prefix
//    or abandon with rollback.
// 4. Use CloseSpanIfComplete speculatively every step to close spans ASAP.
// 5. Add span-length guard: if the constrained prefix grows too long without
//    completing, roll back to last complete state and close.
// 6. Use SafeTemperatureConstrainedStep with lower temperature (0.7) for more
//    deterministic constrained output.
//
// The "unterminated" and "malformed" failures suggest spans are opened but
// the constrained content is invalid or the model runs out of budget.
// Solution: aggressively close spans as soon as they complete, and if a span
// exceeds MAX_SPAN_TOKENS without completing, force rollback to last complete
// state and close.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside-span branch: insideConstrainedOut is false so the implication is
//     vacuously true unless next == "<<", in which case we set
//     currentConstrainedOut := [] which satisfies IsValidPrefix([]) by
//     precondition parser.IsValidPrefix([]).
//   CloseSpanIfComplete branch (closed==true): insideConstrainedOut becomes
//     false, making the implication vacuous. (closed==false): state unchanged.
//   RollbackConstrainedToComplete branch: RollbackConstrainedToComplete returns
//     a currentOut that is IsCompletePrefix or empty. IsCompletePrefix implies
//     IsValidPrefix, and [] satisfies IsValidPrefix by precondition.
//   Constrained step branch: SafeRepetitionPenaltyStep returns EOS or a token t
//     such that parser.IsValidPrefix(currentConstrainedOut + [t]). Then
//     AppendConstrainedToken sets currentConstrainedOut := currentConstrainedOut + [t],
//     preserving IsValidPrefix.
//
// progress:
//   Outside-span branch: steps increments by 1; generated grows by at most 1.
//     |generated| <= |generatedPrefix| + steps preserved.
//   CloseSpanIfComplete branch: steps increments by 1; generated grows by at
//     most 1 (">>" appended). Bound preserved.
//   RollbackConstrainedToComplete branch: steps increments by 1 (for the close
//     that follows). Generated cannot grow beyond what was already appended.
//     The rollback only removes tokens, it does not add; then CloseConstrainedSpan
//     adds at most 1 token. Bound preserved since step was charged.
//   Constrained step branch: steps increments by 1; generated grows by at most 1.
//     Bound preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math word problem step by step. For EACH intermediate calculation and the final answer, write ONLY the arithmetic expression (no equals sign, no explanation) inside << >> delimiters. Example: The total is <<n1 + n2>>. Keep each << >> span to a single short expression. Do not write equations or text inside << >>.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var spanTokenCount: nat := 0;
var MAX_SPAN_TOKENS: nat := 30;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
        spanTokenCount := 0;
      }
    }
  } else {
    // First try to close if complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      spanTokenCount := 0;
    } else if spanTokenCount >= MAX_SPAN_TOKENS {
      // Span has grown too long without completing - roll back to last complete state
      var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
      generated := rg;
      currentConstrainedOut := rc;
      // Now close the span (currentConstrainedOut is complete or empty)
      var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg2;
      insideConstrainedOut := ci2;
      currentConstrainedOut := cc2;
      spanTokenCount := 0;
    } else {
      // Generate next constrained token with repetition penalty to avoid loops
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken
      );
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
        spanTokenCount := spanTokenCount + 1;
      }
    }
  }
}

cost := steps;

