Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD for gsm_symbolic dataset.
//
// The previous attempt failed because after RollbackConstrainedToComplete,
// the resulting currentConstrainedOut may be empty (not complete), so
// CloseConstrainedSpan's precondition parser.IsCompletePrefix(currentConstrainedOut)
// cannot be proved.
//
// Fix: After rolling back, check if the result is complete before calling
// CloseConstrainedSpan. If it's not complete (empty or not complete), we
// need to use CloseSpanIfComplete which doesn't require IsCompletePrefix,
// or simply exit the span by continuing without closing (and charging a step).
//
// Better approach: Instead of calling CloseConstrainedSpan directly after
// rollback, use CloseSpanIfComplete which handles the completeness check
// internally. But CloseSpanIfComplete costs 1 step and we already charged
// a step for the CloseSpanIfComplete that returned false.
//
// Revised strategy: When span is too long, roll back to complete and then
// use CloseSpanIfComplete on the rolled-back state. If still not complete
// (e.g., empty), just exit constrained mode forcibly by treating it as if
// we got EOS (break out of the span without a close token, but this would
// violate state invariants).
//
// Actually the cleanest fix: after rollback, check parser.IsCompletePrefix
// and only call CloseConstrainedSpan if it is complete. If not complete,
// just leave the span open and continue generating (the span will eventually
// complete or we'll hit budget).
//
// But we also need to not infinite-loop. After rollback without close,
// we continue generating from the rolled-back position, and we reset
// spanTokenCount to 0, giving another MAX_SPAN_TOKENS budget.
//
// The key verification fix: guard CloseConstrainedSpan with
// parser.IsCompletePrefix check.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside-span branch: insideConstrainedOut is false so implication is
//     vacuously true unless next == "<<", in which case we set
//     currentConstrainedOut := [] which satisfies IsValidPrefix([]) by
//     precondition parser.IsValidPrefix([]).
//   CloseSpanIfComplete branch (closed==true): insideConstrainedOut becomes
//     false, making implication vacuous. (closed==false): state unchanged,
//     implication preserved by loop invariant.
//   Long-span rollback branch: RollbackConstrainedToComplete returns a
//     currentOut that is IsCompletePrefix or empty. IsCompletePrefix implies
//     IsValidPrefix. Empty prefix satisfies IsValidPrefix([]) by precondition.
//     We then guard CloseConstrainedSpan with parser.IsCompletePrefix check.
//     If complete, CloseConstrainedSpan sets insideConstrainedOut := false
//     (vacuously true). If not complete, we reset spanTokenCount and continue
//     with the invariant preserved by the rollback result being valid.
//   Constrained step branch: SafeRepetitionPenaltyStep returns EOS or a
//     parser-valid extension token. AppendConstrainedToken preserves IsValidPrefix.
//
// progress:
//   Outside-span branch: steps += 1; generated grows by at most 1.
//   CloseSpanIfComplete branch: steps += 1; generated grows by at most 1.
//   Long-span rollback branch: steps += 1 (for the close attempt); rollback
//     only removes tokens (generated shrinks or stays same), then
//     CloseConstrainedSpan adds at most 1. Net growth bounded by steps charged.
//   Constrained step branch: steps += 1; generated grows by at most 1.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Solve the math word problem step by step. Show intermediate calculations inside << >> delimiters. Put the final numeric answer inside << >> as well. Reason carefully before each << >> span.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var spanTokenCount: nat := 0;
var MAX_SPAN_TOKENS: nat := 30;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
        spanTokenCount := 0;
      }
    }
  } else if spanTokenCount >= MAX_SPAN_TOKENS {
    // Span has grown too long - roll back to last complete state
    var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
    // rc is IsCompletePrefix or empty; both are IsValidPrefix
    generated := rg;
    currentConstrainedOut := rc;
    // Only close if complete
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg2;
      insideConstrainedOut := ci2;
      currentConstrainedOut := cc2;
      steps := steps + 1;
      spanTokenCount := 0;
    } else {
      // Not complete after rollback (empty prefix) - reset span counter and continue
      spanTokenCount := 0;
      steps := steps + 1;
    }
  } else {
    // First try to close if complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
