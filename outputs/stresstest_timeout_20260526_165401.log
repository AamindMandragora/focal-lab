Strategy: // CSD_RATIONALE_BEGIN
// SQL-focused CSD for the Spider dataset. The strategy emits "SQL: <<" as a
// fixed prefix to anchor the output format, then enters a constrained span
// where the SQL parser governs every token. Inside the span we use adaptive
// group-boosted constrained decoding: SQL keyword groups (SELECT, FROM, WHERE,
// JOIN, GROUP BY, ORDER BY, HAVING, LIMIT) are boosted when the parser's valid
// continuation count is narrow, providing soft guidance toward well-formed SQL
// structure. We track whether we have seen FROM and WHERE tokens to adjust
// penalty weights during generation. Once the parser reports a complete prefix
// we close the span and stop.
// State tracked: generated (full output), insideConstrainedOut (span mode),
// currentConstrainedOut (active constrained segment), seenFrom, seenWhere,
// steps (budget counter).
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - Outside-span branch: only flips insideConstrainedOut to true when we
//     observe "<<", setting currentConstrainedOut := [] which satisfies
//     parser.IsValidPrefix([]) by precondition. Implication is vacuous otherwise.
//   - CloseConstrainedSpan branch: sets insideConstrainedOut := false, making
//     the implication vacuous afterward.
//   - Constrained-step branches: GroupBoostedConstrainedStep and
//     AdaptiveConstrainedStep/AdaptiveConstrainedStepWithPenalties all guarantee
//     the returned token is parser-valid or EOS. AppendConstrainedToken preserves
//     parser.IsValidPrefix by extending a valid prefix with a valid next token.
// progress:
//   - Outside-span branch: steps += 1, generated grows by at most 1 token,
//     so |generated| <= |generatedPrefix| + steps. EOS breaks without appending.
//   - CloseConstrainedSpan branch: steps += 1, generated grows by at most 1
//     (the ">>" delimiter), invariant preserved.
//   - Constrained-step branches: steps += 1, AppendConstrainedToken appends
//     exactly 1 token to generated, so growth is exactly 1 per iteration.
//     EOS breaks without appending, so the bound holds in all sub-cases.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var sqlKeywordGroups: seq<seq<Token>> := [
  ["SELECT", "select"],
  ["DISTINCT", "distinct"],
  ["FROM", "from"],
  ["WHERE", "where"],
  ["AND", "and", "OR", "or"],
  ["JOIN", "join", "LEFT", "left", "RIGHT", "right", "INNER", "inner", "OUTER", "outer"],
  ["ON", "on"],
  ["GROUP", "group", "BY", "by"],
  ["HAVING", "having"],
  ["ORDER", "order"],
  ["LIMIT", "limit"],
  ["COUNT", "count", "SUM", "sum", "AVG", "avg", "MAX", "max", "MIN", "min"],
  ["AS", "as"],
  ["IN", "in", "NOT", "not", "EXISTS", "exists"],
  ["BETWEEN", "between", "LIKE", "like"]
];

var allGroups: seq<seq<Token>> := sqlKeywordGroups + validTokenGroups;

helpers.AppendTaskGuidance(lm, "Output exactly one SQL query in the format SQL: <<YOUR QUERY>>. Use only tables and columns from the provided schema. Do not add explanation or markdown. The query must be syntactically valid SQL.");

var seenFrom: bool := false;
var seenWhere: bool := false;
var narrowThreshold: nat := 16;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
        seenFrom := false;
        seenWhere := false;
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    if !seenFrom {
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, allGroups, 6.0, eosToken
      );
    } else if seenFrom && !seenWhere {
      next := helpers.AdaptiveConstrainedStepWithPenalties(
        lm, parser, constrainedPrompt, currentConstrainedOut,
        allGroups, 4.0, [";"], 3.0, narrowThreshold, eosToken
      );
    } else {
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, allGroups, 4.0, narrowThreshold, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
      if next == "FROM" || next == "from" {
        seenFrom := true;
      }
      if next == "WHERE" || next == "where" {
        seenWhere := true;
      }
    }
  }
}

cost := steps;

