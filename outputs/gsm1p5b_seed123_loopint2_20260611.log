Strategy: // CSD_RATIONALE_BEGIN
// Core diagnosis:
// - Best attempt (42.9% accuracy, 51.0% syntax) used reactive "<<" detection + AdaptiveConstrainedStep
// - Main failure: 28/49 examples have malformed_constrained_content
// - The model emits variable names like {n}, n0, frac, etc. inside << >> which fail arithmetic parser
// - The arithmetic parser accepts ONLY numbers and operators, rejecting symbolic names
// - avg 4.65 complete visible spans/example shows model reasons with multiple << >> pairs
// - constrained_intervention_activity only 4/49 examples - most spans bypass our constrained control
//
// Key insight: When model emits "<<" naturally during reasoning, the CONTENT is variable expressions.
// Our constrained decoder enters the span but the FIRST token the model wants to emit (e.g., "n0", "frac")
// is INVALID per the arithmetic parser. DeadEndDetection fires, we rollback, and exit - resulting in 
// malformed or empty constrained content.
//
// Root problem: The arithmetic parser is strict (numbers only). The model consistently generates
// symbolic math reasoning. There's a fundamental mismatch between what the model wants to output
// and what the parser accepts.
//
// Solution strategy:
// 1. Generate freely for most of the output (let model do its symbolic reasoning unconstrained)
// 2. When "<<" appears, ENTER constrained mode but use a "survive or exit" approach:
//    - Try ConstrainedStep; if result is EOS → rollback and exit
//    - If dead-end after adding token → rollback to complete and close
// 3. CRITICAL NEW APPROACH: Instead of entering hard constrained mode on EVERY "<<",
//    allow the model to generate intermediate spans freely (model-controlled << >>),
//    but FORCE a final constrained span near the end of the budget.
//    This way intermediate reasoning spans with variables pass through unconstrained,
//    and the LAST span (which evaluator extracts) is parser-enforced numeric.
//
// Implementation:
// - Phase 1 (free): Generate unconstrained until budget gets low OR natural "<<" detected
// - For natural "<<" early in generation: let it pass through unconstrained (don't constrain)
//   because it's likely a reasoning span with variable names
// - Force a hard constrained span at the END using OpenConstrainedSpan when budget < threshold
// - This ensures the LAST span (what evaluator extracts) is syntactically valid
//
// Budget: 900 steps, ~160 tokens/example average
// Threshold: force open constrained at step ~(maxSteps - 50) or when budget < 50 remaining
// Actually better: force at around step 100 (after model has done most reasoning)
// 
// Wait - looking at data again: "tokens before first visible open: avg 22" - model opens VERY early
// "avg 4.65 complete spans" - model does lots of << >> throughout
// The evaluator takes the LAST complete span
//
// Better approach: Let ALL natural << >> pass through UNCONSTRAINED (fast, no parser interference)
// BUT force a FINAL constrained span at the end that the parser controls
// This gives: valid final answer span + fast unconstrained reasoning
//
// Threshold for forcing: when maxSteps - steps <= 60 (enough for a constrained span + close)
// Use OpenConstrainedSpan to force open, then constrained steps, then close
//
// Also: When we DO force constrain, use SafeRepetitionPenaltyStep to avoid repeating
// variable names from the generated context.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Phase 1 (unconstrained, insideConstrainedOut=false): implication vacuously true throughout.
//     We do NOT enter constrained mode for natural "<<" tokens in this approach - we just let them
//     pass through unconstrained. insideConstrainedOut stays false. Invariant trivially preserved.
//   - Phase 2 (forced constrained span): OpenConstrainedSpan sets currentConstrainedOut := []
//     and insideConstrainedOut := true. parser.IsValidPrefix([]) holds by precondition. Invariant holds.
//   - Inside forced constrained span, ConstrainedStep returns non-EOS valid token:
//     AppendConstrainedToken extends currentConstrainedOut with a parser-valid token, preserving
//     IsValidPrefix by the definition of valid prefix extension.
//   - Inside forced constrained span, EOS from ConstrainedStep: RollbackConstrainedToComplete
//     produces a complete-or-empty prefix satisfying IsValidPrefix. Then we set insideConstrainedOut
//     := false, making the implication vacuously true.
//   - CloseConstrainedSpan / CloseSpanIfComplete (closed=true): insideConstrainedOut becomes false,
//     implication vacuously true.
//   - CloseSpanIfComplete (closed=false): state unchanged, invariant preserved by induction.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Phase 1 unconstrained loop: each iteration calls UnconstrainedStep (steps+1) and appends
//     at most one token to generated. |generated| grows by at most 1, steps grows by 1. OK.
//   - OpenConstrainedSpan: steps+1, generated grows by 1 ("<<"). OK.
//   - ConstrainedStep: steps+1. AppendConstrainedToken adds at most 1 token. EOS path: rollback
//     only shrinks generated. OK.
//   - CloseSpanIfComplete(closed=true): steps+1, generated grows by at most 1 (">>"). OK.
//   - CloseSpanIfComplete(closed=false): steps+1, generated unchanged. OK.
//   - All rollback operations are cost-free and only shrink generated. OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem step by step. Show your work. At the very end, write only the final numeric answer as an arithmetic expression between << and >>. Use only actual numbers and +, -, *, /, (, ) inside << >>. Example: <<42>> or <<5 * 3 + 2>>.");

var steps: nat := 0;

// Phase 1: Generate freely, letting the model reason naturally.
// We do NOT constrain intermediate << >> spans - let them pass through.
// We will force a final constrained span near the end of the budget.
// Force constrained span when remaining budget <= 60 steps.
var forceThreshold: nat := 60;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Check if we should force a constrained span now
    if maxSteps - steps <= forceThreshold && forceThreshold <= maxSteps - steps + forceThreshold {
      // Force open a constrained span for the final answer
      if steps < maxSteps {
        var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
        steps := steps + 1;
        generated := og;
        insideConstrainedOut := oi;
        currentConstrainedOut := oc;
      } else {
        break;
      }
    } else {
      // Free generation phase
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        // Model wants to stop - force a constrained span if we haven't had one
        // Check if we have budget for a minimal constrained answer
        if steps + 5 <= maxSteps {
          var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
          steps := steps + 1;
          generated := og;
          insideConstrainedOut := oi;
          currentConstrainedOut := oc;
        } else {
          break;
        }
      } else {
        generated := generated + [next];
        // Don't enter constrained mode for natural "<<" - let it pass through freely
        // This avoids the parser mismatch with variable names
      }
    }
  } else {
    // Inside forced constrained span - use hard parser control
    // Try to close if complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      // Done with constrained span - continue free generation briefly or stop
      if steps < maxSteps {
        // Generate a few more free tokens to let model finish
        var next2 := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if next2 == eosToken {
          break;
        } else {
          generated := generated + [next2];
        }
      } else {
        break;
      }
    } else {
      // Not complete - check budget
      if steps >= maxSteps {
        // No budget - rollback to complete and try to close
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        break;
      }
      // Generate next constrained token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        // EOS inside constrained span - rollback to complete and close
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// If we exit while still inside a constrained span, clean up
if insideConstrainedOut {
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
  insideConstrainedOut := false;
  currentConstrainedOut := [];
}

cost := steps;

