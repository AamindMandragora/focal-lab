Strategy: // CSD_RATIONALE_BEGIN
// Diagnosis from previous attempts:
// 1. The model emits multiple << >> spans during reasoning (avg 3.8 per example).
//    Many of these contain variable names like {n} instead of actual numbers,
//    causing syntax failures (49% syntax rate).
// 2. The core problem: the model uses << >> for intermediate reasoning steps
//    with variable expressions, not just for the final numeric answer.
// 3. Key insight: We need to PREVENT the model from entering constrained mode
//    for intermediate << spans, OR we need to ensure every << span gets valid
//    constrained content. Since the parser enforces numeric expressions, we
//    should let unconstrained generation handle intermediate reasoning spans
//    (the model emits << expr >> freely) but for the FINAL span, we enforce
//    hard parser control.
// 4. Better approach: Generate unconstrained text for most of the budget.
//    Near the end, use UnconstrainedChunk to detect when the model naturally
//    emits "<<", then use hard constrained decoding for that final span.
// 5. BUT: we can't distinguish "reasoning <<" from "final <<" easily.
//    The real fix is: whenever the model emits "<<", enforce hard parser control
//    for the span content. This ensures ALL spans are syntactically valid.
//    This was attempted before but failed because:
//    - The model generates expressions with {variables} which fail the parser
//    - The constrained decoder struggles to close incomplete spans
// 6. New strategy: Use SafeRepetitionPenaltyStep inside spans to discourage
//    repeating tokens from generated (which includes variable names that were
//    seen in the prompt). This may push the model toward numeric tokens.
//    Also use AdaptiveConstrainedStep with group awareness.
// 7. Most important fix: When EOS occurs inside a constrained span, do NOT
//    break immediately - instead rollback to complete and then try to close
//    the span cleanly. The current approach of setting insideConstrainedOut:=false
//    without emitting ">>" leaves unterminated spans.
// 8. Also important: Two steps are consumed per constrained iteration (CloseSpanIfComplete
//    + ConstrainedStep). The progress invariant in the loop accounts for this by
//    only allowing |generated| to grow by at most the number of steps consumed.
//    Since CloseSpanIfComplete can close the span (adding ">>") and ConstrainedStep
//    adds a token, each loop iteration could add 2 tokens but consumes 2 steps.
// 9. Strategy: 
//    - Use UnconstrainedStep freely, detecting "<<" and entering constrained mode
//    - Inside constrained spans, use SafeRepetitionPenaltyStep to discourage variables
//    - Close spans as soon as complete, continue freely
//    - On EOS inside span: rollback to complete prefix, close span, then break
// 10. The budget issue: CloseSpanIfComplete + ConstrainedStep = 2 steps per iteration
//     when inside a span. We need to track this properly.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Unconstrained branch: insideConstrainedOut=false means implication is vacuous.
//     When next=="<<", EnterObservedConstrainedSpan sets currentConstrainedOut:=[]
//     which satisfies parser.IsValidPrefix([]) by method precondition.
//   - Constrained branch (parser.IsCompletePrefix): CloseConstrainedSpan sets
//     insideConstrainedOut:=false, making implication vacuously true.
//   - Constrained branch (not complete, SafeRepetitionPenaltyStep returns non-EOS):
//     AppendConstrainedToken extends currentConstrainedOut with a parser-valid token,
//     preserving IsValidPrefix by definition of safe constrained steps.
//   - Constrained branch (not complete, EOS): RollbackConstrainedToComplete produces
//     a complete-or-empty prefix; then insideConstrainedOut:=false makes it vacuous.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Unconstrained branch: steps+1, generated grows by at most 1. OK.
//   - Constrained complete branch: CloseConstrainedSpan costs 1 step (steps+1),
//     generated grows by at most 1 (">>"). OK.
//   - Constrained non-complete branch: SafeRepetitionPenaltyStep costs 1 step (steps+1),
//     AppendConstrainedToken adds at most 1 token to generated. EOS path: steps+1,
//     RollbackConstrainedToComplete may shrink generated, so growth ≤ 0 ≤ 1. OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem step by step. Show your work. At the very end, write ONLY the final numeric answer as an arithmetic expression with actual numbers between << and >>. Use only digits and operators +, -, *, /, (, ). Example: <<(15 * 3) + 7>>. Never put variable names or letters inside << >>.");

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := og;
        insideConstrainedOut := oi;
        currentConstrainedOut := oc;
      }
    }
  } else {
    // Inside constrained span
    if parser.IsCompletePrefix(currentConstrainedOut) {
      // Close the span immediately when complete
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
    } else {
      // Generate next constrained token
      // Use SafeRepetitionPenaltyStep to discourage variable names already seen
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
      steps := steps + 1;
      if next == eosToken {
        // EOS inside constrained span - rollback to complete and exit constrained mode
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

