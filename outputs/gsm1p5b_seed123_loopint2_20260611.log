Strategy: // CSD_RATIONALE_BEGIN
// Key diagnosis from attempt 1:
// 1. Syntax rate is only 51% - the primary issue is "malformed_constrained_content" (22 examples).
// 2. The model is using variable names like {n1}, {p}, etc. inside << >> instead of actual numbers.
// 3. The model naturally emits << >> multiple times during reasoning (avg 3.61 spans/example).
// 4. Critical insight: "Constrained intervention activity: examples_with_activity 1/49" - the
//    constrained decoder is almost never activating! The model emits << >> and >> in rapid 
//    succession before we can intercept, OR the parser rejects variable expressions immediately.
// 5. The issue: Qwen emits things like "<<n1 * total>>" where the parser sees "n" and rejects it.
//    Since the constrained decoder rarely activates (48/49 examples have no constrained activity),
//    the model is generating the entire span including ">>" in unconstrained mode.
// 6. Strategy fix: We need to FORCE a constrained span at the END of generation, after the model
//    has done its reasoning. We should:
//    a. Let the model reason freely with unconstrained generation
//    b. After enough reasoning, EXPLICITLY OPEN a constrained span (OpenConstrainedSpan)
//    c. Use hard parser control to fill in only valid arithmetic content
//    d. Close immediately when parser-complete
// 7. This means we should NOT react to natural "<<" emissions (which contain variable names),
//    but instead FORCE our own constrained span at the end.
// 8. Budget allocation: Use most of the budget for free reasoning, then reserve enough steps
//    to open and fill a constrained span.
// 9. The guidance should ask the model to put its NUMERIC answer between << >> at the end,
//    and the CSD will enforce this by opening the span explicitly.
// 10. Key: Use OpenConstrainedSpan (forced delimiter) after reasoning phase, then hard constrained
//     generation until parser-complete, then CloseConstrainedSpan.
// 11. Budget: maxSteps=900, stepTokenBudget=1. Reserve ~100 steps for constrained span.
//     Use ~800 steps for reasoning (UnconstrainedChunk or loop).
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Reasoning phase (insideConstrainedOut=false throughout): implication vacuously true.
//   - OpenConstrainedSpan sets currentConstrainedOut := [] which satisfies IsValidPrefix([])
//     by method precondition. insideConstrainedOut becomes true.
//   - ConstrainedStep returns EOS or parser-valid next token. AppendConstrainedToken extends
//     currentConstrainedOut with a parser-valid token, preserving IsValidPrefix.
//   - EOS path inside span: RollbackConstrainedToComplete produces IsCompletePrefix (which
//     implies IsValidPrefix) or [] (also valid). Then insideConstrainedOut := false makes
//     implication vacuous.
//   - CloseConstrainedSpan sets insideConstrainedOut := false, making implication vacuous,
//     and sets currentConstrainedOut := [].
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Reasoning loop: each UnconstrainedStep increments steps by 1 and appends at most 1 token.
//     EOS: steps+1, generated unchanged. Non-EOS: steps+1, generated grows by 1. OK.
//   - OpenConstrainedSpan: steps+1, generated grows by 1 ("<<" appended). OK.
//   - Constrained loop: each ConstrainedStep increments steps by 1. AppendConstrainedToken
//     appends 1 token to generated. EOS path: steps+1, generated unchanged (rollback may shrink). OK.
//   - CloseConstrainedSpan: steps+1, generated grows by at most 1 (">>"). OK.
//   Throughout: each branch increments steps by exactly 1, so the invariant is maintained.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem step by step. Show your reasoning. At the end, write the final numeric answer as an arithmetic expression using ONLY numbers and operators (+, -, *, /, (, )). The system will automatically place your final answer between << and >>.");

var steps: nat := 0;

// Phase 1: Free reasoning. Reserve steps for the constrained span.
// We need: 1 step for OpenConstrainedSpan + up to 50 steps for content + 1 step for CloseConstrainedSpan
// So reserve 52 steps minimum for the constrained phase.
var reservedSteps: nat := 52;

// If we're already inside a constrained span, skip reasoning phase
if !insideConstrainedOut {
  // Reasoning phase: generate freely until we have enough reasoning or hit budget
  while steps + reservedSteps < maxSteps
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant |generated| <= |generatedPrefix| + steps
    invariant !insideConstrainedOut
    decreases maxSteps - steps
  {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      // Skip any natural << >> - we'll force our own at the end
      // But we need to track if model tries to emit << so we don't double-open
      generated := generated + [next];
    }
  }
}

// Phase 2: Force open a constrained span and fill with hard parser control
// Only if we have enough budget left and we're not already inside constrained span
if steps + reservedSteps <= maxSteps && !insideConstrainedOut {
  // Force open the constrained span
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 3: Generate constrained content with hard parser control
// Budget: we have maxSteps - steps remaining
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Check if complete - close immediately
  if parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    // Generate next constrained token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
    steps := steps + 1;
    if next == eosToken {
      // EOS inside span - rollback to complete and exit
      var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
      generated := rg;
      currentConstrainedOut := rc;
      insideConstrainedOut := false;
      currentConstrainedOut := [];
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// If still inside constrained span and no budget left, rollback to complete
if insideConstrainedOut {
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
  insideConstrainedOut := false;
  currentConstrainedOut := [];
}

cost := steps;

