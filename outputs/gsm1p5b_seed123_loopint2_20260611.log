Strategy: // CSD_RATIONALE_BEGIN
// Core diagnosis from feedback:
// - syntax 44.9% in last attempt (forced-open) vs 51.0% best (reactive to natural "<<")
// - 49/49 examples entered constrained branch (good), but malformed_constrained_content=26
// - Key issues:
//   1. Model emits MULTIPLE "<<" during reasoning (avg 3.96 spans per example)
//   2. Each time "<<" appears, we enter hard constrained mode; but the model is
//      generating things like "<<n0 * r>>" with variable names that the arithmetic
//      parser rejects, causing malformed content
//   3. The "balanced visible spans: 4/49" tells us most spans are unterminated
//   4. The evaluator extracts the LAST visible span as the answer
//
// Root cause: The arithmetic parser requires ONLY numbers and operators.
// The model emits variable names (n0, r, etc.) which fail the parser.
// When hard parser masking rejects variable-name tokens, it produces garbage expressions.
//
// Fix strategy:
// 1. Keep reactive "<<" detection (best at 51.0% syntax was reactive)
// 2. Instead of hard parser-masking which produces garbage when variables appear,
//    use a smarter approach: when inside a constrained span, first check if parser
//    is already dead (because model started with a variable name). If so, rollback
//    and close with whatever we have, OR just let it run unconstrained briefly to
//    finish the expression, then close.
// 3. Better: Use RollbackAndContinue to fix dead-end states.
// 4. Even better approach: after detecting "<<", do NOT enter hard constrained mode
//    immediately. Instead, use ConstrainedStep which hard-masks to valid tokens.
//    The problem is valid tokens may be empty if parser rejects all next tokens.
//    So use DeadEndDetection: if dead end, rollback.
// 5. Final approach: 
//    - Generate unconstrained until "<<" detected
//    - Enter constrained mode
//    - Each step: check if dead end (ValidTokenCount < 1); if so, rollback to last
//      complete or empty, then continue with constrained steps
//    - CloseSpanIfComplete at each step
//    - On EOS inside span: rollback to complete
//    - This should dramatically improve syntax rate
//
// Additional insight from rollouts: The model outputs reasoning like
// "<<n0 * r>>" where n0, r are variable names. The arithmetic parser rejects these.
// Strategy: guide model more strongly toward numeric answers only.
// Use guidance to strongly discourage variable names in << >>.
//
// Also: use RollbackAndContinue which is specifically designed for this:
// "rolls currentConstrained back to its last IsCompletePrefix (or empty), then 
// steps the LM forward, avoiding dead-end tokens"
// This is exactly what we need when the model starts generating invalid content.
//
// Budget allocation:
// - Unconstrained phase: generate until "<<" detected or budget exhausted
// - For each constrained span: use at most ~20 steps (enough for a numeric expression)
// - After closing a span, continue unconstrained (model may open more spans)
// - This allows multiple valid spans; last one is the answer
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Unconstrained branch (next != "<<"): insideConstrainedOut stays false or unchanged
//     (since we only flip it to true in the "<<" sub-branch). Implication vacuously true.
//   - Unconstrained branch (next == "<<"): EnterObservedConstrainedSpan sets
//     currentConstrainedOut := [], satisfying parser.IsValidPrefix([]) by precondition.
//   - Constrained branch, CloseSpanIfComplete (closed=true): insideConstrainedOut becomes
//     false, implication vacuously true.
//   - Constrained branch, dead end detected: RollbackConstrainedToComplete returns a prefix
//     that is IsCompletePrefix or empty, both satisfying IsValidPrefix. Then we close the
//     span or set insideConstrainedOut := false. Implication vacuously true afterward.
//   - Constrained branch, ConstrainedStep returns non-EOS: AppendConstrainedToken appends a
//     parser-valid token (ConstrainedStep hard-masks to valid next tokens), preserving
//     IsValidPrefix by definition of valid prefix extension.
//   - Constrained branch, EOS: RollbackConstrainedToComplete produces complete-or-empty,
//     satisfying IsValidPrefix; then insideConstrainedOut := false makes it vacuous.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Each top-level loop iteration either (a) calls one step-consuming helper that
//     increments steps by 1, or (b) calls a non-step helper after a step-consuming one.
//   - Unconstrained branch: steps+1, generated grows by at most 1 (one non-EOS token).
//   - EnterObservedConstrainedSpan: costs 0, does not grow generated. OK.
//   - Constrained, CloseSpanIfComplete (closed=true): steps+1, generated grows by at
//     most 1 (">>"). |generated| + 1 <= |generatedPrefix| + (steps+1). OK.
//   - Constrained, CloseSpanIfComplete (closed=false): steps+1, generated unchanged. OK.
//   - Constrained, ConstrainedStep: steps+1, AppendConstrainedToken adds at most 1 token.
//     |generated| + 1 <= |generatedPrefix| + (steps+1). OK.
//   - Rollback operations: may only shrink generated. OK.
//   - Dead-end path: after rollback (no cost), we break or the span closes. OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem step by step. At the very end, write the final numeric answer as an arithmetic expression with ONLY numbers (digits) and operators +, -, *, /, (, ) between << and >>. Example: <<(15 * 4) / 2>>. Never use variable names, letters, or words inside << >>.");

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        // Model opened a constrained span - enter constrained mode
        var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := og;
        insideConstrainedOut := oi;
        currentConstrainedOut := oc;
      }
    }
  } else {
    // Inside constrained span
    // Check if already dead-end (model started generating invalid content)
    var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
    if narrow {
      // Dead end: rollback to last complete prefix
      var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
      generated := rg;
      currentConstrainedOut := rc;
      // Now try to close the span (it may be complete after rollback)
      var cg2, ci2, cc2, closed2 := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
      steps := steps + 1;
      generated := cg2;
      insideConstrainedOut := ci2;
      currentConstrainedOut := cc2;
      // Whether closed or not, exit the span to avoid looping in dead-end states
      if !closed2 {
        // Force exit: couldn't close, so just exit constrained mode
        insideConstrainedOut := false;
        currentConstrainedOut := [];
      }
    } else {
      // Not a dead end - check if complete and can close
      var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
      steps := steps + 1;
      if closed {
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
      } else {
        // Not complete yet - generate next constrained token
        if steps >= maxSteps {
          // No budget left - rollback to complete and exit
          var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
          generated := rg;
          currentConstrainedOut := rc;
          insideConstrainedOut := false;
          currentConstrainedOut := [];
          break;
        }
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          // EOS inside constrained span - rollback to complete and exit
          var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
          generated := rg;
          currentConstrainedOut := rc;
          insideConstrainedOut := false;
          currentConstrainedOut := [];
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

