Strategy: // CSD_RATIONALE_BEGIN
// Key diagnosis: The constraint engagement check says 0/49 examples used the
// constrained branch. The model naturally emits "<<" tokens, but our reactive
// trigger (waiting for next == "<<") never fires because the model tokenizes
// "<<" differently or emits it as multiple tokens.
//
// Fix: FORCE the opening of a constrained span near the end of generation,
// instead of waiting for the model to emit "<<". Strategy:
// 1. Generate unconstrained text for most of the budget (leaving ~50 steps for
//    the constrained span).
// 2. When budget threshold is reached (or if model naturally emits EOS), force
//    open a constrained span via OpenConstrainedSpan (which appends "<<" itself).
// 3. Use hard constrained decoding (ConstrainedStep + AppendConstrainedToken) to
//    fill the span with a syntactically valid arithmetic expression.
// 4. CloseSpanIfComplete to close as soon as possible.
// 5. After the constrained span closes, break.
//
// This ensures: (a) constrained branch IS always entered, (b) the final span
// content is parser-valid (syntax rate improves dramatically), (c) the arithmetic
// answer is the last thing before EOS.
//
// Budget: maxSteps=900, stepTokenBudget=1.
// Allocate: ~850 steps unconstrained, then force open span, ~49 steps constrained.
// Since we don't know maxSteps in general, use maxSteps - 50 as the threshold.
// If maxSteps <= 50, start constrained immediately.
//
// The rollout examples show the model gets the reasoning right but pollutes spans
// with variable names. By FORCING a constrained span at the end, we get the model
// to commit to a numeric expression under hard parser control.
//
// Also: if model emits EOS during unconstrained phase, force open a span first
// and try to generate something useful, or just break.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Unconstrained phase (steps < threshold, not yet forced): insideConstrainedOut stays
//     false (we never enter constrained mode here), so implication is vacuously true.
//   - Force-open phase: OpenConstrainedSpan sets insideConstrainedOut:=true and
//     currentConstrainedOut:=[], satisfying parser.IsValidPrefix([]) by precondition.
//   - Constrained phase, ConstrainedStep returns non-EOS: AppendConstrainedToken
//     extends currentConstrainedOut with a parser-valid token (ConstrainedStep hard-masks
//     to valid next tokens), preserving IsValidPrefix. Invariant holds.
//   - Constrained phase, CloseSpanIfComplete (closed=true): insideConstrainedOut:=false,
//     implication vacuously true.
//   - Constrained phase, EOS from ConstrainedStep: RollbackConstrainedToComplete gives
//     complete-or-empty prefix satisfying IsValidPrefix; then insideConstrainedOut:=false
//     makes it vacuous.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Unconstrained branch: steps+1, generated grows by 0 (EOS break) or 1 (token appended).
//     After step: |generated| <= |generatedPrefix| + steps+1. Invariant maintained.
//   - OpenConstrainedSpan: steps+1 (forced delimiter costs 1 step), generated grows by 1
//     ("<<" appended). Net: steps+1, |generated|+1. Invariant maintained.
//   - Constrained ConstrainedStep non-EOS: steps+1, AppendConstrainedToken adds 1 token.
//     Net: steps+1, |generated|+1. Invariant maintained.
//   - CloseSpanIfComplete closed: steps+1, generated grows by at most 1 (">>"). OK.
//   - CloseSpanIfComplete not closed: steps+1, generated unchanged. OK.
//   - EOS inside span: steps+1, RollbackConstrainedToComplete may shrink generated. OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem step by step. Show your reasoning, then give the final answer as a numeric arithmetic expression between << and >>. Use only numbers and +, -, *, /, (, ). Example: <<(3 * 4) + 2>>.");

var steps: nat := 0;
var forcedOpen: bool := false;

// Threshold: leave 50 steps for forced constrained span
var threshold: nat := if maxSteps >= 50 then maxSteps - 50 else 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if steps >= threshold && !forcedOpen {
      // Force open a constrained span now
      // OpenConstrainedSpan appends "<<" and costs 1 step
      var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
      generated := og;
      insideConstrainedOut := oi;
      currentConstrainedOut := oc;
      steps := steps + 1;
      forcedOpen := true;
    } else {
      // Generate unconstrained token
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        // EOS during unconstrained phase - force open a span if we haven't already
        // and there's budget left
        if !forcedOpen && steps < maxSteps {
          var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
          generated := og;
          insideConstrainedOut := oi;
          currentConstrainedOut := oc;
          steps := steps + 1;
          forcedOpen := true;
        } else {
          break;
        }
      } else {
        generated := generated + [next];
      }
    }
  } else {
    // Inside constrained span - use hard constrained decoding
    // Try to close if already complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      // Span closed successfully - we're done
      break;
    } else {
      // Not complete - generate next constrained token
      if steps >= maxSteps {
        // No budget - rollback to complete and exit
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        break;
      }
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        // EOS inside constrained span - rollback to complete and exit
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

