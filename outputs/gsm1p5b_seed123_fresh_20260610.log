Helper policy: helper mask warm-up (0/3 evaluated attempts for bandit)
Strategy: // CSD_RATIONALE_BEGIN
// Math word problem CSD with step-by-step reasoning and << >> delimited expressions.
//
// State tracked:
//   - generated: full output so far (reasoning text + delimited expressions)
//   - insideConstrainedOut: whether we are currently inside a << >> span
//   - currentConstrainedOut: the constrained prefix inside the current span
//   - steps: token budget consumed so far
//   - spanCount: how many << >> spans have been opened (to track progress)
//
// Strategy:
//   1. Append task guidance asking for step-by-step math with << >> delimiters.
//   2. Generate freely outside spans until "<<" is observed, then enter constrained mode.
//   3. Inside a constrained span, use SafeRepetitionPenaltyStep to avoid repeating
//      tokens, combined with GroupBoostedConstrainedStep for narrower parser states.
//   4. Once the parser signals completeness, close the span with CloseConstrainedSpan.
//   5. If EOS is observed at any point, stop.
//
// This supports the task because:
//   - Free generation allows natural language reasoning steps.
//   - Constrained generation inside << >> ensures symbolic expressions and the
//     final answer are parser-valid.
//   - Repetition penalty discourages loops in symbolic expressions.
//   - Group boosting helps steer toward valid math tokens when the parser is narrow.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   !insideConstrainedOut ==> currentConstrainedOut == []
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//
//   Branch 1 (outside span, UnconstrainedStep):
//     If next != "<<": insideConstrainedOut stays false, currentConstrainedOut stays [],
//     implication is vacuous. If next == "<<": we set insideConstrainedOut := true and
//     currentConstrainedOut := [], and parser.IsValidPrefix([]) holds by precondition.
//
//   Branch 2 (inside span, complete, CloseConstrainedSpan):
//     CloseConstrainedSpan sets insideConstrainedOut := false and currentConstrainedOut := [],
//     making the implication vacuous after the call.
//
//   Branch 3 (inside span, not complete, SafeRepetitionPenaltyStep):
//     SafeRepetitionPenaltyStep returns EOS or a parser-valid next token. If EOS, we break
//     and insideConstrainedOut stays true but the loop exits. If not EOS, AppendConstrainedToken
//     extends currentConstrainedOut by a valid token, preserving parser.IsValidPrefix by
//     the contract of AppendConstrainedToken.
//
//   Branch 4 (inside span, narrow, GroupBoostedConstrainedStep):
//     Same argument as Branch 3: returns EOS or parser-valid token; AppendConstrainedToken
//     preserves validity.
//
// progress invariant: |generated| <= |generatedPrefix| + steps
//   Every branch increments steps by exactly 1. In Branch 1, generated grows by at most 1.
//   In Branch 2, generated grows by at most 1 (the ">>" delimiter). In Branches 3/4,
//   generated grows by at most 1 (the appended token). So |generated| - |generatedPrefix|
//   is always <= steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve the math word problem step by step. Show each intermediate calculation by wrapping symbolic expressions and the final answer inside << >> delimiters. For example: The total is <<3+5=8>>. Be concise and end with the final answer in << >>.");

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next: Token;
    if validCount <= narrowThreshold {
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, eosToken
      );
    } else {
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

cost := steps;

