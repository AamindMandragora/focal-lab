var steps: nat := 0;
var narrowThreshold: nat := 12;
// Per-span token budget: if we spend more than this inside a single span, force rollback+close
var maxSpanTokens: nat := 35;
var spanTokens: nat := 0; // tokens generated inside current span

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
        spanTokens := 0;
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    // Span is complete - close it immediately
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
    spanTokens := 0;
  } else if spanTokens >= maxSpanTokens {
    // Span budget exhausted without completing - rollback to last complete prefix and close
    var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedToComplete(
      parser, generated, currentConstrainedOut
    );
    generated := rolledGenerated;
    currentConstrainedOut := rolledCurrent;
    // insideConstrainedOut remains true; currentConstrainedOut is now IsCompletePrefix or []
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      // currentConstrainedOut == [] and [] is not complete - we cannot close cleanly.
      // Just exit constrained mode without a closing delimiter to avoid getting stuck.
      // We must not emit ">>" since the span has no valid content.
      // Reset state: treat as if we never opened this span (span is abandoned).
      insideConstrainedOut := false;
      currentConstrainedOut := [];
      // Remove the dangling "<<" from generated by stripping last |currentConstrained|+1 chars?
      // We can't easily remove it; just leave it and continue. The span is malformed but
      // we avoid burning all remaining budget.
      // Cost 0 for the rollback bookkeeping (already incremented nothing).
      // We need at least 1 step to make progress - do a free step.
      if steps < maxSteps {
        var next := helpers.UnconstrainedStep(lm, prompt, generated);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          generated := generated + [next];
          if next == "<<" {
