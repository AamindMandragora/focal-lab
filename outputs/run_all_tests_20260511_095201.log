Strategy: // CSD_RATIONALE_BEGIN
// This strategy tracks the visible output `generated`, whether decoding is
// currently inside a visible constrained SMILES span, and the active SMILES
// prefix `currentConstrainedOut`. Outside a span it uses short unconstrained
// chunking so the model can emit ordinary wrapper text or naturally emit the
// opening delimiter `<<`; if that delimiter is observed, the strategy switches
// into parser-controlled decoding without appending a second delimiter.
// Inside a span, the strategy chooses among three parser-safe actions based on
// simple observations of the current SMILES prefix: close immediately when the
// parser reports completeness, use a one-token hard constrained step when the
// parser state is narrow or near a dead end, and otherwise use a bounded
// constrained-symbol step to accept the longest valid SMILES prefix from a
// short LM rollout. This tracked state keeps the active SMILES substring
// parser-valid at every in-span step while still allowing efficient progress.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span chunk branch, the implication is vacuous
//   unless `stoppedOnOpenSpan` is true; then we call EnterObservedConstrainedSpan,
//   which sets `insideConstrainedOut := true` and `currentConstrainedOut := []`,
//   and `[]` is a valid parser prefix by precondition. In the close branch,
//   CloseConstrainedSpan exits constrained mode, so the implication becomes
//   vacuous. In the narrow/dead-end branch, ConstrainedStep returns EOS or a
//   parser-valid next token; on the non-EOS path, AppendConstrainedToken
//   preserves parser validity. In the symbol branch, ConstrainedSymbolInGenerated
//   returns a longest accepted parser-valid prefix, so assigning its `currentOut`
//   to `currentConstrainedOut` preserves validity.
// progress: In the outside-span branch, UnconstrainedChunk consumes `stepsUsed`
//   token-steps and appends at most that many visible tokens, so after
//   `steps := steps + stepsUsed` the bound `|generated| <= |generatedPrefix| +
//   steps` is preserved. In the close branch, CloseConstrainedSpan consumes one
//   step and appends at most one delimiter token. In the narrow/dead-end branch,
//   ConstrainedStep consumes one step and AppendConstrainedToken appends at most
//   one visible token, so the bound is preserved. In the symbol branch,
//   ConstrainedSymbolInGenerated consumes `stepsUsed` token-steps, and visible
//   growth is at most the accepted valid prefix length, which is at most the
//   consumed budget even if some sampled suffix or EOS is rejected, so the same
//   output-length bound is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remainingOutside: nat := maxSteps - steps;
    var chunkBudget: nat := if remainingOutside > 4 then 4 else remainingOutside;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpenSpan {
      var enteredGenerated, enteredInside, enteredCurrent := helpers.EnterObservedConstrainedSpan(lm, generated);
      generated := enteredGenerated;
      insideConstrainedOut := enteredInside;
      currentConstrainedOut := enteredCurrent;
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  } else {
    var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
    var constrainedPrompt := prompt + stablePrefix;
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var nearDeadEnd := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);

    if nearDeadEnd || validCount <= narrowThreshold || stepTokenBudget <= 1 {
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    } else {
      var remainingInside: nat := maxSteps - steps;
      var symbolBudget: nat := if stepTokenBudget == 0 || stepTokenBudget > remainingInside then remainingInside else stepTokenBudget;
      var symbolGenerated, symbolCurrent, hitEos, stepsUsed2 := helpers.ConstrainedSymbolInGenerated(
        lm, parser, constrainedPrompt, generated, currentConstrainedOut, symbolBudget, eosToken
      );
      generated := symbolGenerated;
      insideConstrainedOut := true;
      currentConstrainedOut := symbolCurrent;
      steps := steps + stepsUsed2;
      if hitEos {
        break;
      }
    }
  }
}

