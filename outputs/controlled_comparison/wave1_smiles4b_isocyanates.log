Strategy: // CSD_RATIONALE_BEGIN
// SMILES-isocyanate CSD v9.
//
// Root cause analysis: The model generates "O" as the first token inside the
// constrained span, which is a valid (but trivially complete) SMILES for water,
// not an isocyanate. The parser then accepts it as complete and the span closes
// immediately with "<<O>>".
//
// The fix: Instead of opening a constrained span and letting the parser generate
// freely, we need to FORCE the SMILES to start with the isocyanate substructure.
// The strategy is:
// 1. Append strong guidance steering toward isocyanate SMILES starting with O=C=N.
// 2. Use UnconstrainedChunk to generate a short prefix that the model will
//    naturally start with the isocyanate pattern (guided by the task prompt).
// 3. Then open a constrained span for the remainder of the SMILES.
// 4. Use CloseSpanWithinBudget to finalize.
//
// Actually the core issue is the SMILES parser accepts "O" as a complete SMILES
// (water). We need to ensure the output has N=C=O pattern. 
//
// Better approach: Use ConstrainedGeneration (which starts from empty) and
// then check if the result contains isocyanate pattern. But we can't check
// semantic validity easily.
//
// Alternative: Use the unconstrained generation to produce the full SMILES
// without delimiters, guided by strong task prompt. The evaluator extracts
// content between << and >> as the answer. So we need delimiters.
//
// Key insight from diagnostics: "entered_constrained_mode_too_early" - the
// span opens immediately and generates "O" (valid SMILES for water). 
//
// Solution: Generate unconstrained preamble first (even a short one), to
// shift the model's distribution away from trivial molecules. Then open
// constrained span. Use SafeRepetitionPenaltyStep to penalize "O" as standalone
// (it appears in prompt), and boost tokens like "N", "C" to steer toward
// the isocyanate substructure.
//
// Also: Use AdaptiveConstrainedStepWithPenalties with penalty on tokens
// that would close the span too early (like standalone "O").
//
// Most importantly: use UnconstrainedChunk to let the model write a few
// free tokens before the constrained span - this shifts the model's context
// away from generating trivial SMILES.
//
// Strategy:
// 1. AppendTaskGuidance with strong isocyanate guidance.
// 2. Phase 1: Generate ~5 unconstrained tokens as preamble (will be outside <<>>).
//    Stop if "<<" is naturally emitted.
// 3. If not yet in constrained mode, open constrained span.
// 4. Phase 2: Force generation of at least 6 tokens before allowing close.
//    Use SafeRepetitionPenaltyStep to avoid trivial molecules.
//    Penalize "O" as first token to avoid water.
// 5. Phase 3: Normal loop with CloseSpanIfComplete.
// 6. Phase 4: CloseSpanWithinBudget for finalization.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Phase 1 (UnconstrainedChunk): if stoppedOnOpenSpan, we call
//     EnterObservedConstrainedSpan which sets insideConstrainedOut := true,
//     currentConstrainedOut := [] (valid by precondition). Otherwise state
//     unchanged.
//   OpenConstrainedSpan: sets currentConstrainedOut := [] (valid), insideConstrainedOut := true.
//   Phase 2 (forced loop): AdaptiveConstrainedStepWithPenalties returns a
//     hard-masked parser-valid token. We check !isComplete before AppendConstrainedToken.
//     AppendConstrainedToken preserves IsValidPrefix by contract.
//   Phase 3 (normal loop): CloseSpanIfComplete either closes (implication vacuous)
//     or leaves state unchanged. SafeRepetitionPenaltyStep + AppendConstrainedToken
//     preserves validity.
//   Phase 4 (CloseSpanWithinBudget): postcondition guarantees
//     insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut).
// progress:
//   Phase 1 (UnconstrainedChunk): stepsUsed <= preambleSize; generated grows
//     by at most stepsUsed. |generated| <= |generatedPrefix| + steps preserved.
//   OpenConstrainedSpan: steps+1, generated grows by 1 ("<<"). Bound preserved.
//   Phase 2 (forced loop): each iteration steps+1, generated grows by at most 1.
//     |generated| <= |generatedPrefix| + steps preserved.
//   Phase 3 (normal loop): each iteration steps += 1 or 2, visible tokens grow
//     by at most 2. Bound preserved.
//   Phase 4 (CloseSpanWithinBudget with closeBudget = maxSteps - steps):
//     |generated| <= old|generated| + closeBudget <= |generatedPrefix| + maxSteps.
//     We set steps := maxSteps so overall bound holds.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "You must output a SMILES string for an isocyanate molecule. Isocyanates have the -N=C=O functional group. The SMILES must contain N=C=O or O=C=N as a substructure. Valid examples: O=C=NCCC, O=C=NC1CCCCC1, O=C=NCCBr, O=C=NC(C)(C)C, O=C=NCC#N. DO NOT output water (O). DO NOT output methane (C). The isocyanate group is N=C=O. Output ONLY the SMILES with no other text.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Short unconstrained preamble to shift model context
// Use a small budget so we don't waste too much
var preambleSize: nat := 3;
if !insideConstrainedOut && steps + preambleSize <= maxSteps {
  var gOut, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(lm, prompt, generated, preambleSize, "<<", eosToken);
  generated := gOut;
  steps := steps + stepsUsed;
  if stoppedOpen {
    var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := og;
    insideConstrainedOut := oi;
    currentConstrainedOut := oc;
  } else if stoppedEos {
    // EOS hit, done
    cost := steps;
    return;
  }
}

// Phase 2: Open constrained span if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 3: Force at least 8 tokens before allowing close
// Penalize short completions by not calling CloseSpanIfComplete in this phase
var forcedSteps: nat := 0;
var minForced: nat := 8;

while steps < maxSteps && insideConstrainedOut && forcedSteps < minForced
  invariant 0 <= steps <= maxSteps
  invariant 0 <= forcedSteps <= minForced
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps, minForced - forcedSteps
{
  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  // Penalize "O" standalone to avoid water, boost "N" to steer toward isocyanate
  var penaltyTokens := ["O"];
  var next := helpers.AdaptiveConstrainedStepWithPenalties(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 3.0, penaltyTokens, 6.0, 12, eosToken);
  steps := steps + 1;
  forcedSteps := forcedSteps + 1;
  if next == eosToken {
    break;
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      // Already complete, break to closing phase
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Phase 4: Normal constrained generation with close detection
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  if closed {
    break;
  } else {
    if steps < maxSteps {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var isComplete2 := parser.IsCompletePrefix(currentConstrainedOut);
        if !isComplete2 {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

// Phase 5: Finalize with CloseSpanWithinBudget if still open
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

