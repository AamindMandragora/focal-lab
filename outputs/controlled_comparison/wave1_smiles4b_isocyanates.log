Strategy: // CSD_RATIONALE_BEGIN
// SMILES-isocyanate CSD v2. The prior attempt failed because:
// 1. The constrained span was opened immediately (entered_constrained_mode_too_early),
//    generating tiny spans like "O" instead of proper isocyanate SMILES.
// 2. The parser accepted "O" as a valid complete SMILES (water), not an isocyanate.
//
// The root cause: no unconstrained preamble, so the model had no context about
// what to generate before the constrained span started. The model defaulted to
// the simplest valid SMILES token.
//
// Fix strategy:
// 1. Use AppendTaskGuidance with explicit isocyanate SMILES examples to prime the LM.
// 2. Generate an unconstrained preamble (up to ~50 steps) that lets the model
//    "think" about what SMILES to produce. Stop at EOS or when budget forces entry.
// 3. Then open the constrained span and generate the actual SMILES.
// 4. Use AdaptiveConstrainedStep with repetition penalty to encourage diversity
//    and avoid trivial molecules.
// 5. Close the span once the parser accepts a complete SMILES.
//
// Key insight: the SMILES parser likely accepts any valid SMILES as complete,
// including trivial ones like "O". We need the LM to be primed with isocyanate
// context BEFORE entering constrained mode, so it will generate N=C=O-containing
// molecules rather than trivial water/methane.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Preamble loop: insideConstrainedOut stays false throughout (loop condition),
//     so the implication is vacuous. We never set insideConstrainedOut here.
//   OpenConstrainedSpan call: sets insideConstrainedOut := true,
//     currentConstrainedOut := [] which satisfies parser.IsValidPrefix([])
//     by precondition. Invariant holds.
//   Constrained loop, CloseSpanIfComplete (closed == true): sets
//     insideConstrainedOut := false, making implication vacuous;
//     currentConstrainedOut := []. Invariant holds.
//   Constrained loop, CloseSpanIfComplete (closed == false): state unchanged;
//     invariant holds inductively.
//   Constrained loop, AdaptiveConstrainedStep: returns EOS or parser-valid
//     token. AppendConstrainedToken extends currentConstrainedOut by one
//     valid token, preserving parser.IsValidPrefix. Invariant holds.
// progress:
//   Preamble loop: each iteration costs 1 step, appends at most 1 token.
//     |generated| <= |generatedPrefix| + steps preserved.
//   OpenConstrainedSpan: costs 1 step, appends "<<" (1 token).
//     |generated| <= |generatedPrefix| + steps preserved.
//   Constrained loop, CloseSpanIfComplete: costs 1 step, appends at most
//     ">>" (1 token). Bound preserved.
//   Constrained loop, constrained step: costs 1 step (AdaptiveConstrainedStep),
//     AppendConstrainedToken appends 1 token. Bound preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Prime the LM with isocyanate context so it generates N=C=O structures
var guidance: string := "You are generating SMILES for isocyanate molecules. Isocyanates contain the functional group -N=C=O. Examples of isocyanate SMILES: O=C=NCCl, O=C=Nc1ccccc1, O=C=NCCCC, O=C=NC(C)C. Generate a novel isocyanate SMILES that is different from these examples. Output only the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: unconstrained preamble to let the model reason about isocyanate structure
// Reserve enough budget for constrained generation (at least 30 steps for SMILES)
var preambleLimit: nat := 20;
if maxSteps <= 30 {
  preambleLimit := 0;
} else if maxSteps <= 60 {
  preambleLimit := 5;
} else {
  preambleLimit := 20;
}

while steps < preambleLimit && steps < maxSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases preambleLimit - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// Phase 2: open constrained span if not already inside one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 3: constrained SMILES generation loop
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  }

  // Check if we can close the span
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  if closed {
    break;
  }

  // Generate next constrained token
  if steps < maxSteps {
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    // Use repetition penalty to avoid trivial/short molecules, plus adaptive group boosting
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      validTokenGroups, 4.0, 15, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      break;
    }
    var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
    generated := ag;
    insideConstrainedOut := ai;
    currentConstrainedOut := ac;
  }
}

// If still inside constrained span and have budget, try to close it
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg2, ci2, cc2 := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg2;
  insideConstrainedOut := ci2;
  currentConstrainedOut := cc2;
  steps := maxSteps;
}

cost := steps;

