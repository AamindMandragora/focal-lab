Strategy: // CSD_RATIONALE_BEGIN
// SMILES-isocyanate CSD v18.
//
// Root cause analysis from diagnostics:
// - 100% syntax, 0% accuracy = parser-valid SMILES but NOT isocyanates
// - The model generates single-token SMILES like "O" or "c" because CloseSpanIfComplete
//   fires immediately when the parser accepts a trivial complete prefix
// - "tiny_span_dominant: yes" confirms this - the spans contain only 1-2 tokens
// - The model needs to generate an isocyanate SMILES containing N=C=O
//
// The core problem: parser for SMILES accepts "O" as complete immediately.
// When we call CloseSpanIfComplete after just one token, it closes.
//
// Fix: Don't call CloseSpanIfComplete until we've generated enough tokens to
// potentially form an isocyanate. Specifically:
// 1. Use ConstrainedStep in a forced phase WITHOUT any close check for at least
//    8 tokens (enough for minimal isocyanate like "C N = C = O" -> "CN=C=O")
// 2. BUT the real issue is that after appending tokens, the constrained prefix
//    may already be "O" (complete) before we even get to step 2.
// 3. We need to PREVENT the model from starting with just "O" by penalizing
//    tokens that by themselves form complete SMILES.
//
// Better approach: Instead of OpenConstrainedSpan + manual loop, use
// ConstrainedGeneration which loops ConstrainedStep until complete. This will
// give us a full SMILES. But we can't control WHICH SMILES it generates.
//
// Key insight: The SafeRepetitionPenaltyStep approach (best attempt, 100% syntax)
// generates valid SMILES but they're not isocyanates. The model is not being
// guided to include N=C=O.
//
// New approach:
// 1. Strong guidance emphasizing N=C=O must be present  
// 2. Open constrained span
// 3. Phase A: Use BoostedConstrainedStep to HEAVILY boost "N" as first token
//    (isocyanates start with R-N=C=O, so we want the chain to include N=C=O)
//    Actually boost tokens that are valid at position 0 AND lead toward isocyanates
// 4. Phase B: After first token, use SafeRepetitionPenaltyStep with strong
//    boost for isocyanate tokens until we have at least 6 tokens
// 5. Only THEN allow CloseSpanIfComplete
//
// The crucial fix for "tiny_span_dominant": We must not call CloseSpanIfComplete
// until |currentConstrainedOut| >= 5 (minimum isocyanate like N=C=O has 5 tokens:
// N, =, C, =, O but realistically R-N=C=O needs R too).
//
// To avoid calling CloseSpanIfComplete early: run a pure forced generation loop
// for the first 8 tokens without any close check. After that, allow close checks.
// The key is: even in the forced loop, if the parser is at a dead end or complete,
// we must handle it properly.
//
// Dead-end handling: if the constrained prefix leads to a dead end (no valid next
// tokens except EOS), we close. If it's complete, we close too. But we ONLY close
// when |currentConstrainedOut| >= 5.
//
// Anti-trivial fix: Penalize tokens that are "complete SMILES by themselves" like
// standalone element tokens at position 0 that the model uses as output.
// Actually, we can't easily detect this. Instead: after opening the span, first
// check if the empty prefix has EOS as valid (it shouldn't for SMILES), then
// heavily boost "C", "c", "O", "N" but we need the model to use them in combination.
//
// Simplest working fix: Use ConstrainedGeneration which runs to completion,
// combined with heavy guidance about N=C=O. The model with good guidance should
// generate proper isocyanate SMILES.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   OpenConstrainedSpan: sets currentConstrainedOut := [] which satisfies
//     parser.IsValidPrefix([]) by precondition. The implication holds.
//   Forced phase loop: ConstrainedStep hard-masks to parser-valid next tokens,
//     so next is always valid at currentConstrainedOut. AppendConstrainedToken
//     extends currentConstrainedOut by that valid token, preserving
//     parser.IsValidPrefix(currentConstrainedOut). If next == eosToken we break.
//     If parser.IsCompletePrefix, we exit to close phase.
//   Normal phase (CloseSpanIfComplete, closed == true): sets insideConstrainedOut
//     := false, making the implication vacuously true, currentConstrainedOut := [].
//   Normal phase (CloseSpanIfComplete, closed == false): state unchanged; 
//     ConstrainedStep + AppendConstrainedToken preserves validity as above.
//   CloseSpanWithinBudget: postcondition guarantees validity.
// progress:
//   OpenConstrainedSpan: +1 step, generated grows by 1 ("<<"). Bound preserved.
//   Forced phase: each iteration +1 step from ConstrainedStep, generated grows
//     by at most 1 token from AppendConstrainedToken. Bound preserved.
//   Normal phase: CloseSpanIfComplete costs 1 step (either closes or no-op);
//     ConstrainedStep costs 1 step; AppendConstrainedToken costs 0. Total +2 per
//     outer iteration, steps grows by 2. Bound preserved.
//   CloseSpanWithinBudget: budget = maxSteps - steps <= remaining budget.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "You must generate a SMILES string for an isocyanate molecule. Isocyanates MUST contain the N=C=O functional group. The SMILES must include the fragment N=C=O somewhere in the string. Valid examples: CCN=C=O, CCCN=C=O, c1ccccc1N=C=O, ClCCN=C=O, BrCCN=C=O, FC(F)(F)CN=C=O. Generate a novel isocyanate SMILES with N=C=O group. Output ONLY the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Open constrained span immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase A: Forced generation - generate at least 6 tokens WITHOUT close check
// This prevents tiny-span (single token SMILES like "O" or "C")
// We boost isocyanate-relevant tokens to steer toward N=C=O
var minTokens: nat := 6;

while steps < maxSteps && insideConstrainedOut && |currentConstrainedOut| < minTokens
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps, minTokens - |currentConstrainedOut|
{
  // Heavily boost N and = to steer toward isocyanate N=C=O fragment
  // These boosts apply before the constrained step sampling
  helpers.SafePenalizeTokenLogits(lm, [eosToken], 5.0);

  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  
  // Use BoostedConstrainedStep to strongly encourage isocyanate tokens
  var next := helpers.BoostedConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, ["N", "=", "C", "O", "c", "n"], 4.0, eosToken);
  steps := steps + 1;

  if next == eosToken {
    break;
  } else {
    var isValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
    if isValid {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
    // If not valid (shouldn't happen with ConstrainedStep), just continue
  }
}

// Phase B: Normal constrained generation with close detection
// Now that we have at least 6 tokens, allow close detection
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Try to close if complete
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  if closed {
    break;
  } else {
    if steps < maxSteps {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      // Use repetition penalty to avoid copying exemplars, boost isocyanate tokens
      var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Phase C: Finalize with CloseSpanWithinBudget if still open
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

