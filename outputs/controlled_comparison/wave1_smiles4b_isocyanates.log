// SMILES-isocyanate CSD v14.
//
// Root cause analysis from prior attempts:
// - Best attempt (syntax 100%, accuracy 0%): generates syntactically valid SMILES
//   but they are not isocyanates (tiny_span_dominant: 100%, the span contains
//   only 1-2 tokens like "c" or "O").
// - The parser accepts any valid SMILES immediately after a single token (e.g., "C"
//   is a complete valid SMILES), so CloseSpanIfComplete closes too early.
// - The model generates "c" as the first constrained token, which is a valid
//   complete SMILES aromatic atom, and then the span closes.
//
// Fix: We must prevent premature closing. Strategy:
// 1. Use stronger task guidance emphasizing the N=C=O requirement.
// 2. Boost tokens "N", "=", "C" to push toward the isocyanate functional group.
// 3. Use a minimum token count before allowing CloseSpanIfComplete.
//    Specifically: don't check for close until |currentConstrainedOut| >= 7
//    (minimum for e.g. "CCN=C=O").
// 4. Use SafeRepetitionPenaltyStep with a moderate penalty to avoid copying exemplars.
// 5. Use CloseSpanWithinBudget for finalization.
//
// Key insight: The tiny_span problem means we're closing too early. We need to
// accumulate enough tokens to form a valid isocyanate before allowing closure.
// We achieve this by only calling CloseSpanIfComplete after a minimum number
// of constrained tokens have been generated.
//
// The minimum token count of 7 corresponds to the shortest valid isocyanate
// like "CCN=C=O" (7 tokens if each char is a token) or "CN=C=O" (6).
// We use 6 as the minimum to be safe.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   OpenConstrainedSpan: sets insideConstrainedOut := true, currentConstrainedOut := []
//     which satisfies parser.IsValidPrefix([]) by precondition. The implication holds.
//   Forced phase (no close check): ConstrainedStep returns a parser-valid next token
//     (hard mask postcondition). AppendConstrainedToken extends currentConstrainedOut
//     by one valid token, preserving parser.IsValidPrefix(currentConstrainedOut).
//     On EOS we break, leaving insideConstrainedOut true but the loop exits.
//   Normal phase (CloseSpanIfComplete, closed == true): sets insideConstrainedOut
//     := false, making the implication vacuously true.
//   Normal phase (CloseSpanIfComplete, closed == false): state unchanged;
//     invariant holds by inductive hypothesis.
//   CloseSpanWithinBudget: postcondition guarantees parser validity of currentOut.
// progress:
//   OpenConstrainedSpan: costs 1 step, appends "<<", |generated| grows by 1.
//   Forced phase: each iteration increments steps by 1, AppendConstrainedToken
//     appends at most 1 token; bound preserved.
//   Normal phase: CloseSpanIfComplete costs 1 step (|generated| grows by at most 1
//     for ">>"); ConstrainedStep + AppendConstrainedToken costs 1 step, 1 token.
//     Total per outer iteration: at most 2 steps, at most 2 tokens; steps < maxSteps
//     guard ensures we don't exceed budget.
//   CloseSpanWithinBudget: budget = maxSteps - steps; total |generated| <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Task: output a single valid SMILES string for a novel isocyanate molecule. Isocyanates MUST contain the -N=C=O functional group. The SMILES must have at least 6 characters and must contain N=C=O. Examples: CCN=C=O, CCCN=C=O, c1ccccc1N=C=O, CC(C)N=C=O. Do NOT output just a single atom or trivially short SMILES. The SMILES must start with a carbon chain or ring, then N=C=O. Output ONLY the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Open constrained span immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
