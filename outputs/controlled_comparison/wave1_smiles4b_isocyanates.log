Strategy: // CSD_RATIONALE_BEGIN
// SMILES-isocyanate CSD v6.
// Key failures to fix:
// 1. too_slow / time budget exceeded: the constrained span was generating only "O"
//    (tiny span) and then timing out. The parser accepts "O" as complete for SMILES,
//    so CloseSpanIfComplete closes too early generating trivial molecules.
// 2. entered_constrained_mode_too_early: opening constrained span immediately doesn't
//    allow the LM to warm up with context.
// 3. Membership 0%: generated molecules don't contain isocyanate group N=C=O.
//
// Fix strategy:
// - Use ConstrainedGeneration helper which loops internally until parser complete,
//   EOS, or budget. This avoids the step-by-step overhead that caused timeouts.
// - Before constrained generation, boost isocyanate-relevant tokens (N, =, C, O)
//   to guide the LM toward producing isocyanate SMILES.
// - Use a minForcedTokens approach: generate at least 6 tokens before allowing
//   parser completion check. We do this by using SafeRepetitionPenaltyStep in a
//   short forced loop first, then switch to ConstrainedGeneration-style loop.
// - Actually, simplest fix: use ConstrainedGeneration directly but with a budget
//   that leaves room, combined with strong guidance.
// - The real issue: parser accepts single atoms like "O" as complete SMILES.
//   We need to force longer output. Use a forced loop for minTokens steps
//   (not allowing close), then allow closing.
// - To avoid timeout: keep the approach simple and fast. The best result was
//   accuracy 0% syntax 100% with the step-by-step approach. The timeout was
//   from attempt 5 which had extra complexity.
// - Use the best-result approach but add: (1) force at least 10 tokens before
//   allowing CloseSpanIfComplete, (2) use GroupBoostedConstrainedStep with
//   isocyanate token groups to steer toward N=C=O.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   OpenConstrainedSpan sets currentConstrainedOut := [] which satisfies IsValidPrefix([]).
//   In the forced loop: GroupBoostedConstrainedStep returns EOS or parser-valid token.
//     AppendConstrainedToken preserves IsValidPrefix(currentConstrainedOut).
//     We never call AppendConstrainedToken on a complete prefix because we only
//     append when !closed (forced loop never checks close, but we must ensure
//     AppendConstrainedToken precondition holds; its precondition requires
//     !parser.IsCompletePrefix - we guard this with isComplete check).
//   In the normal loop: CloseSpanIfComplete either closes (implication vacuous)
//     or leaves state unchanged. GroupBoostedConstrainedStep returns parser-valid
//     token; AppendConstrainedToken preserves validity (guarded by !isComplete).
//   CloseSpanWithinBudget postcondition guarantees both span invariants.
// progress:
//   Each loop iteration increments steps by 1 or 2, and appends at most 1-2 tokens.
//   |generated| <= |generatedPrefix| + steps holds by induction.
//   CloseSpanWithinBudget: costs at most closeBudget = maxSteps - steps; we set
//     steps := maxSteps, so |generated| <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate one valid SMILES for a novel isocyanate. Isocyanates have the -N=C=O functional group. Good examples: O=C=NCC, O=C=NCCCl, O=C=NC1CCCCC1, O=C=NCCCC. The SMILES must contain N=C=O and be at least 6 atoms. Output only the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Open constrained span
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Force at least 10 tokens before allowing closure
// This prevents the parser from accepting "O" or other trivial single-atom SMILES
var minForcedTokens: nat := 10;

while steps < maxSteps && insideConstrainedOut && |currentConstrainedOut| < minForcedTokens
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps, minForcedTokens - |currentConstrainedOut|
{
  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  var next := helpers.GroupBoostedConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, eosToken);
  steps := steps + 1;
  if next == eosToken {
    break;
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if !isComplete {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Phase 3: Normal constrained generation loop - allow closing
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Try to close if complete
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  if closed {
    break;
  } else {
    if steps < maxSteps {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var isComplete2 := parser.IsCompletePrefix(currentConstrainedOut);
        if !isComplete2 {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

// Phase 4: If still open and budget remains, use CloseSpanWithinBudget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

