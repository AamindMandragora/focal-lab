Strategy: // CSD_RATIONALE_BEGIN
// SMILES-isocyanate CSD v16.
//
// Root cause analysis from failure logs:
// - All 50 examples show "tiny_span_dominant: yes" and "entered_constrained_mode_too_early"
// - The model outputs <<O>> or <<c>> - just a single token SMILES like "O" or "c"
// - The span closes immediately because the parser considers "O" a complete SMILES
// - We need to PREVENT premature closure and FORCE a longer, isocyanate-specific SMILES
//
// Key insight: The SMILES parser considers any single valid SMILES token as complete.
// We need to:
// 1. Generate a minimum number of constrained tokens BEFORE allowing close checks
// 2. Boost tokens that are part of isocyanate structures (N, =, C, atoms)
// 3. Use a strategy that forces at least enough tokens to form "XN=C=O"
//
// Strategy:
// 1. Append guidance emphasizing longer, isocyanate-specific SMILES
// 2. Open constrained span
// 3. Phase 2: Generate minimum 8 tokens WITHOUT any close check
//    - Use ConstrainedStep (hard-masked) to ensure parser validity
//    - Skip close check entirely in this phase
// 4. Phase 3: Normal generation with close check allowed
// 5. Phase 4: CloseSpanWithinBudget for finalization
//
// The critical fix: do NOT call CloseSpanIfComplete in the forced phase.
// Also: use IsCompletePrefix check to skip AppendConstrainedToken when complete.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   OpenConstrainedSpan: sets currentConstrainedOut := [] which satisfies
//     parser.IsValidPrefix([]) by precondition.
//   Forced phase: ConstrainedStep returns a parser-valid next token (hard mask).
//     We guard with !parser.IsCompletePrefix before AppendConstrainedToken to
//     satisfy its precondition. AppendConstrainedToken extends currentConstrainedOut
//     by one valid token, preserving parser.IsValidPrefix(currentConstrainedOut).
//     If complete, we break out to allow closing.
//   Normal phase: CloseSpanIfComplete either closes (insideConstrainedOut := false,
//     making the implication vacuous) or leaves state unchanged (invariant holds
//     by IH). ConstrainedStep + AppendConstrainedToken with IsCompletePrefix guard
//     preserves validity.
//   CloseSpanWithinBudget: postcondition guarantees parser validity.
// progress:
//   OpenConstrainedSpan: costs 1 step, appends 1 token, bound preserved.
//   Each forced-phase iteration: costs 1 step, appends at most 1 token.
//   Each normal-phase iteration: costs 1 or 2 steps (close check + step),
//     appends at most 2 tokens.
//   CloseSpanWithinBudget: budget = maxSteps - steps, total stays within maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a novel isocyanate SMILES with the -N=C=O group. The SMILES must be at least 8 tokens long, containing N=C=O. Good examples: CCN=C=O, CCCN=C=O, c1ccccc1N=C=O, ClCCN=C=O. Output ONLY the SMILES string. Do NOT output just O or C alone.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Open constrained span immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Forced constrained generation - NO close check until minimum tokens
// Force at least 8 tokens to prevent trivial "O" or "c" single-token SMILES
var minTokens: nat := 8;

while steps < maxSteps && insideConstrainedOut && |currentConstrainedOut| < minTokens
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps, minTokens - |currentConstrainedOut|
{
  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
  steps := steps + 1;
  if next == eosToken {
    break;
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      // Already complete - break to allow closing
      break;
    } else {
      var isValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
      if isValid {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Phase 3: Normal constrained generation with close detection
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  if closed {
    break;
  } else {
    if steps < maxSteps {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var isComplete2 := parser.IsCompletePrefix(currentConstrainedOut);
        if isComplete2 {
          // Don't append; let next iteration close
        } else {
          var isValid2 := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
          if isValid2 {
            var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
            generated := ag;
            insideConstrainedOut := ai;
            currentConstrainedOut := ac;
          }
        }
      }
    }
  }
}

// Phase 4: Finalize with CloseSpanWithinBudget if still open
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

