Strategy: // CSD_RATIONALE_BEGIN
// SMILES-isocyanate CSD v13.
//
// Root cause analysis:
// - accuracy 0.0% despite syntax 100%: the generated SMILES are syntactically valid
//   but not isocyanates (no -N=C=O group), or are trivial/single-atom SMILES like "O".
// - tiny_span_dominant: 100% - the constrained spans are too short.
// - The model generates "O" or "N" as a complete SMILES immediately.
//
// Fix strategy:
// 1. Use stronger guidance with explicit structural requirements.
// 2. Use AppendTaskGuidance to prime the model with the isocyanate template.
// 3. Before opening the constrained span, prime with a structural prefix
//    by boosting tokens that form the isocyanate core.
// 4. Use SafePenalizedConstrainedStep to heavily penalize tokens that would
//    produce trivially short or non-isocyanate SMILES (like standalone "O").
// 5. Force at least 5 constrained tokens before allowing close.
// 6. Use CloseSpanWithinBudget for finalization.
//
// Key insight: The SMILES parser for isocyanates likely accepts "O" as a complete
// valid SMILES (water), but we need the model to generate isocyanate-containing SMILES.
// The parser might be a generic SMILES parser that accepts any SMILES, not one
// restricted to isocyanates. So we need to steer the LM output.
//
// Approach:
// - Strongly boost carbon-chain tokens (C, CC, CCC, c1ccccc1) at start.
// - Penalize O as a standalone first token.
// - Use forced constrained generation with minimum token count.
// - Boost "N" after we have a carbon prefix (to encourage R-N=C=O pattern).
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   OpenConstrainedSpan: sets insideConstrainedOut := true, currentConstrainedOut := []
//     which satisfies parser.IsValidPrefix([]) by precondition.
//   Forced phase: IsTokenValidNext guard ensures next extends currentConstrainedOut
//     validly; AppendConstrainedToken preserves parser.IsValidPrefix.
//     We also guard with !parser.IsCompletePrefix to ensure AppendConstrainedToken
//     precondition is met; if complete, we break.
//   Normal phase (CloseSpanIfComplete): either closes (implication vacuous) or no-op.
//     ConstrainedStep + AppendConstrainedToken with same guards preserves validity.
//   CloseSpanWithinBudget: postcondition guarantees parser_validity.
// progress:
//   Each loop iteration increments steps by at least 1, and |generated| grows
//   by at most the number of steps consumed. Total: |generated| <= |generatedPrefix| + maxSteps.
//   OpenConstrainedSpan: steps+1, |generated|+1.
//   Forced phase: steps+1 per iteration, |generated|+0 or +1.
//   Normal phase: steps+1 for CloseSpanIfComplete, steps+1 for ConstrainedStep.
//     Total ≤ 2 per outer iteration, loop condition steps < maxSteps preserved.
//   CloseSpanWithinBudget: closeBudget = maxSteps - steps, sets steps := maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "You must generate a valid SMILES string for an isocyanate molecule. Isocyanates contain the R-N=C=O group where R is an organic group. The SMILES must contain 'N=C=O' as a substring. Valid examples of isocyanate SMILES: CCN=C=O (ethyl isocyanate), CCCN=C=O (propyl isocyanate), ClCCN=C=O (chloroethyl isocyanate), c1ccccc1N=C=O (phenyl isocyanate), CC(C)N=C=O (isopropyl isocyanate), CCCCN=C=O (butyl isocyanate). Generate a novel isocyanate SMILES not in this list. The SMILES must start with a carbon-containing group (C, CC, CCC, c1ccc, etc.) followed by N=C=O.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Open constrained span immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Forced constrained generation - minimum tokens to avoid trivial SMILES
// We need at least enough tokens to form something like "CCN=C=O" (7 chars)
// Penalize tokens that would complete the span too early
var forcedCount: nat := 0;
var minForced: nat := 10;

while steps < maxSteps && insideConstrainedOut && forcedCount < minForced
  invariant 0 <= steps <= maxSteps
  invariant 0 <= forcedCount <= minForced
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps, minForced - forcedCount
{
  var isAlreadyComplete := parser.IsCompletePrefix(currentConstrainedOut);
  if isAlreadyComplete && |currentConstrainedOut| < 5 {
    // Too short - need to extend. But parser says complete.
    // We can't force more tokens if parser is complete and we're stuck.
    // Break and let finalization handle it.
    break;
  }

  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];

  // Boost carbon/nitrogen tokens to encourage isocyanate SMILES structure
  // Penalize standalone O and N which lead to non-isocyanate molecules
  var penalizeTokens: seq<Token> := [];
  if |currentConstrainedOut| == 0 {
    // At start, penalize O and N as first tokens (steer toward C)
    penalizeTokens := ["O", "N", "S", "P", "F", "I", "B"];
  }

  var next: Token;
  if |penalizeTokens| > 0 {
    next := helpers.SafePenalizedConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, penalizeTokens, 8.0, eosToken);
  } else {
    next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
  }
  steps := steps + 1;
  forcedCount := forcedCount + 1;

  if next == eosToken {
    break;
  } else {
    var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if valid && !isComplete {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    } else if !valid {
      break;
    } else {
      // valid && isComplete: can't append (AppendConstrainedToken requires !isComplete)
      // Break and let phase 3 close it
      break;
    }
  }
}

// Phase 3: Normal constrained generation with close detection
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  if closed {
    break;
  } else {
    if steps < maxSteps {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
        if !isComplete {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

// Phase 4: Finalize with CloseSpanWithinBudget if still open
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

