Strategy: // CSD_RATIONALE_BEGIN
// SMILES-isocyanate CSD v4. Root cause analysis:
// - All prior attempts produce tiny spans (e.g., "O") because:
//   1. The SMILES parser accepts "O" as a complete valid SMILES immediately.
//   2. CloseSpanIfComplete fires on the very first step inside the span.
//   3. The model defaults to generating "O" (water) as the simplest valid SMILES.
//
// Key insight from failure logs: "entered_constrained_mode_too_early" + "tiny_span_dominant"
// The model enters constrained mode, generates "O", parser accepts it as complete, span closes.
//
// Fix: We need the model to have already generated the isocyanate-specific prefix tokens
// BEFORE CloseSpanIfComplete can fire. The approach:
// 1. Use strong task guidance emphasizing "N=C=O" must appear.
// 2. Use ConstrainedSymbol with stepTokenBudget to generate a substantial chunk of tokens
//    before checking for completeness. This forces the model to commit to a multi-token
//    SMILES before the span can close.
// 3. Key: use SafeRepetitionPenaltyStep to avoid trivial one-token molecules.
// 4. After generating enough tokens, use CloseSpanWithinBudget to close the span.
//
// Strategy:
// - Phase 1: Open constrained span (costs 1 step).
// - Phase 2: Force-generate at least MIN_TOKENS tokens inside the span using
//   ConstrainedStep without checking completeness - this prevents "O" from closing early.
//   Specifically: generate tokens until |currentConstrainedOut| >= MIN_FORCED_TOKENS or
//   the step budget is consumed. Use SafeRepetitionPenaltyStep to discourage short copies.
// - Phase 3: Normal close-or-continue loop.
//
// MIN_FORCED_TOKENS = 6: this means we need at least 6 tokens before we can close.
// "O=C=NC" is 6 tokens (O, =, C, =, N, C), which forces at least a partial isocyanate.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   OpenConstrainedSpan sets insideConstrainedOut := true and currentConstrainedOut := [],
//   which satisfies parser.IsValidPrefix([]) by precondition. After that, every constrained
//   step (ConstrainedStep / SafeRepetitionPenaltyStep) returns either EOS or a parser-valid
//   next token (hard mask postcondition). AppendConstrainedToken extends currentConstrainedOut
//   by one valid token, preserving parser.IsValidPrefix(currentConstrainedOut).
//   CloseSpanIfComplete either closes (making the implication vacuously true with cc=[])
//   or leaves state unchanged (invariant preserved by IH).
//   CloseSpanWithinBudget postconditions guarantee both invariants hold.
// progress:
//   Phase 1: OpenConstrainedSpan costs 1 step, appends "<<" (1 token); bound preserved.
//   Force loop: each iteration costs 1 step from ConstrainedStep, appends at most 1 token;
//   |generated| <= |generatedPrefix| + steps preserved.
//   Normal loop: CloseSpanIfComplete costs 1 step, appends at most 1 token. ConstrainedStep
//   costs 1 step, AppendConstrainedToken appends at most 1 token. Both preserve the bound.
//   CloseSpanWithinBudget: costs at most closeBudget steps; we add closeBudget to steps,
//   preserving steps <= maxSteps and |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Strong guidance: emphasize that "O" alone is WRONG, must have N=C=O
var guidance: string := "Generate exactly one SMILES string for a novel isocyanate. Isocyanates contain the -N=C=O group. The SMILES must be at least 6 characters long and contain N=C=O. Examples: O=C=NCCBr, O=C=NC1CCCC1, O=C=NCC(F)F. Do NOT output just 'O' or other non-isocyanates. Output only the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Open constrained span
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Force-generate at least 8 tokens inside the span before allowing closure.
// This prevents "O" from being accepted as a complete parse immediately.
// We use SafeRepetitionPenaltyStep to penalize tokens already in generated (avoids copies).
var minForcedTokens: nat := 8;
while steps < maxSteps && insideConstrainedOut && |currentConstrainedOut| < minForcedTokens
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
  steps := steps + 1;
  if next == eosToken {
    break;
  } else {
    var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
    generated := ag;
    insideConstrainedOut := ai;
    currentConstrainedOut := ac;
  }
}

// Phase 3: Normal constrained generation loop - now allow closing
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Try to close if complete
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  if closed {
    break;
  } else {
    // Need more tokens
    if steps < maxSteps {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Phase 4: If still open and budget remains, use CloseSpanWithinBudget
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := steps + closeBudget;
}

cost := steps;

