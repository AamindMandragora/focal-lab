Strategy: // CSD_RATIONALE_BEGIN
// SMILES-isocyanate CSD v10.
//
// Root cause: The model generates trivially valid SMILES like "O" (water) or "N"
// that satisfy the parser but are not isocyanates. The constrained span opens,
// one token ("O" or "N") is generated, the parser accepts it as complete, and
// the span closes with <<O>> or <<N>>.
//
// The fundamental problem: We cannot prevent the parser from accepting "O" as a
// complete SMILES - it IS a valid SMILES. We need to steer the model to generate
// SMILES that happen to be isocyanates, not just any valid SMILES.
//
// Key insight: The SMILES parser accepts any valid SMILES. We need the OUTPUT
// to be an isocyanate. The only way to guarantee this is to either:
// (a) Force the SMILES to start with a known isocyanate prefix like "O=C=N"
//     before entering constrained mode, or
// (b) Use unconstrained generation with very strong guidance to produce the
//     full isocyanate SMILES naturally.
//
// Approach: Use UnconstrainedGeneration with strong guidance. The evaluator
// extracts content between << and >>. So we need to produce <<SMILES>> where
// SMILES is an isocyanate.
//
// But UnconstrainedGeneration doesn't use the parser. The syntax rate is 100%
// (parser ensures valid SMILES). The problem is membership (0%).
//
// The real fix: We need to ensure the constrained span generates an isocyanate.
// Since the SMILES parser accepts "O" as complete, we must prevent the span from
// closing on "O" alone by not calling CloseSpanIfComplete until we have enough
// tokens.
//
// Strategy v10:
// 1. Strong guidance emphasizing isocyanate = O=C=N pattern.
// 2. Open constrained span.
// 3. Penalize standalone "O" heavily as first token. Boost "O=C=N" initial tokens.
// 4. Force at least 5 tokens before checking for completion (minForced=5).
//    - In forced phase: call ConstrainedStep (never CloseSpanIfComplete)
//    - Use SafePenalizedConstrainedStep to penalize tokens that would close early
// 5. After forcing: Normal loop with CloseSpanIfComplete.
// 6. CloseSpanWithinBudget to finalize.
//
// The key improvement over v9: In forced phase, we use SafeRepetitionPenaltyStep
// which penalizes tokens already in generated (like "O" which appears in guidance
// examples). But we also need to NOT check for completion - just append.
// We use ConstrainedStep and always append (even if complete). Wait - we can't
// append beyond complete without breaking the parser invariant.
//
// Actually the issue is more subtle: after appending "O", parser.IsValidPrefix(["O"])
// is true. And parser.IsCompletePrefix(["O"]) is also true. So the span closes.
//
// Solution: We must NOT use CloseSpanIfComplete in the forced phase. We just
// use ConstrainedStep and AppendConstrainedToken. This means we extend the SMILES
// beyond "O" even when "O" is a valid complete SMILES. The parser might not allow
// extensions of "O" (since it's already complete). 
//
// If the parser doesn't allow extending "O", then ConstrainedStep will return
// eosToken and we break. In that case we still have a short SMILES.
//
// Better approach: Use SafePenalizedConstrainedStep to penalize "O" (standalone
// water) as the FIRST token. The key insight is that at the start of the SMILES
// (currentConstrained == []), the model will try to pick "O". We penalize "O"
// heavily to steer toward "C", "N", or other atoms that need bonds.
//
// But "O=C=N..." also starts with "O"! So we can't penalize "O" blindly.
// We should penalize when |currentConstrained| == 0 ONLY tokens that would
// lead to trivial SMILES. But the tokenizer may tokenize "O=C=N" differently.
//
// Actually "O=C=NC" is also a valid SMILES but the tokenizer might break it
// into ["O", "=", "C", "=", "N", "C"] or ["O=C=NC"] etc.
//
// Given the token budget is 1 per step (stepTokenBudget=1), each token is
// generated one at a time. So "O" as a single token at position 0 IS the
// problem. We should boost "N" instead (isocyanate can be written as N=C=O...).
//
// Revised strategy:
// - At step 0 (currentConstrained == []): boost ["N", "C"] and penalize ["O", "S"]
//   This steers toward organic isocyanates starting with the carbon chain.
//   Example: CCN=C=O (ethyl isocyanate), NC=C=O, etc.
// - Then generate tokens freely (with repetition penalty) until complete.
// - Use CloseSpanIfComplete to finish.
//
// Wait - if we boost "N" at position 0, the model might generate "N=C=O" which
// IS an isocyanate (methyl-less), or "NC..." 
//
// Actually the simplest fix: at the start of the constrained span, boost the
// token "C" very heavily. Organic isocyanates typically start with a carbon:
// CH3-N=C=O = CN=C=O. So starting with "C" is most common.
// Then after "C" is placed, "C" appended to currentConstrained allows more tokens.
//
// Final approach: Strongly boost "C" at step 0 to get organic isocyanate starters.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   OpenConstrainedSpan: sets insideConstrainedOut := true, currentConstrainedOut := []
//     which satisfies parser.IsValidPrefix([]) by precondition.
//   Forced phase: SafePenalizedConstrainedStep / SafeBoostedConstrainedStep return
//     EOS or a parser-valid token (hard mask). AppendConstrainedToken preserves
//     parser.IsValidPrefix. We never call CloseSpanIfComplete in forced phase,
//     but we do check IsCompletePrefix to avoid appending past completion.
//     If complete and not forced, we don't append - handled by normal phase.
//   Normal loop (CloseSpanIfComplete): either closes (implication vacuous) or
//     no-op (invariant maintained). SafeRepetitionPenaltyStep + AppendConstrainedToken
//     preserves validity.
//   CloseSpanWithinBudget: postcondition guarantees the invariant.
// progress:
//   OpenConstrainedSpan: steps+1, |generated|+1 ("<<"). Bound preserved.
//   Forced phase: each iteration steps+1, |generated| grows by at most 1.
//   Normal phase (CloseSpanIfComplete): steps+1, |generated| grows by at most 1.
//     Inner ConstrainedStep: steps+1, |generated| grows by at most 1.
//   CloseSpanWithinBudget with closeBudget = maxSteps - steps:
//     |generated| <= old|generated| + closeBudget <= |generatedPrefix| + maxSteps.
//     steps := maxSteps preserves the bound.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a SMILES string for an organic isocyanate molecule. Isocyanates contain the functional group -N=C=O. Start with a carbon chain, then add N=C=O. Good examples: CN=C=O, CCN=C=O, CCCN=C=O, CC(C)N=C=O, c1ccccc1N=C=O, CCCCN=C=O, ClCCN=C=O, BrCCN=C=O. The SMILES must contain N=C=O as a substructure. Output ONLY the SMILES, nothing else.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Open constrained span
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Forced generation - at least 6 tokens, boost "C" at start
var forcedSteps: nat := 0;
var minForced: nat := 6;

while steps < maxSteps && insideConstrainedOut && forcedSteps < minForced
  invariant 0 <= steps <= maxSteps
  invariant 0 <= forcedSteps <= minForced
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps, minForced - forcedSteps
{
  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  var next: Token;
  if forcedSteps == 0 {
    // At the very start, boost "C" to steer toward organic isocyanates
    // Penalize "O" to avoid water, penalize "N" standalone
    var boostTokens := ["C"];
    var penaltyTokens := ["O", "S", "P", "F", "I"];
    next := helpers.SafeBoostedConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, boostTokens, 8.0, eosToken);
  } else {
    // Use repetition penalty to avoid copying exemplars
    next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
  }
  steps := steps + 1;
  forcedSteps := forcedSteps + 1;
  if next == eosToken {
    break;
  } else {
    // Only append if it doesn't cause issues - check if current is complete
    // If already complete, we should not try to extend (parser may reject)
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      // Parser would reject extension; break to normal close phase
      break;
    } else {
      var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
      if valid {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Phase 3: Normal constrained generation with close detection
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  if closed {
    break;
  } else {
    if steps < maxSteps {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Phase 4: Finalize with CloseSpanWithinBudget if still open
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

