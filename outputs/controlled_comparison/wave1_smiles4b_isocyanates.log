insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Task: Generate exactly one SMILES string for an isocyanate molecule. Isocyanates MUST contain the -N=C=O group. The SMILES must have at least 6 atoms. Examples of valid isocyanates: CN=C=O (methyl isocyanate), CCN=C=O (ethyl isocyanate), CCCN=C=O (propyl isocyanate), ClCCN=C=O, BrCCN=C=O, c1ccccc1N=C=O. Generate a NEW molecule not in the examples above. Output format: <<SMILES>> where SMILES is your generated molecule.";
