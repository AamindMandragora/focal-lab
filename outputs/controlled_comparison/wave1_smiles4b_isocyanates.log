Helper policy: helper mask warm-up (0/3 evaluated attempts for bandit)
Strategy: // CSD_RATIONALE_BEGIN
// SMILES-isocyanate CSD. The task requires a single valid SMILES string for an
// isocyanate molecule. The strategy:
// 1. Appends task guidance to steer the model toward novel isocyanate SMILES.
// 2. Immediately opens a hidden constrained span (no visible delimiters needed
//    for this task surface) by calling OpenConstrainedSpan to enter constrained
//    mode with currentConstrainedOut := [].
// 3. Inside the span, uses SafeRepetitionPenaltyStep to discourage copying
//    prompt exemplars token-by-token, combined with AdaptiveConstrainedStep
//    for group-aware valid SMILES token selection.
// 4. Polls CloseSpanIfComplete each step; once the parser accepts the SMILES
//    as complete, closes the span.
// 5. Stops on EOS or budget exhaustion.
// State tracked: insideConstrainedOut, currentConstrainedOut, steps.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Branch 1 (OpenConstrainedSpan): sets insideConstrainedOut := true and
//     currentConstrainedOut := [] which satisfies parser.IsValidPrefix([]) by
//     precondition. The implication holds.
//   Branch 2 (CloseSpanIfComplete, closed == true): sets insideConstrainedOut
//     := false, making the implication vacuously true, and currentConstrainedOut
//     := [] per CloseConstrainedSpan postcondition.
//   Branch 2 (CloseSpanIfComplete, closed == false): state unchanged; the
//     invariant holds by the inductive hypothesis.
//   Branch 3 (constrained step): SafeRepetitionPenaltyStep returns EOS or a
//     parser-valid next token (hard mask postcondition). AppendConstrainedToken
//     extends currentConstrainedOut by one valid token, preserving
//     parser.IsValidPrefix(currentConstrainedOut).
// progress:
//   Branch 1 (OpenConstrainedSpan): costs 1 step, appends "<<" to generated,
//     so |generated| grows by 1 and steps grows by 1; bound preserved.
//   Branch 2 (CloseSpanIfComplete): costs 1 step regardless of closed; when
//     closed, appends ">>" (1 token); when not closed, no visible append.
//     Either way |generated| grows by at most 1 and steps grows by 1.
//   Branch 3 (constrained step): costs 1 step, AppendConstrainedToken appends
//     at most 1 token; bound preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate exactly one valid SMILES string for a novel isocyanate molecule (contains -N=C=O group). Output only the SMILES string with no explanation, no Markdown, no exemplar copying.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: if not already inside a constrained span, open one immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: constrained generation loop for the SMILES token sequence
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed; generation complete
    break;
  } else {
    // Try to close if complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    if closed {
      break;
    } else {
      // Need more tokens; use adaptive constrained step with repetition penalty
      // to avoid copying prompt exemplars
      if steps < maxSteps {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

cost := steps;

