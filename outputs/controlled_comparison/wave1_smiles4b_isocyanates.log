Strategy: // CSD_RATIONALE_BEGIN
// SMILES-isocyanate CSD v17.
//
// Root cause analysis:
// - The model outputs single tokens like "O", "N", "c" and immediately the parser
//   considers them complete SMILES. CloseSpanIfComplete fires instantly.
// - We need to FORCE the generation of longer SMILES strings that contain the
//   isocyanate -N=C=O group before allowing any close check.
//
// Key insight from best attempt (syntax 100%, accuracy 0%):
// - That attempt had 100% syntax but 0% accuracy = valid SMILES but not isocyanates
// - The model generates valid SMILES but without the N=C=O group
// - We need to constrain the generation MORE aggressively toward isocyanate structure
//
// New strategy:
// 1. Use ConstrainedGeneration which runs ConstrainedStep in a loop until parser
//    completeness or EOS - this gives us a complete parser-valid SMILES
// 2. BUT we need to prevent single-token SMILES. Since ConstrainedGeneration
//    loops until parser.IsCompletePrefix, single tokens that are complete SMILES
//    will terminate immediately.
// 3. Instead: use a two-phase approach:
//    - Phase A: Force-generate at least 6 tokens using ConstrainedStep without
//      any close check. We check parser.IsCompletePrefix and if complete but
//      too short, we DON'T stop - we continue (but we can't force past a dead end).
//    - Actually: We cannot force continuation past a complete SMILES if the parser
//      won't accept more tokens. So we need to BOOST tokens that extend the molecule.
//    - Phase B: After 6+ tokens, use CloseSpanIfComplete.
//
// Better approach: Use SafeRepetitionPenaltyStep (best attempt) but also
// BOOST tokens that appear in isocyanate SMILES (N, =, C, O combined as pattern).
// The key issue is accuracy (not syntax), meaning the generated SMILES are valid
// but not isocyanates. We need to steer toward N=C=O.
//
// Strategy:
// 1. Guidance emphasizing isocyanate structure
// 2. Open constrained span
// 3. Force at least 6 tokens:
//    - Before each ConstrainedStep, SafeBoostTokenLogits for isocyanate atoms
//    - Use ConstrainedStep (hard mask)
//    - Do NOT check CloseSpanIfComplete in this phase
//    - BUT: if parser.IsCompletePrefix, we must stop (can't extend a dead SMILES)
// 4. After 6 tokens, normal close-check loop
// 5. CloseSpanWithinBudget to finalize
//
// The critical fix for accuracy: boost "N", "=C=", "N=C=O" related tokens
// aggressively to guide the model toward isocyanate structures.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   OpenConstrainedSpan: sets currentConstrainedOut := [] which is valid by precondition.
//   Forced phase: We only call AppendConstrainedToken when !parser.IsCompletePrefix
//     and IsTokenValidNext holds. ConstrainedStep hard-masks to parser-valid tokens,
//     so next is valid. AppendConstrainedToken extends currentConstrainedOut by one
//     valid token, preserving parser.IsValidPrefix.
//   If parser.IsCompletePrefix in forced phase: we break, invariant holds.
//   Normal phase: CloseSpanIfComplete either closes (implication vacuously true)
//     or leaves state unchanged. ConstrainedStep + AppendConstrainedToken preserves
//     validity by the same argument.
//   CloseSpanWithinBudget: postcondition guarantees validity.
// progress:
//   OpenConstrainedSpan: +1 step, +1 token (the "<<"). Bound preserved.
//   Forced phase: each iteration +1 step, at most +1 token. Bound preserved.
//   Normal phase: each outer iteration +1 step (CloseSpanIfComplete), at most +1
//     token; inner ConstrainedStep +1 step, at most +1 token. Total +2 per outer
//     loop iteration but steps grows by 2. Bound preserved.
//   CloseSpanWithinBudget: budget = maxSteps - steps, total stays within maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Task: Generate one valid SMILES string for a novel isocyanate molecule. Isocyanates contain the -N=C=O functional group. Examples of isocyanate SMILES: CCN=C=O, CCCN=C=O, c1ccccc1N=C=O, BrCCN=C=O, CCCCN=C=O, ClCCN=C=O. Your output MUST contain N=C=O. Output ONLY the SMILES string, nothing else.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Open constrained span immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Forced constrained generation with isocyanate boosting
// Generate minimum tokens without close check to avoid trivial single-token SMILES
// We boost N and = tokens to encourage isocyanate structure
var minForced: nat := 7;

while steps < maxSteps && insideConstrainedOut && |currentConstrainedOut| < minForced
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps, minForced - |currentConstrainedOut|
{
  // Check if we're at a complete state - if so we must allow closing
  var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
  if isComplete && |currentConstrainedOut| > 0 {
    // The SMILES might already be complete. Check if it contains N=C=O structure.
    // We can't force more tokens if parser won't accept them. Break to close phase.
    break;
  }

  // Boost isocyanate-relevant tokens before constrained step
  helpers.SafeBoostTokenLogits(lm, ["N", "=", "C"], 3.0);

  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
  steps := steps + 1;

  if next == eosToken {
    break;
  } else {
    var isValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
    if isValid {
      var isComp2 := parser.IsCompletePrefix(currentConstrainedOut);
      if !isComp2 {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      } else {
        break;
      }
    }
  }
}

// Phase 3: Normal constrained generation with close detection
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  if closed {
    break;
  } else {
    if steps < maxSteps {
      // Boost isocyanate tokens during normal generation too
      helpers.SafeBoostTokenLogits(lm, ["N", "=", "C", "O"], 2.0);
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var isComp3 := parser.IsCompletePrefix(currentConstrainedOut);
        if !isComp3 {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

// Phase 4: Finalize with CloseSpanWithinBudget if still open
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget);
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

