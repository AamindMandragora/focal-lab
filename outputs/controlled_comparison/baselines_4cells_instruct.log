tform} as {name2}. If {name1} has {n} friends on {platform}, how many {platform} friends does {name3} have?'}], 'reasoning': None}, {'step': 1, 'action': 'constraints_init', 'outputs': [''], 'task': 'gsm_symbolic', 'valid_vars': ['mult1', 'mult2', 'n'], 'backwards_limit': 20, 'max_iter': 80}, {'step': 2, 'action': 'forward_step', 'outputs': ['<'], 'deltas': ['<'], 'token_ids': [27], 'token_probs': [0.98828125], 'unit_list': ['start'], 'num': 1}, {'step': 3, 'action': 'forward_step', 'outputs': ['<<'], 'deltas': ['<'], 'token_ids': [27], 'token_probs': [1.0], 'unit_list': ['start'], 'num': 1}, {'step': 4, 'action': 'forward_step', 'outputs': ['<<mult'], 'deltas': ['mult'], 'token_ids': [25875], 'token_probs': [0.52734375], 'unit_list': ['start'], 'num': 1}, {'step': 5, 'action': 'forward_step', 'outputs': ['<<mult1'], 'deltas': ['1'], 'token_ids': [16], 'token_probs': [0.67578125], 'unit_list': ['start'], 'num': 1}, {'step': 6, 'action': 'forward_step', 'outputs': ['<<mult1 *'], 'deltas': [' *'], 'token_ids': [353], 'token_probs': [0.9921875], 'unit_list': ['start'], 'num': 1}, {'step': 7, 'action': 'forward_step', 'outputs': ['<<mult1 * mult'], 'deltas': [' mult'], 'token_ids': [2745], 'token_probs': [0.9296875], 'unit_list': ['start'], 'num': 1}, {'step': 8, 'action': 'forward_step', 'outputs': ['<<mult1 * mult2'], 'deltas': ['2'], 'token_ids': [17], 'token_probs': [1.0], 'unit_list': ['start'], 'num': 1}, {'step': 9, 'action': 'forward_step', 'outputs': ['<<mult1 * mult2 *'], 'deltas': [' *'], 'token_ids': [353], 'token_probs': [0.984375], 'unit_list': ['start'], 'num': 1}, {'step': 10, 'action': 'forward_step', 'outputs': ['<<mult1 * mult2 * n'], 'deltas': [' n'], 'token_ids': [308], 'token_probs': [0.90625], 'unit_list': ['start'], 'num': 1}, {'step': 11, 'action': 'forward_step', 'outputs': ['<<mult1 * mult2 * n /'], 'deltas': [' /'], 'token_ids': [608], 'token_probs': [0.287109375], 'unit_list': ['start'], 'num': 1}, {'step': 12, 'action': 'forward_step', 'out