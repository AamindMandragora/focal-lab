Strategy: // CSD_RATIONALE_BEGIN
// The core problem is "tiny_span_dominant" + "entered_constrained_mode_too_early":
// the model enters the constrained span immediately and outputs only 1 token ("C"),
// then the span closes. This happens because:
// 1. The preamble budget is 0, so we open the constrained span right away.
// 2. The parser accepts "C" as a complete SMILES, so CloseSpanIfComplete fires immediately.
//
// The fix: We need the model to generate a LONGER, chemically meaningful SMILES
// for an acrylate. Key insight: the SMILES parser accepts single atoms as complete,
// so we must enforce minimum length BEFORE allowing close.
//
// New strategy:
// 1. Use AppendTaskGuidance with strong guidance about acrylate structure.
// 2. Use a small unconstrained preamble (0 steps) to not waste budget.
// 3. Open constrained span immediately.
// 4. Run constrained generation loop with:
//    a. Hard minimum token count (minConstrainedTokens = 8) before allowing close
//    b. Use ConstrainedStep for each token inside the span
//    c. Use CloseSpanIfComplete only after minConstrainedTokens are generated
//    d. Penalize EOS heavily throughout to prevent premature termination
// 5. CloseSpanWithinBudget at end if still open.
//
// The key fix vs previous attempts: we track constrainedTokenCount and only
// allow CloseSpanIfComplete when constrainedTokenCount >= minConstrainedTokens.
// We use SafePenalizeTokenLogits before ConstrainedStep to discourage early closure.
// We do NOT call AppendConstrainedToken when IsCompletePrefix is true.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   OpenConstrainedSpan sets currentConstrainedOut := [] which is valid.
//   In the constrained loop, we only call AppendConstrainedToken when
//   !parser.IsCompletePrefix(currentConstrainedOut) and next is valid by
//   postcondition of ConstrainedStep. CloseSpanIfComplete either closes
//   (implication vacuously true) or is no-op (invariant unchanged).
//   CloseSpanWithinBudget guarantees validity on exit.
//
// progress:
//   OpenConstrainedSpan: steps += 1, generated grows by 1.
//   Constrained loop: each branch increments steps by exactly 1 and appends
//   at most 1 token to generated, so |generated| <= |generatedPrefix| + steps.
//   CloseSpanWithinBudget: uses at most closeBudget steps with steps := maxSteps,
//   so |generated| <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate a valid SMILES string for a novel acrylate ester molecule. An acrylate must contain the CH2=CH-C(=O)-O- fragment. A valid example is C=CC(=O)OCCCC. Output ONLY the SMILES string. The SMILES must be at least 8 atoms long and contain C=CC(=O)O as a substructure. Do not output just C or a single atom.");

var steps: nat := 0;

// Open constrained span immediately (no preamble)
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

var constrainedTokenCount: nat := 0;
var minConstrainedTokens: nat := 8;

while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
  var isComplete := parser.IsCompletePrefix(currentConstrainedOut);

  if isComplete && constrainedTokenCount >= minConstrainedTokens {
    // Long enough and complete - close the span
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else {
    // Either not complete, or complete but too short - continue generating
    // Penalize EOS to prevent premature termination
    helpers.SafePenalizeTokenLogits(lm, [eosToken], 10.0);
    var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
    steps := steps + 1;
    if next == eosToken {
      // Forced to stop - close if complete
      if parser.IsCompletePrefix(currentConstrainedOut) {
        var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
      }
      break;
    } else {
      var isCompleteNow := parser.IsCompletePrefix(currentConstrainedOut);
      if !isCompleteNow {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
        constrainedTokenCount := constrainedTokenCount + 1;
      }
      // If complete now, we'll handle it on the next iteration
    }
  }
}

if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

