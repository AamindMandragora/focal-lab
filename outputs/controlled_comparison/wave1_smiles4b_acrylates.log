Strategy: // CSD_RATIONALE_BEGIN
// Root cause analysis: The model generates trivially complete SMILES like "C"
// because the parser accepts single atoms as complete SMILES strings, and the
// constrained generation terminates immediately. The "tiny_span_dominant" failure
// mode confirms this - spans close after just 1 token.
//
// Key insight: We need to force the model to generate acrylate-specific substructure.
// The acrylate core is C=CC(=O)O[R] where R is an alkyl group.
//
// New strategy:
// 1. Use strong task guidance emphasizing the acrylate ester core structure
// 2. Use a visible << >> span as the evaluator requires it (failure mode shows
//    "missing_constrained_segment" - the evaluator needs visible delimiters)
// 3. Force open a constrained span immediately
// 4. Use ConstrainedStep with RepetitionPenalty to guide toward acrylate structure
// 5. Close only when parser says complete AND we have sufficient length
//
// The critical fix: The evaluator REQUIRES visible << >> delimiters based on
// "missing_constrained_segment: 50 example(s) (no << >> segment detected)".
// Previous attempts used hidden constrained generation but the evaluator couldn't
// find the answer in the << >> span.
//
// We use OpenConstrainedSpan to emit << then CloseSpanWithinBudget to generate
// the SMILES content with parser guidance and emit >>.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: We call OpenConstrainedSpan which sets insideConstrainedOut=true
//   and currentConstrainedOut=[] (valid empty prefix). Then CloseSpanWithinBudget
//   maintains parser.IsValidPrefix(currentConstrainedOut) throughout and returns
//   either a closed span (insideConstrainedOut=false, vacuously true) or an open
//   valid prefix. So parser_validity is preserved.
//
// progress: OpenConstrainedSpan costs 1 step (steps=1). CloseSpanWithinBudget
//   costs at most closeBudget = maxSteps-1 additional steps. Total steps <= maxSteps.
//   |generated| grows by at most 1 (for "<<") + closeBudget tokens, staying within
//   |generatedPrefix| + maxSteps. When maxSteps > 0, we consume at least 1 step
//   from OpenConstrainedSpan, so cost > 0 satisfies progress postcondition.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "You are generating a SMILES string for an acrylate ester molecule. Acrylates contain the core fragment C=CC(=O)O (acryloyl ester group). Generate a novel acrylate SMILES like C=CC(=O)OCCC or C=CC(=O)OCC or C=CC(=O)OC(C)CC. The SMILES must start with C=C and contain C(=O)O. Output only the SMILES inside the constrained span.");

if maxSteps == 0 {
  cost := 0;
} else {
  // Open the visible constrained span (emits "<<")
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  var steps: nat := 1;

  // Use remaining budget to generate SMILES content and close the span
  if steps < maxSteps {
    var closeBudget := maxSteps - steps;
    var cg, ci, cc := helpers.CloseSpanWithinBudget(
      lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
    );
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := maxSteps;
  }

  cost := steps;
}

