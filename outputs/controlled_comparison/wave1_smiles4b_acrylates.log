Strategy: // CSD_RATIONALE_BEGIN
// Root cause: The model enters constrained mode immediately and generates "C"
// (a minimal valid SMILES) because the SMILES parser accepts "C" as a complete
// prefix. The acrylate functional group (CH2=CH-C(=O)-O-R) is not being enforced.
//
// The key insight: the SMILES parser will accept ANY valid SMILES as complete,
// including trivial ones like "C". We need the model to generate a longer,
// richer SMILES that actually contains the acrylate substructure.
//
// Fix strategy:
// 1. Use a longer unconstrained preamble (up to 10-15 steps) to let the model
//    establish context before the constrained span, rather than jumping straight in
// 2. Use stronger task guidance specifically mentioning the acrylate ester functional
//    group pattern C=CC(=O)O to prime the model for the right kind of output
// 3. Inside the constrained span, use SafeRepetitionPenaltyStep heavily to avoid
//    trivial single-character outputs
// 4. Use SafeTemperatureConstrainedStep with higher temperature (>1.0) to diversify
//    and avoid the argmax "C" trap
// 5. After generating a few tokens inside the span, check if the current constrained
//    prefix resembles a trivial output and penalize short completions
// 6. Use CloseSpanWithinBudget at the end to ensure clean closure
//
// Key observation: "tiny_span_dominant: 100%" means the model is completing the
// SMILES span after just 1-2 tokens. We need to encourage longer generation by:
// - Boosting tokens that extend the SMILES (not closing tokens)
// - Penalizing early closure
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Unconstrained preamble loop: insideConstrainedOut flips to true only when
//      next == "<<", and we set currentConstrainedOut := [] which satisfies
//      parser.IsValidPrefix([]) by precondition.
//   2. Force-open branch: OpenConstrainedSpan sets currentConstrainedOut := []
//      which is valid.
//   3. Constrained generation loop: At each step, either CloseSpanIfComplete
//      closes the span (making implication vacuous) or we generate a token via
//      SafeTemperatureConstrainedStep / SafeRepetitionPenaltyStep / AdaptiveConstrainedStep,
//      all of which return EOS or a parser-valid next token. AppendConstrainedToken
//      preserves parser validity by its postcondition.
//   4. CloseSpanWithinBudget preserves the invariant by its postcondition.
//
// progress:
//   Each loop iteration increments steps by exactly 1 and appends at most 1
//   visible token, so |generated| <= |generatedPrefix| + steps is preserved.
//   CloseSpanWithinBudget appends at most closeBudget tokens and we set
//   steps := maxSteps, so the final bound |generated| <= |generatedPrefix| + maxSteps holds.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Strong task guidance: explicitly describe the acrylate ester pattern
var guidance := "You must generate a valid SMILES string for a novel acrylate ester molecule. Acrylates contain the vinyl acrylate group: C=CC(=O)O attached to an alkyl or substituted group. Example patterns: C=CC(=O)OCC, C=CC(=O)OCCC, C=CC(=O)OC(C)C. Generate a SMILES with at least 8 atoms that is NOT one of the prompt examples. Output only the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Unconstrained preamble - allow the model to warm up for up to 8 steps
// This helps avoid the "immediately enter constrained mode and emit C" failure mode
var preambleBudget: nat := 8;
var preambleSteps: nat := 0;

while steps < maxSteps && !insideConstrainedOut && preambleSteps < preambleBudget
  invariant 0 <= steps <= maxSteps
  invariant 0 <= preambleSteps <= preambleBudget
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  preambleSteps := preambleSteps + 1;
  if next == eosToken {
    break;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// Force entry into constrained mode if not yet entered
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Constrained SMILES generation
// Use temperature to diversify and repetition penalty to avoid trivial outputs
// Track how many constrained tokens we've generated
var constrainedTokenCount: nat := 0;
var minConstrainedTokens: nat := 6; // Force at least 6 tokens before allowing closure

while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Only allow closing after minimum tokens have been generated
  if constrainedTokenCount >= minConstrainedTokens && parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      // Not closed, generate next token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
      if next == eosToken {
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
        constrainedTokenCount := constrainedTokenCount + 1;
      }
    }
  } else {
    // Generate next constrained token - use temperature for diversity and repetition penalty
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    
    // First few tokens: use temperature > 1.0 to diversify away from trivial "C"
    // Later tokens: use repetition penalty and adaptive step
    if constrainedTokenCount < 4 {
      next := helpers.SafeTemperatureConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, 1.5, eosToken
      );
    } else if constrainedTokenCount < 15 {
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.5, eosToken
      );
    } else {
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 15, eosToken
      );
    }
    
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
      constrainedTokenCount := constrainedTokenCount + 1;
    }
  }
}

// If still inside constrained span and budget remaining, close it
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

