Strategy: // CSD_RATIONALE_BEGIN
// The core problem: the model generates tiny spans (e.g., "<<C>>") because it
// enters constrained mode immediately and the parser closes on a single atom.
// The SMILES parser apparently accepts "C" as a complete prefix, so the span
// closes after just 1 token.
//
// Root cause: acrylates require the CH2=CH-C(=O)-O- substructure, but the
// parser (which is a general SMILES parser) accepts any valid SMILES including
// single atoms. We need to guide the model to generate longer, chemically
// relevant SMILES.
//
// Fix strategy:
// 1. Use AppendTaskGuidance with a very specific acrylate SMILES example pattern
//    to prime the model toward the correct substructure.
// 2. Use RepetitionPenaltyStep to avoid short/common tokens early.
// 3. Use a minConstrainedTokens guard: don't allow closing until we have at
//    least 8 constrained tokens (acrylates need C=CC(=O)O + ester group).
// 4. Boost tokens like "=", "C", "(" to steer toward the acrylate core.
// 5. Use SafePenalizedConstrainedStep to penalize early EOS-like completions.
//
// The key insight: we need to prevent early parser completion from closing the
// span. We do this by tracking how many constrained tokens have been generated
// and only calling CloseSpanIfComplete after reaching minConstrainedTokens.
// When IsCompletePrefix is true but we haven't reached min tokens, we must
// keep generating - but we can only do so if !IsCompletePrefix. This is the
// fundamental tension.
//
// Resolution: Instead of fighting the parser's notion of "complete", we should
// use RepetitionPenaltyStep and token boosts to make the model prefer longer
// SMILES naturally. The acrylate pattern "C=CC(=O)O" is ~10 tokens. We boost
// "=" and "(" tokens to encourage the model to extend the SMILES rather than
// stopping at a complete but too-short parse.
//
// We use a loop with:
// - RepetitionPenaltyStep for the first ~20 tokens to avoid repetition
// - GroupBoostedConstrainedStep throughout to prefer acrylate-relevant tokens
// - Only close when both minConstrainedTokens satisfied AND IsCompletePrefix
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Unconstrained preamble (preambleBudget steps): insideConstrainedOut
//      flips to true only when next == "<<", setting currentConstrainedOut := []
//      which satisfies parser.IsValidPrefix([]) by precondition.
//   2. Force-open: OpenConstrainedSpan sets currentConstrainedOut := [] (valid).
//   3. Constrained loop: We only call AppendConstrainedToken when
//      !parser.IsCompletePrefix(currentConstrainedOut) holds (checked explicitly),
//      satisfying its precondition. RepetitionPenaltyStep and GroupBoostedConstrainedStep
//      both return parser-valid tokens or EOS by their postconditions.
//      AppendConstrainedToken preserves parser validity by its postcondition.
//      CloseSpanIfComplete either closes (insideConstrainedOut := false, implication
//      vacuous) or leaves unchanged (parser validity preserved).
//   4. Final CloseSpanWithinBudget preserves both span invariants by postcondition.
//
// progress:
//   Each while iteration increments steps by exactly 1. The preamble loop appends
//   at most 1 token per step. The constrained loop appends at most 1 token per step.
//   CloseSpanWithinBudget adds at most closeBudget <= maxSteps - steps to steps,
//   then we set steps := maxSteps. So |generated| <= |generatedPrefix| + maxSteps
//   throughout, and cost = steps <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Guide the model toward acrylate SMILES structures
var guidance := "You are generating SMILES strings for acrylate esters. Acrylates contain the CH2=CH-C(=O)-O- group. Valid examples: C=CC(=O)OCC, C=CC(=O)OCCO, C=CC(=O)OC(C)C, C=CC(=O)OCCOC. The SMILES must contain the acrylate core C=CC(=O)O and an ester group. Output only the SMILES.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Very short unconstrained preamble (max 2 steps) to let model orient
var preambleBudget: nat := 2;
var preambleSteps: nat := 0;

while steps < maxSteps && !insideConstrainedOut && preambleSteps < preambleBudget
  invariant 0 <= steps <= maxSteps
  invariant 0 <= preambleSteps <= preambleBudget
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  preambleSteps := preambleSteps + 1;
  if next == eosToken {
    break;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// Force entry into constrained mode if not yet entered
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Constrained SMILES generation
// Track constrained token count to avoid premature closure
var constrainedTokenCount: nat := 0;
// Minimum tokens before we allow closing - acrylate core "C=CC(=O)O" is ~8 tokens
var minConstrainedTokens: nat := 8;

while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if constrainedTokenCount >= minConstrainedTokens && parser.IsCompletePrefix(currentConstrainedOut) {
    // Sufficient tokens and parse is complete - close the span
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else if !parser.IsCompletePrefix(currentConstrainedOut) {
    // Parse not yet complete - generate next token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    if constrainedTokenCount < 20 {
      // Use repetition penalty to encourage diverse/longer SMILES
      next := helpers.RepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
    } else {
      // Use group-boosted step for later tokens
      next := helpers.GroupBoostedConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, eosToken
      );
    }
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
      constrainedTokenCount := constrainedTokenCount + 1;
    }
  } else {
    // constrainedTokenCount < minConstrainedTokens but IsCompletePrefix is true
    // We must close (can't append when complete), accept the span as-is
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  }
}

// If still inside constrained span and budget remaining, force close
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

