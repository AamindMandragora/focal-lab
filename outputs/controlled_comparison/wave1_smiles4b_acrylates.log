Strategy: // CSD_RATIONALE_BEGIN
// The previous attempt failed because: 1) entering constrained mode immediately
// produced only "C" (a tiny span), and 2) the extracted answer was "C" not a
// valid acrylate SMILES. The fundamental issue is that the parser-guided
// constrained span for SMILES generation was too short/minimal.
//
// Root cause analysis from diagnostics:
// - "entered_constrained_mode_too_early": 50 examples
// - "tiny_span_dominant": yes (100%)
// - The model generated <<C>> immediately, which is syntactically valid SMILES
//   but not a valid acrylate molecule
//
// Fix strategy:
// 1. Use a non-zero unconstrained preamble budget to let the model generate
//    some context before entering the constrained span
// 2. Use a larger stepTokenBudget for the constrained phase to generate longer SMILES
// 3. Add task guidance specifically about acrylate structure
// 4. Use SafeRepetitionPenaltyStep inside the constrained span to avoid trivial outputs
// 5. Use AdaptiveConstrainedStep with a higher boost amount and narrower threshold
//    to encourage richer SMILES structures
//
// Acrylates contain the acrylate ester group: CH2=CH-C(=O)-O-R
// The SMILES parser should enforce valid SMILES grammar.
// We need the model to generate a non-trivial acrylate SMILES.
//
// New approach: Allow a short unconstrained preamble (1-2 tokens) so the model
// can "warm up", then use the constrained span with a larger budget.
// Use SafeRepetitionPenaltyStep to discourage minimal/trivial outputs.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. In the unconstrained preamble loop, insideConstrainedOut is flipped to
//      true only when next == "<<", and we set currentConstrainedOut := []
//      which is always a valid prefix (parser.IsValidPrefix([]) is a precondition).
//   2. In the constrained generation loop, CloseSpanIfComplete either closes
//      the span (setting insideConstrainedOut false, making the implication vacuous)
//      or leaves state unchanged. When we generate a token via
//      SafeRepetitionPenaltyStep or AdaptiveConstrainedStep, it returns either
//      EOS or a parser-valid next token. AppendConstrainedToken preserves validity.
//
// progress:
//   Each loop iteration increments steps by exactly 1, and appends at most one
//   token to generated. Thus |generated| <= |generatedPrefix| + steps <= 
//   |generatedPrefix| + maxSteps. The CloseSpanIfComplete call costs 1 step
//   and appends at most 1 token (">>"). All other helpers cost 1 step and
//   append at most 1 token. So the invariant |generated| <= |generatedPrefix| + steps
//   is preserved throughout.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Task guidance: tell the model to generate a non-trivial acrylate SMILES
var guidance := "Generate a valid SMILES string for a novel acrylate ester molecule (containing CH2=CH-C(=O)-O- group). The SMILES must be chemically valid and represent a real acrylate. Output only the SMILES string inside the constrained span delimiters.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var narrowThreshold: nat := 15;
var boostAmount := 5.0;

// Phase 1: Short unconstrained preamble - allow model to emit "<<" naturally
// Use a small preamble budget (up to 3 steps) to let model orient itself
var preambleBudget: nat := 3;
var preambleSteps: nat := 0;

while steps < maxSteps && !insideConstrainedOut && preambleSteps < preambleBudget
  invariant 0 <= steps <= maxSteps
  invariant 0 <= preambleSteps <= preambleBudget
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  preambleSteps := preambleSteps + 1;
  if next == eosToken {
    break;
  }
  generated := generated + [next];
  if next == "<<" {
    insideConstrainedOut := true;
    currentConstrainedOut := [];
  }
}

// If we haven't entered constrained mode yet (model didn't emit "<<" in preamble),
// force entry now
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 2: Constrained SMILES generation
// Use a mix of repetition penalty and adaptive constrained steps
// to generate a non-trivial acrylate SMILES
var useRepetitionPenalty: bool := true;
var penaltyStepsUsed: nat := 0;

while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  // Try to close the span if it's complete
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
  } else {
    // Generate the next constrained token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next: Token;
    
    // Use repetition penalty for first several tokens to avoid trivial outputs
    // then switch to adaptive for the rest
    if penaltyStepsUsed < 20 {
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken
      );
      penaltyStepsUsed := penaltyStepsUsed + 1;
    } else {
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, boostAmount, narrowThreshold, eosToken
      );
    }
    
    if next == eosToken {
      break;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

// If still inside constrained span and budget remaining, try to close it
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

