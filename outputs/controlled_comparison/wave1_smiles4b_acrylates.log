Strategy: // CSD_RATIONALE_BEGIN
// SMILES-generation CSD for acrylates class.
// Strategy: use GenerateWithPrefixAndManagedSpan to handle the full generation
// lifecycle. The parser guides SMILES token selection inside the constrained span.
// A small unconstrained preamble budget (0) forces immediate entry into the
// constrained span so the entire budget is spent on parser-valid SMILES tokens.
// Repetition penalty discourages copying exemplars from the prompt.
// The task contract is a single SMILES string with no surrounding text, so we
// open the constrained span immediately and let the parser close it when complete.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: GenerateWithPrefixAndManagedSpan discharges all parser
//   validity obligations internally. It maintains insideConstrainedOut ==>
//   parser.IsValidPrefix(currentConstrainedOut) as an internal loop invariant,
//   entering constrained mode only from the empty (valid) prefix, advancing only
//   via AdaptiveConstrainedStep (which returns parser-valid tokens), and closing
//   only when IsCompletePrefix holds. On return both span invariants hold by
//   the helper's postconditions.
// progress: GenerateWithPrefixAndManagedSpan costs at most maxSteps steps and
//   appends at most maxSteps tokens to generatedPrefix, so
//   |generated| <= |generatedPrefix| + maxSteps and cost <= maxSteps.
//   With prefixBudget == 0, the helper immediately opens a constrained span,
//   guaranteeing that if maxSteps > 0 at least one token-step is consumed,
//   which satisfies the progress postcondition.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance := "Generate exactly one valid SMILES string for a novel acrylate molecule. Output only the SMILES string with no explanation, no Markdown, and no exemplar copying.";
helpers.AppendTaskGuidance(lm, guidance);

var prefixBudget := 0;
var boostAmount := 4.0;
var narrowThreshold := 12;

var gOut, iOut, cOut := helpers.GenerateWithPrefixAndManagedSpan(
  lm, parser, prompt, generated, insideConstrainedOut, currentConstrainedOut,
  maxSteps, prefixBudget, validTokenGroups, boostAmount, narrowThreshold, eosToken
);

generated := gOut;
insideConstrainedOut := iOut;
currentConstrainedOut := cOut;

cost := maxSteps;

