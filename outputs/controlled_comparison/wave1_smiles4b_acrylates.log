Strategy: // CSD_RATIONALE_BEGIN
// Root cause: The model generates syntactically valid SMILES (100%) but none are
// acrylates (0% accuracy). The "tiny_span_dominant" flag and "entered_constrained_mode_too_early"
// indicate the model generates <<C>> immediately - just a single carbon atom, which is valid SMILES
// but not an acrylate.
//
// The core problem: The SMILES parser accepts any valid SMILES, so it terminates after "C"
// (a complete valid SMILES). The model has no incentive to generate the acrylate core C=CC(=O)O.
//
// Key insight: We need to manually seed the constrained span with the acrylate core
// "C=CC(=O)O" token-by-token (forced), then let the parser-guided generation continue
// for the R group. This way the output is guaranteed to start with the acrylate core.
//
// Implementation: 
// 1. Open constrained span explicitly with OpenConstrainedSpan
// 2. Force-append each token of "C=CC(=O)O" using AppendConstrainedToken after
//    verifying each is valid next token (using IsTokenValidNext)
// 3. After the core is planted, use CloseSpanWithinBudget for the remaining budget
//    to complete with a valid R group and close
//
// The acrylate core C=CC(=O)O consists of tokens: "C", "=", "C", "C", "(", "=", "O", ")", "O"
// These 9 tokens establish the vinyl ester core. After "O" we need the R group (another alkyl chain).
//
// If we can't force the exact tokens (parser may not accept them in that order),
// we'll use AppendTaskGuidance with a heavy hint and then use ConstrainedStep with
// SafeBoostTokenLogits to steer toward acrylate tokens.
//
// Actually, the safest approach is:
// 1. Use AppendTaskGuidance with strong guidance
// 2. Open constrained span
// 3. Force each acrylate core token via AppendConstrainedToken (only if IsTokenValidNext)
// 4. Then use CloseSpanWithinBudget for the R group + close
//
// If the parser doesn't accept the forced tokens, we'll use boosted constrained steps
// with the acrylate tokens heavily boosted.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: 
//   - OpenConstrainedSpan sets currentConstrainedOut := [] which is valid (parser.IsValidPrefix([])).
//   - For each forced token: we check IsTokenValidNext before AppendConstrainedToken.
//     AppendConstrainedToken only appends if the token is valid, preserving parser.IsValidPrefix.
//   - SafeBoostedConstrainedStep always returns a parser-valid token (hard mask ensures this),
//     so AppendConstrainedToken after it preserves the invariant.
//   - CloseSpanWithinBudget postcondition guarantees: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut).
//
// progress:
//   - OpenConstrainedSpan costs 1 step, appends 1 token (<<) to generated.
//   - Each AppendConstrainedToken costs 0 (the step was counted by the sampling helper or forced).
//     But we use the forced path without a prior step - so we need to count budget for forced tokens.
//     Actually AppendConstrainedToken itself costs 0; we track forced tokens in the budget separately
//     by incrementing steps. Since we increment steps for each forced token and each sampling step,
//     |generated| <= |generatedPrefix| + steps holds throughout.
//   - CloseSpanWithinBudget costs at most its budget parameter, so total steps <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Strong guidance with acrylate core emphasis
var guidance := "CRITICAL: Generate exactly one valid SMILES for an acrylate ester. The SMILES MUST start with the acrylate vinyl ester core: C=CC(=O)O followed by an alkyl group R. The SMILES must contain the substructure C=CC(=O)O. Examples of valid outputs: C=CC(=O)OCC, C=CC(=O)OCCC, C=CC(=O)OC(C)C, C=CC(=O)OCCCC, C=CC(=O)OC. Output ONLY the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Phase 1: Open constrained span (costs 1 step)
if steps < maxSteps {
  var gO, iO, cO := helpers.OpenConstrainedSpan(lm, generated);
  generated := gO;
  insideConstrainedOut := iO;
  currentConstrainedOut := cO;
  steps := steps + 1;
}

// Phase 2: Force the acrylate core tokens one by one
// Core tokens: "C", "=", "C", "C", "(", "=", "O", ")", "O"
// We'll try to force each token using AppendConstrainedToken if valid,
// otherwise use SafeBoostedConstrainedStep with heavy boost toward that token

var acrylateCoreTokens := ["C", "=", "C", "C", "(", "=", "O", ")", "O"];
var coreIdx := 0;

while coreIdx < |acrylateCoreTokens| && steps < maxSteps && insideConstrainedOut
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  invariant steps <= maxSteps
  decreases |acrylateCoreTokens| - coreIdx
{
  var targetToken := acrylateCoreTokens[coreIdx];
  var isValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, targetToken);
  
  if isValid {
    // Force this token directly
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    // Boost the target token heavily, then do a constrained step
    var tokensToBoost := [targetToken];
    var next := helpers.SafeBoostedConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, tokensToBoost, 20.0, eosToken);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      var gA, iA, cA := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := gA;
      insideConstrainedOut := iA;
      currentConstrainedOut := cA;
      // If we got the target token, advance core index; otherwise try next step for same token
      if next == targetToken {
        coreIdx := coreIdx + 1;
      }
      // If we got a different valid token, still advance (parser accepted it)
      else {
        coreIdx := coreIdx + 1;
      }
    }
  } else {
    // Token not valid - skip this forced token, advance index
    coreIdx := coreIdx + 1;
  }
}

// Phase 3: Use CloseSpanWithinBudget for the R group and close
if insideConstrainedOut && steps < maxSteps {
  var closeBudget := maxSteps - steps;
  var cg, ci, cc := helpers.CloseSpanWithinBudget(
    lm, parser, prompt, generated, currentConstrainedOut, eosToken, closeBudget
  );
  generated := cg;
  insideConstrainedOut := ci;
  currentConstrainedOut := cc;
  steps := maxSteps;
}

cost := steps;

