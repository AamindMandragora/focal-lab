Strategy: // CSD_RATIONALE_BEGIN
// SUPPRESS-THEN-FORCE CSD for math word problems with << >> final answer.
//
// State tracked:
//   - generated: full output so far (reasoning + delimiters + answer)
//   - insideConstrainedOut / currentConstrainedOut: constrained span state
//   - steps: token budget consumed
//   - phase: 0 = free reasoning (suppress "<<"), 1 = forced constrained span
//
// Strategy:
//   Phase 0 (free reasoning): Run UnconstrainedChunk with "<<" as the stop
//   token so the model reasons in plain text. We PENALIZE the "<<" token to
//   suppress model-initiated span opening. The chunk helper stops if the model
//   naturally emits "<<" (stoppedOnOpenSpan), but because we penalize it the
//   model should not. We reserve enough budget for the forced span.
//
//   After the reasoning phase (or when budget is low), we FORCE the constrained
//   span: append "<<" via OpenConstrainedSpan, then drive the answer through
//   parser-guided constrained decoding using AdaptiveConstrainedStep with group
//   boosts. When the parser reports completeness, close with CloseConstrainedSpan
//   which appends ">>".
//
//   This satisfies the SUPPRESS-THEN-FORCE requirement:
//   (1) During reasoning, "<<" is penalized so the model cannot open a span.
//   (2) After reasoning, exactly one constrained span is forced.
//   (3) The span is always closed (budget reservation ensures this).
//
// Budget allocation:
//   - Reserve SPAN_RESERVE steps for the constrained span + close delimiter.
//   - Use remaining steps for free reasoning.
//   - SPAN_RESERVE is set conservatively to allow a complete numeric answer.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//
//   Phase 0 (free reasoning branch):
//     UnconstrainedChunk is called with "<<" as openSpanToken. If
//     stoppedOnOpenSpan is true, we call EnterObservedConstrainedSpan which
//     sets currentConstrainedOut := [] — the empty prefix is always a valid
//     prefix by parser.IsValidPrefix([]) precondition. If stoppedOnOpenSpan is
//     false, insideConstrainedOut remains false, making the implication vacuous.
//
//   Phase 1 force-open branch (OpenConstrainedSpan):
//     OpenConstrainedSpan sets currentConstrainedOut := [], which is valid by
//     the precondition parser.IsValidPrefix([]). insideConstrainedOut := true.
//
//   Phase 1 constrained step branch:
//     AdaptiveConstrainedStep returns either eosToken or a token t such that
//     parser.IsValidPrefix(currentConstrainedOut + [t]). AppendConstrainedToken
//     sets currentConstrainedOut := currentConstrainedOut + [t], preserving
//     validity.
//
//   Phase 1 close branch (CloseConstrainedSpan):
//     CloseConstrainedSpan sets insideConstrainedOut := false and
//     currentConstrainedOut := [], making the implication vacuous.
//
// progress invariant:
//   |generated| <= |generatedPrefix| + steps
//
//   Phase 0 (UnconstrainedChunk):
//     stepsUsed tokens are consumed and at most stepsUsed tokens are appended
//     to generated (EOS is not appended). steps += stepsUsed so the bound is
//     preserved. If stoppedOnOpenSpan, the "<<" token is already in generatedOut
//     (counted in stepsUsed), so the bound still holds.
//
//   Phase 1 force-open (OpenConstrainedSpan):
//     Appends exactly one "<<" token and costs 1 step. steps += 1.
//     |generated| increases by 1 <= 1 = steps increase. Preserved.
//
//   Phase 1 constrained step:
//     AdaptiveConstrainedStep costs 1 step. AppendConstrainedToken appends at
//     most 1 token. steps += 1. Preserved.
//
//   Phase 1 close (CloseConstrainedSpan):
//     Appends ">>" (1 token) and costs 1 step. steps += 1. Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Reserve budget for the constrained span: enough for a numeric answer + ">>"
var SPAN_RESERVE: nat := 30;
var steps: nat := 0;

// Suppress "<<" during reasoning by penalizing it
helpers.SafePenalizeTokenLogits(lm, ["<<"], 20.0);

// Phase 0: Free reasoning with "<<" suppressed
// We use UnconstrainedChunk to generate reasoning text.
// If budget is already low, skip reasoning and go straight to forced span.
if maxSteps > SPAN_RESERVE && !insideConstrainedOut {
  var reasoningBudget: nat := maxSteps - SPAN_RESERVE;
  var generatedOut, stoppedOnOpenSpan, stoppedOnEos, stepsUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, reasoningBudget, "<<", eosToken);
  steps := steps + stepsUsed;
  generated := generatedOut;
  if stoppedOnOpenSpan {
    // Model somehow emitted "<<" despite penalty — enter observed span
    var g2, i2, c2 := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := g2;
    insideConstrainedOut := i2;
    currentConstrainedOut := c2;
  } else if stoppedOnEos {
    // EOS during reasoning — still force the constrained span below
    // (do not break; we need to emit the answer)
  }
}

// Phase 1: Force exactly one constrained span for the final answer
// Only open a new span if we are not already inside one
if steps < maxSteps && !insideConstrainedOut {
  var g2, i2, c2 := helpers.OpenConstrainedSpan(lm, generated);
  generated := g2;
  insideConstrainedOut := i2;
  currentConstrainedOut := c2;
  steps := steps + 1;
}

// Drive constrained content through parser-guided decoding
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if parser.IsCompletePrefix(currentConstrainedOut) {
    // Close the span with ">>"
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    // Generate next constrained token
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
    );
    steps := steps + 1;
    if next == eosToken {
      // Budget or EOS — rollback to last complete prefix and close
      var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
      generated := rg;
      currentConstrainedOut := rc;
      if steps < maxSteps {
        if parser.IsCompletePrefix(currentConstrainedOut) {
          var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg2;
          insideConstrainedOut := ci2;
          currentConstrainedOut := cc2;
          steps := steps + 1;
        } else {
          // Cannot close cleanly — exit loop
          insideConstrainedOut := false;
          currentConstrainedOut := [];
        }
      } else {
        insideConstrainedOut := false;
        currentConstrainedOut := [];
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

// Safety: if still inside constrained span and out of budget, rollback and close
if insideConstrainedOut {
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
  if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    insideConstrainedOut := false;
    currentConstrainedOut := [];
  }
}

