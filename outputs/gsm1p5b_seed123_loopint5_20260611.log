// parser_validity invariant:
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//
//   UnconstrainedStep branch (outside span):
//     If next == "<<", we set currentConstrainedOut := [], which satisfies
//     parser.IsValidPrefix([]) by precondition. insideConstrainedOut := true.
//     Otherwise insideConstrainedOut stays false (implication vacuous).
//
//   OpenConstrainedSpan branch:
//     Sets currentConstrainedOut := []. parser.IsValidPrefix([]) holds by
//     precondition. insideConstrainedOut := true.
//
//   ConstrainedStep + AppendConstrainedToken branch (inside span):
//     ConstrainedStep returns token t with parser.IsValidPrefix(
//     currentConstrainedOut + [t]). AppendConstrainedToken extends
//     currentConstrainedOut by [t], preserving validity.
//
//   CloseConstrainedSpan branch:
//     Requires parser.IsCompletePrefix(currentConstrainedOut). After close,
//     insideConstrainedOut := false (implication vacuous), currentConstrainedOut := [].
//
//   RollbackConstrainedToComplete branch:
//     Returns a prefix that is either IsCompletePrefix or []. Both satisfy
//     IsValidPrefix. After cleanup, insideConstrainedOut := false (vacuous).
//
// progress invariant:
//   |generated| <= |generatedPrefix| + steps
//
//   UnconstrainedStep: costs 1 step, appends at most 1 token. Preserved.
//   OpenConstrainedSpan: costs 1 step, appends "<<" (1 token). Preserved.
//   ConstrainedStep: costs 1 step, AppendConstrainedToken appends 1 token. Preserved.
//   CloseConstrainedSpan: costs 1 step, appends ">>" (1 token). Preserved.
//   RollbackConstrainedToComplete: costs 0 steps, may shrink generated. Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Guidance to steer the model toward symbolic arithmetic answers
helpers.AppendTaskGuidance(lm, "After reasoning step by step, provide the final arithmetic expression as the answer inside << >> delimiters. The expression should use the symbolic variable names from the problem.");

// Budget constants
// With maxSteps=900 and avg token cost ~47, we need the span to complete
// within the budget. Reserve enough for the constrained span.
var SPAN_RESERVE: nat := 150;
var steps: nat := 0;

// Suppress "<<" very aggressively during reasoning
helpers.SafePenalizeTokenLogits(lm, ["<<"], 50.0);

// Phase 0: Free reasoning using individual UnconstrainedStep calls
// This gives us full control over "<<" suppression per step
// We stop when we've used up the reasoning budget OR when we're close to reserve
var reasoningBudget: nat := 0;
if maxSteps > SPAN_RESERVE + 1 {
  reasoningBudget := maxSteps - SPAN_RESERVE - 1;
}

var reasoningSteps: nat := 0;
while reasoningSteps < reasoningBudget && !insideConstrainedOut
  invariant 0 <= reasoningSteps <= reasoningBudget
  invariant 0 <= steps <= maxSteps
  invariant steps == reasoningSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases reasoningBudget - reasoningSteps
{
  // Re-apply suppression each step to ensure "<<" stays penalized
  helpers.SafePenalizeTokenLogits(lm, ["<<"], 50.0);
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  reasoningSteps := reasoningSteps + 1;
  steps := steps + 1;
  if next == eosToken {
    // EOS during reasoning - stop reasoning but continue to force span
    break;
  } else if next == "<<" {
    // Model emitted "<<" despite penalty - handle gracefully
    generated := generated + [next];
    var g2, i2, c2 := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := g2;
    insideConstrainedOut := i2;
    currentConstrainedOut := c2;
    break;
  } else {
    generated := generated + [next];
  }
}

// Phase 1: Force exactly one constrained span for the final answer
// Always open a fresh span if not already inside one
if steps < maxSteps && !insideConstrainedOut {
  var g2, i2, c2 := helpers.OpenConstrainedSpan(lm, generated);
  generated := g2;
  insideConstrainedOut := i2;
  currentConstrainedOut := c2;
  steps := steps + 1;
}

// Phase 2: Drive constrained content through hard parser-guided decoding
// Use ConstrainedStep for strongest parser control
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if parser.IsCompletePrefix(currentConstrainedOut) {
    // Close the span immediately when complete
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    // Generate next constrained token using hard parser control
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
    steps := steps + 1;
    if next == eosToken {
      // EOS inside span — rollback to last complete prefix and close
      var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
      generated := rg;
      currentConstrainedOut := rc;
      if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
        var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg2;
        insideConstrainedOut := ci2;
        currentConstrainedOut := cc2;
        steps := steps + 1;
      } else {
        insideConstrainedOut := false;
        currentConstrainedOut := [];
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
      // Check immediately after append if complete
      if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
        var cg3, ci3, cc3 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg3;
        insideConstrainedOut := ci3;
        currentConstrainedOut := cc3;
        steps := steps + 1;
        break;
      }
    }
  }
}

// Safety: if still inside constrained span (budget ran out), rollback and close
if insideConstrainedOut {
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
  if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    insideConstrainedOut := false;
    currentConstrainedOut := [];
  }
}

cost := steps;

