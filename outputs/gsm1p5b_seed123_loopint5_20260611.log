Strategy: // CSD_RATIONALE_BEGIN
// SUPPRESS-THEN-FORCE CSD for math word problems with << >> final answer.
//
// Root cause of prior failure: 25/49 examples had unterminated spans because
// the constrained span was opened but the step budget ran out before ">>" was
// emitted. The reasoning phase consumed too many steps (up to maxSteps - 30),
// leaving insufficient budget for the constrained answer generation.
//
// Fix: 
//   1. Use a MUCH larger SPAN_RESERVE (e.g., 200 steps) to ensure the answer
//      span always has enough budget to complete.
//   2. Keep the reasoning phase SHORT (bounded tightly).
//   3. Inside the constrained span, use ConstrainedStep (hard parser control)
//      which is the most reliable for exact arithmetic expressions.
//   4. After generating constrained tokens, check IsCompletePrefix eagerly
//      at every step and close immediately when complete.
//   5. If EOS is hit inside the span, rollback to last complete prefix and
//      close immediately — never leave the span open.
//   6. The "<<" suppression is done via SafePenalizeTokenLogits before the
//      reasoning chunk, so the model reasons in plain text.
//
// Budget: maxSteps=900, stepTokenBudget=1
//   - Reserve 300 steps for constrained span (generous for numeric expression)
//   - Use up to 590 steps for reasoning (leaving 10 for overhead)
//   - Reasoning via UnconstrainedChunk stopping at "<<" or EOS
//
// The key insight from failure analysis: the span reserve of 30 was far too
// small. Arithmetic expressions like "n1*p1 + n2*p2 + n3*p3" need many tokens.
// With stepTokenBudget=1, each token costs 1 step, so we need ~50-100 steps
// for a typical numeric expression. We use 300 as a safe margin.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//
//   Phase 0 (UnconstrainedChunk):
//     If stoppedOnOpenSpan, EnterObservedConstrainedSpan sets
//     currentConstrainedOut := [], which satisfies parser.IsValidPrefix([])
//     by precondition. If not stoppedOnOpenSpan, insideConstrainedOut stays
//     false and the implication is vacuous.
//
//   Phase 1 force-open (OpenConstrainedSpan):
//     Sets currentConstrainedOut := []. parser.IsValidPrefix([]) holds by
//     precondition. insideConstrainedOut := true.
//
//   Phase 1 constrained loop — ConstrainedStep branch:
//     ConstrainedStep returns eosToken or t with parser.IsValidPrefix(
//     currentConstrainedOut + [t]). AppendConstrainedToken sets
//     currentConstrainedOut := currentConstrainedOut + [t], preserving validity.
//
//   Phase 1 constrained loop — CloseConstrainedSpan branch:
//     Requires parser.IsCompletePrefix(currentConstrainedOut). After closing,
//     insideConstrainedOut := false, making the implication vacuous.
//
//   Phase 1 constrained loop — EOS/rollback branch:
//     RollbackConstrainedToComplete produces a prefix that is either
//     IsCompletePrefix or empty — both are IsValidPrefix. After close or
//     forced exit, insideConstrainedOut := false (vacuous) or currentConstrainedOut
//     is the rolled-back valid prefix.
//
//   Safety cleanup after loop:
//     Same rollback + close logic as above.
//
// progress invariant:
//   |generated| <= |generatedPrefix| + steps
//
//   UnconstrainedChunk: stepsUsed tokens consumed, at most stepsUsed appended
//     (EOS not appended). steps += stepsUsed. If stoppedOnOpenSpan, "<<" is
//     already in generatedOut and counted in stepsUsed. Preserved.
//
//   OpenConstrainedSpan: appends "<<" (1 token), costs 1 step. steps += 1.
//     |generated| increases by 1. Preserved.
//
//   ConstrainedStep + AppendConstrainedToken: 1 step consumed, at most 1 token
//     appended. steps += 1. Preserved.
//
//   CloseConstrainedSpan: appends ">>" (1 token), costs 1 step. steps += 1.
//     Preserved.
//
//   RollbackConstrainedToComplete: no tokens appended, no steps consumed.
//     |generated| may decrease (rollback). Preserved since |generated|
//     can only decrease or stay same. steps unchanged. Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Reserve a generous budget for the constrained span
var SPAN_RESERVE: nat := 300;
var steps: nat := 0;

// Suppress "<<" during reasoning so model cannot open a span on its own
helpers.SafePenalizeTokenLogits(lm, ["<<"], 25.0);

// Phase 0: Free reasoning with "<<" suppressed
// Only reason if we have enough budget left after reserving for the span
if maxSteps > SPAN_RESERVE + 2 && !insideConstrainedOut {
  var reasoningBudget: nat := maxSteps - SPAN_RESERVE - 2;
  var generatedOut, stoppedOnOpenSpan, stoppedOnEos, stepsUsed :=
    helpers.UnconstrainedChunk(lm, prompt, generated, reasoningBudget, "<<", eosToken);
  steps := steps + stepsUsed;
  generated := generatedOut;
  if stoppedOnOpenSpan {
    // Model emitted "<<" despite penalty — enter observed span state
    var g2, i2, c2 := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := g2;
    insideConstrainedOut := i2;
    currentConstrainedOut := c2;
  }
  // If stoppedOnEos: we still proceed to force the answer span
}

// Phase 1: Force exactly one constrained span for the final answer
if steps < maxSteps && !insideConstrainedOut {
  var g2, i2, c2 := helpers.OpenConstrainedSpan(lm, generated);
  generated := g2;
  insideConstrainedOut := i2;
  currentConstrainedOut := c2;
  steps := steps + 1;
}

// Drive constrained content through hard parser-guided decoding
// Use ConstrainedStep for strongest parser control
while steps < maxSteps && insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if parser.IsCompletePrefix(currentConstrainedOut) {
    // Close the span immediately when complete
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    // Generate next constrained token using hard parser control
    var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
    steps := steps + 1;
    if next == eosToken {
      // EOS inside span — rollback to last complete prefix and close
      var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
      generated := rg;
      currentConstrainedOut := rc;
      if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
        var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg2;
        insideConstrainedOut := ci2;
        currentConstrainedOut := cc2;
        steps := steps + 1;
      } else {
        // Cannot close cleanly — mark as closed with empty state
        insideConstrainedOut := false;
        currentConstrainedOut := [];
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
      // Check immediately after append if we're complete
      if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
        var cg3, ci3, cc3 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg3;
        insideConstrainedOut := ci3;
        currentConstrainedOut := cc3;
        steps := steps + 1;
        break;
      }
    }
  }
}

// Safety: if still inside constrained span (budget ran out), rollback and close
if insideConstrainedOut {
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
  if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    insideConstrainedOut := false;
    currentConstrainedOut := [];
  }
}

cost := steps;

