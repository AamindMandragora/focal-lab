Strategy: // CSD_RATIONALE_BEGIN
// SMILES acrylates CSD - HIDDEN constrained generation (no visible << >>).
// The key failure in attempt 1: OpenConstrainedSpan adds "<<" immediately,
// and the parser only accepts 1 token ("C") before closing, producing "<<C>>"
// which is a tiny span with wrong content. The answer_source shows "none" for
// hidden_or_task_extractor, meaning the evaluator expects a hidden constrained
// span, not a visible one.
//
// Fix: Use ConstrainedGeneration which generates a full SMILES string under
// parser control from empty prefix, starting immediately (no delimiter needed).
// The task contract says "hidden constrained chunk" - so we directly call
// ConstrainedGeneration with sufficient budget and let the parser enforce
// SMILES validity for an acrylate molecule.
//
// The guidance block instructs the LM to generate a full acrylate SMILES
// (e.g. ethyl acrylate: CCOC(=O)C=C, methyl acrylate: COC(=O)C=C, etc.)
// before the constrained generation begins.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   ConstrainedGeneration starts from an empty prefix (which is valid by
//   precondition parser.IsValidPrefix([])) and internally loops ConstrainedStep,
//   which always returns parser-valid tokens or EOS. The returned
//   constrainedGenerated satisfies parser.IsValidPrefix by the helper's contract.
//   We set currentConstrainedOut := [] (not inside constrained) after the call,
//   so the implication !insideConstrainedOut ==> currentConstrainedOut == [] holds.
//   insideConstrainedOut is set to false, making parser_validity vacuously true.
// progress:
//   ConstrainedGeneration costs at most +budget steps where budget <= maxSteps.
//   The generated output grows by |constrainedGenerated| <= budget tokens.
//   So |generated| <= |generatedPrefix| + budget <= |generatedPrefix| + maxSteps.
//   cost is set to min(budget, maxSteps) which satisfies cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a single valid SMILES string for a novel acrylate molecule. Acrylates contain the acryloyl group C=CC(=O)O or C=CC(=O)N. Examples of acrylate SMILES: CCOC(=O)C=C (ethyl acrylate), COC(=O)C=C (methyl acrylate), OC(=O)C=C (acrylic acid), C=CC(=O)OCC (ethyl acrylate), C=CC(=O)OCCO (2-hydroxyethyl acrylate). Output only the SMILES string, nothing else.";
helpers.AppendTaskGuidance(lm, guidance);

// Use a budget that leaves room for the constrained generation
var budget: nat := if maxSteps > 2 then maxSteps - 1 else maxSteps;

// ConstrainedGeneration starts from empty prefix, fully parser-controlled
// It returns the SMILES tokens as a sequence we append to generated
var constrainedGenerated, terminatedByEos := helpers.ConstrainedGeneration(
  lm, parser, prompt, budget, eosToken
);

// Append the constrained result to generated
generated := generatedPrefix + constrainedGenerated;

// We are no longer inside a constrained span (generation complete)
insideConstrainedOut := false;
currentConstrainedOut := [];

// Cost is the number of tokens generated (bounded by budget <= maxSteps)
var genLen: nat := |constrainedGenerated|;
cost := if genLen < budget then genLen + 1 else budget; // +1 for EOS or close step

// Ensure cost <= maxSteps
if cost > maxSteps {
  cost := maxSteps;
}

// Ensure progress invariant: if maxSteps > 0 and we generated nothing, cost >= 1
if maxSteps > 0 && cost == 0 {
  cost := 1;
}

