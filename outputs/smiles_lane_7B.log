Strategy: // CSD_RATIONALE_BEGIN
// DIAGNOSIS: The key failure is "entered_constrained_mode_too_early" — the strategy
// opens << immediately, and the SMILES parser accepts just "O" as a complete molecule,
// so the span closes with a trivially valid but wrong answer (just "O", which is water,
// not an isocyanate).
//
// The parser accepts "O" as a complete SMILES (it's valid SMILES for water), so
// CloseSpanIfComplete fires after just 1 token. We need to force generation of
// isocyanate-specific content. The parser will allow many SMILES molecules, but we
// need isocyanate ones with N=C=O.
//
// ROOT CAUSE: The SMILES parser allows trivially short completions. We need to:
// 1. NOT use CloseSpanIfComplete (it fires too early)
// 2. Force the model to generate a substantial SMILES string before closing
// 3. Only close when we've generated enough content
//
// STRATEGY:
// 1. Strong task guidance mentioning that we need N=C=O isocyanate substructure
// 2. Open constrained span
// 3. Loop generating tokens WITHOUT CloseSpanIfComplete
// 4. Only attempt to close after generating a minimum number of tokens (e.g., 5+)
//    AND the parser says we're at a complete prefix
// 5. Use AdaptiveConstrainedStep for all token generation (no CloseSpanIfComplete)
// 6. At end of budget or EOS, rollback to complete and close
//
// The minimum token threshold prevents premature closure on "O", "N", etc.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - OpenConstrainedSpan sets currentConstrainedOut := [] (valid by precondition).
//   - AdaptiveConstrainedStep returns EOS or a parser-valid next token;
//     AppendConstrainedToken extends currentConstrainedOut preserving IsValidPrefix.
//   - RollbackConstrainedToComplete returns IsCompletePrefix or []; both are valid.
//   - CloseConstrainedSpan only fires when IsCompletePrefix holds, sets inside=false
//     making the implication vacuous.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan appends "<<" (1 token), steps incremented by 1.
//   - Each iteration: steps += 1, AppendConstrainedToken appends at most 1 token.
//   - CloseConstrainedSpan appends ">>" (1 token), steps incremented by 1.
//   - EOS path: steps already incremented for the EOS call; rollback only shrinks;
//     close increments steps and appends 1 token. All bounded.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate exactly one novel SMILES string for an isocyanate molecule. Isocyanates must contain the N=C=O functional group. The SMILES must be at least 5 characters long and include the substructure O=C=N or N=C=O. Do not output water (O) or other non-isocyanate molecules. Example isocyanates: O=C=NCCCC, O=C=NCc1ccccc1, O=C=NC(C)C. Output only the SMILES string.");

var steps: nat := 0;

// Open constrained span if not already inside one.
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Minimum tokens before we allow closing (to prevent trivial single-token completions)
var minTokensBeforeClose: nat := 6;
var tokensGenerated: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  }

  var stableLen: nat := |generated| - |currentConstrainedOut|;
  var constrainedPrompt := prompt + generated[..stableLen];

  // Only close if we've generated enough tokens
  if tokensGenerated >= minTokensBeforeClose && parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
    var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg2;
    insideConstrainedOut := ci2;
    currentConstrainedOut := cc2;
    steps := steps + 1;
    break;
  }

  // Reserve 2 steps for rollback+close at end of budget
  if steps + 2 >= maxSteps {
    var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
    generated := rg;
    currentConstrainedOut := rc;
    if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
      var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg2;
      insideConstrainedOut := ci2;
      currentConstrainedOut := cc2;
      steps := steps + 1;
    }
    break;
