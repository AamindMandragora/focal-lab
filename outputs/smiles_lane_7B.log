Strategy: // CSD_RATIONALE_BEGIN
// SMILES acrylates CSD. The strategy uses a hidden constrained span to generate
// a valid SMILES string for an acrylate molecule. We use OpenConstrainedSpan to
// enter constrained mode immediately, then use SafeRepetitionPenaltyStep inside
// the constrained span to avoid copying exemplar tokens, combined with
// AdaptiveConstrainedStep to provide group-level guidance from validTokenGroups.
// Once the parser reaches a complete prefix, CloseConstrainedSpan exits the span.
// State tracked: insideConstrainedOut (span active), currentConstrainedOut (parser
// prefix for SMILES grammar), steps (budget).
// The guidance block nudges the LM toward novel acrylate SMILES strings.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan sets insideConstrainedOut := true and
//      currentConstrainedOut := [], which satisfies parser.IsValidPrefix([]) by
//      precondition. CloseConstrainedSpan sets insideConstrainedOut := false,
//      making the implication vacuous.
//   2. Inside the constrained branch, SafeRepetitionPenaltyStep returns either
//      EOS or a parser-valid extension token. AppendConstrainedToken preserves
//      parser validity: if currentConstrainedOut was valid and next is a valid
//      next token, then currentConstrainedOut + [next] is valid.
//      AdaptiveConstrainedStep similarly guarantees parser validity of the
//      returned token.
// progress:
//   1. OpenConstrainedSpan costs 1 step and appends one token ("<<") to
//      generated, so |generated| grows by 1 while steps grows by 1.
//   2. CloseConstrainedSpan costs 1 step and appends at most one token (">>"),
//      so the bound is preserved.
//   3. Each constrained step costs 1 step and AppendConstrainedToken appends
//      at most one token, so |generated| <= |generatedPrefix| + steps.
//   4. EOS branch breaks without appending, preserving the bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a single valid SMILES string for a novel acrylate molecule (contains C=CC(=O)O or C=CC(=O)N core). Output only the SMILES string with no explanation, no Markdown, no exemplar copying.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var narrowThreshold: nat := 12;

// Enter constrained span immediately for the SMILES output
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed; generation complete
    break;
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    // Close the constrained span
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
    break;
  } else {
    // Compute the stable prefix (everything before the constrained portion)
    var stableLen := |generated| - |currentConstrainedOut|;
    var constrainedPrompt := prompt + generated[..stableLen];

    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    var next: Token;

    if validCount <= narrowThreshold {
      // Narrow parser state: use group boosting to guide toward valid SMILES tokens
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut,
        validTokenGroups, 5.0, narrowThreshold, eosToken
      );
    } else {
      // Wider parser state: use repetition penalty to encourage novel structures
      next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut,
        generated, 2.0, eosToken
      );
    }

    steps := steps + 1;

    if next == eosToken {
      // EOS inside constrained span: try to close if complete, otherwise break
      if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var ag, ai, ac := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := ag;
      insideConstrainedOut := ai;
      currentConstrainedOut := ac;
    }
  }
}

cost := steps;

