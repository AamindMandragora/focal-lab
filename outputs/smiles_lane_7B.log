// SMILES chain-extender generation CSD.
// State tracked: generated (full visible output), insideConstrainedOut (whether
// we are inside a constrained span), currentConstrainedOut (tokens accumulated
// inside the span), cost/steps.
//
// The strategy uses a single fully-constrained span to produce one valid SMILES
// string. Since the task contract says "a single SMILES string and nothing
// else", we open a constrained span immediately (step 1), then loop using
// AdaptiveConstrainedStep with the caller-supplied validTokenGroups as soft
// hints. When the parser signals completeness we close the span and stop.
// A repetition-penalty path is used in later tokens to discourage reusing
// tokens already emitted (avoiding copying exemplars). If EOS arrives before
// completion, we attempt a rollback-and-continue repair.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   OpenConstrainedSpan sets currentConstrainedOut := [] and insideConstrainedOut
//   := true; [] is a valid prefix by parser.IsValidPrefix([]) precondition.
//   In the main constrained loop, AdaptiveConstrainedStep and
//   SafeRepetitionPenaltyStep both guarantee they return EOS or a parser-valid
//   extension; AppendConstrainedToken then preserves parser.IsValidPrefix by
//   the helper contract. CloseConstrainedSpan sets insideConstrainedOut := false,
//   making the implication vacuously true. RollbackAndContinue ensures its
//   output is IsCompletePrefix or empty and IsValidPrefix, restoring the
//   invariant.
// progress:
//   OpenConstrainedSpan costs 1 step and appends exactly one token ("<<") to
//   generated. Each constrained-step branch costs 1 step and appends at most
//   one visible token (EOS breaks immediately without appending). CloseConstrainedSpan
//   costs 1 step and appends ">>" (one token). RollbackAndContinue costs at most
//   (maxSteps - steps - 1) steps. In all branches, |generated| grows by at most
//   the number of steps consumed, so |generated| <= |generatedPrefix| + steps
//   is maintained throughout.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Output exactly one valid SMILES string for a chain_extender molecule. Do not copy any example from the prompt. Output only the SMILES string with no explanation, no Markdown, and no extra tokens.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var narrowThreshold: nat := 12;

// If not already inside a constrained span, open one immediately.
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
