Strategy: // CSD_RATIONALE_BEGIN
// Root cause analysis: Every prior attempt generates only "C" (1 token) because:
// 1. The SMILES parser accepts "C" as a complete valid prefix immediately.
// 2. The strategy sees IsCompletePrefix=true after just one token and closes.
// 3. "C" is not an acrylate, so accuracy=0%.
//
// The failure diagnostic says "tiny_span_dominant: 100%" and "valid_nonfinal_spans_only: 50/50"
// meaning spans exist but are tiny (1 token = "C") and not the final answer.
// The "answer_source: none" means the extractor finds no usable final span.
//
// Key insight: The SMILES parser for acrylates must accept "C" as complete
// because "C" is a valid SMILES (methane). We need to FORCE generation of a
// longer structure. The only way to do this is to NOT close when the span is
// short, and instead keep generating past single-atom completions.
//
// Solution: Use a minimum length guard before closing. We need at least ~8-10
// tokens to have a valid acrylate (C=CC(=O)O requires 9 tokens). We track
// length of currentConstrainedOut and only allow CloseConstrainedSpan when
// |currentConstrainedOut| >= minSmilesLen.
//
// But CloseConstrainedSpan requires IsCompletePrefix -- so we need to keep
// calling AppendConstrainedToken even when IsCompletePrefix is true (to extend
// the SMILES further). The precondition for AppendConstrainedToken does NOT
// require !IsCompletePrefix. AppendConstrainedToken requires IsValidPrefix AND
// next is a valid next token. But if IsCompletePrefix is true and there are
// valid next tokens, we CAN still append.
//
// So the fix is:
// 1. Use visible delimiters (<< >>) since the evaluator needs them.
// 2. After OpenConstrainedSpan, use AdaptiveConstrainedStep to generate tokens.
// 3. Only call CloseConstrainedSpan when BOTH:
//    - parser.IsCompletePrefix(currentConstrainedOut) is true
//    - |currentConstrainedOut| >= minSmilesLen (e.g., 8 tokens)
// 4. If EOS is returned AND IsCompletePrefix AND len >= minSmilesLen, close.
// 5. If EOS is returned but too short, try RollbackAndContinue or just break.
//
// Important: When IsCompletePrefix is true but we want to keep going, we need
// to check if there are valid next tokens. If ValidTokenCount > 0, we can
// keep appending. If ValidTokenCount == 0 (no valid extensions), we must close.
//
// Acrylate SMILES minimum structure: C=CC(=O)OC = 10 tokens minimum.
// We set minSmilesLen = 8 as a conservative lower bound.
//
// Strong guidance: Tell LM to generate full acrylate SMILES like C=CC(=O)OCC.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan sets currentConstrainedOut := [], which satisfies
//      parser.IsValidPrefix([]) by precondition `parser.IsValidPrefix([])`.
//   2. AdaptiveConstrainedStep returns a parser-valid next token (hard masked).
//      AppendConstrainedToken preserves IsValidPrefix because it only appends
//      a token that is a valid extension.
//   3. CloseConstrainedSpan sets insideConstrainedOut := false, making the
//      implication vacuously true and clearing currentConstrainedOut to [].
//   4. EOS breaks the loop; insideConstrainedOut may remain true, but we
//      attempt to close first when the condition is met.
//
// progress: |generated| <= |generatedPrefix| + steps
//   1. OpenConstrainedSpan costs 1 step, appends "<<" to generated (+1 token).
//      So after open: |generated| = |generatedPrefix| + 1 = |generatedPrefix| + steps.
//   2. Each AdaptiveConstrainedStep costs 1 step. AppendConstrainedToken adds 1
//      token to generated. So |generated| grows by at most 1 while steps grows
//      by 1. Invariant maintained.
//   3. EOS: no token appended to generated, steps grows by 1 (from the step that
//      returned EOS). Invariant maintained since |generated| didn't grow.
//   4. CloseConstrainedSpan costs 1 step, appends ">>" to generated (+1 token).
//      Invariant maintained.
//   5. Budget guard `steps < maxSteps` ensures steps never exceeds maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

// Strong guidance to produce a longer, valid acrylate SMILES string.
// Acrylates have the core C=CC(=O)O (ester) or C=CC(=O)N (amide).
// We need at least 8-10 tokens to represent this structure.
var guidance: string := "You MUST generate a complete acrylate SMILES string with the acrylate core structure C=CC(=O)O (acrylic ester) or C=CC(=O)N (acrylamide). The SMILES must be at least 8 characters long. Valid examples: C=CC(=O)OCC, C=CC(=O)OCCO, C=CC(=O)OC(C)C, C=CC(=O)OCCCC, CCOC(=O)C=C, C=CC(=O)OC. Generate ONLY the SMILES string.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var minSmilesLen: nat := 8;

// Enter the constrained span immediately (visible delimiters for evaluator)
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed; generation complete
    break;
  } else {
    // Check if parser is complete AND we have enough tokens for a valid acrylate
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    var spanLen := |currentConstrainedOut|;
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);

    if isComplete && (spanLen >= minSmilesLen || validCount == 0) {
      // Close the constrained span - we have a sufficiently long valid SMILES
      if steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      // Generate the next constrained token
      var stableLen := |generated| - |currentConstrainedOut|;
      var constrainedPrompt := prompt + generated[..stableLen];

      var next: Token;
      next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut,
        validTokenGroups, 5.0, 16, eosToken
      );

      steps := steps + 1;

      if next == eosToken {
        // EOS received: close if complete and long enough, otherwise break
        if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
          var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
          steps := steps + 1;
        }
        break;
      } else {
        // Append the valid constrained token
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

