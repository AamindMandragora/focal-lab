Strategy: // CSD_RATIONALE_BEGIN
// The failure mode is clear: the evaluator expects a visible << >> constrained span
// containing the SMILES string. The answer extraction uses "last_visible_span" or
// "hidden_or_task_extractor", but the diagnostic shows "missing_constrained_segment"
// for all 50 examples - the << >> delimiters are required for answer extraction.
//
// The previous attempts either:
// 1. Used hidden ConstrainedGeneration (no visible << >>), producing unextractable answers
// 2. Generated only 1 token (avg 1.00 token/example) - likely the parser only allows
//    one token from the empty SMILES prefix before completing
//
// Key insight: The "tiny_span_rate: 100%" diagnostic combined with "valid_nonfinal_spans_only"
// suggests the constrained span IS being created (via << >>) but only contains 1 token.
// Actually wait - "Examples with visible <<: 0/50" - so << is never being emitted.
//
// The fix: Use visible << >> delimiters explicitly. Open a constrained span (appends <<),
// fill it with parser-guided SMILES tokens, then close it (appends >>).
// The ConstrainedGeneration approach doesn't produce visible delimiters.
//
// Strategy:
// 1. Append strong task guidance for isocyanate SMILES.
// 2. Open constrained span with OpenConstrainedSpan (appends <<, costs 1 step).
// 3. Loop: generate parser-valid SMILES tokens using AdaptiveConstrainedStep.
//    Check CloseSpanIfComplete each step. On EOS, rollback-to-complete then close.
// 4. Reserve budget for closing: stop generating when steps >= maxSteps - 2.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - OpenConstrainedSpan sets currentConstrainedOut := [] which is valid by precondition.
//   - CloseSpanIfComplete: when closed=true, insideConstrainedOut := false (vacuous),
//     currentConstrainedOut := []. When closed=false, state unchanged.
//   - AdaptiveConstrainedStep returns EOS or a parser-valid next token;
//     AppendConstrainedToken extends currentConstrainedOut by one valid token,
//     preserving IsValidPrefix by transitivity of the parser grammar.
//   - RollbackConstrainedToComplete produces IsCompletePrefix or []; both are valid prefixes.
//   - CloseConstrainedSpan only fires when IsCompletePrefix holds, sets inside=false.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan appends exactly "<<" (1 token) and we increment steps by 1.
//   - CloseSpanIfComplete: appends ">>" (1 token) when closing, steps incremented by 1.
//   - AdaptiveConstrainedStep: costs 1 step-budget call; AppendConstrainedToken appends
//     at most 1 visible token; steps incremented by 1 per iteration.
//   - RollbackConstrainedToComplete: 0 cost, only shortens generated; preserves bound.
//   - CloseConstrainedSpan: appends ">>" (1 token), steps incremented by 1.
//   - Every branch: steps += 1, |generated| increases by at most 1. Invariant preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "You are generating a SMILES string for an isocyanate molecule. Isocyanates contain the functional group -N=C=O. The SMILES must include N=C=O. Examples of valid isocyanate SMILES: O=C=NCC, O=C=NCCCl, O=C=NCCO, O=C=Nc1ccc(F)cc1, O=C=NCC(C)C. Generate a novel isocyanate SMILES string now.");

var steps: nat := 0;

// Open constrained span with visible << delimiter
if !insideConstrainedOut {
  if steps < maxSteps {
    var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
    generated := og;
    insideConstrainedOut := oi;
    currentConstrainedOut := oc;
    steps := steps + 1;
  }
}

// Main constrained generation loop
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  }

  // Try to close if complete (costs 1 step)
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    break;
  }

  // Still need more tokens - check if we have budget left for at least 2 more steps
  // (1 for the token + 1 for closing)
  if steps + 2 > maxSteps {
    // Budget nearly exhausted: rollback to complete and close if possible
    var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
    generated := rg;
    currentConstrainedOut := rc;
    if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
      var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg2;
      insideConstrainedOut := ci2;
      currentConstrainedOut := cc2;
      steps := steps + 1;
    }
    break;
  }

  // Generate next constrained token
  var stableLen: nat := |generated| - |currentConstrainedOut|;
  var constrainedPrompt := prompt + generated[..stableLen];

  var next := helpers.AdaptiveConstrainedStep(
    lm, parser, constrainedPrompt, currentConstrainedOut,
    validTokenGroups, 4.0, 20, eosToken
  );
  steps := steps + 1;

  if next == eosToken {
    // On EOS, rollback to best complete prefix and close
    var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
    generated := rg;
    currentConstrainedOut := rc;
    if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
      var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg2;
      insideConstrainedOut := ci2;
      currentConstrainedOut := cc2;
      steps := steps + 1;
    }
    break;
  } else {
    var ag, ai, ac := helpers.AppendConstrainedToken(
      lm, parser, generated, currentConstrainedOut, next
    );
    generated := ag;
    insideConstrainedOut := ai;
    currentConstrainedOut := ac;
  }
}

cost := steps;

