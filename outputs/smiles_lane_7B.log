// Root cause diagnosis: The evaluator requires a visible << >> segment
// (answer_source: none in 50/50 examples, missing_constrained_segment: 50/50).
// ConstrainedGeneration without visible delimiters generates tokens but the
// evaluator cannot extract the answer because it looks for << >> span content.
//
// Fix: Use explicit OpenConstrainedSpan (appends "<<"), then generate SMILES
// tokens under hard parser control, then close with CloseConstrainedSpan
// (appends ">>"). The evaluator extracts the SMILES from inside << >>.
//
// Strategy:
// 1. AppendTaskGuidance to orient model toward isocyanates.
// 2. OpenConstrainedSpan immediately (costs 1 step, appends "<<").
// 3. Loop: each iteration tries CloseSpanIfComplete (1 step).
//    If complete, close and break.
//    Otherwise, generate 1 parser-valid token using AdaptiveConstrainedStep
//    with group boosts from validTokenGroups (costs 1 step).
//    If EOS, rollback to complete and close.
// 4. cost := steps.
//
// The "tiny span" problem in attempt 2 was that we were immediately seeing
// IsCompletePrefix after 1 token ("O"). We need to ensure we're generating
// isocyanate SMILES (which need N=C=O). The guidance and group boosts help.
// We use SafeRepetitionPenaltyStep when the span is wide to encourage diversity.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity invariant:
//   - OpenConstrainedSpan sets currentConstrainedOut := [] which satisfies
//     parser.IsValidPrefix([]) by the method precondition.
//   - CloseSpanIfComplete: when closed=true, sets insideConstrainedOut=false
//     making the implication vacuous, clears currentConstrainedOut=[].
//     When closed=false, state unchanged (still valid by invariant).
//   - AdaptiveConstrainedStep returns EOS or a parser-valid next token.
//     AppendConstrainedToken then extends currentConstrainedOut preserving validity.
//   - RollbackConstrainedToComplete ensures currentConstrainedOut is
//     IsCompletePrefix or []; both satisfy IsValidPrefix.
//   - CloseConstrainedSpan requires IsCompletePrefix, sets insideConstrainedOut=false.
//
// progress invariant (|generated| <= |generatedPrefix| + steps):
//   - OpenConstrainedSpan appends "<<" (+1 token) and steps becomes 1.
//   - Each loop iteration increments steps by 1 and appends at most 1 token
//     (via AppendConstrainedToken, CloseSpanIfComplete adding ">>", or
//     CloseConstrainedSpan adding ">>").
//   - RollbackConstrainedToComplete does not append; it only removes tokens.
//   - EOS path: CloseConstrainedSpan appends ">>" and steps is incremented,
//     maintaining the bound.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate exactly one valid novel SMILES string for an isocyanate compound. Isocyanates contain the N=C=O functional group (written as N=C=O or [N+]#[C-]=O in SMILES). Examples of structural motifs: CCNCO, O=C=NCCN=C=O, O=C=Nc1ccccc1. Output ONLY the SMILES string inside the constrained span, nothing else.");

var steps: nat := 0;

// Open the visible constrained span (appends "<<").
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

var narrowThreshold: nat := 20;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  }

  // Try to close if the current constrained prefix is already complete.
  var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
  steps := steps + 1;
  if closed {
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    break;
  }

  // Need more steps to generate and possibly close.
  if steps >= maxSteps {
    break;
  }

  // Generate one parser-valid token.
  var stableLen: nat := |generated| - |currentConstrainedOut|;
  var constrainedPrompt := prompt + generated[..stableLen];

  var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
  var next: Token;

  if validCount <= narrowThreshold {
    next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      validTokenGroups, 6.0, narrowThreshold, eosToken
    );
  } else {
    next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      generated, 2.0, eosToken
    );
  }
  steps := steps + 1;

  if next == eosToken {
    // Roll back to the best complete prefix and close if possible.
    var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
    generated := rg;
    currentConstrainedOut := rc;
    if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
      var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg2;
      insideConstrainedOut := ci2;
      currentConstrainedOut := cc2;
      steps := steps + 1;
    }
    break;
  } else {
    var ag, ai, ac := helpers.AppendConstrainedToken(
      lm, parser, generated, currentConstrainedOut, next
    );
    generated := ag;
    insideConstrainedOut := ai;
    currentConstrainedOut := ac;
  }
}

cost := steps;

