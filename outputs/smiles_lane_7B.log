    steps := steps + 1;

    if next == eosToken {
      // Rollback to best complete prefix and close
      var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
      generated := rg;
      currentConstrainedOut := rc;
      if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
        var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg2;
        insideConstrainedOut := ci2;
        currentConstrainedOut := cc2;
        steps := steps + 1;
      }
      break;
    } else {
      // Only append if not already at a complete prefix
      // (AppendConstrainedToken requires !IsCompletePrefix)
      var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
      if isComplete {
        // Close the span since we're already complete
        if tokensGenerated >= minTokensBeforeClose {
          var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg2;
