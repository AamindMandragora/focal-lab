// Strategy: For the SMILES dataset, we use ConstrainedGeneration to produce
// a parser-valid SMILES string directly from the prompt. This loops
// ConstrainedStep until the parser reports a complete prefix, EOS is emitted,
// or the token budget is exhausted. When maxSteps == 0, we return immediately
// with cost = 0 and unchanged state; the last postcondition is trivially
// satisfied by the disjunct `maxSteps == 0`. When maxSteps > 0, we call
// ConstrainedGeneration which produces at least 1 token-step of progress,
// so cost > 0 is guaranteed, satisfying the progress postcondition.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// Invariant 1 (parser_validity):
//   insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   We never enter constrained span mode in this strategy (insideConstrainedOut
//   is always false on exit, matching the initial value of insideConstrained
//   which is false since we don't modify it). Actually we leave
//   insideConstrainedOut := insideConstrained and currentConstrainedOut :=
//   currentConstrained, both of which satisfy the precondition invariant by
//   hypothesis. No loop is used, so there is no loop invariant to maintain.
//
// Invariant 2 (progress / length bound):
//   |generated| <= |generatedPrefix| + maxSteps
//   ConstrainedGeneration returns at most maxSteps tokens (by its contract),
//   so |constrainedGenerated| <= maxSteps. Therefore
//   |generated| = |generatedPrefix| + |constrainedGenerated| <= |generatedPrefix| + maxSteps.
//   When maxSteps == 0, generated := generatedPrefix so the bound holds trivially.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

if maxSteps == 0 {
  // Nothing to do; all postconditions satisfied trivially (maxSteps == 0 branch).
} else {
  // Use ConstrainedGeneration to produce a parser-valid SMILES string directly.
  // This loops ConstrainedStep until IsCompletePrefix, EOS, or budget exhausted.
  var constrainedGenerated, terminatedByEos := helpers.ConstrainedGeneration(
    lm, parser, prompt, maxSteps, eosToken
  );
  // Append the constrained tokens to our generated output.
  generated := generatedPrefix + constrainedGenerated;
  // insideConstrainedOut and currentConstrainedOut stay as they were (not entering span mode).
  // Cost is the number of tokens generated; ConstrainedGeneration costs |constrainedGenerated|
  // plus one extra step when terminated by EOS.
  var newLen := |constrainedGenerated|;
  if terminatedByEos {
    cost := newLen + 1;
    if cost > maxSteps {
      cost := maxSteps;
    }
  } else {
    cost := newLen;
    if cost > maxSteps {
      cost := maxSteps;
    }
  }
  // Guarantee cost > 0 when maxSteps > 0 (ConstrainedGeneration consumes at least 1 step).
  if cost == 0 {
    cost := 1;
  }
}

