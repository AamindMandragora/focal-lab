Strategy: // CSD_RATIONALE_BEGIN
// Root cause: The parser for SMILES isocyanates accepts "O" as a complete
// prefix (valid single-atom SMILES), so CloseSpanIfComplete fires after just
// one token "O", producing <<O>> which is syntactically valid SMILES but not
// an isocyanate.
//
// Fix: We must NOT open the constrained span until after some unconstrained
// free-text preamble has been generated. Instead:
// 1. AppendTaskGuidance with strong isocyanate-oriented guidance.
// 2. Run unconstrained steps until we naturally see "<<", or until we've
//    spent enough unconstrained budget to prime the model properly.
//    Cap unconstrained budget at (maxSteps - 3) to leave room for constrained
//    phase + close.
// 3. But since the model may never emit "<<" spontaneously, after a fixed
//    number of free steps we manually call OpenConstrainedSpan.
// 4. Then constrained loop: use AdaptiveConstrainedStep which hard-masks to
//    parser-valid tokens. We add a minimum-length guard: if the constrained
//    prefix is too short (< 5 tokens, which can't encode N=C=O), we skip
//    CloseSpanIfComplete. This prevents premature closure on single atoms.
// 5. When complete AND long enough, close the span.
// 6. If EOS, rollback to complete and close.
//
// The tiny-span problem was that "O" is immediately a complete SMILES.
// The minimum-length guard ensures we keep generating until we have something
// that could encode an isocyanate (N=C=O needs at minimum 5 characters/tokens).
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Unconstrained phase: insideConstrainedOut stays false (implication vacuous)
//      unless UnconstrainedStep returns "<<", in which case EnterObservedConstrainedSpan
//      sets currentConstrainedOut := [] which satisfies IsValidPrefix([]).
//      Or OpenConstrainedSpan sets currentConstrainedOut := [].
//   2. Constrained phase - CloseSpanIfComplete: when closed=true, sets
//      insideConstrainedOut=false making implication vacuous; when closed=false,
//      leaves state unchanged.
//   3. Constrained phase - AdaptiveConstrainedStep: returns EOS or a parser-valid
//      next token. AppendConstrainedToken preserves IsValidPrefix by the helper's contract.
//   4. EOS path: RollbackConstrainedToComplete ensures currentConstrainedOut is
//      IsCompletePrefix or []; both satisfy IsValidPrefix. CloseConstrainedSpan
//      requires IsCompletePrefix and clears to false/[].
//
// progress (|generated| <= |generatedPrefix| + steps):
//   - Every iteration of either loop increments steps by exactly 1.
//   - UnconstrainedStep appends at most 1 token (+1) and steps+1.
//   - OpenConstrainedSpan appends "<<" (+1) and steps+1.
//   - CloseSpanIfComplete: no-op path appends 0, close path appends ">>" (+1);
//     steps+1 in both cases, so bound holds.
//   - AdaptiveConstrainedStep (not EOS) + AppendConstrainedToken: steps+1,
//     |generated|+1. Bound holds.
//   - EOS path: RollbackConstrainedToComplete does not append (only removes or
//     leaves). CloseConstrainedSpan appends ">>" (+1) and steps+1. Bound holds.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "You are generating SMILES strings for isocyanate compounds. Isocyanates contain the -N=C=O functional group. A valid isocyanate SMILES must include the fragment N=C=O somewhere in the structure. Examples: O=C=NC, O=C=NCCN=C=O, O=C=Nc1ccccc1, CCN=C=O, O=C=NCCl. Generate a new valid isocyanate SMILES that is not one of the examples. The SMILES should be at least 5 characters long. Output only the SMILES string.");

var steps: nat := 0;

// Phase 1: Unconstrained generation to prime the model context.
// We allow up to 10 unconstrained steps before forcing open the span,
// but if we see "<<" we enter constrained mode immediately.
var unconstrainedBudget: nat := 10;
var unconstrainedSteps: nat := 0;

while steps < maxSteps && unconstrainedSteps < unconstrainedBudget && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  unconstrainedSteps := unconstrainedSteps + 1;
  if next == eosToken {
    break;
  } else if next == "<<" {
    generated := generated + [next];
    var eg, ei, ec := helpers.EnterObservedConstrainedSpan(lm, generated);
    generated := eg;
    insideConstrainedOut := ei;
    currentConstrainedOut := ec;
  } else {
    generated := generated + [next];
  }
}

// If we didn't enter constrained mode yet, force open a span.
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Minimum length before allowing close (to prevent premature <<O>> closure).
// An isocyanate SMILES needs at least: e.g. "CCN=C=O" = 7 tokens in the worst
// case of 1-char tokens. We set minConstrainedLen = 6 tokens.
var minConstrainedLen: nat := 6;
var narrowThreshold: nat := 12;

// Phase 2: Constrained generation loop.
while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  }

  // Only allow closing if we have enough tokens to encode an isocyanate.
  if |currentConstrainedOut| >= minConstrainedLen {
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      break;
    }
    // Not closed, need to keep generating. Check budget.
    if steps >= maxSteps {
      break;
    }
  }

  // Generate one constrained token.
  var stableLen: nat := |generated| - |currentConstrainedOut|;
  var constrainedPrompt := prompt + generated[..stableLen];

  var next := helpers.AdaptiveConstrainedStep(
    lm, parser, constrainedPrompt, currentConstrainedOut,
    validTokenGroups, 5.0, narrowThreshold, eosToken
  );
  steps := steps + 1;

  if next == eosToken {
    // Rollback to best complete prefix and close if sufficient length.
    var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
    generated := rg;
    currentConstrainedOut := rc;
    if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
      var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg2;
      insideConstrainedOut := ci2;
      currentConstrainedOut := cc2;
      steps := steps + 1;
    }
    break;
  } else {
    var ag, ai, ac := helpers.AppendConstrainedToken(
      lm, parser, generated, currentConstrainedOut, next
    );
    generated := ag;
    insideConstrainedOut := ai;
    currentConstrainedOut := ac;
  }
}

cost := steps;

