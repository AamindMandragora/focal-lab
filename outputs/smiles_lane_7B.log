    }
    // If length is insufficient, just exit (the span stays open; 
    // later evaluation may handle this as syntax-invalid which is acceptable
    // since we need to avoid the tiny-span problem).
    break;
  } else {
    // Append the token to the constrained span.
    var ag, ai, ac := helpers.AppendConstrainedToken(
      lm, parser, generated, currentConstrainedOut, next
