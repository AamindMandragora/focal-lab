    // Rollback to best complete prefix and close.
    var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
    generated := rg;
    currentConstrainedOut := rc;
    if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
      var cg4, ci4, cc4 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg4;
      insideConstrainedOut := ci4;
      currentConstrainedOut := cc4;
      steps := steps + 1;
    } else if !parser.IsCompletePrefix(currentConstrainedOut) {
      // currentConstrainedOut is [] or non-complete; just exit
      insideConstrainedOut := false;
      currentConstrainedOut := [];
    }
    break;
  } else {
    // Only append if parser is not yet complete (AppendConstrainedToken precondition).
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if !isComplete {
      var isValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
      if isValid {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    } else {
      // Parser is complete; close the span instead of appending.
      var cg5, ci5, cc5 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg5;
      insideConstrainedOut := ci5;
      currentConstrainedOut := cc5;
      // steps was already incremented for AdaptiveConstrainedStep
      break;
    }
  }
}

