Strategy: // CSD_RATIONALE_BEGIN
// The core issue: AppendConstrainedToken requires !parser.IsCompletePrefix(currentConstrained).
// We cannot call AppendConstrainedToken when the parser already considers the prefix complete.
// 
// Solution: Before calling AppendConstrainedToken, we must verify !IsCompletePrefix.
// If IsCompletePrefix is true, we close the span regardless of length.
// If IsCompletePrefix is false, we can safely append.
//
// The length-gating approach is wrong because we can't force appending when IsCompletePrefix is true.
// The evaluator behavior shows only 1 token "C" being generated, which suggests the SMILES parser
// accepts single atoms as complete. We must close when complete, even if short.
//
// To get a longer SMILES:
// 1. Use strong guidance to bias toward longer acrylate SMILES.
// 2. Use AdaptiveConstrainedStep which applies group boosts.
// 3. Only close when IsCompletePrefix is true (required by CloseConstrainedSpan).
// 4. Only append when !IsCompletePrefix (required by AppendConstrainedToken).
// 5. If IsCompletePrefix and validCount > 0, we cannot extend - must close.
//
// This is a fundamental parser constraint. The guidance is our primary lever for longer output.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan sets currentConstrainedOut := [], valid by precondition.
//   2. In the append branch, we only reach AppendConstrainedToken when !isComplete
//      (checked by if-else structure). AppendConstrainedToken preserves IsValidPrefix.
//   3. In the close branch, isComplete is true (explicitly checked before calling
//      CloseConstrainedSpan which requires IsCompletePrefix). After close,
//      insideConstrainedOut := false, making the implication vacuous.
//   4. EOS break: if not complete, insideConstrainedOut remains true but
//      parser.IsValidPrefix(currentConstrainedOut) was maintained by the invariant.
//
// progress: |generated| <= |generatedPrefix| + steps
//   1. OpenConstrainedSpan: +1 step, +1 token to generated. Invariant maintained.
//   2. Close branch: CloseConstrainedSpan +1 step, +1 token (">>"). Invariant maintained.
//   3. Append branch: AdaptiveConstrainedStep +1 step, AppendConstrainedToken +1 token.
//      steps grows by 1, |generated| grows by at most 1. Invariant maintained.
//   4. EOS: +1 step (from AdaptiveConstrainedStep), no token appended. Invariant maintained.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Generate a SMILES string for a novel acrylate ester molecule. The SMILES must contain the acrylate core. Target longer structures like: C=CC(=O)OCC, C=CC(=O)OCCO, C=CC(=O)OC(C)C, C=CC(=O)OCCCC, C=CC(=O)OCC(C)C, CCOC(=O)C=C. Output ONLY the SMILES string with no spaces or explanation.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;

// Enter constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      // Must close - cannot extend when IsCompletePrefix is true
      if steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      // !isComplete: safe to call AdaptiveConstrainedStep and AppendConstrainedToken
      var stableLen := |generated| - |currentConstrainedOut|;
      var constrainedPrompt := prompt + generated[..stableLen];

      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut,
        validTokenGroups, 5.0, 16, eosToken
      );
      steps := steps + 1;

      if next == eosToken {
        // EOS while not complete: check if we can close anyway
        // (IsCompletePrefix might have changed; re-check not needed since isComplete was false)
        break;
      } else {
        // isComplete was false, so !parser.IsCompletePrefix(currentConstrainedOut)
        // is required for AppendConstrainedToken
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

