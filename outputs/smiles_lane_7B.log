Strategy: // CSD_RATIONALE_BEGIN
// Root cause analysis from diagnostics:
// - "entered_constrained_mode_too_early": 50/50 examples
// - "tiny_span_dominant": 100% - the span contains only 1 token ("O")
// - Generated tokens/example: avg 3.00 (OpenConstrainedSpan="<<", one constrained token, CloseConstrainedSpan=">>")
// - The parser accepts "O" as a complete prefix immediately (water molecule), so CloseSpanIfComplete
//   fires after just 1 constrained token.
//
// The SMILES parser for isocyanates starts with many valid first tokens.
// "O" is immediately a complete SMILES prefix (water), so the span closes at "O".
// We need to generate a longer, proper isocyanate SMILES like "CCN=C=O" or "O=C=NCC".
//
// Fix strategy:
// 1. Use ConstrainedGeneration which internally loops until parser completeness, EOS, or budget.
//    This handles the full generation in one call, running until a "real" complete parse.
//    BUT: ConstrainedGeneration starts from empty prefix and runs to completion naturally -
//    it may still stop at "O". We need to guide it.
//
// 2. Better approach: Use AdaptiveConstrainedStep with strong guidance to steer away from
//    trivial completions. After each token, check if complete - but only close after
//    a MINIMUM number of tokens (e.g., 4+ tokens to ensure a real isocyanate like N=C=O).
//    BUT AppendConstrainedToken requires !IsCompletePrefix - so we can't append to a complete prefix.
//
// 3. Key insight: We need to force the model to generate at least a minimal isocyanate
//    pattern BEFORE the parser can close. The isocyanate class requires N=C=O.
//    "O" alone is not an isocyanate - but the SMILES parser may accept it as syntactically valid.
//    The evaluator checks class membership (isocyanate = contains N=C=O or O=C=N).
//
// 4. Solution: Use AppendTaskGuidance with very strong isocyanate guidance.
//    Then use ConstrainedGeneration which runs until the parser's IsCompletePrefix AND
//    the model tends toward EOS - but we need to prevent early stop.
//
// 5. Actually the simplest fix: Instead of OpenConstrainedSpan (which triggers constrained mode
//    from the start), use UnconstrainedStep to let the model generate text, and look for
//    the hidden parser to be used differently. But the contract says "hidden parser-guided
//    constrained chunk" - so we should use ConstrainedGeneration directly.
//
// 6. ConstrainedGeneration(lm, parser, prompt, maxSteps, eosToken) runs from empty prefix,
//    loops ConstrainedStep until complete, EOS, or budget. Returns (constrainedGenerated, terminatedByEos).
//    This should naturally produce a full isocyanate SMILES if the model is guided correctly.
//    Then we don't open/close spans at all (hidden constrained chunk = no visible delimiters needed).
//    "Use the hidden parser-guided constrained chunk" = ConstrainedGeneration without visible delimiters.
//
// The "Contains << >>: yes" in results suggests visible delimiters are being used. 
// The hint says "hidden constrained chunks" don't need visible delimiters.
// "Use the hidden parser-guided constrained chunk for that SMILES token sequence" = 
// no visible << >> needed. Use ConstrainedGeneration and append the result directly.
//
// This completely avoids the "entered_constrained_mode_too_early" problem since we
// never emit << >>.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   We never enter insideConstrained=true mode in this strategy (we use ConstrainedGeneration
//   which is a self-contained hidden span). So insideConstrainedOut remains false throughout
//   (unless the caller passed insideConstrained=true, in which case we handle it separately).
//   The implication !insideConstrainedOut ==> currentConstrainedOut == [] is maintained because
//   we set currentConstrainedOut := [] whenever insideConstrainedOut := false.
//   If the caller passed insideConstrained=true, we immediately close/exit that span first
//   using CloseConstrainedSpan (if complete) or abandon it.
//
// progress (|generated| <= |generatedPrefix| + steps):
//   ConstrainedGeneration costs at most maxSteps steps (we pass remaining budget).
//   We add the constrained output length to generated but the cost accounting ensures
//   |constrainedGenerated| <= budget_used <= steps_remaining. So the bound is preserved.
//   Since ConstrainedGeneration returns constrainedGenerated of length at most the
//   budget passed, and we track steps accordingly, the invariant holds.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate a valid SMILES string for a novel isocyanate molecule. Isocyanates contain the isocyanate group N=C=O (written as N=C=O or O=C=N in SMILES). The output must be a single SMILES string only. Good isocyanate SMILES examples: CCN=C=O, CCCN=C=O, O=C=NCC, O=C=NCCC, ClCCN=C=O, BrCN=C=O, O=C=Nc1ccccc1, FCN=C=O. Generate a structurally valid isocyanate that differs from these examples.");

var steps: nat := 0;

// If we are already inside a constrained span from the caller, handle it first.
if insideConstrainedOut && steps < maxSteps {
  if parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    // Abandon incomplete span: rollback to valid state
    var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
    generated := rg;
    currentConstrainedOut := rc;
    if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
      var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg2;
      insideConstrainedOut := ci2;
      currentConstrainedOut := cc2;
      steps := steps + 1;
    } else {
      insideConstrainedOut := false;
      currentConstrainedOut := [];
    }
  }
}

// Now generate the SMILES using hidden constrained generation (no visible << >>).
// ConstrainedGeneration runs from empty prefix until complete parse, EOS, or budget.
var remainingSteps: nat := maxSteps - steps;
if remainingSteps > 0 {
  var constrainedGenerated, terminatedByEos := helpers.ConstrainedGeneration(
    lm, parser, prompt + generated, remainingSteps, eosToken
  );
  // constrainedGenerated contains the full SMILES token sequence.
  // Cost is at most remainingSteps.
  var genCost: nat := if |constrainedGenerated| < remainingSteps then |constrainedGenerated| + (if terminatedByEos then 1 else 0) else remainingSteps;
  // Be conservative: charge all remaining steps to be safe for the proof.
  // Actually we need steps <= maxSteps. We know genCost <= remainingSteps = maxSteps - steps.
  // So steps + genCost <= maxSteps. 
  // For the output length bound: |constrainedGenerated| <= genCost <= remainingSteps.
  generated := generated + constrainedGenerated;
  steps := steps + genCost;
}

cost := steps;

