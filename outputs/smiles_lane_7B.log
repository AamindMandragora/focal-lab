Strategy: // CSD_RATIONALE_BEGIN
// DIAGNOSIS: The "tiny_span_dominant" failure (span length avg 1.00) and 
// "entered_constrained_mode_too_early" errors indicate the constrained span 
// opens immediately (generating "<<C>>") — the LM picks a single complete-prefix 
// token ("C") at step 1, IsCompletePrefix fires, and we close immediately.
//
// ROOT CAUSE: The SMILES parser accepts single atoms like "C" as complete prefixes.
// So the very first token ("C") triggers IsCompletePrefix=true and closes the span.
//
// FIX STRATEGY:
// 1. Do NOT check IsCompletePrefix until we have at least a minimum number of tokens
//    (e.g., minLength = 12 tokens for a reasonable acrylate SMILES).
// 2. Use AppendTaskGuidance to nudge the LM toward complex acrylate structures.
// 3. Use AdaptiveConstrainedStepWithPenalties to penalize short/simple atoms at 
//    the start and boost toward acrylate-specific patterns.
// 4. After minLength tokens, check IsCompletePrefix each step.
// 5. If EOS arrives before minLength, do RollbackAndContinue to try to extend.
// 6. After maxSteps budget is near exhaustion, use RollbackConstrainedToComplete 
//    and close.
//
// The key insight: delay CloseConstrainedSpan until |currentConstrainedOut| >= minLength.
// This prevents the span from collapsing to a single atom.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - OpenConstrainedSpan: sets currentConstrainedOut := [], IsValidPrefix([]) by precondition.
//   - AppendConstrainedToken: we check IsTokenValidNext before calling, so
//     parser.IsValidPrefix(currentConstrainedOut + [next]) holds by definition of IsTokenValidNext.
//   - CloseConstrainedSpan: sets insideConstrainedOut := false, making implication vacuous.
//   - RollbackConstrainedToComplete: returns a prefix that IsCompletePrefix (hence IsValidPrefix)
//     or empty (also IsValidPrefix by precondition). Preserves invariant.
//   - EOS path without close: insideConstrainedOut remains true but currentConstrainedOut
//     is unchanged (still valid from previous iteration). Preserved.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - OpenConstrainedSpan: steps += 1, |generated| += 1 (the "<<" token). Maintained.
//   - AdaptiveConstrainedStepWithPenalties/AdaptiveConstrainedStep: steps += 1 each call.
//     AppendConstrainedToken: |generated| += 1 at most. So per iteration steps += 1,
//     |generated| grows by at most 1. Maintained.
//   - CloseConstrainedSpan: steps += 1, |generated| += at most 1 (">>"). Maintained.
//   - RollbackConstrainedToComplete: +0 cost, |generated| may shrink or stay. Maintained.
//   - EOS break: no change, maintained.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var guidance: string := "Task: output a SMILES string for an acrylate molecule. Acrylates contain the substructure C=CC(=O)O (vinyl ester). Valid acrylate SMILES examples: C=CC(=O)OCC, C=CC(=O)OCCC, C=CC(=O)OC(C)C, C=C(C)C(=O)OCC, C=CC(=O)OCCCC, C=CC(=O)OCC(C)C. The answer must be a SMILES string of at least 10 atoms. Do NOT output a single carbon atom. Do NOT copy examples exactly.";
helpers.AppendTaskGuidance(lm, guidance);

var steps: nat := 0;
var minLength: nat := 10;

// Boost tokens characteristic of acrylate SMILES
var acrylateCore: seq<Token> := ["C", "=", "(", ")", "O", "c", "n", "N"];
var vinylGroup: seq<Token> := ["=", "C", "(", "C"];
var esterGroup: seq<Token> := ["(", "=", "O", ")", "O"];
var chainGroup: seq<Token> := ["C", "C", "C", "C", "C", "O", "N"];
var acrylateGroups: seq<seq<Token>> := [acrylateCore, vinylGroup, esterGroup, chainGroup];
var combined: seq<seq<Token>> := validTokenGroups + acrylateGroups;

// Penalty tokens to avoid at start (single-completion atoms)
var avoidShort: seq<Token> := ["N", "O", "S", "F", "B", "P", "I"];

// Open constrained span immediately
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    break;
  }

  // Only allow closing if we have enough tokens
  var curLen := |currentConstrainedOut|;
  var isComplete := parser.IsCompletePrefix(currentConstrainedOut);

  if isComplete && curLen >= minLength {
    // Close the constrained span
    if steps < maxSteps {
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
    }
    break;
  }

  // Check if we're running out of budget - need at least 2 steps (generate + close)
  if steps + 2 >= maxSteps {
    // Try to rollback to complete and close
    var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
    generated := rg;
    currentConstrainedOut := rc;
    var rComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if rComplete && steps < maxSteps {
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
    }
    break;
  }

  // Generate next constrained token
  var stableLen := |generated| - |currentConstrainedOut|;
  var constrainedPrompt := prompt + generated[..stableLen];

  var next: Token;

  if curLen == 0 {
    // First token: strongly penalize short-completion atoms, boost toward "C" + vinyl
    next := helpers.AdaptiveConstrainedStepWithPenalties(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      combined + [["C", "="]], 12.0, avoidShort, 8.0, 200, eosToken
    );
  } else if curLen < 4 {
    // Early tokens: boost acrylate-characteristic tokens
    next := helpers.AdaptiveConstrainedStepWithPenalties(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      combined, 8.0, avoidShort, 4.0, 100, eosToken
    );
  } else if curLen < minLength {
    // Mid tokens: use adaptive step with moderate boost
    next := helpers.AdaptiveConstrainedStep(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      combined, 6.0, 50, eosToken
    );
  } else {
    // Enough tokens: use repetition penalty to encourage varied structure
    next := helpers.SafeRepetitionPenaltyStep(
      lm, parser, constrainedPrompt, currentConstrainedOut,
      generated, 2.0, eosToken
    );
  }

  steps := steps + 1;

  if next == eosToken {
    // EOS arrived: if we have enough and it's complete, close; else rollback and close
    var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
    generated := rg;
    currentConstrainedOut := rc;
    var rComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if rComplete && steps < maxSteps {
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
    }
    break;
  } else {
    // Check preconditions for AppendConstrainedToken
    var curComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if curComplete && curLen >= minLength {
      // Already complete with enough length: close instead of appending
      if steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else if !curComplete {
      // Not complete: append the token
      var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
      if valid {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
      // If not valid: skip (shouldn't happen with constrained step)
    } else {
      // Complete but not enough length yet: append the token to extend
      var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
      if valid {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Final cleanup: if still inside constrained span, rollback to complete and close
if insideConstrainedOut && steps < maxSteps {
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
  var rComplete := parser.IsCompletePrefix(currentConstrainedOut);
  if rComplete && steps < maxSteps {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  }
}

cost := steps;

