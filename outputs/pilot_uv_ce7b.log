Helper policy: helper mask warm-up (0/3 evaluated attempts for bandit)
Strategy: // CSD_RATIONALE_BEGIN
// SMILES chain-extender CSD. The strategy generates a single valid SMILES
// string for the chain_extenders class using a fully constrained hidden chunk.
// State tracked: steps (budget), insideConstrainedOut (span state),
// currentConstrainedOut (constrained prefix for parser). The strategy opens
// a constrained span immediately (no free-text preamble needed since the
// output contract is just a SMILES string), then uses AdaptiveConstrainedStep
// with group boosting to generate the SMILES token sequence. Repetition
// penalties discourage copying exemplars. Once the parser accepts a complete
// prefix, we close the span and stop.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan sets insideConstrainedOut := true and
//      currentConstrainedOut := [], which satisfies parser.IsValidPrefix([])
//      by the method precondition.
//   2. In the constrained generation loop, AdaptiveConstrainedStep and
//      SafeRepetitionPenaltyStep return either EOS or a parser-valid next token.
//      AppendConstrainedToken extends currentConstrainedOut by that token,
//      preserving parser.IsValidPrefix(currentConstrainedOut).
//   3. CloseConstrainedSpan sets insideConstrainedOut := false, making the
//      implication vacuous and clearing currentConstrainedOut to [].
// progress:
//   1. OpenConstrainedSpan costs 1 step and appends 1 visible token ("<<"),
//      so |generated| = |generatedPrefix| + 1 = |generatedPrefix| + steps.
//   2. Each iteration of the while loop increments steps by 1.
//      - In the constrained branch, AppendConstrainedToken appends at most 1
//        visible token, so |generated| <= |generatedPrefix| + steps.
//      - EOS breaks out immediately without appending, preserving the bound.
//      - CloseConstrainedSpan appends ">>" (1 token) and costs 1 step,
//        preserving the bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Append guidance to steer toward chain extender SMILES
helpers.AppendTaskGuidance(lm, "Generate exactly one valid SMILES string for a chain extender molecule. Output only the SMILES string, nothing else. Chain extenders are typically small difunctional molecules like diols or diamines used in polyurethane synthesis.");

// Open the constrained span immediately (the entire output is the SMILES string)
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      // Close the span and finish
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
      break;
    } else {
      // Use the stable prompt prefix for constrained generation
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var next := eosToken;
      if validCount <= 15 {
        // Narrow state: use group boosting for guidance
        next := helpers.GroupBoostedConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 5.0, eosToken
        );
      } else {
        // Wider state: use repetition penalty to avoid copying exemplars
        next := helpers.SafeRepetitionPenaltyStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
        );
      }
      steps := steps + 1;
      if next == eosToken {
        // EOS inside constrained span: try to close if complete, otherwise just stop
        if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
          var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
          steps := steps + 1;
        }
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  } else {
    // Not inside constrained span: should not happen after OpenConstrainedSpan,
    // but handle gracefully with unconstrained step
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
    }
  }
}

cost := steps;

