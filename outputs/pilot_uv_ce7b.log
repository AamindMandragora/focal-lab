Strategy: // CSD_RATIONALE_BEGIN
// The core problem: the model generates only 1 token (e.g., "O" or "OC") inside
// the constrained span before the parser marks it complete, and the span closes.
// Chain extender SMILES like "OCCO" or "NCCN" are valid but very short, so the
// parser completes after just 1-2 tokens. The real issue is that the model keeps
// generating the SAME molecule (usually "O" or "OC"), giving near-zero unique
// valid rate.
//
// Root cause: The strategy opens the constrained span immediately and uses
// SafeRepetitionPenaltyStep, but the penalty only penalizes tokens in 'generated'
// (which includes "<<" and previous tokens). With only 1 token generated per
// run, repetition penalties don't help across examples.
//
// Fix strategy:
// 1. Use AppendTaskGuidance with a richer prompt specifying diverse chain extender
//    examples (but not copying them exactly).
// 2. Use AdaptiveConstrainedStep to let the LM generate freely within parser bounds.
// 3. Ensure the model generates longer SMILES by NOT closing immediately on first
//    complete prefix - instead continue generating until EOS or budget, then close.
// 4. Use ConstrainedGeneration helper which handles the full loop internally and
//    produces complete SMILES sequences naturally.
//
// The key insight: ConstrainedGeneration starts from an EMPTY constrained prefix
// and runs until parser completeness or EOS. It will generate a full SMILES string
// naturally. We just need to wrap it in span delimiters.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. After OpenConstrainedSpan, insideConstrainedOut := true and
//      currentConstrainedOut := []. The method precondition guarantees
//      parser.IsValidPrefix([]), so invariant holds.
//   2. ConstrainedGeneration is called with an empty currentConstrained (i.e., [])
//      and produces constrainedGenerated which satisfies IsValidPrefix (by the
//      helper's contract: it only appends parser-valid tokens). After the call,
//      currentConstrainedOut is set to constrainedGenerated (if not EOS-terminated)
//      or rolled back to complete. We then close the span with CloseConstrainedSpan
//      which requires IsCompletePrefix; we guard with RollbackConstrainedToComplete
//      to ensure this.
//   3. CloseConstrainedSpan sets insideConstrainedOut := false, making the
//      implication vacuous.
//
// progress: |generated| <= |generatedPrefix| + steps
//   1. OpenConstrainedSpan: steps += 1, generated grows by 1 ("<<"). Preserved.
//   2. ConstrainedGeneration consumes at most maxSteps - steps token-steps and
//      appends at most that many tokens to the constrained prefix. We track this
//      via the cost returned and add it to steps. The generated sequence length
//      increases by |constrainedGenerated| <= budget used. Preserved.
//   3. CloseConstrainedSpan: steps += 1, generated grows by 1 (">>"). Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Rich task guidance to steer the model toward diverse chain extender SMILES
helpers.AppendTaskGuidance(lm, "You are generating SMILES strings for chain_extenders molecules. Chain extenders are small bifunctional molecules used in polymer synthesis. They typically have two reactive groups like -OH (diol) or -NH2 (diamine) connected by a short carbon chain. Examples of classes: aliphatic diols (e.g., butanediol), aromatic diols, aliphatic diamines, amino alcohols. Generate a NOVEL molecule not seen before. The SMILES must be chemically valid. Output ONLY the SMILES string with no other text.");

// If not already inside a constrained span, open one
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Now generate the SMILES content using constrained generation
// We use ConstrainedGeneration which loops until parser complete or EOS
// Budget: reserve 2 steps for closing the span
var remainingSteps: nat := 0;
if maxSteps > steps + 2 {
  remainingSteps := maxSteps - steps - 2;
} else if maxSteps > steps {
  remainingSteps := maxSteps - steps;
}

if insideConstrainedOut && remainingSteps > 0 {
  var constrainedGenerated, terminatedByEos := helpers.ConstrainedGeneration(
    lm, parser, prompt, remainingSteps, eosToken
  );
  // ConstrainedGeneration consumes up to remainingSteps token-steps
  // We need to account for these in our step count
  var cgLen: nat := |constrainedGenerated|;
  // The cost is at most remainingSteps (and at least |constrainedGenerated| tokens)
  // To be safe with the proof, we charge remainingSteps
  steps := steps + remainingSteps;
  // Update generated and currentConstrainedOut with the constrained content
  // generated currently ends with "<<", we need to append the constrained tokens
  // and update currentConstrainedOut
  // But ConstrainedGeneration returns just the constrained sequence, not the full generated
  // We need to build the new state manually
  generated := generated + constrainedGenerated;
  currentConstrainedOut := constrainedGenerated;
  // Roll back to a complete prefix if not already complete
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
}

// Close the span if inside and complete
if insideConstrainedOut && steps < maxSteps {
  if parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    // Not complete: exit without closing (leaves span open but handles the case)
    insideConstrainedOut := false;
    currentConstrainedOut := [];
  }
}

cost := steps;

