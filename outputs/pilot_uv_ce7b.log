// The key diagnostic insight: "entered_constrained_mode_too_early" and 
// "tiny_span_dominant" with avg span length 1.0 token. The model generates
// only 1 token inside the constrained span (e.g., "O", "OC"), then closes.
// This means IsCompletePrefix fires too quickly after just 1 atom token.
// 
// Root cause: The SMILES parser treats single atoms like "O", "C", "N" as
// complete valid SMILES, so IsCompletePrefix returns true after just one token,
// causing premature closure. We need to generate longer molecules before closing.
//
// Fix strategy: Use a minimum token count before allowing closure. Generate at
// least 8-15 tokens inside the span before checking IsCompletePrefix. This
// forces the model to produce a more complex (multi-atom) chain extender.
// 
// Also, "unique_valid_rate" shows only 1/50 unique molecules - all 38 correct
// ones are duplicates. Need more diversity: use SafeRepetitionPenaltyStep 
// throughout to discourage repeating common atoms, and append guidance that
// specifically requests diverse, novel molecules.
//
// Chain extenders are typically: ethylene glycol (OCCO), 1,4-butanediol
// (OCCCCO), hexanediol (OCCCCCCO), diaminoethane (NCCN), etc.
// They need at least 4-6 heavy atoms to be useful.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan sets insideConstrainedOut := true and
//      currentConstrainedOut := [], which satisfies parser.IsValidPrefix([])
//      by precondition.
//   2. In the constrained loop, SafeRepetitionPenaltyStep and
//      GroupBoostedConstrainedStep return EOS or a parser-valid next token.
//      AppendConstrainedToken extends currentConstrainedOut preserving validity.
//   3. CloseConstrainedSpan sets insideConstrainedOut := false (vacuous).
//      RollbackConstrainedToComplete produces a complete-or-empty prefix,
//      both satisfying IsValidPrefix.
//
// progress: |generated| <= |generatedPrefix| + steps
//   1. OpenConstrainedSpan: steps += 1, generated grows by 1. Preserved.
//   2. Each constrained step: steps += 1, AppendConstrainedToken adds at most
//      1 visible token. EOS path breaks without appending. Preserved.
//   3. CloseConstrainedSpan: steps += 1, generated grows by 1. Preserved.
//   4. RollbackConstrainedToComplete: steps unchanged, generated shrinks/same. Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

helpers.AppendTaskGuidance(lm, "Generate a novel valid SMILES string for a chain_extender molecule. Chain extenders are small bifunctional molecules (MW 60-500 Da) with two reactive end groups such as -OH, -NH2, or -COOH. Examples of structural patterns: diols like OCCO, OCCCCO, OCCCCCCO; diamines like NCCN, NCCCN; amino alcohols like NCCO; dicarboxylic acids like OC(=O)CCCC(=O)O. Generate a NEW molecule not from the examples. The SMILES must represent a real molecule with at least 4 heavy atoms and exactly two functional end groups. Output only the SMILES string.");

// Open the constrained span immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Minimum tokens before we allow closure - force longer molecules
var minTokensBeforeClose: nat := 8;
var tokensGenerated: nat := 0;

while steps < maxSteps
