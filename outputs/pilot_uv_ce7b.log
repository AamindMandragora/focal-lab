Strategy: // CSD_RATIONALE_BEGIN
// Strategy: Generate a valid SMILES string using constrained decoding.
// If not currently inside a constrained span, use ConstrainedGeneration to
// produce the full SMILES token sequence hidden (no visible << >> delimiters).
// If already inside a constrained span, continue stepping token by token until
// complete, EOS, or budget exhausted. On completion, close the span.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// Invariant 1 (parser_validity):
//   - Outside-span branch: ConstrainedGeneration returns a parser-valid sequence,
//     but we only track generated (not currentConstrainedOut), and insideConstrainedOut
//     stays false, so currentConstrainedOut == [] is maintained trivially.
//   - Inside-span branch: AppendConstrainedToken only appends parser-valid tokens
//     (next was chosen by SafeRepetitionPenaltyStep which hard-masks to valid tokens),
//     so parser.IsValidPrefix(currentConstrainedOut) is preserved each iteration.
//     CloseConstrainedSpan sets insideConstrainedOut=false and currentConstrainedOut=[],
//     satisfying the invariant upon exit.
//
// Invariant 2 (progress):
//   - Outside-span branch: ConstrainedGeneration costs at most `budget` steps.
//     We set cost = budget (conservative), and generated grows by |constrainedOut| <= budget,
//     so |generated| <= |generatedPrefix| + budget = |generatedPrefix| + maxSteps.
//   - Inside-span branch: each loop iteration increments steps by 1 (SafeRepetitionPenaltyStep)
//     and appends at most 1 visible token to generated (AppendConstrainedToken adds 1 token,
//     EOS path adds 0 visible tokens). CloseConstrainedSpan adds 1 token and costs 1 step.
//     Thus |generated| <= |generatedPrefix| + steps <= |generatedPrefix| + maxSteps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

if !insideConstrained {
  var budget := maxSteps;
  if budget > 0 {
    var constrainedOut, terminatedByEos := helpers.ConstrainedGeneration(lm, parser, prompt, budget, eosToken);
    generated := generatedPrefix + constrainedOut;
    steps := budget;
  }
  cost := steps;
} else {
  while steps < maxSteps
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant |generated| <= |generatedPrefix| + steps
    decreases maxSteps - steps
  {
    if !insideConstrainedOut {
      break;
    } else if parser.IsCompletePrefix(currentConstrainedOut) {
      if steps < maxSteps {
        var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
        generated := cg;
        insideConstrainedOut := ci;
        currentConstrainedOut := cc;
        steps := steps + 1;
      }
      break;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
          var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
          steps := steps + 1;
        }
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
  cost := steps;
}

