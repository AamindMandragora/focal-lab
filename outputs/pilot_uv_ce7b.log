Strategy: // CSD_RATIONALE_BEGIN
// The core failure: the model generates single-atom SMILES (e.g., "O") which
// are parser-complete immediately, so the strategy closes the span after just
// one token. This produces valid SMILES but not chain_extender class members.
//
// Root cause analysis:
// 1. "O" (water) is a complete SMILES by the parser, so we close immediately.
// 2. The constrained span opens immediately with no prior unconstrained context,
//    and the guidance is not steering strongly enough toward multi-atom SMILES.
// 3. The model has no signal to prefer "OCCO" over "O".
//
// Fix strategy:
// 1. Use ConstrainedGeneration which runs until parser completeness, EOS, or budget -
//    but this still might stop at "O". Instead, we need to prevent early closure.
// 2. Key insight: Use AdaptiveConstrainedStep in a loop, but DO NOT close when
//    IsCompletePrefix is first reached if the span is too short. Instead, continue
//    generating past the first complete prefix to get a longer molecule.
// 3. Specifically: track the length of currentConstrainedOut. If it's <= 2 tokens,
//    keep generating even if IsCompletePrefix is true (the parser may still accept
//    more tokens). Only close when we have a longer molecule or budget forces us.
// 4. Use AdaptiveConstrainedStep with high boost (8.0) and larger narrowThreshold (50)
//    to strongly guide toward multi-token SMILES.
// 5. Stronger task guidance listing actual chain extender examples.
//
// The critical change: don't close on first IsCompletePrefix if |currentConstrainedOut| < 4.
// Continue generating until we have a substantive SMILES string.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - OpenConstrainedSpan sets currentConstrainedOut := [], parser.IsValidPrefix([]) by precondition.
//   - AdaptiveConstrainedStep returns EOS or a parser-valid next token; AppendConstrainedToken
//     preserves IsValidPrefix by library contract.
//   - When we skip closing despite IsCompletePrefix (short span), we continue with
//     AdaptiveConstrainedStep which returns parser-valid tokens, preserving validity.
//   - CloseConstrainedSpan sets insideConstrainedOut := false, making implication vacuous.
//   - RollbackConstrainedToComplete returns currentOut satisfying IsCompletePrefix (hence IsValidPrefix).
//
// progress: |generated| <= |generatedPrefix| + steps
//   - OpenConstrainedSpan: steps += 1, |generated| += 1 ("<<"). Bound preserved.
//   - Each loop iteration: steps += 1. AppendConstrainedToken adds 1 visible token.
//   - CloseConstrainedSpan adds ">>" (1 token) and costs 1 step. Bound preserved.
//   - RollbackConstrainedToComplete can only decrease |generated|. Bound preserved.
//   - Progress postcondition: OpenConstrainedSpan runs when maxSteps > 0 (steps=0<maxSteps),
//     so cost >= 1 when maxSteps > 0.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Strong guidance listing chain extender examples to prime the model
helpers.AppendTaskGuidance(lm, "Generate exactly one SMILES string for a chain_extenders molecule. Chain extenders are small bifunctional molecules used in polyurethane synthesis: diols (OCCO, OCCCO, OCCCCO, OCCCCCO, OCC(O)CO) or diamines (NCCN, NCCCN, NCCCCN, NCCCCCCN, NCCO). Output ONLY the SMILES string. Do not output single atoms like O or N alone.");

// Open the constrained span immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    // Only close if we have a complete prefix AND it's long enough (>= 4 tokens)
    // to avoid single-atom SMILES like "O" or "N"
    var spanLen := |currentConstrainedOut|;
    if parser.IsCompletePrefix(currentConstrainedOut) && spanLen >= 4 {
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
      break;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      // Use high boost and wide threshold to strongly prefer multi-atom SMILES tokens
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 8.0, 100, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        // EOS: rollback to a complete prefix and close
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        if steps < maxSteps && parser.IsCompletePrefix(currentConstrainedOut) {
          var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
          steps := steps + 1;
        }
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  } else {
    // Not inside constrained span - should not happen, but handle gracefully
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
    }
  }
}

// If we exhausted budget while still inside constrained span, rollback and close
if insideConstrainedOut {
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
  if steps < maxSteps && parser.IsCompletePrefix(currentConstrainedOut) {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  }
}

cost := steps;

