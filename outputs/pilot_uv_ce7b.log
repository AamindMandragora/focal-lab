// - Only call AppendConstrainedToken when we KNOW !IsCompletePrefix.
// - Use AdaptiveConstrainedStep for all constrained steps.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - OpenConstrainedSpan sets currentConstrainedOut := []; parser.IsValidPrefix([]) by precondition.
//   - In the close branch: CloseConstrainedSpan sets insideConstrainedOut := false, making
//     the implication vacuous and clearing currentConstrainedOut.
//   - In the constrained step branch: AdaptiveConstrainedStep returns EOS or a parser-valid
//     token. We only call AppendConstrainedToken after checking !IsCompletePrefix AND
//     that next != eosToken, so the precondition is satisfied. AppendConstrainedToken
//     preserves IsValidPrefix.
//   - RollbackConstrainedToComplete returns a currentOut satisfying IsCompletePrefix
//     (hence IsValidPrefix), or empty (also IsValidPrefix by precondition).
//
// progress: |generated| <= |generatedPrefix| + steps
//   - OpenConstrainedSpan: steps += 1, |generated| += 1. Preserved.
//   - Each loop iteration: steps += 1. AppendConstrainedToken adds 1 token at most.
//   - CloseConstrainedSpan: steps += 1, |generated| += 1 (">>"). Preserved.
//   - RollbackConstrainedToComplete: only decreases |generated|. Preserved.
//   - Post-loop close: steps += 1, |generated| += 1. Steps <= maxSteps guard ensures bound.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

