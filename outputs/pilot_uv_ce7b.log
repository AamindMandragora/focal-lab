Strategy: // CSD_RATIONALE_BEGIN
// DIAGNOSTIC ANALYSIS:
// All 3 attempts share the same failure: "tiny_span_dominant" with visible span
// token length avg 1.00. The model generates only 1 token inside the constrained
// span (e.g., "O" or "OC") then the parser accepts it as complete (single atom
// is a valid SMILES) and we close. This is correct SMILES but not a valid
// chain_extender (needs at least 2 functional groups).
//
// ROOT CAUSE: The SMILES parser treats single atoms like "O" as complete prefixes.
// We close immediately on IsCompletePrefix without checking if the molecule is
// complex enough to be a real chain extender (diol/diamine with 2+ atoms).
//
// FIX STRATEGY:
// 1. Don't close on IsCompletePrefix immediately - require a minimum constrained
//    length before allowing closure (e.g., at least 4 tokens for a meaningful
//    chain extender like OCCO).
// 2. Use AppendTaskGuidance with very specific chain extender SMILES examples
//    that show multi-token structures.
// 3. Use AdaptiveConstrainedStep with strong group boosting to drive toward
//    multi-atom molecules. The validTokenGroups from the caller may contain
//    useful atoms.
// 4. Only close when both IsCompletePrefix AND |currentConstrainedOut| >= minLength.
// 5. Don't use OpenConstrainedSpan with visible delimiters - use ConstrainedGeneration
//    which uses hidden chunks (answer_source was "none" suggesting the hidden
//    extractor was looking elsewhere).
//
// KEY INSIGHT from diagnostics: "answer_source: none" means the evaluator
// couldn't extract from the visible span. The task uses "hidden_or_task_extractor"
// for extraction. We need to use ConstrainedGeneration (hidden chunk) not
// OpenConstrainedSpan (visible delimiters) OR ensure the visible span is long enough.
//
// Actually re-reading: "last_visible_span 0/50" and "hidden_or_task_extractor 0/50"
// both show 0. The answer IS being extracted (has_extracted_answer yes) but from
// the span. The span content "O" or "OC" is valid SMILES but not in-class.
// 
// The fix: generate longer SMILES. Enforce minimum length before close.
// Also use SafeRepetitionPenaltyStep early to avoid the model defaulting to "O".
// Use specific guidance with chain extender SMILES examples.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. OpenConstrainedSpan sets insideConstrainedOut := true and
//      currentConstrainedOut := [], valid by precondition parser.IsValidPrefix([]).
//   2. In the constrained generation loop, all constrained step helpers
//      (AdaptiveConstrainedStep, SafeRepetitionPenaltyStep, GroupBoostedConstrainedStep)
//      return either EOS or a hard-masked parser-valid next token.
//      AppendConstrainedToken extends currentConstrainedOut by that valid token,
//      preserving parser.IsValidPrefix(currentConstrainedOut).
//   3. CloseConstrainedSpan is only called when parser.IsCompletePrefix holds
//      (the contract requires this). It sets insideConstrainedOut := false,
//      making the implication vacuous, and clears currentConstrainedOut to [].
//
// progress:
//   1. OpenConstrainedSpan costs 1 step and appends 1 visible token ("<<"),
//      so |generated| = |generatedPrefix| + 1 = |generatedPrefix| + steps.
//   2. Each iteration of the while loop increments steps by exactly 1.
//      - AppendConstrainedToken appends 1 visible token, preserving
//        |generated| <= |generatedPrefix| + steps.
//      - EOS breaks without appending, preserving the bound.
//      - CloseConstrainedSpan appends ">>" and costs 1 step, preserving bound.
//   3. The minLength check is a pure conditional; it never increments steps
//      without also incrementing steps elsewhere.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Provide very specific guidance with chain extender SMILES examples
helpers.AppendTaskGuidance(lm, "Generate exactly one valid SMILES string for a chain extender molecule used in polyurethane synthesis. Chain extenders are small bifunctional molecules. Examples: OCCO (ethylene glycol), OCCCCO (1,4-butanediol), OCCCO (1,3-propanediol), NCCN (ethylenediamine), NCCCCN (putrescine), NCCO (ethanolamine), OCC(O)CO (glycerol), OCCO, CC(O)CO, OCCCCCCO. Output ONLY the SMILES string with no explanation. The molecule must have at least 2 functional groups (OH or NH2).");

// Open the constrained span immediately
if !insideConstrainedOut && steps < maxSteps {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Minimum token length before we allow closing (ensures non-trivial molecule)
// A single "O" is 1 token; "OCCO" is 4 tokens. We want at least 3 tokens.
var minLength: nat := 3;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    // Only close if complete AND long enough for a real chain extender
    if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength {
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
      break;
