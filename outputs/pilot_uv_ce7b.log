        );
      } else {
        // Normal state: repetition penalty to avoid exemplar copying
        next := helpers.SafeRepetitionPenaltyStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.5, eosToken
        );
      }
      steps := steps + 1;

      if next == eosToken {
        // EOS received: close if complete and long enough, otherwise just stop
        if parser.IsCompletePrefix(currentConstrainedOut) && |currentConstrainedOut| >= minLength && steps < maxSteps {
