Strategy: // CSD_RATIONALE_BEGIN
// Root cause: The strategy opens a constrained span immediately and generates
// only ~1-2 tokens before the parser accepts a complete prefix (e.g., "O" or
// "OC" are complete SMILES). The model then closes the span with a trivially
// short, non-exemplar molecule that fails the chain_extender class check.
//
// Fix: Use unconstrained generation to build context FIRST (letting the model
// "think" about what a chain extender is), then enter the constrained span
// only when ready to emit the SMILES. Additionally, use SafeRepetitionPenaltyStep
// and a high minimum-length check before accepting completeness to force the
// model to generate more complex SMILES. We require at least 8 constrained
// tokens before accepting a complete prefix. We also use stronger task guidance
// that explicitly names chain extender structures and discourages trivial outputs.
//
// The key insight is: the model needs unconstrained "thinking" tokens first to
// set context, then constrained generation for the actual SMILES. We use
// UnconstrainedStep to generate up to ~10 context tokens before opening the
// constrained span. This prevents premature constrained entry.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   1. Before OpenConstrainedSpan, insideConstrainedOut == insideConstrained
//      (false if unconstrained). The implication is vacuously true.
//   2. OpenConstrainedSpan sets insideConstrainedOut := true and
//      currentConstrainedOut := [], satisfying parser.IsValidPrefix([]).
//   3. In the constrained loop, SafeRepetitionPenaltyStep and
//      GroupBoostedConstrainedStep return EOS or parser-valid tokens.
//      AppendConstrainedToken extends currentConstrainedOut, preserving validity.
//   4. CloseConstrainedSpan sets insideConstrainedOut := false (implication vacuous).
//
// progress: |generated| <= |generatedPrefix| + steps
//   1. Unconstrained steps: steps += 1, generated grows by at most 1. Preserved.
//   2. OpenConstrainedSpan: steps += 1, generated grows by 1 ("<<"). Preserved.
//   3. Constrained generation steps: steps += 1, AppendConstrainedToken adds
//      at most 1 visible token. EOS breaks without appending. Preserved.
//   4. CloseConstrainedSpan: steps += 1, adds ">>" (1 token). Preserved.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;

// Strong guidance: name specific chain extender structures to bias toward complex molecules
helpers.AppendTaskGuidance(lm, "Task: Generate ONE valid SMILES string for a chain_extenders molecule. Chain extenders are bifunctional small molecules (MW 62-400) used in polyurethane synthesis: diols like 1,4-butanediol (OCCCCO), ethylene glycol (OCCO), diethylene glycol (OCCOCCO), neopentyl glycol (OCC(C)(C)CO), 1,6-hexanediol (OCCCCCCO), cyclohexanedimethanol, or diamines like ethylenediamine (NCCN), putrescine (NCCCCN), isophoronediamine. Generate a novel chain extender not in the examples. Output ONLY the SMILES string.");

// Phase 1: Use unconstrained generation to build context (let model think)
// We generate up to 8 unconstrained tokens to establish chain-extender context
// but stop if we naturally hit EOS or if the model seems ready
var contextSteps: nat := 0;
var maxContextSteps: nat := 5;
while steps < maxSteps && contextSteps < maxContextSteps && !insideConstrainedOut
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  contextSteps := contextSteps + 1;
  if next == eosToken {
    break;
  } else {
    generated := generated + [next];
    if next == "<<" {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
      contextSteps := maxContextSteps; // exit context loop
    }
  }
}

// Phase 2: Open constrained span if not already inside one
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

// Phase 3: Constrained SMILES generation
// Require minimum length of 8 tokens before accepting completeness
// to avoid trivial single-atom outputs
var minSpanLen: nat := 8;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
