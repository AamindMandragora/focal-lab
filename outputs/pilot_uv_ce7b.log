  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      steps := steps + 1;
      break;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(
        lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken
      );
      steps := steps + 1;

      if next == eosToken {
        // EOS hit: rollback to complete prefix if possible, then close
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        var isCompleteAfterRollback := parser.IsCompletePrefix(currentConstrainedOut);
        if isCompleteAfterRollback && steps < maxSteps {
          var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
          steps := steps + 1;
        } else {
          insideConstrainedOut := false;
          currentConstrainedOut := [];
        }
        break;
      } else {
        // Only append if the current prefix is not complete
        var notComplete := !parser.IsCompletePrefix(currentConstrainedOut);
        if notComplete {
          var ag, ai, ac := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        } else {
          // Complete prefix but got a non-EOS token: close the span
          var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg;
          insideConstrainedOut := ci;
          currentConstrainedOut := cc;
          // steps was already incremented above
          break;
        }
      }
    }
  } else {
    // Not inside span: unconstrained step (fallback)
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
    }
  }
}

// Final cleanup: if still inside span, close if possible
if insideConstrainedOut && steps < maxSteps {
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
  var isFinalComplete := parser.IsCompletePrefix(currentConstrainedOut);
  if isFinalComplete && steps < maxSteps {
    var cg, ci, cc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg;
    insideConstrainedOut := ci;
    currentConstrainedOut := cc;
    steps := steps + 1;
  } else {
    insideConstrainedOut := false;
    currentConstrainedOut := [];
  }
}

cost := steps;

