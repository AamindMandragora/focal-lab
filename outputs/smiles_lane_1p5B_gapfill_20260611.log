Strategy: // CSD_RATIONALE_BEGIN
// Strategy: For SMILES generation with a hidden constrained surface (no visible << >> delimiters),
// we use ConstrainedGeneration to produce a parser-valid SMILES string directly.
// If maxSteps == 0, we return immediately with no progress.
// Otherwise, we call ConstrainedGeneration with the full maxSteps budget, append the result
// to generatedPrefix, and charge cost accordingly.
// The insideConstrained state is preserved as-is (we don't open/close spans here).
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// 1. parser_validity invariant:
//    - We never modify insideConstrainedOut or currentConstrainedOut from their initial values
//      (which satisfy the preconditions). The base case (maxSteps==0) trivially preserves this.
//    - In the non-zero case, we use ConstrainedGeneration which does not affect currentConstrained.
//      insideConstrainedOut remains equal to insideConstrained, and currentConstrainedOut remains
//      equal to currentConstrained. The precondition guarantees these satisfy parser_validity.
//
// 2. progress invariant:
//    - |generated| <= |generatedPrefix| + steps:
//      In the maxSteps==0 branch: generated == generatedPrefix, steps==0, so |generated| == |generatedPrefix| + 0. OK.
//      In the main branch: ConstrainedGeneration returns at most maxSteps tokens.
//      generated := generatedPrefix + constrainedGenerated, so |generated| = |generatedPrefix| + |constrainedGenerated|.
//      Since |constrainedGenerated| <= maxSteps, we have |generated| <= |generatedPrefix| + maxSteps.
//      cost := |constrainedGenerated| + (1 if terminatedByEos else 0) <= maxSteps, satisfying cost <= maxSteps.
//      Progress is ensured because cost > 0 whenever maxSteps > 0 (at least one step is consumed).
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

if maxSteps == 0 {
  // No budget: return immediately with no changes and cost == 0.
  // The progress postcondition is satisfied vacuously (maxSteps == 0).
} else {
  // Use ConstrainedGeneration for the hidden constrained chunk surface.
  // This generates a complete parser-valid SMILES without visible << >> delimiters.
  var constrainedGenerated, terminatedByEos := helpers.ConstrainedGeneration(
    lm, parser, prompt, maxSteps, eosToken
  );

  // Append the constrained generation result to generated
  generated := generatedPrefix + constrainedGenerated;

  // Cost is at most maxSteps; it is at least 1 since maxSteps > 0.
  // ConstrainedGeneration costs |constrainedGenerated| plus 1 if EOS terminated.
  if terminatedByEos {
    cost := |constrainedGenerated| + 1;
    if cost > maxSteps {
      cost := maxSteps;
    }
  } else {
    cost := |constrainedGenerated|;
    if cost == 0 {
      cost := 1;
    }
    if cost > maxSteps {
      cost := maxSteps;
    }
  }
}

