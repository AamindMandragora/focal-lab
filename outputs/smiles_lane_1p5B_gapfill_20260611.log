Strategy: // CSD_RATIONALE_BEGIN
// The previous attempts failed because the evaluator uses a "hidden constrained segment"
// surface — it extracts the answer from a hidden/task-native surface, NOT from visible
// << >> delimiters. The failure mode "missing_constrained_segment" with 50/50 examples
// and "tiny_span_dominant: yes" and "answer_source: none" indicates that the hidden
// parser span produced only 1 token (likely just "O" from ConstrainedGeneration starting
// from [] with an empty-prefix SMILES).
//
// Key insight from diagnostics:
// - "valid_nonfinal_spans_only: 50/50" — every example has a valid span but it's not the
//   final answer span. This means the constrained generation IS producing valid SMILES
//   tokens, but the answer extractor can't find the full SMILES.
// - "tiny_span_dominant: yes" — the constrained chunk is only ~1 token.
// - The correct approach: use visible << >> delimiters so the evaluator can extract the
//   answer from "last_visible_span". The hidden surface isn't working; we need visible spans.
// - Strategy: append guidance, open a constrained span with OpenConstrainedSpan (emits <<),
//   run AdaptiveConstrainedStep in a loop until the parser is complete, then CloseConstrainedSpan
//   to emit >>. The evaluator will extract the content between << and >> as the answer.
//
// The key fix vs previous attempts: use visible << >> delimiters (OpenConstrainedSpan +
// CloseConstrainedSpan) so the evaluator can extract the final SMILES answer. Use
// RepetitionPenaltyStep to avoid copying exemplar tokens from the prompt. Use a higher
// narrowThreshold to ensure good group-boosted behavior throughout generation.
// CSD_RATIONALE_END

// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - OpenConstrainedSpan sets insideConstrainedOut := true, currentConstrainedOut := [].
//     parser.IsValidPrefix([]) holds by precondition.
//   - Each call to AdaptiveConstrainedStep / SafeRepetitionPenaltyStep returns either
//     eosToken or a hard-masked parser-valid next token. AppendConstrainedToken extends
//     currentConstrainedOut by that valid token, preserving IsValidPrefix by parser's
//     prefix extension property.
//   - CloseSpanIfComplete either closes (insideConstrainedOut := false, implication vacuous)
//     or is a no-op (currentConstrainedOut unchanged, still valid).
//   - CloseConstrainedSpan is called only when IsCompletePrefix holds; it sets
//     insideConstrainedOut := false, making the implication vacuous.
//
// progress:
//   - OpenConstrainedSpan costs +1 step, appends "<<" (+1 visible token).
//   - Each constrained step costs +1 step, appends at most 1 visible token.
//   - CloseSpanIfComplete costs +1 when it closes (appends ">>"), +0 otherwise.
//   - CloseConstrainedSpan costs +1 when called.
//   - Every iteration of the main loop increments steps by exactly 1 (either via
//     CloseSpanIfComplete or via the generation sub-branch which itself adds 1).
//     |generated| grows by at most 1 per step, so |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate exactly one novel valid SMILES string for an isocyanate molecule containing the -N=C=O functional group. Output only the SMILES string between the delimiters. Do not copy the examples. Use diverse substituents like alkyl, aryl, or heterocyclic groups attached to N=C=O.");

var steps: nat := 0;
var narrowThreshold: nat := 20;

// Open the constrained span if not already inside one
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span closed; generation complete
    break;
  } else {
    // Try to close if the parser accepts the current prefix as complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      break;
    } else {
      // Generate next constrained token with repetition penalty to avoid copying exemplars
      if steps < maxSteps {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.SafeRepetitionPenaltyStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          // Try to close gracefully before giving up
          if steps < maxSteps && insideConstrainedOut {
            var fg, fi, fc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
            generated := fg;
            insideConstrainedOut := fi;
            currentConstrainedOut := fc;
            steps := steps + 1;
          }
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

// If still inside span and budget remains, try to close cleanly
if insideConstrainedOut && steps < maxSteps && parser.IsCompletePrefix(currentConstrainedOut) {
  var fg, fi, fc := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
  generated := fg;
  insideConstrainedOut := fi;
  currentConstrainedOut := fc;
  steps := steps + 1;
}

cost := steps;

