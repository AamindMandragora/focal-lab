Strategy: // CSD_RATIONALE_BEGIN
// SMILES isocyanate CSD strategy.
// State tracked: generated (full visible output), insideConstrainedOut (whether
// inside a constrained span), currentConstrainedOut (the active constrained
// prefix), steps (token budget consumed), cost (final budget).
//
// Strategy:
// 1. Append task guidance steering the model toward a novel isocyanate SMILES.
// 2. Immediately open a constrained span (OpenConstrainedSpan) — the answer
//    contract is a single SMILES string with no surrounding text, so we go
//    directly into constrained generation without any free-text preamble.
// 3. Inside the span, use AdaptiveConstrainedStep with the caller-supplied
//    validTokenGroups and a narrow threshold to drive hard-parser-valid token
//    selection, boosting group tokens when the branch factor is tight.
// 4. After each constrained token, call CloseSpanIfComplete to close the span
//    as soon as the parser accepts a complete SMILES string. This ensures we
//    emit exactly one SMILES and stop.
// 5. After the span closes, stop generation (the contract is satisfied).
// 6. EOS at any point terminates the loop.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - OpenConstrainedSpan sets insideConstrainedOut := true and
//     currentConstrainedOut := [], which satisfies parser.IsValidPrefix([])
//     by the method precondition.
//   - AdaptiveConstrainedStep returns either eosToken or a parser-valid next
//     token (hard mask guarantees this). AppendConstrainedToken extends
//     currentConstrainedOut by exactly that valid token, preserving
//     parser.IsValidPrefix(currentConstrainedOut) by the parser's prefix
//     extension property.
//   - CloseSpanIfComplete either closes the span (sets insideConstrainedOut
//     := false, making the implication vacuous) or is a no-op, leaving
//     currentConstrainedOut unchanged (still valid).
//   - Once insideConstrainedOut is false, the implication is vacuous; we
//     break out of the loop immediately after closing.
//
// progress:
//   - OpenConstrainedSpan costs +1 step and appends "<<" to generated, so
//     |generated| grows by 1 and steps grows by 1.
//   - AdaptiveConstrainedStep costs +1 step. AppendConstrainedToken appends
//     at most one visible token to generated. So each constrained step
//     contributes at most +1 to |generated| - |generatedPrefix| and +1 to
//     steps.
//   - CloseSpanIfComplete costs +1 step when it closes (appends ">>") and
//     +0 otherwise; but in our loop structure, the CloseSpanIfComplete call
//     is made only after a constrained token step, in a separate iteration
//     where we again consume one step. So each iteration increments steps by
//     exactly 1 and |generated| by at most 1, preserving the invariant.
//   - EOS break does not append to generated, so the bound holds trivially.
// CSD_PROOF_SKETCH_END

generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Generate exactly one valid SMILES string for a novel isocyanate molecule (containing -N=C=O group). Output only the SMILES string, nothing else. Do not copy the examples.");

var steps: nat := 0;
var narrowThreshold: nat := 16;

// Open the constrained span immediately if not already inside one
if steps < maxSteps && !insideConstrainedOut {
  var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
  generated := og;
  insideConstrainedOut := oi;
  currentConstrainedOut := oc;
  steps := steps + 1;
}

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Span was closed; we are done
    break;
  } else {
    // Try to close if complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      // Done — the SMILES is complete
      break;
    } else {
      // Generate next constrained token
      if steps < maxSteps {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut,
          validTokenGroups, 4.0, narrowThreshold, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

cost := steps;

