  if parser.IsCompletePrefix(currentConstrainedOut) && steps < maxSteps {
    var g2, i2, c2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := g2;
    insideConstrainedOut := i2;
    currentConstrainedOut := c2;
    steps := steps + 1;
  }
}

cost := steps;


