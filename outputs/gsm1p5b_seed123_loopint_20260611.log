// - We detect the final answer region by letting the model generate freely for most of budget,
//   then at the end, force open a clean constrained span with ConstrainedStep
// - But we saw forcing doesn't work well (attempts 5, 6 were worse)
//
// Better approach: The problem is that when the model emits "<<", the content it generates
// uses {variable} names which the arithmetic parser rejects. We need to either:
// a) Use much stronger guidance to force actual numbers  
// b) Allow all spans but ensure they're valid
//
// The constrained step IS working (351 calls visible) but only on 1/49 examples!
// The issue: "EnterObservedConstrainedSpan=1" - we only enter constrained mode ONCE across 49 examples
// This means the model very rarely emits "<<" AND triggers our detection code... wait
// Actually 49/49 have "<<" but EnterObservedConstrainedSpan=1 means 48/49 examples never
// triggered our constrained mode entry. Why? Because in the previous attempt, the first "<<"
// was in the generated prefix already (model generates << >> naturally before our CSD runs).
//
// Wait - re-reading: "Tokens before first visible open: avg 36.98" - the model emits "<<"
// after ~37 tokens. With stepTokenBudget=1, our UnconstrainedStep loop SHOULD detect it.
// But EnterObservedConstrainedSpan=1 suggests we almost never enter constrained mode from our loop.
//
// Hypothesis: The "<<" is NOT appearing as a standalone token. It might be part of a longer
// token like "<<5" or "<<n1". The model tokenizer splits it differently.
// This would mean `next == "<<"` almost never fires because "<<" is embedded in multi-char tokens.
//
// Solution: Instead of waiting for "<<", we should FORCE open constrained spans ourselves.
// Strategy: Generate freely for most of the budget (reasoning phase), then near the end
// (say last 150 steps), force OpenConstrainedSpan and drive constrained generation to completion.
// This ensures the FINAL span is properly constrained.
//
// But attempts 5,6 failed with forced spans at fixed offsets.
// The issue was timing - we need enough budget for constrained generation AND the model to have
// completed its reasoning.
//
// New strategy:
// 1. Use a large free-generation phase (steps 0 to ~750 of 900)  
// 2. At step ~750, force OpenConstrainedSpan
// 3. Drive constrained generation with AdaptiveConstrainedStep until complete
// 4. Close the span and optionally continue for a few more tokens
//
// With 150 steps budget for the constrained part:
// - 1 step for OpenConstrainedSpan
// - up to 100 steps for constrained content (typical span is 5-7 tokens, max ~20)
// - 1 step to close
// - remaining steps as free continuation
//
// Also: guidance should be stronger and more specific about numeric-only content.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Free generation phase (steps < threshold, !insideConstrainedOut):
//     insideConstrainedOut stays false throughout, implication is vacuously true.
//   - OpenConstrainedSpan: sets currentConstrainedOut := [], and parser.IsValidPrefix([])
//     holds by method precondition. Invariant holds.
//   - AdaptiveConstrainedStep + AppendConstrainedToken: AppendConstrainedToken extends
//     currentConstrainedOut with a parser-valid next token, so IsValidPrefix still holds.
//   - EOS from AdaptiveConstrainedStep: RollbackConstrainedToComplete produces IsValidPrefix
//     result (or empty), then we set insideConstrainedOut := false, making implication vacuous.
//   - CloseSpanIfComplete (closed=true): insideConstrainedOut := false, implication vacuous.
//   - CloseSpanIfComplete (closed=false): state unchanged, invariant preserved.
//   - Free continuation phase after closing: insideConstrainedOut remains false, vacuous.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Free generation phase: each UnconstrainedStep increments steps by 1 and appends at
//     most 1 token (EOS path appends 0, non-EOS appends 1). |generated| grows by <= steps. OK.
//   - OpenConstrainedSpan: steps+1, generated grows by 1 ("<<"). OK.
//   - Each AdaptiveConstrainedStep: steps+1, AppendConstrainedToken grows generated by 1.
//     EOS path: steps+1, generated unchanged or shrinks (rollback). OK.
//   - CloseSpanIfComplete (closed=true): steps+1, generated grows by at most 1 (">>"). OK.
//   - CloseSpanIfComplete (closed=false): steps+1, generated unchanged. OK.
//   - Post-close UnconstrainedStep: steps+1, generated grows by at most 1. OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem. Show your work step by step. At the end, write your final numeric answer as an arithmetic expression inside << >>. The expression inside << >> must use ONLY literal numbers (digits like 2, 15, 3.5) and math operators (+, -, *, /, (, )). No variable names, no letters, no words. Example: <<(30 - 5) * 2>> or <<100 / 4 + 3>>.");

var steps: nat := 0;
// Threshold at which we force open a constrained span for the final answer
// Use 750 out of 900 steps for free reasoning, then 150 steps for constrained answer
var constraintThreshold: nat := if maxSteps > 150 then maxSteps - 150 else 0;
var forcedOpen: bool := false;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if steps >= constraintThreshold && !forcedOpen {
      // Force open the final answer constrained span
      var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
      steps := steps + 1;
      generated := og;
      insideConstrainedOut := oi;
      currentConstrainedOut := oc;
      forcedOpen := true;
    } else {
      // Free generation phase
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        // EOS during free phase - force open constrained span if we haven't yet
        // and have enough budget
        if !forcedOpen && steps + 2 <= maxSteps {
          var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
          steps := steps + 1;
          generated := og;
          insideConstrainedOut := oi;
          currentConstrainedOut := oc;
          forcedOpen := true;
        } else {
          break;
        }
      } else {
        generated := generated + [next];
      }
    }
  } else {
    // Inside constrained span - check if complete first
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      // After closing, continue free generation for a few more tokens if budget allows
      // to let the model finish naturally
    } else {
      // Generate next constrained token
      if steps >= maxSteps {
        // Out of budget - rollback to complete and close
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        break;
      }
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken);
      steps := steps + 1;
      if next == eosToken {
        // EOS inside constrained span - rollback to complete prefix
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

