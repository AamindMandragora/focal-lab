Strategy: // CSD_RATIONALE_BEGIN
// Key diagnosis from previous attempts:
// 1. Syntax failures (53%): the unconstrained phase often generates malformed content
//    inside << >> spans. The model outputs reasoning text mixed with partial expressions,
//    or emits multiple spans with incorrect ones.
// 2. The "constrained intervention activity: 0/49" tells us the constrained step helpers
//    were NEVER being called - the OpenConstrainedSpan was forcing << at a budget threshold,
//    but the model was already naturally emitting << >> in the unconstrained phase before
//    we got there.
// 3. Fix: Don't rely on OpenConstrainedSpan. Instead, observe the natural << that the
//    model emits during unconstrained generation, then switch to hard constrained decoding
//    for the content between << >>. Use EnterObservedConstrainedSpan when we see <<.
// 4. For the constrained content: use SafeRepetitionPenaltyStep to generate valid
//    arithmetic expressions, and close the span as soon as the parser accepts it.
// 5. Use AppendTaskGuidance to steer the model to produce ONE final answer at the end.
// 6. The guidance should make the model NOT emit << >> multiple times during reasoning -
//    only once at the very end. The model is emitting many spans which confuses extraction.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - UnconstrainedStep branch (!insideConstrainedOut, next != "<<"): implication vacuous.
//   - UnconstrainedStep branch (next == "<<"): EnterObservedConstrainedSpan sets
//     currentConstrainedOut := [], which is a valid prefix by precondition. Invariant holds.
//   - CloseSpanIfComplete (closed=true): insideConstrainedOut becomes false, implication
//     vacuously true. currentConstrainedOut := [] also satisfies IsValidPrefix.
//   - CloseSpanIfComplete (closed=false, then constrained step): SafeRepetitionPenaltyStep
//     returns EOS or a parser-valid next token. AppendConstrainedToken preserves
//     parser.IsValidPrefix(currentConstrainedOut). Invariant maintained.
//   - EOS inside span: RollbackConstrainedToComplete produces IsCompletePrefix or [].
//     Both satisfy IsValidPrefix. Then insideConstrainedOut := false makes implication vacuous.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Each loop iteration increments steps by exactly 1.
//   - UnconstrainedStep (EOS or non-<<): steps+1, generated grows by at most 1 (0 on EOS). OK.
//   - UnconstrainedStep (next == "<<"): steps+1, generated grows by 1 (already appended). OK.
//   - CloseSpanIfComplete (closed=true): steps+1, generated grows by at most 1. OK.
//   - CloseSpanIfComplete (closed=false) + gen step: two increments! Fix: split into two
//     separate branches so only one step is taken per iteration. When closed=false,
//     do NOT do another step in the same iteration - instead fall through to next iteration
//     where we do the generation step. Actually: we check CloseSpanIfComplete first (costs 1 step),
//     and if not closed, we do the gen step anyway in the SAME branch (also costs 1 step).
//     This would be 2 steps per iteration. To avoid this, use the CloseSpanIfComplete+gen
//     approach where the total is 2 steps and we increment steps by 2.
//     But that risks exceeding maxSteps. Instead: use ConstrainedStep directly (no close check
//     before), and after AppendConstrainedToken, check for completion implicitly next iteration.
//     Each iteration: exactly 1 step consumed.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem. Show your work briefly. At the very end, put ONLY the final arithmetic expression (using numbers and +,-,*,/,(,) only) inside << >> delimiters. Do not use << >> anywhere else in your response.");

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        // Model naturally opened a constrained span - enter it
        var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := og;
        insideConstrainedOut := oi;
        currentConstrainedOut := oc;
      }
    }
  } else {
    // Inside constrained span - check if we can close first (no step cost if not complete)
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
      steps := steps + 1;
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      // Whether closed or not, we consumed a step
    } else {
      // Generate next constrained token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
      steps := steps + 1;
      if next == eosToken {
        // EOS inside constrained span - rollback to complete and exit
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

