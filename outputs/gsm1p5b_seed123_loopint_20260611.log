Strategy: // CSD_RATIONALE_BEGIN
// Root cause: The model emits << >> spans freely during unconstrained generation,
// and our strategy only enters constrained mode when it sees next == "<<" from
// UnconstrainedStep. But the model already emitted << before we can intercept it
// (the token appears in the middle of unconstrained output), and when we do intercept,
// we're already past the << that opened the span - causing 44/49 examples to have
// unconstrained span content.
//
// Key insight from diagnostics:
// - Model emits avg 4.33 visible spans per example (multiple << >> during reasoning)
// - We need to FORCE exactly one constrained span for the final answer
// - The strategy should: generate reasoning freely, then FORCE open a constrained span
//   near the end using OpenConstrainedSpan (which appends << directly), drive content
//   with ConstrainedStep/SafeRepetitionPenaltyStep, close with CloseSpanIfComplete
//
// The previous attempt tried this but set forceThreshold too late (700/900 steps),
// and the model was consuming budget and triggering EOS before we forced entry.
// The model typically generates 189 tokens on average, so it finishes naturally
// around step 189 - we need to force the constrained span MUCH earlier.
//
// New strategy:
// 1. Generate unconstrained reasoning for up to ~80 steps (the model does ~37 tokens
//    before first << on average, so 80 gives room for reasoning)
// 2. After 80 steps (or if model emits EOS), FORCE OpenConstrainedSpan
// 3. Drive constrained content with SafeRepetitionPenaltyStep (for expression quality)
// 4. Close with CloseSpanIfComplete as soon as parser accepts
// 5. Budget: 80 free + 1 open + up to 50 constrained + 1 close + a few free = ~133 steps
//    This fits comfortably within maxSteps=900
//
// If model naturally emits "<<" during the first 80 steps, observe it with
// EnterObservedConstrainedSpan and constrain from there.
//
// CRITICAL: We do NOT want the model to generate reasoning inside << >>, so we
// force open AFTER the reasoning phase rather than waiting for the model to open.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - UnconstrainedStep, next != "<<", !insideConstrainedOut: implication vacuous.
//   - UnconstrainedStep, next == "<<": EnterObservedConstrainedSpan sets currentConstrainedOut := [],
//     which satisfies IsValidPrefix([]) by precondition. Invariant holds.
//   - OpenConstrainedSpan (forced): sets currentConstrainedOut := [], which satisfies
//     IsValidPrefix([]) by precondition. Invariant holds.
//   - CloseSpanIfComplete (closed=true): insideConstrainedOut becomes false, implication
//     vacuously true, currentConstrainedOut := []. Invariant holds.
//   - CloseSpanIfComplete (closed=false): state unchanged, invariant preserved by induction.
//   - SafeRepetitionPenaltyStep + AppendConstrainedToken: the step returns a parser-valid token,
//     and AppendConstrainedToken extends currentConstrainedOut preserving IsValidPrefix. Invariant maintained.
//   - EOS inside constrained span: we set insideConstrainedOut := false, currentConstrainedOut := [],
//     making the implication vacuously true. Invariant holds.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Each branch increments steps by exactly 1.
//   - UnconstrainedStep (EOS): steps+1, generated unchanged. |generated| <= |generatedPrefix| + steps. OK.
//   - UnconstrainedStep (non-EOS): steps+1, |generated| += 1. OK.
//   - OpenConstrainedSpan: steps+1, |generated| += 1 (the "<<" token). OK.
//   - CloseSpanIfComplete (closed): steps+1, |generated| += at most 1 (the ">>" token). OK.
//   - CloseSpanIfComplete (not closed): steps+1, |generated| unchanged. OK.
//   - SafeRepetitionPenaltyStep + AppendConstrainedToken: steps+1, |generated| += 1. OK.
//   - SafeRepetitionPenaltyStep (EOS): steps+1, generated unchanged (rollback also doesn't grow). OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem step by step. After your reasoning, write ONLY the final arithmetic expression inside << >> delimiters. The expression must use only numbers and operators +,-,*,/,(,). Do not write anything inside << >> except the arithmetic expression.");

var steps: nat := 0;
// Force open constrained span after this many unconstrained steps
// Model typically generates ~37 tokens before first <<, so 80 gives enough reasoning
var reasoningBudget: nat := if maxSteps > 120 then 80 else (if maxSteps > 10 then maxSteps / 2 else maxSteps);
var forcedOpen: bool := false;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Check if we should force open a constrained span
    if steps >= reasoningBudget && steps + 3 <= maxSteps {
      // Force open the constrained span for the final answer
      var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
      steps := steps + 1;
      generated := og;
      insideConstrainedOut := oi;
      currentConstrainedOut := oc;
      forcedOpen := true;
    } else {
      // Unconstrained reasoning phase
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        // Model finished - force open constrained span if we haven't yet and have budget
        if !forcedOpen && steps + 3 <= maxSteps {
          // We'll open the span in the next iteration (insideConstrainedOut is still false,
          // but we set reasoningBudget to current steps so next iteration forces open)
          reasoningBudget := steps;
          // Don't break - loop will force open on next iteration
        } else {
          break;
        }
      } else {
        generated := generated + [next];
        if next == "<<" {
          // Model naturally opened a constrained span - observe and enter it
          var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
          generated := og;
          insideConstrainedOut := oi;
          currentConstrainedOut := oc;
          forcedOpen := true;
        }
      }
    }
  } else {
    // Inside constrained span
    // Try to close if complete (use CloseSpanIfComplete which is safe)
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      // Span closed - done with constrained content, can break or continue
      break;
    } else {
      // Not complete - generate next constrained token
      if steps < maxSteps {
        var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 2.0, eosToken);
        steps := steps + 1;
        if next == eosToken {
          // EOS inside span - rollback and close
          var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
          generated := rg;
          currentConstrainedOut := rc;
          insideConstrainedOut := false;
          currentConstrainedOut := [];
          break;
        } else {
          var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
          generated := ag;
          insideConstrainedOut := ai;
          currentConstrainedOut := ac;
        }
      }
    }
  }
}

cost := steps;

