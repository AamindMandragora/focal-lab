//
//   Constrained phase (insideConstrainedOut = true):
//   - CloseSpanIfComplete (closed=true): insideConstrainedOut := false, implication vacuous.
//   - CloseSpanIfComplete (closed=false): state unchanged, invariant holds by induction.
//   - AdaptiveConstrainedStep returns non-EOS + AppendConstrainedToken: extends
//     currentConstrainedOut with a parser-valid next token, preserving IsValidPrefix.
//   - EOS path: RollbackConstrainedToComplete gives complete-or-empty prefix satisfying
//     IsValidPrefix. Then CloseSpanIfComplete either closes (insideConstrainedOut:=false,
//     vacuous) or leaves open with IsValidPrefix(currentConstrainedOut) still holding
//     (since rollback result satisfies it). Then insideConstrainedOut:=false makes it vacuous.
//
// progress: |generated| <= |generatedPrefix| + steps
//   Each iteration increments steps by exactly the number of step-consuming helpers called:
//   - Free branch: UnconstrainedStep costs 1 step; generated grows by 0 (EOS) or 1. OK.
//   - EnterObservedConstrainedSpan: cost 0, generated unchanged. OK.
//   - Constrained CloseSpanIfComplete: costs 1 step, generated grows by at most 1 (">>"). OK.
//   - AdaptiveConstrainedStep: costs 1 step, AppendConstrainedToken grows generated by 1. OK.
//   - EOS path: AdaptiveConstrainedStep cost 1, rollback may shrink generated (OK),
//     CloseSpanIfComplete costs 1 more step (steps+2 total for this sub-path, generated
//     grows by at most 1 from ">>" close). Budget check before second step ensures steps<maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this step by step using actual numeric values. Each intermediate calculation goes between << and >>. Use ONLY digits and arithmetic operators (+, -, *, /) inside << >>. Example: <<12 * 3>> not <<n * 3>>. End with the final numeric answer between << and >>.");

var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := og;
        insideConstrainedOut := oi;
        currentConstrainedOut := oc;
      }
    }
  } else {
    // Try to close if already complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      // Continue freely after closing span
    } else {
      // Not complete - need to generate more, but check budget for at least 2 more steps
      // (one for generation, one for potential close)
      if steps + 1 >= maxSteps {
        // Nearly out of budget - rollback to complete and try to close
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        // Try to close whatever we have
        var cg2, ci2, cc2, closed2 := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
        steps := steps + 1;
        generated := cg2;
        insideConstrainedOut := ci2;
        currentConstrainedOut := cc2;
        if !insideConstrainedOut {
          // closed successfully
        } else {
          // Parser won't close - force exit without ">>" (accept unterminated)
          insideConstrainedOut := false;
          currentConstrainedOut := [];
        }
        break;
      }

      // Generate next constrained token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken);
      steps := steps + 1;

      if next == eosToken {
        // EOS inside span - rollback to complete prefix
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        // Try to close the span to emit ">>" and make it balanced
        if steps < maxSteps {
          var cg3, ci3, cc3, closed3 := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
          steps := steps + 1;
          generated := cg3;
          insideConstrainedOut := ci3;
          currentConstrainedOut := cc3;
          if insideConstrainedOut {
            // Couldn't close - force exit
            insideConstrainedOut := false;
            currentConstrainedOut := [];
          }
        } else {
          insideConstrainedOut := false;
          currentConstrainedOut := [];
        }
        // Don't break - continue generating freely (model may emit more << >> spans)
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Final cleanup if still inside a constrained span
if insideConstrainedOut {
  var rg4, rc4 := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg4;
  currentConstrainedOut := rc4;
  if steps < maxSteps {
    var cg5, ci5, cc5, closed5 := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    generated := cg5;
    insideConstrainedOut := ci5;
    currentConstrainedOut := cc5;
  }
  if insideConstrainedOut {
    insideConstrainedOut := false;
    currentConstrainedOut := [];
  }
}

cost := steps;

