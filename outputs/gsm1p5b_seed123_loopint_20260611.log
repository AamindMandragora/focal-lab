// 2. Fix: ensure each loop iteration increments `steps` by at most 1, and the
//    post-loop cleanup uses the remaining budget carefully.
//
// Strategy: free reasoning phase until freeBudget, then open one constrained span
// and generate the arithmetic answer. Use SafeRepetitionPenaltyStep inside the span.
// Each loop body branch increments steps by exactly 1. Post-loop cleanup is
// removed to avoid violating the invariant (the loop handles everything).
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Free branch (!insideConstrainedOut, not opening span): implication vacuous.
//   - OpenConstrainedSpan branch: sets currentConstrainedOut := [], which satisfies
//     parser.IsValidPrefix([]) by precondition. Invariant maintained.
//   - CloseSpanIfComplete (closed=true): insideConstrainedOut becomes false, implication
//     vacuously true. currentConstrainedOut := [] also valid.
//   - CloseSpanIfComplete (closed=false): state unchanged, invariant maintained.
//   - SafeRepetitionPenaltyStep returns EOS or parser-valid token.
//     AppendConstrainedToken preserves parser.IsValidPrefix(currentConstrainedOut).
//   - RollbackConstrainedToComplete: result is IsCompletePrefix (=> IsValidPrefix) or [].
//     Both satisfy IsValidPrefix. insideConstrainedOut set to false makes implication vacuous.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Each branch increments steps by exactly 1.
//   - UnconstrainedStep: generated grows by at most 1 (0 on EOS). Net: steps+1, gen+at most 1.
//   - OpenConstrainedSpan: generated grows by exactly 1. Net: steps+1, gen+1. OK.
//   - CloseSpanIfComplete closed=true: generated grows by at most 1. Net: steps+1, gen+at most 1.
//   - CloseSpanIfComplete closed=false + SafeRepetitionPenaltyStep + AppendConstrainedToken:
//     steps incremented once (for CloseSpanIfComplete) but next step also increments.
//     Wait - this branch has TWO increments within one "else" arm. Fix: only one path
//     should increment per iteration. The constrained branch is split into two sub-branches
//     each consuming exactly one step: either CloseSpanIfComplete (1 step) OR the
//     generation step (1 step), not both in same iteration.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem step by step. At the very end, write ONLY the final arithmetic expression inside << >> delimiters. Use only numbers, +, -, *, /, (, ) inside the delimiters.");

var steps: nat := 0;

var reservedForAnswer: nat := if maxSteps >= 60 then 50 else if maxSteps >= 20 then 20 else if maxSteps >= 5 then maxSteps - 2 else maxSteps;
var freeBudget: nat := if maxSteps > reservedForAnswer then maxSteps - reservedForAnswer else 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if steps >= freeBudget {
      // Time to open constrained span for final answer
      var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
      generated := og;
      insideConstrainedOut := oi;
      currentConstrainedOut := oc;
      steps := steps + 1;
    } else {
      // Free reasoning phase
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    // Inside constrained span
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
      steps := steps + 1;
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      if closed {
        break;
      }
    } else {
      // Generate next constrained token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
      steps := steps + 1;
      if next == eosToken {
        // EOS inside span - rollback to complete if possible, then exit
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        if parser.IsCompletePrefix(currentConstrainedOut) {
          // Leave span open; next iteration will close it
        } else {
          insideConstrainedOut := false;
          currentConstrainedOut := [];
        }
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

cost := steps;

