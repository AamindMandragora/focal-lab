Strategy: // CSD_RATIONALE_BEGIN
// Core diagnosis: The model generates << >> spans freely during unconstrained reasoning,
// but the strategy only enters constrained mode reactively (waiting for next == "<<"),
// which rarely fires because the model emits multi-token sequences like " <<" or "<<n".
// Result: 47/49 examples have unconstrained span content, leading to 57% syntax rate.
//
// Fix: FORCE span entry near the end of reasoning. Strategy:
// 1. Generate freely with UnconstrainedStep for most of the budget (reasoning phase).
// 2. When budget is low (reserve ~100 steps), FORCE a constrained span via OpenConstrainedSpan,
//    which appends "<<" unconditionally, then drive content with ConstrainedStep until complete.
// 3. Close with CloseSpanIfComplete as soon as the parser accepts the expression.
// 4. This guarantees that at least the LAST span is parser-controlled.
//
// Additionally: if the model naturally emits "<<" during reasoning, we can observe it
// with EnterObservedConstrainedSpan and try to constrain the content. But the KEY change
// is that we FORCE a final constrained span regardless.
//
// Budget allocation with maxSteps=900:
// - Steps 0..700: unconstrained reasoning (watch for natural "<<")  
// - If still unconstrained at step 700: force OpenConstrainedSpan
// - Steps 700..895: constrained generation (up to 195 tokens for the expression)
// - Step 895+: close span
//
// Guidance: Ask model to put final answer in << >> at end, avoid intermediate << >>.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - UnconstrainedStep, next != "<<": insideConstrainedOut stays false; implication vacuous.
//   - UnconstrainedStep, next == "<<": EnterObservedConstrainedSpan sets currentConstrainedOut := [],
//     which satisfies IsValidPrefix([]) by precondition. Invariant holds.
//   - OpenConstrainedSpan forced entry: sets currentConstrainedOut := [],
//     which satisfies IsValidPrefix([]) by precondition. Invariant holds.
//   - CloseSpanIfComplete (closed=true): insideConstrainedOut := false, implication vacuously true.
//   - CloseSpanIfComplete (closed=false) + ConstrainedStep + AppendConstrainedToken:
//     ConstrainedStep returns a parser-valid token or EOS; AppendConstrainedToken
//     extends currentConstrainedOut by one valid token, preserving IsValidPrefix. Invariant holds.
//   - EOS inside span: we break, insideConstrainedOut may remain true but the postcondition
//     requires the invariant to hold at exit, which it does since we maintained it in the loop.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - Each loop iteration increments steps by exactly 1.
//   - UnconstrainedStep (EOS): steps+1, generated unchanged. OK.
//   - UnconstrainedStep (non-EOS, non-<<): steps+1, |generated| += 1. OK.
//   - UnconstrainedStep (next == "<<"): steps+1, |generated| += 1 (appended next),
//     EnterObservedConstrainedSpan is +0 cost and doesn't change generated. OK.
//   - OpenConstrainedSpan (forced): steps+1, |generated| += 1 (the "<<" token). OK.
//   - CloseSpanIfComplete (closed=true): steps+1, |generated| += at most 1. OK.
//   - CloseSpanIfComplete (closed=false): steps+1 for the check cost, no generation. OK.
//     Then next iteration does ConstrainedStep + AppendConstrainedToken (steps+1, |generated|+=1). OK.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem step by step. At the very end of your response, write the final arithmetic expression (using only numbers and operators +,-,*,/,(,)) inside << >> delimiters. Use << >> only once, for the final answer.");

var steps: nat := 0;
// Reserve budget: force constrained span entry when steps exceed this threshold
var forceThreshold: nat := if maxSteps > 100 then maxSteps - 100 else 0;
var closeReserve: nat := 2;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    // Check if we should force entry into constrained span
    if steps >= forceThreshold && steps + closeReserve < maxSteps {
      // Force open a constrained span
      var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
      steps := steps + 1;
      generated := og;
      insideConstrainedOut := oi;
      currentConstrainedOut := oc;
    } else {
      // Free generation - watch for natural "<<"
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          // Model naturally opened a constrained span - observe it
          var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
          generated := og;
          insideConstrainedOut := oi;
          currentConstrainedOut := oc;
        }
      }
    }
  } else {
    // Inside constrained span
    if steps + closeReserve >= maxSteps {
      // Running out of budget - try to close if complete, otherwise close anyway
      var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
      steps := steps + 1;
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      if closed {
        break;
      }
      // If not closed and budget exhausted, break anyway
      if steps >= maxSteps {
        break;
      }
    } else {
      // Try to close if complete first (costs 1 step)
      var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
      steps := steps + 1;
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      if closed {
        // Span closed successfully - continue with free generation
      } else {
        // Need to generate more constrained content
        if steps < maxSteps {
          var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
          var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if next == eosToken {
            // EOS inside span - rollback and close
            var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
            generated := rg;
            currentConstrainedOut := rc;
            if parser.IsCompletePrefix(currentConstrainedOut) {
              var fg, fi, fc, fclosed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
              if steps < maxSteps {
                steps := steps + 1;
                generated := fg;
                insideConstrainedOut := fi;
                currentConstrainedOut := fc;
              }
            } else {
              insideConstrainedOut := false;
              currentConstrainedOut := [];
            }
            break;
          } else {
            var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
            generated := ag;
            insideConstrainedOut := ai;
            currentConstrainedOut := ac;
          }
        }
      }
    }
  }
}

cost := steps;

