Strategy: // CSD_RATIONALE_BEGIN
// ROOT CAUSE IDENTIFIED: The constraint-engagement check shows only 2/49 examples
// actually ran the constrained branch. The strategy WAITS for the model to emit "<<"
// but the model emits it only rarely in the right token sequence. 47/49 examples
// go entirely unconstrained, producing variable-name spans like <<n1 * cur>>.
//
// THE FIX: Force the constrained span ourselves. Instead of waiting for "<<",
// let the model do FREE reasoning for N steps, then FORCE open a constrained span
// via OpenConstrainedSpan, drive the content with AdaptiveConstrainedStep, and
// close with CloseSpanIfComplete. This guarantees every example has at least one
// fully constrained span as the final answer.
//
// APPROACH:
// 1. Let the model reason freely for most of the budget (up to ~85% of steps).
//    This allows the reasoning chain which improves accuracy.
// 2. Reserve ~15% of steps for forced constrained span generation.
// 3. When budget drops to RESERVE threshold, break out of free generation.
// 4. Force open "<<" via OpenConstrainedSpan (this appends "<<" and sets state).
// 5. Drive constrained content with AdaptiveConstrainedStep until complete or EOS.
// 6. Close with CloseSpanIfComplete.
// 7. If EOS fires before completion, rollback to complete and close.
//
// Budget math (maxSteps=900, stepTokenBudget=1):
// - Reserve = 50 steps for constrained span generation
// - Free phase: up to 850 steps
// - Constrained phase: up to 50 steps
//
// KEY: We still handle natural "<<" emissions during free phase so those spans
// get constrained too. But even if model never emits "<<", we FORCE one at the end.
//
// Also: if model emits EOS during free phase before reserve is reached, we should
// still attempt the constrained span if we have budget left.
//
// IMPORTANT: During free phase, if model emits "<<", enter constrained mode.
// After the constrained span closes (or on EOS), return to free phase.
// When reserve hits, force a final constrained span.
//
// This guarantees constrained_activity on essentially all examples.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//
//   Free phase, next != "<<": insideConstrainedOut unchanged (false), implication vacuous.
//   Free phase, next == "<<": EnterObservedConstrainedSpan sets currentConstrainedOut := [],
//     and parser.IsValidPrefix([]) holds by method precondition. Invariant holds.
//   Free phase, EOS before reserve: we break to constrained phase below the loop with
//     remaining budget. Invariant holds at loop exit since insideConstrainedOut is false.
//   Constrained branch (natural span), CloseSpanIfComplete closed=true: insideConstrainedOut
//     becomes false, implication vacuously true; currentConstrainedOut := [].
//   Constrained branch, AdaptiveConstrainedStep non-EOS: AppendConstrainedToken preserves
//     IsValidPrefix by appending a parser-valid next token.
//   Constrained branch, EOS: RollbackConstrainedToComplete returns complete-or-empty prefix
//     satisfying IsValidPrefix; then insideConstrainedOut := false makes it vacuous.
//   Forced constrained phase (post-loop): OpenConstrainedSpan sets currentConstrainedOut := [],
//     which satisfies IsValidPrefix([]). AdaptiveConstrainedStep + AppendConstrainedToken
//     preserves IsValidPrefix each step. RollbackConstrainedToComplete on EOS returns
//     complete-or-empty. CloseSpanIfComplete closes when complete (sets insideConstrainedOut
//     false) or is no-op; we then set insideConstrainedOut := false.
//
// progress: |generated| <= |generatedPrefix| + steps
//   Free phase: each iteration increments steps by 1. UnconstrainedStep: generated grows
//     by at most 1 (0 for EOS). EnterObservedConstrainedSpan: 0 cost, no growth. OK.
//   Constrained natural span: CloseSpanIfComplete costs 1, grows generated by at most 1.
//     AdaptiveConstrainedStep costs 1, AppendConstrainedToken grows by at most 1. OK.
//   Post-loop forced phase: OpenConstrainedSpan costs 1, grows generated by 1. Each
//     AdaptiveConstrainedStep costs 1, AppendConstrainedToken grows by at most 1.
//     CloseSpanIfComplete costs 1, grows by at most 1. All within reserved budget. OK.
//   invariant |generated| <= |generatedPrefix| + steps is maintained because visible
//     growth <= steps consumed at all branches.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math problem step by step, showing your work. At the end, provide the final numeric answer as an arithmetic expression using only numbers and operators.");

// Reserve budget for forced constrained span at the end
var reserve: nat := 50;
if reserve > maxSteps {
  reserve := maxSteps;
}
var freeLimit: nat := maxSteps - reserve;

var steps: nat := 0;
var eosHit: bool := false;

// Free reasoning phase
while steps < freeLimit
  invariant 0 <= steps <= freeLimit
  invariant freeLimit <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases freeLimit - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      eosHit := true;
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        var og, oi, oc := helpers.EnterObservedConstrainedSpan(lm, generated);
        generated := og;
        insideConstrainedOut := oi;
        currentConstrainedOut := oc;
      }
    }
  } else {
    // Inside a naturally-opened constrained span
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
    } else {
      if steps >= freeLimit {
        // No free budget left - rollback and exit constrained mode
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        break;
      }
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken);
      steps := steps + 1;
      if next == eosToken {
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// If still inside a constrained span after free phase, exit it cleanly
if insideConstrainedOut {
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
  insideConstrainedOut := false;
  currentConstrainedOut := [];
}

// Forced constrained span phase - force open a "<<" span and drive it with parser control
// We have 'reserve' steps budget left (steps <= freeLimit, maxSteps = freeLimit + reserve)
// So maxSteps - steps >= reserve > 0 (when reserve > 0)
assert steps <= freeLimit;
assert freeLimit + reserve == maxSteps;

if steps < maxSteps {
  // Open a forced constrained span
  var fg, fi, fc := helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
  generated := fg;
  insideConstrainedOut := fi;
  currentConstrainedOut := fc;

  // Drive constrained content
  while steps < maxSteps
    invariant steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant |generated| <= |generatedPrefix| + steps
    decreases maxSteps - steps
  {
    if !insideConstrainedOut {
      break;
    }
    // Check if complete - if so close
    var cg2, ci2, cc2, closed2 := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed2 {
      generated := cg2;
      insideConstrainedOut := ci2;
      currentConstrainedOut := cc2;
      break;
    } else {
      // Not complete, generate more
      if steps >= maxSteps {
        var rg2, rc2 := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg2;
        currentConstrainedOut := rc2;
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        break;
      }
      var constrainedPrompt2 := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next2 := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt2, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken);
      steps := steps + 1;
      if next2 == eosToken {
        var rg2, rc2 := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg2;
        currentConstrainedOut := rc2;
        // Try one more close attempt if budget allows
        if steps < maxSteps {
          var cg3, ci3, cc3, closed3 := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
          steps := steps + 1;
          if closed3 {
            generated := cg3;
            insideConstrainedOut := ci3;
            currentConstrainedOut := cc3;
          } else {
            insideConstrainedOut := false;
            currentConstrainedOut := [];
          }
        } else {
          insideConstrainedOut := false;
          currentConstrainedOut := [];
        }
        break;
      } else {
        var ag2, ai2, ac2 := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next2);
        generated := ag2;
        insideConstrainedOut := ai2;
        currentConstrainedOut := ac2;
      }
    }
  }
}

// Final cleanup
if insideConstrainedOut {
  var rg3, rc3 := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg3;
  currentConstrainedOut := rc3;
  insideConstrainedOut := false;
  currentConstrainedOut := [];
}

cost := steps;

