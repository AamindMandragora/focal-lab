Strategy: // CSD_RATIONALE_BEGIN
// Key insight from failure analysis:
// 1. The model opens multiple << >> spans during reasoning (avg 4.76 spans/example)
//    instead of just one final span for the answer.
// 2. The constrained content is malformed (variables like {n1}, {frac1} appearing
//    instead of arithmetic operators/numbers, repetitive loops like //480//480...).
// 3. The strategy needs to: do FREE reasoning for most of the budget, then at
//    the very end force ONE constrained span containing only the final arithmetic
//    expression and close it immediately when complete.
//
// Fix:
// - Use a larger free-phase budget (e.g., 80% of maxSteps) for reasoning.
// - When opening the constrained span, use SafeRepetitionPenaltyStep to avoid
//   repetitive patterns.
// - After each constrained token, immediately check CloseSpanIfComplete to
//   close as soon as the expression is valid.
// - Use SafeSoftConstrainedStep for the constrained phase to help the model
//   prefer natural completions over repetition.
// - Critically: use a step budget that reserves enough tokens for the final
//   constrained expression but doesn't open the span too early.
// - Guidance: be very explicit about only one final << >> span.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//   - Free branch (!insideConstrainedOut): implication is vacuous.
//   - OpenConstrainedSpan: sets currentConstrainedOut := [], valid by precondition parser.IsValidPrefix([]).
//   - SafeRepetitionPenaltyStep returns EOS or parser-valid token; AppendConstrainedToken preserves validity.
//   - CloseSpanIfComplete: when closed=true, sets insideConstrainedOut:=false making implication vacuous,
//     sets currentConstrainedOut:=[]; when closed=false, state unchanged (still valid).
//   - RollbackConstrainedToComplete: returns a complete prefix (IsCompletePrefix => IsValidPrefix) or [].
//     Both satisfy IsValidPrefix.
//
// progress: |generated| <= |generatedPrefix| + steps
//   - UnconstrainedStep: steps+1, generated grows by at most 1 (0 on EOS). Invariant maintained.
//   - OpenConstrainedSpan: steps+1, generated grows by exactly 1 ("<<"). Invariant maintained.
//   - CloseSpanIfComplete when closed=true: steps+1, generated grows by at most 1 (">>"). Maintained.
//   - CloseSpanIfComplete when closed=false: steps+1, no visible growth. Maintained.
//   - SafeRepetitionPenaltyStep + AppendConstrainedToken: steps+1, generated grows by 1. Maintained.
//   - SafeRepetitionPenaltyStep + EOS: steps+1, no visible growth (rollback shrinks or preserves). Maintained.
//   - RollbackConstrainedToComplete: +0 steps, generated shrinks or stays same. Maintained.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Reason step by step. At the very end, output ONLY the final numeric arithmetic expression (using numbers and +,-,*,/,(,) only) inside ONE pair of << >> delimiters. Do not open << >> during reasoning. Example: The answer is <<3*4+2>>.");

var steps: nat := 0;

// Reserve: we need at most ~30 tokens for the constrained span + closing.
// Use 85% of budget for free reasoning, rest for constrained answer.
var reservedForAnswer: nat := if maxSteps >= 60 then 50 else if maxSteps >= 20 then 20 else if maxSteps >= 5 then maxSteps - 2 else maxSteps;
var freeBudget: nat := if maxSteps > reservedForAnswer then maxSteps - reservedForAnswer else 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if steps >= freeBudget {
      // Time to open constrained span for final answer
      if steps + 1 <= maxSteps {
        var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
        generated := og;
        insideConstrainedOut := oi;
        currentConstrainedOut := oc;
        steps := steps + 1;
      } else {
        break;
      }
    } else {
      // Free reasoning phase
      var next := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      if next == eosToken {
        // Model wants to stop - open constrained span if we have budget
        if steps + 2 <= maxSteps {
          var og, oi, oc := helpers.OpenConstrainedSpan(lm, generated);
          generated := og;
          insideConstrainedOut := oi;
          currentConstrainedOut := oc;
          steps := steps + 1;
        } else {
          break;
        }
      } else {
        generated := generated + [next];
      }
    }
  } else {
    // Inside constrained span - generate the arithmetic expression
    // First try to close if already complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      break;
    } else {
      // Need more tokens for the expression
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.SafeRepetitionPenaltyStep(lm, parser, constrainedPrompt, currentConstrainedOut, generated, 3.0, eosToken);
      steps := steps + 1;
      if next == eosToken {
        // EOS inside span - rollback to complete if possible, then close
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        if parser.IsCompletePrefix(currentConstrainedOut) && steps + 1 <= maxSteps {
          var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := cg2;
          insideConstrainedOut := ci2;
          currentConstrainedOut := cc2;
          steps := steps + 1;
        } else {
          insideConstrainedOut := false;
          currentConstrainedOut := [];
        }
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
        // Immediately try to close if complete (no extra step cost check - handled next iteration)
      }
    }
  }
}

// Post-loop cleanup: ensure we close any open constrained span
if insideConstrainedOut && steps < maxSteps {
  var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg;
  currentConstrainedOut := rc;
  if parser.IsCompletePrefix(currentConstrainedOut) && steps + 1 <= maxSteps {
    var cg2, ci2, cc2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
    generated := cg2;
    insideConstrainedOut := ci2;
    currentConstrainedOut := cc2;
    steps := steps + 1;
  } else {
    insideConstrainedOut := false;
    currentConstrainedOut := [];
  }
}

cost := steps;

