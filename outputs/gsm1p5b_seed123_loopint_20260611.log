// DIAGNOSIS from previous attempts:
// - Best attempt (9): 40.8% accuracy, 57.1% syntax
// - Core problem: model emits MULTIPLE << >> spans during free reasoning, each with
//   variable names/expressions like {n}, cur, etc. Parser rejects these (malformed_constrained_content).
// - The model treats << >> as a way to show intermediate steps, but these contain variables.
// - Key insight: We should NOT enter constrained mode for every natural "<<" the model emits
//   during reasoning. Instead, we should let the model reason freely, then FORCE ONE final
//   constrained span at the end with the numeric answer.
// - The issue with forcing at end: model generates reasoning with many << tokens embedded.
//   When we force open at step 750, the answer may already be in the reasoning.
// - BETTER APPROACH: Let model generate freely until it would emit EOS or budget is near end.
//   Reserve ~100 steps for final answer. When budget gets low, force open constrained span
//   and drive it with parser control to get a valid numeric expression.
// - BUT: the model emits "<<" naturally, causing many unconstrained << that interfere.
// - Solution: During free phase, DON'T enter constrained mode on "<<". Let them flow freely.
//   They'll appear as text. At the end, force ONE clean constrained span.
// - The evaluator extracts the LAST visible span. So our forced final span = answer.
// - Critical: force span LATE (reserve ~100 steps), use guidance to produce a NUMBER.
// - The guidance must tell the model: the FINAL << >> contains only digits and operators.
// - In constrained phase, use AdaptiveConstrainedStep; close immediately on completion.
// - If model hits EOS in free phase before reserve threshold, immediately open constrained span.
//
// STRATEGY:
// 1. Reserve 100 steps for final constrained answer span.
// 2. Free generation for maxSteps - 100 steps (just unconstrained, no span detection).
// 3. When budget hits 100 remaining OR model emits EOS, open forced constrained span.
// 4. Drive with AdaptiveConstrainedStep until complete or EOS.
// 5. Close on completion. If EOS before complete, rollback + close.
//
// This ensures:
// - Only ONE constrained span (the final answer) - evaluator extracts it.
// - Content is parser-valid (hard masked).
// - Reasoning is fully free (high accuracy).
// - No interference from intermediate << >> in reasoning text.
//
// Budget: maxSteps=900, reserve=100 for constrained.
// Free phase: up to 800 steps.
//
// IMPORTANT: Don't use EnterObservedConstrainedSpan during free phase; we want
// naturally emitted << >> to appear as plain text, NOT trigger constrained mode.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
//
//   Free phase: insideConstrainedOut is never set to true; it starts false (or true if
//   insideConstrained was true). If insideConstrained=true on entry, we inherit the valid
//   prefix. Free phase doesn't touch insideConstrainedOut, so invariant is preserved by
//   initial precondition and never violated.
//
//   After free loop: we call RollbackConstrainedToComplete if insideConstrainedOut is true
//   (handles the case where insideConstrained was true on entry). This produces a valid
//   complete-or-empty prefix. Then we set insideConstrainedOut := false, making it vacuous.
//
//   Forced constrained phase: OpenConstrainedSpan sets currentConstrainedOut := [],
//   and parser.IsValidPrefix([]) holds by precondition. Each AdaptiveConstrainedStep +
//   AppendConstrainedToken extends with a parser-valid next token, preserving IsValidPrefix.
//   CloseSpanIfComplete (closed=true): insideConstrainedOut := false, implication vacuous.
//   On EOS: RollbackConstrainedToComplete produces complete-or-empty, then insideConstrainedOut
//   := false makes it vacuous.
//
// progress: |generated| <= |generatedPrefix| + steps
//   Free phase: each iteration increments steps by 1; UnconstrainedStep grows generated
//   by at most 1 (EOS=0, token=1). So |generated| grows by at most steps each iteration. OK.
//   OpenConstrainedSpan: steps+1, generated grows by 1 ("<<" token). OK.
//   Constrained loop: CloseSpanIfComplete costs 1, grows generated by at most 1. 
//   AdaptiveConstrainedStep costs 1, AppendConstrainedToken grows by at most 1. 
//   RollbackConstrainedToComplete: generated can only shrink or stay same, steps unchanged. OK.
//   All branches: visible growth <= steps consumed. Invariant maintained throughout.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

helpers.AppendTaskGuidance(lm, "Solve this math word problem step by step. Compute with actual numbers at each step. At the very end, write your final numeric answer as a single arithmetic expression using ONLY digits and operators (+, -, *, /) between << and >>. Example: <<(15 * 3) / 5>>. The content between << and >> must contain only numbers and arithmetic operators, no words or variable names.");

// Reserve budget for forced final constrained answer span
var reserve: nat := 100;
if reserve > maxSteps {
  reserve := maxSteps;
}
var freeLimit: nat := maxSteps - reserve;

var steps: nat := 0;

// If we entered with insideConstrained=true, exit it cleanly first
if insideConstrainedOut {
  var rg0, rc0 := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg0;
  currentConstrainedOut := rc0;
  insideConstrainedOut := false;
  currentConstrainedOut := [];
}

// Free reasoning phase - purely unconstrained, ignore natural << emissions
// (they appear as text tokens, don't trigger constrained mode)
while steps < freeLimit
  invariant 0 <= steps <= freeLimit
  invariant freeLimit <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant |generated| <= |generatedPrefix| + steps
  decreases freeLimit - steps
{
  // insideConstrainedOut is always false here (we cleaned it up above and never set it)
  var next := helpers.UnconstrainedStep(lm, prompt, generated);
  steps := steps + 1;
  if next == eosToken {
    break;
  } else {
    generated := generated + [next];
  }
}

// Now force open a constrained span for the final answer
// We have at most 'reserve' steps remaining (maxSteps - freeLimit = reserve)
// steps <= freeLimit, so maxSteps - steps >= reserve
if steps < maxSteps {
  // Open the forced constrained span
  var fg, fi, fc := helpers.OpenConstrainedSpan(lm, generated);
  steps := steps + 1;
  generated := fg;
  insideConstrainedOut := fi;
  currentConstrainedOut := fc;

  // Drive constrained content until complete or budget exhausted
  while steps < maxSteps
    invariant steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant |generated| <= |generatedPrefix| + steps
    decreases maxSteps - steps
  {
    if !insideConstrainedOut {
      break;
    }

    // Try to close if complete
    var cg, ci, cc, closed := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
    steps := steps + 1;
    if closed {
      generated := cg;
      insideConstrainedOut := ci;
      currentConstrainedOut := cc;
      break;
    } else {
      // Not complete - check budget for another step
      if steps >= maxSteps {
        // No budget - rollback to complete and exit
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        insideConstrainedOut := false;
        currentConstrainedOut := [];
        break;
      }

      // Generate next constrained token
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next2 := helpers.AdaptiveConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken);
      steps := steps + 1;

      if next2 == eosToken {
        // EOS inside span - rollback to complete and try to close
        var rg, rc := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
        generated := rg;
        currentConstrainedOut := rc;
        if steps < maxSteps {
          var cg2, ci2, cc2, closed2 := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
          steps := steps + 1;
          if closed2 {
            generated := cg2;
            insideConstrainedOut := ci2;
            currentConstrainedOut := cc2;
          } else {
            insideConstrainedOut := false;
            currentConstrainedOut := [];
          }
        } else {
          insideConstrainedOut := false;
          currentConstrainedOut := [];
        }
        break;
      } else {
        var ag, ai, ac := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next2);
        generated := ag;
        insideConstrainedOut := ai;
        currentConstrainedOut := ac;
      }
    }
  }
}

// Final cleanup if still inside constrained span
if insideConstrainedOut {
  var rg3, rc3 := helpers.RollbackConstrainedToComplete(parser, generated, currentConstrainedOut);
  generated := rg3;
  currentConstrainedOut := rc3;
  insideConstrainedOut := false;
  currentConstrainedOut := [];
}

cost := steps;

