// Phase 4c: CloseSpanWithinBudget for second span
if insideConstrainedOut && steps < maxSteps {
  var remaining4c := maxSteps - steps;
  var spanBudget4c: nat := remaining4c;
  if spanBudget4c > 150 {
    spanBudget4c := 150;
  }
  if spanBudget4c > 0 {
    var wg4c, wi4c, wc4c := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, spanBudget4c);
    generated := wg4c;
    insideConstrainedOut := wi4c;
    currentConstrainedOut := wc4c;
    steps := steps + spanBudget4c;
    if !insideConstrainedOut {
      hasCompletedSpan := true;
    }
  }
}

// Phase 5: Force open span if still no completed span
if !insideConstrainedOut && !hasCompletedSpan && steps + 2 <= maxSteps {
  var fg, fi, fc := helpers.OpenConstrainedSpan(lm, generated);
  generated := fg;
  insideConstrainedOut := fi;
  currentConstrainedOut := fc;
  steps := steps + 1;

  var innerSteps5: nat := 0;
  var innerTokenCount5: nat := 0;
  var innerLimit5: nat := 80;

  while insideConstrainedOut && !hasCompletedSpan && steps < maxSteps && innerSteps5 < innerLimit5
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant |generated| <= |generatedPrefix| + steps
    decreases (maxSteps - steps) + (innerLimit5 - innerSteps5)
  {
    if innerTokenCount5 >= minInnerTokens {
      var cg5, ci5, cc5, closed5 := helpers.CloseSpanIfComplete(lm, parser, generated, currentConstrainedOut);
      if closed5 {
        generated := cg5;
        insideConstrainedOut := ci5;
        currentConstrainedOut := cc5;
        steps := steps + 1;
        hasCompletedSpan := true;
        break;
      }
    }
    var constrainedPrompt5 := prompt + generated[..|generated| - |currentConstrainedOut|];
    var next5 := helpers.ConstrainedStep(lm, parser, constrainedPrompt5, currentConstrainedOut, eosToken);
    steps := steps + 1;
    innerSteps5 := innerSteps5 + 1;
    if next5 == eosToken {
      break;
    } else {
      var ag5, ai5, ac5 := helpers.AppendConstrainedToken(lm, parser, generated, currentConstrainedOut, next5);
      generated := ag5;
      insideConstrainedOut := ai5;
      currentConstrainedOut := ac5;
      innerTokenCount5 := innerTokenCount5 + 1;
    }
  }

  if insideConstrainedOut && steps < maxSteps {
    var remainBudget5 := maxSteps - steps;
    if remainBudget5 > 60 {
      remainBudget5 := 60;
    }
    if remainBudget5 > 0 {
      var wg5, wi5, wc5 := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, remainBudget5);
      generated := wg5;
      insideConstrainedOut := wi5;
      currentConstrainedOut := wc5;
      steps := steps + remainBudget5;
    }
  }
}

// Phase 6: Final safety - use ALL remaining budget to close
if insideConstrainedOut && steps < maxSteps {
  var finalBudget := maxSteps - steps;
  if finalBudget > 0 {
    var wgf, wif, wcf := helpers.CloseSpanWithinBudget(lm, parser, prompt, generated, currentConstrainedOut, eosToken, finalBudget);
    generated := wgf;
    insideConstrainedOut := wif;
    currentConstrainedOut := wcf;
    steps := steps + finalBudget;
  }
}

cost := steps;


