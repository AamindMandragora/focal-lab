syncode: "<<" start ">>"

// Visible spans may be symbolic (contain variables) or purely numeric.
start: any_expr

// For CSD prefix parsing: same union so constrained decoding can close after
// either a symbolic or a numeric expression before ">>".
csd_start: any_expr ">>"
expr_only: any_expr


// Any expression - either symbolic (contains variables) or numeric (numbers only).
?any_expr: s_expr
         | n_expr

// ============================================================================
// NUMERIC EXPRESSIONS (N) - Contains ONLY numbers, NO variables
// ============================================================================

?n_expr: n_term
       | n_expr "+" n_term -> add
       | n_expr "-" n_term -> sub

?n_term: n_factor
       | n_term "*" n_factor -> mul
       | n_term "/" n_factor -> div
       | n_term "//" n_factor -> floordiv
       | n_term "%" n_factor -> mod

?n_factor: n_atom
         | "(" n_expr ")"

?n_atom: NUMBER
       | "int" "(" n_expr ")"

// ============================================================================
// SYMBOLIC EXPRESSIONS (S) - MUST contain at least one variable
// ============================================================================
// Logic: An operation is Symbolic if AT LEAST ONE operand is Symbolic.

?s_expr: s_term
       | s_expr "+" n_term -> add  // S + N -> S
       | n_expr "+" s_term -> add  // N + S -> S
       | s_expr "+" s_term -> add  // S + S -> S
       | s_expr "-" n_term -> sub
       | n_expr "-" s_term -> sub
       | s_expr "-" s_term -> sub

?s_term: s_factor
       | s_term "*" n_factor -> mul
       | n_term "*" s_factor -> mul
       | s_term "*" s_factor -> mul
       | s_term "/" n_factor -> div
       | n_term "/" s_factor -> div
       | s_term "/" s_factor -> div
       | s_term "//" n_factor -> floordiv
       | n_term "//" s_factor -> floordiv
       | s_term "//" s_factor -> floordiv
       | s_term "%" n_factor -> mod
       | n_term "%" s_factor -> mod
       | s_term "%" s_factor -> mod

?s_factor: s_atom
         | "(" s_expr ")"

?s_atom: VARIABLE
       | VARIABLE NUMBER      -> var_num
       | "int" "(" s_expr ")"

// ============================================================================
// TERMINALS
// ============================================================================

// Variables may be descriptive identifiers so the model can reuse names
// it introduces in the answer text, such as total, brokerage_fee, or o_new.
// Digits and underscores are allowed after the first character.
VARIABLE: /[a-zA-Z_][a-zA-Z0-9_]*/

NUMBER: /-?\d+(\.\d+)?/

%import common.WS
%ignore WS