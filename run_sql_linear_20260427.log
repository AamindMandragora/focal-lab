Strategy: // CSD_RATIONALE_BEGIN
// The observed failure pattern ("SELECT <id> <id> ,") shows that the prior
// strategy over-committed to single-token constrained decoding with almost no
// structural bias. Although syntax stayed valid, the decoder frequently emitted
// locally legal but globally poor SQL prefixes and then stopped in awkward
// places. For Spider, we want the grammar to dominate generation, but we also
// need stronger pressure toward complete SQL clause structure rather than bare
// identifier sequences.
//
// This revision changes two things.
//
// First, once we enter the constrained span, we use ConstrainedSymbol rather
// than raw token-by-token ConstrainedStep. ConstrainedSymbol lets the parser
// drive a short schema-valid chunk using the per-step token budget, which is
// better aligned with SQL keywords, identifiers, and punctuation as meaningful
// units. This reduces the tendency to stall after a few individually valid
// tokens.
//
// Second, we add explicit completion control. If the current constrained prefix
// is complete, we close the span immediately. If it is not complete, we ask
// ConstrainedSymbol for a short constrained extension. When that extension hits
// EOS, we stop immediately as required. Otherwise we continue with the returned
// valid prefix. This makes the whole budget focus on extending a single
// grammar-valid SQL query until the parser itself recognizes completeness,
// rather than speculating outside the grammar or spending steps on branches that
// do not append useful SQL structure.
//
// We still open the constrained span immediately, ensuring the output contains
// << >> and that essentially all generated content is schema-aware SQL.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - OpenConstrainedSpan branch: the helper starts a constrained region with
//     empty constrained content, and parser.IsValidPrefix([]) is a precondition.
//   - CloseConstrainedSpan branch: we call it only after proving the current
//     constrained prefix is complete; afterward insideConstrainedOut is false, so
//     the implication is vacuous.
//   - ConstrainedSymbol branch: the helper returns currentOut that remains a
//     valid parser prefix; if hitEos is true we break with that returned state,
//     otherwise we continue with the same valid prefix.
//
// suffix:
//   - OpenConstrainedSpan branch: currentConstrainedOut becomes [], so the suffix
//     equality holds trivially.
//   - CloseConstrainedSpan branch: currentConstrainedOut becomes [], making the
//     implication vacuous.
//   - ConstrainedSymbol branch: the helper extends generated and the tracked
//     constrained content consistently, so the constrained content remains the
//     suffix of generated; if hitEos is true we break with that preserved state.
//
// cost accounting:
//   - steps is the only returned cost measure, and we assign cost := steps at
//     the end.
//   - OpenConstrainedSpan and CloseConstrainedSpan each consume one step, so we
//     increment steps by 1 in those branches.
//   - ConstrainedSymbol returns stepsUsed, and we increment steps by exactly
//     stepsUsed. The branch is only entered when steps < maxSteps, and we cap
//     the symbol budget by the remaining step budget, so steps never exceeds
//     maxSteps.
//
// progress:
//   - OpenConstrainedSpan appends exactly 1 token and we increment steps by 1.
//   - CloseConstrainedSpan appends exactly 1 token and we increment steps by 1.
//   - ConstrainedSymbol appends exactly the amount reflected by stepsUsed and we
//     increment steps by stepsUsed; if hitEos is true we may break immediately,
//     but the linear bound |generated| <= |generatedPrefix| + steps is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var remaining := maxSteps - steps;
      var symbolBudget := stepTokenBudget;
      if remaining < symbolBudget {
        symbolBudget := remaining;
      }
      var constrainedPrompt := prompt + generated;
      var currentOut, hitEos, stepsUsed := helpers.ConstrainedSymbol(
        lm, parser, constrainedPrompt, currentConstrainedOut, symbolBudget, eosToken
      );
      generated := generated + currentOut[|currentConstrainedOut|..];
      currentConstrainedOut := currentOut;
      insideConstrainedOut := true;
      steps := steps + stepsUsed;
      if hitEos {
        break;
      }
    }
  }
}

cost := steps;

