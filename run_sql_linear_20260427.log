Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy was syntactically safe but too passive inside the SQL
// span: ConstrainedSymbol often accepted tiny parser-valid fragments such as
// " SELECT <id>" and then stalled or ended before assembling a full query.
// For Spider, accuracy depends on driving the constrained span all the way to a
// complete SQL statement, not merely staying prefix-valid.
//
// The revised strategy keeps chunked decoding outside the span, but replaces the
// inner decoding policy with a more directed token-by-token constrained search.
// Inside the span:
//   (1) if the current SQL prefix is already complete, we immediately emit ">>";
//   (2) otherwise we ask for a small set of top valid candidates under the
//       schema-specialized grammar;
//   (3) we strongly boost those valid candidates and heavily penalize eosToken so
//       EOS does not prematurely terminate an unfinished SQL query;
//   (4) we sample one token, and only append it when parser validation confirms
//       it is a valid next token;
//   (5) if the valid-candidate set is empty, we conservatively stop rather than
//       corrupt the constrained state.
//
// This directly addresses the observed failure mode of short incomplete SQL
// outputs: the decoder now repeatedly commits valid grammar-approved tokens
// until completion, and only then closes the constrained span. The design still
// respects EOS terminality, uses the parser as the source of truth, and keeps
// the full answer text in generated while currentConstrainedOut stores only the
// SQL payload between delimiters.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span chunk branch, either we remain outside,
//   or we open a new constrained span with currentConstrainedOut := [], and
//   parser.IsValidPrefix([]) holds by precondition. In the complete-prefix
//   branch, CloseConstrainedSpan returns outside the span, so the implication is
//   vacuous. In the candidate-driven append branch, we first require
//   IsTokenValidNext(parser, currentConstrainedOut, next); then
//   AppendConstrainedToken updates currentConstrainedOut to the extended prefix,
//   which remains parser-valid. In the no-candidate / invalid-sample / EOS
//   branches we break without mutating the constrained state.
// suffix: In the outside-span chunk branch, if we open a span we set
//   currentConstrainedOut := [], whose length-0 suffix matches generated. In
//   the close branch, CloseConstrainedSpan resets currentConstrainedOut to [],
//   so the implication is vacuous. In the append branch, let stablePrefix be
//   generated without the old constrained suffix; AppendConstrainedToken returns
//   generated = stablePrefix + newCurrent and currentConstrainedOut = newCurrent,
//   so the generated suffix is exactly currentConstrainedOut. Break branches do
//   not change state.
// progress: In the outside-span branch, UnconstrainedChunk appends stepsUsed
//   tokens and we increment steps by stepsUsed. In the close branch,
//   CloseConstrainedSpan appends exactly 1 token and we increment steps by 1. In
//   the append branch, we choose exactly one token with ChooseNextToken and then
//   AppendConstrainedToken appends exactly that one token, so incrementing steps
//   by 1 preserves |generated| <= |generatedPrefix| + steps. The remaining
//   branches break immediately without changing steps or generated.
// cost_accounting: We maintain cost == 0 throughout the loop and use a local
//   steps counter as the only returned cost. Every mutating generation action in
//   the loop increments steps by the exact number of appended tokens: chunk by
//   stepsUsed, close by 1, append by 1. Thus steps <= maxSteps by invariant, and
//   assigning cost := steps at the end establishes cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else {
      if stoppedOpen {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var candidates := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 8, eosToken);
      if |candidates| == 0 {
        break;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        lm.GenerateLogits(prompt + stablePrefix + currentConstrainedOut);
        helpers.BoostTokenLogits(lm, candidates, 100.0);
        helpers.PenalizeTokenLogits(lm, [eosToken], 100.0);
        var next := lm.ChooseNextToken();
        helpers.cost := helpers.cost + 1;
        if next == eosToken {
          break;
        } else {
          var validNext := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
          if validNext {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
            steps := steps + 1;
          } else {
            break;
          }
        }
      }
    }
  }
}

cost := steps;

