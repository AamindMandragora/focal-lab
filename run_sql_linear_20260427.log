Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL generation benefits from spending most tokens inside a
// schema-constrained SQL span while still allowing a short unconstrained prefix
// before the delimiter appears. The strategy therefore tracks (1) the full
// generated output, (2) whether we are currently inside the constrained SQL
// span, and (3) the current constrained suffix alone, which is the parser state
// carrier used for grammar validation against the schema-narrowed SQL grammar.
// Outside the span, we amortize work with UnconstrainedChunk so natural-language
// preamble or formatting can be emitted cheaply until either "<<" opens the SQL
// span or EOS is produced. Inside the span, we use ConstrainedSymbol with the
// provided stepTokenBudget so one iteration can accept a whole valid SQL symbol
// or short phrase, which matches SQL keywords, identifiers, and operators
// better than pure token-by-token decoding. As soon as the parser reports that
// the current SQL prefix is complete, we close the span with CloseConstrainedSpan;
// we never close merely because some sampled token looks like ">>".
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   - UnconstrainedChunk branch: if no span opens, insideConstrainedOut stays
//     false, so the implication is vacuous. If stoppedOnOpenSpan, we set
//     currentConstrainedOut := [], and parser.IsValidPrefix([]) holds by the
//     method precondition.
//   - Complete-prefix branch: we call CloseConstrainedSpan only when
//     parser.IsCompletePrefix(currentConstrainedOut) is already known; the
//     helper returns outside the span, so the implication becomes vacuous.
//   - ConstrainedSymbol branch: the helper returns symbolOut that is still a
//     valid parser prefix, and we assign currentConstrainedOut := symbolOut.
//   - Break-on-EOS paths do not modify the tracked constrained state after the
//     helper result is observed, so the invariant is preserved.
//
// suffix:
//   - UnconstrainedChunk branch: when no span opens, insideConstrainedOut stays
//     false, so the implication is vacuous. When stoppedOnOpenSpan, we set
//     currentConstrainedOut := []; the empty suffix always matches the last
//     |[]| tokens of generated.
//   - Complete-prefix branch: CloseConstrainedSpan appends the closing delimiter
//     and resets currentConstrainedOut to [], so the implication is vacuous.
//   - ConstrainedSymbol branch: letting stablePrefix be generated without the
//     old constrained suffix, we set generated := stablePrefix + symbolOut and
//     currentConstrainedOut := symbolOut, so generated[|generated| -
//     |currentConstrainedOut|..] == currentConstrainedOut holds directly.
//   - Break-on-EOS leaves generated/currentConstrainedOut as assigned by the
//     helper result, so the same reasoning still applies.
//
// cost accounting:
//   - We return cost := steps, with a loop invariant cost == 0, so only steps
//     matters for the postcondition.
//   - UnconstrainedChunk increases steps by stepsUsed; CloseConstrainedSpan
//     increases steps by 1; ConstrainedSymbol increases steps by stepsUsed.
//     Every branch either increases steps by the exact helper-reported amount
//     or breaks immediately, so steps never exceeds maxSteps because each helper
//     is called with a remaining budget.
//   - Therefore cost := steps at the end implies cost <= maxSteps.
//
// progress:
//   - UnconstrainedChunk branch: generated grows by at most stepsUsed tokens and
//     we set steps := steps + stepsUsed, so |generated| <= |generatedPrefix| +
//     steps is preserved by linear arithmetic.
//   - Complete-prefix branch: CloseConstrainedSpan appends exactly one token and
//     we increment steps by 1, preserving the same bound.
//   - ConstrainedSymbol branch: generated becomes stablePrefix + symbolOut; the
//     helper reports stepsUsed tokens consumed, and symbolOut extends the prior
//     constrained content by at most those stepsUsed tokens, so the bound is
//     preserved when steps := steps + stepsUsed.
//   - Break branches stop immediately after one of the above updates, so the
//     invariant already holds at loop exit.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpenSpan {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var remainingBudget: nat := maxSteps - steps;
      var symbolBudget: nat := if stepTokenBudget < remainingBudget then stepTokenBudget else remainingBudget;
      var symbolOut, hitEos, stepsUsed := helpers.ConstrainedSymbol(
        lm, parser, constrainedPrompt, currentConstrainedOut, symbolBudget, eosToken
      );
      generated := stablePrefix + symbolOut;
      insideConstrainedOut := true;
      currentConstrainedOut := symbolOut;
      steps := steps + stepsUsed;
      if hitEos {
        break;
      }
    }
  }
}

