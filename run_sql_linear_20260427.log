Strategy: // CSD_RATIONALE_BEGIN
// The prior strategy under-generated inside the SQL span by forcing essentially
// one-token constrained growth per loop iteration and by relying on a generic
// constrained-symbol helper that often left the model in awkward delimiter /
// completion states. The observed failures (`... <id>>><id> ...`) suggest that
// the system was frequently closing or continuing the constrained span at poor
// boundaries rather than strongly steering toward a single complete SQL query.
//
// This revision changes the decoding policy substantially:
//
// 1. Outside the constrained span, we still use unconstrained chunking to find
//    the opening delimiter `<<` quickly.
// 2. Inside the constrained span, we no longer ask for an arbitrary constrained
//    symbol chunk. Instead, each loop iteration performs one explicitly guided
//    constrained token step via `helpers.ConstrainedStep`.
// 3. Before that step, we shape logits using parser-aware candidate analysis:
//    - if the current SQL prefix is complete, we immediately close with `>>`;
//    - if the parser reports a near-dead-end, we strongly boost top valid
//      parser-approved candidates;
//    - otherwise, we mildly boost several top valid candidates.
//    This keeps generation tightly aligned with schema-valid SQL continuations.
// 4. Every constrained token is appended with `AppendConstrainedToken`, which
//    preserves the invariant that `currentConstrainedOut` is exactly the active
//    SQL contents and that `generated` ends with that contents while inside the
//    span.
// 5. EOS remains terminal: if the guided constrained step returns EOS, we stop
//    immediately rather than attempting recovery.
//
// The intent is to improve Spider accuracy by making the SQL span a clean,
// parser-driven single query between `<<` and `>>`, while retaining simple,
// verifiable step accounting.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
// - Unconstrained chunk branch: if we stay outside, the implication is vacuous.
//   If the chunk stops on `<<`, we enter constrained mode with
//   `currentConstrainedOut := []`, and `parser.IsValidPrefix([])` is given.
// - Complete-prefix branch: `CloseConstrainedSpan` is called only after
//   `parser.IsCompletePrefix(currentConstrainedOut)` is established; it returns
//   outside constrained mode, so the implication is vacuous afterward.
// - Guided constrained-token branch: parser-query helpers do not mutate the
//   tracked prefixes. `ConstrainedStep` chooses a parser-valid next token (or
//   EOS), and when the token is not EOS we update via `AppendConstrainedToken`,
//   which returns a parser-valid new constrained prefix.
//
// suffix:
// - Unconstrained chunk branch: while outside the implication is vacuous; when
//   we open a span, `currentConstrainedOut` becomes `[]`, which is the suffix of
//   `generated` of length 0.
// - Complete-prefix branch: `CloseConstrainedSpan` appends the closing
//   delimiter and resets `currentConstrainedOut` to `[]`, so the suffix claim is
//   trivial.
// - Guided constrained-token branch: let `stablePrefix` be
//   `generated[..|generated| - |currentConstrainedOut|]`. By the loop invariant,
//   `generated == stablePrefix + currentConstrainedOut`. `AppendConstrainedToken`
//   updates the generated text to `stablePrefix + newCurrent`, so the final
//   suffix of length `|newCurrent|` is exactly `newCurrent`.
//
// progress:
// - Unconstrained chunk branch: `UnconstrainedChunk` appends `stepsUsed` tokens
//   and we set `steps := steps + stepsUsed`, with `chunkBudget` chosen no larger
//   than the remaining budget. Hence `|generated| <= |generatedPrefix| + steps`
//   and `steps <= maxSteps` are preserved.
// - Complete-prefix branch: `CloseConstrainedSpan` appends exactly 1 token and
//   we increment `steps` by 1; the loop guard gives enough remaining budget.
// - Guided constrained-token branch: `ConstrainedStep` consumes exactly 1 step;
//   if it returns EOS we increment `steps` by 1 and break immediately with no
//   further growth of `generated`. Otherwise `AppendConstrainedToken` appends
//   exactly 1 token and we increment `steps` by 1, preserving the linear bound
//   on generated length.
//
// cost accounting:
// - `cost` is initialized to 0 and left unchanged throughout the loop, so the
//   invariant `cost == 0` is preserved in every branch.
// - Returned cost is `steps`. The outside chunk branch adds `stepsUsed`, the
//   close branch adds 1, and the guided constrained-token branch adds 1. Since
//   each branch respects the remaining budget, `steps <= maxSteps` always
//   holds, and therefore `cost := steps` satisfies `cost <= maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var remaining := maxSteps - steps;
    var chunkBudget: nat := remaining;
    var chunkedGenerated, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 3);
      var candidateCap: nat := 3;
      if validCount >= 5 {
        candidateCap := 5;
      }
      var candidates := helpers.TopValidCandidates(
        lm, parser, prompt, currentConstrainedOut, candidateCap, eosToken
      );
      if |candidates| > 0 {
        if narrow {
          helpers.BoostTokenLogits(lm, candidates, 8.0);
        } else {
          helpers.BoostTokenLogits(lm, candidates, 3.0);
        }
      }
      var next := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, stablePrefix + currentConstrainedOut, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

