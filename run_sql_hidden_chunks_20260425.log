Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy still let the model emit unconstrained material before
// the SQL body, and the evaluation trace `SELECT <id>>>` strongly suggests that
// the benchmark expects the actual answer itself to be the single constrained
// SQL query, wrapped once by the delimiter protocol, with no free-form prelude
// and no early closing after a short complete prefix.
//
// This revision therefore switches to a stricter single-span policy tailored to
// Spider:
//
// 1. If generation starts outside a constrained span, we immediately open one.
//    There is no unconstrained prelude at all.
// 2. Once inside the span, every non-EOS token is produced by
//    `ConstrainedStep` and appended with `AppendConstrainedToken`, so the SQL
//    body is parser-valid token-by-token.
// 3. We never close merely because a prefix is complete. Instead, we keep
//    generating under parser control until either EOS is chosen or the step
//    budget is exhausted. Only after we already have a complete SQL prefix do we
//    allow a single explicit close step.
// 4. If the budget ends while still inside, we close only when the current
//    constrained prefix is complete; otherwise we leave the span open rather
//    than fabricate an invalid termination.
//
// This directly addresses the observed failure mode by removing unconstrained
// SQL-like output outside the delimiters and by ensuring the substantive query
// is generated entirely inside one constrained segment.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open-span branch, OpenConstrainedSpan enters
//   constrained mode with empty currentConstrainedOut, which is valid because
//   parser.IsValidPrefix([]) holds. In the constrained-generation branch,
//   ConstrainedStep returns either EOS (after which state is unchanged) or a
//   valid next token, and AppendConstrainedToken preserves parser validity of
//   the extended constrained prefix. In the close branch, CloseConstrainedSpan
//   exits constrained mode, so the implication becomes vacuous.
// suffix: Before opening, if we are outside constrained mode the implication is
//   vacuous. OpenConstrainedSpan sets currentConstrainedOut to [], so the suffix
//   property is immediate. AppendConstrainedToken appends the same token to both
//   generated and currentConstrainedOut, preserving that the active constrained
//   content is exactly the suffix of generated. CloseConstrainedSpan resets
//   currentConstrainedOut to [], making the implication vacuous again.
// cost: The only cost-bumping helpers used are OpenConstrainedSpan,
//   ConstrainedStep, and CloseConstrainedSpan, each bumping helpers.cost by 1.
//   Every iteration performs at most one such helper before steps is increased
//   by 1, except the final close-after-loop branch, which also increments steps
//   once for its single cost-bumping helper; thus helpers.cost <= steps is
//   preserved.
// progress: OpenConstrainedSpan adds one delimiter token while steps increases
//   by 1. In constrained generation, either EOS is returned and generated does
//   not grow, or one token is appended while steps increases by 1. The close
//   branch adds one delimiter token with one additional step. Therefore
//   generated grows by at most one token per counted step, preserving
//   |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var stop := false;

while steps < maxSteps && !stop
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var next := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
    steps := steps + 1;
    if next == eosToken {
      stop := true;
    } else {
      var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
        lm, parser, generated, currentConstrainedOut, next
      );
      generated := appendedGenerated;
      insideConstrainedOut := appendedInside;
      currentConstrainedOut := appendedCurrent;
    }
  }
}

if insideConstrainedOut && steps < maxSteps {
  var completeAtEnd := parser.IsCompletePrefix(currentConstrainedOut);
  if completeAtEnd {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  }
}

cost := steps;

