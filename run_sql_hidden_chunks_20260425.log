Strategy: // CSD_RATIONALE_BEGIN
// The prior strategy guaranteed syntactic validity inside the constrained span,
// but it stopped as soon as the SQL prefix became complete and then closed the
// span immediately. The evaluation traces like `SELECT count>>` indicate that
// this was far too eager: Spider answers are usually longer complete queries,
// and the grammar can mark short prefixes as complete before the semantically
// correct query has been finished.
//
// This revision changes the policy in two important ways:
//
// 1. We still force a single constrained SQL span with no unconstrained prelude,
//    because the benchmark expects the answer itself to be one SQL query.
// 2. Inside that span, we distinguish between "valid continuation exists" and
//    "dead end / natural stopping point". We do not close merely because the
//    current prefix is complete. Instead, we keep generating constrained tokens
//    while the parser reports that there are valid continuations. Only when the
//    prefix is complete and there are zero valid next tokens do we stop and
//    close. This avoids truncating queries at short complete prefixes such as
//    `SELECT count`.
// 3. If the model emits EOS while inside the constrained span, we stop
//    immediately as required; afterwards, if the current constrained prefix is
//    complete and budget remains, we close the span once.
// 4. If the budget expires mid-query, we preserve the valid constrained prefix;
//    we close only when the parser says the prefix is complete.
//
// This is still verifier-friendly because every generated SQL token comes from
// ConstrainedStep and is appended only through AppendConstrainedToken, while the
// new stopping rule is driven by parser completeness plus zero valid-next-token
// count rather than completeness alone.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open branch, OpenConstrainedSpan produces an empty
//   constrained prefix, and [] is valid by precondition. In the constrained
//   branch, the "stop" sub-branch only reads parser state and leaves
//   currentConstrainedOut unchanged, so validity is preserved. In the generation
//   sub-branch, ConstrainedStep chooses a parser-allowed next token (or EOS);
//   if EOS appears we leave the constrained prefix unchanged, and otherwise
//   AppendConstrainedToken extends it with that valid token, preserving parser
//   validity. In the closing branch, CloseConstrainedSpan exits constrained
//   mode, making the implication vacuous.
// suffix: OpenConstrainedSpan starts a fresh constrained span with
//   currentConstrainedOut == [], so the suffix relation is immediate. The stop
//   and EOS sub-branches do not modify generated or currentConstrainedOut, so
//   the existing suffix relation remains true. AppendConstrainedToken appends
//   the same token to generated and to currentConstrainedOut, so the active
//   constrained content remains exactly the suffix of generated. CloseConstrainedSpan
//   clears currentConstrainedOut, making the implication vacuous.
// cost: The only cost-bumping helpers used are OpenConstrainedSpan,
//   ConstrainedStep, and CloseConstrainedSpan, each contributing at most one
//   unit when called. Every loop iteration increments steps by exactly one;
//   branches that do not call a cost-bumping helper still preserve
//   helpers.cost <= steps because only steps increases. The post-loop close
//   branch also increments steps once when it calls CloseConstrainedSpan, so the
//   inequality remains true.
// progress: OpenConstrainedSpan adds one delimiter token while steps increases
//   by one. In the stop and EOS sub-branches, generated does not grow while
//   steps does. In the append sub-branch, exactly one token is appended to
//   generated and steps increases by one. The post-loop close branch adds one
//   delimiter token with one additional counted step. Hence generated grows by
//   at most one token per counted step, preserving
//   |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var stop := false;

while steps < maxSteps && !stop
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
    if completeNow && validCount == 0 {
      stop := true;
      steps := steps + 1;
    } else {
      var next := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        stop := true;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

if insideConstrainedOut && steps < maxSteps {
  var completeAtEnd := parser.IsCompletePrefix(currentConstrainedOut);
  if completeAtEnd {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
    );
    generated := closedGenerated;
    insideConstrainedOut := closedInside;
    currentConstrainedOut := closedCurrent;
    steps := steps + 1;
  }
}

cost := steps;

