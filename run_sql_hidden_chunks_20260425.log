Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL often benefits from staying unconstrained for ordinary
// narration/preamble tokens but switching quickly into grammar-constrained SQL
// once a delimiter-like cue appears. This strategy tracks the full generated
// output in `generated`, whether we are currently inside a constrained SQL span
// in `insideConstrainedOut`, and the SQL-only contents of that active span in
// `currentConstrainedOut`.
// 
// Outside a constrained span, we sample one token unconstrained. If that token
// is the explicit opener "<<" we enter constrained mode immediately. We also
// proactively open a constrained span when the sampled token contains "<<":
// this is useful for schema-heavy prompts where the model may emit a token that
// fuses text with the opening delimiter. Inside a constrained span, we use the
// parser state to choose between three actions: close immediately when the SQL
// prefix is complete; use a speculative argmax fast path when the model's top
// token is parser-valid; otherwise fall back to `ConstrainedStep`, which uses
// the parser to obtain a valid next SQL token.
// 
// The tracked constrained suffix supports validity because, while
// `insideConstrainedOut` is true, `currentConstrainedOut` is always maintained
// as exactly the generated suffix after the opening delimiter and is only
// extended through parser-validated appends. That lets us safely query parser
// completeness, valid-next checks, and constrained decoding helpers.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if we stay outside a span the
//   implication is vacuous; if we enter because next == "<<" or Contains(next,
//   "<<"), we set currentConstrainedOut := [], which is valid by precondition.
//   In the complete-prefix branch, CloseConstrainedSpan makes
//   insideConstrainedOut false, so the implication is vacuous. In the
//   speculative constrained branch, we call AppendConstrainedToken only after
//   IsTokenValidNext returned true, so the new constrained prefix remains
//   parser-valid. In the fallback constrained branch, ConstrainedStep provides
//   a valid next token (or EOS, which breaks), and appending preserves validity.
// suffix: Outside a span, no suffix obligation is required; when we newly enter
//   a span we set currentConstrainedOut := [], and the length-0 suffix of
//   generated is []. CloseConstrainedSpan appends the closing delimiter and
//   resets currentConstrainedOut to [], so the invariant holds trivially. In
//   both constrained append branches, AppendConstrainedToken appends the same
//   token to generated and currentConstrainedOut, preserving the suffix match.
// cost: UnconstrainedStep, ConstrainedStep, and CloseConstrainedSpan each bump
//   helpers.cost by 1 internally, and we increment steps by 1 in the same
//   iteration. In the speculative argmax branch, GenerateLogits and
//   GetHighestLogitToken / IsTokenValidNext do not bump helpers.cost, and
//   AppendConstrainedToken also does not bump, while we still increment steps;
//   therefore helpers.cost <= steps is preserved with slack.
// progress: In the unconstrained branch we append at most one sampled token.
//   In the close branch we append only the closing delimiter once. In each
//   constrained append branch we append exactly one SQL token. Since steps grows
//   by 1 on every iteration and no branch appends more than one token (modulo
//   the helper-based close step counted as one generation action), we preserve
//   |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        if Contains(next, "<<") {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);
      if argmaxValid && argmax != eosToken {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

cost := steps;

