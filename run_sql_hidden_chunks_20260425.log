Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy let the model spend many steps outside the SQL grammar
// and also used a speculative argmax path inside the constrained span. On
// Spider, that produced syntactically valid-but-wrong SQL with repeated alias /
// placeholder-like fragments, indicating that unconstrained freedom and local
// argmax bias were both hurting exact-match accuracy.
// 
// This revision switches to a schema-first strategy: as soon as generation is
// not already inside a constrained span, it opens one immediately and then keeps
// all substantive generation under the SQL parser. Inside the span, it avoids
// the old speculative append path entirely and delegates token choice to
// `ConstrainedStep`, so every SQL token is selected through parser-aware
// constrained decoding rather than raw argmax over logits.
// 
// To reduce repetition loops, the strategy also closes the constrained span as
// soon as the parser reports a complete SQL prefix. This encourages emitting a
// single finished query inside `<< ... >>` instead of continuing to elaborate or
// cycle through extra clauses. EOS remains terminal in every branch.
// 
// The key state discipline is unchanged: `generated` stores the full answer
// including delimiters, while `currentConstrainedOut` stores only the active SQL
// contents. Opening a span sets `currentConstrainedOut` to empty; each
// constrained token is appended to both `generated` and
// `currentConstrainedOut`; closing the span resets `currentConstrainedOut` to
// empty and leaves constrained mode.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the open-span branch, OpenConstrainedSpan starts a fresh
//   constrained segment with empty currentConstrainedOut, which is a valid
//   parser prefix by precondition. In the close branch, CloseConstrainedSpan
//   sets insideConstrainedOut false, so the implication is vacuous. In the
//   constrained-token branch, ConstrainedStep chooses a parser-valid next token
//   (or EOS, which breaks), and AppendConstrainedToken preserves parser
//   validity of the extended constrained prefix.
// suffix: After opening, currentConstrainedOut is [], which equals the
//   length-zero suffix of generated. After closing, currentConstrainedOut is []
//   again, so the invariant is trivial. In the constrained-token branch,
//   AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, preserving that the constrained content is exactly
//   the suffix of generated while insideConstrainedOut is true.
// cost: OpenConstrainedSpan, CloseConstrainedSpan, and ConstrainedStep are the
//   only cost-bumping helpers used, and each bumps helpers.cost by 1 internally.
//   We increment steps by 1 in the same iteration in every non-break path, so
//   helpers.cost <= steps is preserved.
// progress: Each loop iteration performs exactly one generation action: open a
//   span, close a span, or produce one constrained token. Thus generated grows
//   by at most one token per increment of steps, preserving
//   |generated| <= |generatedPrefix| + steps. If ConstrainedStep returns EOS we
//   break immediately after incrementing steps, without appending further
//   tokens, so the bound still holds.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

