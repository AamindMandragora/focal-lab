Strategy: // CSD_RATIONALE_BEGIN
// The last strategy was too eager to open a constrained span at the very first
// step and too eager to close it the moment the parser reported completeness.
// On Spider, that interacted badly with the delimiter protocol: the model often
// produced a tiny complete SQL prefix such as `SELECT count`, immediately closed
// with `>>`, then reopened `<<` and repeated. That explains both the observed
// `SELECT count>><< ...` pattern and the high repetition-loop count despite
// perfect syntax.
//
// This revision changes the control policy in two ways.
//
// First, it allows exactly one unconstrained step before any constrained span is
// opened. This gives the model one chance to emit the expected opening
// delimiter/context token naturally instead of forcing an immediate helper-based
// open at position 0. After that single outside step, if we are still outside a
// constrained span, we force opening and keep the substantive SQL generation
// under the parser.
//
// Second, inside a constrained span we no longer close immediately on the first
// complete prefix. Instead, when the parser says the current SQL is complete, we
// bias the next action toward termination: if the highest-logit valid
// continuation is EOS, we stop; otherwise we close the span once and then stop
// the loop rather than permitting reopen/close cycling. While the span is still
// incomplete, we continue to use parser-aware `ConstrainedStep` and
// `AppendConstrainedToken`, so every SQL token remains grammar-valid.
//
// The resulting strategy is single-query oriented: optional one-token prelude,
// one constrained SQL segment, then terminate as soon as a complete query is
// available. This directly targets the measured failure mode of repeated
// `>><<` oscillation while preserving the required `<< >>` structure and parser
// validity.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the one-time unconstrained-outside branch, we either stay
//   outside constrained mode (so the implication is vacuous) or, if EOS is
//   sampled, break without changing constrained state. In the forced-open
//   branch, OpenConstrainedSpan creates an empty constrained prefix, which is
//   parser-valid. In the complete-and-close branch, CloseConstrainedSpan leaves
//   constrained mode, so the implication is vacuous. In the constrained-token
//   branch, ConstrainedStep returns a parser-valid next token (or EOS, which
//   causes a break), and AppendConstrainedToken preserves validity of the
//   extended constrained prefix.
// suffix: Outside-constrained branches keep currentConstrainedOut == [], so the
//   suffix property is trivial. OpenConstrainedSpan sets currentConstrainedOut
//   to [], again making the property trivial. CloseConstrainedSpan resets
//   currentConstrainedOut to []. In the constrained-token branch,
//   AppendConstrainedToken appends the chosen token to both generated and
//   currentConstrainedOut, preserving that the active constrained content is the
//   suffix of generated.
// cost: The only cost-bumping operations used are UnconstrainedStep,
//   OpenConstrainedSpan, ConstrainedStep, and CloseConstrainedSpan, each of
//   which bumps helpers.cost by 1 internally. Every non-break iteration that
//   uses one of these helpers also increments steps by 1 exactly once, so
//   helpers.cost <= steps is preserved in every branch.
// progress: The unconstrained step appends at most one token to generated while
//   steps increases by 1. OpenConstrainedSpan and CloseConstrainedSpan each add
//   at most one delimiter token per step. The constrained-token branch appends
//   at most one SQL token per step; if ConstrainedStep returns EOS, we break
//   after increasing steps and append nothing further. Hence in all branches
//   generated grows by at most one token per counted step, preserving
//   |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var usedPrelude := insideConstrained;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  invariant insideConstrained ==> usedPrelude
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if !usedPrelude {
      var nextOutside := helpers.UnconstrainedStep(lm, prompt, generated);
      steps := steps + 1;
      usedPrelude := true;
      if nextOutside == eosToken {
        break;
      } else {
        generated := generated + [nextOutside];
      }
    } else {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var nextIfContinue := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if nextIfContinue == eosToken {
        break;
      } else {
        if steps < maxSteps {
          var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
            lm, parser, generated, currentConstrainedOut
          );
          generated := closedGenerated;
          insideConstrainedOut := closedInside;
          currentConstrainedOut := closedCurrent;
          steps := steps + 1;
        }
        break;
      }
    } else {
      var constrainedPrompt2 := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt2, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

