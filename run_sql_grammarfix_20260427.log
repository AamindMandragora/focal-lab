            done := true;
          } else {
            done := true;
          }
        }
      } else {
        if stepTokenBudget == 0 {
          done := true;
        } else {
          var remaining := maxSteps - steps;
          if remaining == 0 {
            done := true;
          } else {
            var localBudget := stepTokenBudget;
            if remaining < localBudget {
              localBudget := remaining;
            }
            var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
            var constrainedPrompt := prompt + stablePrefix;
            var currentOut, hitEos, stepsUsed := helpers.ConstrainedSymbol(
              lm, parser, constrainedPrompt, currentConstrainedOut, localBudget, eosToken
            );
            generated := stablePrefix + currentOut;
            currentConstrainedOut := currentOut;
            steps := steps + stepsUsed;
            if hitEos || stepsUsed == 0 {
              done := true;
            }
          }
        }
      }
    }
  }

  cost := steps;
}

