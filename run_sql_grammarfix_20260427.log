Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL generation benefits from tracking whether we are inside
// the SQL span and, when inside, the exact constrained SQL prefix currently
// being built. The strategy uses two observations to choose actions:
// (1) outside the span, SQL often starts abruptly after a delimiter, so we
// chunk unconstrained decoding until either EOS or "<<" appears;
// (2) inside the span, SQL alternates between narrow grammar points (keywords,
// punctuation, clause transitions) and wider semantic points (schema-linked
// identifiers, expressions). We therefore query the parser's valid-next count:
// when narrow, use token-level ConstrainedStep; when wider, use
// ConstrainedSymbol to accept a longer valid parser prefix in one step.
// This tracked state supports validity because currentConstrainedOut is always
// the parser-validated suffix of generated inside the span, and closing is only
// attempted once parser.IsCompletePrefix(currentConstrainedOut) holds.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span chunk branch, insideConstrainedOut stays
//   false unless UnconstrainedChunk stops on "<<"; then we set
//   currentConstrainedOut := [], and parser.IsValidPrefix([]) holds by the
//   method precondition. In the complete-prefix branch, CloseConstrainedSpan
//   flips insideConstrainedOut to false, so the implication becomes vacuous.
//   In the narrow inside branch, ConstrainedStep returns either EOS (break) or
//   a parser-valid next token; AppendConstrainedToken therefore preserves
//   parser.IsValidPrefix. In the wide inside branch, ConstrainedSymbol returns
//   a parser-valid symbolOut, which we assign to currentConstrainedOut.
// suffix: Outside the span the implication is vacuous; when chunking stops on
//   "<<", generated already ends with that delimiter and we set
//   currentConstrainedOut := [], so the length-0 suffix matches []. In the
//   complete-prefix branch, CloseConstrainedSpan appends the closing delimiter
//   and resets currentConstrainedOut to [], making the suffix condition
//   immediate. In the narrow branch, AppendConstrainedToken appends the same
//   token to generated and currentConstrainedOut. In the wide branch, writing
//   generated := stablePrefix + symbolOut and currentConstrainedOut := symbolOut
//   makes the suffix equality hold by construction.
// progress: Outside the span, UnconstrainedChunk appends at most stepsUsed
//   tokens and we do steps := steps + stepsUsed. In the complete-prefix branch,
//   CloseConstrainedSpan appends exactly one token and we increment steps by 1.
//   In the narrow branch, ConstrainedStep contributes one token attempt and
//   AppendConstrainedToken appends one token, so steps += 1. In the wide
//   branch, ConstrainedSymbol appends a valid extension of length accounted for
//   by stepsUsed, and we do steps := steps + stepsUsed. Break branches append
//   nothing further, so |generated| <= |generatedPrefix| + steps is preserved.
// cost accounting: The loop keeps cost == 0 as an invariant and uses a local
//   steps counter as the sole returned accounting. UnconstrainedChunk and
//   ConstrainedSymbol internally bump helper cost by stepsUsed, while
//   CloseConstrainedSpan and ConstrainedStep bump by 1, but the returned cost
//   is set only once at the end via cost := steps. Every non-break branch
//   increases steps by exactly the amount of generation work performed, so
//   final cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var narrowThreshold: nat := 12;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpenSpan {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= narrowThreshold {
        var next := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var symbolBudget: nat := maxSteps - steps;
        var symbolOut, hitEos, stepsUsed2 := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, symbolBudget, eosToken
        );
        generated := stablePrefix + symbolOut;
        currentConstrainedOut := symbolOut;
        steps := steps + stepsUsed2;
        if hitEos {
          break;
        }
      }
    }
  }
}

cost := steps;

