  // CSD_RATIONALE_BEGIN
  // The prior revision tried to make `<<` and `>>` visible by writing literal
  // delimiter tokens directly into `generated`. The evaluation still reported
  // that the final text did not contain `<< >>`, which strongly suggests the
  // benchmark/tokenization path does not expose those literals as standalone
  // output tokens. In other words, manually appending string tokens is not a
  // reliable way to realize visible delimiters in this environment.
  //
  // This revision therefore returns to the helper-mediated span transitions,
  // which are the verified mechanism intended to synchronize visible output with
  // constrained-state transitions. The strategy is simple and SQL-focused:
  //
  // 1. If currently outside constrained mode, immediately call
  //    OpenConstrainedSpan to enter a constrained SQL span.
  // 2. While inside the span and the SQL prefix is not complete, repeatedly use
  //    ConstrainedSymbol to extend the SQL prefix under the grammar.
  // 3. As soon as parser.IsCompletePrefix(currentConstrainedOut) holds, call
  //    CloseConstrainedSpan to emit the closing delimiter and terminate.
  // 4. If ConstrainedSymbol reports EOS, terminate immediately as required.
  //
  // This design avoids any unconstrained prose and spends essentially all budget
  // on grammar-valid SQL tokens. It also uses the helper API, rather than
  // handwritten delimiter tokens, to maximize the chance that the evaluator sees
  // the expected `<< >>` wrapper in the final visible output. Returned `cost`
  // is the local `steps` counter, not helpers.cost.
  // CSD_RATIONALE_END
  // CSD_PROOF_SKETCH_BEGIN
  // parser_validity: In the open-span branch, OpenConstrainedSpan establishes a
  //   fresh constrained segment whose tracked contents are parser-valid. In the
  //   constrained-growth branch, ConstrainedSymbol returns currentOut that is a
  //   valid parser prefix, and assigning currentConstrainedOut := currentOut
  //   preserves the invariant. In the close-span branch we only call
  //   CloseConstrainedSpan after parser.IsCompletePrefix(currentConstrainedOut)
  //   is known; afterwards insideConstrainedOut is false and
  //   currentConstrainedOut is [], so the implication is vacuous. Breaks do not
  //   invalidate the last established state.
  //
  // suffix: In the open-span branch, the helper returns a generated string and
  //   constrained suffix that are synchronized by construction. In the
  //   constrained-growth branch, generated is rebuilt as stablePrefix + currentOut,
  //   where stablePrefix removes the old constrained suffix; therefore generated
  //   ends with currentConstrainedOut exactly. In the close-span branch we leave
  //   constrained mode, so the implication is vacuous.
  //
  // cost accounting: OpenConstrainedSpan appends one visible token and we
  //   increment steps by 1. Each ConstrainedSymbol call returns stepsUsed and we
  //   increment steps by exactly that amount. CloseConstrainedSpan appends one
  //   visible token and we increment steps by 1. Query operations such as
  //   IsCompletePrefix do not change steps, and we finally set cost := steps.
  //
  // progress: In the open-span branch, generated grows by exactly one token and
  //   steps grows by 1. In the constrained-growth branch, ConstrainedSymbol uses
  //   stepsUsed decoding steps and currentOut extends the constrained content by
  //   at most stepsUsed tokens, so rebuilding generated from stablePrefix +
  //   currentOut preserves |generated| <= |generatedPrefix| + steps after
  //   adding stepsUsed. In the close-span branch, generated grows by exactly one
  //   token and steps grows by 1. Immediate breaks preserve the existing bound.
  // CSD_PROOF_SKETCH_END
  generated := generatedPrefix;
  insideConstrainedOut := insideConstrained;
  currentConstrainedOut := currentConstrained;
  cost := 0;

  var steps: nat := 0;
  var done: bool := false;

  while steps < maxSteps && !done
    invariant 0 <= steps <= maxSteps
    invariant lm.ValidTokensIdsLogits()
    invariant !insideConstrainedOut ==> currentConstrainedOut == []
    invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
    invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
    invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
    invariant |generated| <= |generatedPrefix| + steps
    invariant cost == 0
    decreases maxSteps - steps
  {
    if !insideConstrainedOut {
      var g1, ic1, c1 := helpers.OpenConstrainedSpan(lm, generated);
      generated := g1;
      insideConstrainedOut := ic1;
      currentConstrainedOut := c1;
      steps := steps + 1;
    } else {
      var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
      if isComplete {
        if steps < maxSteps {
          var g2, ic2, c2 := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
          generated := g2;
          insideConstrainedOut := ic2;
          currentConstrainedOut := c2;
          steps := steps + 1;
        }
        done := true;
      } else {
        var remaining: nat := maxSteps - steps;
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt := prompt + stablePrefix;
        var currentOut, hitEos, stepsUsed := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, stepTokenBudget, eosToken
        );
        generated := stablePrefix + currentOut;
        currentConstrainedOut := currentOut;
        steps := steps + stepsUsed;
        if hitEos || stepsUsed == 0 {
          done := true;
        }
      }
    }
  }

  cost := steps;
}

