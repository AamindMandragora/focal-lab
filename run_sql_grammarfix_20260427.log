//   same token to generated and currentConstrainedOut, preserving suffix
//   equality. In the wide inside branch, with stablePrefix defined as generated
//   without the old constrained suffix, assigning generated := stablePrefix +
//   currentOut and currentConstrainedOut := currentOut makes the suffix
//   relation hold by construction.
// progress: OpenConstrainedSpan appends exactly one token and we increment
//   steps by 1. CloseConstrainedSpan also appends exactly one token and we
//   increment steps by 1. In the narrow branch, one constrained token is
//   generated and appended, so steps increases by 1. In the wide branch,
//   ConstrainedSymbol accounts for stepsUsed tokens and we set
//   generated := stablePrefix + currentOut, whose growth is bounded by the
//   returned stepsUsed; then we do steps := steps + stepsUsed. Break branches
//   append nothing further.
// cost accounting: The loop maintains cost == 0 until the end, using local
//   steps as the sole returned accounting. Every productive branch increases
//   steps by exactly the amount of generation work it performs: 1 for opening,
//   closing, and narrow constrained steps, and stepsUsed for ConstrainedSymbol.
//   Thus steps stays within maxSteps by the loop guard and per-branch budgets,
//   and final assignment cost := steps ensures cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var narrowThreshold: nat := 10;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
    generated := openedGenerated;
    insideConstrainedOut := openedInside;
    currentConstrainedOut := openedCurrent;
    steps := steps + 1;
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
      break;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= narrowThreshold {
        var next := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var symbolBudget: nat := maxSteps - steps;
        var currentOut, hitEos, stepsUsed := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, symbolBudget, eosToken
        );
        generated := stablePrefix + currentOut;
        currentConstrainedOut := currentOut;
        steps := steps + stepsUsed;
        if hitEos {
          break;
        }
      }
    }
  }
}

cost := steps;

