Attempt 1/20
============================================================
Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL is naturally split into two phases: free-form reasoning /
// setup text outside the SQL answer, and a single schema-constrained SQL query
// inside a constrained span. This strategy tracks whether we are currently
// inside that SQL span (`insideConstrainedOut`) and, if so, the exact SQL token
// prefix accumulated so far (`currentConstrainedOut`), which is always kept as
// the suffix of `generated`.
//
// Outside the span, we use chunked unconstrained decoding so the model can
// quickly emit any preamble until it either opens the SQL span with "<<" or
// reaches EOS. Inside the span, we adapt to parser narrowness: when the SQL
// grammar is tight (few valid next tokens), we use one-token constrained
// decoding; when it is wide, we use `ConstrainedSymbol` so multi-token SQL
// units such as identifiers or expressions can be emitted in larger chunks.
// As soon as the parser reports that the SQL prefix is complete, we close the
// span with `CloseConstrainedSpan`.
//
// The tracked constrained prefix is what lets the parser enforce schema-aware
// SQL validity, while the adaptive choice between token-step and symbol-step
// keeps generation efficient on wider parts of the SQL grammar.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, we either stay outside
//   the span or enter it only when `stoppedOpen` is true, setting
//   `currentConstrainedOut := []`; `parser.IsValidPrefix([])` holds by the
//   method precondition. In the complete-prefix branch,
//   `CloseConstrainedSpan` sets `insideConstrainedOut` to false, so the
//   implication is vacuous. In the tight constrained branch,
//   `ConstrainedStep` returns either EOS (break) or a parser-valid next token,
//   and `AppendConstrainedToken` preserves validity. In the loose branch,
//   `ConstrainedSymbol` returns a valid constrained prefix directly, which we
//   assign to `currentConstrainedOut`.
// suffix: In the unconstrained chunk branch we remain outside the span unless
//   `stoppedOpen` is true; on entry we set `currentConstrainedOut := []`, and
//   the length-0 suffix of `generated` is `[]`. In the complete-prefix branch,
//   `CloseConstrainedSpan` appends the closing delimiter and resets
//   `currentConstrainedOut := []`, so the implication is vacuous. In the tight
//   branch, `AppendConstrainedToken` appends the same token to both `generated`
//   and `currentConstrainedOut`. In the loose branch, with
//   `stablePrefix := generated[..|generated| - |currentConstrainedOut|]`, we
//   set `generated := stablePrefix + symbolOut` and
//   `currentConstrainedOut := symbolOut`, so the suffix equality holds
//   immediately.
// progress: In the unconstrained chunk branch, `UnconstrainedChunk` appends
//   `stepsUsed` tokens and we do `steps := steps + stepsUsed`, so
//   `|generated| <= |generatedPrefix| + steps` is preserved by linear
//   arithmetic. In the complete-prefix branch, `CloseConstrainedSpan` appends
//   exactly 1 token and we increment `steps` by 1. In the tight constrained
//   branch, `ConstrainedStep` contributes one token of progress and
//   `AppendConstrainedToken` appends exactly that token, so `steps += 1`
//   matches generated growth. In the loose branch, `ConstrainedSymbol` appends
//   up to `stepsUsed` tokens and we increment `steps` by `stepsUsed`; if it
//   hits EOS we break immediately after the update.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var narrowThreshold: nat := 12;
var steps: nat := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      if validCount <= narrowThreshold {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var symbolBudget: nat := maxSteps - steps;
        var symbolOut, hitEos, stepsUsed2 := helpers.ConstrainedSymbol(
          lm, parser, constrainedPrompt, currentConstrainedOut, symbolBudget, eosToken
        );
        generated := stablePrefix + symbolOut;
        currentConstrainedOut := symbolOut;
        steps := steps + stepsUsed2;
        if hitEos {
          break;
        }
      }
    }
  }
}

cost := steps;

