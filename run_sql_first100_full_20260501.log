Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy overused mixed unconstrained/chunk behavior and a wide
// constrained-symbol mode. The evaluation traces showed outputs that kept
// generating garbage after a valid SQL query, plus a few repetition loops.
// For Spider, the desired output is essentially just one SQL query, and the
// parser already enforces a schema-specialized SQL grammar. So this revision
// switches to a simpler, query-focused policy:
//
// 1. Outside a constrained span, do not emit long unconstrained chunks. Instead,
//    immediately open the constrained span when budget remains. This ensures the
//    model spends almost all tokens inside the SQL grammar rather than in free
//    text.
// 2. Inside the span, generate exactly one grammar-valid token per step using
//    AdaptiveConstrainedStep. This avoids the previous wide-mode ConstrainedSymbol
//    behavior that could run past the natural query end and made recovery harder.
// 3. As soon as the current constrained prefix is complete, close the span
//    immediately and stop generation. This directly targets the observed failure
//    mode where extra tokens appeared after a complete SQL query.
// 4. To reduce repetition loops, when token groups are available we penalize the
//    flattened group tokens if the last constrained token is repeated; otherwise
//    we use adaptive group boosting. This is a lightweight anti-loop heuristic
//    that stays parser-safe.
// 5. If the parser reaches a dead-end-like narrow state with no completion yet,
//    we fall back to a boundary rollback repair branch. That branch may shrink
//    the constrained suffix, re-synchronizing generation while still charging one
//    step for progress.
//
// This is a more aggressive "open immediately, stay constrained, close
// immediately, then stop" design tailored to single-query Spider outputs.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
// - Open-span branch sets insideConstrainedOut := true and currentConstrainedOut := [];
//   parser.IsValidPrefix([]) holds by precondition, so validity is preserved.
// - Complete-prefix close branch uses CloseConstrainedSpan, which returns
//   insideOut == false and currentOut == [], making the implication vacuous.
// - Penalized/adaptive single-token branch either breaks on eosToken or gets a
//   parser-valid next token by helper postcondition; AppendConstrainedToken then
//   ensures the updated constrained prefix is parser-valid.
// - Rollback repair branch assigns currentConstrainedOut to a prefix returned by
//   RollbackToBoundary, which ensures parser validity.
//
// suffix:
// - Open-span branch sets currentConstrainedOut := [] after appending only the
//   delimiter to generated; the empty sequence is the suffix of any generated.
// - Close branch makes insideConstrainedOut false, so the suffix implication is
//   vacuous afterward.
// - Penalized/adaptive single-token branch appends the same non-EOS token to
//   both generated and currentConstrainedOut via AppendConstrainedToken, so the
//   constrained prefix remains exactly the suffix.
// - Rollback repair branch computes repaired as a prefix of currentConstrainedOut
//   and trims generated by exactly |currentConstrainedOut| - |repaired| tokens;
//   therefore the new suffix of generated is repaired.
//
// progress:
// - Open-span branch appends exactly 1 token and increments steps by 1.
// - Close branch appends at most 1 token and increments steps by 1.
// - Penalized/adaptive single-token branch either breaks immediately on EOS or
//   appends exactly 1 token and increments steps by 1.
// - Rollback repair branch may append no tokens and may shrink generated, but it
//   still does steps := steps + 1, so the linear bound |generated| <=
//   |generatedPrefix| + steps is preserved trivially. Every non-breaking branch
//   strictly increases steps, satisfying decreases maxSteps - steps.
//
// cost accounting:
// - The loop maintains cost == 0 until the end and uses steps as the returned
//   accounting variable.
// - OpenConstrainedSpan, CloseConstrainedSpan, PenalizedConstrainedStep, and
//   AdaptiveConstrainedStep are cost-bumping helpers by 1, mirrored by
//   steps := steps + 1 in those branches.
// - RollbackToBoundary is non-bumping, so the pure repair branch explicitly does
//   steps := steps + 1 to preserve progress and the final cost bound.
// - Since every increment is by 1 and guarded by steps < maxSteps, the final
//   assignment cost := steps proves cost <= maxSteps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;
var flatGroups := helpers.FlattenTokenGroups(validTokenGroups);

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if "<<" in lm.Tokens {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
      steps := steps + 1;
    } else {
      break;
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      if ">>" in lm.Tokens {
        var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
          lm, parser, generated, currentConstrainedOut
        );
        generated := closedGenerated;
        insideConstrainedOut := closedInside;
        currentConstrainedOut := closedCurrent;
        steps := steps + 1;
      } else {
        break;
      }
      break;
    } else {
      var dead := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if dead {
        var repaired := helpers.RollbackToBoundary(parser, currentConstrainedOut, ",");
        var trim := |currentConstrainedOut| - |repaired|;
        generated := generated[..|generated| - trim];
        currentConstrainedOut := repaired;
        insideConstrainedOut := true;
        steps := steps + 1;
      } else {
        var tokBeforeComma, foundBeforeComma := helpers.LastTokenBefore(currentConstrainedOut, ",");
        var usePenalty := false;
        if 0 < |currentConstrainedOut| {
          if foundBeforeComma && currentConstrainedOut[|currentConstrainedOut| - 1] == tokBeforeComma {
            usePenalty := true;
          } else if 1 < |currentConstrainedOut| && currentConstrainedOut[|currentConstrainedOut| - 1] == currentConstrainedOut[|currentConstrainedOut| - 2] {
            usePenalty := true;
          }
        }

        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        if usePenalty && 0 < |flatGroups| {
          var next := helpers.PenalizedConstrainedStep(
            lm, parser, prompt + stablePrefix, currentConstrainedOut, flatGroups, 5.0, eosToken
          );
          steps := steps + 1;
          if next == eosToken {
            break;
          } else {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
          }
        } else {
          var next := helpers.AdaptiveConstrainedStep(
            lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
          );
          steps := steps + 1;
          if next == eosToken {
            break;
          } else {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
          }
        }
      }
    }
  }
}

cost := steps;

