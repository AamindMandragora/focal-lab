Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL usually has a long unconstrained preamble containing the
// natural-language prompt and schema text, followed by one constrained SQL span
// delimited by "<< ... >>". This strategy therefore tracks only the standard
// delimiter state: whether we are currently inside the SQL span, and the
// current constrained SQL prefix being validated by the schema-specialized SQL
// parser.
//
// Outside the span, generation is free-form and chunked with UnconstrainedChunk
// so the model can quickly emit prompt-following text until it either reaches
// the SQL opener "<<" or EOS. Inside the span, the strategy adapts to grammar
// width: when the parser says the next-token set is narrow, it uses
// AdaptiveConstrainedStep with caller-supplied token groups to softly favor
// schema-relevant tokens while still enforcing parser validity; when the next
// position is wider, it uses ConstrainedSymbol with a token budget so the model
// can emit a larger SQL fragment naturally under parser control. Once the SQL
// prefix is complete, the strategy closes the span with ">>".
//
// The tracked constrained prefix is exactly the SQL text between delimiters.
// That makes parser validity and the suffix relationship easy to maintain:
// every constrained append updates both generated and currentConstrainedOut in
// lockstep, while closing the span resets currentConstrainedOut to [].
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, insideConstrainedOut
//   stays false unless the chunk stops on "<<"; in that case we set
//   currentConstrainedOut := [], which is valid by the method precondition
//   parser.IsValidPrefix([]). In the complete-prefix branch,
//   CloseConstrainedSpan sets insideConstrainedOut to false, so the invariant
//   becomes vacuous. In the adaptive constrained branch, a non-EOS token from
//   AdaptiveConstrainedStep is guaranteed parser-valid, so
//   AppendConstrainedToken yields a valid prefix; in the symbol branch,
//   ConstrainedSymbol directly ensures parser.IsValidPrefix(symbolOut).
// suffix: In the unconstrained chunk branch, when outside the span the suffix
//   implication is vacuous; if the chunk stopped on "<<", currentConstrainedOut
//   is reset to [], and the length-0 suffix of generated equals []. In the
//   close branch, CloseConstrainedSpan appends the closing delimiter and resets
//   currentConstrainedOut to [], so the implication is again vacuous. In the
//   adaptive append branch, AppendConstrainedToken appends the same token to
//   both generated and currentConstrainedOut; in the symbol branch we define
//   stablePrefix := generated[..|generated|-|currentConstrainedOut|] and then
//   set generated := stablePrefix + symbolOut and currentConstrainedOut :=
//   symbolOut, so the suffix equality holds by construction.
// cost accounting: We return cost := steps at the end, and keep the loop
//   invariant cost == 0. Every non-breaking branch increases steps exactly by
//   the amount of work done: UnconstrainedChunk contributes stepsUsed,
//   CloseConstrainedSpan contributes 1, AdaptiveConstrainedStep + append
//   contributes 1, and ConstrainedSymbol contributes stepsUsed. No branch
//   decreases steps, so steps remains within maxSteps.
// progress bound: In the chunk branch, |generated| increases by at most
//   stepsUsed and we do steps := steps + stepsUsed, preserving
//   |generated| <= |generatedPrefix| + steps. In the close and adaptive-append
//   branches, generated grows by exactly 1 and steps grows by 1. In the symbol
//   branch, generated becomes stablePrefix + symbolOut, so its growth is
//   |symbolOut| - |currentConstrainedOut|, which is bounded by the returned
//   stepsUsed from ConstrainedSymbol; thus the same linear bound is preserved.
//   Break branches terminate immediately, so no further preservation is needed.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpenSpan {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= narrowThreshold {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var symbolBudget: nat := stepTokenBudget;
        if symbolBudget > maxSteps - steps {
          symbolBudget := maxSteps - steps;
        }
        var symbolOut, hitEos, symbolSteps := helpers.ConstrainedSymbol(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, symbolBudget, eosToken
        );
        generated := stablePrefix + symbolOut;
        insideConstrainedOut := true;
        currentConstrainedOut := symbolOut;
        steps := steps + symbolSteps;
        if hitEos {
          break;
        }
      }
    }
  }
}

cost := steps;

