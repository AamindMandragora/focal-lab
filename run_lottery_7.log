Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it could open `<<` opportunistically and
// then spend multiple constrained steps trying to synthesize the arithmetic
// interior, often hitting EOS or budget exhaustion before emitting `>>`. To fix
// that failure mode, this revision makes constrained spans single-step and
// closure-driven: once inside a span, it appends exactly one parser-valid token
// and then, on the very next iteration when the parser reports completeness,
// immediately closes with `>>`. Outside a span, it only opens `<<` when the
// next unconstrained token itself is `<<`; it no longer opens merely because an
// argmax token text contains `<<`, which previously caused accidental openings.
// Inside a span, it uses `ConstrainedStep` to obtain a parser-valid token unless
// the current argmax is already valid, and it treats EOS as terminal by breaking
// without appending further text. This design prioritizes always-terminated
// spans and syntax rate over aggressive multi-token constrained generation.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: Outside a span, either we stay outside after unconstrained
//   generation or we open a fresh span with `currentConstrainedOut := []`; the
//   implication is vacuous in the first case and holds in the second because
//   `[]` is a valid parser prefix. Inside a span, if `parser.IsCompletePrefix`
//   holds we call `CloseConstrainedSpan`, which exits the span so the
//   implication is vacuous; otherwise we append exactly one token only after
//   either checking `IsTokenValidNext` on the argmax or obtaining a token from
//   `ConstrainedStep`, so the new constrained prefix remains valid.
// suffix: When we remain outside a span after unconstrained generation, the
//   implication is vacuous; when we open a span, `generated` gains only `"<<"
//   and `currentConstrainedOut` is `[]`, so the empty suffix matches. When we
//   close a complete span, `CloseConstrainedSpan` appends only `">>"` and resets
//   `currentConstrainedOut` to `[]`, making the implication vacuous. In the
//   constrained append branch, `AppendConstrainedToken` appends the same token
//   to both `generated` and `currentConstrainedOut`, preserving the suffix
//   equality.
// cost: In the unconstrained branch we use a primitive token choice, so we
//   manually increment `helpers.cost` once and also increment `steps` once. In
//   the close branch, `CloseConstrainedSpan` bumps helper cost internally and we
//   increment `steps` once. In the constrained append branch using a valid
//   argmax, only non-bumping queries plus `AppendConstrainedToken` are used, so
//   after incrementing `steps` the inequality `helpers.cost <= steps` still
//   holds. In the constrained fallback branch, `ConstrainedStep` bumps helper
//   cost once and we increment `steps` once before either breaking on EOS or
//   appending, so the invariant is preserved.
// progress: Every non-breaking iteration appends at most one token to
//   `generated`: either one unconstrained token, one opening delimiter `<<`, one
//   constrained interior token via `AppendConstrainedToken`, or one closing
//   delimiter via `CloseConstrainedSpan`. Since `steps` increases by exactly one
//   on each such iteration, `|generated| <= |generatedPrefix| + steps` is
//   preserved in all branches.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;

    if next == eosToken {
      break;
    } else if next == "<<" {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
    } else {
      generated := generated + [next];
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(lm, parser, generated, currentConstrainedOut);
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);
      if argmaxValid && argmax != eosToken {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

