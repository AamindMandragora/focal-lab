Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it opened constrained spans too eagerly
// and then allowed ordinary unconstrained sampling while inside, which often
// produced invalid arithmetic text, never reached parser completion, and left
// `<<` unterminated. The revised strategy is conservative:
//
// 1. Outside constrained mode, it never opens `<<` just because the model seems
//    to like it. It only opens when the sampled token is exactly "<<".
// 2. Once inside constrained mode, it never uses ordinary unconstrained token
//    sampling for arithmetic contents. It always advances with
//    `helpers.ConstrainedStep`, so every appended token is parser-valid.
// 3. If the constrained prefix is complete, it immediately closes with `>>` on
//    the next step; it never tries to generate more arithmetic text first.
// 4. To improve the chance that spans are actually used for math work, outside
//    constrained mode it lightly boosts the opening delimiter token whenever the
//    local context already contains arithmetic-looking cues such as digits or
//    operator characters. This is only a bias, not a forced open, so it avoids
//    pathological accidental openings.
// 5. EOS remains terminal in every branch.
//
// This directly targets the observed failures: no unconstrained interior tokens,
// no closing based merely on seeing `">>"`, and immediate closure once the
// parser says the arithmetic expression is complete.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, if the sampled token is not "<<", we
//   remain outside so the implication is vacuous; if it is "<<", OpenConstrainedSpan
//   starts a fresh empty constrained prefix, which is valid by the method
//   precondition on []. In the inside-complete branch, CloseConstrainedSpan
//   exits constrained mode, so the implication is vacuous afterward. In the
//   inside-incomplete branch, ConstrainedStep returns a parser-valid next token
//   (or EOS, in which case we break without changing the constrained state), and
//   AppendConstrainedToken preserves validity by appending that valid token.
// suffix: Outside constrained mode, non-"<<" tokens leave us outside so the
//   implication is vacuous; opening with OpenConstrainedSpan sets the active
//   constrained prefix to [] and the empty suffix matches. Closing with
//   CloseConstrainedSpan leaves constrained mode, so the implication is again
//   vacuous. Appending a constrained token uses AppendConstrainedToken, which
//   extends both `generated` and `currentConstrainedOut` by the same token, so
//   the suffix equality is preserved.
// cost: In the outside branch we use raw ChooseNextToken exactly once and then
//   manually increment helpers.cost; we also increment steps once. In the
//   inside-complete branch, CloseConstrainedSpan bumps helpers.cost internally
//   once and we increment steps once. In the inside-incomplete branch,
//   ConstrainedStep bumps helpers.cost internally once and we increment steps
//   once; AppendConstrainedToken is non-bumping. Therefore helpers.cost <= steps
//   is preserved in every non-breaking iteration.
// progress: In the outside branch, either we append one sampled token directly
//   or, when that token is "<<", OpenConstrainedSpan appends exactly that one
//   delimiter token; steps increases by one. In the inside-complete branch,
//   CloseConstrainedSpan appends one closing delimiter token and steps increases
//   by one. In the inside-incomplete branch, AppendConstrainedToken appends one
//   constrained token and steps increases by one. Thus |generated| grows by at
//   most one per loop iteration, preserving |generated| <= |generatedPrefix| +
//   steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var shouldBiasOpen := false;
    var top := helpers.GetHighestLogitToken(lm);
    if Contains(top, "+") || Contains(top, "-") || Contains(top, "*") || Contains(top, "/") ||
       Contains(top, "=") || Contains(top, "0") || Contains(top, "1") || Contains(top, "2") ||
       Contains(top, "3") || Contains(top, "4") || Contains(top, "5") || Contains(top, "6") ||
       Contains(top, "7") || Contains(top, "8") || Contains(top, "9") {
      shouldBiasOpen := true;
    }
    if shouldBiasOpen {
      helpers.BoostTokenLogits(lm, ["<<"], 8.0);
    }

    var next := lm.ChooseNextToken();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;

    if next == eosToken {
      break;
    } else if next == "<<" {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
    } else {
      generated := generated + [next];
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var next := helpers.ConstrainedStep(lm, parser, prompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

