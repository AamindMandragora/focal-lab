//   becomes vacuous. In the adaptive constrained branch, if next == eosToken we
//   break with state unchanged; otherwise the helper ensures
//   parser.IsValidPrefix(currentConstrainedOut + [next]), and
//   AppendConstrainedToken updates currentConstrainedOut to exactly that valid
//   prefix.
// suffix: In the unconstrained branch, when we stay outside a span the suffix
//   invariant is vacuous; when we enter a span on "<<", currentConstrainedOut is
//   [], and the length-0 suffix of generated matches []. In the close branch,
//   CloseConstrainedSpan appends at most one delimiter token and resets
//   currentConstrainedOut to [], so the implication is again vacuous. In the
//   adaptive constrained branch, AppendConstrainedToken appends the same `next`
//   token to both generated and currentConstrainedOut, preserving that the tail
//   of generated equals the constrained prefix.
// cost accounting: We use a local `steps` counter and assign `cost := steps` at
//   the end. Every non-breaking branch calls exactly one cost-bumping helper:
//   UnconstrainedStep, CloseConstrainedSpan, or AdaptiveConstrainedStep, and
//   then increments steps by 1. Break branches also increment steps for the
//   helper call that produced EOS, so returned cost still matches work done and
//   remains <= maxSteps.
// progress: UnconstrainedStep appends exactly one token when it does not break,
//   and we do steps := steps + 1, so |generated| grows by at most 1 while the
//   bound gains 1. CloseConstrainedSpan appends at most one token and also
//   increments steps by 1, preserving the bound. In the adaptive constrained
//   branch, EOS breaks immediately after steps increases by 1 with generated
//   unchanged; otherwise AppendConstrainedToken appends exactly one token and
//   steps also increases by 1, so |generated| <= |generatedPrefix| + steps is
//   preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.AdaptiveConstrainedStep(
        lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
      );
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

