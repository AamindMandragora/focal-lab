// CSD_RATIONALE_BEGIN
// Step-by-step math CSD with delimiter-triggered constrained spans. The strategy
// tracks the usual generated text plus whether we are currently inside a
// `<< ... >>` arithmetic-computation span and the constrained contents of that
// active span. Outside spans, generation is mostly free but chunked for
// efficiency, stopping early on EOS or when the model emits the open delimiter
// token `<<`.
//
// Inside a span, the strategy uses parser-aware constrained decoding. When the
// grammar is relatively wide, it uses AdaptiveConstrainedStep with caller-
// supplied validTokenGroups to softly bias toward useful arithmetic tokens while
// still enforcing parser validity. When the grammar becomes narrow, it switches
// to a plain ConstrainedStep. As soon as the parser reports the constrained
// prefix is complete, the strategy emits the closing delimiter via
// CloseConstrainedSpan. This tracked state ensures that only the contents
// between delimiters are parser-constrained, while the full generated answer
// still includes the delimiters themselves.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, insideConstrainedOut
//   remains false unless the chunk stops on `<<`; in that case we set
//   currentConstrainedOut := [], and parser.IsValidPrefix([]) is given by the
//   method precondition. In the close-span branch, CloseConstrainedSpan sets
//   insideConstrainedOut to false, so the implication is vacuous. In the
//   narrow constrained branch, ConstrainedStep either breaks on EOS with state
//   unchanged or returns parser-valid currentOut directly. In the adaptive
//   branch, AdaptiveConstrainedStep guarantees the sampled token is EOS or a
//   valid next token; on the non-EOS path, AppendConstrainedToken preserves
//   parser validity.
// suffix: In the unconstrained chunk branch, when we remain outside the span
//   the implication is vacuous; when we enter a span after stopping on `<<`,
//   currentConstrainedOut is reset to [], and the length-0 suffix of generated
//   equals []. In the close-span branch, CloseConstrainedSpan appends only the
//   delimiter and resets currentConstrainedOut to [], so the implication again
//   becomes vacuous. In the narrow constrained branch, ConstrainedStep
//   preserves the suffix relation by postcondition. In the adaptive branch,
//   AppendConstrainedToken appends the same token to generated and
//   currentConstrainedOut, so the suffix equality is preserved.
// cost accounting: We return cost := steps, and every non-breaking branch
//   increases steps exactly by the amount of work performed: UnconstrainedChunk
//   contributes stepsUsed, CloseConstrainedSpan contributes 1, ConstrainedStep
//   contributes 1, and AdaptiveConstrainedStep plus AppendConstrainedToken
//   contributes 1 because only the adaptive helper bumps cost. Breaking branches
//   stop immediately after a cost-bumping helper, so steps already reflects the
//   consumed work.
// progress: UnconstrainedChunk appends at most stepsUsed tokens and we do
//   steps := steps + stepsUsed, so |generated| <= |generatedPrefix| + steps is
//   preserved. CloseConstrainedSpan appends at most one token and steps grows
//   by 1. ConstrainedStep either appends one token with steps += 1 or breaks
//   with no state growth. AdaptiveConstrainedStep samples one token, and on the
//   non-EOS path AppendConstrainedToken appends exactly one token while steps
//   also grows by 1. Thus every non-breaking branch strictly increases steps,
//   satisfying decreases maxSteps - steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 8;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedOnEos {
      break;
    } else if stoppedOnOpenSpan {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= narrowThreshold {
        var constrainedGenerated, constrainedInside, constrainedCurrent, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := constrainedGenerated;
          insideConstrainedOut := constrainedInside;
          currentConstrainedOut := constrainedCurrent;
        }
      } else {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;
