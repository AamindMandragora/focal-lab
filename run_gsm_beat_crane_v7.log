Strategy: // CSD_RATIONALE_BEGIN
// The 72%-accuracy strategy was still the best balance of syntax and accuracy,
// and the latest 69% regression points to one especially damaging pattern:
// the model often spent many unconstrained tokens introducing symbolic variable
// names before ever opening `<<`, and then the constrained span merely copied
// those symbols (`x`, `k * y`, etc.) instead of performing arithmetic. A second
// recurring issue was leaving the span open too long once it had started.
//
// This revision therefore makes small, targeted changes relative to the 72%
// baseline rather than changing the overall design.
//
// 1. Open earlier and more decisively. Outside constrained mode, the boost
//    toward `<<` now starts sooner and becomes stronger after a second
//    threshold. This is intended to trigger the arithmetic span before the
//    model drifts into long symbolic setup prose.
// 2. Inside the span, simplify aggressively toward grammar-following completion.
//    The previous early custom/adaptive branches were the main source of
//    malformed symbolic content, so they are removed. Once inside a span, the
//    strategy uses plain ConstrainedStep until the parser reports completeness,
//    then closes immediately.
// 3. After one span has been closed, stop immediately. For this task, extra
//    trailing text after a valid `<<...>>` computation is usually harmful.
//
// These changes preserve the verified state discipline while specifically
// targeting the observed failures: late opening, symbolic constrained content,
// and occasional non-termination of the constrained segment.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, EOS breaks with unchanged constrained
//   state; on a non-EOS token we either remain outside, making the implication
//   vacuous, or if next == "<<", we enter constrained mode with
//   currentConstrainedOut := [], which is valid by parser.IsValidPrefix([]).
//   In the close branch, CloseConstrainedSpan sets insideConstrainedOut to
//   false, so the implication is vacuous and we break immediately. In the plain
//   constrained branch, ConstrainedStep preserves parser validity directly by
//   postcondition on the non-EOS path, and leaves state unchanged on EOS.
// suffix: In the outside branch, staying outside makes the implication
//   vacuous; opening on `<<` sets currentConstrainedOut := [], which matches the
//   length-0 suffix of generated after appending the delimiter. In the close
//   branch, insideConstrainedOut becomes false, so the implication is vacuous.
//   In the constrained branch, ConstrainedStep preserves the suffix relation by
//   postcondition whenever it appends a token, and on EOS the state is
//   unchanged.
// cost accounting: We return cost := steps. The outside manual unconstrained
//   sampling branch calls ChooseNextTokenUnconstrained and explicitly bumps
//   helpers.cost; we also increment steps by 1. CloseConstrainedSpan and
//   ConstrainedStep each consume one step and we increment steps by 1 in those
//   branches. Query-only state like spansClosed does not affect steps.
// progress: In the outside branch, a non-EOS sample appends exactly one token
//   and we increment steps by 1; on EOS we break immediately after consuming
//   that step. CloseConstrainedSpan appends at most one token and steps grows by
//   1, then we break. ConstrainedStep either appends one token and steps grows
//   by 1, or returns hitEos and we break immediately after that consumed step.
//   Therefore every non-breaking branch strictly increases steps by 1 and
//   preserves |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var spansClosed: nat := 0;
var openWarmup1: nat := 5;
var openWarmup2: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if spansClosed > 0 {
      break;
    } else {
      lm.GenerateLogits(prompt + generated);
      if "<<" in lm.Tokens {
        if openWarmup2 <= steps {
          helpers.BoostTokenLogits(lm, ["<<"], 14.0);
        } else if openWarmup1 <= steps {
          helpers.BoostTokenLogits(lm, ["<<"], 6.0);
        }
      }
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      spansClosed := spansClosed + 1;
      steps := steps + 1;
      break;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedGenerated, constrainedInside, constrainedCurrent, hitEos := helpers.ConstrainedStep(
        lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
      );
      steps := steps + 1;
      if hitEos {
        break;
      } else {
        generated := constrainedGenerated;
        insideConstrainedOut := constrainedInside;
        currentConstrainedOut := constrainedCurrent;
      }
    }
  }
}

