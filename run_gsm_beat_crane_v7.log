Strategy: // CSD_RATIONALE_BEGIN
// The 72%-accuracy strategy was the strongest stable point, and the bad 3% run
// came from a specific overcorrection: opening `<<` too aggressively and too
// early caused the model to copy symbolic variable setups into the constrained
// span, while continued free-form decoding after a closed span often added extra
// junk. The fix here is therefore targeted and conservative.
//
// Changes from the 72% baseline:
// 1. Outside constrained mode, we still manually sample, but the `<<` boost is
//    delayed slightly and made gentler. This keeps the good property of
//    eventually opening a span, but reduces the chance of opening in the middle
//    of a symbolic setup like `Let x = ...`.
// 2. Once a constrained span has been closed, we stop immediately. For this task
//    the required output is typically just the final answer after step-by-step
//    work, so trailing unconstrained text is more often harmful than helpful.
//    This directly targets traces that produced a good `<<...>>` span and then
//    rambled or opened additional malformed spans.
// 3. Inside constrained mode, we simplify toward grammar-following completion.
//    The early custom branch is kept but weakened: it only applies at the very
//    start of a span, only when caller-supplied groups have some parser-valid
//    member, and uses small boosts. Otherwise we use plain ConstrainedStep.
//    This is meant to preserve the baseline's syntax strength while reducing
//    drift toward symbolic variable names and long malformed expressions.
//
// Overall, this keeps the verified state discipline unchanged while nudging the
// decoder toward exactly one short arithmetic computation span and then an early
// stop.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, EOS breaks with unchanged constrained
//   state; on a non-EOS token we either remain outside, making the implication
//   vacuous, or if next == "<<", we enter constrained mode with
//   currentConstrainedOut := [], valid by parser.IsValidPrefix([]). In the
//   close branch, CloseConstrainedSpan sets insideConstrainedOut to false, so
//   the implication is vacuous; we then break immediately. In the plain
//   constrained branch, ConstrainedStep preserves parser-validity directly. In
//   the small early group-boosted branch, the helper returns EOS or a parser-
//   valid next token, and AppendConstrainedToken preserves validity.
// suffix: In the outside branch, remaining outside makes the implication
//   vacuous; opening on "<<" sets currentConstrainedOut := [], which equals the
//   length-0 suffix of generated after appending the delimiter. In the close
//   branch, insideConstrainedOut becomes false, so the implication is vacuous.
//   In the ConstrainedStep branch, the helper preserves the suffix relation by
//   postcondition. In the early group-boosted branch, AppendConstrainedToken
//   appends the same token to generated and currentConstrainedOut, preserving
//   suffix equality.
// cost accounting: We return cost := steps. The outside manual unconstrained
//   sampling branch calls ChooseNextTokenUnconstrained and then explicitly bumps
//   helpers.cost; we also do steps := steps + 1. CloseConstrainedSpan,
//   GroupBoostedConstrainedStep, and ConstrainedStep each consume one step and
//   we increment steps by 1 in those branches. Query-only helpers such as
//   GroupHasValidMember and ValidTokenCount do not affect steps.
// progress: In the outside branch, a non-EOS sample appends exactly one token
//   and we increment steps by 1; on EOS we break immediately after consuming
//   that step. CloseConstrainedSpan appends at most one token and steps grows by
//   1, then we break. ConstrainedStep either appends one token and steps grows
//   by 1, or breaks on EOS. The early group-boosted branch consumes one step;
//   on the non-EOS path, AppendConstrainedToken appends exactly one token.
//   Therefore every non-breaking branch strictly increases steps by 1 and
//   preserves |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var spansClosed: nat := 0;
var openWarmup: nat := 10;
var earlySpanThreshold: nat := 1;
var longSpanThreshold: nat := 6;
var narrowThreshold: nat := 8;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    if spansClosed > 0 {
      break;
    } else {
      lm.GenerateLogits(prompt + generated);
      if openWarmup <= steps && "<<" in lm.Tokens {
        helpers.BoostTokenLogits(lm, ["<<"], 5.0);
      }
      var next := lm.ChooseNextTokenUnconstrained();
      helpers.cost := helpers.cost + 1;
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      spansClosed := spansClosed + 1;
      steps := steps + 1;
      break;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);

      if |currentConstrainedOut| >= longSpanThreshold || validCount <= narrowThreshold {
        var constrainedGenerated, constrainedInside, constrainedCurrent, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := constrainedGenerated;
          insideConstrainedOut := constrainedInside;
          currentConstrainedOut := constrainedCurrent;
        }
      } else {
        var useGroups := false;
        if |currentConstrainedOut| <= earlySpanThreshold && |validTokenGroups| > 0 {
          useGroups := helpers.GroupHasValidMember(parser, currentConstrainedOut, validTokenGroups[0]);
        }

        if useGroups {
          var next2 := helpers.GroupBoostedConstrainedStep(
            lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 1.5, eosToken
          );
          steps := steps + 1;
          if next2 == eosToken {
            break;
          } else {
            var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next2
            );
            generated := appendedGenerated2;
            insideConstrainedOut := appendedInside2;
            currentConstrainedOut := appendedCurrent2;
          }
        } else {
          var constrainedGenerated2, constrainedInside2, constrainedCurrent2, hitEos2 := helpers.ConstrainedStep(
            lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
          );
          steps := steps + 1;
          if hitEos2 {
            break;
          } else {
            generated := constrainedGenerated2;
            insideConstrainedOut := constrainedInside2;
            currentConstrainedOut := constrainedCurrent2;
          }
        }
      }
    }
  }
}

cost := steps;

