        }
      } else {
        var useGroups := false;
        if |currentConstrainedOut| <= earlySpanThreshold && |validTokenGroups| > 0 {
          useGroups := helpers.GroupHasValidMember(parser, currentConstrainedOut, validTokenGroups[0]);
        }

        if useGroups {
          var next2 := helpers.GroupBoostedConstrainedStep(
            lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 1.5, eosToken
          );
          steps := steps + 1;
          if next2 == eosToken {
            break;
          } else {
            var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next2
            );
            generated := appendedGenerated2;
            insideConstrainedOut := appendedInside2;
            currentConstrainedOut := appendedCurrent2;
          }
        } else {
          var constrainedGenerated2, constrainedInside2, constrainedCurrent2, hitEos2 := helpers.ConstrainedStep(
            lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
          );
          steps := steps + 1;
          if hitEos2 {
            break;
          } else {
            generated := constrainedGenerated2;
            insideConstrainedOut := constrainedInside2;
            currentConstrainedOut := constrainedCurrent2;
          }
        }
      }
    }
  }
}

