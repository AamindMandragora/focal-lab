// The 71%-accuracy strategy was structurally close, so this revision keeps its
// core constrained-decoding design and makes two targeted fixes driven by the
// evaluation failures.
//
// First, the 0%-accuracy regression came from over-eager opening of `<<` in the
// unconstrained region. Here we revert to neutral unconstrained generation:
// outside a span we simply take ordinary unconstrained steps and only enter
// constrained mode if the model itself emits `<<`. This directly addresses the
// observed "entered_constrained_mode_too_early" failure mode.
//
// Second, to improve completion reliability once a span is open, the inside-span
// policy becomes slightly more completion-oriented. When the constrained prefix
// is already somewhat long or the parser-valid frontier is narrow, we use plain
// ConstrainedStep, which tends to follow the grammar directly and can hit a
// complete prefix sooner. Otherwise we keep the prior arithmetic-context idea:
// extract tokens after the most recent "=" and softly boost overlapping caller-
// supplied groups, then mask and sample. As before, we close only when
// parser.IsCompletePrefix(currentConstrainedOut) holds, so `>>` is emitted only
// in a parser-sanctioned state.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if next is EOS we break with
//   unchanged state; if next is `<<` we enter constrained mode with
//   currentConstrainedOut := [], and parser.IsValidPrefix([]) is given. In the
//   close branch, CloseConstrainedSpan sets insideConstrainedOut to false, so
//   the implication is vacuous. In the ConstrainedStep branch, the helper
//   either returns hitEos with unchanged state or a parser-valid currentOut. In
//   the adaptive/manual branch, AdaptiveConstrainedStep or masked sampling
//   returns EOS or a parser-valid next token, and AppendConstrainedToken
//   preserves parser validity.
// suffix: In the unconstrained branch, staying outside makes the implication
//   vacuous; when next == `<<`, currentConstrainedOut becomes [], which is the
//   length-0 suffix of generated after appending `<<`. In the close branch,
//   inside becomes false, so the implication is vacuous. In the ConstrainedStep
//   branch, the helper preserves the suffix relation by postcondition. In the
//   adaptive/manual append branch, AppendConstrainedToken appends the same token
//   to generated and currentConstrainedOut, preserving suffix equality.
// cost accounting: We use a local `steps` counter and return cost := steps.
//   UnconstrainedStep, CloseConstrainedSpan, ConstrainedStep, and
//   AdaptiveConstrainedStep each consume one step and we increment steps by 1
//   in those branches. In the manual masked-sampling branch, ChooseNextToken is
//   followed by helpers.cost := helpers.cost + 1 and we also do steps := steps
//   + 1. Query-only helpers such as ExtractAfterKeyword, FlattenTokenGroups,
//   IntersectTokenSets, GroupContaining, and ValidTokenCount do not affect
//   steps.
// progress: UnconstrainedStep appends exactly one token on the non-EOS path and
//   we increment steps by 1; on EOS we break immediately after the step.
//   CloseConstrainedSpan appends at most one token and we do steps := steps +
//   1. ConstrainedStep either appends one token and we increment steps by 1, or
//   breaks on EOS with no further state change. AdaptiveConstrainedStep and the
//   manual masked-sampling branch each consume one step; on non-EOS,
//   AppendConstrainedToken appends exactly one token. Therefore every
//   non-breaking branch strictly increases steps by 1 and preserves
//   |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var recentNumbers: seq<Token> := [];
var activePreferred: seq<Token> := [];
var longSpanThreshold: nat := 10;
var narrowThreshold: nat := 6;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
        recentNumbers := [];
        activePreferred := [];
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      recentNumbers := [];
      activePreferred := [];
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if |currentConstrainedOut| >= longSpanThreshold || validCount <= narrowThreshold {
        var constrainedGenerated, constrainedInside, constrainedCurrent, hitEos := helpers.ConstrainedStep(
          lm, parser, prompt + stablePrefix, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := constrainedGenerated;
          insideConstrainedOut := constrainedInside;
          currentConstrainedOut := constrainedCurrent;
          recentNumbers := helpers.ExtractAfterKeyword(currentConstrainedOut, "=");
          var flatPreferred1 := helpers.FlattenTokenGroups(validTokenGroups);
          activePreferred := helpers.IntersectTokenSets(flatPreferred1, recentNumbers);
        }
      } else {
        recentNumbers := helpers.ExtractAfterKeyword(currentConstrainedOut, "=");
        var flatPreferred := helpers.FlattenTokenGroups(validTokenGroups);
        activePreferred := helpers.IntersectTokenSets(flatPreferred, recentNumbers);

        if |activePreferred| == 0 {
          var next2 := helpers.AdaptiveConstrainedStep(
            lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
          );
          steps := steps + 1;
          if next2 == eosToken {
            break;
          } else {
            var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next2
            );
            generated := appendedGenerated2;
            insideConstrainedOut := appendedInside2;
            currentConstrainedOut := appendedCurrent2;
            var idx2 := helpers.GroupContaining(validTokenGroups, next2);
            if idx2 >= 0 {
              activePreferred := validTokenGroups[idx2];
            }
          }
        } else {
          lm.GenerateLogits(prompt + stablePrefix + currentConstrainedOut);
          helpers.BoostTokenLogits(lm, activePreferred, 8.0);
          if |validTokenGroups| > 0 {
            helpers.BoostValidGroups(lm, parser, currentConstrainedOut, validTokenGroups, 3.0);
          }
          lm.MaskValidNextAndEos(parser, currentConstrainedOut, eosToken);
          var next3 := lm.ChooseNextToken();
          helpers.cost := helpers.cost + 1;
          steps := steps + 1;
          if next3 == eosToken {
            break;
          } else {
            var appendedGenerated3, appendedInside3, appendedCurrent3 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next3
            );
            generated := appendedGenerated3;
            insideConstrainedOut := appendedInside3;
            currentConstrainedOut := appendedCurrent3;
            var idx3 := helpers.GroupContaining(validTokenGroups, next3);
            if idx3 >= 0 {
              activePreferred := validTokenGroups[idx3];
            }
          }
        }
      }
    }
  }
}

