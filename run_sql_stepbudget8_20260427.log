Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy over-corrected for syntax by delaying closure until a
// longer complete SQL prefix appeared. On Spider this still produced many short,
// generic but wrong queries, especially variants collapsing to things like
// "SELECT count". The evaluation signal suggests the issue is not grammar
// validity but semantic drift under token-by-token constrained sampling.
//
// Revised strategy:
// 1. Emit exactly one constrained SQL span and force it to open immediately.
// 2. Inside the span, use chunked unconstrained generation for short bursts while
//    strongly biasing toward staying inside SQL rather than reopening spans or
//    ending early. This lets the LM express higher-level SQL patterns instead of
//    being myopically steered one token at a time.
// 3. After each chunk, project the produced constrained suffix back to the
//    nearest parser-valid prefix with RollbackToValidPrefix / RollbackConstrainedSpan.
//    This keeps syntax perfect while preserving as much LM intent as possible.
// 4. Only close the span when the current constrained prefix is complete and has
//    reached a modest minimum length; otherwise continue generating.
// 5. If a chunk stops on EOS, terminate immediately as required.
// 6. Near the step budget limit, fall back to single constrained steps so the
//    progress bound remains easy to satisfy and we still have a chance to finish
//    with a valid complete query.
//
// This directly addresses the observed failures: instead of repeatedly sampling
// locally valid next SQL tokens that gravitate toward trivial "SELECT count"
// fragments, we let the model draft multi-token SQL continuations, then repair
// them back to the grammar-valid frontier.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: Outside the span, either we remain outside after sampling one
//   token, making the implication vacuous, or we open the constrained span and
//   set currentConstrainedOut := [], which is a valid parser prefix. In the
//   chunk-repair branch, UnconstrainedChunk may produce an invalid constrained
//   suffix, but we immediately replace it by rolled := RollbackToValidPrefix(...)
//   and then RollbackConstrainedSpan aligns generated/current to that valid
//   prefix; if the chunk opened a nested span or hit EOS we stop after repair.
//   In the close branch, leaving constrained mode makes the implication vacuous.
//   In the single-step append branch, we append only after checking
//   parser.IsValidPrefix(currentConstrainedOut + [next]), so validity is
//   preserved.
// suffix: Opening sets currentConstrainedOut to [] so the suffix property holds
//   trivially. Remaining outside or closing makes the implication vacuous. In the
//   chunk-repair branch, RollbackConstrainedSpan restores generated so that its
//   constrained suffix is exactly the rolled-back valid prefix. In the single-step
//   append branch, AppendConstrainedToken appends the same token to generated and
//   currentConstrainedOut, preserving suffix equality.
// cost accounting: We return the local steps counter. Each loop iteration chooses
//   exactly one counted action: one outside token, one chunk generation using
//   stepsUsed outer steps, one close action, or one constrained single-token
//   action. We increase steps by that amount exactly once per branch and never
//   decrease it. Since the loop guard enforces steps < maxSteps and chunk size is
//   capped by remaining budget, the final cost := steps satisfies cost <=
//   maxSteps.
// progress: Initially generated == generatedPrefix. Outside generation appends at
//   most one token, so growth is <= stepTokenBudget because stepTokenBudget >= 1.
//   In the chunk branch, maxChunk is chosen so that UnconstrainedChunk appends at
//   most stepsUsed <= maxChunk <= remainingSteps * stepTokenBudget tokens; the
//   subsequent rollback can only shrink generated, so
//   |generated| <= |generatedPrefix| + steps * stepTokenBudget is preserved. The
//   close and single-step append branches add at most one token in one outer
//   step, again within the budget bound.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var minSqlTokens := 10;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 100.0);
    helpers.PenalizeTokenLogits(lm, [eosToken], 100.0);
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete && minSqlTokens <= |currentConstrainedOut| {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var remainingSteps := maxSteps - steps;
      if 1 < remainingSteps && 1 < stepTokenBudget {
