Strategy: // CSD_RATIONALE_BEGIN
// The prior strategy guaranteed grammar-valid SQL but still scored poorly because
// it tended to stop as soon as any complete prefix existed. On Spider, many very
// short prefixes are syntactically complete yet semantically useless (for
// example, beginnings that drift toward fragments like "SELECT avg"). The fix is
// to make constrained decoding more selective rather than merely valid.
//
// Revised strategy:
// 1. We still emit exactly one constrained SQL span delimited by "<<" and ">>".
// 2. Outside the span, we aggressively open the span immediately by boosting "<<"
//    so generation spends almost all budget on SQL rather than narration.
// 3. Inside the span, decoding remains parser-constrained, but we add a
//    completion gate: if the parser says the prefix is complete, we only close
//    when the prefix is not in a narrow state and has reached a modest minimum
//    length. This avoids prematurely ending at short trivial queries.
// 4. When the valid next-token set is very small, we bias toward the parser's
//    top valid candidates before sampling. This keeps decoding on high-probability
//    schema-consistent continuations without ever leaving the grammar.
// 5. If we nevertheless enter a dead-end-like narrow prefix, we roll back to the
//    nearest valid prefix and continue.
// 6. EOS remains terminal everywhere.
//
// In response to the evaluation failure pattern, the key change is delaying
// closure of the SQL span until the query has enough substance, while still
// using parser-valid constrained steps only.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, either we stay outside after one
//   unconstrained token (implication vacuous) or we open the constrained span and
//   set currentConstrainedOut := [], which is valid by the precondition on the
//   parser. In the close branch, CloseConstrainedSpan leaves constrained mode, so
//   the implication is vacuous. In the rollback branch, we replace the current
//   constrained prefix by RollbackToValidPrefix(parser, currentConstrainedOut),
//   and RollbackConstrainedSpan returns generated/current aligned to that valid
//   prefix. In both constrained-token branches, ConstrainedStep returns a parser-
//   valid next token (or EOS); if not EOS, AppendConstrainedToken preserves
//   parser validity.
// suffix: Opening the span sets currentConstrainedOut to [], so the suffix claim
//   holds trivially. Remaining outside or closing the span makes the implication
//   vacuous. RollbackConstrainedSpan restores generated so that its constrained
//   suffix exactly matches the rolled-back current prefix. AppendConstrainedToken
//   appends the same constrained token to both generated and currentConstrainedOut,
//   preserving the suffix equality.
// cost accounting: We use local steps as the returned cost. Every loop iteration
//   takes exactly one counted action: one unconstrained token, one close action,
//   one rollback action, or one constrained token action. We increment steps once
//   in each such branch and nowhere else; breaks happen only after the counted
//   action, so cost := steps satisfies cost <= maxSteps.
// progress: Initially generated == generatedPrefix. In the outside branch, one
//   token is appended, so length grows by at most 1 <= stepTokenBudget. Opening
//   the span does not append extra tokens beyond that sampled token. In the close
//   branch, CloseConstrainedSpan appends at most one token. In rollback, generated
//   may shrink or stay the same, so the bound is preserved. In constrained-token
//   branches, one parser-valid token is appended, hence growth is at most 1 <=
//   stepTokenBudget. Therefore after each iteration,
//   |generated| <= |generatedPrefix| + steps * stepTokenBudget remains true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;
var minSqlTokens := 6;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 100.0);
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    var narrowForClose := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
    if complete && !narrowForClose && minSqlTokens <= |currentConstrainedOut| {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if narrow && 0 < |currentConstrainedOut| && !complete {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
        var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
          parser, stablePrefix, generated, currentConstrainedOut
        );
        generated := rolledGenerated;
        currentConstrainedOut := rolledCurrent;
        insideConstrainedOut := true;
        steps := steps + 1;
      } else {
        var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
        if validCount <= 4 {
          var stablePrefix2 := generated[..|generated| - |currentConstrainedOut|];
          lm.GenerateLogits(prompt + stablePrefix2 + currentConstrainedOut);
          var cands := helpers.TopValidCandidates(lm, parser, prompt, currentConstrainedOut, 4, eosToken);
          helpers.BoostTokenLogits(lm, cands, 8.0);
          var next2 := lm.ChooseNextToken();
          helpers.cost := helpers.cost + 1;
          steps := steps + 1;
          if next2 == eosToken {
            break;
          } else {
            var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next2
            );
            generated := appendedGenerated;
            insideConstrainedOut := appendedInside;
            currentConstrainedOut := appendedCurrent;
          }
        } else {
          var stablePrefix3 := generated[..|generated| - |currentConstrainedOut|];
          var constrainedPrompt := prompt + stablePrefix3;
          var next3 := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
          steps := steps + 1;
          if next3 == eosToken {
            break;
          } else {
            var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next3
            );
            generated := appendedGenerated2;
            insideConstrainedOut := appendedInside2;
            currentConstrainedOut := appendedCurrent2;
          }
        }
      }
    }
  }
}

cost := steps;

