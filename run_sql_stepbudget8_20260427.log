Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy mixed constrained and unconstrained sampling inside the
// SQL span. Although syntax stayed valid, the soft-bias branch often wandered
// into low-quality continuations and produced long, repetitive but still
// grammar-valid SQL-like text. For Spider, the output should be dominated by a
// single schema-valid SQL query, so the revised strategy is much stricter.
//
// Main changes:
// 1. Outside the constrained span, we still search for "<<" but only one token
//    per outer step, preserving the required delimiter behavior.
// 2. Once inside the SQL span, we never use unconstrained sampling. We decode
//    only with parser-aware constrained steps.
// 3. If the parser reports the current SQL prefix is complete, we close the span
//    immediately with ">>" rather than trying to elaborate further.
// 4. If the constrained prefix becomes narrow/dead-end-like, we roll back to the
//    nearest valid prefix before continuing. This is a recovery mechanism aimed
//    at preventing the long malformed-but-grammar-accepted continuations seen in
//    evaluation.
// 5. We also cap the amount of SQL content generated inside one span by using
//    the global maxSteps loop; every constrained iteration consumes exactly one
//    step and appends at most one token, so generation tends to terminate as
//    soon as a complete SQL query is available.
//
// This replaces the earlier exploratory candidate-boosting branch with a
// deterministic parser-respecting strategy better matched to Spider's
// text-to-SQL setting.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-span branch, UnconstrainedStep either keeps us
//   outside (implication vacuous) or we detect the opening delimiter and set
//   currentConstrainedOut := [], which is valid by parser.IsValidPrefix([]). In
//   the complete-prefix branch, CloseConstrainedSpan exits constrained mode, so
//   the implication is vacuous. In the rollback branch, RollbackConstrainedSpan
//   returns a parser-valid constrained prefix. In the constrained-step branch,
//   ConstrainedStep returns a parser-valid next token or EOS; if not EOS,
//   AppendConstrainedToken preserves parser validity.
// suffix: Outside the span, remaining outside makes the implication vacuous; on
//   opening "<<", currentConstrainedOut is reset to [], and the empty suffix
//   matches. CloseConstrainedSpan leaves constrained mode, so the implication is
//   vacuous. RollbackConstrainedSpan restores generated and currentConstrainedOut
//   consistently so that the generated suffix equals the constrained prefix.
//   AppendConstrainedToken appends the same token to both generated and
//   currentConstrainedOut, preserving the suffix relation.
// cost accounting: We maintain a local `steps` counter and return `cost :=
//   steps`. Each outer iteration either performs one UnconstrainedStep, one
//   CloseConstrainedSpan, one rollback action, or one ConstrainedStep, and in
//   each such branch we increment `steps` by exactly 1. Breaks occur only after
//   the corresponding step has been counted, so `cost <= maxSteps` follows.
// progress: Initially |generated| = |generatedPrefix|. In the outside-span
//   branch, UnconstrainedStep appends at most one token; after incrementing
//   steps, the bound holds because stepTokenBudget >= 1. CloseConstrainedSpan,
//   rollback, and constrained append each change generated by at most one token
//   in the forward direction; rollback may shorten generated, which also
//   preserves the bound. Thus every branch maintains
//   |generated| <= |generatedPrefix| + steps * stepTokenBudget.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 1);
      if narrow && |currentConstrainedOut| > 0 {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
        var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
          parser, stablePrefix, generated, currentConstrainedOut
        );
        generated := stablePrefix + rolled;
        currentConstrainedOut := rolled;
        insideConstrainedOut := true;
        steps := steps + 1;
      } else {
        var stablePrefix2 := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt := prompt + stablePrefix2;
        var next2 := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next2 == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next2
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

