        lm.GenerateLogits(prompt + stablePrefix + currentConstrainedOut);
        helpers.PenalizeTokenLogits(lm, ["<<"], 100.0);
        helpers.PenalizeTokenLogits(lm, [">>"], 100.0);
        if |currentConstrainedOut| < minSqlTokens {
          helpers.PenalizeTokenLogits(lm, [eosToken], 100.0);
        }
        var maxChunk := stepTokenBudget;
        var chunkGenerated, stoppedOnOpenSpan, stoppedOnEos, stepsUsed := helpers.UnconstrainedChunk(
          lm, prompt, generated, maxChunk, "<<", eosToken
        );
        var chunkCurrent := chunkGenerated[|stablePrefix|..];
        var rolled := helpers.RollbackToValidPrefix(parser, chunkCurrent);
        var repairedGenerated, repairedCurrent := helpers.RollbackConstrainedSpan(
          parser, stablePrefix, chunkGenerated, chunkCurrent
        );
        generated := repairedGenerated;
        currentConstrainedOut := repairedCurrent;
        insideConstrainedOut := true;
        steps := steps + stepsUsed;
        if stoppedOnEos {
          break;
        } else {
          if stoppedOnOpenSpan {
            var completeAfterRepair := parser.IsCompletePrefix(currentConstrainedOut);
            if completeAfterRepair && minSqlTokens <= |currentConstrainedOut| {
