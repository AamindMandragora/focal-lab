Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy was too permissive inside the SQL span: when the valid
// frontier was broad, it merely boosted a few valid tokens and still sampled
// from the unconstrained distribution. That preserved syntax but often emitted
// low-quality SQL continuations, including malformed delimiter interactions and
// poor clause choices. For Spider, accuracy matters more than stylistic freedom,
// so this revision makes the constrained span much more parser-dominant.
//
// Revised strategy:
// 1. Outside the SQL span, use `UnconstrainedChunk` only to reach the opening
//    delimiter `<<` (or EOS), preserving the required wrapper behavior.
// 2. Inside the SQL span, never sample arbitrary unconstrained tokens. If the
//    current SQL prefix is complete, close immediately with `>>`.
// 3. Otherwise, use parser-guided constrained decoding every step. When the
//    frontier is narrow or a dead end is suspected, directly call
//    `ConstrainedStep`.
// 4. When the frontier is broader, still restrict generation to valid parser
//    continuations by computing top valid candidates, heavily penalizing a few
//    delimiter-like / obviously bad tokens, and sampling once; if that sampled
//    token is not parser-valid, fall back in the same outer step to
//    `ConstrainedStep`. This keeps every accepted SQL token parser-valid while
//    remaining more model-sensitive than a purely deterministic walk.
// 5. To address the observed repeated or overlong SQL fragments, when the active
//    constrained prefix becomes a complete SQL query we close immediately on the
//    next iteration rather than continuing to explore.
//
// The key change is that every token accepted inside `<< ... >>` is guaranteed
// to be parser-valid, and broad-frontier exploration now has an in-step
// parser-guided fallback instead of silently wasting the step or drifting.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained-chunk branch, if we stay outside then
//   the implication is vacuous; if we stop on `<<`, we enter constrained mode
//   with `currentConstrainedOut := []`, which is valid by the precondition on
//   the parser. In the close branch, `CloseConstrainedSpan` exits constrained
//   mode, so the implication is vacuous afterward. In both constrained-token
//   branches, we append only tokens returned by `ConstrainedStep` or checked by
//   `IsTokenValidNext`; `AppendConstrainedToken` therefore preserves
//   `parser.IsValidPrefix(currentConstrainedOut)`. The fallback sub-branch also
//   uses `ConstrainedStep`, so validity is preserved there as well.
// suffix: In the unconstrained-chunk branch, if `stoppedOpen` is false we stay
//   outside and the implication is vacuous; if `stoppedOpen` is true we set the
//   active constrained prefix to `[]`, and the empty suffix property holds
//   immediately. In the close branch, `CloseConstrainedSpan` resets the active
//   constrained prefix to `[]`, so the implication is vacuous. In every append
//   branch, `AppendConstrainedToken` appends the same accepted token to both the
//   full generated output and the active constrained prefix, preserving the
//   suffix equality.
// progress: In the chunk branch, `stepsUsed <= maxSteps - steps` by the chosen
//   chunk budget, and the helper appends at most `stepsUsed` tokens, so after
//   `steps := steps + stepsUsed` we still have
//   `|generated| <= |generatedPrefix| + steps * stepTokenBudget` because
//   `stepTokenBudget >= 1`. In the close branch and in each constrained-token
//   branch, one outer step is consumed and at most one token is appended, so the
//   bound is preserved since `1 <= stepTokenBudget`. EOS branches append no
//   further token and therefore also preserve the bound.
// cost accounting: The loop maintains `0 <= steps <= maxSteps` and leaves the
//   out-parameter `cost` unchanged at 0 until the end. The chunk branch adds
//   `stepsUsed`, bounded by the remaining budget. Every other branch increments
//   `steps` by exactly 1, including the broad-frontier branch with fallback,
//   because the entire attempt is one outer decoding step. Thus the decreases
//   measure `maxSteps - steps` strictly drops whenever the loop continues, and
//   assigning `cost := steps` at the end ensures `cost <= maxSteps`.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else {
      if stoppedOpen {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 4);
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      if narrow {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var candidates := helpers.TopValidCandidates(
          lm, parser, constrainedPrompt, currentConstrainedOut, 6, eosToken
        );
        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
        helpers.BoostTokenLogits(lm, candidates, 100.0);
        helpers.PenalizeTokenLogits(lm, [">>", "<<"], 100.0);
        var next := lm.ChooseNextTokenUnconstrained();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
          if valid {
            var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, next
            );
            generated := appendedGenerated2;
            insideConstrainedOut := appendedInside2;
            currentConstrainedOut := appendedCurrent2;
          } else {
            var fallback := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
            if fallback == eosToken {
              break;
            } else {
              var appendedGenerated3, appendedInside3, appendedCurrent3 := helpers.AppendConstrainedToken(
                lm, parser, generated, currentConstrainedOut, fallback
              );
              generated := appendedGenerated3;
              insideConstrainedOut := appendedInside3;
              currentConstrainedOut := appendedCurrent3;
            }
          }
        }
      }
    }
  }
}

cost := steps;

