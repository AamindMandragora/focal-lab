Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy was verifier-friendly but too myopic for Spider SQL:
// once inside the constrained span it often accepted the model's raw argmax if
// it was merely parser-valid. That produced locally valid but semantically weak
// continuations such as repeated identifiers and under-structured clauses
// ("SELECT <id> <id> FROM"), which explains the high syntax rate but low task
// accuracy.
//
// The revised strategy changes the constrained behavior substantially.
// Outside the span, it still uses an unconstrained chunk to efficiently reach
// the required SQL delimiter "<<". Inside the span, however, it no longer
// greedily trusts a single unconstrained argmax. Instead it always performs a
// parser-aware constrained decoding step, but with targeted logit shaping
// before sampling: when the current SQL prefix is in a narrow/dead-end region,
// we strongly boost a small parser-valid candidate set and penalize EOS so the
// model commits to schema- and grammar-consistent continuations rather than
// prematurely stopping or drifting among weak valid tokens. When the prefix is
// not narrow, we still use parser-aware constrained decoding, which lets the
// helper choose among valid next SQL tokens while respecting the grammar.
//
// Another important change is completion handling. We close the constrained
// span immediately once the SQL prefix is complete, and we never close merely
// because a sampled token resembles ">>". This keeps the output in the required
// `<< ... >>` format while ensuring the parser governs the SQL content itself.
// Overall, the strategy trades some speculative speed for much stronger
// structure inside the SQL span, directly targeting the observed failure mode
// of syntactically valid but inaccurate SQL continuations.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, remaining outside the
//   span makes the implication vacuous; if the chunk stops on "<<", we enter
//   the span with `currentConstrainedOut := []`, valid by precondition. In the
//   complete-prefix branch, `CloseConstrainedSpan` exits the span so the
//   implication is vacuous. In the rollback branch, `RollbackConstrainedSpan`
//   returns a parser-valid constrained prefix. In the constrained-step branch,
//   `ConstrainedStep` returns EOS or a parser-valid next token; on non-EOS we
//   append it with `AppendConstrainedToken`, preserving parser validity.
//
// suffix: In the chunk branch, staying outside makes the implication vacuous;
//   entering on "<<"" sets `currentConstrainedOut := []`, and the empty suffix
//   property holds trivially. In the complete-prefix branch, closing the span
//   sets `insideConstrainedOut := false`, so the implication is vacuous. In the
//   rollback branch, `RollbackConstrainedSpan` restores `generated` and the
//   constrained suffix together, so the suffix relation is re-established. In
//   the constrained-step branch, `AppendConstrainedToken` appends the same SQL
//   token to both `generated` and `currentConstrainedOut`, preserving the
//   suffix equality.
//
// cost accounting: We return the local `steps` as `cost`. In the chunk branch,
//   `UnconstrainedChunk` returns `stepsUsed` and we add exactly that to
//   `steps`, with `stepsUsed <= maxSteps - old(steps)` because the chunk budget
//   is `maxSteps - steps`. In the complete-prefix branch and the constrained-
//   step branch we increment `steps` by exactly 1. The rollback branch is
//   paired with the same outer iteration's constrained-step branch and does not
//   itself increment `steps`; thus `steps` remains within `[0, maxSteps]`.
//
// progress: Initially `generated == generatedPrefix`. In the chunk branch,
//   `UnconstrainedChunk` adds at most `stepsUsed` tokens, and since
//   `stepTokenBudget >= 1`, this is at most `stepsUsed * stepTokenBudget`; after
//   updating `steps`, the bound is preserved. In the complete-prefix branch,
//   closing adds at most one token and `steps` increases by 1, so the bound
//   holds because `1 <= stepTokenBudget`. In the rollback branch, `generated`
//   can only shrink, so the bound is preserved immediately. In the constrained-
//   step branch, appending one SQL token adds at most one token while `steps`
//   grows by 1, again preserving the bound. Breaks do not mutate `generated`
//   after the relevant step update, so the invariant holds on exit.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else {
      if stoppedOpen {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var rolled := helpers.RollbackToValidPrefix(parser, currentConstrainedOut);
      if |rolled| < |currentConstrainedOut| {
        var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
        var rolledGenerated, rolledCurrent := helpers.RollbackConstrainedSpan(
          parser, stablePrefix, generated, currentConstrainedOut
        );
        generated := rolledGenerated;
        currentConstrainedOut := rolledCurrent;
        insideConstrainedOut := true;
      } else {
        var stablePrefix2 := generated[..|generated| - |currentConstrainedOut|];
        var constrainedPrompt := prompt + stablePrefix2;
        var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 3);
        if narrow {
          lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
          var candidates := helpers.TopValidCandidates(lm, parser, constrainedPrompt, currentConstrainedOut, 4, eosToken);
          helpers.BoostTokenLogits(lm, candidates, 8.0);
          helpers.PenalizeTokenLogits(lm, [eosToken], 100.0);
        }
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

