Strategy: // CSD_RATIONALE_BEGIN
// Spider text-to-SQL has a natural split between free-form explanation/context
// tokens outside a constrained SQL span and grammar-checked SQL tokens inside
// the span. This strategy tracks three pieces of state: the full generated
// output (`generated`), whether we are currently inside a constrained SQL span
// (`insideConstrainedOut`), and the SQL-only suffix currently being validated
// by the schema-specialized parser (`currentConstrainedOut`).
//
// Outside a span, the strategy uses chunked unconstrained decoding so the model
// can quickly emit boilerplate or reach the SQL delimiter with low overhead.
// The chunk stops early on EOS or on the open-span token "<<". Inside a span,
// the strategy first checks whether the current SQL prefix is already complete;
// if so it closes immediately with `CloseConstrainedSpan`. Otherwise it uses a
// speculative fast path: look at the model argmax under the constrained prompt,
// and if that token is parser-valid, append it directly. If the argmax is not
// parser-valid, fall back to `ConstrainedStep`, which chooses a parser-valid
// next token. This combines speed (cheap argmax acceptance on common SQL
// continuations like SELECT / FROM / identifiers) with correctness (fallback
// to parser-aware constrained decoding when the unconstrained preference would
// violate the grammar or schema narrowing).
//
// The tracked constrained suffix is what makes the parser checks verifier-
// friendly: every accepted SQL token is appended to both `generated` and
// `currentConstrainedOut`, so the parser-valid prefix and suffix relationship
// remain explicit throughout generation.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained chunk branch, if we stay outside the
//   span then the implication is vacuous; if `stoppedOpen` is true we set
//   `insideConstrainedOut := true` and `currentConstrainedOut := []`, which is
//   valid by the method precondition `parser.IsValidPrefix([])`. In the
//   complete-prefix branch, `CloseConstrainedSpan` sets `insideConstrainedOut`
//   to false, so the implication becomes vacuous. In the speculative argmax
//   branch inside the span, we call `AppendConstrainedToken` only after
//   `IsTokenValidNext` returns true, so the new constrained prefix is valid. In
//   the fallback branch, `ConstrainedStep` returns either EOS (break) or a
//   parser-valid next token, and appending that token preserves validity.
//
// suffix: In the chunk branch, when we remain outside the span the implication
//   is vacuous; when `stoppedOpen` is true we have just entered the span with
//   `currentConstrainedOut := []`, and the length-0 suffix of `generated` is
//   `[]`. In the complete-prefix branch, `CloseConstrainedSpan` appends the
//   closing delimiter and resets `currentConstrainedOut` to `[]`, so the
//   implication is again vacuous. In both constrained append branches,
//   `AppendConstrainedToken` appends the same token to `generated` and to
//   `currentConstrainedOut`, preserving that the active constrained prefix is
//   exactly the suffix of `generated`.
//
// cost accounting: We use a local `steps` counter as the returned cost. In the
//   chunk branch, `UnconstrainedChunk` returns `stepsUsed`; we update
//   `steps := steps + stepsUsed`, and `stepsUsed <= maxSteps - old(steps)`
//   because the chunk budget is exactly `maxSteps - steps`. In the close,
//   speculative-append, and constrained-fallback branches we increment `steps`
//   by exactly 1. Thus `steps` stays between 0 and `maxSteps`, and assigning
//   `cost := steps` at the end proves `cost <= maxSteps`.
//
// progress: Initially `generated == generatedPrefix`. In the chunk branch,
//   `UnconstrainedChunk` adds at most `stepsUsed` tokens, and since
//   `stepTokenBudget >= 1`, `stepsUsed <= stepsUsed * stepTokenBudget`; after
//   updating `steps`, the bound
//   `|generated| <= |generatedPrefix| + steps * stepTokenBudget` is preserved.
//   In the close branch, at most one token (`">>"`) is appended and steps grows
//   by 1, so the bound holds because `1 <= stepTokenBudget`. In the speculative
//   append and constrained fallback branches, at most one SQL token is appended
//   and steps grows by 1, so the same arithmetic preserves the bound. Break
//   branches do not mutate `generated` after the step update, so the invariant
//   remains true on loop exit.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps * stepTokenBudget
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var chunkBudget: nat := maxSteps - steps;
    var chunkedGenerated, stoppedOpen, stoppedEos, stepsUsed := helpers.UnconstrainedChunk(
      lm, prompt, generated, chunkBudget, "<<", eosToken
    );
    generated := chunkedGenerated;
    steps := steps + stepsUsed;
    if stoppedEos {
      break;
    } else if stoppedOpen {
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);
      if argmaxValid && argmax != eosToken {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

cost := steps;

