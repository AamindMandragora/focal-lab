Strategy: // CSD_RATIONALE_BEGIN
// Revised strategy optimized for math word problems that require every
// arithmetic computation to appear inside << >>. The prior version sometimes
// opened spans too opportunistically and also spent too many steps inside
// constrained decoding, which hurt syntax rate and occasionally let malformed
// mixed text appear around computations. This revision makes delimiter handling
// simpler and more reliable:
//
// 1. Outside constrained mode, we strongly prefer opening a span when the model
//    itself proposes "<<", when the sampled token contains "<<", or when the
//    open-delimiter token is the current argmax / near-argmax. This increases
//    the chance that arithmetic is emitted inside delimiters.
// 2. Once inside a span, we avoid expensive speculative logic. If the current
//    constrained prefix is complete, we immediately close with ">>". Otherwise
//    we take exactly one parser-guided constrained step and append it only when
//    valid. This reduces runtime and avoids malformed partial arithmetic text.
// 3. We never close merely because a sampled token resembles ">>"; closing is
//    done only from a branch where parser completeness is already known.
// 4. Cost accounting is tied directly to `steps`, and each continuing branch
//    performs at most one token-growth action, improving both proof simplicity
//    and evaluation robustness.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In unconstrained branches, either we stay outside
//   constrained mode after appending a normal token, making the implication
//   vacuous, or we open a span with currentConstrainedOut := [], which is a
//   valid prefix by precondition. In the complete-prefix branch, closing sets
//   insideConstrainedOut to false, so the implication is vacuous. In the active
//   constrained branch, ConstrainedStep is parser-guided; we append only after
//   checking the returned token is valid next, so AppendConstrainedToken
//   preserves parser validity.
// suffix: Appending an unconstrained token while outside leaves the implication
//   vacuous. Opening a span appends only "<<", then sets currentConstrainedOut
//   to [], whose empty suffix matches generated. Closing resets
//   currentConstrainedOut to [] after appending ">>", so the implication again
//   holds vacuously. In the active constrained append branch,
//   AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, preserving the suffix equality.
// cost: UnconstrainedStep, ConstrainedStep, and CloseConstrainedSpan each bump
//   helpers.cost by 1 internally, and in the same branches we increment steps
//   by 1. In the eager-open branch driven by logits, GenerateLogits and logit
//   queries do not bump helpers.cost; we manually add 1 to helpers.cost exactly
//   when we increment steps, so helpers.cost <= steps is preserved.
// progress: Initially generated == generatedPrefix. Every non-breaking branch
//   increments steps by 1. The unconstrained append branch adds at most one
//   token, the eager-open branch adds exactly one token ("<<"), the constrained
//   append branch adds at most one token, and the close branch adds exactly one
//   token (">>"). EOS branches break immediately without further growth. Hence
//   |generated| <= |generatedPrefix| + steps is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    var sampled := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;

    if sampled == eosToken {
      break;
    } else {
      var shouldOpen := false;
      if sampled == "<<" {
        shouldOpen := true;
      } else if Contains(sampled, "<<") {
        shouldOpen := true;
      } else if argmax == "<<" {
        shouldOpen := true;
      } else if openLogit >= argmaxLogit - 1.0 {
        shouldOpen := true;
      }

      if shouldOpen {
        generated := generated + ["<<"];
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        generated := generated + [sampled];
      }
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
        if valid {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

