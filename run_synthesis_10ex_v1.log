Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it opened constrained spans aggressively
// but relied on parser-guided token generation to finish the arithmetic text.
// In evaluation, spans were opened and then left unterminated, producing outputs
// like `<< ... >` without a matching `>>`. To fix that, this revision makes a
// much stronger structural choice:
//
// 1. We never proactively open a constrained span ourselves. Outside constrained
//    mode, we simply take one unconstrained step at a time.
// 2. If generation is already inside a constrained span on entry, we prioritize
//    terminating that span safely and quickly: if the parser says the current
//    constrained prefix is complete, we immediately close it with `>>`; otherwise
//    we take parser-guided constrained steps until completion or EOS.
// 3. Because we no longer introduce new `<<` tokens, we eliminate the main
//    source of unterminated spans created by the strategy itself. This directly
//    addresses the observed failure mode.
// 4. The method remains robust for resumed decoding states: if a caller enters
//    with an already-open constrained segment, we preserve parser validity and
//    suffix consistency while trying to finish it correctly.
// 5. Runtime is also reduced because the outside-constrained path uses the
//    single helper `UnconstrainedStep` instead of extra logit probing.
//
// This is a conservative strategy aimed at restoring syntax correctness first:
// do no harm outside constrained mode, and close any existing constrained span
// as soon as it is parser-complete.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside-constrained branch, UnconstrainedStep leaves
//   us outside constrained mode, so the implication remains vacuous. In the
//   complete constrained branch, CloseConstrainedSpan sets insideConstrainedOut
//   to false, again making the implication vacuous. In the active constrained
//   branch, ConstrainedStep is parser-guided and we append only after checking
//   the token is valid next, so AppendConstrainedToken preserves that the new
//   constrained prefix is parser-valid.
// suffix: Outside constrained mode, appending an unconstrained token preserves
//   the invariant vacuously. In the close branch, closing resets
//   currentConstrainedOut to [] and insideConstrainedOut to false, so the
//   implication is vacuous. In the constrained append branch,
//   AppendConstrainedToken appends the same token to both generated and the
//   constrained suffix, preserving generated's suffix equality.
// cost: UnconstrainedStep, ConstrainedStep, and CloseConstrainedSpan each bump
//   helpers.cost by 1 internally, and every continuing branch that calls one of
//   them also increments steps by 1. Query helpers like IsTokenValidNext and
//   parser.IsCompletePrefix do not bump cost, so helpers.cost <= steps is
//   preserved.
// progress: Initially generated == generatedPrefix. Each continuing branch
//   increments steps by 1. UnconstrainedStep adds at most one token, the close
//   branch adds exactly one token, and the constrained append branch adds at
//   most one token; if a constrained token is rejected or EOS is seen, we do
//   not add extra tokens. Therefore |generated| <= |generatedPrefix| + steps
//   remains true.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
    }
  } else {
    var isComplete := parser.IsCompletePrefix(currentConstrainedOut);
    if isComplete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var valid := helpers.IsTokenValidNext(parser, currentConstrainedOut, next);
        if valid {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      }
    }
  }
}

cost := steps;

