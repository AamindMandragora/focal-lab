Strategy: // CSD_RATIONALE_BEGIN
// Step-by-step math CSD with eager delimiter entry and parser-guided recovery.
// The strategy tracks the full generated answer in `generated`, whether we are
// currently inside a computation span in `insideConstrainedOut`, and the active
// span contents (without delimiters) in `currentConstrainedOut`.
// Outside a span, it looks at the sampled token and also at the model logits:
// if the token itself is "<<", or if the token text contains "<<" and the
// delimiter logit is close to the argmax, it proactively opens a constrained
// span so arithmetic can be generated under parser control. Inside a span, if
// the current constrained prefix is complete we close with ">>"; otherwise we
// prefer a valid argmax token when available, and fall back to ConstrainedStep
// when the argmax is invalid. This tracked state ensures constrained text is
// always a parser-valid prefix and remains the suffix of the full generated
// output while a span is open.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, appending a normal token leaves
//   insideConstrainedOut false, so the implication is vacuous; opening a span
//   sets currentConstrainedOut := [], and parser.IsValidPrefix([]) holds by
//   precondition. In the complete-prefix branch, CloseConstrainedSpan sets
//   insideConstrainedOut to false, again making the implication vacuous. In the
//   constrained argmax-fast-path and ConstrainedStep fallback, we call
//   AppendConstrainedToken only after establishing the chosen token is a valid
//   next token, so the new constrained prefix stays valid.
// suffix: In unconstrained normal-token branches we do not change
//   currentConstrainedOut, and when we open a span we set it to [] after
//   appending "<<", so the length-0 suffix matches. CloseConstrainedSpan
//   atomically appends ">>" and resets currentConstrainedOut to [], so the
//   implication holds. In both constrained append branches,
//   AppendConstrainedToken appends the same token to generated and to
//   currentConstrainedOut, preserving the suffix equality.
// cost: UnconstrainedStep, CloseConstrainedSpan, and ConstrainedStep each bump
//   helpers.cost by 1 internally, and in those branches we also do
//   steps := steps + 1. In the eager-open branch based on raw logits we use
//   GenerateLogits plus query helpers (no bump), then manually do
//   helpers.cost := helpers.cost + 1 together with steps := steps + 1. In the
//   constrained argmax-fast-path, no helper bumps cost and we still increase
//   steps by 1, so helpers.cost <= steps is preserved with slack.
// progress: Every branch that continues the loop increases steps by 1. The
//   unconstrained normal-token, eager-open, and constrained append branches
//   append at most one token to generated; the close branch appends only the
//   closing delimiter token; EOS branches break immediately without further
//   growth. Therefore |generated| never exceeds |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else if next == "<<" {
      generated := generated + [next];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else {
      lm.GenerateLogits(prompt + generated);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
      var openLogit := helpers.GetTokenLogit(lm, "<<");
      var shouldOpen := false;
      if Contains(next, "<<") {
        if openLogit >= argmaxLogit - 3.0 {
          shouldOpen := true;
        }
      }
      if shouldOpen {
        generated := generated + ["<<"];
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        generated := generated + [next];
      }
    }
  } else if parser.IsCompletePrefix(currentConstrainedOut) {
    var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
      lm, parser, generated, currentConstrainedOut
