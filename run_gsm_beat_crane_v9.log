// CSD_RATIONALE_BEGIN
// Math-step CSD with delimiter-triggered constrained arithmetic spans. The
// strategy tracks the usual generated text plus whether it is currently inside
// a constrained `<< ... >>` region and, if so, the exact constrained suffix
// `currentConstrainedOut` that the parser has already accepted.
//
// Outside constrained spans, generation is unconstrained except that seeing a
// token containing "<<" opens a constrained region. Inside a constrained span,
// the strategy chooses among three actions based on parser state: if the span
// is already complete, it closes with `>>`; if the grammar is narrow, it uses
// a caller-guided adaptive constrained sampler over validTokenGroups to steer
// arithmetic tokens; otherwise it uses a plain constrained step. This keeps
// arithmetic computations parser-valid while still allowing flexible natural-
// language reasoning outside delimiters.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, the only transition to
//   insideConstrainedOut == true is when the sampled token contains "<<"; we
//   then set currentConstrainedOut := [], and parser.IsValidPrefix([]) holds by
//   precondition. In the close branch, CloseConstrainedSpan sets
//   insideConstrainedOut := false, so the implication becomes vacuous. In both
//   constrained decoding branches, the chosen token is either eosToken (break)
//   or parser-valid by the helper postcondition, and AppendConstrainedToken
//   therefore yields a parser-valid updated prefix.
// suffix: Outside the span, either we remain outside (implication vacuous) or
//   we enter with currentConstrainedOut := [], whose length-0 suffix matches
//   the end of generated after appending the opener token. In the close branch,
//   CloseConstrainedSpan appends at most the closing delimiter and resets the
//   constrained suffix to [], so the implication is vacuous. In each
//   constrained append branch, AppendConstrainedToken appends the same token to
//   both generated and currentConstrainedOut, preserving suffix equality.
// cost accounting: The loop uses a local steps counter only. Every non-break
//   branch calls exactly one cost-bumping helper among UnconstrainedStep,
//   CloseConstrainedSpan, AdaptiveConstrainedStep, or ConstrainedStep, then
//   increments steps by 1; AppendConstrainedToken is non-bumping, so returned
//   cost := steps remains <= maxSteps. Break branches also occur only after a
//   single cost-bumping helper and thus preserve steps <= maxSteps.
// progress bound: Outside, UnconstrainedStep appends exactly one token and we
//   do steps := steps + 1, so |generated| grows by 1 at most. The close branch
//   appends at most one token and also increments steps by 1. In each
//   constrained decoding branch, either EOS breaks immediately with generated
//   unchanged, or AppendConstrainedToken appends exactly one token while steps
//   increases by 1. Therefore |generated| <= |generatedPrefix| + steps is
//   preserved in every non-breaking branch, and decreases maxSteps - steps is
//   satisfied.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var narrowThreshold: nat := 12;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if Contains(next, "<<") {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      if validCount <= narrowThreshold {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, prompt + stablePrefix, currentConstrainedOut, validTokenGroups, 4.0, narrowThreshold, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var constrainedPrompt := prompt + stablePrefix;
        var g, i, c, hitEos := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := g;
          insideConstrainedOut := i;
          currentConstrainedOut := c;
        }
      }
    }
  }
}

cost := steps;
