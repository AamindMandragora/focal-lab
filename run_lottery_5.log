Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy opened constrained spans aggressively and then tried to
// build arithmetic token-by-token under parser control. Evaluation showed that
// this frequently produced unterminated spans, so the revised strategy changes
// the policy completely: it is conservative about opening `<<` and, once inside
// a constrained span, it prioritizes guaranteed termination over creativity.
// Concretely, outside constrained mode it only opens a span when the model
// explicitly emits the delimiter token `<<`; otherwise it performs ordinary
// unconstrained generation. Inside constrained mode, if the current constrained
// prefix is already complete we immediately close with `>>`. If it is not yet
// complete, we take exactly one parser-constrained token step; after that, on
// the next iteration, completeness is checked again and the span is closed as
// soon as allowed. This removes the earlier eager-opening behavior that created
// many partial expressions and directly targets the observed failure mode of
// missing closing delimiters.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the outside branch, if we remain outside then the
// implication is vacuous; if the sampled token is `<<`, OpenConstrainedSpan
// starts a fresh constrained segment with empty contents, and `[]` is a valid
// prefix by precondition. In the inside-complete branch, CloseConstrainedSpan
// sets `insideConstrainedOut` false, so the implication is vacuous. In the
// inside-incomplete branch, ConstrainedStep returns a parser-valid next token
// (or eos), and when it is not eos we pass it to AppendConstrainedToken, which
// preserves parser validity.
// suffix: While outside constrained mode there is no suffix obligation. Opening
// with OpenConstrainedSpan appends only the delimiter and sets the constrained
// contents to `[]`, so the required trailing slice is the empty suffix. Closing
// with CloseConstrainedSpan resets the constrained contents to `[]`, making the
// suffix condition trivial. Appending a constrained token uses
// AppendConstrainedToken, which extends both `generated` and
// `currentConstrainedOut` by the same token, preserving the suffix equality.
// cost: In the unconstrained branch, UnconstrainedStep bumps helper cost by 1
// and we increment `steps` by 1 in the same iteration. OpenConstrainedSpan and
// AppendConstrainedToken are non-bumping, so any extra state update in those
// branches cannot violate `helpers.cost <= steps`. In the inside-complete
// branch, CloseConstrainedSpan bumps helper cost by 1 and we also increment
// `steps` by 1. In the inside-incomplete branch, ConstrainedStep bumps helper
// cost by 1, while the subsequent AppendConstrainedToken is non-bumping, and we
// increment `steps` exactly once.
// progress: UnconstrainedStep appends at most one token to `generated`, and we
// then increment `steps` by 1; if that token is `<<`, OpenConstrainedSpan only
// re-expresses that same one-token growth rather than adding another token. In
// the inside-complete branch, CloseConstrainedSpan appends exactly one `>>` and
// `steps` grows by 1. In the inside-incomplete branch, ConstrainedStep itself
// does not change `generated`; if it returns a non-eos token then
// AppendConstrainedToken appends exactly one token, still within the single-step
// budget. Thus every iteration increases `generated` by at most one token while
// `steps` increases by one.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;

    if next == eosToken {
      break;
    } else if next == "<<" {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
    } else {
      generated := generated + [next];
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;

      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  }
}

cost := steps;

