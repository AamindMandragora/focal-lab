Strategy: // CSD_RATIONALE_BEGIN
// This strategy tracks the full generated output in `generated`, whether we are
// currently inside a math-computation span in `insideConstrainedOut`, and the
// active constrained contents between delimiters in `currentConstrainedOut`.
// Outside a span it generates mostly freely, but if the model appears close to
// opening a computation span (the logit of "<<" is near the argmax) or if the
// sampled token literally contains "<<", it opens a constrained span eagerly.
// Inside a span it uses parser-aware decoding: if the current constrained text
// is complete, it closes with ">>"; otherwise it prefers a valid argmax token
// when available and falls back to `ConstrainedStep` when the argmax is not a
// parser-valid continuation. This tracked state ensures that text between "<<"
// and ">>" stays parser-valid and aligned with the suffix of the full output.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, if we stay outside then the
// implication is vacuous; if we open a span (either eagerly or after sampling a
// token containing "<<"), we set currentConstrainedOut := [], which is a valid
// prefix by precondition. In the complete-prefix branch, CloseConstrainedSpan
// sets insideConstrainedOut to false, so the implication becomes vacuous. In
// the constrained argmax-valid and constrained-fallback branches, we call
// AppendConstrainedToken only with a token already shown valid by
// IsTokenValidNext or guaranteed by ConstrainedStep, so validity is preserved.
// suffix: Outside a span, no suffix obligation is required. When we open a span,
// we append the opener token to generated and set currentConstrainedOut := [],
// so the required suffix is the length-0 suffix, which equals []. In the close
// branch, CloseConstrainedSpan appends ">>" and resets currentConstrainedOut to
// [], making the suffix obligation trivial. In the append branches,
// AppendConstrainedToken appends the same token to both generated and the
// constrained suffix, preserving equality of the trailing segment.
// cost: In the unconstrained raw-sampling branch we manually increment
// helpers.cost once after ChooseNextTokenUnconstrained and also increment steps
// once, so helpers.cost <= steps is preserved. OpenConstrainedSpan itself does
// not need to be called here; eager opening is done by direct state update with
// no helper-cost bump. In the close branch, CloseConstrainedSpan bumps helper
// cost once and we increment steps once. In the constrained fast path,
// AppendConstrainedToken is non-bumping, so increasing steps by 1 only adds
// slack. In the constrained fallback, ConstrainedStep bumps once and steps also
// grows by 1.
// progress: In the unconstrained branch, we append at most one token to
// generated before steps increases by 1. In the eager-open subcase we append
// exactly one opener token. In the close branch, CloseConstrainedSpan appends
// one token and steps grows by 1. In the constrained append branches,
// AppendConstrainedToken appends one token and the iteration also increments
// steps by 1. Thus |generated| never exceeds |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;

    if next == eosToken {
      break;
    } else if openLogit >= argmaxLogit - 2.0 && next != "<<" {
      generated := generated + ["<<"];
      insideConstrainedOut := true;
      currentConstrainedOut := [];
    } else {
      generated := generated + [next];
      if next == "<<" || Contains(next, "<<") {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
      var argmax := helpers.GetHighestLogitToken(lm);
      var argmaxValid := helpers.IsTokenValidNext(parser, currentConstrainedOut, argmax);

      if argmaxValid && argmax != eosToken {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, argmax
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
        steps := steps + 1;
      } else {
        var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated2;
          insideConstrainedOut := appendedInside2;
          currentConstrainedOut := appendedCurrent2;
        }
      }
    }
  }
}

cost := steps;

