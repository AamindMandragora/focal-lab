Strategy: // CSD_RATIONALE_BEGIN
// The previous strategy failed because it could open a constrained span too
// eagerly and then rely on free-form token generation inside the span, which
// often produced invalid or incomplete arithmetic text and never reached a
// parser-complete state, leaving "<< ... " unterminated.
// 
// The revised strategy is conservative and closure-oriented:
// - Outside constrained mode, generation is unconstrained except for a mild
//   bias toward opening when the model explicitly proposes "<<".
// - Once inside a constrained span, we never use speculative raw argmax
//   appends. Instead, we exclusively use ConstrainedStep to obtain a
//   parser-valid next token, append it, and immediately check whether the
//   constrained prefix is complete.
// - As soon as the parser says the constrained prefix is complete, we spend the
//   next step closing with CloseConstrainedSpan. We never attempt to close just
//   because a token resembles ">>"; closure is driven only by parser
//   completeness, satisfying the delimiter discipline.
// 
// This directly targets the evaluation failure mode: every opened span is
// advanced only through parser-valid tokens and then closed at the earliest
// parser-complete point, making unterminated constrained segments much less
// likely while preserving the required invariants.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In unconstrained branches, either we stay outside
//   constrained mode, making the implication vacuous, or we open a span with
//   currentConstrainedOut := [], which is valid by the method precondition on
//   the parser. In the constrained append branch, ConstrainedStep returns a
//   token suitable for constrained decoding and AppendConstrainedToken extends
//   the current constrained prefix with that token, preserving validity; in the
//   close branch, CloseConstrainedSpan sets insideConstrainedOut to false, so
//   the implication is vacuous again.
// suffix: If we remain unconstrained, constrained state is unchanged, so any
//   existing suffix relationship is preserved vacuously or directly. Opening a
//   span appends only "<<" and sets currentConstrainedOut to [], whose empty
//   suffix matches trivially; constrained append adds the same token to both
//   generated and currentConstrainedOut, and closing resets currentConstrainedOut
//   to [] after appending ">>", so the invariant continues to hold.
// cost: Every step-consuming branch increments steps exactly once. The only
//   helpers used that bump helpers.cost are UnconstrainedStep, ConstrainedStep,
//   OpenConstrainedSpan, and CloseConstrainedSpan, and each such call occurs in
//   a branch where steps is incremented once in the same iteration; branches
//   with only state updates use no extra cost-bumping primitive, so
//   helpers.cost <= steps is preserved.
// progress: Each iteration increases steps by 1. UnconstrainedStep appends at
//   most one token; OpenConstrainedSpan appends exactly one token "<<";
//   AppendConstrainedToken appends exactly one constrained token; and
//   CloseConstrainedSpan appends exactly one token ">>". Therefore generated
//   grows by at most one token per step, preserving
//   |generated| <= |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;
helpers.cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if insideConstrainedOut {
    var completeNow := parser.IsCompletePrefix(currentConstrainedOut);
    if completeNow {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var next := helpers.ConstrainedStep(lm, parser, constrainedPrompt, currentConstrainedOut, eosToken);
      steps := steps + 1;
      if next == eosToken {
        break;
      } else {
        var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
          lm, parser, generated, currentConstrainedOut, next
        );
        generated := appendedGenerated;
        insideConstrainedOut := appendedInside;
        currentConstrainedOut := appendedCurrent;
      }
    }
  } else {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 8.0);
    var next := lm.ChooseNextToken();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;
    if next == eosToken {
      break;
    } else if next == "<<" {
      var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
      generated := openedGenerated;
      insideConstrainedOut := openedInside;
      currentConstrainedOut := openedCurrent;
    } else {
      generated := generated + [next];
    }
  }
}

cost := steps;

