// This strategy tracks three pieces of generation state: the full generated
// output (`generated`), whether we are currently inside a constrained arithmetic
// span (`insideConstrainedOut`), and the content accumulated inside that span
// (`currentConstrainedOut`). Outside spans, generation is mostly free but we
// bias toward opening `<<` when the model already appears interested in doing
// arithmetic soon, either because `<<` itself is competitive or because the
// sampled token text contains `<<`.
// Inside spans, the parser state is the main control signal. If the current
// constrained prefix is complete, we close with `>>`. Otherwise we inspect how
// many valid next tokens remain: when the parser looks narrow or near a dead
// end, we use hard constrained decoding (`ConstrainedStep`); when it looks
// broad, we try a softer top-valid-candidate boost and sample, appending only
// if the sampled token is parser-valid.
// This supports the task because arithmetic work is funneled into `<< >>`
// spans, and `currentConstrainedOut` always mirrors exactly the suffix of the
// generated text between delimiters. That lets us use parser validity to keep
// computations well-formed while still allowing freer text generation outside
// the delimiters.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity: In the unconstrained branch, appending a normal token keeps
//   insideConstrainedOut false, so the implication is vacuous; if we instead
//   open a span, we set currentConstrainedOut := [], which is valid by the
//   method precondition on parser.IsValidPrefix([]). In the complete-prefix
//   branch, CloseConstrainedSpan sets insideConstrainedOut to false, again
//   making the implication vacuous. In the hard constrained branch,
//   ConstrainedStep is followed by AppendConstrainedToken only on a non-EOS
//   token chosen for the current parser state, so validity is preserved. In the
//   soft constrained branch, we append only when IsTokenValidNext returns true;
//   the reject branch leaves the state unchanged.
// suffix: In unconstrained free-text steps we do not modify currentConstrainedOut;
//   if we open a span we append "<<" and set currentConstrainedOut := [], and
//   the length-0 suffix condition holds immediately. CloseConstrainedSpan
//   appends the closing delimiter and resets currentConstrainedOut to [],
//   preserving the implication. Both constrained append branches use
//   AppendConstrainedToken, which appends the same token to generated and to
//   currentConstrainedOut; the reject branch changes neither side.
// cost: UnconstrainedStep, ConstrainedStep, and CloseConstrainedSpan each bump
//   helpers.cost by 1 internally, and in those branches we also do
//   steps := steps + 1. In the soft constrained branch we use raw sampling via
//   ChooseNextTokenUnconstrained, so we manually do helpers.cost := helpers.cost + 1
//   and also increment steps once. Query helpers and AppendConstrainedToken do
//   not bump cost, so helpers.cost <= steps is preserved in every branch.
// progress: Every iteration increments steps by exactly 1 before either break
//   or state update. The unconstrained branch appends at most one token. The
//   complete-prefix branch appends only the closing delimiter, i.e. one token.
//   The hard constrained branch appends at most one constrained token. The soft
//   constrained branch either appends one token or rejects and appends none.
//   Therefore |generated| never exceeds |generatedPrefix| + steps.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps := 0;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  invariant helpers.cost <= steps
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    var argmax := helpers.GetHighestLogitToken(lm);
    var argmaxLogit := helpers.GetTokenLogit(lm, argmax);
    var openLogit := helpers.GetTokenLogit(lm, "<<");
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      if openLogit >= argmaxLogit - 2.0 || Contains(next, "<<") {
        generated := generated + ["<<"];
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      } else {
        generated := generated + [next];
        if next == "<<" {
          insideConstrainedOut := true;
          currentConstrainedOut := [];
        }
      }
    }
  } else {
    if parser.IsCompletePrefix(currentConstrainedOut) {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var constrainedPrompt := prompt + generated[..|generated| - |currentConstrainedOut|];
      var validCount := helpers.ValidTokenCount(parser, currentConstrainedOut);
      var narrow := helpers.DeadEndDetection(parser, currentConstrainedOut, 2);
      if narrow || validCount <= 2 {
        var nextHard := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if nextHard == eosToken {
          break;
        } else {
          var appendedGenerated1, appendedInside1, appendedCurrent1 := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, nextHard
          );
          generated := appendedGenerated1;
          insideConstrainedOut := appendedInside1;
          currentConstrainedOut := appendedCurrent1;
        }
      } else {
        var candidates := helpers.TopValidCandidates(
          lm, parser, constrainedPrompt, currentConstrainedOut, 4, eosToken
        );
        lm.GenerateLogits(constrainedPrompt + currentConstrainedOut);
        helpers.BoostTokenLogits(lm, candidates, 5.0);
        helpers.PenalizeTokenLogits(lm, [">>"], 8.0);
        var nextSoft := lm.ChooseNextTokenUnconstrained();
        helpers.cost := helpers.cost + 1;
        steps := steps + 1;
        if nextSoft == eosToken {
          break;
        } else {
          var validSoft := helpers.IsTokenValidNext(parser, currentConstrainedOut, nextSoft);
          if validSoft {
            var appendedGenerated2, appendedInside2, appendedCurrent2 := helpers.AppendConstrainedToken(
              lm, parser, generated, currentConstrainedOut, nextSoft
            );
            generated := appendedGenerated2;
            insideConstrainedOut := appendedInside2;
            currentConstrainedOut := appendedCurrent2;
          }
        }
      }
    }
  }
}

