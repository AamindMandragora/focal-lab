Strategy: // CSD_RATIONALE_BEGIN
// The failure pattern shows that waiting for the model to *choose* when to emit
// arithmetic spans leaves almost the whole solution unconstrained; in the bad
// cases the model wrote symbolic setup like `n1`, `t_beach`, or prose inside
// `<< >>`, which violates the arithmetic-only syntax requirement. The revised
// strategy therefore flips the control policy: outside constrained mode we still
// allow ordinary explanation text, but we actively bias generation toward
// opening a constrained span whenever possible by boosting `"<<"` at every
// unconstrained step. Once inside a span, we use only parser-valid constrained
// sampling helpers and close immediately when the arithmetic fragment is
// complete. This does not force a span at every position, but it substantially
// increases the frequency of short arithmetic computations and sharply reduces
// malformed symbolic content inside delimiters.
// 
// Concretely, outside a span we no longer use `UnconstrainedStep`; instead we
// generate logits, strongly boost `"<<"`, then sample unconstrained. This keeps
// prose flexible while making arithmetic spans much more likely to appear early
// and often. Inside a span we continue to use verified constrained helpers
// (`AdaptiveConstrainedStep` when groups are provided, otherwise
// `ConstrainedStep`) so every non-EOS token appended between delimiters is
// parser-valid arithmetic text. As soon as `parser.IsCompletePrefix` holds, we
// call `CloseConstrainedSpan`, ensuring `">>"` is emitted only at a valid
// completion point.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside-span branch: after manual unconstrained sampling we either remain
//   outside constrained mode, break on EOS, or open a span with
//   `OpenConstrainedSpan`; in the latter case `currentConstrainedOut := []`, and
//   `parser.IsValidPrefix([])` is a precondition, so validity holds.
//   Inside complete branch: `CloseConstrainedSpan` sets `insideConstrainedOut` to
//   false, making the implication vacuous. Inside incomplete branch:
//   `AdaptiveConstrainedStep` / `ConstrainedStep` guarantee EOS or a token that
//   extends a valid parser prefix; on non-EOS, `AppendConstrainedToken` or the
//   postcondition of `ConstrainedStep` preserves parser validity.
//
// suffix:
//   Outside-span branch: if we stay outside or break, the implication is
//   vacuous; if we open a span, `OpenConstrainedSpan` appends only `"<<"` and
//   resets the tracked constrained prefix to `[]`, which is exactly the
//   zero-length suffix of `generated`.
//   Inside complete branch: after `CloseConstrainedSpan` we are outside, so the
//   implication is vacuous. Inside incomplete branch: `AppendConstrainedToken`
//   appends the same token to both `generated` and `currentConstrainedOut`, and
//   `ConstrainedStep` directly guarantees the suffix relation on its outputs.
//
// cost accounting:
//   We keep the out-parameter `cost` fixed at 0 during the loop and return
//   `cost := steps` afterward. Every non-breaking branch performs exactly one
//   costed action and then increments `steps` by 1: outside-span manual sampling
//   does `ChooseNextTokenUnconstrained` plus `helpers.cost := helpers.cost + 1`;
//   opening or closing a span uses `OpenConstrainedSpan` / `CloseConstrainedSpan`;
//   constrained generation uses `AdaptiveConstrainedStep` or `ConstrainedStep`.
//   Breaking branches also increment `steps` immediately after the costed action,
//   so returned `cost` equals the number of charged steps and is bounded by
//   `maxSteps`.
//
// progress:
//   Outside-span manual sampling appends either one ordinary token or one `"<<"`
//   token (via `OpenConstrainedSpan`) and then increments `steps` by 1; on EOS it
//   appends nothing but breaks immediately after incrementing `steps`, which is
//   allowed. The complete constrained branch uses `CloseConstrainedSpan`, which
//   appends at most one token and increments `steps` by 1. The incomplete
//   constrained branches either append exactly one parser-valid token and then
//   increment `steps` by 1, or hit EOS and break after incrementing `steps` by
//   1. Therefore every non-breaking branch strictly increases `steps`, and
//   `|generated| <= |generatedPrefix| + steps` is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var useGroups: bool := 0 < |validTokenGroups|;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    lm.GenerateLogits(prompt + generated);
    helpers.BoostTokenLogits(lm, ["<<"], 8.0);
    var next := lm.ChooseNextTokenUnconstrained();
    helpers.cost := helpers.cost + 1;
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      if next == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      if useGroups {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var steppedGenerated, steppedInside, steppedCurrent, hitEos := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := steppedGenerated;
          insideConstrainedOut := steppedInside;
          currentConstrainedOut := steppedCurrent;
        }
      }
    }
  }
}

cost := steps;

