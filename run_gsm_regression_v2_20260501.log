Generating initial strategy for: Solve math word problems step by step, writing each arithmetic computation inside << >> delimiters.

============================================================
Attempt 1/10
============================================================
Strategy: // CSD_RATIONALE_BEGIN
// Math-step CSD with delimiter-triggered constrained arithmetic spans.
// The strategy tracks the standard span state (`insideConstrainedOut` and
// `currentConstrainedOut`) plus one task-local signal: whether the current
// constrained prefix appears structurally narrow according to the parser.
// Outside `<< >>`, generation is unconstrained so the model can write natural
// language explanations. When the model emits `<<`, we enter constrained mode
// and require the span contents to stay parser-valid arithmetic text. Inside a
// span, the strategy chooses between two verified constrained samplers:
// `AdaptiveConstrainedStep` when caller-supplied token groups are available,
// otherwise `ConstrainedStep`. Once the parser reports that the arithmetic span
// is complete, the strategy emits `>>` via `CloseConstrainedSpan`.
// This supports the task because free-form reasoning remains fluent outside the
// delimiters, while every arithmetic computation inside delimiters is forced to
// remain a valid parser prefix and is only closed when complete.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Unconstrained branch: if the sampled token is not "<<", constrained state
//   stays false; if it is "<<", we set currentConstrainedOut := [], and the
//   precondition gives parser.IsValidPrefix([]). Close branch: CloseConstrainedSpan
//   sets insideConstrainedOut to false, so the implication is vacuous.
//   Adaptive/regular constrained branches: both helpers guarantee either EOS
//   (state unchanged before break) or a parser-valid next token; AppendConstrainedToken
//   is then called only on that valid token, so the updated constrained prefix
//   remains parser-valid.
//
// suffix:
//   Unconstrained branch: when we stay outside, the implication is vacuous; on
//   opening `<<`, currentConstrainedOut becomes [], which matches the length-0
//   suffix of generated after appending "<<". Close branch: CloseConstrainedSpan
//   appends the closing delimiter and resets currentConstrainedOut to [], so the
//   implication is again vacuous afterward.
//   Adaptive/regular constrained branches: AppendConstrainedToken appends the
//   same non-EOS token to both generated and currentConstrainedOut, preserving
//   generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut.
//
// cost accounting:
//   We return cost := steps at the end, so the loop maintains only cost == 0.
//   Every non-breaking branch uses exactly one costed helper step
//   (UnconstrainedStep, CloseConstrainedSpan, AdaptiveConstrainedStep, or
//   ConstrainedStep) and then does steps := steps + 1. Break branches also come
//   immediately after such a helper step, so steps counts all charged work and
//   remains <= maxSteps by the loop guard.
//
// progress:
//   Unconstrained branch appends exactly one token and increments steps by 1,
//   so |generated| increases by at most 1 and stays within |generatedPrefix| +
//   steps. Close branch appends at most one token and also increments steps by 1.
//   Adaptive/regular constrained branches either break on EOS with generated
//   unchanged after steps += 1, or append exactly one token via
//   AppendConstrainedToken and increment steps by 1. Thus every non-breaking
//   branch strictly increases steps, satisfying decreases maxSteps - steps, and
//   the bound |generated| <= |generatedPrefix| + steps is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var useGroups: bool := 0 < |validTokenGroups|;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      generated := generated + [next];
      if next == "<<" {
        insideConstrainedOut := true;
        currentConstrainedOut := [];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      if useGroups {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var steppedGenerated, steppedInside, steppedCurrent, hitEos := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := steppedGenerated;
          insideConstrainedOut := steppedInside;
          currentConstrainedOut := steppedCurrent;
        }
      }
    }
  }
}

cost := steps;

