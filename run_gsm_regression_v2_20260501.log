Strategy: // CSD_RATIONALE_BEGIN
// Revised strategy: aggressively force arithmetic-only constrained spans instead
// of waiting for the model to decide when to open `<<`. The previous attempt
// left almost all generation unconstrained, so the model often wrote variable
// names or prose inside delimiters, causing malformed constrained content.
// Here, outside a span we still generate natural-language explanation
// unconstrained, but any time the model proposes `<<` we immediately switch to a
// tightly controlled constrained phase. Inside a span we never use free-form
// constrained text generation beyond parser-valid arithmetic tokens: we use
// `AdaptiveConstrainedStep` with caller groups when available, otherwise
// `ConstrainedStep`, and we close the span as soon as the parser says the
// arithmetic expression is complete. This directly targets the syntax failures:
// the contents between `<<` and `>>` are always parser-valid arithmetic text,
// never copied prose like variable names or English words.
// CSD_RATIONALE_END
// CSD_PROOF_SKETCH_BEGIN
// parser_validity:
//   Outside-span branch: if the sampled token is ordinary text or EOS, either we
//   remain outside constrained mode or break, so the implication is vacuous; if
//   the token is "<<", OpenConstrainedSpan sets currentConstrainedOut := [],
//   and parser.IsValidPrefix([]) is given.
//   Complete-span branch: CloseConstrainedSpan sets insideConstrainedOut := false,
//   so the implication is vacuous afterward. In constrained-sampling branches,
//   AdaptiveConstrainedStep / ConstrainedStep guarantee either EOS or a token
//   extending a valid parser prefix; AppendConstrainedToken is called only on
//   such a token, preserving parser validity.
//
// suffix:
//   Outside-span branch: when we stay outside, the implication is vacuous; when
//   we open a span, OpenConstrainedSpan appends only "<<" and resets the tracked
//   constrained content to [], which equals the length-0 suffix of generated.
//   Complete-span branch: after CloseConstrainedSpan we are outside constrained
//   mode, so the implication is vacuous. In constrained-sampling branches,
//   AppendConstrainedToken appends the same token to both generated and
//   currentConstrainedOut, while ConstrainedStep already guarantees the suffix
//   relation on its updated outputs.
//
// cost accounting:
//   We maintain cost == 0 during the loop and return cost := steps at the end.
//   Every non-breaking branch performs exactly one costed helper action
//   (UnconstrainedStep, OpenConstrainedSpan, CloseConstrainedSpan,
//   AdaptiveConstrainedStep, or ConstrainedStep) and then increments steps by 1.
//   Breaking branches also increment steps immediately after the costed helper,
//   so returned cost matches the number of charged steps and is <= maxSteps.
//
// progress:
//   Unconstrained text branch appends exactly one token and increments steps by
//   1; opening a span appends exactly one token via OpenConstrainedSpan and also
//   increments steps by 1. Close branch appends at most one token and increments
//   steps by 1. Adaptive constrained branch either breaks on EOS after steps :=
//   steps + 1 with generated unchanged, or appends exactly one token via
//   AppendConstrainedToken and increments steps by 1. Regular constrained branch
//   uses ConstrainedStep, which on non-EOS appends exactly one token and on EOS
//   leaves generated unchanged; in both cases the branch increments steps by 1
//   or breaks. Thus every non-breaking branch strictly increases steps, and
//   |generated| <= |generatedPrefix| + steps is preserved.
// CSD_PROOF_SKETCH_END
generated := generatedPrefix;
insideConstrainedOut := insideConstrained;
currentConstrainedOut := currentConstrained;
cost := 0;

var steps: nat := 0;
var useGroups: bool := 0 < |validTokenGroups|;

while steps < maxSteps
  invariant 0 <= steps <= maxSteps
  invariant lm.ValidTokensIdsLogits()
  invariant !insideConstrainedOut ==> currentConstrainedOut == []
  invariant insideConstrainedOut ==> parser.IsValidPrefix(currentConstrainedOut)
  invariant insideConstrainedOut ==> |currentConstrainedOut| <= |generated|
  invariant insideConstrainedOut ==> generated[|generated| - |currentConstrainedOut|..] == currentConstrainedOut
  invariant |generated| <= |generatedPrefix| + steps
  invariant cost == 0
  decreases maxSteps - steps
{
  if !insideConstrainedOut {
    var next := helpers.UnconstrainedStep(lm, prompt, generated);
    steps := steps + 1;
    if next == eosToken {
      break;
    } else {
      if next == "<<" {
        var openedGenerated, openedInside, openedCurrent := helpers.OpenConstrainedSpan(lm, generated);
        generated := openedGenerated;
        insideConstrainedOut := openedInside;
        currentConstrainedOut := openedCurrent;
      } else {
        generated := generated + [next];
      }
    }
  } else {
    var complete := parser.IsCompletePrefix(currentConstrainedOut);
    if complete {
      var closedGenerated, closedInside, closedCurrent := helpers.CloseConstrainedSpan(
        lm, parser, generated, currentConstrainedOut
      );
      generated := closedGenerated;
      insideConstrainedOut := closedInside;
      currentConstrainedOut := closedCurrent;
      steps := steps + 1;
    } else {
      var stablePrefix := generated[..|generated| - |currentConstrainedOut|];
      var constrainedPrompt := prompt + stablePrefix;
      if useGroups {
        var next := helpers.AdaptiveConstrainedStep(
          lm, parser, constrainedPrompt, currentConstrainedOut, validTokenGroups, 4.0, 12, eosToken
        );
        steps := steps + 1;
        if next == eosToken {
          break;
        } else {
          var appendedGenerated, appendedInside, appendedCurrent := helpers.AppendConstrainedToken(
            lm, parser, generated, currentConstrainedOut, next
          );
          generated := appendedGenerated;
          insideConstrainedOut := appendedInside;
          currentConstrainedOut := appendedCurrent;
        }
      } else {
        var steppedGenerated, steppedInside, steppedCurrent, hitEos := helpers.ConstrainedStep(
          lm, parser, constrainedPrompt, generated, currentConstrainedOut, eosToken
        );
        steps := steps + 1;
        if hitEos {
          break;
        } else {
          generated := steppedGenerated;
          insideConstrainedOut := steppedInside;
          currentConstrainedOut := steppedCurrent;
        }
      }
    }
  }
}

